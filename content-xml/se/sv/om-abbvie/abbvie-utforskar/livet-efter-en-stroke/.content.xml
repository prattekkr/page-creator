                                alt="Life after a stroke"
                                altValueFromDAM="false"
                                displayPopupTitle="true"
                                dmPresetType="imagePreset"
                                fileReference="/content/dam/abbvie-com2/se/images/se-3-0-images/se-2-0-images-for-2024/SE-ABBV_dempsey_wedding.jpg"
                                isDecorative="false"
                                titleValueFromDAM="false"/>
                            <text_519518953
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2024-02-26T08:14:34.161-05:00"
                                jcr:createdBy="lennglx"
