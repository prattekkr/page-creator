                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;i>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-14-reg&quot;>Sophia och Joe gifte sig. Tillsammans gillar de att besöka och utforska olika platser. De säger att så länge de kan fortsätta med det, så är de glada.&lt;/span>&lt;/span>&lt;/i>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
