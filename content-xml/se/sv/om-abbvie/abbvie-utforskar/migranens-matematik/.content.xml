                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>En miljard människor påverkas. Miljoner missade arbetsdagar. Mängder av missade evenemang. Effekterna av migrän är stora. Men det görs stora framsteg inom migränvården.&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
