                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;h2>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-20-reg&quot;>Vi vet av erfarenhet att de bästa lösningarna skapar vi tillsammans. Därför samarbetar vi med andra för att lösa framtidens hälsoutmaningar. Bland våra samarbetspartners finns representanter från hela vårdkedjan; vårdgivare och patienter, anhöriga, beslutsfattare, intresseorganisationer och andra relevanta företag och samhällsaktörer. Vi söker ständigt nya och idérika partners och välkomnar de som vill samarbeta med oss mot samma mål.&amp;nbsp;Följ&amp;nbsp;oss gärna på &lt;span style=&quot;font-weight: normal;&quot;>facebook&amp;nbsp;&lt;/span>&lt;a href=&quot;https://www.facebook.com/AbbVieSverige&quot;>@AbbVieSverige&lt;/a>, &lt;a href=&quot;https://www.instagram.com/abbviesverige/&quot; target=&quot;_blank&quot;>Instagram&lt;/a>&lt;span style=&quot;font-weight: normal;&quot;>&amp;nbsp;samt&amp;nbsp;vår&amp;nbsp;&lt;/span>&lt;a href=&quot;https://www.youtube.com/channel/UC06TkIvs5letihNgJ2rDUYg&quot;>Youtube-kanal&lt;/a>&lt;span style=&quot;font-weight: normal;&quot;>.&lt;/span>&lt;/span>&lt;/span>&lt;br>&#xd;&#xa;&lt;/h2>&#xd;&#xa;"
                                textIsRich="true"/>
