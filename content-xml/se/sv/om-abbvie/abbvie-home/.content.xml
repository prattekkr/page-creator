                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>Hållbara eHälsolösningar med digifysisk vård – digitalt när det passar, fysiskt när det behövs&lt;/span>&lt;/span>&lt;br />&#xd;&#xa;&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_copy_copy_
                                cq:styleIds="[1662756456518]"
                                jcr:created="{Date}2022-12-05T12:22:48.644-05:00"
