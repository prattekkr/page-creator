                        <item_1670707208042
                            cq:panelTitle="Förbättra liv"
                            cq:styleIds="[1659545825678]"
                            jcr:lastModified="{Date}2024-02-20T08:12:30.587-05:00"
                            jcr:lastModifiedBy="lennglx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>&lt;span class=&quot;light-font&quot;>Vi förbättrar liv varje dag. Vi fattar beslut baserat på medkänsla och skapar en långsiktig positiv påverkan på patienter, deras familjer, våra medarbetare och samhället.&lt;/span>&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
                        <item_1670707211154
                            cq:panelTitle="Integritet"
                            cq:styleIds="[1659545825678]"
                            jcr:lastModified="{Date}2024-02-20T08:12:15.590-05:00"
                            jcr:lastModifiedBy="lennglx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>&lt;span class=&quot;light-font&quot;>Vi strävar efter att alltid göra det som är rätt. Vår integritet är central och vi strävar efter att alltid hålla högsta möjliga standard i allt vi gör.&amp;nbsp;&lt;/span>&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
                        <item_1670707214308
                            cq:panelTitle="Innovation"
                            cq:styleIds="[1659545825678]"
                            jcr:lastModified="{Date}2024-02-20T08:11:48.532-05:00"
                            jcr:lastModifiedBy="lennglx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>&lt;span class=&quot;light-font&quot;>Vi är innovativa för att kunna lösa framtidens hälsoutmaningar. Vi investerar ständigt i upptäckt och utveckling av nya mediciner och vårdlösningar för att förbättra liv.&lt;/span>&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
                        <item_1670707217700
                            cq:panelTitle="Mångfald"
                            cq:styleIds="[1659545825678]"
                            jcr:lastModified="{Date}2024-02-27T06:57:02.554-05:00"
                            jcr:lastModifiedBy="lennglx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>&lt;span class=&quot;light-font&quot;>Vi behandlar alla lika och med respekt. Vi har medarbetare över hela världen, och vi omfamnar allas olikhet i bakgrund och perspektiv, vilket ökar vår möjlighet att nå vår mission: att förbättra liv. &lt;/span>&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
                        <item_1670707220579
                            cq:panelTitle="Samhällsansvar"
                            cq:styleIds="[1659545825678]"
                            jcr:lastModified="{Date}2024-03-14T07:06:08.057-04:00"
                            jcr:lastModifiedBy="lennglx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>&lt;span class=&quot;light-font&quot;>Vi bidrar till det samhälle vi lever i genom att ta ett socialt ansvar och även skydda vår miljö. Vi bidrar också till en mer hållbar sjukvård genom flera vårdlösningsinitiativ.&amp;nbsp;&lt;/span>&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
                    </accordion_copy_copy>
