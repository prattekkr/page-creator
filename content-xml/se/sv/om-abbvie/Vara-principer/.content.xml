                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-26-reg&quot;>För att ytterligare understryka vikten av ett etiskt och värdegrundat beteende, lanserade AbbVie 2019 våra så kallade principer. Dessa är grundvalen för hur vi agerar när vi gör affärer.&amp;nbsp;&lt;/span>&lt;/span>&lt;br>&#xa;&lt;/p>&#xa;"
