                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>Se vad som gör oss till en bra arbetsplats.&lt;/span>&lt;/span>&lt;/p>&#xa;"
                                textIsRich="true"/>
                            <text_144983223
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2024-02-09T07:21:58.058-05:00"
                                jcr:createdBy="lennglx"
                                jcr:lastModified="{Date}2024-03-27T05:59:09.550-04:00"
                                jcr:lastModifiedBy="lennglx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-26-reg&quot;>Vi tror på att låta engagemanget växa, och uppmuntrar även våra medarbetare att arbeta ideellt inom ramen för ett flertal företagsövergripande initiativ – en plats för personlig tillväxt!&lt;/span>&lt;/span>&lt;br>&#xd;&#xa;&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator
