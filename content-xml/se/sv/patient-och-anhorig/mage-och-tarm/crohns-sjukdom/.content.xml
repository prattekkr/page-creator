                                    jcr:lastModifiedBy="lennglx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-14-reg&quot;>Cirka 15 000 till 35 000 lever med Crohns sjukdom och varje år nyinsjuknar cirka 750 personer i Sverige. Sjukdomen debuterar oftast i 15-30 års åldern.&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <header_copy
                                    cq:styleIds="[2]"
                                    jcr:created="{Date}2022-12-12T11:17:13.424-05:00"
                                    jcr:createdBy="chiucx"
