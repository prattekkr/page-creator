                                    jcr:lastModifiedBy="lennglx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-14-reg&quot;>Orsaken till ulcerös kolit är ännu inte känd, men man vet att sjukdomen delvis är ärftlig. Det finns även faktorer i omgivningen som kan påverka risken för att få ulcerös kolit. och fortsatt rökning försämrar prognosen ytterligare.&lt;/span>&lt;/span>&lt;/p>&#xa;"
                                    textIsRich="true"/>
