                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>&lt;span class=&quot;body-unica-14-reg&quot;>Varje år nyinsjuknar cIirka 1 000 personer, ungefär lika många kvinnor som män drabbas. Drygt 30 000 personer i Sverige lever med ulcerös kolit.&lt;/span>&lt;/p>&#xa;"
                                    textIsRich="true"/>
                                <header_copy
