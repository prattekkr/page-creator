                                jcr:title="IBD är en vanlig inflammatorisk tarmsjukdom"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h5"
                                variant="h"/>
                            <text_960610795
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2024-03-07T01:32:36.436-05:00"
                                jcr:createdBy="lennglx"
                                jcr:lastModified="{Date}2024-08-07T03:38:52.487-04:00"
                                jcr:lastModifiedBy="lennglx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-20-reg&quot;>Inflammatorisk tarmsjukdom eller IBD (Inflammatory Bowel Disease) är ett samlingsnamn för sjukdomarna&amp;nbsp;&lt;a href=&quot;https://www.alltomibd.se/inflammatoriska-tarmsjukdomar/ulceros-kolit-uc.html&quot; target=&quot;_blank&quot;>Ulcerös kolit&lt;/a>&amp;nbsp;och&amp;nbsp;&lt;a href=&quot;https://www.alltomibd.se/inflammatoriska-tarmsjukdomar/crohns-sjukdom.html&quot; target=&quot;_blank&quot;>Crohns sjukdom&lt;/a>. IBD karakteriseras av en kronisk inflammation i tarmens slemhinna. Sjukdomarna debuterar vanligen vid 15-40 års ålder och är lika vanligt hos både kvinnor och män.&amp;nbsp;Sjukdomen är kronisk och går vanligen i skov med längre perioder av låg eller ingen sjukdomsaktivitet.&amp;nbsp;Gemensamt för de båda sjukdomarna är att de flesta idag kan leva ett bra liv med rätt behandling. Samsjuklighet vid inflammatorisk tarmsjukdom innebär dels att patienten kan vara drabbad av flera av varandra oberoende sjukdomar, men även att den inflammatoriska tarmsjukdomen ger symtom i andra organ än tarmen, såsom på lederna och på huden.&lt;/span>&lt;/span>&lt;/p>&#xa;"
                                textIsRich="true"/>
                            <separator_1639942211
                                cq:styleIds="[1662756502570]"
                                jcr:created="{Date}2024-03-15T04:17:39.374-04:00"
