                                <header_copy
                                    cq:styleIds="[2]"
                                    jcr:created="{Date}2022-12-12T11:17:13.424-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2024-03-12T07:17:38.749-04:00"
                                    jcr:lastModifiedBy="lennglx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/header/v2/header"
                                    eyebrow="FÖREKOMST"/>
                                <text_copy_461620600_
                                    cq:styleIds="[1659545825679]"
                                    jcr:created="{Date}2023-12-08T04:14:12.848-05:00"
                                    jcr:createdBy="lennglx"
                                    jcr:lastModified="{Date}2024-07-10T03:58:14.351-04:00"
                                    jcr:lastModifiedBy="lennglx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-14-reg&quot;>Glaukom är vanligare i högre åldrar. Man räknar med att cirka fem procent i åldersgruppen över 70 år har sjukdomen. Glaukom är en av de vanligaste orsakerna till blindhet. &lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <header_copy_copy
                                    cq:styleIds="[2]"
                                    jcr:created="{Date}2022-12-12T11:17:13.424-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2024-03-12T07:17:54.101-04:00"
                                    jcr:lastModifiedBy="lennglx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/header/v2/header"
                                    eyebrow="ORSAK"/>
                                <text_copy_461620600__417303765
                                    cq:styleIds="[1659545825679]"
                                    jcr:created="{Date}2023-12-08T04:14:12.848-05:00"
                                    jcr:createdBy="lennglx"
                                    jcr:lastModified="{Date}2024-07-10T03:58:26.328-04:00"
                                    jcr:lastModifiedBy="lennglx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-14-reg&quot;>Vem som helst kan få glaukom, men ärftlighet har en viss inverkan. Har man en förälder eller ett syskon med glaukom är risken något större att drabbas.&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
