                                    jcr:created="{Date}2023-11-28T08:20:30.768-05:00"
                                    jcr:createdBy="lennglx"
                                    jcr:lastModified="{Date}2024-03-15T08:40:41.031-04:00"
                                    jcr:lastModifiedBy="lennglx"
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="Att leva med RVO"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h4"
                                    variant="h"/>
                                <text_copy_copy_copy__860414665
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2022-12-07T14:53:09.069-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2024-03-15T08:40:57.842-04:00"
                                    jcr:lastModifiedBy="lennglx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Att leva med RVO kan vara svårt eftersom sjukdomen kan orsaka permanent synnedsättning eller blindhet. Det är viktigt att söka medicinsk hjälp så snart som möjligt om man upplever några symptom på sjukdomen.&amp;nbsp;&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                            </container_568753235>
