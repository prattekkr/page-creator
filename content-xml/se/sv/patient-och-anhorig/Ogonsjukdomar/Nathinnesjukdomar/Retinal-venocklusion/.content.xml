                                    jcr:title="Vad är retinal venocklusion?"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h4"
                                    variant="h"/>
                                <separator
                                    jcr:created="{Date}2023-11-28T08:36:38.984-05:00"
                                    jcr:createdBy="lennglx"
                                    jcr:lastModified="{Date}2023-11-28T08:36:38.984-05:00"
                                    jcr:lastModifiedBy="lennglx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                                <text_copy_copy
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2022-12-07T14:53:09.069-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2024-03-15T08:38:01.616-04:00"
                                    jcr:lastModifiedBy="lennglx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Retinal venocklusion (RVO) är en relativt vanlig näthinnesjukdom. Vid RVO uppstår en förträngning av en ven i näthinnan, vilket kan leda till försämrad syn.&amp;nbsp;Förträngningen bromsar blodflödet genom näthinnan, som då kan bli svullen och få syrebrist. Svullnaden kan leda till skador på gula fläcken, makulan, och påverka främst lässynen.&amp;nbsp;Makula är det område mitt på näthinnan där synen är som skarpast, därför är den extra känslig. Förträngningen uppstår antingen i näthinnans centrala ven eller i en grenven, där&amp;nbsp;en blockering av centrala vener i regel leder till mer uttalad synnedsättning.&amp;nbsp;&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <separator_1294049852
                                    cq:styleIds="[1662756456518]"
                                    jcr:created="{Date}2022-12-14T13:11:13.090-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2022-12-14T13:11:13.090-05:00"
                                    jcr:lastModifiedBy="chiucx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                                <title_copy_712620418
                                    cq:styleIds="[1659545825678,1661545829678]"
                                    jcr:created="{Date}2023-11-28T08:20:30.768-05:00"
                                    jcr:createdBy="lennglx"
                                    jcr:lastModified="{Date}2024-03-15T08:38:45.503-04:00"
                                    jcr:lastModifiedBy="lennglx"
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="Symptom på RVO"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h4"
                                    variant="h"/>
                                <text_copy_copy_copy__1096204616
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2022-12-07T14:53:09.069-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2024-03-15T08:39:12.789-04:00"
                                    jcr:lastModifiedBy="lennglx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Symptomen på sjukdomen kan variera beroende på vilken del av näthinnan som påverkas, men vanliga symptom är nedsatt synskärpa, synfältsbortfall, suddig och förvrängd syn.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <separator_1294049852_1660570701
                                    cq:styleIds="[1662756456518]"
                                    jcr:created="{Date}2022-12-14T13:11:13.090-05:00"
                                    jcr:createdBy="chiucx"
