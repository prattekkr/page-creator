                                    jcr:title="Vad är diabetiskt makulaödem?"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h4"
                                    variant="h"/>
                                <separator
                                    jcr:created="{Date}2023-11-28T08:36:38.984-05:00"
                                    jcr:createdBy="lennglx"
                                    jcr:lastModified="{Date}2023-11-28T08:36:38.984-05:00"
                                    jcr:lastModifiedBy="lennglx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                                <text_copy_copy
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2022-12-07T14:53:09.069-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2024-03-15T07:57:30.256-04:00"
                                    jcr:lastModifiedBy="lennglx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Diabetiskt makulaödem (DME) är en komplikation av diabetes som påverkar ögat. Sjukdomen uppstår när höga blodsockernivåer och leder till att blodkärlen i ögat skadas och läckande vätska påverkar den centrala delen av näthinnan. Detta kan orsaka svullnad och skada på makula, vilket kan leda till synnedsättning eller till och med blindhet. Makula är den ljuskänsliga delen av näthinnan som är viktig för synskärpa och detaljseende.&amp;nbsp;&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <separator_1294049852
                                    cq:styleIds="[1662756456518]"
                                    jcr:created="{Date}2022-12-14T13:11:13.090-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2022-12-14T13:11:13.090-05:00"
                                    jcr:lastModifiedBy="chiucx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                                <title_copy
                                    cq:styleIds="[1659545825678,1661545829678]"
                                    jcr:created="{Date}2023-11-28T08:20:30.768-05:00"
                                    jcr:createdBy="lennglx"
                                    jcr:lastModified="{Date}2024-03-15T07:58:07.978-04:00"
                                    jcr:lastModifiedBy="lennglx"
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="Symtom på DME"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h4"
                                    variant="h"/>
                                <text_copy_copy_copy_
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2022-12-07T14:53:09.069-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2024-03-15T07:59:32.598-04:00"
                                    jcr:lastModifiedBy="lennglx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Symptomen på DME kan variera från lindriga synnedsättningar till kraftig synförlust. Andra vanliga symptom inkluderar suddig syn, förvrängd syn eller fläckar i synfältet.&amp;nbsp;&lt;/p>&#xa;"
                                    textIsRich="true"/>
                                <separator_1294049852_1660570701
                                    cq:styleIds="[1662756456518]"
                                    jcr:created="{Date}2022-12-14T13:11:13.090-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2022-12-14T13:11:13.090-05:00"
                                    jcr:lastModifiedBy="chiucx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                                <title_copy_1936414606
                                    cq:styleIds="[1659545825678,1661545829678]"
                                    jcr:created="{Date}2023-11-28T08:20:30.768-05:00"
                                    jcr:createdBy="lennglx"
                                    jcr:lastModified="{Date}2024-03-15T07:58:28.602-04:00"
                                    jcr:lastModifiedBy="lennglx"
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="Diagnos av DME"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h4"
                                    variant="h"/>
                                <text_copy_copy_copy__28924054
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2022-12-07T14:53:09.069-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2024-03-15T07:59:11.208-04:00"
                                    jcr:lastModifiedBy="lennglx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Ögonläkaren ställer diagnosen genom att titta på uppkomna symptom som exempelvis försämrad syn, särskilt lässynen kan vara påverkad. Det görs också en ögonundersökning där man med hjälp av fotografier granskar ögats näthinna. Eventuellt utförs också en undersökning med hjälp av ett kontrastmedel för att titta på utbredning av svullnaden.&amp;nbsp;&lt;/p>&#xa;"
                                    textIsRich="true"/>
                                <separator_1294049852_1427574389
                                    cq:styleIds="[1662756456518]"
                                    jcr:created="{Date}2022-12-14T13:11:13.090-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2022-12-14T13:11:13.090-05:00"
                                    jcr:lastModifiedBy="chiucx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                                <title_copy_712620418
                                    cq:styleIds="[1659545825678,1661545829678]"
                                    jcr:created="{Date}2023-11-28T08:20:30.768-05:00"
                                    jcr:createdBy="lennglx"
                                    jcr:lastModified="{Date}2024-03-15T07:59:57.888-04:00"
                                    jcr:lastModifiedBy="lennglx"
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="Behandling av DME"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h4"
                                    variant="h"/>
                                <text_copy_copy_copy__1096204616
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2022-12-07T14:53:09.069-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2024-03-15T08:00:16.951-04:00"
                                    jcr:lastModifiedBy="lennglx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Behandlingen fokuserar på att minska svullnaden i makula och förhindra fortsatt sjukdomsutveckling. Det finns flera behandlingsalternativ, inklusive injektioner i ögat, laserbehandling och kirurgi. Det är viktigt att personer med diabetes regelbundet undersöker sina ögon för att upptäcka eventuella förändringar i makula redan i ett tidigt skede.&lt;/p>&#xa;"
                                    textIsRich="true"/>
                                <separator_1294049852_968899328
                                    cq:styleIds="[1662756456518]"
                                    jcr:created="{Date}2022-12-14T13:11:13.090-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2022-12-14T13:11:13.090-05:00"
                                    jcr:lastModifiedBy="chiucx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                                <title_copy_712620418_31780961
                                    cq:styleIds="[1659545825678,1661545829678]"
                                    jcr:created="{Date}2023-11-28T08:20:30.768-05:00"
                                    jcr:createdBy="lennglx"
                                    jcr:lastModified="{Date}2024-03-15T08:01:23.186-04:00"
                                    jcr:lastModifiedBy="lennglx"
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="Att leva med DME"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h4"
                                    variant="h"/>
                                <text_copy_copy_copy__1442294842
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2022-12-07T14:53:09.069-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2024-03-15T08:01:41.914-04:00"
                                    jcr:lastModifiedBy="lennglx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>DME kan påverka livet på olika sätt. Många som drabbas av sjukdomen upplever en minskning av sin synskärpa, vilket kan göra det svårt att utföra vardagliga aktiviteter som att köra bil eller läsa. Det kan naturligtvis också påverka arbete och sociala aktiviteter.&amp;nbsp;&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                            </container_568753235>
