                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-14-reg&quot;>Förekomsten av DME har ökat i takt med ökningen av diabetes i samhället. Ungefär hälften av personer med diabetes typ 2 utvecklar förändringar i makula under sin livstid. &lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
