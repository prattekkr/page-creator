                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-14-reg&quot;>Kroniskt höga blodsockernivåer är den största riskfaktorn för uppkomsten av DME.&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
