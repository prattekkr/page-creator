                                    jcr:createdBy="lennglx"
                                    jcr:description="&lt;p>&lt;span class=&quot;light-font&quot;>Retinal venocklusion (RVO) är en sjukdom som uppstår när en ven i ögats näthinna blir blockerad och hindrar blodflödet till vissa delar av näthinnan. Detta kan leda till synnedsättning eller i värsta fall blindhet. Sjukdomen kan drabba både unga och gamla, men äldre personer löper större risk att drabbas.&lt;/span>&lt;/p>&#xd;&#xa;"
                                    jcr:lastModified="{Date}2024-03-15T07:53:46.829-04:00"
                                    jcr:lastModifiedBy="lennglx"
                                    jcr:primaryType="nt:unstructured"
