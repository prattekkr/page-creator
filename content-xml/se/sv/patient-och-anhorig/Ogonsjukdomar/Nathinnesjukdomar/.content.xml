                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>Vi fokuserar på Diabetisk makulaödem (DME)&lt;br>&#xa;och&amp;nbsp;Retinal venocklusion (RVO).&lt;/span>&lt;/span>&lt;/p>&#xa;"
                                textIsRich="true"/>
                            <separator
                                cq:styleIds="[1662756456518]"
                                jcr:created="{Date}2022-12-21T17:39:33.617-05:00"
