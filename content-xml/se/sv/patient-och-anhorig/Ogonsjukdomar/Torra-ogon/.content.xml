                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-14-reg&quot;>Med ålder försämras funktionen hos de körtlar som ska producera tårfilmen. Vissa läkemedel kan minska produktionen av tårvätska. I sällsynta fall kan det vara symtom på en annan sjukdom som till exempel Sjögrens syndrom.&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
