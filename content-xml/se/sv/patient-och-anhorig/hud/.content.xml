                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>Flera hundratusen lever idag med en kronisk hudsjukdom. Vår ambition är att alla som påverkas av Atopisk Dermatit (AD), Psoriasis och Hidradenitis Suppurativa (HS) ska kunna leva sina liv utan begränsningar.&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
