                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-14-reg&quot;>Den främsta orsaken till psoriasis är ett överaktivt immunförsvar. Det är en ärftlig sjukdom, en av tre har en släkting med psoriasis. Sjukdomen bryter ut i skov som kan orsakas av till exempel infektioner.&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
