                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-14-reg&quot;>Runt 1 miljon i Sverige är drabbade av hudsjukdomen atopiskt eksem – ungefär var tionde person.&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
