                                    sling:resourceType="abbvie-com2/components/header/v2/header"
                                    eyebrow="FÖREKOMST"/>
                                <text
                                    cq:styleIds="[1659545825679]"
                                    jcr:created="{Date}2023-12-08T04:14:12.848-05:00"
                                    jcr:createdBy="lennglx"
                                    jcr:lastModified="{Date}2024-03-18T09:13:16.118-04:00"
                                    jcr:lastModifiedBy="lennglx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>&lt;span class=&quot;body-unica-14-reg&quot;>Mellan 1 till 4 procent, där siffrorna varierar i olika studier och länder, sannolikt på grund av att sjukdomen är underdiagnostiserad. Kvinnor löper högre risk än män att utveckla hidradenitis suppurativa.&amp;nbsp;&lt;/span>&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <header_copy
                                    cq:styleIds="[2]"
                                    jcr:created="{Date}2022-12-12T11:17:13.424-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2024-03-18T09:08:52.792-04:00"
                                    jcr:lastModifiedBy="lennglx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/header/v2/header"
                                    eyebrow="ORSAK"/>
                                <text_copy
                                    cq:styleIds="[1659545825679]"
                                    jcr:created="{Date}2023-12-08T04:14:12.848-05:00"
                                    jcr:createdBy="lennglx"
                                    jcr:lastModified="{Date}2024-03-18T09:13:26.186-04:00"
                                    jcr:lastModifiedBy="lennglx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>&lt;span class=&quot;body-unica-14-reg&quot;>HS är en inflammatorisk hudsjukdom. Det innebär att sjukdomen är förknippad med avvikelser i immunförsvaret, men den exakta orsaken till HS är inte känd.&amp;nbsp;Ungefär en tredjedel av alla som får diagnosen HS har en nära släkting som också har sjukdomen.&amp;nbsp;&lt;/span>&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
