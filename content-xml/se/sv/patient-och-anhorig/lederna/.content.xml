                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>Ungefär en miljon människor i Sverige lever idag med en reumatisk sjukdom. Vi vill höja ambitionsnivån och fortsätta förbättra livet för alla som lever med reumatisk sjukdom.&lt;/span>&lt;/span>&lt;/p>&#xa;"
