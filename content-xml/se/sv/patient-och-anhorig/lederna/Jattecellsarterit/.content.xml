                                    jcr:lastModifiedBy="lennglx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    langAttribute="none"
                                    text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-14-reg&quot;>Jättecellsarterit uppträder sällan före 50 års ålder, störst risk för att insjukna är i 70-80 årsåldern. Kvinnor drabbas tre gånger så ofta som män. Varje år insjuknar cirka 2000 personer i Sverige.&amp;nbsp;&amp;nbsp;I andra delar av världen är sjukdomen betydligt ovanligare.&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <header_copy_206196699
                                    cq:styleIds="[2]"
                                    jcr:created="{Date}2022-12-12T11:17:13.424-05:00"
