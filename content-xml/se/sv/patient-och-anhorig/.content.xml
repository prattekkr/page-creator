                                    pretitle="CANCER"
                                    textIsRich="[true,true]"/>
                                <teaser_copy_copy_cop_86965358
                                    cq:styleIds="[6]"
                                    jcr:created="{Date}2022-11-21T14:18:06.856-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:description="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-20-reg&quot;>Vår ambition är att alla som påverkas av Atopisk Dermatit (AD), Psoriasis och Hidradenitis Suppurativa (HS) ska kunna leva sina liv utan begränsningar.&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
