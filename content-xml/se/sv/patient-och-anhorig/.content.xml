                                    jcr:description="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-20-reg&quot;>Med människan i centrum arbetar vi för att flytta fram gränsen för vad som är möjligt att uppnå med cancerbehandling. Därför forskar vi inom några av de mest svårbehandlade cancerformerna.&lt;/span>&lt;/span>&lt;br />&#xd;&#xa;&lt;/p>&#xd;&#xa;"
                                    jcr:lastModified="{Date}2024-04-16T09:50:10.253-04:00"
                                    jcr:lastModifiedBy="lennglx"
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="&lt;p>Vi nöjer oss först när alla kan leva ett bra liv trots cancer&lt;/p>&#xd;&#xa;"
                                    sling:resourceType="abbvie-com2/components/teaser/v2/teaser"
                                    ctaLink="/content/abbvie-com2/se/sv/patient-och-anhorig/cancer"
                                    ctaTarget="_blank"
