                                    jcr:lastModifiedBy="lennglx"
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="&lt;p>Flera hundratusen lever idag med en kronisk hudsjukdom&lt;/p>&#xd;&#xa;"
                                    sling:resourceType="abbvie-com2/components/teaser/v2/teaser"
                                    ctaLink="/content/abbvie-com2/se/sv/patient-och-anhorig/hud"
