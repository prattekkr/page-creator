                                    jcr:created="{Date}2022-11-21T14:18:06.856-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:description="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-20-reg&quot;>Ögat kan drabbas av sjukdom, där en del är relaterade till andra sjukdomar, som diabetes, hjärt- och kärlsjukdom och autoimmuna sjukdomar. Andra orsaker kan vara arv och miljö. Med rätt vård och behandling kan du bevara synen.&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
                                    jcr:lastModified="{Date}2024-04-16T10:46:17.946-04:00"
                                    jcr:lastModifiedBy="lennglx"
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="&lt;p>Vi fokuserar på glaukom och näthinnesjukdomar&lt;/p>&#xd;&#xa;"
                                    sling:resourceType="abbvie-com2/components/teaser/v2/teaser"
