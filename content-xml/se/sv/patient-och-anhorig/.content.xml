                                    ctaText="Läs mer om hudsjukdomar här"
                                    pretitle="HUDEN"
                                    textIsRich="[true,true]"/>
                                <teaser_copy_copy_cop_1960919622
                                    cq:styleIds="[6]"
                                    jcr:created="{Date}2022-11-21T14:18:06.856-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:description="&lt;p>&lt;span class=&quot;body-unica-20-reg&quot;>&lt;span class=&quot;light-font&quot;>Ungefär en miljon människor i Sverige lever idag med en reumatisk sjukdom. Vi vill höja ambitionsnivån och fortsätta förbättra livet för alla som lever med reumatisk sjukdom&lt;/span>.&lt;/span>&lt;/p>&#xd;&#xa;"
                                    jcr:lastModified="{Date}2024-04-16T10:52:40.556-04:00"
                                    jcr:lastModifiedBy="lennglx"
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="&lt;p>Reumatism – en vanlig sjukdom med många diagnoser&lt;/p>&#xd;&#xa;"
                                    sling:resourceType="abbvie-com2/components/teaser/v2/teaser"
                                    ctaLink="/content/abbvie-com2/se/sv/patient-och-anhorig/lederna"
                                    ctaTarget="_blank"
                                    ctaText="Läs mer om reumatiska sjukdomar här"
                                    pretitle="LEDERNA"
                                    textIsRich="[true,true]"/>
                                <teaser_copy_copy_cop_1504807420
                                    cq:styleIds="[6]"
                                    jcr:created="{Date}2022-11-21T14:18:06.856-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:description="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-20-reg&quot;>Att leva med en kronisk inflammatorisk tarmsjukdom (IBD) har stor påverkan på livet. Vår ambition är att förbättra livet för alla som lever med sjukdomarna Crohns sjukdom och Ulcerös kolit.&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
                                    jcr:lastModified="{Date}2024-04-16T10:48:29.908-04:00"
                                    jcr:lastModifiedBy="lennglx"
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="&lt;p>IBD är ett samlingsnamn för kroniska tarmsjukdomar&lt;/p>&#xd;&#xa;"
                                    sling:resourceType="abbvie-com2/components/teaser/v2/teaser"
                                    ctaLink="/content/abbvie-com2/se/sv/patient-och-anhorig/mage-och-tarm"
                                    ctaTarget="_blank"
                                    ctaText="Läs mer om IBD här"
                                    pretitle="MAGE OCH TARM"
                                    textIsRich="[true,true]"/>
                                <teaser_copy_copy_cop_1654312830
                                    cq:styleIds="[6]"
                                    jcr:created="{Date}2022-11-21T14:18:06.856-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:description="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-20-reg&quot;>Mer än en halv miljon personer lever i dag med en neurologisk sjukdom. Vi strävar mot ett bättre liv för alla som påverkas av neurologisk sjukdom.&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
                                    jcr:lastModified="{Date}2024-04-16T10:47:38.880-04:00"
                                    jcr:lastModifiedBy="lennglx"
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="&lt;p>1 av 3 svenskar kommer någon gång drabbas av en hjärnsjukdom&lt;/p>&#xd;&#xa;"
                                    sling:resourceType="abbvie-com2/components/teaser/v2/teaser"
                                    ctaLink="/content/abbvie-com2/se/sv/patient-och-anhorig/nervsystemet"
                                    ctaTarget="_blank"
                                    ctaText="Läs mer om neurologiska sjukdomar här"
                                    pretitle="NERVSYSTEMET"
                                    textIsRich="[true,true]"/>
                                <teaser_copy_copy_cop_751812512
