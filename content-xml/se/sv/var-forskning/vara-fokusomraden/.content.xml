                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-18-reg&quot;>AbbVie är ett av de ledande företagen inom immunologi med mer än 20 års erfarenhet av biologiska läkemedel. Vårt fokus inom immunologi är effektiva behandlingar mot kroniska inflammatoriska led-, hud och tarmsjukdomar såsom reumatoid artrit, ankyloserande spondylit, psoriasis, psoriasisartrit, atopisk dermatit, Crohns sjukdom och ulcerös kolit.&amp;nbsp;&lt;/span>&lt;/span>&lt;br>&#xd;&#xa;&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                        </par_12>
