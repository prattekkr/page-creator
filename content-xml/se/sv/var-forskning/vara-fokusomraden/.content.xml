                                isDecorative="false"
                                titleValueFromDAM="true"/>
                            <header_copy_copy
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/header/v2/header"
                                eyebrow="Onkologi"/>
                            <text_copy_copy
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2024-02-22T02:49:13.623-05:00"
                                jcr:lastModifiedBy="lennglx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-18-reg&quot;>Vår forskning inom cancer är inriktad på att upptäcka och utveckla målstyrda behandlingar. Vi utforskar över 20 nya substanser i fler än 300 kliniska prövningar inom en rad cancerformer, däribland blodcancersjukdomarna&amp;nbsp;kronisk lymfatisk leukemi, akut myeloisk leukemi och multipelt myelom samt olika solida tumörer.&lt;/span>&lt;/span>&lt;br>&#xd;&#xa;&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                        </par_14>
