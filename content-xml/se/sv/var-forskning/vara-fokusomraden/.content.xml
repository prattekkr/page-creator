                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                langAttribute="none"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-18-reg&quot;>Vi har en bred och gedigen forskning som är inriktad på att utveckla substanser som har potential att behandla en rad&amp;nbsp;olika neurologiska sjukdomar såsom Alzheimers sjukdom, Parkinsons sjukdom, migrän, ryggmärgsskador, spasticitet efter stroke – sjukdomar som påverkar miljontals människor världen över.&amp;nbsp;&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                        </par_22>
