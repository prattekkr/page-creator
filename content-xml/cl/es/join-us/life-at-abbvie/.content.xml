                                singleExpansion="false">
                                <item_1670707208042
                                    cq:panelTitle="Todos por un AbbVie"
                                    cq:styleIds="[1659545825678]"
                                    jcr:lastModified="{Date}2024-08-23T00:59:51.091-04:00"
                                    jcr:lastModifiedBy="NANDIVX5"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Nos inspiramos, compartimos y creamos como un equipo, siempre poniendo los intereses de la compañía primero.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <item_1670707211154
                                    cq:panelTitle="Tomar decisiones inteligentes y seguras"
                                    cq:styleIds="[1659545825678]"
                                    jcr:lastModified="{Date}2024-08-23T01:00:09.723-04:00"
                                    jcr:lastModifiedBy="NANDIVX5"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p> Tomamos decisiones inteligentes para lograr los mejores resultados.&amp;nbsp;&lt;br>&#xd;&#xa;&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <item_1670707214308
                                    cq:panelTitle="Ágiles y responsables "
                                    cq:styleIds="[1659545825678]"
                                    jcr:lastModified="{Date}2024-08-23T01:04:34.211-04:00"
                                    jcr:lastModifiedBy="NANDIVX5"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p> Nos movemos rápido y asumimos las responsabilidades para que el paciente no tenga que esperar.&amp;nbsp;&lt;br>&#xd;&#xa;&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <item_1670707217700
                                    cq:panelTitle=" Honestidad y valentía "
                                    cq:styleIds="[1659545825678]"
                                    jcr:lastModified="{Date}2024-08-23T01:04:51.809-04:00"
                                    jcr:lastModifiedBy="NANDIVX5"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Mantenemos un diálogo abierto, honesto y cálido que es central a nuestro trabajo y la manera de interactuar entre nosotros.&amp;nbsp;&lt;br>&#xd;&#xa;&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <item_1670707220579
                                    cq:panelTitle=" Convertir lo posible en realidad "
                                    cq:styleIds="[1659545825678]"
                                    jcr:lastModified="{Date}2024-08-23T01:05:17.482-04:00"
                                    jcr:lastModifiedBy="NANDIVX5"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Nunca estamos satisfechos con “es suficiente” porque los pacientes confían en que nosotros daremos más.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                            </accordion>
