                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>Bij AbbVie zoeken we elke dag naar nieuwe en betere manieren om mensen over de hele wereld te helpen.&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
