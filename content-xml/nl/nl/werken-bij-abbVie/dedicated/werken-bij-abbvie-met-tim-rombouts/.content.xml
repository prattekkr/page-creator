                                <text2_copy_185866601_1856453939
                                    cq:styleIds="[1659545825678,1659545835858]"
                                    jcr:lastModified="{Date}2025-06-03T06:51:59.330-04:00"
                                    jcr:lastModifiedBy="tengcx4"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>&lt;b>Meer weten over het werken bij AbbVie?&lt;br>&#xd;&#xa; &lt;br>&#xd;&#xa;&lt;/b>Bekijk de video en luister de podcast waarin Tim dieper ingaat op zijn afgelopen zeven jaar bij AbbVie en wat het bedrijf volgens hem kenmerkt.&amp;nbsp;&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                            </container4>
