                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;body-unica-20-reg&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>Bij AbbVie zijn we niet zomaar aan het werk.&amp;nbsp;We zetten ons continu in voor goede zorg en een betere kwaliteit van leven. En de weg daar naar toe vinden we net zo belangrijk als de uitkomst zelf.&amp;nbsp;Samen werken we aan verbetering van de gezondheidszorg, maken we innovatie mogelijk en hebben we een positieve impact op de samenleving. &amp;nbsp;&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                        </container3>
