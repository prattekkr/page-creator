                                jcr:lastModifiedBy="chiucx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/container/v2/container">
                                <text
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2022-11-28T14:12:33.220-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2023-11-15T08:17:41.178-05:00"
                                    jcr:lastModifiedBy="kooycx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>We omarmen verschillende achtergronden en perspectieven over de hele wereld. Bij ons is iedereen welkom en wordt gelijk behandeld, met waardigheid en respect. Daardoor kunnen we ons allemaal optimaal inzetten.&lt;/p>&#xd;&#xa;&lt;p>We dragen met trots een steentje bij aan de gemeenschappen die we dienen, waarmee we een blijvende impact hebben op de gezondheidszorg.&amp;nbsp;Wat we doen is niet eenvoudig, maar we blijven doorgaan omdat we weten dat het levens verandert - elke dag opnieuw.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                            </container>
                        </par_12>
                    </grid_copy>
                    <accordion
                        cq:styleIds="[4,8,,,]"
                        jcr:created="{Date}2022-12-20T16:08:57.224-05:00"
                        jcr:createdBy="chiucx"
                        jcr:lastModified="{Date}2024-02-07T04:51:44.689-05:00"
