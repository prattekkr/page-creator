                                sling:resourceType="abbvie-com2/components/image/v2/image"
                                fileReference="/content/dam/abbvie-com2/images/employee/woman-looking-at screen-feature.jpg"/>
                            <header_copy
                                jcr:created="{Date}2022-12-05T17:56:57.364-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2023-12-20T07:38:11.513-05:00"
