                                jcr:lastModifiedBy="jewitca"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/image/v2/image"
                                altValueFromDAM="true"
                                displayPopupTitle="true"
                                dmPresetType="imagePreset"
                                fileReference="/content/dam/abbvie-com2/images/employee/male/man-scientist-in-lab-feature-small.jpg"
                                isDecorative="false"
                                titleValueFromDAM="true"/>
                            <header_copy_copy_cop
                                jcr:created="{Date}2022-12-05T17:56:57.364-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2023-07-17T06:31:46.915-04:00"
                                jcr:lastModifiedBy="DEVIJX1"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/header/v2/header"
                                eyebrow="Prestatie"/>
                            <text_copy_copy_copy
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2022-12-05T17:51:25.819-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2023-07-17T06:31:21.508-04:00"
                                jcr:lastModifiedBy="DEVIJX1"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>De noodzaak om meer te doen voor patiënten motiveert ons R&amp;amp;D-werk. Door te investeren in grensverleggende benaderingen, streven we ernaar programma's vooruit te helpen met een grotere kans op succes en activa sneller vooruit te helpen.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                        </par_13>
