                                jcr:created="{Date}2022-12-05T17:51:25.819-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2026-06-30T07:32:40.803-04:00"
                                jcr:lastModifiedBy="strunsx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                langAttribute="none"
                                text="&lt;p>Aan de introductie van onze geneesmiddelen gaat veel klinisch onderzoek vooraf.&amp;nbsp;AbbVie investeerde in 2025 een totaalbedrag van&amp;nbsp;€ 4.253.922 in Onderzoek &amp;amp; Ontwikkeling in Nederland, (in 2024 was dit € 5.306.028 en in 2023 €&amp;nbsp;3.010.797).&amp;nbsp;Voor klinisch onderzoek werken we samen met ca. 40 ziekenhuizen. Download de&amp;nbsp;&lt;a href=&quot;/content/dam/abbvie-com2/nl/documents/2025-abbvie-netherlands-methodological-note.pdf&quot;>Transparency Disclosure Methodological Notes&lt;/a>&amp;nbsp;om te zien wat onder de financiële ondersteuning van Onderzoek &amp;amp; Ontwikkeling valt. Bekijk&amp;nbsp;&lt;a href=&quot;/content/dam/abbvie-com2/nl/documents/2025-abbvie-netherlands-efpia-report.pdf&quot;>hier&amp;nbsp;&lt;/a>de Nederlandse data voor EFPIA transparantie rapportage.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                        </par_12>
                        <par_13
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="wcm/foundation/components/parsys">
                            <image_copy_copy_copy
                                jcr:created="{Date}2022-12-05T17:51:18.295-05:00"
                                jcr:createdBy="chiucx"
