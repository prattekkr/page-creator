                            sling:resourceType="abbvie-com2/components/button/v2/button"
                            accessibilityLabel="Bekijk onze aandachtsgebieden"
                            linkTarget="_self"
                            linkURL="/content/abbvie-com2/nl/nl/innovaties/aandachtsgebieden"/>
                    </container_427345950>
