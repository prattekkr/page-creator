                                    jcr:title="Moeilijk te behandelen aandoeningen"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h3"
                                    variant="h"/>
                                <text2
                                    cq:styleIds="[1659545825678,1659545835858]"
                                    jcr:lastModified="{Date}2024-01-31T07:53:55.192-05:00"
                                    jcr:lastModifiedBy="kooycx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>We zijn toegewijd aan het ontwikkelen van nieuwe, innovatieve oplossingen om moeilijk te behandelen neurologische aandoeningen aan te pakken. We komen steeds een stukje verder met ons neurowetenschappelijk onderzoek naar aandoeningen, zoals de ziekte van Alzheimer, migraine, de ziekte van Parkinson en spasticiteit na een beroerte.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                            </container4>
