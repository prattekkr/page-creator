                                    jcr:lastModifiedBy="chiucx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                                <image
                                    cq:styleIds="[1402843082812,1402843082822,1402843082832]"
                                    jcr:created="{Date}2022-12-17T17:37:15.547-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2024-01-16T08:25:56.313-05:00"
                                    jcr:lastModifiedBy="kooycx"
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="Oogwetenschappers van AbbVie richten zich op het bestrijden van oogziekten en het verbeteren van de zorg."
                                    sling:resourceType="abbvie-com2/components/image/v2/image"
                                    altValueFromDAM="true"
                                    displayPopupTitle="false"
                                    dmPresetType="imagePreset"
                                    fileReference="/content/dam/abbvie-com2/images/employee/woman-in-lab-holding-device.jpg"
                                    isDecorative="false"
                                    titleValueFromDAM="false"/>
                                <separator_copy
