                                    jcr:lastModifiedBy="kooycx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/image/v2/image"
                                    altValueFromDAM="true"
                                    displayPopupTitle="true"
                                    fileReference="/content/dam/abbvie-com2/nl/images/5.jpg"
                                    isDecorative="false"
                                    titleValueFromDAM="true"/>
                                <header_copy_copy_cop
                                    jcr:created="{Date}2022-12-05T17:56:57.364-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2023-12-12T08:51:25.988-05:00"
                                    jcr:lastModifiedBy="kooycx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/header/v2/header"
                                    eyebrow="Zorgoplossingen op maat"/>
                                <text_copy_copy_copy
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2022-12-05T17:51:25.819-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2023-12-12T08:52:32.342-05:00"
                                    jcr:lastModifiedBy="kooycx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Onze zorgoplossingen variëren van praktische informatie waarmee de arts of verpleegkundige de patiënt extra kan ondersteunen, op de behoefte van de patiënt afgestemd materiaal tot handige tools voor juist en op tijd medicatie innemen. We maken dit zo persoonlijk mogelijk door rekening te houden met de persoonlijke kenmerken en overtuigingen van de mensen die we helpen.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                            </par_13>
                        </grid_copy>
