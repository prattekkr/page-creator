                                    sling:resourceType="abbvie-com2/components/header/v2/header"
                                    eyebrow="Een speciaal ontwikkeld zorgprogramma"/>
                                <text_copy
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2022-12-05T17:51:25.819-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2023-12-12T08:53:42.507-05:00"
                                    jcr:lastModifiedBy="kooycx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>AbbVie Care is een zorgprogramma dat samen met patiënten, artsen en verpleegkundigen is ontwikkeld om patiënten te ondersteunen bij het gebruik van onze geneesmiddelen. Dit programma biedt betrouwbare informatie, praktische ondersteuning en handige tips zodat iemand in staat is het beste resultaat uit de behandeling te halen. We helpen mensen meer grip te krijgen op hun ziekte.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                            </par_11>
                            <par_12
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="wcm/foundation/components/parsys">
                                <image_copy_copy
                                    jcr:created="{Date}2022-12-05T17:51:18.295-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2023-12-13T08:05:01.145-05:00"
                                    jcr:lastModifiedBy="kooycx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/image/v2/image"
                                    altValueFromDAM="true"
                                    displayPopupTitle="true"
                                    fileReference="/content/dam/abbvie-com2/nl/images/1.jpg"
                                    isDecorative="false"
                                    titleValueFromDAM="true"/>
                                <header_copy_copy
                                    jcr:created="{Date}2022-12-05T17:56:57.364-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2023-12-12T08:51:08.633-05:00"
                                    jcr:lastModifiedBy="kooycx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/header/v2/header"
                                    eyebrow="Patiëntreis als uitgangspunt"/>
                                <text_copy_copy
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2022-12-05T17:51:25.819-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2023-12-12T08:51:15.704-05:00"
                                    jcr:lastModifiedBy="kooycx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Het verloop en de ervaring van een ziekte is voor iedereen anders. Daarom verdiepen we ons in de reis die iemand maakt tijdens zijn of haar behandeling: Patient Journey. Deze methode geeft ons inzicht in wat de patiënten nodig hebben: van de eerste symptomen, tot diagnose, eventuele genezing en alles ertussenin. Ook het behandeltraject en de emotionele én sociale ervaringen brengen wij in kaart.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                            </par_12>
                            <par_13
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="wcm/foundation/components/parsys">
