                            dmPresetType="imagePreset"
                            fileReference="/content/dam/abbvie-com2/nl/images/Yick Lan Lee.jpg"
                            quote="Meer weten over de Healthcare Innovation Academy? Ik kom graag met je in contact via yick.lan.lee@abbvie.com."
