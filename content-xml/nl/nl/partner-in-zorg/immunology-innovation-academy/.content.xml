                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>De Immunology Innovation Academy wordt mogelijk gemaakt door AbbVie. AbbVie heeft geen invloed gehad op de gedeelde zorginnovaties, tenzij dit expliciet wordt vermeld.&amp;nbsp;&lt;/p>&#xa;&lt;p>&amp;nbsp;&lt;/p>&#xa;"
