                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>Pharmacist working in Supply Chain QA&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
