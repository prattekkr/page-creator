                                    displayPopupTitle="false"
                                    dmPresetType="imagePreset"
                                    fileReference="/content/dam/abbvie-com2/nl/images/logo2026.png"
                                    isDecorative="false"
                                    openInNewWindow="false"
                                    titleValueFromDAM="false"/>
                            </container_1252259470>
