                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                                <text_copy
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2024-01-18T04:53:11.386-05:00"
                                    jcr:createdBy="kooycx"
                                    jcr:lastModified="{Date}2024-04-17T07:32:31.953-04:00"
                                    jcr:lastModifiedBy="KRIJGRL"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>&lt;span class=&quot;body-unica-20-reg&quot;>&lt;span class=&quot;body-unica-26-reg&quot;>&lt;b>Pijn, piekeren, ’s nachts plassen, moeilijk opstaan of stijfheid&lt;/b>&lt;br>&#xd;&#xa;&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;&lt;p>De ziekte van Parkinson kan op verschillende manieren de kwaliteit van slaap verslechteren. Zo kun je bijvoorbeeld last hebben van pijn, piekeren, ’s nachts vaak moeten plassen, moeilijk opstaan en/of stijfheid&lt;sup>2&lt;/sup>. Een passende oplossing vinden begint met het herkennen van de klachten en deze bespreken met je neuroloog of verpleegkundige. In de podcast en op de website &lt;a href=&quot;http://www.verdermetparkinson.nl/&quot; target=&quot;_blank&quot;>www.VerdermetParkinson.nl&lt;/a> vind je meer informatie en tips.&lt;/p>&#xd;&#xa;&lt;p>&lt;span class=&quot;body-unica-26-reg&quot;>&lt;b>Meer over slaapproblemen bij de ziekte van Parkinson&lt;/b>&lt;/span>&lt;/p>&#xd;&#xa;&lt;p>Naast de podcast over slaapproblemen bij de ziekte van Parkinson, biedt de website &lt;a href=&quot;http://www.verdermetparkinson.nl/&quot; target=&quot;_blank&quot;>www.VerdermetParkinson.nl&lt;/a> ook andere informatie en tips over slaapproblemen. Daarnaast vind je er bijvoorbeeld ook een vragenlijst die kan helpen bij het gesprek over slaapproblemen. Naast slaapproblemen, komen op &lt;a href=&quot;http://www.verdermetparkinson.nl/&quot; target=&quot;_blank&quot;>de website&lt;/a> ook andere aspecten aan bod die een rol spelen bij het leven met gevorderde parkinson, zoals leefstijl, relaties en behandelingen.&amp;nbsp;&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
