                            jcr:lastModified="{Date}2025-11-25T02:15:18.416-05:00"
                            jcr:lastModifiedBy="nandivx5"
                            jcr:primaryType="nt:unstructured"
                            jcr:title="Students and Early-Career Professionals"
                            sling:resourceType="abbvie-com2/components/title/v2/title"
                            type="h3"
                            variant="h"/>
                        <text
                            cq:styleIds="[1659545825678]"
                            jcr:created="{Date}2025-11-25T02:16:58.544-05:00"
                            jcr:createdBy="nandivx5"
                            jcr:lastModified="{Date}2025-11-25T02:17:16.937-05:00"
                            jcr:lastModifiedBy="nandivx5"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>Jumpstart your career at AbbVie and take on challenging work that changes lives.&lt;/p>&#xd;&#xa;&lt;p>Are you the kind of student who never gives up on a problem? Who thrives when challenged? Who finds your best ideas when&amp;nbsp;you’re&amp;nbsp;faced with the toughest problems? Then we want you.&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
                        <separator
                            cq:styleIds="[1662756456518]"
                            jcr:created="{Date}2025-11-25T02:17:27.395-05:00"
                            jcr:createdBy="nandivx5"
                            jcr:lastModified="{Date}2025-11-25T02:17:27.395-05:00"
                            jcr:lastModifiedBy="nandivx5"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                        <title_1808924005
                            cq:styleIds="[1659545825678,1661545829678]"
                            jcr:created="{Date}2025-11-25T02:17:43.307-05:00"
                            jcr:createdBy="nandivx5"
                            jcr:lastModified="{Date}2025-11-25T02:18:39.668-05:00"
                            jcr:lastModifiedBy="nandivx5"
                            jcr:primaryType="nt:unstructured"
                            jcr:title="Define your path, shape our journey"
                            sling:resourceType="abbvie-com2/components/title/v2/title"
                            type="h4"
                            variant="h"/>
                        <text_453056778
                            cq:styleIds="[1659545825678]"
                            jcr:created="{Date}2025-11-25T02:18:53.026-05:00"
                            jcr:createdBy="nandivx5"
                            jcr:lastModified="{Date}2025-11-25T02:19:30.068-05:00"
                            jcr:lastModifiedBy="nandivx5"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>We offer&amp;nbsp;interns and graduates&amp;nbsp;dynamic programmes&amp;nbsp;which&amp;nbsp;provide&amp;nbsp;personal and professional development&amp;nbsp;through rigorous, well-defined assignments, performance management&amp;nbsp;process&amp;nbsp;and opportunities to get to know the business and its leaders.&amp;nbsp;&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
                        <separator_copy
                            cq:styleIds="[1662756456518]"
                            jcr:created="{Date}2025-11-25T02:17:27.395-05:00"
                            jcr:createdBy="nandivx5"
                            jcr:lastModified="{Date}2025-11-25T02:17:27.395-05:00"
                            jcr:lastModifiedBy="nandivx5"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                        <title_1086457318
                            cq:styleIds="[1659545825678,1661545829678]"
                            jcr:created="{Date}2025-11-25T02:20:22.091-05:00"
                            jcr:createdBy="nandivx5"
                            jcr:lastModified="{Date}2025-11-25T02:20:32.369-05:00"
                            jcr:lastModifiedBy="nandivx5"
                            jcr:primaryType="nt:unstructured"
                            jcr:title="AbbVie Ireland Graduate Development Programmes"
                            sling:resourceType="abbvie-com2/components/title/v2/title"
                            type="h4"
                            variant="h"/>
                        <text_680449946
                            cq:styleIds="[1659545825678]"
                            jcr:created="{Date}2025-11-25T02:20:55.873-05:00"
                            jcr:createdBy="nandivx5"
                            jcr:lastModified="{Date}2026-03-13T12:02:39.708-04:00"
                            jcr:lastModifiedBy="singarx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            langAttribute="none"
                            text="&lt;p>The&amp;nbsp;AbbVie Graduate Development Programmes are designed to develop AbbVie’s leaders of tomorrow through differentiated rotational assignments, leadership development and learning experiences.&amp;nbsp;&lt;/p>&#xd;&#xa;&lt;p>Each formal development programme lasts two or three years, depending on the discipline. They&amp;nbsp;will&amp;nbsp;enhance your leadership capabilities, expand your functional skill set and help pave the way to your ultimate career goals. Your functional programme manager, assignment manager and mentor will help you acclimatise to our unique culture of innovation and discovery. Working collaboratively, you will help make goal-oriented decisions while you perform challenging and rewarding work alongside industry pioneers.&amp;nbsp;&lt;/p>&#xd;&#xa;&lt;p>AbbVie’s Graduate Development Programmes&amp;nbsp;will&amp;nbsp;enhance your leadership and technical capabilities, expand your functional skill set and help pave the way to your ultimate career goals.&lt;/p>&#xd;&#xa;&lt;p>These programmes include:&lt;/p>&#xd;&#xa;&lt;p>&lt;b>The Operations Development Programme (ODP)&lt;/b>&amp;nbsp;is a three-year rotational global leadership development programme. ODP career path is orientated towards head of Site and Operations roles.&lt;/p>&#xd;&#xa;&lt;p>&lt;b>The Technical Development Programme (TDP)&lt;/b>&amp;nbsp;is a three-year rotational, site-specific specialist programme designed to develop leaders for Operations and Subject Matter Experts (SMEs). TDP career path is orientated towards Senior Technical Specialists and leadership positions within Operations.&lt;/p>&#xd;&#xa;&lt;p>&lt;b>The Finance Development Programme (FDP)&lt;/b>&amp;nbsp;is a two-year rotational global programme, designed to&amp;nbsp;identify&amp;nbsp;and develop AbbVie’s future financial leaders.&lt;/p>&#xd;&#xa;&lt;p>&lt;b>The Commercial Development Programme (CDP)&lt;/b>&amp;nbsp;is a two-year rotational programme based in our Commercial Affiliate in Citywest, designed to develop future leaders and subject matter experts for our Commercial organisation.&amp;nbsp;&lt;/p>&#xd;&#xa;&lt;p>Our Development Programmes are&amp;nbsp;rotational programmes, designed to give the member an accelerated career experiences; combining experiential learning, formal&amp;nbsp;training&amp;nbsp;and regular performance management, along with coaching and mentoring.&amp;nbsp;Our&amp;nbsp;programmes will enhance your leadership and technical capabilities, expand your functional skill set and help pave the way to your ultimate career goals.&lt;/p>&#xd;&#xa;&lt;p>&lt;b>AbbVie Ireland&amp;nbsp;Internship&amp;nbsp;Programmes&amp;nbsp;&lt;/b>&lt;/p>&#xd;&#xa;&lt;p>Over the last five years,&amp;nbsp;AbbVie has been the&amp;nbsp;proud&amp;nbsp;recipient of the gold Intern programme of the year awards from&amp;nbsp;Gradireland&amp;nbsp;since 2020.&lt;/p>&#xd;&#xa;&lt;p>During&amp;nbsp;your placement, you will be given extensive opportunities to develop both professionally and personally and to engage in cultural and social corporate responsibility initiatives. You will receive extensive on the job training and&amp;nbsp;participate&amp;nbsp;in professional training courses that give all the tools needed for success. Assignments are structured in such a way as to give you the opportunity to make a measurable impact.&lt;/p>&#xd;&#xa;&lt;ul>&#xd;&#xa;&lt;li>The &lt;b>Intern&amp;nbsp;Programme&lt;/b> provides&amp;nbsp;6-15 month&amp;nbsp;placements for student Chemical Engineers, Mechanical&amp;nbsp;Engineer&amp;nbsp;and Chemists. This program is a pathway to our ODP and TDP programmes.&lt;/li>&#xd;&#xa;&lt;li>The &lt;b>APPEL Programme&lt;/b> provides&amp;nbsp;4-6 month&amp;nbsp;placement for&amp;nbsp;fourth&amp;nbsp;year Pharmacy students and is available across our Operations and Commercial sites. This programme is also a pathway to our ODP and TDP programmes.&lt;/li>&#xd;&#xa;&lt;li>The &lt;b>Co-Operative Programmes&lt;/b> provide&amp;nbsp;6-12 month&amp;nbsp;placements for students within Science, Engineering, Commercial and Support Services (e.g. HR, Finance, IT, EHS, Supply Chain etc.) disciplines. Depending on the discipline, the Co-Operative Programme may also be a pathway to our TDP programme&amp;nbsp;and also&amp;nbsp;Direct Hire roles.&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;&lt;p>Keep in touch&amp;nbsp;with your Careers Office to find out more about how you can apply for AbbVie&amp;nbsp;Internship&amp;nbsp;Programmes! &lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
