                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h4"/>
                            <text_copy_copy_copy
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2022-12-09T17:34:50.014-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2026-01-19T02:10:05.781-05:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Live for today while planning for tomorrow.&amp;nbsp;AbbVie’s&amp;nbsp;global focus on&amp;nbsp;financial&amp;nbsp;well-being can help you build and sustain your financial knowledge, take control of your current financial&amp;nbsp;situation&amp;nbsp;and&amp;nbsp;establish&amp;nbsp;a plan to achieve future financial goals.&amp;nbsp;In&amp;nbsp;Ireland, we partner with a provider who offers free educational resources across a range of financial topics.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
