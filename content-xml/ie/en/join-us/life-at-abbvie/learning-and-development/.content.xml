                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <title_1837068827
                                cq:styleIds="[1659545825678,1661545829678]"
                                jcr:created="{Date}2025-11-24T05:27:52.755-05:00"
                                jcr:createdBy="nandivx5"
                                jcr:lastModified="{Date}2025-11-24T05:28:04.031-05:00"
                                jcr:lastModifiedBy="nandivx5"
                                jcr:primaryType="nt:unstructured"
                                jcr:title=" Your development, your way"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h3"
                                variant="h"/>
                            <text_504853254
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2025-11-24T05:28:38.745-05:00"
                                jcr:createdBy="nandivx5"
                                jcr:lastModified="{Date}2025-11-24T05:29:02.012-05:00"
                                jcr:lastModifiedBy="nandivx5"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>We believe in employees owning their growth and development. Employees define their goals, and AbbVie provides resources to help achieve them. From workshops to global events, our offerings ensure your growth journey is easily accessible, personalised and tailored to your interests. &lt;/p>&#xd;&#xa;&lt;p>For example, during our award-winning annual Learn.Develop.Perform (LDP) Week, global leaders and experts share their insights on topics like collaboration, business acumen and unconscious bias. Employees curate their learning experience, choosing topics that resonate most with their goals.&lt;/p>&#xd;&#xa;&lt;p>We constantly innovate how learning is delivered. Past events have featured a 24-hour radio station, bite-sized video content through a YouTube channel and TED-style presentations&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                        </par_13>
