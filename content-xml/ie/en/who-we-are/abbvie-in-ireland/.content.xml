                                sling:resourceType="abbvie-com2/components/image/v2/image"
                                alt="westport-site-abbvie-ie"
                                altValueFromDAM="false"
                                displayPopupTitle="true"
                                dmPresetType="imagePreset"
                                fileReference="/content/dam/abbvie-com2/ie/images/Westport-Site-AbbVie-ie.jpg"
                                isDecorative="false"
                                openInNewWindow="false"
                                titleValueFromDAM="true"/>
                            <separator_122209139
                                jcr:created="{Date}2026-03-09T14:42:40.650-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2026-03-09T14:42:40.650-04:00"
                                jcr:lastModifiedBy="singarx"
