                                jcr:title="AbbVie Dublin – Citywest"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                langAttribute="none"
                                type="h1"
                                variant="h"/>
                            <text_887584649
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2026-03-09T14:48:43.752-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2026-03-09T14:49:29.649-04:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                langAttribute="none"
                                text="&lt;p>The company’s commercial offices are located at the Citywest office campus, west Dublin. Close to 100 people work here overseeing the sale, supply, distribution and marketing of the company’s licensed products in Ireland.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
