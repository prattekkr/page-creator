                                dmPresetType="imagePreset"
                                fileReference="/content/dam/abbvie-com2/ie/images/sligo-ballytivan.jpg"
                                isDecorative="false"
                                openInNewWindow="false"
                                titleValueFromDAM="true"/>
                            <separator_366712139
