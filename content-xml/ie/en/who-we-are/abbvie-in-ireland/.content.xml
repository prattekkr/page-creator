                                jcr:primaryType="nt:unstructured"
                                jcr:title="AbbVie Sligo – Manorhamilton Road"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                langAttribute="none"
                                type="h1"
                                variant="h"/>
                            <text_1975721155
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2026-03-09T14:16:59.036-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2026-03-25T13:34:35.865-04:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                langAttribute="none"
                                text="&lt;p>AbbVie operates two separate plants in Sligo employing approximately 700 people.&amp;nbsp;The company’s high containment facility on the Manorhamilton Road was established in 2002 and has dedicated capabilities for potent active pharmaceutical ingredient and drug product manufacturing.&lt;/p>&#xd;&#xa;&lt;p>The quality control labs are equipped with the latest design technology for chemical and microbiological analytical testing to meet customers’ needs. Since inception, the site has undergone a significant expansion that doubled its footprint and provided additional capability to support AbbVie’s new product introductions.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <image
                                jcr:created="{Date}2026-03-09T14:17:09.962-04:00"
