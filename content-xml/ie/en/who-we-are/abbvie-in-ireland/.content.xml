                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;sup>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>AbbVie&amp;nbsp;is a global, research-driven pharmaceutical company.&amp;nbsp;Through&amp;nbsp;our&amp;nbsp;diverse and innovative&amp;nbsp;portfolio&amp;nbsp;of medicines and approaches,&amp;nbsp;we&amp;nbsp;seek&amp;nbsp;to&amp;nbsp;create impact for patients, health systems and the&amp;nbsp;Irish&amp;nbsp;economy.&lt;/span>&lt;/span>&lt;/sup>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                        </container3>
