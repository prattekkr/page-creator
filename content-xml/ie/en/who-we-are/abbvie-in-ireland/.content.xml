                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <title_136629138
                                cq:styleIds="[1659545825678,1651545825694]"
                                jcr:created="{Date}2026-03-09T14:42:47.482-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2026-03-09T14:52:42.160-04:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="AbbVie North Dublin"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                langAttribute="none"
                                type="h1"
                                variant="h"/>
                            <text_1357108874
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2026-03-09T14:42:52.663-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2026-03-09T14:44:37.675-04:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                langAttribute="none"
                                text="&lt;p>The AbbVie pharmaceutical manufacturing site in north Dublin was established in 1994. This location specialises in the manufacture of tablets and capsules, primarily in the therapeutic areas of neuroscience and gastrointestinal conditions. This location’s manufacturing capability extends across a range of technologies, including multiple releases and a range of manufacturing techniques, to deliver on a broad portfolio of capsules and tablets.&lt;/p>&#xd;&#xa;&lt;p>The site recently underwent a significant refurbishment and is now also an international base for a range of supply chain, manufacturing and engineering services. AbbVie North Dubin now supports AbbVie plants all around the world.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <image_1628840754
                                jcr:created="{Date}2026-03-09T14:43:02.941-04:00"
                                jcr:createdBy="singarx"
