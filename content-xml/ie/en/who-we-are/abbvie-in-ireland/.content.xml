                                jcr:primaryType="nt:unstructured"
                                jcr:title="AbbVie Sligo – Ballytivnan"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                langAttribute="none"
                                type="h1"
                                variant="h"/>
                            <text_126430864
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2026-03-09T14:23:53.244-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2026-03-09T14:25:35.550-04:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                langAttribute="none"
                                text="&lt;p>AbbVie has a second manufacturing site in Sligo at Ballytivnan. Founded in 1974, this plant is now a global centre of excellence for design control and precision engineering in the production of drug delivery devices.&lt;/p>&#xd;&#xa;&lt;p>AbbVie recently completed a €113 million expansion in oncology-focused manufacturing technology (aseptic filling, lyophilisation and finishing) at the Ballytivnan site. The investment in new sterile manufacturing capability has added approximately 100 new jobs in a variety of technical and manufacturing positions.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <image_997044064
                                jcr:created="{Date}2026-03-09T14:24:15.967-04:00"
