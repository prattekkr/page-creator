                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;ul>&#xd;&#xa;&lt;li>2025 ‘Pharma Company of the Year – Large’ and ‘Biopharma Company of the Year’ at the Irish Pharma Industry Awards&lt;/li>&#xd;&#xa;&lt;li>2025 ‘Green Large Organisation of the Year (1000+ Employees)’ at the Green Awards&lt;/li>&#xd;&#xa;&lt;li>2024 ‘Sustainable Energy Achievement Award’ and ‘Green Lifesciences Award’ at the Green Awards&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;li>2023&lt;b>&amp;nbsp;&lt;/b>‘Green Pharmaceutical Award’ at the Green Awards&lt;/li>&#xd;&#xa;&lt;li>2021 Irish Pharma Industry Awards ‘Sustainability Initiative of the Year’&lt;/li>&#xd;&#xa;&lt;li>2020 Corporate Social Responsibility Initiative of the Year Award at the&amp;nbsp;Facilities Management Awards&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;li>2019 American Chamber of Commerce Créafóg Award (North West)&lt;/li>&#xd;&#xa;&lt;li>2019 Green Award in the Sustainable Energy Management category&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;li>2018 Irish Pharma Industry Awards ‘Biopharmaceutical Company of the Year’&amp;nbsp;&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;li>2018 Green Pharmaceutical Company at the Green Awards&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;li>2017 ‘Responsible Care Award’ at the Irish Pharma Industry Awards&lt;/li>&#xd;&#xa;&lt;li>2015 AEE Award for Corporate Energy Management in Western Europe&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;li>2015 SEAI Award in the Large Industry Category&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;li>2015 Green Award in the Sustainable Energy Management&amp;nbsp;category&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;li>2014 Chambers Ireland CSR Award for Heat Recovery Programme&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;"
                            textIsRich="true"/>
