                            jcr:createdBy="singarx"
                            jcr:lastModified="{Date}2026-05-26T17:18:31.977-04:00"
                            jcr:lastModifiedBy="VALENSX5"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            langAttribute="none"
                            text="&lt;p>&lt;span class=&quot;body-unica-18-reg&quot;>&lt;b>AbbVie is committed to transparency in all of its interactions with healthcare professionals (HCPs), healthcare organisations (HCOs) and patient associations.&lt;/b>&lt;/span>&lt;b>&lt;span class=&quot;body-unica-18-reg&quot;>&lt;br />&#xd;&#xa; &lt;br />&#xd;&#xa; &lt;/span>&lt;/b>We believe partnerships with healthcare professionals, healthcare organisations and patient organisations bring value to patient care.&lt;br />&#xd;&#xa;&lt;br />&#xd;&#xa;For information about the disclosure of transfers for value to healthcare professionals and healthcare organisations in Ireland, please see &lt;a href=&quot;https://www.transferofvalue.ie/&quot;>Transfer of Value&lt;/a>&lt;br />&#xd;&#xa;&lt;br />&#xd;&#xa;&lt;a href=&quot;/content/dam/abbvie-com2/ie/documents/abbvie-ireland-patient-organisation-tov-declaration%202025.pdf&quot;>AbbVie in Ireland Transfer of Value (TOV) for patient organisation 2025&lt;/a>&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
