                                    jcr:lastModified="{Date}2025-11-20T04:30:45.208-05:00"
                                    jcr:lastModifiedBy="nandivx5"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>Committed&amp;nbsp;to Good Clinical Practice&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <text_copy
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2022-11-28T14:12:33.220-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2025-10-29T04:03:16.569-04:00"
                                    jcr:lastModifiedBy="singarx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Throughout the clinical trials process, patients remain our highest priority. Good Clinical Practice (GCP) is a global ethical and scientific quality standard for designing, conducting, recording and reporting clinical trials. Compliance with this standard provides public assurance that the rights, safety and well-being of trial subjects are protected, consistent with global ethical standards and regulatory requirements. Compliance also assures the credibility of the clinical data. AbbVie is committed to ensuring Good Clinical Practice is strictly adhered to within all AbbVie-sponsored clinical trials.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <separator_copy
                                    cq:styleIds="[1662756486159]"
                                    jcr:created="{Date}2022-12-18T15:12:02.543-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2022-12-18T15:12:02.543-05:00"
                                    jcr:lastModifiedBy="chiucx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                                <text_2119661798_copy
                                    jcr:created="{Date}2025-11-20T04:35:21.309-05:00"
                                    jcr:createdBy="nandivx5"
                                    jcr:lastModified="{Date}2025-11-20T05:04:04.378-05:00"
                                    jcr:lastModifiedBy="nandivx5"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>Join&amp;nbsp;our clinical trial site network&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <text_1843484495_copy
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2025-11-20T05:19:09.602-05:00"
                                    jcr:createdBy="nandivx5"
                                    jcr:lastModified="{Date}2025-11-20T05:19:42.416-05:00"
                                    jcr:lastModifiedBy="nandivx5"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>AbbVie partners with leading scientific and medical professionals around the world and in&amp;nbsp;Ireland&amp;nbsp;to conduct clinical trials. We value the significant contributions that our scientific and medical professional partners make to our scientific innovation. AbbVie is committed to&amp;nbsp;establishing&amp;nbsp;collaborative partnerships to continuously grow our clinical trial site network.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <button_copy_copy
                                    cq:styleIds="[1659997756584]"
                                    jcr:created="{Date}2025-10-29T04:08:04.220-04:00"
                                    jcr:createdBy="singarx"
                                    jcr:lastModified="{Date}2026-01-19T06:30:08.838-05:00"
                                    jcr:lastModifiedBy="singarx"
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="Become a clinical trial investigator "
                                    sling:resourceType="abbvie-com2/components/button/v2/button"
                                    accessibilityLabel="Become a clinical trial investigator "
                                    linkTarget="_blank"
                                    linkURL="https://investigatorinquiry.abbvie.net/"/>
                                <separator
                                    jcr:created="{Date}2026-03-10T11:16:58.433-04:00"
                                    jcr:createdBy="singarx"
                                    jcr:lastModified="{Date}2026-03-10T11:16:58.433-04:00"
                                    jcr:lastModifiedBy="singarx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                                <text_27598641_copy
                                    jcr:created="{Date}2025-11-20T05:21:17.062-05:00"
                                    jcr:createdBy="nandivx5"
                                    jcr:lastModified="{Date}2025-11-20T05:21:38.861-05:00"
                                    jcr:lastModifiedBy="nandivx5"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>Investigator-Initiated Studies (IIS)&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <text_copy_copy
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2022-11-28T14:12:33.220-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2025-10-29T04:09:58.745-04:00"
                                    jcr:lastModifiedBy="singarx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>We’re committed to supporting investigator-initiated research that promotes the advancement of medical and scientific knowledge involving AbbVie’s products and therapeutic areas of interest.&amp;nbsp;&lt;br>&#xd;&#xa;&amp;nbsp;&lt;br>&#xd;&#xa;Our Investigator-Initiated Studies (IIS) Programme, is open to academic and community based healthcare professionals and researchers globally to apply for research support.&amp;nbsp;&lt;br>&#xd;&#xa;&amp;nbsp;&lt;br>&#xd;&#xa;If you’re an investigator, you can learn more about our research areas of interest and application process by visiting our global website. &lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <button_copy_copy_1205955254
                                    cq:styleIds="[1659997756584]"
                                    jcr:created="{Date}2022-12-31T15:31:46.585-05:00"
                                    jcr:createdBy="chiucx"
