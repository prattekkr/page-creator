                            <text_1681235449_copy
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2025-04-21T11:17:49.833-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2026-02-18T05:58:11.060-05:00"
                                jcr:lastModifiedBy="veigaix"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Caso não consiga submeter o pedido através do botão acima, deverá enviar o pedido formal de donativo para &lt;a href=&quot;mailto:OEC.Portugal@abbvie.com?subject=Pedido%20de%20Donativo&quot;>OEC.Portugal@abbvie.com&lt;/a> com o assunto &amp;quot;Pedido de Donativo&amp;quot;.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
