                                    type="h2"
                                    variant="h"/>
                                <text_copy
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2024-11-13T04:08:53.107-05:00"
                                    jcr:createdBy="singarx"
                                    jcr:lastModified="{Date}2024-11-13T04:09:19.040-05:00"
                                    jcr:lastModifiedBy="singarx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Com cada nova descoberta, criamos uma compreensão melhor de como os doentes são diferentes — mesmo aqueles que são diagnosticados com a mesma doença — para que possamos desenvolver abordagens mais personalizadas para doenças imunomediadas. &lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
