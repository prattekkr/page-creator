                            singleExpansion="false">
                            <item_1731569571215
                                cq:panelTitle="Olho seco  "
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2024-11-14T02:35:37.581-05:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Com sintomas característicos como ardor, comichão ou irritação nos olhos, lacrimejamento excessivo, visão turva ou cansada, o olho seco é uma doença crônica que pode ser causada por idade avançada, uso de lentes de contato, outras doenças oculares e condições médicas ou até mesmo fatores ambientais.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <item_1731569574903
                                cq:panelTitle="Edema Macular Diabético  "
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2024-11-14T02:36:11.414-05:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>É uma complicação ligada à diabetes, sendo a principal causa de cegueira nestes doentes. A sua evolução é lenta e progressiva, levando a uma visão turva e deformação das imagens.&amp;nbsp;&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                        </accordion>
