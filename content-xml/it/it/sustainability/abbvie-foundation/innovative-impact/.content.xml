                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;b>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>La Fondazione AbbVie è un catalizzatore di cambiamento: accelerare l'innovazione è essenziale per il nostro impatto.&lt;/span>&lt;/span>&lt;/b>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator
                                cq:styleIds="[1662756456518]"
                                jcr:created="{Date}2024-04-22T11:58:18.748-04:00"
