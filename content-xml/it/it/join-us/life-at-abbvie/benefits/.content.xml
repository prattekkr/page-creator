                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <text_230942827
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2022-12-10T17:10:30.657-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2026-01-21T11:20:08.600-05:00"
                                jcr:lastModifiedBy="MONTIIX"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>I nostri programmi di compensation, benefit e well-being sono pensati per supportare esigenze diversificate e in continua evoluzione in ogni fase della carriera e della vita. Offriamo riconoscimenti e benefit distintivi e competitivi. Alcuni programmi possono variare in base al paese.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
