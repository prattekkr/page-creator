                                variant="h"/>
                            <text_copy_copy
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2022-12-09T17:34:50.014-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2026-01-12T10:46:52.975-05:00"
                                jcr:lastModifiedBy="MONTIIX"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&amp;nbsp;&lt;/p>&#xd;&#xa;&lt;p>Ci impegniamo a promuovere l'equità, l'uguaglianza, la diversità e l'inclusione (EED&amp;amp;I). È un principio fondamentale della nostra identità. Questo per noi include il valore attribuito a prospettive diverse, la creazione di una cultura inclusiva e il trattamento di tutti i dipendenti con dignità e rispetto.&lt;/p>&#xd;&#xa;&lt;p>&lt;b>Permettendoci di raggiungere il nostro meglio…&lt;/b>&lt;/p>&#xd;&#xa;&lt;p>In AbbVie, avere una cultura diversificata e inclusiva è un imperativo aziendale. Ci impegniamo ad agire con integrità, promuovere l'innovazione, trasformare le vite, servire la nostra comunità e abbracciare la diversità e l'inclusione. Non è solo la cosa giusta da fare: rafforza la nostra capacità di innovare ed è fondamentale per la nostra capacità di ottenere risultati oggi e in futuro.&lt;/p>&#xd;&#xa;&lt;p>&lt;b>…così possiamo avere un impatto significativo sulla vita delle persone.&lt;/b>&lt;/p>&#xd;&#xa;&lt;p>Sviluppare e portare ai pazienti farmaci innovativi e rivoluzionari richiede diversità di pensiero e la diversità di pensiero nasce da una forza lavoro diversificata. È inoltre importante sottolineare che serviamo una grande varietà di pazienti in tutto il mondo, ed è fondamentale che, come azienda, li rappresentiamo e diamo loro voce.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                        </par_12>
