                            <container4_copy_copy
                                cq:styleIds="[1653545847150,1653242825678,1653545835879,1653545835982,1653545825686]"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/container/v2/container">
                                <title2
                                    cq:styleIds="[1651545824678,1651545825692,1659545825678]"
                                    jcr:lastModified="{Date}2026-01-09T11:28:03.033-05:00"
                                    jcr:lastModifiedBy="MONTIIX"
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="Aree di focus in oncologia"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h3"
                                    variant="h"/>
                                <text2
                                    cq:styleIds="[1659545825678,1659545835858]"
                                    jcr:lastModified="{Date}2026-01-09T11:28:10.619-05:00"
                                    jcr:lastModifiedBy="MONTIIX"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Ci impegniamo a trovare soluzioni che trasformino il trattamento oncologico. Puntiamo a ottenere risultati migliori e più duraturi sia nei tumori del sangue che in quelli solidi. La nostra cultura della curiosità ci guida nella scoperta di nuove e innovative strategie terapeutiche&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <separator
                                    cq:styleIds="[1662756486159]"
                                    jcr:created="{Date}2022-12-18T09:01:55.660-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2022-12-18T09:01:55.660-05:00"
                                    jcr:lastModifiedBy="chiucx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                                <title2_copy
                                    cq:styleIds="[1659545825678,1651545824678]"
                                    jcr:lastModified="{Date}2026-01-09T11:28:22.490-05:00"
                                    jcr:lastModifiedBy="MONTIIX"
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="Tumori del sangue"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h4"
                                    variant="h"/>
                                <text2_copy
                                    cq:styleIds="[1659545825678,1659545835858]"
                                    jcr:lastModified="{Date}2026-01-09T11:28:30.449-05:00"
                                    jcr:lastModifiedBy="MONTIIX"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>I tumori del sangue colpiscono i tessuti ematopoietici (come il midollo osseo) e compromettono la capacità del corpo di combattere le infezioni. Tra le principali forme osservate vi sono leucemia, linfoma e mieloma.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <separator_165917366
                                    cq:styleIds="[1662756423318]"
                                    jcr:created="{Date}2022-12-18T09:21:43.017-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2022-12-18T09:21:43.017-05:00"
                                    jcr:lastModifiedBy="chiucx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                                <accordion_copy_copy
                                    cq:styleIds="[1653545835881,1]"
                                    jcr:created="{Date}2022-12-17T16:25:09.442-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2026-02-09T04:24:11.549-05:00"
                                    jcr:lastModifiedBy="MONTIIX"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/accordion/v2/accordion"
                                    heading="Le nostre aree di focus"
                                    headingElement="h5"
                                    singleExpansion="false">
                                    <item_1671312472873
                                        cq:panelTitle="Leucemia Mieloide Acuta (LMA)"
                                        cq:styleIds="[1659545825678]"
                                        jcr:lastModified="{Date}2026-01-09T11:29:35.357-05:00"
                                        jcr:lastModifiedBy="MONTIIX"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="abbvie-com2/components/text/v2/text"
                                        text="&lt;p>L’LMA è uno dei tumori del sangue più aggressivi e difficili da trattare, con un tasso di sopravvivenza molto basso e poche opzioni terapeutiche per i pazienti non idonei alla chemioterapia intensiva.&lt;/p>&#xd;&#xa;"
                                        textIsRich="true"/>
                                    <item_1671312475801
                                        cq:panelTitle="Leucemia Linfoblastica Acuta (LLA)"
                                        cq:styleIds="[1659545825678]"
                                        jcr:lastModified="{Date}2026-01-09T11:29:48.334-05:00"
                                        jcr:lastModifiedBy="MONTIIX"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="abbvie-com2/components/text/v2/text"
                                        text="&lt;p>La LLA si sviluppa quando il midollo osseo produce un numero eccessivo di linfociti immaturi (globuli bianchi).&lt;/p>&#xd;&#xa;"
                                        textIsRich="true"/>
                                    <item_1671312481387
                                        cq:panelTitle="Leucemia Linfatica Cronica (LLC)"
                                        cq:styleIds="[1659545825678]"
                                        jcr:lastModified="{Date}2026-01-09T11:30:00.278-05:00"
                                        jcr:lastModifiedBy="MONTIIX"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="abbvie-com2/components/text/v2/text"
                                        text="&lt;p>La LLC è un tumore del sangue a crescita lenta in cui il midollo osseo produce un numero eccessivo di linfociti, un tipo di globuli bianchi.&lt;/p>&#xd;&#xa;"
                                        textIsRich="true"/>
                                    <item_1671372277563
                                        cq:panelTitle="Linfoma Diffuso a Grandi Cellule B (DLBCL)"
                                        cq:styleIds="[1659545825678]"
                                        jcr:lastModified="{Date}2026-01-09T11:30:14.413-05:00"
                                        jcr:lastModifiedBy="MONTIIX"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="abbvie-com2/components/text/v2/text"
                                        text="&lt;p>Il DLBCL è il tipo più comune di linfoma non-Hodgkin (NHL) negli Stati Uniti e nel mondo. L’incidenza aumenta generalmente con l’età, con la maggior parte dei pazienti diagnosticati oltre i 60 anni.&lt;/p>&#xd;&#xa;"
                                        textIsRich="true"/>
                                    <item_1671372299968
                                        cq:panelTitle="Mieloma Multiplo (MM)"
                                        cq:styleIds="[1659545825678]"
                                        jcr:lastModified="{Date}2026-01-09T11:30:29.371-05:00"
                                        jcr:lastModifiedBy="MONTIIX"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="abbvie-com2/components/text/v2/text"
                                        text="&lt;p>Il MM è un tumore delle plasmacellule, spesso caratterizzato da cicli ricorrenti di recidiva e remissione. È il secondo tumore del sangue più comune.&lt;/p>&#xd;&#xa;"
                                        textIsRich="true"/>
                                    <item_1671372303344
                                        cq:panelTitle="Sindromi Mielodisplastiche (SMD)"
                                        cq:styleIds="[1659545825678]"
                                        jcr:lastModified="{Date}2026-01-09T11:30:43.002-05:00"
                                        jcr:lastModifiedBy="MONTIIX"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="abbvie-com2/components/text/v2/text"
                                        text="&lt;p>Le SMD sono un gruppo di patologie ematologiche caratterizzate da uno sviluppo anomalo delle cellule del sangue nel midollo osseo, considerate neoplasie.&lt;/p>&#xd;&#xa;"
                                        textIsRich="true"/>
                                    <item_1770629048801
                                        cq:panelTitle="Linfoma Follicolare"
                                        cq:styleIds="[1659545825678]"
                                        jcr:lastModified="{Date}2026-02-09T04:24:25.912-05:00"
                                        jcr:lastModifiedBy="MONTIIX"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="abbvie-com2/components/text/v2/text"
                                        text="&lt;p>Il Linfoma follicolare cresce lentamente, spesso non dà sintomi per molto tempo e tende ad avere un decorso cronico.&lt;/p>&#xd;&#xa;"
                                        textIsRich="true"/>
                                </accordion_copy_copy>
