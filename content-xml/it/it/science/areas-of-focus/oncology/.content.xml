                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>Lavoriamo insieme per affrontare le sfide più difficili in oncologia con un unico obiettivo: avere un impatto significativo sulla vita dei pazienti migliorando la loro qualità.&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
