                                jcr:lastModifiedBy="MONTIIX"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>Oltre alle nostre aree terapeutiche principali, i nostri ricercatori studiano un insieme diversificato di malattie ad alto bisogno non soddisfatto, dove crediamo sia possibile un grande progresso per i pazienti.&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                        </container3>
                    </container2>
                    <grid_copy_copy
                        cq:styleIds="[1653545835880]"
                        jcr:lastModified="{Date}2026-04-07T10:40:21.296-04:00"
