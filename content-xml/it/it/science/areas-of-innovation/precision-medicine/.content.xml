                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="Creare il farmaco giusto per il paziente giusto"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h3"
                                    variant="h"/>
                                <text_copy_copy
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2022-12-07T14:53:09.069-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2026-01-21T04:20:31.063-05:00"
                                    jcr:lastModifiedBy="MONTIIX"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>La medicina di precisione ha rivoluzionato il modo in cui i pazienti oncologici vengono diagnosticati e trattati. Ora stiamo portando i principi della medicina di precisione un passo oltre, per combattere le malattie in ambito immunologico, neuroscientifico e nell’oftalmologia.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <separator
