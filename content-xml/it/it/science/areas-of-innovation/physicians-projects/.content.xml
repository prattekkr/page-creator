                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>In AbbVie ci impegniamo costantemente a identificare e implementare soluzioni digitali all'avanguardia per offrire supporto e informazioni e avere un impatto significativo sulla vita dei pazienti.&lt;/p>&#xd;&#xa;"
