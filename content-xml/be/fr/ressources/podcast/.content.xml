                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>Le podcast qui donne la parole aux patients&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
