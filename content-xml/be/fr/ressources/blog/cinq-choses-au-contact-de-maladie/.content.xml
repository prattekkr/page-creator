                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>En tant qu’infirmière, Mary Neumann aide les patients atteints d’une affection cutanée chronique à s’y retrouver dans leur parcours de soins.&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
