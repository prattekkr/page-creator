                        <par_12
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="wcm/foundation/components/parsys">
                            <container4
                                cq:styleIds="[1653545847150,1653242825678,1653545835982,1653545825683]"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/container/v2/container">
                                <text2_copy
                                    cq:styleIds="[1659545825678,1659545835858]"
                                    jcr:lastModified="{Date}2024-08-26T17:42:19.450-04:00"
                                    jcr:lastModifiedBy="washidx10"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>&lt;b>En Belgique, on estime que 30.000 personnes sont atteintes de MICI, 20.000 personnes souffrant de la maladie de Crohn et 10.000 personnes de la colite ulcéreuse.&lt;sup>2&lt;/sup>&amp;nbsp;Présentant de nombreuses similitudes, ces deux affections sont pourtant différentes et nécessitent un traitement adapté. Comment faire la différence&amp;nbsp;? Quel est leur impact sur la vie quotidienne&amp;nbsp;? Et quels résultats peut-on attendre des traitements actuels&amp;nbsp;?&lt;/b>&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <separator_copy
                                    cq:styleIds="[1662756456518]"
                                    jcr:created="{Date}2024-08-26T17:33:20.630-04:00"
                                    jcr:createdBy="washidx10"
                                    jcr:lastModified="{Date}2024-08-26T17:33:20.630-04:00"
                                    jcr:lastModifiedBy="washidx10"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                                <title2
                                    cq:styleIds="[1659545825678,1651545824678,1661545829678]"
                                    jcr:lastModified="{Date}2024-08-26T17:41:47.451-04:00"
                                    jcr:lastModifiedBy="washidx10"
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="Les intestins comme cible principale"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h2"
                                    variant="h"/>
                                <text2_copy_1098948873
                                    cq:styleIds="[1659545825678,1659545835858]"
                                    jcr:lastModified="{Date}2024-12-16T14:11:52.783-05:00"
                                    jcr:lastModifiedBy="BAUFAAX"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>La&lt;b>&amp;nbsp;maladie de Crohn (MC)&lt;/b>&amp;nbsp;et la&amp;nbsp;&lt;b>colite ulcéreuse (CU)&lt;/b>&amp;nbsp;sont généralement diagnostiquées entre 15 et 35 ans, bien qu’elles puissent survenir à tout âge.&lt;sup>3&lt;/sup>&amp;nbsp;Il s’agit de&amp;nbsp;&lt;b>maladies auto-immunes&lt;/b>&amp;nbsp;qui peuvent progresser de manière imprévisible et s’aggraver avec le temps. Un diagnostic précoce et la mise en place d’un traitement adapté sont essentiels&amp;nbsp;:&amp;nbsp;&lt;b>ils&amp;nbsp;contrôlent la progression de la maladie et peuvent améliorer les résultats à long terme&lt;/b>.&lt;sup>4&lt;/sup>&lt;/p>&#xd;&#xa;&lt;p>Généralement, la CU est de nature plus localisée que la MC. La colite ulcéreuse provoque une inflammation continue des muqueuses s’étendant de manière variable du rectum au côlon.&lt;sup>5&lt;/sup>&amp;nbsp;La MC, quant à elle, entraine une inflammation qui peut toucher toutes les parties du système digestif, de la bouche à l’anus.&lt;sup>6&lt;/sup>&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <separator_copy_1305948102
                                    cq:styleIds="[1662756456518]"
                                    jcr:created="{Date}2024-08-26T17:33:20.630-04:00"
