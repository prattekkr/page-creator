                            <container4
                                cq:styleIds="[1653545847150,1653242825678,1653545835982,1653545825683]"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/container/v2/container">
                                <title
                                    cq:styleIds="[1659545825678,1651545825678]"
                                    jcr:created="{Date}2026-03-03T04:32:26.327-05:00"
                                    jcr:createdBy="BAUFAAX"
                                    jcr:lastModified="{Date}2026-03-03T04:32:48.989-05:00"
                                    jcr:lastModifiedBy="BAUFAAX"
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="Un impact significatif sur la vie professionnelle et personnelle"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h2"
                                    variant="h"/>
                                <text2
                                    cq:styleIds="[1659545825678,1659545835858]"
                                    jcr:lastModified="{Date}2026-03-03T04:38:49.187-05:00"
                                    jcr:lastModifiedBy="BAUFAAX"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>&lt;span class=&quot;body-unica-26-reg&quot;>Les résultats belges mettent en évidence une charge importante&lt;sup>2:&lt;/sup>&lt;/span>&lt;/p>&#xd;&#xa;&lt;ul>&#xd;&#xa;&lt;li>&lt;span class=&quot;body-unica-26-reg&quot;>Près de&amp;nbsp;90 % des participantes déclarent que leurs crises ont déjà limité leur capacité à travailler, étudier ou assurer leurs activités quotidiennes.&lt;/span>&lt;/li>&#xd;&#xa;&lt;li>&lt;span class=&quot;body-unica-26-reg&quot;>37 % rapportent des maux de tête au moins 9 jours par mois&lt;/span>&lt;ul>&#xd;&#xa;&lt;li>&lt;span class=&quot;body-unica-26-reg&quot;>24,6 % entre 9 et 14 jours&lt;/span>&lt;/li>&#xd;&#xa;&lt;li>&lt;span class=&quot;body-unica-26-reg&quot;>12,4 % 15 jours ou plus&lt;/span>&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;&lt;/li>&#xd;&#xa;&lt;li>&lt;span class=&quot;body-unica-26-reg&quot;>Une majorité décrit des symptômes associés tels que des nausées et une forte sensibilité à la lumière.&lt;/span>&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;&lt;p>&lt;span class=&quot;body-unica-26-reg&quot;>Pour une proportion significative des répondantes, la migraine est donc une condition récurrente.&lt;/span>&lt;/p>&#xd;&#xa;&lt;p>&lt;span class=&quot;body-unica-26-reg&quot;>Dans notre saison de podcast &lt;i>&lt;a href=&quot;https://www.abbvie.be/fr/ressources/podcast/parlons-en-saison-4.html&quot; target=&quot;_blank&quot;>consacrée à la migraine&lt;/a>&lt;/i>, une patiente évoquait l’impact concret de ses crises sur sa vie familiale et professionnelle : nécessité de s’isoler dans l’obscurité, difficulté à se concentrer, impossibilité d’être présente à certains moments importants. Un vécu qui semble être partagé par les répondantes.&amp;nbsp;&lt;/span>&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <separator_copy_1880015361
                                    cq:styleIds="[1662756456518]"
                                    jcr:created="{Date}2024-08-26T18:47:52.384-04:00"
                                    jcr:createdBy="washidx10"
                                    jcr:lastModified="{Date}2024-08-26T18:47:52.384-04:00"
                                    jcr:lastModifiedBy="washidx10"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                                <title_copy
                                    cq:styleIds="[1659545825678,1651545825678]"
                                    jcr:created="{Date}2026-03-03T04:32:26.327-05:00"
                                    jcr:createdBy="BAUFAAX"
                                    jcr:lastModified="{Date}2026-03-03T04:39:38.944-05:00"
                                    jcr:lastModifiedBy="BAUFAAX"
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="Un diagnostic et une prise en charge encore incomplets"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h2"
                                    variant="h"/>
                                <text2_copy
                                    cq:styleIds="[1659545825678,1659545835858]"
                                    jcr:lastModified="{Date}2026-03-03T05:20:49.061-05:00"
                                    jcr:lastModifiedBy="BAUFAAX"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>&lt;span class=&quot;body-unica-26-reg&quot;>Malgré cet impact :&lt;/span>&lt;/p>&#xd;&#xa;&lt;ul>&#xd;&#xa;&lt;li>&lt;span class=&quot;body-unica-26-reg&quot;>Seules 50,9 % des participantes indiquent avoir reçu un diagnostic formel de migraine.&lt;sup>2&lt;/sup>&lt;/span>&lt;/li>&#xd;&#xa;&lt;li>&lt;span class=&quot;body-unica-26-reg&quot;>62,7 % ont consulté un médecin.&lt;sup>2&lt;/sup>&lt;/span>&lt;/li>&#xd;&#xa;&lt;li>&lt;span class=&quot;body-unica-26-reg&quot;>43,7% déclarent ne pas avoir reçu de traitement spécifique.&lt;sup>2&lt;/sup>&lt;/span>&lt;/li>&#xd;&#xa;&lt;li>&lt;span class=&quot;body-unica-26-reg&quot;>84,9 % indiquent s’auto-traiter.&amp;nbsp;&lt;sup>2&lt;/sup>&lt;/span>&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;&lt;p>&lt;span class=&quot;body-unica-26-reg&quot;>Lorsque des traitements sont prescrits, leur efficacité est jugée variable.&lt;sup>2&lt;/sup> Ces éléments font écho à la littérature scientifique, qui souligne que la migraine reste encore sous-diagnostiquée et parfois insuffisamment prise en charge, en particulier chez les femmes³.&lt;/span>&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <title_copy_copy
                                    cq:styleIds="[1659545825678,1651545825678]"
                                    jcr:created="{Date}2026-03-03T04:32:26.327-05:00"
                                    jcr:createdBy="BAUFAAX"
                                    jcr:lastModified="{Date}2026-03-03T04:43:37.052-05:00"
                                    jcr:lastModifiedBy="BAUFAAX"
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="Une affection neurologique influencée par des facteurs hormonaux"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h2"
                                    variant="h"/>
                                <text2_copy_copy
                                    cq:styleIds="[1659545825678,1659545835858]"
                                    jcr:lastModified="{Date}2026-03-03T10:36:00.321-05:00"
                                    jcr:lastModifiedBy="BAUFAAX"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>&lt;span class=&quot;body-unica-26-reg&quot;>La migraine n’est pas un simple mal de tête. Il s’agit d’une affection neurologique complexe, impliquant des mécanismes neurovasculaires, pouvant durer de quelques heures à plusieurs jours&lt;sup>4&lt;/sup>.&lt;/span>&lt;/p>&#xd;&#xa;&lt;p>&lt;span class=&quot;body-unica-26-reg&quot;>Certaines études indiquent que les crises sont en moyenne plus longues et plus fréquentes chez les femmes que chez les hommes&lt;sup>5&lt;/sup>.&lt;/span>&lt;/p>&#xd;&#xa;&lt;p>&lt;span class=&quot;body-unica-26-reg&quot;>L’enquête belge met également en évidence la dimension hormonale&lt;sup>2:&lt;/sup>&lt;/span>&lt;/p>&#xd;&#xa;&lt;ul>&#xd;&#xa;&lt;li>&lt;span class=&quot;body-unica-26-reg&quot;>65% des répondantes rapportent un antécédent familial&amp;nbsp;&lt;/span>&lt;/li>&#xd;&#xa;&lt;li>&lt;span class=&quot;body-unica-26-reg&quot;>Une proportion importante identifie un lien entre les crises et le cycle menstruel&lt;/span>&lt;/li>&#xd;&#xa;&lt;li>&lt;span class=&quot;body-unica-26-reg&quot;>58% expriment le souhait de recevoir davantage d'informations sur le lien entre hormones et migraine&amp;nbsp;&lt;/span>&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;&lt;p>&lt;span class=&quot;body-unica-26-reg&quot;>Pourtant, seule une minorité déclare avoir bénéficié d'une information ou d'une prise en charge spécifique liée à cette dimension.&lt;sup>2&lt;/sup>&lt;/span>&lt;/p>&#xd;&#xa;&lt;p>&amp;nbsp;&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <title_copy_copy_1956889894
                                    cq:styleIds="[1659545825678,1651545825678]"
                                    jcr:created="{Date}2026-03-03T04:32:26.327-05:00"
                                    jcr:createdBy="BAUFAAX"
                                    jcr:lastModified="{Date}2026-03-03T04:47:39.052-05:00"
                                    jcr:lastModifiedBy="BAUFAAX"
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="Mieux comprendre pour mieux accompagner"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h2"
                                    variant="h"/>
                                <text2_copy_copy_copy
                                    cq:styleIds="[1659545825678,1659545835858]"
                                    jcr:lastModified="{Date}2026-03-03T04:48:35.295-05:00"
                                    jcr:lastModifiedBy="BAUFAAX"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>&lt;span class=&quot;body-unica-26-reg&quot;>Les données issues de cette enquête européenne apportent un éclairage concret sur la réalité vécue par les femmes en Belgique.&lt;/span>&lt;/p>&#xd;&#xa;&lt;p>&lt;span class=&quot;body-unica-26-reg&quot;>Mieux informer, mieux diagnostiquer et mieux structurer les parcours de soins constituent des leviers importants pour améliorer la reconnaissance et l’accompagnement des patientes.&amp;nbsp;&lt;/span>&lt;/p>&#xd;&#xa;&lt;p>&lt;span class=&quot;body-unica-26-reg&quot;>&lt;sup>&amp;nbsp;&lt;/sup>&lt;/span>&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <text_1090895253
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2025-09-09T10:39:53.439-04:00"
                                    jcr:createdBy="BAUFAAX"
                                    jcr:lastModified="{Date}2026-03-03T05:22:46.190-05:00"
                                    jcr:lastModifiedBy="BAUFAAX"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>&lt;span class=&quot;body-unica-18-reg&quot;>&lt;span class=&quot;body-unica-20-reg&quot;>&lt;span class=&quot;body-unica-40-reg&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>&lt;b>Pour en savoir plus:&lt;/b>&lt;/span>&lt;/span>&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;&lt;ul>&#xd;&#xa;&lt;li>&lt;span class=&quot;body-unica-18-reg&quot;>&lt;span class=&quot;body-unica-20-reg&quot;>&lt;span class=&quot;body-unica-40-reg&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>&lt;b>Consultez notre brochure &amp;quot;&lt;a href=&quot;https://www.abbvie.be/content/dam/abbvie-com2/be/documents/abbvie10-migraine-brochure-250909_FR1.pdf&quot; target=&quot;_blank&quot;>Migraine at Work&lt;/a>&amp;quot;&lt;/b>&lt;/span>&lt;/span>&lt;/span>&lt;/span>&lt;/li>&#xd;&#xa;&lt;li>&lt;span class=&quot;body-unica-18-reg&quot;>&lt;span class=&quot;body-unica-20-reg&quot;>&lt;span class=&quot;body-unica-40-reg&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>&lt;b>Découvrez &lt;a href=&quot;https://www.abbvie.be/fr/ressources/podcast/parlons-en-saison-4.html&quot; target=&quot;_blank&quot;>notre saison de podcast dédiée à la migraine&lt;/a>&lt;/b>&lt;/span>&lt;/span>&lt;/span>&lt;/span>&lt;/li>&#xd;&#xa;&lt;li>&lt;span class=&quot;body-unica-18-reg&quot;>&lt;span class=&quot;body-unica-20-reg&quot;>&lt;span class=&quot;body-unica-40-reg&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>&lt;b>Retrouvez des informations et du soutien via &lt;a href=&quot;https://www.hoofd-stuk.be/&quot; target=&quot;_blank&quot;>l'association de patients Hoofd-Stuk vzw&amp;nbsp;&lt;/a>&lt;/b>&lt;/span>&lt;/span>&lt;/span>&lt;/span>&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;&lt;p>&amp;nbsp;&lt;/p>&#xd;&#xa;&lt;p>&lt;i>Cet article a pour objectif de contribuer à une meilleure compréhension de la m&lt;/i>&lt;i style=&quot;font-size: 0.8125rem;&quot;>igraine. Il ne se substitue pas à un avis médical et n’a pas vocation à formuler des recommandations thérapeutiques.&lt;/i>&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <separator
