                                    videoType="youtube"
                                    youtubeAutoPlay="true"
                                    youtubeUrl="https://www.youtube.com/embed/WwayEGgXkUk?si=dOJtJs_jomCU5BYs"/>
                                <text2_copy_1962602975
                                    cq:styleIds="[1659545825678,1659545835858]"
                                    jcr:lastModified="{Date}2024-08-26T18:50:53.035-04:00"
                                    jcr:lastModifiedBy="washidx10"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>«&amp;nbsp;La maladie de Parkinson, c'est la 2e maladie neurodégénérative la plus fréquente après la maladie d'Alzheimer.&lt;sup>2&lt;/sup>&amp;nbsp;En Belgique, elle touche entre 30000 et 50000 patients.&lt;sup>3&amp;nbsp;&lt;/sup>C'est une maladie qui commence en général autour de 55, 60 ans. Il y a aussi des formes juvéniles qui sont beaucoup plus rares.&lt;sup>4&amp;nbsp;&lt;/sup>»&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <separator_copy_18800
                                    cq:styleIds="[1662756456518]"
                                    jcr:created="{Date}2024-08-26T18:47:52.384-04:00"
                                    jcr:createdBy="washidx10"
                                    jcr:lastModified="{Date}2024-08-26T18:47:52.384-04:00"
                                    jcr:lastModifiedBy="washidx10"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                                <title2
                                    cq:styleIds="[1659545825678,1651545824678,1661545829678]"
                                    jcr:lastModified="{Date}2024-08-26T18:50:23.792-04:00"
                                    jcr:lastModifiedBy="washidx10"
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="Plus de 70% des patients Parkinson souffrent de troubles du sommeil"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h2"
                                    variant="h"/>
                                <text2
                                    cq:styleIds="[1659545825678,1659545835858]"
                                    jcr:lastModified="{Date}2024-12-16T14:38:02.146-05:00"
                                    jcr:lastModifiedBy="BAUFAAX"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>«&amp;nbsp;Les troubles du sommeil peuvent apparaitre 10 à 20 ans avant les symptômes moteurs.&lt;sup>6&lt;/sup>&amp;nbsp;Le patient peut faire des rêves très agités, d'agressions, de poursuites, de combats et va avoir un comportement moteur très agité&amp;nbsp;: se lever de son lit, tomber, se battre avec quelqu'un d'imaginaire. Et puis évidemment, il y a d'autres problèmes de sommeil comme l'insomnie&lt;sup>.7&lt;/sup>&amp;nbsp;C'est clair que les gens qui ne dorment pas bien vont être plus stressés, plus anxieux. Cela peut induire des complications motrices, beaucoup plus de blocages, de dyskinésie et de mouvements involontaires.&lt;sup>8&lt;/sup>&amp;nbsp;»&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <separator_copy_1880015361
                                    cq:styleIds="[1662756456518]"
                                    jcr:created="{Date}2024-08-26T18:47:52.384-04:00"
                                    jcr:createdBy="washidx10"
                                    jcr:lastModified="{Date}2024-08-26T18:47:52.384-04:00"
                                    jcr:lastModifiedBy="washidx10"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                                <title2_copy
                                    cq:styleIds="[1659545825678,1651545824678,1661545829678]"
                                    jcr:lastModified="{Date}2024-08-26T18:51:16.410-04:00"
                                    jcr:lastModifiedBy="washidx10"
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="En discuter avec son médecin "
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h2"
                                    variant="h"/>
                                <text2_copy
                                    cq:styleIds="[1659545825678,1659545835858]"
                                    jcr:lastModified="{Date}2024-08-26T18:51:22.375-04:00"
                                    jcr:lastModifiedBy="washidx10"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>« À cause de ce stress et de cette anxiété, il est important de parler des troubles du sommeil à son médecin. Ce sont des choses qu'on peut régler, pas seulement par des médicaments, mais aussi par des thérapies de comportement, par une modification des habitudes, par un réaménagement de la chambre… Et surtout, parce qu'on sait que ces troubles font partie intégrante de la maladie de Parkinson. Je pense que les patients ne le savent pas toujours et ils ne vont pas le mentionner parce qu'ils pensent qu'il n'y a pas de lien entre les 2. Il existe la Journée mondiale de Parkinson, mais ce serait une très bonne idée d'organiser la Nuit mondiale de Parkinson pour sensibiliser tous les patients aux pathologies du sommeil dans le cadre de cette maladie, ainsi que les médecins traitants, les neurologues et tous les gens qui gravitent autour des patients&amp;nbsp;».&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <separator
                                    cq:styleIds="[1662756456518]"
