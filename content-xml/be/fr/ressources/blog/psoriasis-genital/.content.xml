                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                langAttribute="none"
                                text="&lt;p>&lt;span class=&quot;body-unica-26-reg&quot;>Le psoriasis en plaques ne touche pas uniquement les zones visibles du corps. Chez certaines personnes, il peut aussi apparaître au niveau des zones génitales. Une localisation encore peu connue, dont il est parfois difficile de parler, y compris avec un professionnel de santé.&amp;nbsp;&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
