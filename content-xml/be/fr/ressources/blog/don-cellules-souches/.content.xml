                                jcr:primaryType="nt:unstructured"
                                jcr:title="Un match qui peut sauver une vie "
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h1"
                                variant="h"/>
                            <text_copy
                                cq:styleIds="[1659545825678,1659545835858]"
                                jcr:lastModified="{Date}2025-09-16T10:50:36.020-04:00"
                                jcr:lastModifiedBy="BAUFAAX"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>Dans l’univers des applications de rencontre, un «&amp;nbsp;match&amp;nbsp;» est une question d’affinités. Dans le cadre du don de cellules souches, il s’agit d’un match vital : celui qui permet à un patient atteint d’un cancer du sang de recevoir une greffe.&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <image
                                jcr:created="{Date}2025-03-10T09:54:45.400-04:00"
                                jcr:createdBy="BAUFAAX"
                                jcr:lastModified="{Date}2025-09-16T12:16:19.619-04:00"
                                jcr:lastModifiedBy="BAUFAAX"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/image/v2/image"
                                alt="MICI"
                                altValueFromDAM="false"
                                displayPopupTitle="true"
                                dmPresetType="imagePreset"
                                fileReference="/content/dam/abbvie-com2/be/images/Match match.png"
                                isDecorative="false"
                                openInNewWindow="false"
                                titleValueFromDAM="false"/>
                            <text
                                cq:styleIds="[1659545835858,1659545847147]"
                                jcr:created="{Date}2025-09-16T10:50:44.569-04:00"
                                jcr:createdBy="BAUFAAX"
                                jcr:lastModified="{Date}2025-09-16T12:18:54.688-04:00"
                                jcr:lastModifiedBy="BAUFAAX"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;body-unica-18-reg&quot;>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-26-reg&quot;>Chaque année, près de 7.800 personnes en Belgique sont touchées par une maladie hématologique telle que la leucémie, le lymphome ou le myélome.&lt;sup>1&lt;/sup>&amp;nbsp;Pour de nombreux patients, la greffe de cellules souches représente la seule chance de survie.&lt;sup>1&lt;/sup> Le défi est la compatibilité : celle-ci reste rare dans certains cas, de l’ordre d’1 sur 100.000.&lt;sup>2&lt;/sup>&lt;/span>&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;&lt;p>&amp;nbsp;&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <text_copy_2007163026
                                cq:styleIds="[1659545835858,1659545847147]"
                                jcr:created="{Date}2025-09-16T10:50:44.569-04:00"
                                jcr:createdBy="BAUFAAX"
                                jcr:lastModified="{Date}2025-09-16T10:59:28.566-04:00"
                                jcr:lastModifiedBy="BAUFAAX"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;body-unica-18-reg&quot;>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-26-reg&quot;>&lt;b>Le rôle des jeunes adultes&lt;/b>&lt;/span>&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;&lt;p>&lt;span class=&quot;body-unica-18-reg&quot;>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-26-reg&quot;>Le registre des donneurs est ouvert aux personnes âgées de 18 à 39 ans. Cette tranche d’âge joue donc un rôle essentiel pour assurer le renouvellement du registre et accroître la diversité des profils. Cette diversité est particulièrement importante, car certains patients issus de minorités ethniques ont aujourd’hui beaucoup moins de chances de trouver un donneur compatible.&lt;sup>3&lt;/sup>&lt;/span>&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;&lt;p>&amp;nbsp;&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <text_copy_2007163026_1363696007
                                cq:styleIds="[1659545835858,1659545847147]"
                                jcr:created="{Date}2025-09-16T10:50:44.569-04:00"
                                jcr:createdBy="BAUFAAX"
                                jcr:lastModified="{Date}2025-09-17T08:58:21.871-04:00"
                                jcr:lastModifiedBy="BAUFAAX"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;body-unica-18-reg&quot;>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-26-reg&quot;>&lt;b>Comment se passe le don ?&lt;/b>&lt;/span>&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;&lt;ul>&#xd;&#xa;&lt;li>&lt;span class=&quot;body-unica-18-reg&quot;>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-26-reg&quot;>&lt;b>Les cellules souches&lt;/b> : elles régénèrent le sang. En cas de cancer du sang, un apport de cellules saines peut être vital.&lt;sup>4&lt;/sup>&lt;/span>&lt;/span>&lt;/span>&lt;/li>&#xd;&#xa;&lt;li>&lt;span class=&quot;body-unica-18-reg&quot;>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-26-reg&quot;>&lt;b>Le don&lt;/b> : dans la plupart des cas, il s’agit d’un prélèvement sanguin élargi, comparable à une prise de sang longue, avec un traitement pris au préalable.&lt;sup>4&lt;/sup>&lt;/span>&lt;/span>&lt;/span>&lt;/li>&#xd;&#xa;&lt;li>&lt;span class=&quot;body-unica-18-reg&quot;>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-26-reg&quot;>&lt;b>L’anonymat&lt;/b> : le donneur et le patient ne se rencontrent pas, mais la vie de l’un dépend du geste de l’autre.&lt;sup>5&lt;/sup>&lt;/span>&lt;/span>&lt;/span>&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;"
                                textIsRich="true"/>
                            <text_copy_2007163026_575939260
                                cq:styleIds="[1659545835858,1659545847147]"
                                jcr:created="{Date}2025-09-16T10:50:44.569-04:00"
                                jcr:createdBy="BAUFAAX"
                                jcr:lastModified="{Date}2025-09-17T08:58:29.229-04:00"
                                jcr:lastModifiedBy="BAUFAAX"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;body-unica-18-reg&quot;>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-26-reg&quot;>&lt;b>Quelques chiffres clés&lt;/b>&lt;/span>&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;&lt;ul>&#xd;&#xa;&lt;li>&lt;span class=&quot;body-unica-18-reg&quot;>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-26-reg&quot;>Selon une enquête menée en 2025, 46 % des 18–25 ans savent qu’un don peut sauver une vie&lt;sup>6&lt;/sup>&lt;/span>&lt;/span>&lt;/span>&lt;/li>&#xd;&#xa;&lt;li>&lt;span class=&quot;body-unica-18-reg&quot;>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-26-reg&quot;>92 % se disent prêts à s’inscrire si un proche en avait besoin&lt;sup>6&lt;/sup>&lt;/span>&lt;/span>&lt;/span>&lt;/li>&#xd;&#xa;&lt;li>&lt;span class=&quot;body-unica-18-reg&quot;>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-26-reg&quot;>Il y a 82 000 donneurs inscrits au registre belge&lt;sup>7&lt;/sup>&lt;/span>&lt;/span>&lt;/span>&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;&lt;p>&amp;nbsp;&lt;/p>&#xd;&#xa;&lt;p>&amp;nbsp;&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <video
                                jcr:created="{Date}2026-02-04T11:54:48.237-05:00"
                                jcr:createdBy="BAUFAAX"
                                jcr:lastModified="{Date}2026-02-05T07:09:14.873-05:00"
                                jcr:lastModifiedBy="BAUFAAX"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/video/v2/video"
