                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;body-unica-18-reg&quot;>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-26-reg&quot;>&lt;b>Vous souhaitez en savoir plus sur le don de cellules souches ?&lt;/b>&lt;/span>&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;&lt;p>&lt;span class=&quot;body-unica-26-reg&quot;>Retrouvez la procédure, les critères et informations officielles sur&amp;nbsp;&lt;a href=&quot;http://www.donneurdesang.be/&quot;>&lt;b>www.donneurdesang.be&lt;/b>&lt;/a>&lt;b>&amp;nbsp;&amp;nbsp;&lt;/b>&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
