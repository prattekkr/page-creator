                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>A travers notre gouvernance d'entreprise et nos normes élevées en matière de qualité, de conformité, de sécurité et de performance, nous nous efforçons de toujours faire ce qui est juste.&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_copy_copy_
                                cq:styleIds="[1662756456518]"
