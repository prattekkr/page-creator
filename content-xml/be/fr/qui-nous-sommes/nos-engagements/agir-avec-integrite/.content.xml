                                jcr:lastModified="{Date}2024-09-02T09:52:12.961-04:00"
                                jcr:lastModifiedBy="jewitca"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;body-unica-20-reg&quot;>Pour avoir un impact positif à long terme sur les patients, nous faisons en sorte de gagner et de conserver leur confiance en agissant avec intégrité dans tout ce que nous faisons. Nous sommes fiers de nos principes solides et de notre engagement, car nous savons que c’est non seulement la bonne attitude à avoir, mais aussi qu’une telle approche contribue à la résilience de notre entreprise et à notre succès à long terme.&amp;nbsp;&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
