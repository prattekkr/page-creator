                                    jcr:lastModifiedBy="kanchrx3"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/quote"
                                    attributionName="Michael Gold, M.D."
                                    attributionTitle="VP, Neuroscience Development"
                                    bgImageModifiers="resMode=sharp2&amp;op_sharpen=1"
                                    imageModifiers="resMode=sharp2&amp;op_sharpen=1"
                                    quote="Avec curiosité et résilience, nos scientifiques veillent à découvrir de nouvelles perspectives afin d’induire des améliorations significatives chez les patients."
                                    quoteType="regular"
                                    textSize="h0"/>
                            </container4>
