                                    jcr:primaryType="nt:unstructured"
                                    jcr:title=" Nos domaines thérapeutiques en oncologie"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h3"
                                    variant="h"/>
                                <text2
                                    cq:styleIds="[1659545825678,1659545835858]"
                                    jcr:lastModified="{Date}2024-09-02T11:52:53.237-04:00"
                                    jcr:lastModifiedBy="jewitca"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Nous nous &lt;b>consacrons à trouver des façons de faire évoluer le traitement du cancer.&lt;/b> Nous entendons mettre au point des options de traitement plus efficaces et plus durables pour les cancers du sang et les tumeurs solides. Notre culture de la curiosité nous pousse à trouver de nouvelles solutions.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
