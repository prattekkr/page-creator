                                    type="h3"
                                    variant="h"/>
                                <text2
                                    cq:styleIds="[1659545825678,1659545835858]"
                                    jcr:lastModified="{Date}2024-12-05T09:44:47.044-05:00"
                                    jcr:lastModifiedBy="BAUFAAX"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Chacune de nos découvertes permet de mieux comprendre les différences de besoins chez les patients — même s’ils souffrent de la même maladie — et de créer des traitements plus personnalisés dans les maladies auto-immunes. Nos traitements sont suivis par plus d’un million de personnes souffrant de maladies à médiation immunitaire dans le monde entier.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                            </container4>
