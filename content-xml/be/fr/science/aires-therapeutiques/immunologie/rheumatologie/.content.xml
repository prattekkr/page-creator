                            sling:resourceType="wcm/foundation/components/parsys">
                            <container4
                                cq:styleIds="[1653545825687,1653545847150,1653242825678,1653545835982,1653545835879]"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/container/v2/container">
                                <text2
                                    cq:styleIds="[1659545825678,1659545835858]"
                                    jcr:lastModified="{Date}2024-12-05T04:25:28.562-05:00"
                                    jcr:lastModifiedBy="sokalpx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Malgré des avancées médicales significatives, de nombreux patients ont toujours du mal à gérer leur état de santé : il est donc plus qu’urgent d’améliorer les options thérapeutiques.  &lt;/p>&#xd;&#xa;&lt;p>Nous nous engageons à améliorer la vie des patients atteints notamment de polyarthrite rhumatoïde, d’arthrite psoriasique ou de spondylarthrite axiale.&lt;br />&#xd;&#xa;&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                            </container4>
