                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                                <accordion_copy_copy
                                    cq:styleIds="[1,1653545835881]"
                                    jcr:created="{Date}2022-12-17T16:25:09.442-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2024-12-05T04:04:31.005-05:00"
                                    jcr:lastModifiedBy="sokalpx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/accordion/v2/accordion"
                                    heading="Maladies rhumatologiques "
                                    headingElement="h5"
                                    singleExpansion="false">
                                    <item_1671312472873
                                        cq:panelTitle="Polyarthrite rhumatoïde (PR) "
                                        cq:styleIds="[1659545825678]"
                                        jcr:lastModified="{Date}2024-12-05T12:21:40.942-05:00"
                                        jcr:lastModifiedBy="BAUFAAX"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="abbvie-com2/components/text/v2/text"
                                        text="&lt;p>La polyarthrite rhumatoïde est une maladie chronique, auto-immune et inflammatoire qui peut entraîner une douleur, une raideur, un gonflement et une perte de la fonction articulaire. La PR peut endommager les tissus, ce qui peut provoquer des douleurs chroniques, une perte d’équilibre et des déformations physiques.&lt;sup>1&lt;/sup>&lt;/p>&#xd;&#xa;"
                                        textIsRich="true"/>
                                    <item_1671312475801
                                        cq:panelTitle="Arthrite psoriasique (AP) "
                                        cq:styleIds="[1659545825678]"
                                        jcr:lastModified="{Date}2024-12-05T12:21:54.821-05:00"
                                        jcr:lastModifiedBy="BAUFAAX"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="abbvie-com2/components/text/v2/text"
                                        text="&lt;p>L’AP est une maladie chronique qui peut provoquer une inflammation des articulations, des tendons et/ou des ligaments. Elle touche jusqu’à 30 % des patients souffrant de psoriasis.&lt;sup>2&lt;/sup>&lt;/p>&#xd;&#xa;"
                                        textIsRich="true"/>
                                    <item_1671312481387
                                        cq:panelTitle="Spondylarthrite (SpA) "
                                        cq:styleIds="[1659545825678]"
                                        jcr:lastModified="{Date}2024-12-05T12:22:13.868-05:00"
                                        jcr:lastModifiedBy="BAUFAAX"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="abbvie-com2/components/text/v2/text"
                                        text="&lt;p>La SpA est une forme d’arthrite qui touche la colonne vertébrale ainsi que les articulations.&lt;sup>3&lt;/sup>&lt;/p>&#xd;&#xa;"
                                        textIsRich="true"/>
                                    <item_1722945965647
                                        cq:panelTitle="Spondylarthrite axiale (axSpA) "
                                        cq:styleIds="[1659545825678]"
                                        jcr:lastModified="{Date}2024-12-05T12:22:37.005-05:00"
                                        jcr:lastModifiedBy="BAUFAAX"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="abbvie-com2/components/text/v2/text"
                                        text="&lt;p>L’axSpA est une maladie inflammatoire chronique qui englobe deux sous-groupes: la spondylarthrite ankylosante (SA) et la spondylarthrite axiale non radiographique (nr-axSpA). La SA est une maladie inflammatoire qui cause à terme la fusion des os de la colonne vertébrale. Elle touche plus souvent les hommes que les femmes. La nr-axSpA est une maladie inflammatoire chronique des tissus de la colonne vertébrale. Elle entraîne un gonflement, une raideur et des douleurs. Les symptômes de la nr-axSpa sont difficiles à examiner, résultant souvent en un diagnostic tardif.&lt;sup>4&lt;/sup>&lt;/p>&#xd;&#xa;"
                                        textIsRich="true"/>
                                    <item_1722946012514
                                        cq:panelTitle="Uvéite (UV)"
                                        cq:styleIds="[1659545825678]"
                                        jcr:lastModified="{Date}2024-12-05T12:22:57.009-05:00"
                                        jcr:lastModifiedBy="BAUFAAX"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="abbvie-com2/components/text/v2/text"
                                        text="&lt;p>L’uvéite est un groupe de maladies oculaires caractérisées par l’inflammation de l’uvée, la partie intermédiaire de l’œil. Un diagnostic et un traitement précoces sont essentiels étant donné que l’uvéite est une maladie qui peut s'avérer grave et entraîner une perte de vision permanente. &lt;sup>5&lt;/sup>&lt;/p>&#xd;&#xa;"
                                        textIsRich="true"/>
                                    <item_1722946023905
                                        cq:panelTitle="Lupus érythémateux disséminé (SLE)"
                                        cq:styleIds="[1659545825678]"
                                        jcr:lastModified="{Date}2024-12-05T12:23:11.330-05:00"
                                        jcr:lastModifiedBy="BAUFAAX"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="abbvie-com2/components/text/v2/text"
                                        text="&lt;p>Le lupus érythémateux disséminé (SLE) est la forme la plus courante de lupus, surtout chez les femmes. Cette maladie à médiation immunitaire est associée à l’inflammation de différents organes. &lt;sup>6&lt;/sup>&lt;/p>&#xd;&#xa;"
                                        textIsRich="true"/>
                                    <item_1722946047029
                                        cq:panelTitle="Arthrite juvénile idiopathique (JIA) "
                                        cq:styleIds="[1659545825678]"
                                        jcr:lastModified="{Date}2024-12-05T12:23:28.019-05:00"
                                        jcr:lastModifiedBy="BAUFAAX"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="abbvie-com2/components/text/v2/text"
                                        text="&lt;p>La JIA est la maladie rhumatismale chronique la plus fréquente chez les enfants. Un diagnostic et un traitement précoces sont essentiels.&lt;sup>7&lt;/sup>&lt;/p>&#xd;&#xa;"
                                        textIsRich="true"/>
                                </accordion_copy_copy>
