                                    jcr:createdBy="singarx"
                                    jcr:lastModified="{Date}2024-10-16T02:21:29.481-04:00"
                                    jcr:lastModifiedBy="singarx"
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="Voorbij de fysieke symptomen"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h4"
                                    variant="h"/>
                                <text_1423472997
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2024-10-16T02:20:58.768-04:00"
                                    jcr:createdBy="singarx"
                                    jcr:lastModified="{Date}2024-10-16T02:22:48.809-04:00"
                                    jcr:lastModifiedBy="singarx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Het onvoorspelbare karakter van de IBD-symptomen is een &lt;b>zware last&lt;/b> voor de patiënten. Uit een enquête onder IBD-patiënten in Europa11 blijkt dat 71% van de respondenten zich weleens zorgen maakt over wanneer de volgende flare-up zal opduiken. En 16% maakt zich daar voortdurend zorgen over. Ook &lt;b>vooroordelen&lt;/b> liggen gevoelig: bijna een op de vier patiënten zegt weleens onterechte opmerkingen te hebben gekregen over hun prestaties op het werk en meer dan een op de vier patiënten is weleens uitgelachen omdat ze vaak naar het toilet moesten.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <separator_826833122
                                    cq:styleIds="[1662756486159]"
                                    jcr:created="{Date}2024-10-16T02:23:08.166-04:00"
                                    jcr:createdBy="singarx"
                                    jcr:lastModified="{Date}2024-10-16T02:23:08.166-04:00"
                                    jcr:lastModifiedBy="singarx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                                <image
                                    cq:styleIds="[1402843082812,1402843082834,1402843082823]"
                                    jcr:created="{Date}2024-10-16T02:23:42.879-04:00"
