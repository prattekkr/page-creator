                                        jcr:lastModifiedBy="BAUFAAX"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="abbvie-com2/components/text/v2/text"
                                        text="&lt;p>&lt;span class=&quot;body-unica-14-reg&quot;>[1] Inserm. IBD. Beschikbaar op&amp;nbsp;&lt;a href=&quot;http://www.inserm.fr/information-en-sante/dossiers-information/maladies-inflammatoires-chroniques-intestin-mici&quot; title=&quot;www.inserm.fr/information-en-sante/dossiers-information/maladies-inflammatoires-chroniques-intestin-mici&quot;>www.inserm.fr/information-en-sante/dossiers-information/maladies-inflammatoires-chroniques-intestin-mici&lt;/a>. Last accessed in December 2024.&amp;nbsp;&lt;/span>&lt;/p>&#xd;&#xa;&lt;p>&lt;span class=&quot;body-unica-14-reg&quot;>[2]&amp;nbsp;&amp;nbsp;Vzw Crohn-RCUH,&amp;nbsp;&lt;a href=&quot;http://www.mici.be/crohn/tabac-alcool-drogues/&quot;>http://www.mici.be/crohn/tabac-alcool-drogues/&lt;/a>.&amp;nbsp;Last accessed in December 2024.&amp;nbsp;&lt;/span>&lt;/p>&#xd;&#xa;&lt;p>&lt;span class=&quot;body-unica-14-reg&quot;>[3]&amp;nbsp;Crohn’s &amp;amp; Colitis Foundation of America. The Facts about Inflammatory Bowel Diseases. Crohn’s &amp;amp; Colitis Foundation. Last accessed in December 2024.&amp;nbsp; https://www.crohnscolitisfoundation.org/sites/default/files/2019-02/Updated%20IBD%20Factbook.pdf&lt;/span>&lt;/p>&#xd;&#xa;&lt;p>&lt;span class=&quot;body-unica-14-reg&quot;>[4]&amp;nbsp;Wylezinski LS, et al.. Illuminating an Invisible Epidemic: A Systemic Review of the Clinical and Economic Benefits of Early Diagnosis and Treatment in Inflammatory Disease and Related Syndromes. J Clin Med. 2019 Apr 11;8(4):493. doi: 10.3390/jcm8040493.&lt;/span>&lt;/p>&#xd;&#xa;&lt;p>&lt;span class=&quot;body-unica-14-reg&quot;>[5]&amp;nbsp;Crohn’s &amp;amp; Colitis Foundation of America. The Facts about Inflammatory Bowel Diseases. Crohn’s &amp;amp; Colitis Foundation. Last accessed in December 2024.&amp;nbsp;&amp;nbsp;https://www.crohnscolitisfoundation.org/sites/default/files/2019-02/Updated%20IBD%20Factbook.pdf&lt;/span>&lt;/p>&#xd;&#xa;&lt;p>&lt;span class=&quot;body-unica-14-reg&qu