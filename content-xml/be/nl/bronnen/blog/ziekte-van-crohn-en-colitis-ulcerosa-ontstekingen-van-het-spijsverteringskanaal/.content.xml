                                    jcr:lastModified="{Date}2024-10-16T02:20:14.190-04:00"
                                    jcr:lastModifiedBy="singarx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Beide ziekten kennen&amp;nbsp;actieve periodes of ‘flare-ups’&amp;nbsp;en&amp;nbsp;periodes van remissie&amp;nbsp;waarbij de symptomen verminderen of helemaal verdwijnen.9,10&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <separator_153781937
                                    cq:styleIds="[1662756456518]"
                                    jcr:created="{Date}2024-10-16T02:18:38.036-04:00"
