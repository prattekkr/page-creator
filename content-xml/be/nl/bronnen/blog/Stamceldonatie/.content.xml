                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>&lt;span class=&quot;body-unica-26-reg&quot;>&lt;b>Meer weten over stamceldonatie?&lt;/b>&lt;/span>&lt;/p>&#xd;&#xa;&lt;p>&lt;span class=&quot;body-unica-26-reg&quot;>Bekijk de procedure, criteria en officiële informatie op: &lt;a href=&quot;http://www.stamceldonor.be/&quot;>&lt;b>www.stamceldonor.be&lt;/b>&lt;/a>&lt;/span>&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
