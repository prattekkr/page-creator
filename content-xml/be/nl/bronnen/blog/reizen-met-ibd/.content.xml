                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                langAttribute="none"
                                text="&lt;p>&lt;span class=&quot;body-unica-26-reg&quot;>Voor veel mensen staat de zomer synoniem voor vakantie. Ook met de ziekte van Crohn of colitis ulcerosa hoeft reizen geen uitzondering te zijn. Een goede voorbereiding kan helpen om met meer vertrouwen te vertrekken en onderweg met een gerust gevoel van je vakantie te genieten.&lt;/span>&lt;/p>&#xd;&#xa;&lt;p>&lt;span class=&quot;body-unica-26-reg&quot;>Hoewel elke reis anders is, zijn er enkele aandachtspunten die je voorbereiding een stuk makkelijker kunnen maken.&lt;i>&lt;/i>&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <image
