                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/container/v2/container">
                                <title
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2026-03-05T09:19:03.534-05:00"
                                    jcr:createdBy="BAUFAAX"
                                    jcr:lastModified="{Date}2026-03-05T09:19:49.028-05:00"
                                    jcr:lastModifiedBy="BAUFAAX"
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="Een aanzienlijke impact op het professionele en persoonlijke leven"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h1"
                                    variant="h"/>
                                <text2
                                    cq:styleIds="[1659545825678,1659545835858]"
                                    jcr:lastModified="{Date}2026-03-05T10:55:12.864-05:00"
                                    jcr:lastModifiedBy="BAUFAAX"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>&lt;span class=&quot;body-unica-26-reg&quot;>De Belgische resultaten tonen een aanzienlijke impact aan²:&lt;/span>&lt;/p>&#xd;&#xa;&lt;ul>&#xd;&#xa;&lt;li>&lt;span class=&quot;body-unica-26-reg&quot;>Bijna 90 % van de deelneemsters geeft aan dat hun aanvallen hun vermogen om te werken, te studeren of hun dagelijkse activiteiten uit te voeren al hebben beperkt.&lt;/span>&lt;/li>&#xd;&#xa;&lt;li>&lt;span class=&quot;body-unica-26-reg&quot;>37 % rapporteert hoofdpijn gedurende minstens 9 dagen per maand&lt;/span>&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;&lt;p style=&quot;margin-left: 40.0px;&quot;>&lt;span class=&quot;body-unica-26-reg&quot;>- 24,6 % tussen 9 en 14 dagen&lt;/span>&lt;/p>&#xd;&#xa;&lt;p style=&quot;margin-left: 40.0px;&quot;>&lt;span class=&quot;body-unica-26-reg&quot;>- 12,4 % 15 dagen of meer&lt;/span>&lt;/p>&#xd;&#xa;&lt;ul>&#xd;&#xa;&lt;li>&lt;span class=&quot;body-unica-26-reg&quot;>Een meerderheid beschrijft bijkomende symptomen zoals misselijkheid en een sterke gevoeligheid voor licht.&lt;/span>&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;&lt;p>&lt;span class=&quot;body-unica-26-reg&quot;>Voor een aanzienlijk deel van de respondenten is migraine dus een terugkerende aandoening.&lt;/span>&lt;/p>&#xd;&#xa;&lt;p>&lt;span class=&quot;body-unica-26-reg&quot;>In ons &lt;a href=&quot;https://open.spotify.com/show/4CdlEoU5FjKxN8GisP2LQo&quot; target=&quot;_blank&quot;>podcastseizoen gewijd aan migraine&lt;/a> sprak een patiënte over de concrete impact van haar aanvallen op haar gezins- en beroepsleven: de noodzaak om zich in het donker te isoleren, moeite om zich te concentreren, en het onvermogen om op bepaalde belangrijke momenten aanwezig te zijn. Een ervaring die ook door de respondenten lijkt te worden gedeeld.&lt;/span>&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <title_copy
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2026-03-05T09:19:03.534-05:00"
                                    jcr:createdBy="BAUFAAX"
                                    jcr:lastModified="{Date}2026-03-05T09:27:27.502-05:00"
                                    jcr:lastModifiedBy="BAUFAAX"
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="Een diagnose en behandeling die nog onvolledig blijven"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h1"
                                    variant="h"/>
                                <text2_copy
                                    cq:styleIds="[1659545825678,1659545835858]"
                                    jcr:lastModified="{Date}2026-03-05T09:31:16.612-05:00"
                                    jcr:lastModifiedBy="BAUFAAX"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>&lt;span class=&quot;body-unica-26-reg&quot;>Ondanks deze impact:&lt;/span>&lt;/p>&#xd;&#xa;&lt;ul>&#xd;&#xa;&lt;li>&lt;span class=&quot;body-unica-26-reg&quot;>Slechts 50,9 % van de deelneemsters geeft aan een formele diagnose van migraine te hebben gekregen.²&lt;/span>&lt;/li>&#xd;&#xa;&lt;li>&lt;span class=&quot;body-unica-26-reg&quot;>62,7 % heeft een arts geraadpleegd.²&lt;/span>&lt;/li>&#xd;&#xa;&lt;li>&lt;span class=&quot;body-unica-26-reg&quot;>43,7 % geeft aan geen specifieke behandeling te hebben gekregen.²&lt;/span>&lt;/li>&#xd;&#xa;&lt;li>&lt;span class=&quot;body-unica-26-reg&quot;>84,9 % geeft aan zichzelf te behandelen.²&lt;/span>&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;&lt;p>&lt;span class=&quot;body-unica-26-reg&quot;>Wanneer behandelingen worden voorgeschreven, wordt hun effectiviteit als wisselend beoordeeld.² Deze elementen sluiten aan bij de wetenschappelijke literatuur, die benadrukt dat migraine nog steeds ondergediagnosticeerd is en soms onvoldoende wordt behandeld, in het bijzonder bij vrouwen³.&lt;/span>&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <title_copy_copy
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2026-03-05T09:19:03.534-05:00"
                                    jcr:createdBy="BAUFAAX"
                                    jcr:lastModified="{Date}2026-03-05T10:01:17.066-05:00"
                                    jcr:lastModifiedBy="BAUFAAX"
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="Een neurologische aandoening beïnvloed door hormonale factoren"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h1"
                                    variant="h"/>
                                <text2_copy_copy
                                    cq:styleIds="[1659545825678,1659545835858]"
                                    jcr:lastModified="{Date}2026-03-05T10:55:57.666-05:00"
                                    jcr:lastModifiedBy="BAUFAAX"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>&lt;span class=&quot;body-unica-26-reg&quot;>Migraine is niet zomaar een gewone hoofdpijn. Het gaat om een complexe neurologische aandoening waarbij neurovasculaire mechanismen betrokken zijn en die van enkele uren tot meerdere dagen kan aanhouden.&lt;sup>4&lt;/sup>&lt;/span>&lt;/p>&#xd;&#xa;&lt;p>&lt;span class=&quot;body-unica-26-reg&quot;>Sommige studies geven aan dat aanvallen gemiddeld langer duren en vaker voorkomen bij vrouwen dan bij mannen⁵.&lt;/span>&lt;/p>&#xd;&#xa;&lt;p>&lt;span class=&quot;body-unica-26-reg&quot;>De Belgische enquête benadrukt ook het hormonale aspect²:&lt;/span>&lt;/p>&#xd;&#xa;&lt;ul>&#xd;&#xa;&lt;li>&lt;span class=&quot;body-unica-26-reg&quot;>65 % van de respondenten meldt een familiale voorgeschiedenis.&lt;/span>&lt;/li>&#xd;&#xa;&lt;li>&lt;span class=&quot;body-unica-26-reg&quot;>Een aanzienlijk deel ziet een verband tussen de aanvallen en de menstruatiecyclus.&lt;/span>&lt;/li>&#xd;&#xa;&lt;li>&lt;span class=&quot;body-unica-26-reg&quot;>58 % geeft aan meer informatie te willen ontvangen over het verband tussen hormonen en migraine.&amp;nbsp;&lt;/span>&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;&lt;p>&lt;span class=&quot;body-unica-26-reg&quot;>Toch geeft slechts een minderheid aan informatie of een specifieke aanpak te hebben gekregen die verband houdt met dit aspect².&lt;/span>&lt;/p>&#xd;&#xa;&lt;p>&amp;nbsp;&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <title_copy_copy_copy
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2026-03-05T09:19:03.534-05:00"
                                    jcr:createdBy="BAUFAAX"
                                    jcr:lastModified="{Date}2026-03-05T10:10:15.772-05:00"
                                    jcr:lastModifiedBy="BAUFAAX"
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="Beter begrijpen om beter te kunnen ondersteunen"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h1"
                                    variant="h"/>
                                <text2_copy_copy_copy
                                    cq:styleIds="[1659545825678,1659545835858]"
                                    jcr:lastModified="{Date}2026-03-05T10:12:13.103-05:00"
                                    jcr:lastModifiedBy="BAUFAAX"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>&lt;span class=&quot;body-unica-26-reg&quot;>De gegevens uit deze Europese enquête werpen een concreet licht op de realiteit die vrouwen in België ervaren. Beter informeren, beter diagnosticeren en zorgtrajecten beter structureren zijn belangrijke hefbomen om de erkenning en ondersteuning van patiënten te verbeteren.&lt;/span>&lt;/p>&#xd;&#xa;&lt;p>&amp;nbsp;&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <text2_copy_copy_copy_1674345661
                                    cq:styleIds="[1659545825678,1659545835858]"
                                    jcr:lastModified="{Date}2026-03-05T10:16:08.588-05:00"
                                    jcr:lastModifiedBy="BAUFAAX"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>&lt;b>Meer weten:&lt;/b>&lt;/p>&#xd;&#xa;&lt;ul>&#xd;&#xa;&lt;li>Raadpleeg onze brochure &lt;b>&lt;a href=&quot;https://www.abbvie.be/content/dam/abbvie-com2/be/documents/abbvie10-migraine-brochure-250909_NL1.pdf&quot; target=&quot;_blank&quot;>“Migraine at Work”&lt;/a>&lt;/b>&lt;/li>&#xd;&#xa;&lt;li>Ontdek ons&lt;b> &lt;a href=&quot;https://open.spotify.com/show/2lW8ZZuQ5caeOkFiq8djWm&quot; target=&quot;_blank&quot;>podcastseizoen gewijd aan migraine&lt;/a>&lt;/b>&lt;/li>&#xd;&#xa;&lt;li>Vind informatie en ondersteuning via de patiëntenvereniging &lt;b>&lt;a href=&quot;https://www.hoofd-stuk.be/&quot; target=&quot;_blank&quot;>Hoofd-Stuk vzw&lt;/a>&lt;/b>&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;&lt;p>Dit artikel heeft als doel bij te dragen aan een beter begrip van migraine. Het vervangt geen medisch advies en is niet bedoeld om therapeutische aanbevelingen te formuleren.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <separator_copy_1880015361
