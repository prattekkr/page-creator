                                    jcr:createdBy="singarx"
                                    jcr:lastModified="{Date}2024-10-16T05:56:38.516-04:00"
                                    jcr:lastModifiedBy="singarx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/quote"
                                    attributionName="Kristian Reich"
                                    attributionTitle="professor aan het Dermatologikum in Hamburg, Duitsland"
                                    bgImageModifiers="resMode=sharp2&amp;op_sharpen=1"
                                    imageModifiers="resMode=sharp2&amp;op_sharpen=1"
                                    quote="Wanneer ik patiënten met psoriasis vraag wat ze willen, antwoorden ze steevast: Ik wil mijn aandoening niet meer kunnen zien. "
                                    quoteType="regular"
                                    textSize="h0"/>
                                <separator_1857340046
