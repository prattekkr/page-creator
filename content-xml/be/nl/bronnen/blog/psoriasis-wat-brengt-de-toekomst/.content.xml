                                text="&lt;p>AbbVie SA/NV -&amp;nbsp;BE-ABBV-240177 (V1.0) - December 2024&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <text_1930548101
                                jcr:created="{Date}2024-12-18T14:57:29.553-05:00"
                                jcr:createdBy="BAUFAAX"
                                jcr:lastModified="{Date}2024-12-18T14:57:46.018-05:00"
                                jcr:lastModifiedBy="BAUFAAX"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;b>Referenties&lt;/b>&lt;/p>&#xd;&#xa;&lt;ol>&#xd;&#xa;&lt;li>Jang DI, Lee AH, Shin HY, et al. The Role of Tumor Necrosis Factor Alpha (TNF-α) in Autoimmune Disease and Current TNF-α Inhibitors in Therapeutics.&amp;nbsp;&lt;i>Int J Mol Sci&lt;/i>. 2021;22(5):2719. Published 2021 Mar 8. doi:10.3390/ijms22052719&lt;/li>&#xd;&#xa;&lt;li>Brownstone ND, Hong J, Mosca M, et al. Biologic Treatments of Psoriasis: An Update for the Clinician.&amp;nbsp;&lt;i>Biologics&lt;/i>. 2021;15:39-51. Published 2021 Feb 16. doi:10.2147/BTT.S252578.&lt;/li>&#xd;&#xa;&lt;li>Canadian Association of Psoriasis Patients, Psoriasis, Score Pasi,&amp;nbsp;&lt;a href=&quot;https://canadianpsoriasis.ca/fr/psoriasis-fr/qu-est-ce-que-le-psoriasis/score-pasi#:~:text=PASI%20100%20signifie%20que%20la,PASI%2090%20et%20PASI%20100&quot;>https://canadianpsoriasis.ca/fr/psoriasis-fr/qu-est-ce-que-le-psoriasis/score-pasi#:~:text=PASI%20100%20signifie%20que%20la,PASI%2090%20et%20PASI%20100&lt;/a>., Last accessed December 2024.&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;/ol>&#xd;&#xa;"
                                textIsRich="true"/>
