                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;sup>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-26-reg&quot;>de podcast die patiënten een stem geeft&amp;nbsp;&lt;/span>&lt;/span>&lt;/sup>&lt;/p>&#xd;&#xa;"
