                                jcr:primaryType="nt:unstructured"
                                jcr:title="Transparantie"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                langAttribute="none"
                                type="h3"
                                variant="h"/>
                            <text_87969147_copy
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2024-10-09T04:12:37.989-04:00"
                                jcr:createdBy="kanchrx3"
                                jcr:lastModified="{Date}2026-05-28T13:00:27.137-04:00"
                                jcr:lastModifiedBy="BAUFAAX"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                langAttribute="none"
                                text="&lt;p>Bij AbbVie engageren we ons om transparant te handelen in onze interacties met actoren in de gezondheidszorg, waaronder zorgverleners, gezondheidszorgorganisaties en patiëntenverenigingen. Informatie over waardeoverdrachten wordt gepubliceerd op het nationale platform BeTransparent: &lt;a href=&quot;http://www.betransparent.be&quot; target=&quot;_blank&quot;>www.betransparent.be&lt;/a>&lt;/p>&#xd;&#xa;"
