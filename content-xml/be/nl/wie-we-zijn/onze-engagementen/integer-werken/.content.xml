                            <text_87969147
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2024-10-09T04:12:37.989-04:00"
                                jcr:createdBy="kanchrx3"
                                jcr:lastModified="{Date}2024-10-09T04:13:07.916-04:00"
                                jcr:lastModifiedBy="kanchrx3"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Om op lange termijn een positieve impact te hebben op de patiënten, verdienen en behouden wij hun vertrouwen door altijd integer te handelen. We zijn trots op onze onwankelbare principes en ons engagement. We weten dat dit niet alleen de juiste keuze is, maar dat het ook de veerkracht van ons bedrijf en ons succes op lange termijn verzekert. &lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
