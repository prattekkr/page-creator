                                singleExpansion="false">
                                <item_1670707220579
                                    cq:panelTitle="Allergan Aesthetics "
                                    cq:styleIds="[1659545825678]"
                                    jcr:lastModified="{Date}2024-10-11T08:56:50.120-04:00"
                                    jcr:lastModifiedBy="singarx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Allergan Aesthetics, een dochter van AbbVie, ontwikkelt, produceert en commercialiseert een portefeuille van toonaangevende esthetische merken en producten. Ga aan de slag bij een team dat gelooft in de kracht van vertrouwen.&amp;nbsp;&lt;/p>&#xd;&#xa;&lt;p>Onze functies bij Allergan Aesthetics:&lt;/p>&#xd;&#xa;&lt;ul>&#xd;&#xa;&lt;li>Allergan Data Labs&lt;/li>&#xd;&#xa;&lt;li>Communications &amp;amp; Customer Engagement&lt;/li>&#xd;&#xa;&lt;li>Global Strategy and Pipeline Marketing&lt;/li>&#xd;&#xa;&lt;li>Sales&lt;/li>&#xd;&#xa;&lt;li>Sales Training&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <item_1670707211154
                                    cq:panelTitle="Commercial "
                                    cq:styleIds="[1659545825678]"
                                    jcr:lastModified="{Date}2024-10-11T08:58:57.071-04:00"
                                    jcr:lastModifiedBy="singarx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Ga aan de slag bij onze teams voor verkoop, marketing en business support, die de patiënten in contact brengen met nieuwe therapieën en oplossingen met een positieve impact op hun leven&lt;/p>&#xd;&#xa;&lt;p>Onze commerciële functies:&lt;/p>&#xd;&#xa;&lt;ul>&#xd;&#xa;&lt;li>Market Access&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;li>Market Analytics &amp;amp; Business Intelligence&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;li>Marketing&lt;/li>&#xd;&#xa;&lt;li>Sales&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <item_1670707214308
                                    cq:panelTitle="Corporate "
                                    cq:styleIds="[1659545825678]"
                                    jcr:lastModified="{Date}2024-10-11T09:06:55.169-04:00"
                                    jcr:lastModifiedBy="singarx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Vind nieuwe manieren om ons concurrentievoordeel te vergroten, onze mensen te steunen en een integere leider te zijn in alles wat we doen.&lt;/p>&#xd;&#xa;&lt;p>Onze corporatefuncties:&lt;/p>&#xd;&#xa;&lt;ul>&#xd;&#xa;&lt;li>Business Technology Solutions (BTS)&lt;/li>&#xd;&#xa;&lt;li>Corporate Responsibility, Brand &amp;amp; Communications&lt;/li>&#xd;&#xa;&lt;li>Finance &amp;amp; Accounting&lt;/li>&#xd;&#xa;&lt;li>Government Affairs&lt;/li>&#xd;&#xa;&lt;li>Health Economics Outcomes Research&lt;/li>&#xd;&#xa;&lt;li>Human Resources&lt;/li>&#xd;&#xa;&lt;li>Legal&lt;/li>&#xd;&#xa;&lt;li>Office of Ethics and Compliance (OEC)&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <item_1670707217700
                                    cq:panelTitle="Operations"
                                    jcr:lastModified="{Date}2024-10-11T09:09:49.147-04:00"
                                    jcr:lastModifiedBy="singarx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Werk samen met wereldwijde experts aan de ontwikkeling en levering van oplossingen voor patiënten die aan alle veiligheids- en kwaliteitsnormen voldoen of ze zelfs overtreffen.&lt;/p>&#xd;&#xa;&lt;p>Onze operationele functies:&lt;/p>&#xd;&#xa;&lt;ul>&#xd;&#xa;&lt;li>Purchasing&lt;/li>&#xd;&#xa;&lt;li>Quality&lt;/li>&#xd;&#xa;&lt;li>Supply Chain&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <item_1670707208042
                                    cq:panelTitle="Research and Development"
                                    cq:styleIds="[1659545825678]"
                                    jcr:lastModified="{Date}2024-10-11T09:13:02.977-04:00"
                                    jcr:lastModifiedBy="singarx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Verken nieuw terrein in de ontdekking en ontwikkeling van geneesmiddelen en oplossingen, en verzeker dat onze producten en praktijken aan de strengste regelgeving voldoen.&amp;nbsp;&lt;/p>&#xd;&#xa;&lt;p>Onze functies in R&amp;amp;D:&lt;/p>&#xd;&#xa;&lt;ul>&#xd;&#xa;&lt;li>Clinical Research and Site Monitoring&lt;/li>&#xd;&#xa;&lt;li>Medical Affairs&lt;/li>&#xd;&#xa;&lt;li>Pharmacovigilance&lt;/li>&#xd;&#xa;&lt;li>Quality Assurance&lt;/li>&#xd;&#xa;&lt;li>Regulatory Operations, Policy &amp;amp; Intelligence&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;"
                                    textIsRich="true"/>
