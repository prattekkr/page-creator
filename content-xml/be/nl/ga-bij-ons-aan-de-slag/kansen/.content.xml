                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;sup>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;> Bij AbbVie werken we elke dag vol energie en doorzettingsvermogen om nieuwe en betere manieren te vinden om mensen overal ter wereld te helpen.&lt;/span>&lt;/span>&lt;/sup>&lt;/p>&#xd;&#xa;"
