                                jcr:createdBy="NANDIVX5"
                                jcr:lastModified="{Date}2024-10-16T06:27:23.153-04:00"
                                jcr:lastModifiedBy="NANDIVX5"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Healthcare Heroes richt zich tot alle studenten in België en omvat:&lt;/p>&#xd;&#xa;&lt;ul>&#xd;&#xa;&lt;li>Sensibilisering voor de uitdagingen en opportuniteiten in onze gezondheidzorg&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;li>Coaching door gerenommeerde experts: artsen, apothekers, patiënten, verzekeraars en specialisten in medische technologieën&lt;/li>&#xd;&#xa;&lt;li>Een hackathon, begeleid door facilitators die opgeleid zijn in design thinking, om de studenten te helpen innoverende ideeën te bedenken en te ontwikkelen&lt;/li>&#xd;&#xa;&lt;li>Een grote finale in het federale parlement om de ideeën aan de politieke besluitvormers voor te stellen&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;&lt;p>De volgende editie van Healthcare Heroes zal plaatsvinden in 2025. Ontdek alle informatie over de wedstrijd op de website&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
