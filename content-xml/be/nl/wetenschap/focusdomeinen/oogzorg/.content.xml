                            sling:resourceType="abbvie-com2/components/accordion/v2/accordion"
                            heading="Focusdomeinen in de oogzorg "
                            headingElement="h5"
                            singleExpansion="false">
                            <item_1671312472873
                                cq:panelTitle=" Chronische drogeogenziekte"
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2024-12-18T10:27:20.007-05:00"
                                jcr:lastModifiedBy="BAUFAAX"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Een chronische ziekte die veroorzaakt kan worden door ouderdom, het dragen van contactlenzen, bepaalde medicaties, oogziekten, andere medische aandoeningen of milieufactoren.&lt;sup>1&lt;/sup>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <item_1671312475801
                                cq:panelTitle="Glaucome"
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2024-12-18T10:27:33.421-05:00"
                                jcr:lastModifiedBy="BAUFAAX"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Een groep oogziekten (er bestaan veel verschillende types) die de oogzenuw aantasten. Ze houden meestal verband met hoge druk in de ogen en kunnen blindheid veroorzaken.&lt;sup>2&lt;/sup>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <item_1671312481387
                                cq:panelTitle="Leeftijdsgebonden ziekten van het netvlies"
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2024-12-18T10:27:44.694-05:00"
                                jcr:lastModifiedBy="BAUFAAX"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Een beschadiging van de gele vlek, bij het centrum van het netvlies, tast het centrale zicht aan en het vermogen om fijne details te zien. Leeftijdgebonden aantasting van de gele vlek is de courantste oorzaak van ernstige slechtziendheid bij personen van 60 jaar en ouder.&lt;sup>3&lt;/sup>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <item_1671372277563
                                cq:panelTitle="Refractiestoornissen "
