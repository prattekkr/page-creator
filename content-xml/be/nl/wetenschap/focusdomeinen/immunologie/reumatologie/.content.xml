                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>AbbVie SA/NV –&amp;nbsp;BE-ABBV-240167 (1.0) – Decembre 2024&lt;/p>&#xd;&#xa;&lt;p>&amp;nbsp;&lt;/p>&#xd;&#xa;&lt;p>&lt;b>Referenties&lt;/b>&lt;/p>&#xd;&#xa;&lt;ol>&#xd;&#xa;&lt;li>&lt;sup>Rheumatoid Arthritis, Mayo Clinic,&amp;nbsp;&lt;a href=&quot;https://mayoclinic.org/diseases-conditions/rheumatoid-arthritis/symptoms-causes/syc-20353648&quot;>https://mayoclinic.org/diseases-conditions/rheumatoid-arthritis/symptoms-causes/syc-20353648&lt;/a>, Last accessed December 2024.&lt;/sup>&lt;/li>&#xd;&#xa;&lt;li>&lt;sup>About Psoriasis Arthritis, National Psoriasis Foundation,&amp;nbsp;&lt;a href=&quot;https://www.psoriasis.org/about-psoriatic-arthritis/&quot;>https://www.psoriasis.org/about-psoriatic-arthritis/&lt;/a>, Last accessed December 2024.&lt;/sup>&lt;/li>&#xd;&#xa;&lt;li>&lt;sup>Spondylarthritis, American College of Rheumatology,&amp;nbsp;&lt;a href=&quot;https://rheumatology.org/patients/spondyloarthritis&quot;>https://rheumatology.org/patients/spondyloarthritis&lt;/a>, Last accessed December 2024.&lt;/sup>&lt;/li>&#xd;&#xa;&lt;li>&lt;sup>Ankylosing spondylitis &amp;amp; non radiographic axial spondylarthritis, Arthritis Foundation,&amp;nbsp;&lt;a href=&quot;https://www.arthritis.org/diseases/ankylosing-spondylitis&quot;>https://www.arthritis.org/diseases/ankylosing-spondylitis&lt;/a>, Last accessed December 2024.&lt;/sup>&lt;/li>&#xd;&#xa;&lt;li>&lt;sup>Uveitis, Mayo Clinic,&amp;nbsp;&lt;a href=&quot;https://www.mayoclinic.org/diseases-conditions/uveitis/symptoms-causes/syc-20378734&quot;>https://www.mayoclinic.org/diseases-conditions/uveitis/symptoms-causes/syc-20378734&lt;/a>, Last accessed December 2024.&lt;/sup>&lt;/li>&#xd;&#xa;&lt;li>&lt;sup>Maidhof W, Hilas O. Lupus: an overview of the disease and management options. P T. 2012;37:240-249.&lt;/sup>&lt;/li>&#xd;&#xa;&lt;li>&lt;sup>Juvenile Arthritis, Arthritis Foundation,&amp;nbsp;&lt;a href=&quot;https://www.arthritis.org/diseases/juvenile-arthritis&quot;>https://www.arthritis.org/diseases/juvenile-arthritis&lt;/a>, Last accessed December 2024.&amp;nbsp;&lt;/sup>&lt;/li>&#xd;&#xa;&lt;/ol>&#xd;&#xa;"
