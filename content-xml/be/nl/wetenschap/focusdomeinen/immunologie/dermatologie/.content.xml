                                    sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                                <accordion
                                    cq:styleIds="[1]"
                                    jcr:created="{Date}2024-08-07T04:04:57.303-04:00"
                                    jcr:createdBy="kanchrx3"
                                    jcr:lastModified="{Date}2024-10-08T04:51:06.890-04:00"
                                    jcr:lastModifiedBy="NANDIVX5"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/accordion/v2/accordion"
                                    singleExpansion="false">
                                    <item_1723017953144
                                        cq:panelTitle="Psoriasis (PsO) "
                                        cq:styleIds="[1659545825678]"
                                        jcr:lastModified="{Date}2024-12-17T14:49:20.675-05:00"
                                        jcr:lastModifiedBy="BAUFAAX"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="abbvie-com2/components/text/v2/text"
                                        text="&lt;p>Deze chronische ziekte van het immuunsysteem leidt tot de ontsteking van de huid en een abnormaal snelle productie van huidcellen, zodat dikke, rode, jeukende en schilferende vlekken ontstaan, de zogenaamde plaques.&lt;sup>1&lt;/sup> Psoriasis kan een negatieve impact hebben op de geestelijke gezondheid en het welzijn, met onder meer schaamte, boosheid en piekeren, naast moeilijkheden met de dagelijkse activiteiten en dus een impact op de levenskwaliteit.&lt;sup>2&lt;/sup>&lt;/p>&#xd;&#xa;"
                                        textIsRich="true"/>
                                    <item_1723017971674
                                        cq:panelTitle="Atopische dermatitis(AD) "
                                        cq:styleIds="[1659545825678]"
                                        jcr:lastModified="{Date}2024-12-17T14:50:02.761-05:00"
                                        jcr:lastModifiedBy="BAUFAAX"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="abbvie-com2/components/text/v2/text"
                                        text="&lt;p>AD is een chronische ontstekingsziekte die wordt gekenmerkt door intense jeuk, vochtafscheiding, korstvorming, roodheid, huiderosie en een droge huid.&lt;sup>3&lt;/sup> AD treft niet alleen de huid, maar heeft ook een holistische impact op het leven van de patiënten: een slechte slaap, een lagere productiviteit op het werk, naast gevolgen voor de geestelijke gezondheid, vooral tijdens opstoten, met vermoeidheid en een aantasting van de levenskwaliteit.&lt;sup>4&lt;/sup>&lt;/p>&#xd;&#xa;"
                                        textIsRich="true"/>
                                    <item_1723018007388
                                        cq:panelTitle="Artritis psoriatica (PsA)"
                                        cq:styleIds="[1659545825678]"
                                        jcr:lastModified="{Date}2024-12-17T14:50:25.018-05:00"
                                        jcr:lastModifiedBy="BAUFAAX"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="abbvie-com2/components/text/v2/text"
                                        text="&lt;p>Een inflammatoire artritis met pijnlijke gewrichten, stijfheid en zwelling. Ongeveer 30 procent van de patiënten met psoriasis zal ook artritis psoriatica ontwikkelen.&lt;sup>5&lt;/sup>&lt;/p>&#xd;&#xa;"
                                        textIsRich="true"/>
                                    <item_1723018045210
                                        cq:panelTitle="Hidradenitis suppurativa (HS) "
                                        cq:styleIds="[1659545825678]"
                                        jcr:lastModified="{Date}2024-12-17T14:50:41.056-05:00"
                                        jcr:lastModifiedBy="BAUFAAX"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="abbvie-com2/components/text/v2/text"
                                        text="&lt;p>HS is een chronische ontstekingsziekte die soms moeilijk te diagnosticeren is. Het is een voortschrijdende ziekte, die na verloop van tijd ernstiger kan worden en onomkeerbare huidletsels en ondraaglijke pijn kan veroorzaken.&lt;sup>6&lt;/sup>&lt;/p>&#xd;&#xa;"
                                        textIsRich="true"/>
                                </accordion>
