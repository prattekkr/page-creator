                                jcr:lastModified="{Date}2024-10-08T04:58:49.965-04:00"
                                jcr:lastModifiedBy="NANDIVX5"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Psoriasis, meer dan een huidziekte&lt;/p>&#xd;&#xa;&lt;p>Psoriasis is een ontstekingsziekte van de huid. Maar als de symptomen niet onder controle worden gehouden, kunnen ze de patiënten ook psychologisch en emotioneel ondermijnen.&lt;/p>&#xd;&#xa;&lt;p>Dankzij de evolutie van de behandelingen is een zuivere huid vandaag een realistisch behandelingsdoel. Ontdek de website ikkanwel.be en vind de behandeling die je het best past.&lt;/p>&#xd;&#xa;&lt;p>&lt;a href=&quot;http://www.ikkanwel.be&quot; target=&quot;_blank&quot;>Meer weten&lt;/a>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
