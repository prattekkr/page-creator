                                    type="h3"
                                    variant="h"/>
                                <text2
                                    cq:styleIds="[1659545825678,1659545835858]"
                                    jcr:lastModified="{Date}2024-10-08T01:32:14.208-04:00"
                                    jcr:lastModifiedBy="NANDIVX5"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Met elke nieuwe ontdekking begrijpen we beter hoe de patiënten van elkaar verschillen – zelfs als ze met dezelfde ziekte gediagnosticeerd zijn – zodat we meer gepersonaliseerde behandelingen voor immunologische ziekten kunnen ontwikkelen. Wereldwijd worden meer dan 1 miljoen personen met immuun-gemedieerde ziekten behandeld met onze therapieën.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                            </container4>
