                                    jcr:lastModifiedBy="NANDIVX5"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/quote"
                                    attributionName="Michael Gold, M.D."
                                    attributionTitle="VP, Neuroscience Development"
                                    bgImageModifiers="resMode=sharp2&amp;op_sharpen=1"
                                    imageModifiers="resMode=sharp2&amp;op_sharpen=1"
                                    quote="Onze nieuwsgierige en volhardende wetenschappers focussen op het vinden van nieuwe inzichten die zinvolle veranderingen voor de patiënten opleveren."
                                    quoteType="regular"
                                    textSize="h0"/>
