                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="Focusdomeinen in de neurowetenschap en de psychiatrie"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h2"
                                    variant="h"/>
                                <text2
                                    cq:styleIds="[1659545825678,1659545835858]"
                                    jcr:lastModified="{Date}2024-10-14T06:21:26.153-04:00"
                                    jcr:lastModifiedBy="NANDIVX5"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>De last van neurologische en psychiatrische aandoeningen kan ondraaglijk lijken. Maar dat besef spoort ons aan om enkele van de grootste uitdagingen aan te gaan en oplossingen te zoeken die heel de patiënt in aanmerking nemen.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <separator
                                    cq:styleIds="[1662756456518]"
                                    jcr:created="{Date}2024-08-11T08:34:31.311-04:00"
                                    jcr:createdBy="kanchrx3"
