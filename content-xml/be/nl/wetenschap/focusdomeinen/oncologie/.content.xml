                                <text2
                                    cq:styleIds="[1659545825678,1659545835858]"
                                    jcr:lastModified="{Date}2024-10-14T05:58:58.600-04:00"
                                    jcr:lastModifiedBy="NANDIVX5"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Wij&lt;b> focussen op oplossingen die de behandeling van kanker transformeren&lt;/b>. We willen betere en blijvende resultaten bereiken voor bloedkankers en vaste tumoren. Onze cultuur van nieuwsgierigheid spoort ons aan om nieuwe oplossingen te ontdekken.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <separator
