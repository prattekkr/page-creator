                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>Buiten onze belangrijkste therapeutische gebieden onderzoeken onze wetenschappers een waaier aan ziekten met onbeantwoorde behoeften, waarvoor we een grote vooruitgang voor de patiënten mogelijk kunnen maken.&amp;nbsp;&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
