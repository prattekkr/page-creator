                            jcr:lastModifiedBy="jewitca"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>We steunen de initiatieven van patiëntenverenigingen om de patiënten, hun familie en zorgverstrekkers de kennis en de middelen mee te geven om hun ziekte te begrijpen en ermee om te gaan.&amp;nbsp;&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
                        <separator_1100770780_2015410877
