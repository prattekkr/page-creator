                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>Samen met patiëntenverenigingen ontwikkelen wij&amp;nbsp; ondersteuningsprogramma's om te verzekeren dat patiënten optimaal worden behandeld.&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
                        <separator_1100770780_1726967249
