                            jcr:lastModifiedBy="jewitca"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>Door met patiëntenverenigingen samen te werken houden we voeling met de behoeften van de patiënten. Als we begrijpen wat mensen als gevolg van hun ziekte denken, voelen en doen, kunnen we inspelen op hun behoeften.&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
