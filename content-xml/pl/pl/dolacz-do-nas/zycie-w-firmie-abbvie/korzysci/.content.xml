                                jcr:lastModifiedBy="DEVIJX1"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Nasze programy wynagrodzeń, świadczeń i dobrego samopoczucia wspierają Twoje zróżnicowane i zmieniające się potrzeby na każdym etapie Twojej kariery i życia. Oferujemy zróżnicowane i konkurencyjne nagrody i korzyści. Niektóre programy różnią się w zależności od kraju.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
