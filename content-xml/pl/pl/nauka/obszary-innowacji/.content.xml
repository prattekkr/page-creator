                        sling:resourceType="abbvie-com2/components/container/v2/container">
                        <title_116699496
                            cq:styleIds="[1659545825678,1661545829678]"
                            jcr:created="{Date}2022-12-15T11:49:26.700-05:00"
                            jcr:createdBy="chiucx"
                            jcr:lastModified="{Date}2024-07-15T18:46:07.423-04:00"
                            jcr:lastModifiedBy="jewitca"
                            jcr:primaryType="nt:unstructured"
                            jcr:title="To, co robimy teraz, kształtuje naszą przyszłość"
                            sling:resourceType="abbvie-com2/components/title/v2/title"
                            type="h3"
                            variant="h"/>
                        <text_copy_copy
                            cq:styleIds="[1659545825678]"
                            jcr:created="{Date}2022-12-07T14:53:09.069-05:00"
                            jcr:createdBy="chiucx"
                            jcr:lastModified="{Date}2024-08-20T17:39:40.801-04:00"
                            jcr:lastModifiedBy="jewitca"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>Nasze unikalne podejście do nauki oraz nieustanne poszukiwanie i opracowywanie innowacyjnych rozwiązań poprawiających jakość życia pacjentów, stanowią główną siłę napędową AbbVie. Nasza firma wdraża kolejne innowacje, aby efektywnie odpowiadać na zmieniające się potrzeby otoczenia. Inwestujemy w kluczowe obszary i technologie, takie jak: medycyna precyzyjna, nowoczesne metody zarządzania danymi, genetyka i genomika oraz opracowywanie leków ukierunkowanych na pacjenta. Jesteśmy przekonani, że nasze zaangażowanie umożliwi dostarczanie jeszcze lepszych i bardziej skutecznych rozwiązań dla naszych pacjentów.&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
                    </container_2049798639>
                    <container_472145492
                        cq:styleIds="[1653545835982,1653545825688]"
                        jcr:created="{Date}2024-03-21T12:41:49.031-04:00"
                        jcr:createdBy="jewitca"
                        jcr:lastModified="{Date}2024-03-21T12:41:49.031-04:00"
