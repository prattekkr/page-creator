                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>W AbbVie zespoły ds. badań i rozwoju stawiają sobie ambitne cele: tworzyć terapie i rozwiązania, których nikt jeszcze nie wdrożył, a nawet nie podjął próby opracowania. Chcemy być pierwsi i do tego dążymy każdego dnia – dla dobra pacjentów.&amp;nbsp;&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
