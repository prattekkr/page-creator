                            <item_1710905612424_c
                                cq:panelTitle="INNOWACJE PRODUKTOWE"
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2024-07-02T15:11:26.794-04:00"
                                jcr:lastModifiedBy="jewitca"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Pracujemy, aby niestrudzenie opracowywać i dostarczać innowacyjne leki, które rozwiązują poważne problemy zdrowotne i poprawiają jakość życia ludzi.&lt;/p>&#xd;&#xa;&lt;p>&lt;a href=&quot;/content/abbvie-com2/pl/pl/nauka/obszary-innowacji.html&quot;>Dowiedz się więcej&lt;/a>&lt;/p>&#xd;&#xa;&lt;p>&amp;nbsp;&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <item_1710905635884
                                cq:panelTitle="JAKOŚĆ I BEZPIECZEŃSTWO STOSOWANIA PRODUKTÓW"
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2024-07-02T15:12:59.042-04:00"
                                jcr:lastModifiedBy="jewitca"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Dokładamy wszelkich starań, aby dostarczać bezpieczne i skuteczne produkty oraz leki wysokiej jakości, w czym wspierają nas solidne systemy kontroli jakości.&lt;/p>&#xd;&#xa;&lt;p>&lt;a href=&quot;/content/abbvie-com2/pl/pl/nauka/jakosc-i-bezpieczenstwo-produktu.html&quot;>Dowiedz się więcej&lt;/a>&lt;/p>&#xd;&#xa;&lt;p>&amp;nbsp;&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <item_1710905644552
                                cq:panelTitle="ZARZĄDZANIE KAPITAŁEM LUDZKIM "
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2024-06-21T13:16:09.288-04:00"
                                jcr:lastModifiedBy="jewitca"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Rozwijamy talenty. Tym samym skuteczniej rozwiązujemy wyzwania zdrowotne i wywieramy pozytywny wpływ na życie ludzi.&lt;/p>&#xd;&#xa;&lt;p>&lt;a href=&quot;/content/abbvie-com2/pl/pl/dolacz-do-nas.html&quot;>Dowiedz się więcej&lt;/a>&lt;/p>&#xd;&#xa;&lt;p>&amp;nbsp;&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <item_1710905652348
                                cq:panelTitle="ZDROWIE I ZAANGAŻOWANIE PACJENTÓW"
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2024-06-21T13:16:40.376-04:00"
                                jcr:lastModifiedBy="jewitca"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Nieprzerwanie dążymy do poprawy wyników zdrowotnych pacjentów na całym świecie.&lt;/p>&#xd;&#xa;&lt;p>&lt;a href=&quot;/content/abbvie-com2/pl/pl/pacjenci.html&quot;>Dowiedz się więcej&lt;/a>&lt;/p>&#xd;&#xa;&lt;p> &lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <item_1710905661296
                                cq:panelTitle="ETYKA BIZNESOWA"
                                jcr:lastModified="{Date}2024-06-21T13:16:59.489-04:00"
                                jcr:lastModifiedBy="jewitca"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>We wszystkim, co robimy, kierujemy się uczciwością.&lt;/p>&#xd;&#xa;&lt;p>&lt;a href=&quot;/content/abbvie-com2/pl/pl/o-nas/etyka-w-dzialaniu/kodeks-etyki-abbvie.html&quot;>Dowiedz się więcej&lt;/a>&lt;/p>&#xd;&#xa;&lt;p> &lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <item_1710905669326
                                cq:panelTitle="OCHRONA ŚRODOWISKA"
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2024-06-21T13:17:19.176-04:00"
                                jcr:lastModifiedBy="jewitca"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Stosując innowacje, chcemy zmniejszać nasz wpływ na środowisko i rozwijać się w zrównoważony sposób.&amp;nbsp;&lt;/p>&#xd;&#xa;&lt;p>&lt;a href=&quot;/content/dam/abbvie-com2/pl/documents/informacja-o-realizacji-celow-w-zakresie-gospodarowania-odpadami1.pdf&quot; target=&quot;_blank&quot;>Dowiedz się więcej&lt;/a>&lt;/p>&#xd;&#xa;&lt;p>&amp;nbsp;&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                        </accordion>
