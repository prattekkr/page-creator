                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>Cluster Sur está formado por &lt;b>Argentina, Chile, Paraguay y Uruguay&lt;/b>. Impulsamos el trabajo conjunto para realizar un aporte que logre un cambio significativo en la vida de nuestros pacientes.&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
