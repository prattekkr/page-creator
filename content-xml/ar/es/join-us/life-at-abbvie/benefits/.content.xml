                                text="&lt;p> &lt;sup>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>Acompañamiento en cada etapa de la vida laboral y personal.&lt;/span>&lt;/span>&lt;/sup>&lt;/p>&#xd;&#xa;"
