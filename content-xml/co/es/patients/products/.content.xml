                                    jcr:lastModifiedBy="DEVIJX1"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>&lt;b>Solicitudes de información médica:&lt;/b>&lt;/p>&#xd;&#xa;&lt;p>Si es un profesional de la salud o un paciente o cuidador y desea buscar información sobre productos o enviar una consulta al equipo de información médica de AbbVie, visite&amp;nbsp;&lt;a href=&quot;http://www.abbviemedinfo.com&quot; title=&quot;http://www.abbviemedinfo.com&quot; target=&quot;_blank&quot;>www.abbviemedinfo.com&lt;/a>.&lt;/p>&#xd;&#xa;"
