                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>&lt;b>Se le anima a informar a la FDA sobre los efectos secundarios negativos de los medicamentos recetados. Visite www.fda.gov/medwatch o llame al 1-800-FDA-1088 (1-800-332-1088).&lt;/b>&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <text
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2023-04-13T17:55:46.354-04:00"
