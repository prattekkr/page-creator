                                jcr:lastModified="{Date}2025-10-07T04:29:25.061-04:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>애브비는 변혁적인 변화가 지역사회에서 시작된다고 믿습니다. 대담한 사고를 수용하고 파트너와 협력하여 그들의 새로운 아이디어와 접근법을 가속화함으로써, 당사는 구조적 변화를 이끌고 수 세대에 걸쳐 지역사회에 영향을 미쳐온 심각한 건강 불평등을 극복할 수 있는 가장 큰 잠재력을 가지고 있습니다.&lt;br />&#xd;&#xa;&lt;br />&#xd;&#xa;애브비는 지역 기반 조직이 기존의 틀을 깨고 지역사회가 직면한 복잡한 문제를 해결할 수 있는 혁신적인 솔루션을 개발하고 확장하도록 지원하고 역량을 강화하여 모두가 가장 건강한 삶을 살 수 있도록 합니다. &lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
