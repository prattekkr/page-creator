                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>한국애브비는 업의 특성과 역량을 활용해 희귀난치성 질환 환우 등을 위한 사회공헌활동을 펼치고 있습니다.&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator
                                cq:styleIds="[1662756423318]"
                                jcr:created="{Date}2025-10-07T06:59:48.209-04:00"
