                                jcr:lastModified="{Date}2025-10-07T07:00:26.752-04:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>소외받는 이웃들과 건강 약자인 환우들을 위해 창립부터 현재까지 건강한 지역 사회를 위한 꾸준한 나눔과 봉사활동을 실천하고 있습니다.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
