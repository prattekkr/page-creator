                                    jcr:lastModified="{Date}2026-02-26T05:16:06.529-05:00"
                                    jcr:lastModifiedBy="nandivx5"
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="애브비OED팀과 한국애브비 의학부, 서울아산병원 연구진이 Phase 1 Partnerships for Excellence in Research (P1PER) network를 통한 항암제 신약 조기 개발을 위한 협력을 강화했다."
                                    sling:resourceType="abbvie-com2/components/image/v2/image"
                                    altValueFromDAM="true"
                                    displayPopupTitle="false"
                                    dmPresetType="imagePreset"
