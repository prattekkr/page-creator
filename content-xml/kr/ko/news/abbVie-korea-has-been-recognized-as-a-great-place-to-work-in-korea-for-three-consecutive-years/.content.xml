                                    titleValueFromDAM="false"/>
                                <text_197043431
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2026-02-24T01:46:16.880-05:00"
                                    jcr:createdBy="singarx"
                                    jcr:lastModified="{Date}2026-02-26T04:59:20.816-05:00"
                                    jcr:lastModifiedBy="nandivx5"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>&amp;nbsp;&lt;/p>&#xd;&#xa;&lt;p>&lt;b>애브비에 대하여&lt;/b>&lt;/p>&#xd;&#xa;&lt;p>애브비의 사명은 현재의 심각한 건강문제를 해결하고 미래에 발생할 의료분야의 도전을 이겨낼 혁신적인 의약품과 솔루션을 발견하고 제공하는 것이다. 당사는 면역학, 종양학, 신경과학 및 안과학을 비롯한 여러 주요 치료분야와 엘러간 에스테틱의 중점 치료분야와 서비스를 통해 사람들의 삶에 주목할 만한 변화를 만들기 위해 노력한다. 당사에 대한 자세한 내용은 &lt;a href=&quot;http://www.abbvie.xn--com-of0o/&quot;>www.abbvie.com&lt;/a> 방문하거나, &lt;a href=&quot;https://www.linkedin.com/company/abbvie/&quot;>링크드인&lt;/a>, &lt;a href=&quot;https://www.facebook.com/AbbVieGlobal/&quot;>페이스북&lt;/a>, &lt;a href=&quot;https://www.instagram.com/abbvie/&quot;>인스타그램&lt;/a>, &lt;a href=&quot;https://twitter.com/abbvie&quot;>X(구 트위터)&lt;/a>, &lt;a href=&quot;https://www.youtube.com/user/AbbVie&quot;>유튜브&lt;/a>의 애브비 계정에서 확인할 수 있다.&lt;/p>&#xd;&#xa;&lt;p>한국애브비(대표이사 강소영)는 서울 본사와 부산, 대구, 광주, 대전 등 전국에 걸쳐 제품을 공급하고 있으며, 상세 정보는 &lt;a href=&quot;http://www.abbvie.co.kr/&quot;>www.abbvie.co.kr&lt;/a>에서 확인할 수 있다.&lt;/p>&#xd;&#xa;&lt;p>&lt;b>&amp;nbsp;&lt;/b>&lt;/p>&#xd;&#xa;&lt;p>&lt;b>Great Place to Work®에 대하여&lt;/b>&lt;/p>&#xd;&#xa;&lt;p>일하기 좋은 일터(Great Place to Work®)는 경영진과 상사에 대한 높은 신뢰를 기반으로 자신의 업무에 대한 강한 자부심을 느끼며, 함께 일하는 동료들과 즐겁고 보람 있게 일하는 일터를 의미한다.&lt;/p>&#xd;&#xa;&lt;p>일하기 좋은 기업 인증제도는 세계 150여개 국가에서 동일한 방법으로 진행되는 가장 공정하고 권위있는 인증제도로, 매년 3만 이상의 기업 및 기관, 2,000만 명 이상이 매년 Emprising TM 플랫폼을 활용, 직원 경험 설문[신뢰지수Trust Index TM]조사에 참여하며, 인증기준(Trust Index TM 60% 이상)을 만족한 기업에 12개월간 인증하며, 대한민국 일하기 좋은 100대 기업 선정 응모 자격을 부여한다.&lt;/p>&#xd;&#xa;&lt;p>&amp;nbsp;&lt;/p>&#xd;&#xa;&lt;p style=&quot;text-align: center;&quot;># # #&lt;/p>&#xd;&#xa;&lt;p>&amp;nbsp;&lt;/p>&#xd;&#xa;&lt;p>&lt;b>&lt;u>[보도자료 관련 문의]&lt;/u>&lt;/b>&lt;/p>&#xd;&#xa;&lt;p>&lt;b>한국애브비 대외협력부&lt;/b>&lt;/p>&#xd;&#xa;&lt;p>박지현 이사 (&lt;a href=&quot;mailto:jihyun.park@abbvie.com&quot;>jihyun.park@abbvie.com&lt;/a>)&lt;br>&#xd;&#xa;안도희 과장 (&lt;a href=&quot;mailto:dohui.an@abbvie.com&quot;>dohui.an@abbvie.com&lt;/a>)&lt;/p>&#xd;&#xa;&lt;p>&amp;nbsp;&lt;/p>&#xd;&#xa;&lt;p>&lt;b>커뮤니케이션 웍스 홍보 담당&lt;/b>&lt;/p>&#xd;&#xa;&lt;p>백훈 이사(010-3697-0263 / &lt;a href=&quot;mailto:robin@ccworks.co.kr&quot;>robin@ccworks.co.kr&lt;/a>)&lt;br>&#xd;&#xa;이원주 차장(010-5715-0706) / &lt;a href=&quot;mailto:pilee@ccworks.co.kr&quot;>pilee@ccworks.co.kr&lt;/a>)&lt;br>&#xd;&#xa;박정하 대리(010-2270-1591 / &lt;a href=&quot;mailto:jhpark@ccworks.co.kr&quot;>jhpark@ccworks.co.kr&lt;/a>)&lt;/p>&#xd;&#xa;"
