                                    jcr:created="{Date}2024-11-11T15:31:08.431-05:00"
                                    jcr:createdBy="VALENSX5"
                                    jcr:lastModified="{Date}2025-10-10T08:55:39.011-04:00"
                                    jcr:lastModifiedBy="nandivx5"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>캘리포니아에서 매사추세츠, 독일, 일본까지—애브비는 '충분함'에 만족하지 않고, 내일의 역량을 새롭게 창조하며 환자들에게 획기적인 의약품과 솔루션을 제공합니다.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <separator
                                    cq:styleIds="[1662756515133]"
                                    jcr:created="{Date}2024-11-11T16:27:32.087-05:00"
