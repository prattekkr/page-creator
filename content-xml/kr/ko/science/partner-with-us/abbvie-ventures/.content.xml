                                            displayPopupTitle="true"
                                            dmPresetType="imagePreset"
                                            fileReference="/content/dam/abbvie-com2/images/cso/christina-vorvis-headshot.jpg"
                                            isDecorative="false"
                                            titleValueFromDAM="true"/>
                                        <text_copy
                                            cq:styleIds="[1659545825678]"
                                            jcr:lastModified="{Date}2025-10-10T06:36:14.156-04:00"
                                            jcr:lastModifiedBy="nandivx5"
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="abbvie-com2/components/text/v2/text"
                                            text="&lt;p> &lt;b>Director, 매사추세츠주 케임브리지&lt;/b>&lt;/p>&#xd;&#xa;&lt;p>크리스티나 보비스 박사는 애브비 동부 벤처 디렉터로, 매사추세츠주 케임브리지에서 암, 면역학, 신경과학, 안과학, 에스테틱 분야의 혁신 치료제 및 기술을 개발하는 초기 단계 기업에 대한 투자를 이끌고 있습니다. 크리스티나 보비스는 생명과학 분야에서 10년 이상의 경력이 있으며, 실험실 연구, 디지털 헬스 스타트업, 투자은행, 그리고 암젠, 오비메드, 백 베이 라이프 사이언스 어드바이저스등 글로벌 기업/기관에서 딜 오리진 및 집행 경험을 쌓았습니다. UCLA에서 암생물학 박사 학위를 취득했으며, 췌장암에서 종양 성장과 진행의 분자적 메커니즘을 연구했습니다. 애브비 입사 전에는 바이오테크 및 제약 회사의 인수합병, 자금 조달 및 기타 전략적 거래에 대한 자문활동을 했습니다. 현재 애브비에서 그녀는 혁신적인 기업들이 새로운 치료 및 기술을 개발하고 상업화하여 전 세계 환자의 삶을 개선할 수 있도록 전문성을 발휘하고 있습니다.&lt;/p>&#xd;&#xa;&lt;p>&lt;a href=&quot;https://www.linkedin.com/in/christinavorvis/&quot;>LinkedIn&lt;/a>&lt;/p>&#xd;&#xa;"
                                            textIsRich="true"/>
                                    </item_1673125666916>
