                                            isDecorative="false"
                                            titleValueFromDAM="true"/>
                                        <text
                                            cq:styleIds="[1659545825678]"
                                            jcr:lastModified="{Date}2026-02-09T02:09:30.108-05:00"
                                            jcr:lastModifiedBy="singarx"
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="abbvie-com2/components/text/v2/text"
                                            text="&lt;p>&lt;b>Head of AbbVie Ventures,  매사추세츠주 케임브리지&lt;/b>&lt;/p>&#xd;&#xa;&lt;p>크리스찬은 글로벌 대형 제약사와 바이오테크 기업에서 경험을 쌓은 유전학자, 신경생물학자이자 생화학자입니다. 그는 호기심이 많은 바이오테크 스타트업의 마인드의 소유자입니다. 애브비 벤처에서 회사 설립, 벤처 투자, 외부 혁신, 사업 개발 및 연구개발에 관한 폭넓은 전략적 역량과 운영 분야의 전문가입니다. 크리스찬은 환자를 위한 과학적 기업가 정신을 바탕으로 의약품 발견과 가치 창출에 열정을 가지고 있으며, 생명과학 밸류체인 전반에 걸쳐 성공적인 파트너십 팀을 미국, 유럽, 아시아-태평양 지역의 바이오테크 허브에서 구축하고 이끌어 왔습니다.&lt;/p>&#xd;&#xa;&lt;p>&lt;a href=&quot;https://www.linkedin.com/in/crs79/&quot;>LinkedIn&lt;/a>&lt;/p>&#xd;&#xa;"
                                            textIsRich="true"/>
                                    </item_1673125365973>
                                    <item_1691182433666_c
                                        cq:panelTitle="더그 폰스(Doug Faunce)"
                                        cq:styleIds="[1653545825683,1653545847150,1653545835982,1653545835879]"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="abbvie-com2/components/container/v2/container">
                                        <image
                                            cq:styleIds="[1402843082812,1402843082823,1402843082836]"
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="abbvie-com2/components/image/v2/image"
                                            altValueFromDAM="true"
                                            displayPopupTitle="true"
                                            dmPresetType="imagePreset"
                                            fileReference="/content/dam/abbvie-com2/images/cso/doug-faunce-headshot.jpg"
                                            isDecorative="false"
                                            titleValueFromDAM="true"/>
                                        <text
                                            cq:styleIds="[1659545825678]"
                                            jcr:lastModified="{Date}2025-10-10T06:27:42.705-04:00"
                                            jcr:lastModifiedBy="nandivx5"
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="abbvie-com2/components/text/v2/text"
                                            text="&lt;p>&lt;b>Executive Director, 캘리포니아주 어바인&lt;/b>&lt;/p>&#xd;&#xa;&lt;p>더그는 기업가적 생명 과학자이자 면역학 박사로, 대형 제약사와 학계에서 20년 이상의 전문 경력을 보유하고 있습니다. 그는 사업 개발 및 외부 전략적 파트너십을 위한 탐색 및 평가 활동, 치료 분야 기업 전략, 약물 재배치(자산/적응증 매칭), 그리고 전임상 및 임상 개발 분야등에서 폭넓은 전문성을 가지고 있습니다. 혁신, 창의적이고 전략적인 파트너십, 그리고 부서 간 팀 리더십을 중요하게 여기며, 면역학과 염증성 질환 분야 전반과 안과학, 피부과학, 유전자와 세포 치료, 에스테틱 분야에 풍부한 경험이 있습니다.&lt;/p>&#xd;&#xa;&lt;p>&lt;a href=&quot;https://www.linkedin.com/in/doug-faunce-phd-1b958124/&quot;>LinkedIn&lt;/a>&lt;/p>&#xd;&#xa;"
                                            textIsRich="true"/>
                                    </item_1691182433666_c>
                                    <item_1673125673234
                                        cq:panelTitle="샤우나 프레이저(Shawna Frazier)"
                                        cq:styleIds="[1653545835879,1653545835982]"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="abbvie-com2/components/container/v2/container">
                                        <image_copy
