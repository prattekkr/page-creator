                                            displayPopupTitle="true"
                                            dmPresetType="imagePreset"
                                            fileReference="/content/dam/abbvie-com2/images/cso/shawna-frazier-headshot.jpg"
                                            isDecorative="false"
                                            titleValueFromDAM="true"/>
                                        <text_copy
                                            cq:styleIds="[1659545825678]"
                                            jcr:lastModified="{Date}2025-10-10T06:28:26.956-04:00"
                                            jcr:lastModifiedBy="nandivx5"
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="abbvie-com2/components/text/v2/text"
                                            text="&lt;p>&lt;b>Director – 캘리포니아주 샌프란시스코&lt;/b>&lt;/p>&#xd;&#xa;&lt;p>샤우나는 바이오테크 생태계 분야의 전문가 입니다. 그녀는 또한 민간 및 공공 바이오테크 기업에 투자 경험이 있는 숙련된 생명과학 벤처 투자자입니다. 시리즈 A 투자부터 IPO 및 그 이후까지 투자에 참여했습니다. 또한 기업 전략과 비즈니스 개발 분야에 경험이 있고, 신경과학 및 안과학 분야 질환 치료제를 개발하는 베이 에어리어 스타트업의 공동 설립자이자 과학 자문을 담당한 바 있습니다. 샤우나는 생화학 및 생물물리학을 전공했고, 그동안 세포 생리학, 분자 공학, 합성 생물학, 유전자 치료 등의 분야에서 연구 경험을 쌓아왔습니다.&amp;nbsp;&lt;/p>&#xd;&#xa;&lt;p>&lt;a href=&quot;https://www.linkedin.com/in/shawnalea-frazier-phd-69840213/&quot;>LinkedIn&lt;/a>&amp;nbsp;&lt;/p>&#xd;&#xa;"
                                            textIsRich="true"/>
                                    </item_1673125673234>
