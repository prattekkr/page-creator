                                    <item_1673125365973
                                        cq:panelTitle="크리스찬 슈버트(Christian Schubert) "
                                        cq:styleIds="[1653545835982,1653545835879]"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="abbvie-com2/components/container/v2/container">
                                        <image
                                            cq:styleIds="[1402843082812,1402843082823,1402843082836]"
