                            <title_copy
                                cq:styleIds="[1659545825678,1661545829678,1651545825692]"
                                jcr:created="{Date}2023-01-04T12:55:15.469-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2025-10-10T03:25:18.222-04:00"
                                jcr:lastModifiedBy="nandivx5"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="협업 방식"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h2"
                                variant="h"/>
                            <text_259153141
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2023-01-17T14:03:15.858-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2026-02-09T03:07:05.717-05:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;b>발굴 및 평가(Search and Evaluation)&lt;br>&#xd;&#xa; &lt;/b>애브비는 기존의 내부 혁신 전략을 보완하고 강화할 수 있는 새로운 기회를 발굴하고 평가하는 데 집중합니다. 발굴평가 팀은 연구개발(R&amp;amp;D) 및 커머셜팀, 사업개발 및 인수 벤처팀과 긴밀하게 협력하여 각 기회를 신중하게 추진합니다.&lt;/p>&#xd;&#xa;&lt;p>&lt;b>사업 개발 및 인수 (Business Development and Acquisitions)&lt;br>&#xd;&#xa; &lt;/b>애브비는 양측의 니즈를 충족시키기 위해 다양한 파트너십 구조를 평가합니다. 사업개발 인수팀은 발굴평가 팀, 그리고&amp;nbsp;커머셜 및 연구개발 조직과 긴밀히 협력하여 새로운 기회를 검토합니다.&lt;/p>&#xd;&#xa;&lt;p>&lt;b>글로벌 제휴 (Global Alliance)&lt;br>&#xd;&#xa; &lt;/b>높은 성과를 내는 파트너십은 공동의 비전을 실현하려는 지속적인 노력에서 비롯됩니다. 애브비는 계약부터 상업화까지 파트너십의 모든 단계에 참여하는 전담 팀을 운영하고 있습니다.&lt;/p>&#xd;&#xa;&lt;p>&lt;b>애브비 벤쳐(AbbVie Ventures)&lt;br>&#xd;&#xa; &lt;/b>애브비는 핵심 연구개발 분야를 강화하고 차세대 과학 및 검증된 과학 리더에 연결하기 위해 혁신적인 과학적 기회에 전략적으로 투자합니다. 의약품 개발과 상업화 분야에서 애브비가 보유한 전문성은 초기 단계 기업에도 매우 가치 있는 자원이 될 수 있습니다.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
