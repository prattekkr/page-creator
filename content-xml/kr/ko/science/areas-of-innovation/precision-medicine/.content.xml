                                    jcr:title=" 적합한 환자에게 적합한 약물 개발하기"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    langAttribute="none"
                                    type="h1"
                                    variant="h"/>
                                <text_copy_copy
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2022-12-07T14:53:09.069-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2025-10-09T07:20:33.691-04:00"
                                    jcr:lastModifiedBy="nandivx5"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>정밀의학은 암 환자의 진단과 치료 방식을 혁신했습니다. 이제 애브비는 정밀의학의 원칙을 한 단계 더 발전시켜 면역학, 신경과학, 안과 질환 전반의 치료에 도전하고 있습니다.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <separator
                                    cq:styleIds="[1662756486159]"
                                    jcr:created="{Date}2022-12-17T11:19:50.354-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2022-12-17T11:19:50.354-05:00"
                                    jcr:lastModifiedBy="chiucx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                                <text
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2024-05-20T03:08:57.113-04:00"
                                    jcr:createdBy="NANDIVX5"
                                    jcr:lastModified="{Date}2025-10-09T07:22:22.030-04:00"
                                    jcr:lastModifiedBy="nandivx5"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>애브비는 첨단 기술과 데이터 과학을 활용하여 질병 기전과 환자의 이질성에 대한 전례 없는 통찰을 얻음으로써, 정밀의학를 포트폴리오 전반에 걸쳐 적합한 환자에게 적합한 약을 제공하고 있습니다. 이러한 통찰은 약물을 더 정밀하게 타깃팅하고, 병용 기회를 식별하며, 환자와 의사에게 실행 가능한 진단 도구를 제공하는 데 기여합니다. 애브비는 모든 환자의 질환을 이해하고 그 근본적 기전을 해결하는 데 전념하고 있습니다.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                            </container_568753235>
                            <container_568753235_
                                cq:styleIds="[1653545825687,1653545847150,1653242825678,1653545835982]"
                                jcr:created="{Date}2022-12-16T18:05:55.966-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2022-12-16T18:05:55.966-05:00"
