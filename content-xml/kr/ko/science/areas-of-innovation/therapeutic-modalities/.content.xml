                                <title_116699496
                                    cq:styleIds="[1659545825678,1661545829678]"
                                    jcr:created="{Date}2022-12-15T11:49:26.700-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2025-10-10T02:49:12.809-04:00"
                                    jcr:lastModifiedBy="nandivx5"
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="신약을 이끄는 치료방법과 도구들 "
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h2"
                                    variant="h"/>
                                <text_copy_copy
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2022-12-07T14:53:09.069-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2025-10-10T02:49:38.626-04:00"
                                    jcr:lastModifiedBy="nandivx5"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>애브비의 연구는 질병 생물학에 대한 깊은 이해에서 시작합니다. 환자 및 유전체학 데이터에 접근하여 인간 질병에 대한 전례 없는 통찰을 얻습니다. 인간 질병과 강하게 연결된 적절한 타깃을 식별하면, 전통적 방식과 최첨단 접근법 및 플랫폼 기술이 결합된 연구개발 도구 상자를 활용하여 해당 타깃에 최적화된 분자를 만듭니다.&lt;/p>&#xd;&#xa;&lt;p>애브비의 치료방법 무기는 혁신과 지식의 발전과 함께 지속적으로 확장되고 있습니다. 애브비는 혁신적 플랫폼 기술, AI와 머신러닝 응용, 약물 전달 기술에 투자하여 환자들에게 더 나은 치료제를 더 빠르게 제공하고 있습니다.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                            </container_568753235>
                            <quote
                                cq:styleIds="[1000000000000]"
                                jcr:created="{Date}2025-10-10T02:52:05.423-04:00"
                                jcr:createdBy="nandivx5"
                                jcr:lastModified="{Date}2025-10-10T02:52:42.614-04:00"
                                jcr:lastModifiedBy="nandivx5"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/quote"
                                attributionName="조나단 세지윅(Jonathon Sedgwick) 박사"
                                attributionTitle=" 애브비, 발견 연구 부문 글로벌 책임자, 부사장 "
                                dmPresetType="imagePreset"
                                quote="(발견을 약으로 전환하는 것은) 수년에 걸친 시행착오가 필요한 어려운 과정입니다. 그러나 미지의 세계에 대한 호기심과 지식에 대한 갈증으로 애브비는 영감받고 움직입니다. "
                                quoteType="regular"
                                textSize="h0"/>
