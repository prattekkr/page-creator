                                    jcr:title="AI로 연구개발 가속화"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h3"
                                    variant="h"/>
                                <text_copy_copy
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2022-12-07T14:53:09.069-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2025-10-09T03:21:40.483-04:00"
                                    jcr:lastModifiedBy="nandivx5"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>전통적으로 신약 후보가 발견에서 임상 개발까지 이어져 환자에게 도달하기까지는 10~15년이 소요됩니다. 그러나 연구개발 전 과정에 AI와 머신러닝을 적용함으로써 이런 시간을 절반 수준으로 단축해, 사람들의 삶을 바꾸는 치료를 더 빨리 제공할 수 있을 것입니다.&lt;/p>&#xd;&#xa;&lt;p>질환 기전을 이해하기 위한 초기 실험부터 사내 신약 자산의 발굴, 후기 개발 단계의 프로그램 고도화에 이르기까지, 우리의 최첨단 기술은 변혁적 치료제를 더 빠르게 환자에게 전달하는 데 기여하고 있습니다.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <separator
                                    cq:styleIds="[1662756486159]"
                                    jcr:created="{Date}2022-12-17T11:19:50.354-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2022-12-17T11:19:50.354-05:00"
                                    jcr:lastModifiedBy="chiucx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                                <text
                                    cq:styleIds="[1659545825678,1659545825676]"
                                    jcr:created="{Date}2022-12-17T11:59:05.187-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2024-05-17T09:27:24.907-04:00"
                                    jcr:lastModifiedBy="NANDIVX5"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>애브비 전문가는 우리의 임상의, 컴퓨터 과학자, 데이터 과학자, 기술 전문가 및 기타 전문가들이 협력하여 어떻게 의료 분야의 정보 사일로를 해소할 수 있을지에 대해 논의합니다.&amp;nbsp;&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
