                                    jcr:lastModified="{Date}2024-05-16T09:46:44.960-04:00"
                                    jcr:lastModifiedBy="NANDIVX5"
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="연구 관심분야"
