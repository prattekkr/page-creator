                                jcr:lastModifiedBy="nandivx5"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>애브비는 면역 매개성 피부 질환뿐만 아니라, 특히 진단과 치료가 어려운 사람들을 위한 새로운 답을 찾고 표준 치료법을 개선하기 위해 노력하고 있습니다.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <item_1671312481387
                                cq:panelTitle="소화기내과"
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2025-10-07T06:04:33.266-04:00"
