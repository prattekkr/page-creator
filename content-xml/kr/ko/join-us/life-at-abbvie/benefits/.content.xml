                            <text_230942827
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2022-12-10T17:10:30.657-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2025-10-10T06:14:43.184-04:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>통합보상(Total Rewords)은 급여 및 인센티브, 복리후생 및 경력개발 프로그램등을 통해 경쟁력있는 보상수준을 제공하는 것입니다. 또한 개별적 성과에 대한 인정과 보상 프로그램을 통해 유연한 방식으로 직원의 모든 삶의 과정을 지원합니다.&amp;nbsp;&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
