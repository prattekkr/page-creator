                            jcr:lastModifiedBy="singarx"
                            jcr:primaryType="nt:unstructured"
                            jcr:title="일반 사항:"
                            sling:resourceType="abbvie-com2/components/title/v2/title"
                            type="h4"
                            variant="h"/>
                        <text_171059647_copy__1487024467
                            cq:styleIds="[1659545825678]"
                            jcr:created="{Date}2022-12-22T17:05:41.466-05:00"
                            jcr:createdBy="chiucx"
                            jcr:lastModified="{Date}2025-10-16T03:23:05.789-04:00"
                            jcr:lastModifiedBy="singarx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>귀하는 본 온라인 이용 약관과 개인정보 보호정책이 본 주제와 관련하여 애브비와 귀하 간의 모든 계약 내용을 기술하고 있다는 점에 동의합니다. 애브비 웹사이트는 일리노이 주(州)법에 의거하여 만들어졌고 운영되고 있습니다. 일리노이 주법은 예를 들어 귀하에게 적용되는 소비자 보호법과 같이 적용 가능한 의무 법에 의해 효력을 잃지 않는 범위에서 본 온라인 사용 약관에 제공된 조건을 통제할 것입니다. 귀하는 관할 법원에서 본 온라인 이용 약관의 특정 조항이&amp;nbsp;무효 또는 시행 불가능한 것으로 판결을 내릴 경우, 본 온라인 이용 약관 중 그 외의 나머지 조항은 그대로 효력을 유지할 것임에 동의합니다.&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
                    </container_944523654>
