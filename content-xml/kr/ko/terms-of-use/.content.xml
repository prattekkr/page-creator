                        <title_copy_copy
                            cq:styleIds="[1659545825678,1661545829678]"
                            jcr:created="{Date}2022-12-22T17:03:21.680-05:00"
                            jcr:createdBy="chiucx"
                            jcr:lastModified="{Date}2025-10-16T03:18:30.957-04:00"
                            jcr:lastModifiedBy="singarx"
                            jcr:primaryType="nt:unstructured"
                            jcr:title="제품의 내용 표시:"
                            sling:resourceType="abbvie-com2/components/title/v2/title"
                            type="h4"
                            variant="h"/>
                        <text_171059647_copy
                            cq:styleIds="[1659545825678]"
                            jcr:created="{Date}2022-12-22T17:05:41.466-05:00"
                            jcr:createdBy="chiucx"
                            jcr:lastModified="{Date}2025-10-16T03:18:50.883-04:00"
                            jcr:lastModifiedBy="singarx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>제품명, 설명 및 표시는 미국 또는 귀하가 거주하지 않는 제3국으로부터 유래할 수 있습니다. 제품은 일부 국가에서 이용 불가할 수 있거나 다른 브랜드명, 다른 장점 또는 다른 적응증에 제공될 수 있습니다. 본 웹사이트에 열거된 많은 제품은 귀하가 거주하는 곳의 의료전문가의 처방을 통해서만 이용할 수 있습니다. 명시적으로 규정하거나 사전에 애브비가 동의한 경우를 제외하고 애브비와 애브비의 자회사 및 관계회사의 임원, 직원, 대리인 또는 대표는 본 웹사이트를 통해서 의사와 환자의 관계가 형성될 수 있는 의료적 조언, 진단, 치료 또는 기타 어떠한 방식의 의료 서비스에도 관여하지 않습니다.&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
                        <separator_copy_copy_920539570
                            cq:styleIds="[1662756456518]"
                            jcr:created="{Date}2022-12-22T17:03:44.000-05:00"
                            jcr:createdBy="chiucx"
