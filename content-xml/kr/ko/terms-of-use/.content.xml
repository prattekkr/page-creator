                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>발효일: 2013년 1월 1일&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
