                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-26-reg&quot;>For ytterligere å understreke viktigheten av etisk og verdibasert atferd lanserte AbbVie våre prinsipper i 2019. Dette er grunnlaget for hvordan vi oppfører oss når vi gjør forretninger.&lt;/span>&lt;/span>&lt;/p>&#xa;"
