                        <item_1671570554123
                            cq:panelTitle="Forbedre liv "
                            cq:styleIds="[1659545825678]"
                            jcr:lastModified="{Date}2024-04-18T08:08:24.852-04:00"
                            jcr:lastModifiedBy="lennglx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>&lt;span class=&quot;light-font&quot;>Vi forbedrer menneskers liv hver dag. Vi tar beslutninger basert på medfølelse og skaper en langsiktig positiv innvirkning på pasienter, deres familier, våre kolleger og samfunnet.&amp;nbsp;&lt;/span>&lt;/p>&#xa;"
                            textIsRich="true"/>
                        <item_1671570557396
                            cq:panelTitle="Integritet"
                            cq:styleIds="[1659545825678]"
                            jcr:lastModified="{Date}2024-04-18T08:09:06.597-04:00"
                            jcr:lastModifiedBy="lennglx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>&lt;span class=&quot;light-font&quot;>Vi forsøker alltid å gjøre det som er riktig. Vår integritet er sentral, og vi ønsker å alltid opprettholde høyest mulig standard i alt vi gjør.&amp;nbsp;&lt;/span>&lt;/p>&#xa;"
                            textIsRich="true"/>
                        <item_1671570603045
                            cq:panelTitle="Innovasjon"
                            cq:styleIds="[1659545825678]"
                            jcr:lastModified="{Date}2024-04-18T08:09:43.147-04:00"
                            jcr:lastModifiedBy="lennglx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>&lt;span class=&quot;light-font&quot;>Vi innoverer for å løse fremtidens helseutfordringer. Vi investerer kontinuerlig i å oppdage og utvikle nye medisiner og omsorgsløsninger for å forbedre liv.&amp;nbsp;&lt;/span>&lt;/p>&#xa;"
                            textIsRich="true"/>
                        <item_1671570607019
                            cq:panelTitle="Mangfold og inkludering"
                            cq:styleIds="[1659545825678]"
                            jcr:lastModified="{Date}2024-04-18T08:10:16.767-04:00"
                            jcr:lastModifiedBy="lennglx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>&lt;span class=&quot;light-font&quot;>Vi behandler alle likt og med respekt. Vi har ansatte over hele verden, og vi omfavner mangfoldighet i bakgrunn og perspektiv, og dermed øke vår evne til å oppnå vårt oppdrag: å forbedre liv.&amp;nbsp;&lt;/span>&lt;/p>&#xa;"
                            textIsRich="true"/>
                        <item_1671570609829
                            cq:panelTitle="Samfunnsansvar"
                            cq:styleIds="[1659545825678]"
                            jcr:lastModified="{Date}2024-04-18T08:11:05.740-04:00"
                            jcr:lastModifiedBy="lennglx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>&lt;span class=&quot;light-font&quot;>Vi bidrar til samfunnet vi lever i ved å ta samfunnsansvar og beskytte miljøet vårt. Vi bidrar også til et mer bærekraftig helsevesen gjennom ulike helseløsninger.&lt;/span>&lt;/p>&#xa;"
                            textIsRich="true"/>
                    </accordion>
