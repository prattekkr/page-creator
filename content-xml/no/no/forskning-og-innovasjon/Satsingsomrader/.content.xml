                                jcr:lastModified="{Date}2024-04-18T02:46:18.968-04:00"
                                jcr:lastModifiedBy="lennglx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Vi er fokusert på å finne bedre måter å bringe de riktige medisinene til pasientene på - skreddersy og tilpasse terapiene våre og la pasientens stemme og erfaring veilede oss. Vi investerer på viktige områder og teknologier som presisjonsmedisin, datakonvergens, genetikk og genomikk og pasientfokusert legemiddelutvikling.&lt;/p>&#xa;"
                                textIsRich="true"/>
