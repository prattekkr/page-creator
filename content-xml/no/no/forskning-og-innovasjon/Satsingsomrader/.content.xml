                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-18-reg&quot;>AbbVie er et av de ledende selskapene innen immunologi med mer enn 20 års erfaring innen biologiske legemidler. Vårt fokus innen immunologi er effektive behandlinger for kroniske og inflammatoriske ledd-, hud- og tarmsykdommer som revmatoid artritt, ankyloserende spondylitt, psoriasis, psoriasisartritt, atopisk dermatitt, Crohns sykdom og ulcerøs kolitt.&lt;/span>&lt;/span>&lt;br>&#xa;&lt;/p>&#xa;"
                                textIsRich="true"/>
