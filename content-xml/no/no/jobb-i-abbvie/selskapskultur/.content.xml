                            <text
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2024-02-07T08:59:11.129-05:00"
                                jcr:createdBy="lennglx"
                                jcr:lastModified="{Date}2024-04-17T12:42:38.062-04:00"
                                jcr:lastModifiedBy="lennglx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;body-unica-20-reg&quot;>&lt;span class=&quot;light-font&quot;>Sentralt i vår kultur er nøkkelordene Mennesker, Engasjement og Muligheter.&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;&lt;p>&lt;span class=&quot;body-unica-20-reg&quot;>&lt;span class=&quot;light-font&quot;>Siden dag én har vår inkluderende kultur vært hemmeligheten bak vår suksess. Det gjenspeiles i alt vi gjør og alt vi tilbyr. Grunnlaget er&amp;nbsp;&amp;nbsp;&lt;b>The Ways We Work&lt;/b>, fem pilarer som styrer hvordan mennesker jobber, innoverer, samarbeider og behandler hverandre. Det er det som gjør det mulig for enkeltpersoner, team og selskapet vårt som helhet å gjøre en reell forskjell i menneskers liv over hele verden.&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
