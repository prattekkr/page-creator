                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>Se hva som gjør oss til en god arbeidsplass.&amp;nbsp;&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
