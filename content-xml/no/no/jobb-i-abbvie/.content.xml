                            jcr:lastModified="{Date}2024-01-23T03:57:59.639-05:00"
                            jcr:lastModifiedBy="lennglx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>Enten du jobber på et kontor eller i felten, er målet det samme – &lt;b>å gjøre en reell forskjell i folks liv.&lt;/b> Det er derfor vi kontinuerlig stiller spørsmål og fremmer nye perspektiver. Og bygger på hverandres ekspertise for å utvikle de beste løsningene for menneskene som er avhengige av oss. Se våre muligheter:&lt;/p>&#xa;"
                            textIsRich="true"/>
