                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>&lt;span class=&quot;body-unica-32-reg&quot;>Dynamiske team skaper morgendagens muligheter&lt;/span>&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
                        <text_copy
                            cq:styleIds="[1659545825678,1659545847147]"
