                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/quote"
                                    attributionName="Elisabeth Jarnæss"
                                    attributionTitle="Head of Medical Affairs Hematology/Oncology, AbbVie Scandinavia"
                                    quote="Arbeidsdagen min er veldig variert og består i mye kontakt med helsepersonell. Jeg har en aktiv rolle i tverrfaglige team og har også mulighet til å drive medisinske prosjekter. Heldigvis er jeg omgitt av faglig dyktige mennesker som gjerne hjelper hverandre hvis det trengs"
