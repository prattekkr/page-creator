                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    langAttribute="none"
                                    text="&lt;p>Értékeink határozzák meg, kik vagyunk, és hogyan dolgozunk a közösségeink érdekében.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <text
                                    cq:styleIds="[1659545825678]"
