                            variant="h"/>
                        <text_copy
                            cq:styleIds="[1659545825678]"
                            jcr:created="{Date}2022-12-21T17:40:32.258-05:00"
                            jcr:createdBy="chiucx"
                            jcr:lastModified="{Date}2026-06-23T14:23:12.699-04:00"
                            jcr:lastModifiedBy="VALENSX5"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            langAttribute="none"
                            text="&lt;p>Esse conteúdo não possui cunho promocional e está voltado a fornecer informações a respeito dos nossos programas de suporte ao paciente e programas de serviço ao cliente, contribuindo com a jornada de tratamento de pacientes e alinhado a nosso propósito de causar um impacto positivo na vida das pessoas e transformar o cenário da saúde no Brasil e no mundo.&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
                    </container_259896524>
