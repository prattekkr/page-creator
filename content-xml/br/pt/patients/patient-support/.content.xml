                            jcr:createdBy="kanchrx3"
                            jcr:lastModified="{Date}2024-06-27T05:47:21.703-04:00"
                            jcr:lastModifiedBy="kanchrx3"
                            jcr:primaryType="nt:unstructured"
                            jcr:title="Nossos Programas  "
                            sling:resourceType="abbvie-com2/components/title/v2/title"
                            type="h3"
                            variant="h"/>
                        <text_copy_copy
                            cq:styleIds="[1659545825678]"
                            jcr:created="{Date}2022-12-21T17:40:32.258-05:00"
                            jcr:createdBy="chiucx"
                            jcr:lastModified="{Date}2024-06-27T05:48:09.021-04:00"
                            jcr:lastModifiedBy="kanchrx3"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>Direcionados por nosso propósito, agimos com coragem a cada novo desafio, porque nunca esquecemos o porquê de estarmos aqui.&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
                        <title_1451618471
                            cq:styleIds="[1659545825678,1661545829678,1651545825693]"
                            jcr:created="{Date}2025-01-29T01:31:16.298-05:00"
                            jcr:createdBy="jewitca"
                            jcr:lastModified="{Date}2025-02-18T19:12:05.436-05:00"
                            jcr:lastModifiedBy="jewitca"
                            jcr:primaryType="nt:unstructured"
                            jcr:title="Programas de Suporte ao Paciente"
                            sling:resourceType="abbvie-com2/components/title/v2/title"
                            type="h3"
                            variant="h"/>
                        <text
                            cq:styleIds="[1659545825678]"
                            jcr:created="{Date}2024-06-27T05:48:28.569-04:00"
                            jcr:createdBy="kanchrx3"
                            jcr:lastModified="{Date}2026-06-23T14:23:33.667-04:00"
                            jcr:lastModifiedBy="VALENSX5"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            langAttribute="none"
                            text="&lt;p>Nossos Programas de Suporte a Pacientes (PSPs) visam apoiar os pacientes que tenham recebido uma prescrição de um medicamento AbbVie, oferecendo serviços que melhorem a adesão ao plano de tratamento prescrito e a aumentar a compreensão sobre sua doença e/ou tratamento.&lt;/p>&#xd;&#xa;&lt;p>Os PSPs não fornecem aconselhamento médico, nem substituem a necessidade do paciente de falar com seu(ua) médico(a).&lt;/p>&#xd;&#xa;&lt;p>Além disso, não incentivam profissionais de saúde a prescrever, administrar, comprar, fornecer ou recomendar qualquer produto AbbVie.&lt;/p>&#xd;&#xa;&lt;p>&lt;span class=&quot;body-unica-26-reg&quot;>&lt;b>Alguns dos nossos PSPs são:&lt;/b>&lt;/span>&lt;/p>&#xd;&#xa;&lt;p>&lt;span class=&quot;body-unica-20-reg&quot;>&lt;b>AbbVie Com Você para Rinvoq® (upadacitinibe)&lt;/b>&lt;/span>&lt;/p>&#xd;&#xa;&lt;p>AbbVie Com Você é um programa para apoiar pacientes que tenham recebido prescrição de Rinvoq® (upadacitinibe), conforme aprovado em bula, e atendam aos&amp;nbsp;&lt;b>&lt;a href=&quot;https://qrco.de/bflCne&quot; target=&quot;_blank&quot;>critérios de regulamento do programa&lt;/a>&lt;/b>.&lt;/p>&#xd;&#xa;&lt;p>O programa tem abrangência em todo território nacional pelo telefone 0800-074-6867, de segunda a sexta-feira, das 8h às 20h, ou no site&amp;nbsp;&lt;a href=&quot;https://www.abbviecomvoce.com.br/&quot;>www.abbviecomvoce.com.br&lt;/a>.&amp;nbsp;&lt;/p>&#xd;&#xa;&lt;p>&lt;span class=&quot;body-unica-20-reg&quot;>&lt;b>AbbVie Com Você para Skyrizi® (risanquizumabe)&lt;/b>&lt;/span>&lt;/p>&#xd;&#xa;&lt;p>AbbVie Com Você é um programa para apoiar pacientes que tenham recebido prescrição de Skyrizi® (risanquizumabe), conforme aprovado em bula, e atendam aos&amp;nbsp;&lt;b>&lt;a href=&quot;https://qrco.de/bggYVH&quot; target=&quot;_blank&quot;>critérios de regulamento do programa&lt;/a>&lt;/b>.&lt;/p>&#xd;&#xa;&lt;p>O programa tem abrangência em todo território nacional pelo telefone 0800-721-0195, de segunda a sexta-feira, das 8h às 20h, ou no site&amp;nbsp;&lt;a href=&quot;https://www.abbviecomvoce.com.br/&quot;>www.abbviecomvoce.com.br&lt;/a>.&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
                        <separator
                            cq:styleIds="[1662756486159]"
                            jcr:created="{Date}2024-06-28T05:16:59.019-04:00"
