                            jcr:lastModifiedBy="VALENSX5"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/accordion/v2/accordion"
                            singleExpansion="false">
                            <item_1738108627089
                                cq:panelTitle="Produtos AbbVie"
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2026-06-15T13:44:58.262-04:00"
                                jcr:lastModifiedBy="VALENSX5"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                langAttribute="none"
                                text="&lt;p>&lt;b>BOTOX®&lt;/b>&amp;nbsp;(toxina botulínica A)&lt;br>&#xd;&#xa;&lt;a href=&quot;/content/dam/abbvie-com2/br/documents/Paciente_ANVISA_BOTOX.pdf&quot; target=&quot;_blank&quot;>Bula BOTOX®&amp;nbsp;para o paciente&lt;/a>&lt;br>&#xd;&#xa;&lt;a href=&quot;/content/dam/abbvie-com2/br/documents/Bula_BOTOX_VPS.pdf&quot; target=&quot;_blank&quot;>Bula BOTOX®&amp;nbsp;para o profissional de saúde&lt;/a>&lt;/p>&#xd;&#xa;&lt;p>&lt;b>ELAHERE®&lt;/b>&amp;nbsp;(mirvetuximabe soravtansina)&amp;nbsp;&lt;br>&#xd;&#xa;&lt;a href=&quot;/content/dam/abbvie-com2/br/documents/Bula_Elahere_VP.pdf&quot;>Bula ELAHERE® para o paciente&lt;/a>&lt;br>&#xd;&#xa;&lt;a href=&quot;/content/dam/abbvie-com2/br/documents/Bula_Elahere_VPS.pdf&quot;>Bula ELAHERE® para o profissional de saúde&lt;/a>&lt;/p>&#xd;&#xa;&lt;p>&lt;b>Epkinly®&amp;nbsp;&lt;/b>(epcoritamabe)&amp;nbsp;&lt;br>&#xd;&#xa;&lt;a href=&quot;/content/dam/abbvie-com2/br/documents/bula-EPKINLY-VP.pdf&quot;>Bula Epkinly® para o paciente&lt;/a>&lt;br>&#xd;&#xa;&lt;a href=&quot;/content/dam/abbvie-com2/br/documents/bula-EPKINLY-VPS.pdf&quot; target=&quot;_blank&quot;>Bula Epkinly® para o profissional de saúde&lt;/a>&lt;br>&#xd;&#xa;&lt;/p>&#xd;&#xa;&lt;p>&lt;b>Humira AC &lt;/b>(adalimumabe)&lt;br>&#xd;&#xa;&lt;a href=&quot;/content/dam/abbvie-com2/br/documents/Paciente_ANVISA_HUMIRA_AC.pdf&quot; target=&quot;_blank&quot;>Bula Humira AC para o paciente&lt;/a>&lt;/p>&#xd;&#xa;&lt;p>&lt;b>Kaletra&lt;/b> (lopinavir/ritonavir) - solução oral&lt;br>&#xd;&#xa;&lt;a href=&quot;/content/dam/abbvie-com2/br/documents/Kaletra-sol-oral-VP.pdf&quot; target=&quot;_blank&quot;>Bula Kaletra solução oral para paciente&lt;/a>&lt;/p>&#xd;&#xa;&lt;p>&lt;b>Maviret &lt;/b>(glecaprevir/pibrentasvir)&lt;br>&#xd;&#xa;&lt;a href=&quot;/content/dam/abbvie-com2/br/documents/Maviret-VP.pdf&quot; target=&quot;_blank&quot;>Bula Maviret para paciente&lt;/a>&lt;/p>&#xd;&#xa;&lt;p>&lt;b>Optive® ADVANCE&lt;br>&#xd;&#xa; &lt;/b>&lt;a href=&quot;/content/dam/abbvie-com2/br/documents/Optive-Advance.pdf&quot; target=&quot;_blank&quot;>Instrutivo de Uso Optive&lt;b>®&amp;nbsp;&lt;/b>ADVANCE para o paciente&lt;/a>&lt;/p>&#xd;&#xa;&lt;p>&lt;b>OPTIVE®&amp;nbsp;Gel Drops&lt;br>&#xd;&#xa; &lt;/b>&lt;a href=&quot;/content/dam/abbvie-com2/br/documents/Optive-Gel-Drops.pdf&quot; target=&quot;_blank&quot;>Instrutivo de Uso OPTIVE Gel Drops para o paciente&lt;/a>&lt;/p>&#xd;&#xa;&lt;p>&lt;b>OPTIVE® OMEGA 3 UD&lt;br>&#xd;&#xa; &lt;/b>&lt;a href=&quot;/content/dam/abbvie-com2/br/documents/Optive-Omega-3UD.pdf&quot; target=&quot;_blank&quot;>Instrutivo de Uso OPTIVE&lt;sup>®&lt;/sup> OMEGA 3 UD&amp;nbsp;para o paciente&lt;/a>&lt;/p>&#xd;&#xa;&lt;p>&lt;b>OPTIVE® UD&lt;/b>&lt;br>&#xd;&#xa;&lt;a href=&quot;/content/dam/abbvie-com2/br/documents/Optive-UD.pdf&quot; target=&quot;_blank&quot;>Instrutivo de Uso OPTIVE® UD para o paciente&lt;/a>&lt;br>&#xd;&#xa;&lt;br>&#xd;&#xa;&lt;b>OZURDEX® &lt;/b>(dexametasona)&lt;br>&#xd;&#xa;&lt;a href=&quot;/content/dam/abbvie-com2/br/documents/Bula%20Paciente-Ozurdex.pdf&quot; target=&quot;_blank&quot;>Bula OZURDEX® para o paciente&lt;/a>&lt;/p>&#xd;&#xa;&lt;p>&lt;b>Rinvoq &lt;/b>(upadacitinibe)&lt;br>&#xd;&#xa;&lt;a href=&quot;/content/dam/abbvie-com2/br/documents/Paciente_ANVISA_RINVOQAD.pdf&quot; target=&quot;_blank&quot;>Bula Rinvoq para o paciente&lt;/a>&lt;/p>&#xd;&#xa;&lt;p>&lt;b>Skyrizi&lt;/b> (risanquizumabe)&lt;br>&#xd;&#xa;&lt;a href=&quot;/content/dam/abbvie-com2/br/documents/Paciente_ANVISA_SKYRIZI.pdf&quot; target=&quot;_blank&quot;>Bula Skyrizi para o paciente&lt;/a>&lt;br>&#xd;&#xa;&lt;a href=&quot;/content/dam/abbvie-com2/br/documents/Profissional_ANVISA_SKYRIZI.pdf&quot; target=&quot;_blank&quot;>Bula Skyrizi para o profissional&lt;/a>&lt;/p>&#xd;&#xa;&lt;p>&lt;b>Survanta&lt;/b> (beractanto)&lt;br>&#xd;&#xa;&lt;a href=&quot;/content/dam/abbvie-com2/br/documents/SURVANTA-VP.pdf&quot; target=&quot;_blank&quot;>Bula Survanta®&amp;nbsp; para paciente&lt;/a>&lt;br>&#xd;&#xa;&lt;a href=&quot;/content/dam/abbvie-com2/br/documents/BU22-VENCLEXTA-VPS.pdf&quot;>&lt;/a>&lt;a href=&quot;/content/dam/abbvie-com2/br/documents/SURVANTA_VPS.pdf&quot; target=&quot;_blank&quot;>Bula Survanta®&amp;nbsp; para o profissional de saúde&lt;/a>&lt;/p>&#xd;&#xa;&lt;p>&lt;b>Venclexta&lt;/b> (venetoclax)&lt;br>&#xd;&#xa;&lt;a href=&quot;/content/dam/abbvie-com2/br/documents/BU22-VENCLEXTA-VP.pdf&quot; target=&quot;_blank&quot;>Bula Venclexta®&amp;nbsp;&amp;nbsp;para o paciente&lt;/a>&lt;br>&#xd;&#xa;&lt;a href=&quot;/content/dam/abbvie-com2/br/documents/BU22-VENCLEXTA-VPS.pdf&quot; target=&quot;_blank&quot;>Bula Venclexta®&amp;nbsp; para o profissional de saúde&lt;/a>&lt;/p>&#xd;&#xa;&lt;p>&lt;b>VYALEV&lt;/b>&lt;sup>®&lt;/sup> (foslevodopa/foscarbidopa hidratada)&lt;br>&#xd;&#xa;&lt;a href=&quot;/content/dam/abbvie-com2/br/documents/VYALEV-VP.pdf&quot; target=&quot;_blank&quot;>Bula VYALEV&lt;sup>®&lt;/sup>&amp;nbsp;para o paciente&lt;/a>&lt;br>&#xd;&#xa;&lt;a href=&quot;/content/dam/abbvie-com2/br/documents/VYALEV-VPS.pdf&quot; target=&quot;_blank&quot;>Bula VYALEV&lt;sup>®&amp;nbsp;&lt;/sup>para o profissional de saúde&lt;/a>&lt;/p>&#xd;&#xa;&lt;p>&lt;b>XEN® Implante em Gel para Glaucoma&lt;/b>&lt;br>&#xd;&#xa;&lt;a href=&quot;/content/dam/abbvie-com2/br/documents/Instru%C3%A7%C3%A3o-de-Uso-(DFU)-XEN.pdf&quot; target=&quot;_blank&quot;>Instrutivo de Uso XEN®&amp;nbsp; para o paciente&lt;/a>&lt;/p>&#xd;&#xa;&lt;p>&lt;b>Zemplar®&lt;/b> (paricalcitol)&lt;br>&#xd;&#xa;&lt;a href=&quot;/content/dam/abbvie-com2/br/documents/ZEMPLAR-VP.pdf&quot; target=&quot;_blank&quot;>Bula Zemplar®&amp;nbsp; para paciente&lt;/a>&lt;br>&#xd;&#xa;&lt;a href=&quot;/content/dam/abbvie-com2/br/documents/ZEMPLAR-VPS.pdf&quot; target=&quot;_blank&quot;>Bula&amp;nbsp;Zemplar®&amp;nbsp; para o profissional de saúde&lt;/a>&lt;/p>&#xd;&#xa;&lt;p>&lt;br>&#xd;&#xa;&lt;br>&#xd;&#xa;&lt;/p>&#xd;&#xa;&lt;p>&amp;nbsp;&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <item_1738108637644
                                cq:panelTitle="Produtos Allergan"
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2026-08-12T09:14:49.696-04:00"
                                jcr:lastModifiedBy="VALENSX5"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                langAttribute="none"
                                text="&lt;p>&lt;b>ACULAR® CMC&lt;/b> (cetorolaco trometamol)&lt;br>&#xd;&#xa;&lt;a href=&quot;/content/dam/abbvie-com2/br/documents/Acular-CMC.pdf&quot; target=&quot;_blank&quot;>Bula ACULAR® CMC para o paciente&lt;/a>&lt;/p>&#xd;&#xa;&lt;p>&lt;b>ACULAR® LS&lt;/b> (cetorolaco trometamol)&lt;br>&#xd;&#xa;&lt;a href=&quot;/content/dam/abbvie-com2/br/documents/Acular-LS.pdf&quot; target=&quot;_blank&quot;>Bula ACULAR® LS para o paciente&lt;/a>&lt;/p>&#xd;&#xa;&lt;p>&lt;b>ALPHAGAN®&lt;/b> (tartarato de brimonidina)&lt;br>&#xd;&#xa;&lt;a href=&quot;/content/dam/abbvie-com2/br/documents/Alphagan.pdf&quot; target=&quot;_blank&quot;>Bula ALPHAGAN® para o paciente&lt;/a>&lt;/p>&#xd;&#xa;&lt;p>&lt;b>ALPHAGAN® P&lt;/b> (tartarato de brimonidina)&lt;br>&#xd;&#xa;&lt;a href=&quot;/content/dam/abbvie-com2/br/documents/Alphagan-P.pdf&quot; target=&quot;_blank&quot;>Bula ALPHAGAN® P para o paciente&lt;/a>&lt;/p>&#xd;&#xa;&lt;p>&lt;b>ALPHAGAN® Z&lt;/b> (tartarato de brimonidina)&lt;br>&#xd;&#xa;&lt;a href=&quot;/content/dam/abbvie-com2/br/documents/Alphagan-Z.pdf&quot; target=&quot;_blank&quot;>Bula ALPHAGAN® Z para o paciente&lt;/a>&lt;/p>&#xd;&#xa;&lt;p>&lt;b>ATROPINA (sulfato de atropina)&lt;br>&#xd;&#xa;&lt;/b>&lt;a href=&quot;https://www.abbvie.com.br/content/dam/abbvie-com2/br/documents/Atropina.pdf&quot;>Bula ATROPINA para o paciente&lt;/a>&lt;/p>&#xd;&#xa;&lt;p>&lt;b>CICLOPLÉGICO&lt;/b> (cloridrato de ciclopentolato)&lt;br>&#xd;&#xa;&lt;a href=&quot;/content/dam/abbvie-com2/br/documents/Cicoplegico.pdf&quot; target=&quot;_blank&quot;>Bula CICLOPLÉGICO para o paciente&lt;/a>&lt;/p>&#xd;&#xa;&lt;p>&lt;b>COMBIGAN® &lt;/b>(tartarato de brimonidina, maleato de timolol)&lt;br>&#xd;&#xa;&lt;a href=&quot;/content/dam/abbvie-com2/br/documents/Combigan.pdf&quot; target=&quot;_blank&quot;>Bula COMBIGAN® para o paciente&lt;/a>&lt;/p>&#xd;&#xa;&lt;p>&lt;b>CROMOLERG&lt;/b> (cromoglicato dissódico)&lt;br>&#xd;&#xa;&lt;a href=&quot;/content/dam/abbvie-com2/br