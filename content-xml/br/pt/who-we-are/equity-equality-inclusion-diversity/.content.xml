                            jcr:lastModifiedBy="kanchrx3"
                            jcr:primaryType="nt:unstructured"
                            jcr:title="Nos capacitando para alcançar o nosso melhor    para que possamos causar um impacto notável nos pacientes"
                            sling:resourceType="abbvie-com2/components/title/v2/title"
                            type="h5"
                            variant="h"/>
                        <text_copy_18329983 jcr:primaryType="nt:unstructured"/>
                        <text_845649858
                            cq:styleIds="[1659545825678]"
                            jcr:created="{Date}2024-07-22T04:59:38.108-04:00"
                            jcr:createdBy="singarx"
                            jcr:lastModified="{Date}2024-07-22T04:59:52.577-04:00"
                            jcr:lastModifiedBy="singarx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>Desenvolver e fornecer medicamentos inovadores e transformadores de vidas para os pacientes exige diversidade de pensamento - e a diversidade de pensamento vem de uma força de trabalho diversificada. Além disso, servimos múltiplos pacientes em todo o mundo, e é crucial que, como empresa, as reflitamos e representemos suas vozes.&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
                        <separator_2041334234
