                            jcr:primaryType="nt:unstructured"
                            jcr:title=" Nosso compromisso"
                            sling:resourceType="abbvie-com2/components/title/v2/title"
                            type="h3"
                            variant="h"/>
                        <text_copy jcr:primaryType="nt:unstructured"/>
                        <text
                            cq:styleIds="[1659545825678]"
                            jcr:created="{Date}2024-07-22T04:54:36.870-04:00"
                            jcr:createdBy="singarx"
                            jcr:lastModified="{Date}2024-07-22T04:55:31.517-04:00"
                            jcr:lastModifiedBy="singarx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>Na AbbVie, ter uma cultura diversificada e inclusive e claborativa é um imperativo para os negócios. Estamos comprometidos em agir com integridade, impulsionar a inovação, transformar vidas, servir nossa comunidade e apoiar a diversidade e inclusão. Além de ser a coisa certa a fazer, também fortalece a maneira como inovamos e nossa capacidade de transformar hoje e o futuro.&amp;nbsp;&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
                        <separator
                            cq:styleIds="[1662756423318]"
                            jcr:created="{Date}2024-07-22T04:57:30.861-04:00"
