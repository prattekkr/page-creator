                                sling:resourceType="abbvie-com2/components/button/v2/button"
                                accessibilityLabel="Leia nosso compromisso"
                                linkTarget="_blank"
                                linkURL="https://www.abbvie.com/content/dam/abbvie-com2/pdfs/about/our-commitment-to-human-rights.pdf"/>
                        </par_13>
