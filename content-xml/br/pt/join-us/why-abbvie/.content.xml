                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>Veja o que nos torna um ótimo lugar para trabalhar.&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
