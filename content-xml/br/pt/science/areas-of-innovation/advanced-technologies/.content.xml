                                    jcr:title="Alavancando a tecnologia para acelerar as ciências  "
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h3"
                                    variant="h"/>
                                <text_copy_copy
                                    cq:styleIds="[1659545825678]"
