                                jcr:primaryType="nt:unstructured"
                                jcr:title="Importância do diálogo médico-paciente"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h3"
                                variant="h"/>
                            <text
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2025-11-19T11:52:07.153-05:00"
                                jcr:createdBy="VALENSX5"
                                jcr:lastModified="{Date}2025-11-19T11:58:24.058-05:00"
                                jcr:lastModifiedBy="VALENSX5"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>O diálogo entre paciente e médico é de &lt;b>extrema importância.&lt;/b>&lt;sup>1&lt;/sup>&lt;/p>&#xd;&#xa;&lt;p>Preparar-se com antecedência para a consulta, anotando as dúvidas e os desafios encontrados na rotina, pode tornar as trocas mais valiosas, com escolhas de tratamento mais assertivas.&lt;sup>1&lt;/sup>&lt;/p>&#xd;&#xa;&lt;p>&lt;b>Não adie essa conversa: &lt;/b>fale com seus familiares e &lt;b>busque um(a) neurologista especializado(a) em distúrbios do movimento hoje mesmo.&lt;/b>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
