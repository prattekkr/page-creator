                                    jcr:lastModifiedBy="VALENSX5"
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="Comprometidos em levar informação para mais pessoas"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    langAttribute="none"
                                    type="h5"
                                    variant="h"/>
                                <text_copy
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2024-06-17T02:12:13.617-04:00"
                                    jcr:createdBy="singarx"
                                    jcr:lastModified="{Date}2026-06-04T15:11:47.069-04:00"
                                    jcr:lastModifiedBy="VALENSX5"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    langAttribute="none"
                                    text="&lt;p>&lt;b>Nossos canais ReabilitAção e Enxaqueca Crônica&lt;/b> são mais uma via em que reforçamos nosso compromisso em conectar pacientes ao diagnóstico precoce e ao profissional de saúde/tratamento adequado e contribuir com a melhoria do cenário da saúde no Brasil por meio da conscientização.&lt;/p>&#xd;&#xa;&lt;p>Em parceria com a classe médica e pacientes, levamos informação de qualidade sobre condições neurológicas para a população. Acesse &lt;a href=&quot;http://www.portalreabilitacao.com.br/&quot;>www.portalreabilitacao.com.br&lt;/a> e &lt;a href=&quot;https://enxaquecacronica.com.br/&quot;>https://enxaquecacronica.com.br/&lt;/a>.&amp;nbsp;&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
