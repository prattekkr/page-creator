                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h2"
                                variant="h"/>
                            <text_1800797007
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2024-11-12T16:21:02.140-05:00"
                                jcr:createdBy="jewitca"
                                jcr:lastModified="{Date}2024-11-12T16:23:01.674-05:00"
                                jcr:lastModifiedBy="jewitca"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Dermatologistas e alergistas são os(as) responsáveis pelo diagnóstico e tratamento da dermatite atópica. Ter diálogos abertos com seu/sua médico(a) é importante para que tenham todas as informações durante a condução do tratamento.&lt;/p>&#xd;&#xa;&lt;p>Apesar de não haver uma cura definitiva para a DA, a doença pode ser controlada.&lt;sup>1&lt;/sup>&amp;nbsp;A compreensão sobre a dermatite atópica e seu tratamento tem crescido de forma significativa ao longo dos anos, sendo que as opções terapêuticas atuais incluem tratamentos tópicos e sistêmicos, sistêmicos (orais e infusionais) e fototerapia, associados a técnicas de hidratação e cuidados na rotina, como no banho.&lt;sup>1&lt;/sup>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
