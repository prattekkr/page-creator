                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>Uma doença inflamatória crônica que pode ser controlada&lt;sup>1&lt;/sup>&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
