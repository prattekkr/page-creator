                                jcr:created="{Date}2024-11-12T15:47:15.342-05:00"
                                jcr:createdBy="jewitca"
                                jcr:lastModified="{Date}2024-11-12T16:35:30.968-05:00"
                                jcr:lastModifiedBy="jewitca"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>O(A) reumatologista é o(a) profissional mais adequado para diagnóstico e tratamento correto da artrite psoriásica. Ter diálogos abertos com seu/sua médico(a) é importante para que o/a especialista tenha todas as informações durante a condução do tratamento para prevenir danos articulares que podem afetar a qualidade de vida do paciente&lt;sup>4&lt;/sup>.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
