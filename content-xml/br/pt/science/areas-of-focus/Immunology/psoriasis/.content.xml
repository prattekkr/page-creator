                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>O(A) dermatologista é o profissional mais adequado para diagnóstico e tratamento correto da psoríase. Ter diálogos abertos com seu/sua médico(a) é importante para que o/a especialista tenha todas as informações durante a condução do tratamento porque a intervenção precoce e o tratamento adequado podem ajudar a diminuir a progressão da doença e controlar os sintomas.&lt;sup>1&amp;nbsp;&lt;/sup>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
