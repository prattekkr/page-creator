                                singleExpansion="false">
                                <item_1738138031172
                                    cq:panelTitle="Referências:"
                                    cq:styleIds="[1659545825678]"
                                    jcr:lastModified="{Date}2025-07-23T12:00:25.555-04:00"
                                    jcr:lastModifiedBy="VALENSX5"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;ol>&#xd;&#xa;&lt;li>Tipos de linfomas não Hodgkin.&amp;nbsp;Disponível em: &lt;a href=&quot;https://www.oncoguia.org.br/conteudo/tipos-de-linfomas-nao-hodgkin-de-celulas-b/12258/52&quot;>https://www.oncoguia.org.br/conteudo/tipos-de-linfomas-nao-hodgkin-de-celulas-b/12258/52&lt;/a>. Acesso em 11 de julho de 2025.&lt;/li>&#xd;&#xa;&lt;li>O que é linfoma difuso de grandes células B. Disponível em: &lt;a href=&quot;https://abrale.org.br/doencas/linfomas/lnh/subtipos/linfoma-difuso-de-grandes-celulas-b/o-que-e-linfoma-difuso-de-grandes-celulas-b/&quot;>https://abrale.org.br/doencas/linfomas/lnh/subtipos/linfoma-difuso-de-grandes-celulas-b/o-que-e-linfoma-difuso-de-grandes-celulas-b/&lt;/a>. Acesso em 11 de julho de 2025.&lt;/li>&#xd;&#xa;&lt;li>Linfoma não Hodgkin. Disponível em: &lt;a href=&quot;https://accamargo.org.br/sobre-o-cancer/tipos-de-cancer/linfoma-nao-hodgkin&quot;>https://accamargo.org.br/sobre-o-cancer/tipos-de-cancer/linfoma-nao-hodgkin&lt;/a>. Acesso em 11 de julho de 2025.&lt;/li>&#xd;&#xa;&lt;li>Saiba tudo sobre o linfoma folicular. Disponível em: &lt;a href=&quot;https://revista.abrale.org.br/saude/2023/08/saiba-tudo-sobre-o-linfoma-folicular/&quot;>https://revista.abrale.org.br/saude/2023/08/saiba-tudo-sobre-o-linfoma-folicular/&lt;/a>. Acesso em 11 de julho de 2025.&lt;/li>&#xd;&#xa;&lt;li>ABRALE. Linfoma difuso de grandes células B: O que esperar do meu terceiro tratamento?. Folheto 2024.&lt;/li>&#xd;&#xa;&lt;li>Wu Y, Yi M, Zhu S, Wang H, Wu K. Recent advances and challenges of bispecific antibodies in solid tumors. Exp Hematol Oncol. 2021 Dec 18;10(1):56.&lt;br>&#xd;&#xa;&lt;br>&#xd;&#xa;&lt;/li>&#xd;&#xa;&lt;/ol>&#xd;&#xa;&lt;p>Todos os Direitos Reservados. BR-ONC-250032. Aprovado em Julho/2025&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
