                            jcr:title="Procure um especialista"
                            sling:resourceType="abbvie-com2/components/title/v2/title"
                            type="h3"
                            variant="h"/>
                        <text_1192535367
                            cq:styleIds="[1659545825678]"
                            jcr:created="{Date}2025-01-29T03:02:50.573-05:00"
                            jcr:createdBy="jewitca"
                            jcr:lastModified="{Date}2025-01-29T03:03:02.446-05:00"
                            jcr:lastModifiedBy="jewitca"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>O especialista em câncer do sangue é o onco-hematologista e o acompanhamento da doença deve ser feito com ele para um bom diagnóstico e o tratamento adequado. O diálogo médico e paciente é de extrema importância, esclarecendo dúvidas e dividindo estilo de vida para juntos, definirem a melhor opção de condução e tratamento dentro das possibilidades.&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
                        <separator_892674072__53616721
                            cq:styleIds="[1662756456518]"
                            jcr:created="{Date}2024-11-12T15:56:44.394-05:00"
