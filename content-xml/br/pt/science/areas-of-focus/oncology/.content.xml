                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            langAttribute="none"
                            text="&lt;p>Estamos trabalhando para criar novos padrões de tratamentos para tumores sólidos como câncer de ovário, de pulmão e colorretal. Quando o assunto é Oncologia, não podemos parar.&lt;/p>&#xd;&#xa;"
