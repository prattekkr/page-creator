                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            langAttribute="none"
                            text="&lt;p>Estamos focados em encontrar respostas que transformem a maneira como o câncer é tratado. Queremos alcançar melhores resultados clínicos e mais duradouros em hematologia e tumores sólidos.&amp;nbsp;&lt;/p>&#xd;&#xa;"
