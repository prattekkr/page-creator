                            jcr:primaryType="nt:unstructured"
                            jcr:title="Cânceres de Sangue "
                            sling:resourceType="abbvie-com2/components/title/v2/title"
                            type="h4"
                            variant="h"/>
                        <text2_copy
                            cq:styleIds="[1659545825678,1659545835858]"
                            jcr:lastModified="{Date}2026-06-22T12:41:12.961-04:00"
                            jcr:lastModifiedBy="VALENSX5"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            langAttribute="none"
                            text="&lt;p>Os cânceres hematológicos (que podem ser chamados de maneira mais simples de 'cânceres de sangue') são um grupo de doenças que afetam os tecidos formadores do sangue, como a medula óssea, e pode comprometer a produção e a função das células sanguíneas, dificultando a defesa do organismo contra infecções.&lt;sup>1&lt;/sup>&lt;/p>&#xd;&#xa;&lt;p>Conheça mais sobre a atuação da AbbVie:&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
                        <separator_165917366
                            cq:styleIds="[1662756423318]"
                            jcr:created="{Date}2022-12-18T09:21:43.017-05:00"
