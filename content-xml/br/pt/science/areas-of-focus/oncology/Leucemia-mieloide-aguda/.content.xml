                                jcr:lastModifiedBy="jewitca"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Pacientes com LMA geralmente apresentam sintomas inespecíficos que simulam outras doenças comuns, como a gripe. Seus primeiros sintomas incluem:&lt;sup>2&lt;/sup>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <image
