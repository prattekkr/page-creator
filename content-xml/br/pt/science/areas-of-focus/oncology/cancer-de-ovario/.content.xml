                                jcr:lastModifiedBy="VALENSX5"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <title_copy_copy_copy
                                cq:styleIds="[1659545825678,1661545829678]"
                                jcr:lastModified="{Date}2025-05-06T14:06:40.788-04:00"
                                jcr:lastModifiedBy="VALENSX5"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="Guia para ajudar você na Próxima Consulta"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h3"
                                variant="h"/>
                            <text_93726874_copy_c_1615510230
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2025-05-06T13:51:24.170-04:00"
                                jcr:createdBy="VALENSX5"
                                jcr:lastModified="{Date}2025-05-06T14:01:28.324-04:00"
                                jcr:lastModifiedBy="VALENSX5"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Pensando em facilitar essa conversa, acesse abaixo um &lt;b>Guia Interativo de Consulta Médica&lt;/b>, com espaço para você:&lt;/p>&#xd;&#xa;&lt;ul>&#xd;&#xa;&lt;li>Registrar sintomas&lt;/li>&#xd;&#xa;&lt;li>Anotar dúvidas&lt;/li>&#xd;&#xa;&lt;li>Organizar contatos importantes da equipe de saúde&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;"
                                textIsRich="true"/>
                            <text_93726874_copy_c_1416154157
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2025-05-06T13:51:24.170-04:00"
                                jcr:createdBy="VALENSX5"
                                jcr:lastModified="{Date}2025-05-06T14:01:46.368-04:00"
                                jcr:lastModifiedBy="VALENSX5"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Leve-o com você para lembrar de tudo o que precisa ser esclarecido em suas consultas.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <button
