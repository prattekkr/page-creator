                            jcr:primaryType="nt:unstructured"
                            jcr:title="Our Commitment "
                            sling:resourceType="abbvie-com2/components/title/v2/title"
                            type="h3"
                            variant="h"/>
                        <text_1918840030
                            cq:styleIds="[1659545825678]"
                            jcr:created="{Date}2023-05-02T15:22:14.870-04:00"
                            jcr:createdBy="chiucx"
                            jcr:lastModified="{Date}2026-01-21T08:53:08.275-05:00"
                            jcr:lastModifiedBy="singarx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>We’re&amp;nbsp;committed to providing&amp;nbsp;a quality&amp;nbsp;web experience for all who use our site, regardless of device or ability.&amp;nbsp;That’s&amp;nbsp;why&amp;nbsp;we’re&amp;nbsp;using&amp;nbsp;the&amp;nbsp;&lt;a href=&quot;https://www.w3.org/WAI/standards-guidelines/wcag/&quot;>Web Content Accessibility Guidelines (WCAG) 2.1&lt;/a>&amp;nbsp;as criteria to work towards.&amp;nbsp;&lt;/p>&#xd;&#xa;&lt;p>Currently,&amp;nbsp;we’re&amp;nbsp;achieving&amp;nbsp;our goal of AA. We regularly&amp;nbsp;monitor&amp;nbsp;our site to ensure that our website sustains that goal.&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
                        <separator_copy
                            cq:styleIds="[1662756423318]"
