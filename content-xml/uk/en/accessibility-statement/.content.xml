                            jcr:lastModifiedBy="singarx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>If you&amp;nbsp;would like to&amp;nbsp;get in contact with&amp;nbsp;AbbVie&amp;nbsp;to raise any&amp;nbsp;accessibility&amp;nbsp;questions or&amp;nbsp;provide&amp;nbsp;feedback&amp;nbsp;on your experience of the site, please&lt;a href=&quot;/content/abbvie-com2/uk/en/contactus.html&quot;> contact us.&lt;/a>&lt;/p>&#xd;&#xa;"
