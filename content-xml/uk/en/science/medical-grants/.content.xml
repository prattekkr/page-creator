                            <item_1768553218418
                                cq:panelTitle="Application Criteria  "
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2026-01-16T11:29:31.482-05:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>AbbVie accepts funding applications from Healthcare Organisations to support projects&amp;nbsp;related&amp;nbsp;to:&lt;/p>&#xd;&#xa;&lt;p>&lt;ul>&#xd;&#xa;&lt;li>Health&lt;/li>&#xd;&#xa;&lt;li>Medical/Scientific&amp;nbsp;Education&lt;/li>&#xd;&#xa;&lt;li>Science&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;&lt;/p>&#xd;&#xa;&lt;p>When applying, the&amp;nbsp;application form&amp;nbsp;will&amp;nbsp;contain&amp;nbsp;further details and relevant criteria, which reflect the requirements of the ABPI Code of Practice and relevant policies and governance obligations.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <item_1768553222052
                                cq:panelTitle="Application Approvals"
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2026-01-16T03:49:32.282-05:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>All internal applications are reviewed by an impartial committee who meet 2 times a year. We aim to notify all applicants on the outcome of their application directly and in a timely fashion. Completion of the form is not confirmation that your request will be granted.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                        </accordion>
