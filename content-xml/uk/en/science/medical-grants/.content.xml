                            jcr:lastModified="{Date}2026-02-10T10:32:27.420-05:00"
                            jcr:lastModifiedBy="singarx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>Our&amp;nbsp;AbbVie Medical Independent Grants&amp;nbsp;programme offers arm’s lengths financial grants to eligible Healthcare&amp;nbsp;Organisations, to support a range of projects including scientific and educational initiatives, and projects which improve standards of care&amp;nbsp;that are aligned to AbbVie’s medical and/or scientific strategies. It is important to note that AbbVie will not have any involvement in the projects financed by these grants.&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
                        <separator_2077978924
                            jcr:created="{Date}2026-01-16T03:43:08.681-05:00"
                            jcr:createdBy="singarx"
                            jcr:lastModified="{Date}2026-01-16T03:43:08.681-05:00"
