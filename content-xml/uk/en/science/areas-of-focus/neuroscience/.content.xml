                            jcr:createdBy="chiucx"
                            jcr:lastModified="{Date}2022-12-18T09:35:15.294-05:00"
                            jcr:lastModifiedBy="chiucx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/accordion/v2/accordion"
                            heading="Focus areas"
                            headingElement="h5"
                            singleExpansion="false">
                            <item_1671312472873
                                cq:panelTitle="Parkinson’s disease"
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2026-01-13T10:42:25.258-05:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Parkinson’s disease is a degenerative condition of the brain associated with muscular rigidity, tremors and cognitive decline.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <item_1671312475801
                                cq:panelTitle="Migraine"
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2026-01-13T10:42:06.084-05:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Migraine is a complex neurological condition with a variety of symptoms, usually featuring a severe headache. Other symptoms include disturbed vision, nausea and increased sensitivity to light and sound.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <item_1671312481387
                                cq:panelTitle="Movement Disorders"
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2026-01-13T10:41:16.250-05:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Movement disorders are chronic and progressive neurological conditions impacting the body’s ability to control movement.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <item_1671372277563
                                cq:panelTitle="Psychiatric Disorders"
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2026-01-13T10:40:45.744-05:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Psychiatric disorders are health conditions involving changes in emotion, thinking or behaviour (or a combination of these), such as depression, anxiety, bipolar disorder.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <item_1671372296338
                                cq:panelTitle="Alzheimer’s disease"
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2026-01-13T10:39:53.115-05:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Alzheimer's is a brain disorder which eventually causes dementia, affecting memory, thinking, and behaviour. Alzheimer’s disease is marked by changes in memory, language and the ability to carry out everyday tasks like cooking or driving.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
