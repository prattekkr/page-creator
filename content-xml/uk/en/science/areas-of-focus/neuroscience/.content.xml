                            jcr:lastModifiedBy="singarx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>The burden of neurological and psychiatric disorders can feel insurmountable. But that feeling drives us to take on some of the biggest challenges and unearth potential solutions.&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
                        <separator_165917366
                            cq:styleIds="[1662756423318]"
                            jcr:created="{Date}2022-12-18T09:21:43.017-05:00"
