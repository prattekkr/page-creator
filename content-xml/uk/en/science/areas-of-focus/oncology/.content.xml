                            jcr:created="{Date}2025-06-06T02:47:56.824-04:00"
                            jcr:createdBy="singarx"
                            jcr:lastModified="{Date}2025-06-06T02:47:56.824-04:00"
                            jcr:lastModifiedBy="singarx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                        <title
                            cq:styleIds="[1659545825678,1661545829678,1651545825694]"
                            jcr:created="{Date}2025-06-06T02:48:14.288-04:00"
                            jcr:createdBy="singarx"
                            jcr:lastModified="{Date}2025-06-06T02:48:48.936-04:00"
                            jcr:lastModifiedBy="singarx"
                            jcr:primaryType="nt:unstructured"
                            jcr:title="Going beyond our medicines "
                            sling:resourceType="abbvie-com2/components/title/v2/title"
                            type="h4"
                            variant="h"/>
                        <text
                            cq:styleIds="[1659545825678]"
                            jcr:created="{Date}2025-06-06T02:48:56.322-04:00"
                            jcr:createdBy="singarx"
                            jcr:lastModified="{Date}2025-06-06T02:50:00.661-04:00"
                            jcr:lastModifiedBy="singarx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>As treatment paradigms shift, our intent is to continue supporting clinical and patient communities to keep pace with new developments in a sustainable way, through disease awareness programmes, medical education and continued investment in scientific and medical research.&amp;nbsp;&lt;br>&#xd;&#xa;&lt;br>&#xd;&#xa;By listening to and working with these communities, we want to help people with cancer focus on living with their condition, not suffering from or being defined by it.&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
                    </container4_copy_copy>
