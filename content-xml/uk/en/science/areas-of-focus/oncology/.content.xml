                        sling:resourceType="abbvie-com2/components/container/v2/container">
                        <title2
                            cq:styleIds="[1659545825678,1651545824678]"
                            jcr:lastModified="{Date}2023-02-11T15:09:45.986-05:00"
                            jcr:lastModifiedBy="chiucx"
                            jcr:primaryType="nt:unstructured"
                            jcr:title="Oncology focus areas"
                            sling:resourceType="abbvie-com2/components/title/v2/title"
                            type="h3"
                            variant="h"/>
                        <text2
                            cq:styleIds="[1659545825678,1659545835858]"
                            jcr:lastModified="{Date}2025-12-11T05:08:25.994-05:00"
                            jcr:lastModifiedBy="singarx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>We are focused on developing and accelerating access to transformative therapies that improve patient outcomes in a selected set of debilitating and widespread cancers. These include haematological malignancies and solid tumour cancers.  &lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
                        <separator
                            cq:styleIds="[1662756486159]"
                            jcr:created="{Date}2022-12-18T09:01:55.660-05:00"
                            jcr:createdBy="chiucx"
                            jcr:lastModified="{Date}2022-12-18T09:01:55.660-05:00"
                            jcr:lastModifiedBy="chiucx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                        <title2_copy
                            cq:styleIds="[1659545825678,1651545824678]"
                            jcr:lastModified="{Date}2023-02-11T15:10:16.369-05:00"
                            jcr:lastModifiedBy="chiucx"
                            jcr:primaryType="nt:unstructured"
                            jcr:title="Blood cancers"
                            sling:resourceType="abbvie-com2/components/title/v2/title"
                            type="h4"
                            variant="h"/>
                        <text2_copy
                            cq:styleIds="[1659545825678,1659545835858]"
                            jcr:lastModified="{Date}2025-12-11T04:51:23.616-05:00"
                            jcr:lastModifiedBy="singarx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>Blood cancer is the fifth most common cancer and third biggest cancer killer in the UK. There are more than 100 individual blood cancers and most of these are types of leukaemia, lymphoma or myeloma.&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
                        <separator_165917366
                            cq:styleIds="[1662756423318]"
                            jcr:created="{Date}2022-12-18T09:21:43.017-05:00"
                            jcr:createdBy="chiucx"
                            jcr:lastModified="{Date}2022-12-18T09:21:43.017-05:00"
                            jcr:lastModifiedBy="chiucx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                        <accordion_copy_copy
                            cq:styleIds="[1,1653545835881]"
                            jcr:created="{Date}2022-12-17T16:25:09.442-05:00"
                            jcr:createdBy="chiucx"
                            jcr:lastModified="{Date}2026-02-13T20:20:05.685-05:00"
                            jcr:lastModifiedBy="singarx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/accordion/v2/accordion"
                            heading="OUR FOCUS AREAS "
                            headingElement="h5"
                            singleExpansion="false">
                            <item_1671312472873
                                cq:panelTitle="Acute Myeloid Leukaemia (AML)"
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2026-01-14T09:48:54.314-05:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>AML is the most common acute blood cancer in the world. AML is also one of the most aggressive and difficult-to-treat blood cancers. The rarity and aggressive nature of the disease combined with poor outcomes makes treatment challenging.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <item_1671312481387
                                cq:panelTitle="Chronic Lymphocytic Leukaemia (CLL)"
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2025-06-06T02:38:48.903-04:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>CLL is a slow-growing type of blood cancer in which the bone marrow makes too many lymphocytes, a type of white blood cell.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <item_1671372277563
                                cq:panelTitle="Diffuse large B-cell Lymphoma (DLBCL)"
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2025-06-06T02:39:24.898-04:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>DLBCL is a common sub-type of high-grade non-Hodgkin’s lymphoma (NHL). It is an aggressive blood cancer that develops in the lymphatic system and causes certain white blood cells to grow abnormally.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <item_1749191781253
                                cq:panelTitle="Follicular Lymphoma (FL)"
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2025-12-12T04:40:31.274-05:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Follicular lymphoma is a common type of low-grade non-Hodgkin lymphoma. It develops in the lymphatic system and causes certain white blood cells to grow abnormally, usually developing in clumps called ‘follicules‘.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <item_1671372296338
                                cq:panelTitle="Mantle Cell Lymphoma (MCL)"
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2025-06-06T02:39:55.651-04:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>MCL is typically an aggressive form of non-Hodgkin’s lymphoma (NHL) that arises from cells originating in the outer edge of the lymph nodes called the mantle zone.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <item_1671372299968
                                cq:panelTitle="Multiple Myeloma (MM)"
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2026-01-13T11:04:50.920-05:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Myeloma, also known as multiple myeloma, is a cancer of plasma cells, often categorised by recurring cycles of relapse and remission.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <item_1671372303344
                                cq:panelTitle="Myelodysplastic Syndromes (MDS) "
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2025-06-06T02:40:59.281-04:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>MDS are a group of blood disorders characterised by abnormal development of blood cells within the bone marrow. These disorders are considered a type of cancer.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                        </accordion_copy_copy>
                        <separator_165917366_
                            cq:styleIds="[1662756526578]"
                            jcr:created="{Date}2022-12-18T09:21:43.017-05:00"
                            jcr:createdBy="chiucx"
