                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>Our scientists and oncologists strive to give patients improved treatment outcomes and a life beyond cancer by developing therapies that elevate the standards of care.&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
