                            jcr:lastModifiedBy="chiucx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                        <title2_1194237703
                            cq:styleIds="[1659545825678,1651545824678]"
                            jcr:lastModified="{Date}2023-02-11T15:10:23.181-05:00"
                            jcr:lastModifiedBy="chiucx"
                            jcr:primaryType="nt:unstructured"
                            jcr:title="Solid tumors"
                            sling:resourceType="abbvie-com2/components/title/v2/title"
                            type="h4"
                            variant="h"/>
                        <text2_1534592806
                            cq:styleIds="[1659545825678,1659545835858]"
                            jcr:lastModified="{Date}2025-12-11T04:01:33.984-05:00"
                            jcr:lastModifiedBy="singarx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>Solid tumours make up some of the most common types of cancer worldwide. Despite recent innovations, survival rates remain low for many types of solid tumor, particularly in the metastatic setting.&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
                        <accordion
                            cq:styleIds="[1]"
                            jcr:created="{Date}2025-06-06T02:43:49.429-04:00"
                            jcr:createdBy="singarx"
                            jcr:lastModified="{Date}2025-06-06T02:45:20.593-04:00"
                            jcr:lastModifiedBy="singarx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/accordion/v2/accordion"
                            heading="OUR FOCUS AREAS "
                            singleExpansion="false">
                            <item_1749192243264
                                cq:panelTitle="Colorectal Cancer"
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2025-06-06T02:46:14.948-04:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Colorectal cancer is also called bowel cancer. It affects the large bowel, which is made up of the colon and rectum.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <item_1749192246975
                                cq:panelTitle="Lung Cancer   "
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2025-06-06T02:46:45.113-04:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Lung cancer starts in the windpipe (trachea), the main airway (bronchus) or the lung tissue. There are different types of lung cancer, with the most common type being non-small cell lung cancer.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <item_1749192250390
                                cq:panelTitle="Ovarian Cancer  "
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2026-01-20T02:28:14.829-05:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Ovarian cancer is when abnormal cells in the ovary begin to grow and divide in an uncontrolled way. And eventually form a growth (tumour). There are different types of ovarian cancer. The type of ovarian cancer you have depends on the type of cell it starts in.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                        </accordion>
