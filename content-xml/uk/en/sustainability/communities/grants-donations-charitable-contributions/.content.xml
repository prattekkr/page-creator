                        <text
                            cq:styleIds="[1659545825678]"
                            jcr:created="{Date}2025-06-17T06:02:09.453-04:00"
                            jcr:createdBy="singarx"
                            jcr:lastModified="{Date}2026-02-09T04:46:43.864-05:00"
                            jcr:lastModifiedBy="singarx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>Our grants, donations and charitable contributions are awarded to eligible organisations, to support health, education, science or community-based projects undertaken by Healthcare Organisations or Charitable Institutions.&lt;/p>&#xd;&#xa;&lt;p>We are proud to have supported the work of over 250 UK organisations since 2018, and we are pleased to welcome applications from eligible organisations in 2026.&lt;/p>&#xd;&#xa;&lt;p>Due to a high volume of applications, we may close our application window from time to time.  &lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
                        <separator
                            cq:styleIds="[1662756409908]"
                            jcr:created="{Date}2025-06-17T06:04:05.729-04:00"
                            jcr:createdBy="singarx"
