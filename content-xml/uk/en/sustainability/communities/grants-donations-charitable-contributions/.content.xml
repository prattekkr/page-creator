                            jcr:lastModifiedBy="singarx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                        <accordion
                            cq:styleIds="[2,8]"
                            jcr:created="{Date}2025-07-28T10:24:13.518-04:00"
                            jcr:createdBy="singarx"
                            jcr:lastModified="{Date}2025-07-28T10:25:54.709-04:00"
                            jcr:lastModifiedBy="singarx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/accordion/v2/accordion"
                            singleExpansion="false">
                            <item_1753712665364
                                cq:panelTitle="Application Criteria"
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2026-01-20T06:44:27.949-05:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>AbbVie accepts funding applications from Healthcare Organisations or Charitable Institutions to support projects or core mission and activities relative to:&lt;/p>&#xd;&#xa;&lt;ul>&#xd;&#xa;&lt;li>Health&lt;/li>&#xd;&#xa;&lt;li>Education&lt;/li>&#xd;&#xa;&lt;li>Local&lt;/li>&#xd;&#xa;&lt;li>Communities&lt;/li>&#xd;&#xa;&lt;li>Science&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;&lt;p>&lt;b>Projects NOT considered for funding via this process include:&lt;/b>&amp;nbsp; &amp;nbsp;&lt;/p>&#xd;&#xa;&lt;ul>&#xd;&#xa;&lt;li>Clinical research, including Investigator Initiated Studies (please see the AbbVie global website for information on Investigator-Initiated Studies)&lt;/li>&#xd;&#xa;&lt;li>Grants to Healthcare Professionals to attend scientific conferences (Note -these need to be requested through Head Office)&lt;/li>&#xd;&#xa;&lt;li>Medical education events or symposia aimed at healthcare professional audiences (Note - these need to be requested through Head Office)&lt;/li>&#xd;&#xa;&lt;li>Grants to individual healthcare professionals or commercial businesses&lt;/li>&#xd;&#xa;&lt;li>Healthcare Professionals individual training or development opportunities&lt;/li>&#xd;&#xa;&lt;li>Projects/initiatives outside of the UK&lt;/li>&#xd;&#xa;&lt;li>Organisations who have received funding in the last two years&lt;/li>&#xd;&#xa;&lt;li>Projects with a clinical focus outside of our core therapeutic areas&lt;/li>&#xd;&#xa;&lt;li>Salaries and core operating costs&lt;/li>&#xd;&#xa;&lt;li>Projects which provide benefit to an individual only&lt;/li>&#xd;&#xa;&lt;li>Medical equipment that should be funded by the NHS&lt;/li>&#xd;&#xa;&lt;li>Religious Programmes&lt;/li>&#xd;&#xa;&lt;li>Political party sponsorship&lt;/li>&#xd;&#xa;&lt;li>Charity fundraising&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;&lt;p>When applying, the application form will contain further details and relevant criteria, which reflects the requirements of the ABPI Code of Practice and relevant policies and governance obligations.&lt;/p>&#xd;&#xa;&lt;p>&lt;b>Before starting your application, please note:&lt;/b>&lt;/p>&#xd;&#xa;&lt;ul>&#xd;&#xa;&lt;li>Our maximum award level is £5,000 per application&lt;/li>&#xd;&#xa;&lt;li>Only projects wholly controlled by an independent non for profit organisation/charity and where AbbVie has no input or influence over the content are eligible&lt;/li>&#xd;&#xa;&lt;li>Grants and donations to Healthcare Organisations cannot be linked to the use of AbbVie products&lt;/li>&#xd;&#xa;&lt;li>Applications from Healthcare Organisations must be made by an authorised person on behalf of the Healthcare Organisation&lt;/li>&#xd;&#xa;&lt;li>This online application does not allow you to save progress to complete at a later date, so please make sure you have all the required information available to complete the process (including if applicable your organisation's registered charity number and a project budget breakdown)&lt;/li>&#xd;&#xa;&lt;li>Given the high volume of applications we receive and our desire to support as many good causes as possible, it is a general preference of the Committee to provide funding to specific defined initiatives, activities or projects&lt;/li>&#xd;&#xa;&lt;li>All requests must be for a prospective activity/purpose and for a single financial year (January to December), with no commitment for continued funding beyond that year.&lt;/li>&#xd;&#xa;&lt;li>In line with applicable policies and obligations we will make public declarations about any relevant grant/donation to a Healthcare Organisation or Charitable Institution that we have engaged with to provide financial support. This includes, but is not limited to, declarations on our corporate website.&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;"
                                textIsRich="true"/>
                            <item_1753712669804
                                cq:panelTitle="Application Approvals"
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2025-07-28T10:31:02.703-04:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>All internal applications are reviewed by an impartial committee who meet 4 times a year. We aim to notify all applicants on the outcome of their application directly and in a timely fashion. Completion of the form is not confirmation that your request will be granted.&amp;nbsp;&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                        </accordion>
