                            jcr:primaryType="nt:unstructured"
                            jcr:title="Supporting our Communities"
                            sling:resourceType="abbvie-com2/components/title/v2/title"
                            type="h3"
                            variant="h"/>
                        <text
                            cq:styleIds="[1659545825678]"
                            jcr:created="{Date}2025-06-17T07:37:25.465-04:00"
                            jcr:createdBy="NANDIVX5"
                            jcr:lastModified="{Date}2025-06-17T07:42:17.801-04:00"
                            jcr:lastModifiedBy="NANDIVX5"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>&lt;b>Southern California Wildfires&lt;/b>&amp;nbsp;&lt;br>&#xd;&#xa;The AbbVie Foundation donated $1 million to support our disaster relief partners providing safe shelter, food, essential supplies, and critical health and other services to residents and communities impacted by the wildfires across Southern California.  &lt;/p>&#xd;&#xa;&lt;p>&lt;b>Hurricanes Helene and Milton&amp;nbsp;&lt;/b>&lt;br>&#xd;&#xa;The AbbVie Foundation supported relief and recovery efforts through a $250,000 donation to our trusted nonprofit partners. We also donated essential medicines to ensure people impacted by the hurricanes could maintain their health during this challenging time.&lt;/p>&#xd;&#xa;&lt;p>&lt;b>Israel and Gaza&amp;nbsp;&lt;/b>&lt;br>&#xd;&#xa;We donated $1 million to trusted humanitarian relief organisations in response to the conflict in Israel and Gaza. The AbbVie Foundation also matched employee donations to select humanitarian relief partners and nonprofits standing against hate, violence, injustice and persecution of any kind.&lt;/p>&#xd;&#xa;&lt;p>&lt;b>Ukraine&amp;nbsp;&lt;/b>&lt;br>&#xd;&#xa;We partnered with nonprofit organisations to support relief efforts in Ukraine and surrounding countries, and ensure patients continue to have access to our life-saving medicines.&lt;/p>&#xd;&#xa;&lt;p>&lt;b>Turkey &amp;amp; Syria&lt;/b>&amp;nbsp;&lt;br>&#xd;&#xa;We donated $1 million to disaster response and relief efforts in the wake of the devastating earthquakes in Turkey and Syria.&lt;/p>&#xd;&#xa;&lt;p>&lt;b>Puerto Rico&lt;/b>&amp;nbsp;&lt;br>&#xd;&#xa;Following two major hurricanes in 2018, we made a five-year, $100 million donation to support immediate recovery efforts and long-term resiliency on the island.&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
                    </container_1331821906>
