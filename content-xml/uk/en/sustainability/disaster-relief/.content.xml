                            <text
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2025-06-17T06:45:36.062-04:00"
                                jcr:lastModifiedBy="NANDIVX5"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>Our commitment to creating a positive impact on the world is at the heart of everything we do. We aid communities across the globe affected by natural disasters and humanitarian crises by donating essential AbbVie medicines, equipping nonprofit partners with needed resources and providing financial support to impacted employees and their families.&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_copy_copy
                                cq:styleIds="[1662756486159]"
                                jcr:created="{Date}2022-12-05T12:22:48.644-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2022-12-05T12:22:48.644-05:00"
                                jcr:lastModifiedBy="chiucx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <text_1653936822
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2025-06-17T07:30:18.840-04:00"
                                jcr:createdBy="NANDIVX5"
                                jcr:lastModified="{Date}2025-06-17T07:30:32.673-04:00"
                                jcr:lastModifiedBy="NANDIVX5"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>The AbbVie Foundation also matches employee donations to select organisations supporting relief efforts in affected areas, empowering our employees to make a difference and advance a healthier world in times of critical need.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
