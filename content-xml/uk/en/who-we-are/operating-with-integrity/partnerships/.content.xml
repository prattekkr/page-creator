                            jcr:lastModifiedBy="singarx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>From developing medicines that elevate the standard of care, to rethinking how, where, and by whom care is delivered – we work to make lives better.&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
                        <separator_1163967029
                            jcr:created="{Date}2025-07-17T02:38:21.931-04:00"
                            jcr:createdBy="singarx"
                            jcr:lastModified="{Date}2025-07-17T02:38:21.931-04:00"
