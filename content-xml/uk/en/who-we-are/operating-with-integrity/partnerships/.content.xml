                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Collaborative Working and Joint Working projects are a specific type of partnership between the NHS and the pharmaceutical industry, which aim to improve the efficiency and quality of the delivery of patient care.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <item_1751995113122
