                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                        <text_1713106788
                            cq:styleIds="[1659545825678]"
                            jcr:created="{Date}2025-07-17T02:38:28.463-04:00"
                            jcr:createdBy="singarx"
                            jcr:lastModified="{Date}2026-02-09T05:44:55.517-05:00"
                            jcr:lastModifiedBy="singarx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>We don't do this alone. Guided by our ambition to create impact for individuals, the NHS, and for the economy, we collaborate to facilitate and evidence the value of new models of care in areas of high patient and system burden. &lt;br>&#xd;&#xa;&lt;br>&#xd;&#xa;Our partnerships focus on ensuring people can access the right treatment, at the right time and in the right place, to help improve outcomes and reduce pressure on health services.&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
                    </container2>
