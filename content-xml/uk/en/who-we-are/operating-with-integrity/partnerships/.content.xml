                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/accordion/v2/accordion"
                                expandedItems="[item_1774895243941]"
                                singleExpansion="false">
                                <item_1751995117474
                                    cq:panelTitle="Our Current Collaborative Working Projects  "
                                    cq:styleIds="[1659545825678]"
                                    jcr:lastModified="{Date}2026-04-08T10:56:39.468-04:00"
                                    jcr:lastModifiedBy="vickekx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    langAttribute="none"
                                    text="&lt;p>&lt;b>Dermatology&lt;/b>&lt;/p>&#xd;&#xa;&lt;p>&lt;b>Manchester NHS Foundation Trust and AbbVie Ltd &lt;/b>collaborative working executive summary can be found &lt;a href=&quot;/content/dam/abbvie-com2/uk/documents/UK-IMMD-260005%20MFT%20Collaborative%20Working%20Exec%20Summary%20Dermatology%20Approved%20March%202026.pdf&quot;>here&lt;/a>&lt;/p>&#xd;&#xa;&lt;p>&lt;b>The Northern Alliance NHS Foundation Trust and AbbVie Ltd&lt;/b> collaborative working executive summary can be found&lt;a href=&quot;/content/dam/abbvie-com2/uk/documents/project-catalyst-collaborative-working-executive-summary-salford-pharmacy-approved.pdf&quot;> here&lt;/a>.&lt;/p>&#xd;&#xa;&lt;p>&lt;b>Immunology&lt;/b>&lt;/p>&#xd;&#xa;&lt;p>&lt;b>Barts NHS Trust and AbbVie Ltd&lt;/b> collaborative working agreement can be found &lt;a href=&quot;/content/dam/abbvie-com2/uk/documents/uk-abbv-230449-cert-project-catalyst-collaborative-working-executive-summary-imid-barts-nhs-trust-approved-june-24.pdf&quot;>here&lt;/a>.&lt;br>&#xd;&#xa;&lt;br>&#xd;&#xa;&lt;b>Gastroenterology&lt;/b>&lt;br>&#xd;&#xa;&lt;br>&#xd;&#xa;&lt;b>Royal Wolverhampton NHS Trust (New Cross Hospital) and AbbVie Ltd&lt;/b> collaborative working executive summary can be found &lt;a href=&quot;/content/dam/abbvie-com2/uk/documents/SEPT-2024-UK-ABBV-240184-cert-wolverhapton-project-catalyst-collaborative-working-executive-summary-approved.pdf&quot;>here&lt;/a>.&lt;br>&#xd;&#xa;&lt;br>&#xd;&#xa;&lt;b>Guys and St Thomas NHS Foundation Trust and AbbVie Ltd&lt;/b> collaborative working executive summary can be found &lt;a href=&quot;/content/dam/abbvie-com2/uk/documents/uk-immg-250010-guys-st-thomas-gastro-collaborative-working-exec-summary-approved-jan-25.pdf&quot;>here&lt;/a>.&lt;br>&#xd;&#xa;&lt;br>&#xd;&#xa;&lt;b>Royal Devon University Healthcare NHS Foundation Trust and AbbVie Ltd&lt;/b> collaborative working executive summary can be found &lt;a href=&quot;/content/dam/abbvie-com2/uk/documents/uk-immg-250009-royal-devon-gastro-collaborative-working-exec-summary-approved-jan-2025.pdf&quot;>here&lt;/a>.&lt;br>&#xd;&#xa;&lt;br>&#xd;&#xa;&lt;b>Neuroscience&lt;br>&#xd;&#xa; &lt;/b>&lt;br>&#xd;&#xa;&lt;b>Health Innovation Manchester (HInM) and AbbVie Ltd&lt;/b> collaborative working executive summary can be found &lt;a href=&quot;/content/dam/abbvie-com2/uk/documents/migraine-pathway-transformation-collaborative-working-project.pdf&quot;>here.&lt;/a>&amp;nbsp;&lt;br>&#xd;&#xa;&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <item_1774895243941
                                    cq:panelTitle="Our Completed Collaborative Working Projects"
                                    jcr:lastModified="{Date}2026-04-13T05:39:41.560-04:00"
                                    jcr:lastModifiedBy="vickekx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    langAttribute="none"
                                    text="&lt;p>&lt;b>Dermatology&lt;/b>&lt;/p>&#xd;&#xa;&lt;p>&lt;b>The British Dermatology Nursing Group&lt;/b> &lt;b>and AbbVie Ltd&lt;/b>&amp;nbsp;collaborative working executive summary can be found&amp;nbsp;&lt;a href=&quot;/content/dam/abbvie-com2/uk/documents/UK-ABBV-260130%20-%20CERT-%20National%20Dermatology%20Nurse%20Audit%20Executive%20Summary%20(updated%20v2).pdf&quot;>here&lt;/a>. An outcome summary of this project can be found&amp;nbsp;&lt;a href=&quot;/content/dam/abbvie-com2/uk/documents/UK-ABBV-260129%20-%20CERT-%20National%20Dermatology%20Nurse%20Audit%20outcome%20summary.pdf&quot;>here.&lt;/a>&lt;/p>&#xd;&#xa;&lt;p>&lt;b>Eyecare&lt;/b>&lt;/p>&#xd;&#xa;&lt;p>&lt;b>University Hospital Birmingham NHS Foundation Trust and AbbVie Ltd&amp;nbsp;&lt;/b>collaborative working executive summary can be found &lt;a href=&quot;/content/dam/abbvie-com2/uk/documents/UK-ABBV-250204-uhb-risk-stratification-jw-executive-summary-approved-june-2025.pdf&quot;>here.&lt;/a> An outcome summary of this project can be found &lt;a href=&quot;/content/dam/abbvie-com2/uk/documents/UK-ABBV-250137-glau-strat-fast-uhb-joint-working-outcome-summary-approved-may-2025.pdf&quot;>here&lt;/a>.&lt;/p>&#xd;&#xa;&lt;p>&lt;b>Rheumatology&lt;/b>&lt;/p>&#xd;&#xa;&lt;p>&lt;b>University Hospitals Coventry and Warwickshire NHS Trust and AbbVie Ltd&amp;nbsp;&lt;/b>collaborative working executive summary can be found &lt;a href=&quot;/content/dam/abbvie-com2/uk/documents/UK-ABBV-250175-cert-cwa-project-catalyst-rheum-ex-summary-coventry-reapproved-april-2025.pdf&quot;>here&lt;/a>. An outcome summary of this project can be found &lt;a href=&quot;/content/dam/abbvie-com2/uk/documents/UK-ABBV-250130-cwa-catalyst-rheumatology-outcome-summary-coventry.pdf&quot;>here&lt;/a>.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                            </accordion>
