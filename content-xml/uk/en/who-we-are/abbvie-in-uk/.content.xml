                                    jcr:title="Our Mission"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h3"
                                    variant="h"/>
                                <text_copy_copy_copy_
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2025-06-18T02:03:26.255-04:00"
                                    jcr:createdBy="singarx"
                                    jcr:lastModified="{Date}2026-05-19T05:58:37.990-04:00"
                                    jcr:lastModifiedBy="vickekx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    langAttribute="none"
                                    text="&lt;p>AbbVie’s mission is to discover and deliver innovative medicines and solutions that address complex health issues and enhance people’s lives.&amp;nbsp;&lt;br>&#xd;&#xa;&lt;br>&#xd;&#xa;Guided by this and our ambition to create impact at scale, we collaborate and innovate, always seeking new ways to elevate standards of care, enhance lives and support health system sustainability.&lt;br>&#xd;&#xa;&lt;br>&#xd;&#xa;In the UK, AbbVie employs ~1200 people across four sites.&amp;nbsp;Our primary offices are located in Maidenhead and Marlow. In addition, we have a discovery facility in Oxford and an additional site in Sittingbourne.&amp;nbsp;&lt;br>&#xd;&#xa;&lt;br>&#xd;&#xa;Our UK employees work across our diverse therapeutic portfolio and pipeline, which spans immunology, neuroscience, oncology and eye care, in addition to the products and services in our Allergan Aesthetics portfolio. Our UK sites include a global centre of regulatory excellence, a hub for many international Aesthetics functions and a significant clinical development team, working to advance our pipeline.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                            </par_13>
