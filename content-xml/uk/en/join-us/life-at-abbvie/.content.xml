                            <title_1382338800
                                cq:styleIds="[1659545825678,1661545829678]"
                                jcr:created="{Date}2022-12-10T16:40:31.549-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2025-06-19T02:00:50.144-04:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="Inclusive. Collaborative. Innovative.  "
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h3"
                                variant="h"/>
                            <text_1044727654_copy
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2022-12-10T16:39:49.979-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2025-06-19T02:01:19.599-04:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Since day one our inclusive culture has been the secret to our success. It's reflected in everything we do and everything we offer.  At the foundation are the Ways We Work, five pillars that guide how people work, innovate, collaborate and treat one another. It’s what enables individuals, teams and our company as a whole to make a real difference in people’s lives worldwide. &lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                        </container3>
