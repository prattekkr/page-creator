                            <text
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2022-12-10T17:16:00.094-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2025-06-19T05:07:20.168-04:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>No matter your role, level or background, we make sure you have access to the tools and resources needed to grow on your terms. This includes:&lt;/p>&#xd;&#xa;&lt;p>&lt;ul>&#xd;&#xa;&lt;li>On-demand webinars delivered by global content experts and AbbVie leaders&lt;/li>&#xd;&#xa;&lt;li>Talent Link, an internal platform to build your network and grow your brand&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;&lt;br>&#xd;&#xa;&lt;/p>&#xd;&#xa;"
