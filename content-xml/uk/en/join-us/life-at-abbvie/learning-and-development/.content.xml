                            jcr:lastModifiedBy="chiucx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/container/v2/container">
                            <title_copy
                                cq:styleIds="[1659545825678,1661545829678]"
                                jcr:lastModified="{Date}2025-06-19T05:02:41.892-04:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="Develop as a leader "
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h3"
                                variant="h"/>
                            <text
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2026-02-09T12:41:37.101-05:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p> Our leaders play an essential role in bringing out the best in our teams. As a new or aspiring leader at AbbVie, you have access to training resources and specialised programmes focused entirely on developing your leadership skills, including our: &lt;/p>&#xd;&#xa;&lt;ul>&#xd;&#xa;&lt;li>&lt;b>Skills-Focused Workshops&lt;/b>, solutions and resources for leaders to develop critical skills that expand capabilities and build business knowledge&lt;/li>&#xd;&#xa;&lt;li>&lt;b>Leading at AbbVie&lt;/b>,&amp;nbsp;a cohort-based&amp;nbsp;programme that supports first time people leaders with critical skills needed to successfully lead individuals and teams &lt;/li>&#xd;&#xa;&lt;li>&lt;b>Key Talent Leadership Programmes&lt;/b>, a suite of customised learning solutions designed for key talent leaders selected by their business for accelerated development &lt;/li>&#xd;&#xa;&lt;li>&lt;b>Impact Through Inclusion Learning Series&lt;/b>,&amp;nbsp; awareness courses that help build cross-cultural effectiveness &lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;"
                                textIsRich="true"/>
                        </container_1199983605>
                    </copy_of_container_co>
