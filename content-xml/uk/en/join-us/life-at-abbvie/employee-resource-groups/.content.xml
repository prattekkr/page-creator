                                eyebrow="Young Minds "/>
                            <text_copy_copy_copy
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2022-12-05T17:51:25.819-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2026-01-27T02:06:10.509-05:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Young Minds is focused on harnessing the expertise and fresh perspectives of young professionals to foster innovation and agility as well as enhancing the growth opportunities for those early in their careers.&amp;nbsp;&lt;br>&#xd;&#xa;&lt;br>&#xd;&#xa;“The Young Minds Employee Resource Group actively supports early career professionals at AbbVie as they grow and connect in their role. Our mission is to foster a sense of community, empowerment, and personal development - allowing early career professionals to flourish and drive positive change within the business.”&amp;nbsp;&lt;/p>&#xd;&#xa;&lt;p>Katie Walker,&amp;nbsp;Member of Young Minds Committee&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                        </par_13>
