                                sling:resourceType="abbvie-com2/components/header/v2/header"
                                eyebrow="Neurodiversity Circle  "/>
                            <text_copy_copy
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2022-12-05T17:51:25.819-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2026-02-20T10:11:57.361-05:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Our UK Neurodiversity Circle focuses on building awareness and understanding to create a workplace where our neurodiverse community, which brings highly valued skills to our workplace, are empowered to reach their full potential.&lt;br>&#xd;&#xa;&lt;br>&#xd;&#xa;“Recognising the value of diversity is important to me. I feel&amp;nbsp;very proud&amp;nbsp;to be part of an organisation that embraces neurodiversity and adopts a strengths-based approach, allowing each of us to reach our full potential in the workplace. Seeing this carried through actions, rather than just words, makes me feel valued and encouraged to embrace the AbbVie Ways of Working fully.”&lt;/p>&#xd;&#xa;&lt;p>Carly Rutter, Member of Neurodiversity UK Committee&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                        </par_12>
