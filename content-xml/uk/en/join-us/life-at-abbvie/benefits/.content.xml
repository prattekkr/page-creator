                                jcr:lastModified="{Date}2022-12-10T17:10:21.789-05:00"
                                jcr:lastModifiedBy="chiucx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <text_230942827
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2022-12-10T17:10:30.657-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2025-06-19T04:35:06.316-04:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Our compensation, benefits, and wellbeing programmes support your diverse and evolving needs at every stage of your career and life. We offer differentiated and competitive rewards and benefits with the opportunity to flex your benefits to what matters to you most. &lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
