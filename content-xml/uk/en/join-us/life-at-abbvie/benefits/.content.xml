                                    singleExpansion="false">
                                    <item_1670713218905
                                        cq:panelTitle="Compensation"
                                        cq:styleIds="[1659545825678]"
                                        jcr:lastModified="{Date}2026-01-20T06:03:30.718-05:00"
                                        jcr:lastModifiedBy="singarx"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="abbvie-com2/components/text/v2/text"
                                        text="&lt;ul>&#xd;&#xa;&lt;li>Competitive base pay&lt;/li>&#xd;&#xa;&lt;li>Short and long-term incentives&lt;/li>&#xd;&#xa;&lt;li>Recognition&amp;nbsp;programmes&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;"
                                        textIsRich="true"/>
                                    <item_1670713221584
                                        cq:panelTitle="Flexible benefits   "
                                        cq:styleIds="[1659545825678]"
                                        jcr:lastModified="{Date}2026-01-20T06:09:07.696-05:00"
                                        jcr:lastModifiedBy="singarx"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="abbvie-com2/components/text/v2/text"
                                        text="&lt;ul>&#xd;&#xa;&lt;li>Comprehensive medical, dental and vision and coverage&lt;/li>&#xd;&#xa;&lt;li>Sick pay and medical leave&lt;/li>&#xd;&#xa;&lt;li>Life and disability insurance&lt;/li>&#xd;&#xa;&lt;li>Pension Scheme&lt;/li>&#xd;&#xa;&lt;li>Employee Stock Purchase Plan&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;"
                                        textIsRich="true"/>
                                    <item_1670713228568
                                        cq:panelTitle="Flexible work and time off"
                                        cq:styleIds="[1659545825678]"
                                        jcr:lastModified="{Date}2026-02-09T12:43:29.606-05:00"
                                        jcr:lastModifiedBy="singarx"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="abbvie-com2/components/text/v2/text"
                                        text="&lt;ul>&#xd;&#xa;&lt;li>Workplace flexibility that varies based on role&lt;/li>&#xd;&#xa;&lt;li>Hybrid work model for office-based employees that consists of 3 days in office and 2 days of remote work &lt;/li>&#xd;&#xa;&lt;li>Paid holiday and company holidays&lt;/li>&#xd;&#xa;&lt;li>2 paid days off to volunteer, in addition to a volunteer day to participate in a company-wide volunteer week &lt;p>&amp;nbsp;&lt;/p>&#xd;&#xa;&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;"
                                        textIsRich="true"/>
                                    <item_1670713232031
                                        cq:panelTitle="Support for families"
                                        cq:styleIds="[1659545825678]"
                                        jcr:lastModified="{Date}2025-06-19T04:40:44.433-04:00"
                                        jcr:lastModifiedBy="singarx"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="abbvie-com2/components/text/v2/text"
                                        text="&lt;ul>&#xd;&#xa;&lt;li>Paid leave for new parents welcoming a child through birth, adoption, surrogacy or fostering &lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;"
                                        textIsRich="true"/>
                                    <item_1670713236887
                                        cq:panelTitle="Holistic wellbeing"
                                        cq:styleIds="[1659545825678]"
                                        jcr:lastModified="{Date}2025-06-19T04:41:16.623-04:00"
                                        jcr:lastModifiedBy="singarx"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="abbvie-com2/components/text/v2/text"
                                        text="&lt;p>We partner with employees on their wellbeing journey, connecting them to tools, and support to help them be their best selves, at work and at home. Because when you're at your best, you can make the most impact. &lt;/p>&#xd;&#xa;&lt;p>&lt;a href=&quot;/content/abbvie-com2/uk/en/join-us/life-at-abbvie/well-being-in-the-workplace.html&quot;>Explore more&lt;/a>&lt;/p>&#xd;&#xa;"
                                        textIsRich="true"/>
                                    <item_1670713240836
                                        cq:panelTitle="Learning &amp; development"
                                        cq:styleIds="[1659545825678]"
                                        jcr:lastModified="{Date}2025-06-19T04:41:46.712-04:00"
                                        jcr:lastModifiedBy="singarx"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="abbvie-com2/components/text/v2/text"
                                        text="&lt;p>We're at our best when we push ourselves to grow, try new skills and have the courage to take risks. Our commitment to learning and development provides resources that empower employees to step up and reach higher. &lt;/p>&#xd;&#xa;&lt;p>&lt;a href=&quot;/content/abbvie-com2/uk/en/join-us/life-at-abbvie/learning-and-development.html&quot;>Explore more&lt;/a>&lt;/p>&#xd;&#xa;"
                                        textIsRich="true"/>
                                </accordion>
