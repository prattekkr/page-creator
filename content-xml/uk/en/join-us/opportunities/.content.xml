                            <text_673041397
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2022-12-10T16:00:34.180-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2025-06-19T01:29:40.406-04:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Whether you work in the lab, in an office, in a manufacturing facility or in the field, the objective is the same - to make a real difference in people’s lives. That’s why we continually ask questions and champion new perspectives, building on each other’s expertise to develop the best solutions for the people who depend on us. Learn more about our teams and their impact.&amp;nbsp;&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
