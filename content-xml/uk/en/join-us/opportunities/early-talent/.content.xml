                            <item_1764157483483
                                cq:panelTitle="What will you be doing?"
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2026-02-11T11:20:32.073-05:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>You’ll&amp;nbsp;be part of an innovative&amp;nbsp;organisation&amp;nbsp;with an unparalleled culture, given the opportunity to dive into projects and work alongside industry leaders, who will guide and mentor you along the way. Discover your potential and be part of a company committed to making possibilities real.&lt;br>&#xd;&#xa;&lt;br>&#xd;&#xa;&lt;b>Join one of our business areas and make a difference:&amp;nbsp;&lt;/b>&lt;br>&#xd;&#xa;&lt;br>&#xd;&#xa;&lt;b>Therapeutics: &lt;/b>Rotate in 12-month rotations in AbbVie key business areas, such as Marketing, Customer Excellence, Market Access, and Sales.&amp;nbsp;&lt;br>&#xd;&#xa;&lt;b>Aesthetics:&lt;/b>&amp;nbsp;Rotate in 12-month rotations in Allergan Aesthetics key business areas, such as Allergan Medical Institute, Business Excellence, Marketing/PR Communications and Sales.&lt;/p>&#xd;&#xa;&lt;p>If you meet or exceed our&amp;nbsp;expectation,&amp;nbsp;you’ll&amp;nbsp;have the opportunity to secure a permanent position in a variety of commercial areas. At AbbVie, possibilities are limitless, how much will you accelerate your potential?&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <item_1764157488557
                                cq:panelTitle="What are we looking for?"
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2026-02-12T08:15:59.037-05:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Graduates with a passion for healthcare or life sciences and&amp;nbsp;excited&amp;nbsp;to be a part of the future within our global&amp;nbsp;organisation.&lt;/p>&#xd;&#xa;&lt;ul>&#xd;&#xa;&lt;li>Curiosity,&amp;nbsp;adaptability&amp;nbsp;and a growth mindset&lt;/li>&#xd;&#xa;&lt;li>Innovative, creative and a drive to challenge the status quo&lt;/li>&#xd;&#xa;&lt;li>Strong communication&amp;nbsp;and&amp;nbsp;teamwork&amp;nbsp;skills&lt;/li>&#xd;&#xa;&lt;li>Strategic thinking and strong problem-solving abilities&lt;/li>&#xd;&#xa;&lt;li>Demonstrates leadership skills&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;"
                                textIsRich="true"/>
                            <item_1764157492515
                                cq:panelTitle="What's in it for you? "
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2026-02-11T11:21:53.198-05:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&amp;nbsp;&lt;/p>&#xd;&#xa;&lt;ul>&#xd;&#xa;&lt;li>Rotations allow experience of different business units and skillsets&lt;/li>&#xd;&#xa;&lt;li>Launchpad for your career within AbbVie / Allergan Aesthetics&lt;/li>&#xd;&#xa;&lt;li>Competitive salary&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;li>World-class office facilities&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;li>&amp;nbsp;Strong development culture, coaching opportunities and learn from experiences of past graduates&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;&lt;p>&amp;nbsp;&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                        </accordion_copy>
