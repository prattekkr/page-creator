                                    jcr:lastModified="{Date}2025-01-13T15:35:09.674-05:00"
                                    jcr:lastModifiedBy="jewitca"
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="Ponemos en práctica nuestra experiencia para abordar los cánceres más difíciles."
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h2"
                                    variant="h"/>
                                <text2_copy_copy
                                    cq:styleIds="[1659545825678,1659545835858]"
                                    jcr:lastModified="{Date}2025-06-04T04:30:45.191-04:00"
                                    jcr:lastModifiedBy="MOLINAX5"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Nuestra investigación científica ha dado lugar a descubrimientos fundamentales en el tratamiento de cánceres hematológicos. Ahora estamos ampliando nuestro conocimiento para ayudar a tratar los tumores sólidos, que representan más del 90% de los cánceres.&lt;/p>&#xd;&#xa;&lt;p>Aprovechamos nuestro profundo conocimiento de la biología humana y las tecnologías vanguardistas de investigación para encontrar nuevas formas de mejorar la vida de las personas con cáncer.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                            </container4>
                            <container
                                cq:styleIds="[1653545825684,1653545835879]"
                                jcr:created="{Date}2025-01-13T15:35:25.861-05:00"
                                jcr:createdBy="jewitca"
                                jcr:lastModified="{Date}2025-01-13T15:35:25.861-05:00"
                                jcr:lastModifiedBy="jewitca"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/container/v2/container">
                                <title
                                    cq:styleIds="[1661545829678,1659545825678,1651545825692]"
                                    jcr:created="{Date}2025-01-13T15:35:43.108-05:00"
                                    jcr:createdBy="jewitca"
                                    jcr:lastModified="{Date}2025-01-13T15:36:10.319-05:00"
