                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            langAttribute="none"
                            text="&lt;ul>&#xd;&#xa;&lt;li>&lt;span class=&quot;body-unica-26-reg&quot;>&lt;b>Acular®&lt;/b> (ketorolaco trometamol)&lt;/span>&lt;/li>&#xd;&#xa;&lt;li>&lt;span class=&quot;body-unica-26-reg&quot;>&lt;b>Alphagan®&lt;/b> (tartrato de brimonidina)&lt;/span>&lt;/li>&#xd;&#xa;&lt;li>&lt;span class=&quot;body-unica-26-reg&quot;>&lt;b>Aquipta&lt;/b>®&amp;nbsp;(atogepant)&lt;/span>&lt;/li>&#xd;&#xa;&lt;li>&lt;span class=&quot;body-unica-26-reg&quot;>&lt;b>Botox®&lt;/b> (toxina botulínica tipo A)&lt;/span>&lt;/li>&#xd;&#xa;&lt;li>&lt;span class=&quot;body-unica-26-reg&quot;>&lt;b>Chirocane® &lt;/b>(levobupivacaina)&lt;/span>&lt;/li>&#xd;&#xa;&lt;li>&lt;span class=&quot;body-unica-26-reg&quot;>&lt;b>Combigan®&lt;/b> (brimonidina, timolol maleato)&lt;/span>&lt;/li>&#xd;&#xa;&lt;li>&lt;span class=&quot;body-unica-26-reg&quot;>&lt;b>Constella®&lt;/b> (linaclotida)&lt;/span>&lt;/li>&#xd;&#xa;&lt;li>&lt;span class=&quot;body-unica-26-reg&quot;>&lt;b>Duodopa®&lt;/b> (levodopa/carbidopa)&lt;/span>&lt;/li>&#xd;&#xa;&lt;li>&lt;span class=&quot;body-unica-26-reg&quot;>&lt;b>Exocin®&lt;/b> (ofloxacino)&lt;/span>&lt;/li>&#xd;&#xa;&lt;li>&lt;span class=&quot;body-unica-26-reg&quot;>&lt;b>FML®&lt;/b> (fluorometalona)&lt;/span>&lt;/li>&#xd;&#xa;&lt;li>&lt;span class=&quot;body-unica-26-reg&quot;>&lt;b>Ganfort®&lt;/b> (bimatoprost, timolol maleato)&lt;/span>&lt;/li>&#xd;&#xa;&lt;li>&lt;span class=&quot;body-unica-26-reg&quot;>&lt;b>Humira®&lt;/b> (adalimumab)&lt;/span>&lt;/li>&#xd;&#xa;&lt;li>&lt;span class=&quot;body-unica-26-reg&quot;>&lt;b>Kaletra®&lt;/b> (lopinavir/ritonavir)&lt;/span>&lt;/li>&#xd;&#xa;&lt;li>&lt;span class=&quot;body-unica-26-reg&quot;>&lt;b>Lumigan®&lt;/b> (bimatoprost)&lt;/span>&lt;/li>&#xd;&#xa;&lt;li>&lt;span class=&quot;body-unica-26-reg&quot;>&lt;b>Maviret®&lt;/b> (glecaprevir/pibrentasvir)&lt;/span>&lt;/li>&#xd;&#xa;&lt;li>&lt;span class=&quot;body-unica-26-reg&quot;>&lt;b>Norvir®&lt;/b> (ritonavir)&lt;/span>&lt;/li>&#xd;&#xa;&lt;li>&lt;span class=&quot;body-unica-26-reg&quot;>&lt;b>Ozurdex®&lt;/b> (dexametasona)&lt;/span>&lt;/li>&#xd;&#xa;&lt;li>&lt;span class=&quot;body-unica-26-reg&quot;>&lt;b>Pred Forte®&lt;/b> (prednisolona acetato)&lt;/span>&lt;/li>&#xd;&#xa;&lt;li>&lt;span class=&quot;body-unica-26-reg&quot;>&lt;b>Procrin®&lt;/b> (acetato de leuprorelina)&lt;/span>&lt;/li>&#xd;&#xa;&lt;li>&lt;span class=&quot;body-unica-26-reg&quot;>&lt;b>Rinvoq® &lt;/b>(upadacitinib)&lt;/span>&lt;/li>&#xd;&#xa;&lt;li>&lt;span class=&quot;body-unica-26-reg&quot;>&lt;b>Sevorane®&lt;/b> (sevoflurano)&lt;/span>&lt;/li>&#xd;&#xa;&lt;li>&lt;span class=&quot;body-unica-26-reg&quot;>&lt;b>Skyrizi®&lt;/b> (risankizumab)&lt;/span>&lt;/li>&#xd;&#xa;&lt;li>&lt;span class=&quot;body-unica-26-reg&quot;>&lt;b>Tepkinly&lt;/b>®&amp;nbsp;(epcoritamab)&lt;/span>&lt;/li>&#xd;&#xa;&lt;li>&lt;span class=&quot;body-unica-26-reg&quot;>&lt;b>Venclyxto® &lt;/b>(venetoclax)&lt;/span>&lt;/li>&#xd;&#xa;&lt;li>&lt;span class=&quot;body-unica-26-reg&quot;>&lt;b>Viscofresh® &lt;/b>(carmelosa sódica)&lt;/span>&lt;/li>&#xd;&#xa;&lt;li>&lt;span class=&quot;body-unica-26-reg&quot;>&lt;b>Vistabel®&lt;/b> (toxina botulínica tipo A)&lt;/span>&lt;/li>&#xd;&#xa;&lt;li>&lt;span class=&quot;body-unica-26-reg&quot;>&lt;b>Zemplar®&lt;/b> (paricalcitol)&lt;/span>&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;&lt;p>&amp;nbsp;&lt;/p>&#xd;&#xa;"
