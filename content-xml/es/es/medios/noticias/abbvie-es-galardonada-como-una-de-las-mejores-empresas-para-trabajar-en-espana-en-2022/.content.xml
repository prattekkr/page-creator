                                langAttribute="none"
                                text="&lt;ul>&#xd;&#xa;&lt;li>&lt;span class=&quot;light-font&quot;>AbbVie alcanza la tercera posición en la categoría de 500 a 1.000 empleados&lt;/span>&lt;/li>&#xd;&#xa;&lt;li>&lt;span class=&quot;light-font&quot;>9 de cada 10 empleados de AbbVie afirman que la compañía es un Gran Lugar para Trabajar&lt;/span>&lt;/li>&#xd;&#xa;&lt;li>&lt;span class=&quot;light-font&quot;>El 96% de los empleados se siente orgulloso de los éxitos conseguidos por la compañía&lt;/span>&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;"
                                textIsRich="true"/>
