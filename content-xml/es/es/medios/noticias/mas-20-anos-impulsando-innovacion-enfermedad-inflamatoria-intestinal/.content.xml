                                    langAttribute="none"
                                    text="&lt;p>&lt;sup>3&lt;/sup> Lönnfors S, et al. IBD and health- related quality of life -- discovering the true impact. J Crohns Colitis. 2014;8(10):1281-1286. doi:10.1016/j.crohns.2014.03.005&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
