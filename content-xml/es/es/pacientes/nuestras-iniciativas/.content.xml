                            jcr:primaryType="nt:unstructured"
                            jcr:title=" Un programa de soporte a pacientes que ofrece recursos, contenidos y servicios personalizados a todas las personas que viven o conviven con patologías inmunomediadas."
                            sling:resourceType="abbvie-com2/components/title/v2/title"
                            type="h5"
                            variant="h"/>
                        <text_1069752308
                            cq:styleIds="[1659545825678]"
                            jcr:created="{Date}2024-10-28T06:59:40.621-04:00"
