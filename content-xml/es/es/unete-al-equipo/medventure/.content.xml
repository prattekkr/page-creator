                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>MEDVenture es el programa de desarrollo para médicos de AbbVie, mediante el cual buscamos incorporar a Médicos con experiencia clínica que quieran desarrollar su carrera profesional en la industria farmacéutica.&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator
                                cq:styleIds="[1662756456518]"
                                jcr:created="{Date}2024-10-28T13:18:28.119-04:00"
