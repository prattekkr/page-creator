                            jcr:lastModifiedBy="kanchrx3"
                            jcr:primaryType="nt:unstructured"
                            jcr:title="¿Qué becas ofrecemos?"
                            sling:resourceType="abbvie-com2/components/title/v2/title"
                            type="h4"
                            variant="h"/>
                        <text_994290436_copy_
                            cq:styleIds="[1659545825678]"
                            jcr:created="{Date}2024-10-28T12:35:22.979-04:00"
                            jcr:createdBy="kanchrx3"
                            jcr:lastModified="{Date}2024-10-28T12:39:49.506-04:00"
                            jcr:lastModifiedBy="kanchrx3"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>Contamos con numerosas oportunidades para el talento joven en los departamentos de Medical Affairs, Marketing, Comunicación, Pacientes, Recursos Humanos, Financiero, IT, Omnicanalidad y Business Intelligence.&amp;nbsp;&lt;br>&#xd;&#xa; &amp;nbsp;&lt;br>&#xd;&#xa;Descubre las oportunidades que tenemos disponibles y comienza tu carrera en la Industria Farmacéutica. ¡Te estamos esperando!&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
                    </container_copy>
