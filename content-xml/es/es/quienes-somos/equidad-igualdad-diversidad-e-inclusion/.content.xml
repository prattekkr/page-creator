                                    jcr:lastModifiedBy="jewitca"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Algunos de nuestros reconocimientos en EEDI :&lt;/p>&#xd;&#xa;&lt;ul>&#xd;&#xa;&lt;li>Reconocimiento Diversidad de Great Place To Work Spain&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;li>Human Rights Campaign Corporate Equality Index&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;li>Fair360 “Top 50 Companies for Diversity”&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;li>Great Place to Work “World’s Best Workplaces”&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;li>Seramount &amp;quot;100 Best Companies&amp;quot;&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;"
                                    textIsRich="true"/>
