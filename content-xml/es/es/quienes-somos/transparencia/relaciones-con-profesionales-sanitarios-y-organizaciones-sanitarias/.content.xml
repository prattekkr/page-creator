                                text="&lt;p>&lt;sup>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>Defendemos y respetamos los derechos individuales y la seguridad de las personas.&lt;/span>&lt;/span>&lt;/sup>&lt;/p>&#xd;&#xa;"
