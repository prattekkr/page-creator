                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;sup>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>En AbbVie, el paciente está en el centro de todo lo que hacemos y nuestro punto de partida es el profundo conocimiento de él, de su entorno y de su patología.&lt;/span>&lt;/span>&lt;/sup>&lt;/p>&#xd;&#xa;"
