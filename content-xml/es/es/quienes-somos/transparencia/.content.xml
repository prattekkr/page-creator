                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <title_752188606
                                cq:styleIds="[1659545825678,1651545825692]"
                                jcr:created="{Date}2025-02-05T00:04:29.812-05:00"
                                jcr:createdBy="jewitca"
                                jcr:lastModified="{Date}2025-02-05T00:04:39.087-05:00"
                                jcr:lastModifiedBy="jewitca"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="Colaboraciones"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h3"
                                variant="h"/>
                            <text_911081050_copy_
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2024-09-19T12:48:51.035-04:00"
                                jcr:createdBy="kanchrx3"
                                jcr:lastModified="{Date}2025-07-09T06:01:51.261-04:00"
                                jcr:lastModifiedBy="MOLINAX5"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>AbbVie ha declarado detalles de colaboraciones con profesionales sanitarios en EE. UU. desde marzo de 2012, además de en varios países europeos.&lt;/p>&#xd;&#xa;&lt;ul>&#xd;&#xa;&lt;li>Convenios de Colaboración&lt;br>&#xd;&#xa;&lt;br>&#xd;&#xa;Los Convenios de Colaboración más recientes suscritos de acuerdo con el artículo 25 de la Ley 49/2002 de 23 de diciembre, de Régimen Fiscal de las Entidades sin Fines Lucrativos y de los Incentivos Fiscales al Mecenazgo (Ley del Mecenazgo).&lt;br>&#xd;&#xa;&lt;br>&#xd;&#xa;&lt;a href=&quot;/content/abbvie-com2/es/es/quienes-somos/transparencia/convenios-de-colaboracion.html&quot; target=&quot;_self&quot;>Ir a la página&lt;/a>&lt;br>&#xd;&#xa;&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;&lt;ul>&#xd;&#xa;&lt;li>Estado de Información no Financiera&lt;br>&#xd;&#xa;&lt;br>&#xd;&#xa;Informe elaborado conforme a las recomendaciones del IIRC (International Integrated Reporting Council), y de acuerdo con la opción de Conformidad Esencial de los Estándares-GRI (Global Reporting Initiative).&lt;br>&#xd;&#xa;&lt;br>&#xd;&#xa;&lt;a href=&quot;/content/abbvie-com2/es/es/quienes-somos/transparencia/estado-de-informacion-no-financiera.html&quot; target=&quot;_self&quot;>Ir a la página&lt;/a>&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;&lt;div>&amp;nbsp;&lt;/div>&#xd;&#xa;&lt;ul>&#xd;&#xa;&lt;li>Relaciones&lt;br>&#xd;&#xa;&lt;br>&#xd;&#xa;AbbVie ha declarado detalles de colaboraciones con profesionales sanitarios en EE. UU. desde marzo de 2012, además de en varios países europeos.&lt;br>&#xd;&#xa;&lt;br>&#xd;&#xa;&lt;ol>&#xd;&#xa;&lt;li>&amp;nbsp; &amp;nbsp;&lt;a href=&quot;/content/abbvie-com2/es/es/quienes-somos/transparencia/relaciones-con-organizaciones-de-pacientes.html&quot; target=&quot;_self&quot;>Relaciones con organizaciones de pacientes&lt;/a>&lt;/li>&#xd;&#xa;&lt;li>&amp;nbsp; &amp;nbsp;&lt;a href=&quot;/content/abbvie-com2/es/es/quienes-somos/transparencia/relaciones-con-profesionales-sanitarios-y-organizaciones-sanitarias.html&quot; target=&quot;_self&quot;>Relaciones con profesionales sanitarios y organizaciones sanitarias&lt;/a>&lt;/li>&#xd;&#xa;&lt;/ol>&#xd;&#xa;&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;&lt;p>&amp;nbsp;&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
