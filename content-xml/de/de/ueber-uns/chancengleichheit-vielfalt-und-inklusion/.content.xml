                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>Gerechtigkeit, Chancengleichheit, Vielfalt und Inklusion zu leben steht bei AbbVie an erster Stelle. Uns ist es wichtig, Kolleg*innen auf der ganzen Welt ein Umfeld zu bieten, in dem sie ihr volles Potenzial ausschöpfen können.&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
