                        <teaser
                            jcr:created="{Date}2022-12-09T23:24:42.332-05:00"
                            jcr:createdBy="chiucx"
                            jcr:description="&lt;p>Wir setzen uns dafür ein, Chancengleichheit und Inklusion durch kontinuierliches Wachstum und gegenseitige Akzeptanz zu fördern und beim Bewältigen von Herausforderungen eine Kultur der Gleichberechtigung zu schaffen. Dies ist die Grundlage unserer Geschäftstätigkeit, unserer Suche nach Talenten und deren Weiterentwicklung sowie unseres Engagements für die Gemeinschaft. Wir wissen, dass noch ein langer Weg vor uns liegt, und wir verpflichten uns, zuzuhören und an nachhaltigen und wirkungsvollen Veränderungen zu arbeiten. &lt;/p>&#xd;&#xa;"
                            jcr:lastModified="{Date}2024-05-06T14:15:21.345-04:00"
                            jcr:lastModifiedBy="ABDELAX6"
                            jcr:primaryType="nt:unstructured"
                            jcr:title="&lt;p>Starkes Engagement für Fairness in jeglicher Hinsicht und für soziale Gerechtigkeit&lt;/p>&#xd;&#xa;"
                            sling:resourceType="abbvie-com2/components/teaser/v2/teaser"
                            ctaTarget="_self"
                            textIsRich="[true,true]"/>
