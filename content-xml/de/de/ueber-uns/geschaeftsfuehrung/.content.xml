                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;body-unica-32-reg&quot;>Geschäftsführer Forschung und Entwicklung&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <image_copy_1277864189
                                jcr:created="{Date}2024-06-05T14:19:08.799-04:00"
                                jcr:createdBy="washidx10"
