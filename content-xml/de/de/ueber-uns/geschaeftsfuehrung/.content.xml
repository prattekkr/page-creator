                                jcr:lastModified="{Date}2025-12-15T06:39:38.071-05:00"
                                jcr:lastModifiedBy="ZEMSCJX"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>In Deutschland arbeiten rund 3.500 Mitarbeiter*innen jeden Tag daran, einen entscheidenden Beitrag für die Lebensqualität von Menschen mit chronischen und schweren Erkrankungen zu leisten. Unser vierköpfiges Führungsteam in Deutschland verantwortet die Bereiche Forschung und Entwicklung, Produktion, Commercial (Marketing &amp;amp; Vertrieb) und Allergan Aesthetics.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
