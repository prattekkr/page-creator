                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                langAttribute="none"
                                text="&lt;ul>&#xd;&#xa;&lt;li>Zuwendungen an Patientenorganisationen und weitere Institutionen &lt;a title=&quot;Zuwendeungen an Patientenorganisationen 2024&quot; href=&quot;/content/dam/abbvie-com2/de/documents/transparenzkodex/zuwendungen-an-patientenorganisationen-2024.pdf&quot; target=&quot;_blank&quot;>2024&lt;/a> | &lt;a href=&quot;/content/dam/abbvie-com2/de/documents/transparenzkodex/zuwendungen-an-patientenorganisationen-2023.pdf&quot; title=&quot;Zuwendungen an Patientenorganisationen und weitere Institutionen 2023&quot; target=&quot;_blank&quot;>2023&lt;/a>  |  &lt;a href=&quot;/content/dam/abbvie-com2/de/documents/transparenzkodex/zuwendungen-an-patientenorganisationen-2022.pdf&quot; title=&quot;Zuwendungen an Patientenorganisationen und weitere Institutionen 2022&quot; target=&quot;_blank&quot;>2022&lt;/a> &lt;/li>&#xd;&#xa;&lt;li>Zuwendungen an Angehörige der Fachkreise und medizinische Einrichtungen &lt;a title=&quot;Zuwendungen an Angehörige der Fachkreise und medizinische Einrichtungen 2024&quot; href=&quot;https://www.abbvie.com/content/dam/abbvie-com2/pdfs/disclosures/germany/2024-abbvie-germany-efpia-report.pdf&quot; target=&quot;_blank&quot;>2024&lt;/a> |  &lt;a href=&quot;https://www.abbvie.com/content/dam/abbvie-com2/pdfs/disclosures/germany/2023-abbvie-germany-efpia-report.pdf&quot; target=&quot;_blank&quot; title=&quot;Zuwendungen an Angehörige der Fachkreise und medizinische Einrichtungen 2023&quot;>2023&lt;/a>  |  &lt;a href=&quot;https://www.abbvie.com/content/dam/abbvie-com2/pdfs/disclosures/germany/2022-abbvie-germany-efpia-report.pdf&quot; title=&quot;Zuwendungen an Angehörige der Fachkreise und medizinische Einrichtungen 2022&quot; target=&quot;_blank&quot;>2022&lt;/a>&lt;/li>&#xd;&#xa;&lt;li>Beschreibung der Vorgehensweise (Methodology Sheet) &lt;a title=&quot;Beschreibung der Vorgehensweise (Methodology Sheet) 2024&quot; href=&quot;https://www.abbvie.com/content/dam/abbvie-com2/pdfs/disclosures/germany/2024-abbvie-germany-supporting-document.pdf&quot; target=&quot;_blank&quot;>2024&lt;/a> |  &lt;a href=&quot;https://www.abbvie.com/content/dam/abbvie-com2/pdfs/disclosures/germany/2023-abbvie-germany-supporting-document.pdf&quot; title=&quot;Beschreibung der Vorgehensweise (Methodology Sheet) 2023&quot; target=&quot;_blank&quot;>2023&lt;/a>  |  &lt;a href=&quot;https://www.abbvie.com/content/dam/abbvie-com2/pdfs/disclosures/germany/2022-abbvie-germany-supporting-document.pdf&quot; title=&quot;Beschreibung der Vorgehensweise (Methodology Sheet) 2022&quot; target=&quot;_blank&quot;>2022&lt;/a>&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;"
                                textIsRich="true"/>
                        </container3_copy>
