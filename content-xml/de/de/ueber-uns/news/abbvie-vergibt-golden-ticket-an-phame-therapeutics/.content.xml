                                type="h1"
                                variant="h"/>
                            <text_copy_1166287110
                                cq:styleIds="[1659545825678,1659545835858]"
                                jcr:lastModified="{Date}2025-02-06T09:03:05.150-05:00"
                                jcr:lastModifiedBy="LENNIAM"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;sup>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-26-reg&quot;>Innovationen fördern, die Forschung vorantreiben und die Region unterstützen – diese Ziele verfolgt AbbVie nicht nur durch eigene Forschung und Entwicklung. Mit dem „Golden Ticket“ werden junge Biotech-Pioniere unterstützt, ihre vielversprechenden Ideen voranzubringen.&lt;/span>&lt;/span>&lt;/sup>&lt;/p>&#xd;&#xa;&lt;ul>&#xd;&#xa;&lt;li>&lt;span class=&quot;body-unica-26-reg&quot;>&lt;span class=&quot;light-font&quot;>AbbVie sponsort einjährigen Zugang zu BioLabs Heidelberg.&lt;/span>&lt;/span>&lt;/li>&#xd;&#xa;&lt;li>&lt;span class=&quot;body-unica-26-reg&quot;>&lt;span class=&quot;light-font&quot;>Gewinner-Team forscht an Entdeckungstechnologie für Antikörper&lt;/span>&lt;/span>&lt;/li>&#xd;&#xa;&lt;li>&lt;span class=&quot;body-unica-26-reg&quot;>&lt;span class=&quot;light-font&quot;>Golden Ticket ist eine Investition in die Zukunft – auch für AbbVie&lt;/span>&lt;/span>&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;"
                                textIsRich="true"/>
                        </container3_copy>
                    </container2>
                    <grid_copy
