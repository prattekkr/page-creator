                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;sup>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-26-reg&quot;>Bereits zum 14. Mal sind AbbVies „Helfende Hände“ im Einsatz, um soziale Einrichtungen tatkräftig zu unterstützen. In diesem Jahr waren die freiwilligen Helfer*innen besonders gefordert, denn erstmals wurde gleich an zwei Standorten geschliffen, geschraubt und gewerkelt.&lt;/span>&lt;/span>&lt;/sup>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator
                                cq:styleIds="[1662756423318]"
                                jcr:created="{Date}2024-10-03T03:59:52.111-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2024-10-03T03:59:52.111-04:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <text_55898712
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2024-10-03T04:00:10.136-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2024-10-03T04:15:15.385-04:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;ul>&#xd;&#xa;&lt;li>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-26-reg&quot;>Zwei Aktionstage, zwei Standorte, 150 fleißige Mitarbeiter*innen&lt;/span>&lt;/span>&lt;/li>&#xd;&#xa;&lt;li>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-26-reg&quot;>Neuer Anstrich und neue Spielgeräte für die Kindertagesstätte Heilig Geist&amp;nbsp;&amp;nbsp;&lt;/span>&lt;/span>&lt;/li>&#xd;&#xa;&lt;li>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-26-reg&quot;>Pausenhof und Schulgarten derLudwigshafenerGoetheschule hergerichtet&amp;nbsp;&lt;/span>&lt;/span>&lt;/li>&#xd;&#xa;&lt;li>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-26-reg&quot;>&amp;nbsp;Oberbürgermeisterin Jutta Steinruck dankbar für „unermüdlichen Einsatz“&amp;nbsp;&lt;/span>&lt;/span>&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;"
                                textIsRich="true"/>
                        </container3>
