                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;sup>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-26-reg&quot;>• Richard A. Gonzalez übergibt die Funktion des Chief Executive Officer (CEO) an&amp;nbsp;&lt;br>&#xd;&#xa; &amp;nbsp; Robert A. Michael und steht AbbVie fortan als Executive Chairman zur Seite. &lt;br>&#xd;&#xa; • Robert A. Michael tritt damit auch dem Vorstand von AbbVie bei.&lt;/span>&lt;/span>&lt;/sup>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
