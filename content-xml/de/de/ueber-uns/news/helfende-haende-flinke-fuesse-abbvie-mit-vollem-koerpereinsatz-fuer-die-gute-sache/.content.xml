                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;body-unica-26-reg&quot;>&lt;span class=&quot;light-font&quot;>&lt;sup>AbbVies „Helfende Hände“ krempeln wieder die Ärmel hoch. In diesem Jahr erstrahlt die Grund- und Förderschule an der Blies in neuem Glanz.&lt;/sup>&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;&lt;ul>&#xd;&#xa;&lt;li>&lt;span class=&quot;body-unica-26-reg&quot;>&lt;span class=&quot;light-font&quot;>&lt;sup>&amp;nbsp;Neue Wege, neue Bauten, neuer Anstrich&lt;/sup>&lt;/span>&lt;/span>&lt;/li>&#xd;&#xa;&lt;li>&lt;span class=&quot;body-unica-26-reg&quot;>&lt;span class=&quot;light-font&quot;>&lt;sup>Mehr als 150 freiwillige Helfer*innen packen mit an&lt;/sup>&lt;/span>&lt;/span>&lt;/li>&#xd;&#xa;&lt;li>&lt;span class=&quot;body-unica-26-reg&quot;>&lt;span class=&quot;light-font&quot;>&lt;sup>Oberbürgermeisterin Jutta Steinruck lobt „kontinuierliches Engagement“&lt;/sup>&lt;/span>&lt;/span>&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;"
                                textIsRich="true"/>
