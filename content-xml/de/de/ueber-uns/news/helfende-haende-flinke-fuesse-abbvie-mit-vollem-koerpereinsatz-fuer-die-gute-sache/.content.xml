                                    jcr:lastModified="{Date}2025-06-27T09:49:58.893-04:00"
                                    jcr:lastModifiedBy="kunkefx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Die Pinsel wurden ebenfalls geschwungen: „Mit Unterstützung von zwei professionellen Malern haben wir Räume, Flure, Garderoben, Mülleimer und Spielgeräte wie Schaukeln oder Klettergerüste gestrichen.“&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
