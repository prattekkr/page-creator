                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/image/v2/image"
                                    alt="Corporate Health Award 2025 Gruppenbild"
                                    altValueFromDAM="false"
                                    displayPopupTitle="true"
                                    fileReference="/content/dam/abbvie-com2/de/images/presse-medienkontakte/news/corporate-health-award-2025/corporate-health-award-2025-gruppenbild-v2.jpg"
                                    isDecorative="false"
                                    openInNewWindow="false"
                                    titleValueFromDAM="true"/>
                                <text2_copy
                                    cq:styleIds="[1659545825678,1659545835858]"
                                    jcr:lastModified="{Date}2025-11-25T09:53:04.425-05:00"
                                    jcr:lastModifiedBy="LENNIAM"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>„Wir hören unseren Mitarbeitenden aktiv zu und entwickeln flexible, zielgruppengerechte Lösungen – von der Vorsorge bis zur Unterstützung im Krankheitsfall, und das ganzheitlich für die mentale und körperliche Gesundheit,“ sagt Dr. Andreas Erb, Leitender Betriebsarzt bei der Tochtergesellschaft des globalen Biopharma-Unternehmens AbbVie mit Deutschlandsitz in Wiesbaden sowie großem Forschungs- und Produktionsstandort Ludwigshafen. „Durch die enge Verzahnung von digitalen und analogen Angeboten und die Einbindung unserer Partner setzen wir Standards, die echte Teilhabe und nachhaltige Wirkung entfalten. Grundlage dafür ist die enge interdisziplinäre Zusammenarbeit im Arbeitskreis Gesundheit bei AbbVie.“&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <separator_copy
                                    jcr:created="{Date}2024-10-08T02:03:39.634-04:00"
                                    jcr:createdBy="singarx"
                                    jcr:lastModified="{Date}2024-10-08T02:03:39.634-04:00"
                                    jcr:lastModifiedBy="singarx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                                <text_copy_875603341
                                    cq:styleIds="[1659545825678,1659545835858]"
                                    jcr:created="{Date}2025-06-27T09:05:24.616-04:00"
                                    jcr:createdBy="kunkefx"
                                    jcr:lastModified="{Date}2025-11-26T09:54:12.778-05:00"
                                    jcr:lastModifiedBy="LENNIAM"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>&lt;span class=&quot;body-unica-40-reg&quot;>Mental gesund, digital vernetzt, individuell ausgerichtet&lt;/span>&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <text
                                    cq:styleIds="[1659545825678,1659545835858]"
                                    jcr:created="{Date}2025-06-27T09:05:24.616-04:00"
                                    jcr:createdBy="kunkefx"
                                    jcr:lastModified="{Date}2025-11-25T09:53:32.272-05:00"
                                    jcr:lastModifiedBy="LENNIAM"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>AbbVie hat in den letzten Jahren konsequent die Angebote zur mentalen Gesundheit ausgebaut: Ein mehrstufiges System ermöglicht beispielsweise auch die schnelle Vermittlung von psychologischer Unterstützung bei akuten Belastungen. Zielgerichtet für den individuellen Bedarf von Mitarbeitenden stehen Prävention, Empowerment und gezielte Intervention auf mehreren Ebenen zur Verfügung.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <separator_1128535821
                                    jcr:created="{Date}2024-10-08T02:36:08.024-04:00"
                                    jcr:createdBy="singarx"
                                    jcr:lastModified="{Date}2024-10-08T02:36:08.024-04:00"
                                    jcr:lastModifiedBy="singarx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                                <text_copy_875603341_
                                    cq:styleIds="[1659545825678,1659545835858]"
                                    jcr:created="{Date}2025-06-27T09:05:24.616-04:00"
                                    jcr:createdBy="kunkefx"
                                    jcr:lastModified="{Date}2025-11-26T09:54:45.849-05:00"
                                    jcr:lastModifiedBy="LENNIAM"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>&lt;span class=&quot;body-unica-40-reg&quot;>Vielfalt mit System: Zielgruppenspezifische und geschlechterorientierte Angebote&lt;/span>&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <text_copy
                                    cq:styleIds="[1659545825678,1659545835858]"
                                    jcr:created="{Date}2025-06-27T09:05:24.616-04:00"
                                    jcr:createdBy="kunkefx"
                                    jcr:lastModified="{Date}2025-11-25T09:53:51.350-05:00"
                                    jcr:lastModifiedBy="LENNIAM"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Das Gesundheitsangebot wird für unterschiedliche Mitarbeitergruppen präzise zugeschnitten: Für Azubis und Studierende gibt es besondere Gesundheitsworkshops, die auch die Ausbildungsvertretungen (AVOs) einbinden, und das Gesundheitsmanagement ist in Ausbildungspläne integriert. Spezifische Programme adressieren Frauen- und Männergesundheit sowie die Herausforderungen älterer Beschäftigter – ob durch altersgerechte Vorsorge, Mentoring oder den Ausbau kollegialer Netzwerke.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <separator_1128535821_1120065104
                                    jcr:created="{Date}2024-10-08T02:36:08.024-04:00"
                                    jcr:createdBy="singarx"
                                    jcr:lastModified="{Date}2024-10-08T02:36:08.024-04:00"
                                    jcr:lastModifiedBy="singarx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                                <text_copy_875603341__1209031772
                                    cq:styleIds="[1659545825678,1659545835858]"
                                    jcr:created="{Date}2025-06-27T09:05:24.616-04:00"
                                    jcr:createdBy="kunkefx"
                                    jcr:lastModified="{Date}2025-11-26T09:55:09.528-05:00"
                                    jcr:lastModifiedBy="LENNIAM"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>&lt;span class=&quot;body-unica-40-reg&quot;>Digitalisierung als Innovationstreiber&lt;/span>&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <text_copy_copy
                                    cq:styleIds="[1659545825678,1659545835858]"
                                    jcr:created="{Date}2025-06-27T09:05:24.616-04:00"
                                    jcr:createdBy="kunkefx"
                                    jcr:lastModified="{Date}2025-11-25T09:54:31.753-05:00"
                                    jcr:lastModifiedBy="LENNIAM"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>AbbVie setzt auf digitale Angebote: Gesundheitsumfragen können bequem online durchgeführt werden. Das führt zu hohen Teilnahmequoten und liefert allen Teilnehmenden individuelle Auswertungen; Gesundheitsinformationen oder Beratung sind per App sowie online jederzeit abrufbar.&amp;nbsp;&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <separator_1128535821_1619140439
                                    jcr:created="{Date}2024-10-08T02:36:08.024-04:00"
                                    jcr:createdBy="singarx"
                                    jcr:lastModified="{Date}2024-10-08T02:36:08.024-04:00"
                                    jcr:lastModifiedBy="singarx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                                <separator_1128535821_1861401792
                                    jcr:created="{Date}2024-10-08T02:36:08.024-04:00"
                                    jcr:createdBy="singarx"
                                    jcr:lastModified="{Date}2024-10-08T02:36:08.024-04:00"
                                    jcr:lastModifiedBy="singarx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                                <text_copy_875603341__1771799937
                                    cq:styleIds="[1659545825678,1659545835858]"
                                    jcr:created="{Date}2025-06-27T09:05:24.616-04:00"
                                    jcr:createdBy="kunkefx"
                                    jcr:lastModified="{Date}2025-11-26T09:55:31.083-05:00"
                                    jcr:lastModifiedBy="LENNIAM"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>&lt;span class=&quot;body-unica-40-reg&quot;>Starke Allianz mit Krankenkassen und externen Partnern&lt;/span>&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <text_copy_copy_copy
                                    cq:styleIds="[1659545825678,1659545835858]"
                                    jcr:created="{Date}2025-06-27T09:05:24.616-04:00"
                                    jcr:createdBy="kunkefx"
                                    jcr:lastModified="{Date}2025-11-25T09:56:15.557-05:00"
                                    jcr:lastModifiedBy="LENNIAM"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Externe Angebote der Krankenkassen sind fest in die Gesundheitsförderung eingebunden und werden sinnvoll ergänzt – von Präventions- und Vorsorgeleistungen über spezifische Check-Ups bis hin zum Beratungsangebot. Die Qualität und Wirksamkeit wird zudem kontinuierlich durch Evaluationen und Partnerfeedback gemessen und weiterentwickelt.&lt;/p>&#xd;&#xa;&lt;p>Dr. Thomas Merdan, Geschäftsführer Forschung und Entwicklung von AbbVie Deutschland, resümiert: „AbbVie steht für medizinische Innovationen und für ein Arbeitsumfeld, das Gesundheit und persönliche Entwicklung konsequent fördert. Unser Anspruch ist, für alle Beschäftigten – unabhängig von Alter, Funktion oder Geschlecht – eine Arbeitswelt zu schaffen, in der Prävention, Wertschätzung und Digitalisierung zusammenspielen.“&lt;/p>&#xd;&#xa;&lt;p>AbbVie Deutschland nimmt seit 2015 alle zwei Jahre am Wettbewerb um den Corporate Health Award teil, ist sechsmaliger Branchensieger und zeigt, wie sich Gesundheitsmanagement über Jahre gezielt weiterentwickeln lässt. Die aktuelle Auszeichnung zeigt, auf welchem Top-Level das Betriebliche Gesundheitsmanagement bei AbbVie ist. Gleichzeitig ist sie Ansporn, weiterhin Maßstäbe zu setzen.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <separator_1128535821_638274026
                                    jcr:created="{Date}2024-10-08T02:36:08.024-04:00"
                                    jcr:createdBy="singarx"
                                    jcr:lastModified="{Date}2024-10-08T02:36:08.024-04:00"
                                    jcr:lastModifiedBy="singarx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                                <text_copy_875603341__1932122295
                                    cq:styleIds="[1659545825678,1659545835858]"
                                    jcr:created="{Date}2025-06-27T09:05:24.616-04:00"
                                    jcr:createdBy="kunkefx"
                                    jcr:lastModified="{Date}2025-11-26T09:56:00.863-05:00"
                                    jcr:lastModifiedBy="LENNIAM"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>&lt;span class=&quot;body-unica-40-reg&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>Über den Corporate Health Award&amp;nbsp;&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <grid_copy
                                    cq:styleIds="[1653545835880]"
                                    jcr:created="{Date}2025-06-27T09:26:38.579-04:00"
                                    jcr:createdBy="kunkefx"
                                    jcr:lastModified="{Date}2025-06-27T09:49:34.625-04:00"
                                    jcr:lastModifiedBy="kunkefx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/grid/v2/grid"
                                    rowCount="1">
                                    <par_11
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="wcm/foundation/components/parsys">
                                        <text_copy_copy_copy_
                                            cq:styleIds="[1659545825678,1659545835858]"
                                            jcr:created="{Date}2025-06-27T09:05:24.616-04:00"
                                            jcr:createdBy="kunkefx"
                                            jcr:lastModified="{Date}2025-11-25T09:57:47.544-05:00"
                                            jcr:lastModifiedBy="LENNIAM"
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="abbvie-com2/components/text/v2/text"
                                            text="&lt;p>Der Corporate Health Award ist die renommierteste Auszeichnung für Betriebliches Gesundheitsmanagement in Deutschland. Vergeben von EUPD Research und dem Handelsblatt, ehrt der Award nachhaltige Arbeitgeber, die mit modernen Personal- und Gesundheitsstrategien als Vorbild wirken. Weitere Informationen: &lt;a href=&quot;http://www.corporate-health-award.de/&quot; target=&quot;_blank&quot; title=&quot;Zur Seite&quot;>www.corporate-health-award.de&lt;/a>&lt;/p>&#xd;&#xa;"
                                            textIsRich="true"/>
                                    </par_11>
