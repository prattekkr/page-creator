                                jcr:lastModifiedBy="LENNIAM"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;body-unica-26-reg&quot;>AbbVie Deutschland wurde für sein umfassendes und zukunftsweisendes Betriebliches Gesundheitsmanagement (BGM) mit dem Corporate Health Award 2025 in der Kategorie Chemie/Pharma Großkonzern geehrt. Die Jury von EUPD Research und Handelsblatt würdigt damit ein Programm, das kontinuierlich neue Maßstäbe setzt und aktuelle Herausforderungen proaktiv adressiert.&amp;nbsp;&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                        </container3>
