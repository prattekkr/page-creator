                                dmPresetType="imagePreset">
                                <image_copy
                                    jcr:created="{Date}2025-06-27T09:42:01.262-04:00"
                                    jcr:createdBy="kunkefx"
                                    jcr:lastModified="{Date}2025-11-26T09:52:14.253-05:00"
