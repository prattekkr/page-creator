                            sling:resourceType="wcm/foundation/components/parsys">
                            <container4
                                cq:styleIds="[1653545825687,1653545847150,1653242825678,1653545835982,1653545835879]"
                                jcr:lastModified="{Date}2024-12-04T08:36:10.335-05:00"
                                jcr:lastModifiedBy="kunkefx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/container/v2/container">
                                <title2
                                    cq:styleIds="[1659545825678,1651545824678,1651545825692]"
                                    jcr:lastModified="{Date}2024-12-04T08:37:02.785-05:00"
                                    jcr:lastModifiedBy="kunkefx"
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="1. Die häufigste aggressive Unterform eines Non-Hodgkin-Lymphoms"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h2"
                                    variant="h"/>
                                <text
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2024-10-10T11:21:53.121-04:00"
                                    jcr:createdBy="singarx"
                                    jcr:lastModified="{Date}2024-10-10T11:22:24.610-04:00"
                                    jcr:lastModifiedBy="singarx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Das DLBCL zählt zu einer Gruppe von mehr als 60 das lymphatische System betreffende Krebserkrankungen, die unter dem Oberbegriff Non-Hodgkin-Lymphome (NHL) zusammengefasst werden. Mit einem Anteil von 30 Prozent ist das DLBCL die häufigste Unterform eines NHL. Innerhalb der NHL gehört das DLBCL zu den aggressiv verlaufenden Lymphomen.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <separator
                                    jcr:created="{Date}2024-10-10T11:22:44.617-04:00"
                                    jcr:createdBy="singarx"
                                    jcr:lastModified="{Date}2024-10-10T11:22:44.617-04:00"
                                    jcr:lastModifiedBy="singarx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                                <title
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2024-10-10T11:22:50.595-04:00"
                                    jcr:createdBy="singarx"
                                    jcr:lastModified="{Date}2024-12-04T08:37:09.384-05:00"
                                    jcr:lastModifiedBy="kunkefx"
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="2. Diffus bedeutet „ohne Struktur“"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h3"
                                    variant="h"/>
                                <text_936910251
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2024-10-10T11:22:59.417-04:00"
                                    jcr:createdBy="singarx"
                                    jcr:lastModified="{Date}2024-10-10T11:23:53.387-04:00"
                                    jcr:lastModifiedBy="singarx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Bei Krebserkrankungen kommt es zu einer starken und unkontrollierten Vermehrung krankhaft veränderter Zellen. In Abhängigkeit der Krebsform kann sich die Art und Weise dieses Zellwachstums unterscheiden. Das D in DLBCL sagt aus, dass bei dieser Erkrankung ein sogenanntes „diffuses Wachstumsmuster“ vorliegt. Damit ist Folgendes gemeint: Betrachtet man die Krebszellen bei einem DLBCL durch ein Mikroskop, sind sie nicht um bestimmte Strukturen herum angeordnet bzw. es sind keine abgegrenzten Zellanhäufungen zu erkennen. Vielmehr verteilen sich die Zellen gleichmäßig innerhalb der Gewebep&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <separator_733442691
                                    jcr:created="{Date}2024-10-10T11:24:06.928-04:00"
                                    jcr:createdBy="singarx"
                                    jcr:lastModified="{Date}2024-10-10T11:24:06.928-04:00"
                                    jcr:lastModifiedBy="singarx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                                <title_509713176
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2024-10-10T11:24:20.060-04:00"
                                    jcr:createdBy="singarx"
                                    jcr:lastModified="{Date}2024-12-04T08:40:58.814-05:00"
                                    jcr:lastModifiedBy="kunkefx"
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="3. Im wahrsten Sinne des Wortes „groß“"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h3"
                                    variant="h"/>
                                <text_1411584501
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2024-10-10T11:24:58.831-04:00"
                                    jcr:createdBy="singarx"
                                    jcr:lastModified="{Date}2024-10-10T11:26:12.246-04:00"
                                    jcr:lastModifiedBy="singarx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Das erste L in DLBCL kommt aus dem Englischen (large = groß). Denn: Ein weiteres Merkmal der Krebszellen beim DLBCL ist ihre Größe: Im Vergleich zu gesunden Zellen des Zelltyps, aus dem sie entstehen, sind sie mehr als zweifach vergrößert.&amp;nbsp;&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <separator_1678484073
                                    jcr:created="{Date}2024-10-10T11:25:05.535-04:00"
                                    jcr:createdBy="singarx"
                                    jcr:lastModified="{Date}2024-10-10T11:25:05.535-04:00"
                                    jcr:lastModifiedBy="singarx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                                <title_60887702
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2024-10-10T11:25:10.998-04:00"
                                    jcr:createdBy="singarx"
                                    jcr:lastModified="{Date}2024-12-04T08:41:16.878-05:00"
                                    jcr:lastModifiedBy="kunkefx"
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="4. B-Zellen sind krankhaft verändert"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h3"
                                    variant="h"/>
                                <text_2073708813
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2024-10-10T11:25:18.720-04:00"
                                    jcr:createdBy="singarx"
                                    jcr:lastModified="{Date}2024-10-10T11:40:26.524-04:00"
                                    jcr:lastModifiedBy="singarx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Wie bei allen so genannten B-Zell-Lymphomen handelt es sich bei den Krebszellen des DLBCL um krankhaft veränderte B-Zellen. Daher rühren die Buchstaben B und C im Namen („B-cell“ im Englischen). Diese werden auch B-Lymphozyten genannt und sind eine Unterkategorie der Leukozyten, also der weißen Blutzellen.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <separator_74019132
                                    jcr:created="{Date}2024-10-10T11:26:35.538-04:00"
                                    jcr:createdBy="singarx"
                                    jcr:lastModified="{Date}2024-10-10T11:26:35.538-04:00"
                                    jcr:lastModifiedBy="singarx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                                <title_1283726394
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2024-10-10T11:26:41.517-04:00"
                                    jcr:createdBy="singarx"
                                    jcr:lastModified="{Date}2024-12-04T08:41:22.480-05:00"
                                    jcr:lastModifiedBy="kunkefx"
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="5. Lymphome entstehen im Lymphsystem"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h3"
                                    variant="h"/>
                                <text_1073927201
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2024-10-10T11:26:48.682-04:00"
                                    jcr:createdBy="singarx"
                                    jcr:lastModified="{Date}2024-10-10T11:27:54.736-04:00"
                                    jcr:lastModifiedBy="singarx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>B-Zellen – also der Zelltyp, von dem die Krebserkrankung beim DLBCL ausgeht – sind Zellen des lymphatischen Systems, daher die Bezeichnung „Lymphom“ und das zweite L im Namen. Sie sind essenzieller Teil des menschlichen Immunsystems: Sie tragen dazu bei, Fremdstoffe wie Krankheitserreger unschädlich zu machen. Eine wichtige Funktion gesunder B-Zellen liegt in der Bildung von Antikörpern. &lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <separator_1956243188
                                    jcr:created="{Date}2024-10-10T11:28:01.762-04:00"
                                    jcr:createdBy="singarx"
                                    jcr:lastModified="{Date}2024-10-10T11:28:01.762-04:00"
                                    jcr:lastModifiedBy="singarx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                                <title_1266577792
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2024-10-10T11:28:17.662-04:00"
                                    jcr:createdBy="singarx"
                                    jcr:lastModified="{Date}2024-12-04T08:41:27.737-05:00"
                                    jcr:lastModifiedBy="kunkefx"
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="6.  Männer und ältere Menschen sind häufiger betroffen"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h3"
                                    variant="h"/>
                                <text_2127338874_copy
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2024-10-10T11:28:08.045-04:00"
                                    jcr:createdBy="singarx"
                                    jcr:lastModified="{Date}2024-10-10T11:29:21.810-04:00"
                                    jcr:lastModifiedBy="singarx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Männer erkranken etwas häufiger an einem DLBCL als Frauen. Auch steigt das Erkrankungsrisiko mit dem Lebensalter: Rund die Hälfte der Menschen mit einem DLBCL sind 66 Jahre oder älter, wenn sie die Diagnose bekommen. Auch Menschen, die eine die körpereigene Abwehr unterdrückende Behandlung erhalten (sogenannte Immunsuppressiva) oder eine das Immunsystem betreffende Erkrankung (zum Beispiel HIV) haben, tragen ein erhöhtes Risiko für ein DLBCL.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <separator_1534588405
                                    jcr:created="{Date}2024-10-10T11:29:43.025-04:00"
                                    jcr:createdBy="singarx"
                                    jcr:lastModified="{Date}2024-10-10T11:29:43.025-04:00"
                                    jcr:lastModifiedBy="singarx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                                <title_942819653
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2024-10-10T11:29:48.197-04:00"
                                    jcr:createdBy="singarx"
                                    jcr:lastModified="{Date}2024-12-04T08:41:34.447-05:00"
                                    jcr:lastModifiedBy="kunkefx"
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="7. Symptome: Hauptmerkmal sind geschwollene Lymphknoten"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h3"
                                    variant="h"/>
                                <text_155535322
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2024-10-10T11:30:12.951-04:00"
                                    jcr:createdBy="singarx"
                                    jcr:lastModified="{Date}2024-10-10T11:30:40.048-04:00"
                                    jcr:lastModifiedBy="singarx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Das Hauptsymptom des DLBCL sind vergrößerte Lymphknoten im Hals- und Nackenbereich, unter den Achseln, am Bauch sowie in der Leistengegend, denn hier vermehren sich die krankhaft veränderten Zellen. Die schmerzlosen Schwellungen bzw. Knoten entstehen innerhalb weniger Wochen und sind über die Haut mit den Händen ertastbar. Teilweise können die Lymphknoten sehr stark vergrößert sein; ab einem Lymphknotendurchmesser von ≥ 7,5 cm sprechen Mediziner von einem „Bulk“. Patienten mit Bulk haben ein höheres Risiko für einen schweren Verlauf des DLBCL. Bei Ausbreitung der Krebszellen im Knochenmark kann es darüber hinaus zu einer Störung der Blutbildung kommen, welche sich in Abgeschlagenheit und Müdigkeit oder Blutungsneigung etc. äußern kann. Zudem können, wie bei vielen Krebserkrankungen, sogenannte B-Symptome auftreten: Fieber, übermäßiges nächtliches Schwitzen und eine relativ rasche und starke Gewichtsabnahme.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <separator_1059608389
                                    jcr:created="{Date}2024-10-10T11:30:47.728-04:00"
                                    jcr:createdBy="singarx"
                                    jcr:lastModified="{Date}2024-10-10T11:30:47.728-04:00"
                                    jcr:lastModifiedBy="singarx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                                <title_21399748
                                    cq:styleIds="[1659545825678,1651545825693]"
                                    jcr:created="{Date}2024-10-10T11:30:54.128-04:00"
                                    jcr:createdBy="singarx"
                                    jcr:lastModified="{Date}2024-12-04T08:41:42.069-05:00"
                                    jcr:lastModifiedBy="kunkefx"
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="8. Schnelles Wachstum erfordert schnelles Handeln"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h3"
                                    variant="h"/>
                                <text_535143445
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2024-10-10T11:31:02.028-04:00"
                                    jcr:createdBy="singarx"
                                    jcr:lastModified="{Date}2024-10-10T11:32:41.176-04:00"
                                    jcr:lastModifiedBy="singarx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Das DLBCL ist ein aggressiv verlaufendes Lymphom. Dies bedeutet, dass die unkontrollierte Vermehrung der krankhaft veränderten B-Zellen in einem sehr raschen Tempo vonstattengeht. Ohne Behandlung wäre die Lebenserwartung sehr stark verkürzt. Sobald die Diagnose DLBCL feststeht, sollte daher eine entsprechende Therapie eingeleitet werden.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <separator_635745221
                                    jcr:created="{Date}2024-10-10T11:31:08.257-04:00"
                                    jcr:createdBy="singarx"
                                    jcr:lastModified="{Date}2024-10-10T11:31:08.257-04:00"
