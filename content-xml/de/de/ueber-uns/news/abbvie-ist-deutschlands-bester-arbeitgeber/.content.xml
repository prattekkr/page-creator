                                jcr:title="AbbVie ist „Deutschlands Bester Arbeitgeber“: Platz 3 in der Kategorie der Unternehmen mit 2.001 bis 5.000 Mitarbeiter*innen"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h1"
                                variant="h"/>
                            <text_copy_1166287110
                                cq:styleIds="[1659545825678,1659545835858]"
                                jcr:lastModified="{Date}2025-03-21T03:43:23.135-04:00"
                                jcr:lastModifiedBy="LENNIAM"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;sup>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-26-reg&quot;>Das forschende BioPharma-Unternehmen AbbVie Deutschland ist beim Wettbewerb „Deutschlands Beste Arbeitgeber“ vom Great Place to Work-Institut ausgezeichnet worden.&lt;/span>&lt;/span>&lt;/sup>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                        </container3_copy>
                    </container2>
                    <grid_copy
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="abbvie-com2/components/grid/v2/grid"
                        rowCount="1">
