                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>An unseren deutschen Standorten wird geforscht, produziert und vermarktet. Zudem werden Ideen für die Gesundheitsversorgung von morgen entwickelt und in die Tat umgesetzt.&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
                    </container>
