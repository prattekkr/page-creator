                            jcr:lastModifiedBy="jewitca"
                            jcr:primaryType="nt:unstructured"
                            jcr:title="Innovation „Made in Germany“"
                            sling:resourceType="abbvie-com2/components/title/v2/title"
                            type="h4"
                            variant="h"/>
                        <text_772203946
                            cq:styleIds="[1659545825678]"
                            jcr:created="{Date}2024-10-01T06:18:19.722-04:00"
                            jcr:createdBy="kanchrx3"
                            jcr:lastModified="{Date}2025-12-15T06:45:25.366-05:00"
                            jcr:lastModifiedBy="ZEMSCJX"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>Mit dieser Investition unterstreicht AbbVie, welch wichtige Rolle der rheinland-pfälzische Standort mit seinen rund 2.400 Beschäftigten auch zukünftig im weltweiten Firmennetzwerk spielen wird. Sie tragen maßgeblich dazu bei, AbbVies Forschungspipeline erfolgreich voranzutreiben. Ziel ist es, neue Therapien gegen schwere Erkrankungen in Bereichen wie der Onkologie, Neurologie oder Immunologie zu entwickeln, die das Leben von Millionen Patient*innen verbessern können.&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
                        <separator
                            cq:styleIds="[1662756502570]"
