                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>Wir sind davon überzeugt, dass die Wege, die wir gehen, um unsere Erfolge zu erreichen, entscheidend sind. Dass die Wege ebenso entscheidend sind wie das Ergebnis.&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
