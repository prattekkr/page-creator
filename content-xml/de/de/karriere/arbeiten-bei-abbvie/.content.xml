                                jcr:title="Inklusiv. Kooperativ. Innovativ."
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h2"
                                variant="h"/>
                            <text_1044727654_copy
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2022-12-10T16:39:49.979-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2024-05-08T12:58:27.147-04:00"
                                jcr:lastModifiedBy="ABDELAX6"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Unsere inklusive Kultur war von Anfang an das Erfolgsgeheimnis unseres Unternehmens. Sie spiegelt sich in allem wider – in dem, was wir tun, und in dem, was wir anbieten. Die Ways We Work sind unser Fundament: fünf Säulen, die uns Orientierung dafür geben, wie wir arbeiten, Innovationen schaffen, zusammenarbeiten und miteinander umgehen. Denn nur so können einzelne Mitarbeiter*innen, Teams und unser gesamtes Unternehmen einen echten Unterschied im Leben von Menschen weltweit machen.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
