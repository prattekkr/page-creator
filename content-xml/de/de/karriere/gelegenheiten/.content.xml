                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/accordion/v2/accordion"
                                headingElement="h5"
                                singleExpansion="false">
                                <item_1670707220579
                                    cq:panelTitle="Allergan Aesthetics "
                                    cq:styleIds="[1659545825678]"
                                    jcr:lastModified="{Date}2024-05-08T12:09:06.559-04:00"
                                    jcr:lastModifiedBy="ABDELAX6"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Allergan Aesthetics, ein Unternehmen von AbbVie, entwickelt, fertigt und vermarktet ein Portfolio führender Marken und Produkte im Bereich der ästhetischen Medizin. Sei Teil des Teams, das an die Kraft des Selbstvertrauens glaubt.&lt;/p>&#xd;&#xa;&lt;p>Unsere Funktionen bei Allergan Aesthetics:&lt;/p>&#xd;&#xa;&lt;ul>&#xd;&#xa;&lt;li>Allergan Data Labs&lt;/li>&#xd;&#xa;&lt;li>Communications &amp;amp; Customer Engagement&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;li>Global Strategy &amp;amp; Pipeline Marketing&lt;/li>&#xd;&#xa;&lt;li>Sales&lt;/li>&#xd;&#xa;&lt;li>Sales Training&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <item_1670707211154
                                    cq:panelTitle="Commercial"
                                    cq:styleIds="[1659545825678]"
                                    jcr:lastModified="{Date}2024-05-08T12:09:50.029-04:00"
                                    jcr:lastModifiedBy="ABDELAX6"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Bring als Teil unserer Außendienst-, Marketing- und Business-Support-Teams Patient*innen mit neuen Therapien und Lösungen zusammen, die einen positiven Einfluss auf ihr Leben haben können.&amp;nbsp;&lt;/p>&#xd;&#xa;&lt;p>Unsere Funktionen bei Commercial:&lt;/p>&#xd;&#xa;&lt;ul>&#xd;&#xa;&lt;li>Market Access &amp;amp; Managed Health Care&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;li>Market Analytics &amp;amp; Business Intelligence&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;li>Marketing&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;li>Sales&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <item_1670707214308
                                    cq:panelTitle="Corporate"
                                    cq:styleIds="[1659545825678]"
                                    jcr:lastModified="{Date}2024-09-17T18:00:58.355-04:00"
                                    jcr:lastModifiedBy="jewitca"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Finde neue Wege, um unseren Wettbewerbsvorteil auszubauen, unsere Mitarbeiter*innen zu unterstützen und bei allem, was wir tun, mit Integrität voranzugehen.&lt;/p>&#xd;&#xa;&lt;p>Unsere Funktionen bei Corporate:&lt;/p>&#xd;&#xa;&lt;ul>&#xd;&#xa;&lt;li>Business Technology Solutions (BTS)&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;li>Corporate Affairs&lt;/li>&#xd;&#xa;&lt;li>Corporate Strategy Office (CSO)&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;li>Finance &amp;amp; Accounting&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;li>Government Affairs&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;li>Health Economics Outcomes Research&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;li>Human Resources&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;li>Legal&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;li>Office of Ethics and Compliance (OEC)&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <item_1670707217700
                                    cq:panelTitle="Operations"
                                    jcr:lastModified="{Date}2024-05-08T12:11:14.692-04:00"
                                    jcr:lastModifiedBy="ABDELAX6"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Arbeite bei der Herstellung und Bereitstellung unserer Lösungen für Patient*innen mit Expert*innen auf der ganzen Welt zusammen und erfülle oder übertreffe dabei die höchsten Sicherheits- und Qualitätsstandards.&lt;/p>&#xd;&#xa;&lt;p>Unsere Funktionen bei Operations:&lt;/p>&#xd;&#xa;&lt;ul>&#xd;&#xa;&lt;li>Engineering&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;li>Manufacturing&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;li>Pharmacy Solutions&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;li>Purchasing&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;li>Quality&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;li>Science &amp;amp; Technology&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;li>Supply Chain&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <item_1670707208042
                                    cq:panelTitle="Research and Development "
                                    cq:styleIds="[1659545825678]"
                                    jcr:lastModified="{Date}2024-05-08T12:12:51.980-04:00"
                                    jcr:lastModifiedBy="ABDELAX6"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Verschiebe Grenzen in der Forschung &amp;amp; Entwicklung von Arzneimitteln und Lösungen und stelle sicher, dass unsere Produkte und Verfahren höchsten regulatorischen Standards entsprechen.&lt;/p>&#xd;&#xa;&lt;p>Unsere Funktionen bei R&amp;amp;D:&lt;/p>&#xd;&#xa;&lt;ul>&#xd;&#xa;&lt;li>Analytical Research &amp;amp; Development&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;li>Chemistry, Manufacturing &amp;amp; Controls (CMC)&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;li>Data &amp;amp; Statistical Sciences (DSS)&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;li>Discovery&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;li>Global Labeling, Advertising &amp;amp; Promotion&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;li>Global Medical Affairs&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;li>Global Product Strategy&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;li>Pharmaceutical Development&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;li>Pharmacovigilance&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;li>Pharmacology&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;li>Quality Assurance&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;li>Regulatory Operations, Policy &amp;amp; Intelligence&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;"
                                    textIsRich="true"/>
                            </accordion>
                        </par_13>
