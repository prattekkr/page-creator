                            jcr:lastModifiedBy="WINTELX"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>Alle aktuellen Praktikums- und Werkstudent*innenstellen findest du in&amp;nbsp;&lt;a title=&quot;Stellenangebote&quot; href=&quot;https://careers.abbvie.com/de/&quot; target=&quot;_blank&quot;>unserem Jobportal&lt;/a>.&lt;/p>&#xd;&#xa;"
