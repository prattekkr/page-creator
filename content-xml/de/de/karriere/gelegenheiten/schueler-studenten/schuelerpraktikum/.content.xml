                                    jcr:createdBy="singarx"
                                    jcr:lastModified="{Date}2026-07-16T09:30:53.530-04:00"
                                    jcr:lastModifiedBy="LENNIAM"
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="So bewirbst du dich"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    langAttribute="none"
                                    type="h2"
                                    variant="noh"/>
                                <text_385847365_copy__752700296
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2024-10-23T07:27:10.441-04:00"
                                    jcr:createdBy="singarx"
                                    jcr:lastModified="{Date}2026-07-20T02:40:47.404-04:00"
                                    jcr:lastModifiedBy="LENNIAM"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    langAttribute="none"
                                    text="&lt;p>Du möchtest dein Schülerpraktikum bei AbbVie absolvieren? Dann sende uns deine Bewerbung direkt an &lt;a href=&quot;TalentAcquisition.de@abbvie.com&quot; target=&quot;_blank&quot;>TalentAcquisition.de@abbvie.com&lt;/a>.&lt;/p>&#xd;&#xa;&lt;p>Bitte lade folgende Unterlagen hoch:&lt;/p>&#xd;&#xa;&lt;ul>&#xd;&#xa;&lt;li>&lt;b>Anschreiben:&lt;/b> Erzähle uns kurz etwas über dich, warum du dich für ein Praktikum bei AbbVie interessierst und welches Berufsfeld dich besonders interessiert. Gib bitte außerdem deinen gewünschten Praktikumszeitraum an.&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;li>&lt;b>Lebenslauf:&lt;/b> Mit deinen aktuellen Kontaktdaten sowie Informationen zu deiner Schule und bisherigen Erfahrungen.&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;li>&lt;b>Praktikumsbestätigung:&lt;/b> Eine Bescheinigung deiner Schule über das geplante Pflichtpraktikum.&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <separator_1840982084_384514209
                                    cq:styleIds="[1662756486159]"
                                    jcr:created="{Date}2024-10-24T01:23:44.183-04:00"
