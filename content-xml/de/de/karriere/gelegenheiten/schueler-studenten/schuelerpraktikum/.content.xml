                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    langAttribute="none"
                                    text="&lt;ul>&#xd;&#xa;&lt;li>Dauer: 1–2 Wochen&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;li>Voraussetzung: Ein Schülerpraktikum im Rahmen einer schulischen Pflichtveranstaltung&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;li>Nachweis: Vorlage einer Schulbescheinigung bzw. Praktikumsbestätigung durch die Schule&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <separator_1840982084_1034411549
                                    cq:styleIds="[1662756486159]"
                                    jcr:created="{Date}2024-10-24T01:23:44.183-04:00"
