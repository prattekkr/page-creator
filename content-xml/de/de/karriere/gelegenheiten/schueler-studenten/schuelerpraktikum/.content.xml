                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="Dein erster Schritt in die Berufswelt"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    langAttribute="none"
                                    type="h4"
                                    variant="noh"/>
                                <text_385847365_copy__106907281
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2024-10-23T07:27:10.441-04:00"
                                    jcr:createdBy="singarx"
                                    jcr:lastModified="{Date}2026-07-16T09:15:17.244-04:00"
                                    jcr:lastModifiedBy="LENNIAM"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    langAttribute="none"
                                    text="&lt;p>Ein Schülerpraktikum bei AbbVie ist mehr als nur ein Blick hinter die Kulissen: Es ist deine Chance, neue Perspektiven zu entdecken, Fragen zu stellen und herauszufinden, welcher Weg zu dir passt.&lt;/p>&#xd;&#xa;&lt;p>Wir freuen uns darauf, dich kennenzulernen!&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
