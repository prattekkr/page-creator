                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;sup>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-26-reg&quot;>Wir freuen uns über Bewerbungen für unsere Trainee- und Entwicklungsprogramme. Aktuelle Stellenausschreibungen findest du im&amp;nbsp;&lt;a href=&quot;https://careers.abbvie.com/de/&quot; title=&quot;AbbVie-Stellenportal&quot; target=&quot;_blank&quot;>AbbVie-Stellenportal&lt;/a>. Bei Fragen erreichst du uns über&amp;nbsp;&lt;a href=&quot;mailto:TalentAcquisition.de@abbvie.com&quot; title=&quot;Mail an Talent Acquisition&quot;>TalentAcquisition.de@abbvie.com&lt;/a>.&lt;/span>&lt;/span>&lt;/sup>&lt;/p>&#xd;&#xa;"
