                            langAttribute="none"
                            type="h3"
                            variant="h"/>
                        <text_copy_copy_copy
                            cq:styleIds="[1659545825678]"
                            jcr:created="{Date}2024-10-23T05:24:22.435-04:00"
                            jcr:createdBy="singarx"
                            jcr:lastModified="{Date}2026-08-07T05:46:39.578-04:00"
                            jcr:lastModifiedBy="kunkefx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            langAttribute="none"
                            text="&lt;p>Wir bieten Student*innen vielfältige Möglichkeiten, praktische Erfahrungen zu sammeln und erste Einblicke in die Berufswelt zu gewinnen. Ob im Rahmen eines Praktikums, einer Werkstudententätigkeit oder einer Abschlussarbeit – bei uns können Studierende ihr Wissen aus dem Studium anwenden und wertvolle Praxiserfahrung sammeln. Darüber hinaus bieten wir auch Möglichkeiten für Pharmaziepraktika sowie Ferienhelfertätigkeiten an.&lt;/p>&#xd;&#xa;&lt;ul>&#xd;&#xa;&lt;li>&lt;a title=&quot;Zur Seite&quot; href=&quot;/content/abbvie-com2/de/de/karriere/gelegenheiten/schueler-studenten/praktikum.html&quot;>Praktikum, Werkstudententätigkeit und Abschlussarbeit&lt;/a>&lt;/li>&#xd;&#xa;&lt;li>&lt;a title=&quot;Zur Seite&quot; href=&quot;/content/abbvie-com2/de/de/karriere/gelegenheiten/schueler-studenten/pharmaziepraktikum.html&quot;>Pharmaziepraktikum&lt;/a>&lt;/li>&#xd;&#xa;&lt;li>&lt;a title=&quot;Zur Seite&quot; href=&quot;/content/abbvie-com2/de/de/karriere/gelegenheiten/schueler-studenten/ferienhelfer.html&quot;>Ferienhelfer*innen&lt;/a>&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;"
                            textIsRich="true"/>
