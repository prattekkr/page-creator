                            langAttribute="none"
                            type="h3"
                            variant="h"/>
                        <text_copy_copy
                            cq:styleIds="[1659545825678]"
                            jcr:created="{Date}2024-10-23T05:24:22.435-04:00"
                            jcr:createdBy="singarx"
                            jcr:lastModified="{Date}2026-08-07T05:46:18.924-04:00"
                            jcr:lastModifiedBy="kunkefx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            langAttribute="none"
                            text="&lt;p>Wir legen großen Wert darauf, unsere Mitarbeiter*innen selbst auszubilden und junge Talente frühzeitig zu fördern. Deshalb bietet AbbVie in Deutschland vielfältige Einstiegsmöglichkeiten für Schüler*innen – von Schüler*innenpraktika und Tätigkeiten als Ferienhelfer*in über eine Ausbildung bis hin zu einem dualen Studium. So können erste berufliche Erfahrungen gesammelt und der Grundstein für eine erfolgreiche Zukunft gelegt werden.&lt;/p>&#xd;&#xa;&lt;ul>&#xd;&#xa;&lt;li>&lt;a title=&quot;Zur Seite&quot; href=&quot;/content/abbvie-com2/de/de/karriere/gelegenheiten/schueler-studenten/duale-ausbildung.html&quot;>Ausbildung&lt;/a>&lt;/li>&#xd;&#xa;&lt;li>&lt;a title=&quot;Zur Seite&quot; href=&quot;/content/abbvie-com2/de/de/karriere/gelegenheiten/schueler-studenten/duales-studium.html&quot;>Duales Studium&lt;/a>&lt;/li>&#xd;&#xa;&lt;li>&lt;a title=&quot;Zur Seite&quot; href=&quot;/content/abbvie-com2/de/de/karriere/gelegenheiten/schueler-studenten/schuelerpraktikum.html&quot;>Schüler*innenpraktikum&lt;/a>&lt;/li>&#xd;&#xa;&lt;li>&lt;a title=&quot;Zur Seite&quot; href=&quot;/content/abbvie-com2/de/de/karriere/gelegenheiten/schueler-studenten/ferienhelfer.html&quot;>Ferienhelfer*innen&lt;/a>&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;"
                            textIsRich="true"/>
                        <separator_1840982084
                            cq:styleIds="[1662756486159]"
                            jcr:created="{Date}2024-10-24T01:23:44.183-04:00"
