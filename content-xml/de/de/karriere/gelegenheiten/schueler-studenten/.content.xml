                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            langAttribute="none"
                            text="&lt;p>Starte deine Karriere mit vielfältigen Möglichkeiten, dein Wissen einzubringen, neue Perspektiven zu entdecken und gemeinsam mit uns Zukunft zu gestalten. Wir bieten Hochschulabsolvent*innen spannende Einstiegsmöglichkeiten – von strukturierten Einstiegsprogrammen bis hin zu wissenschaftlichen Karrierewegen im Rahmen von Ph.D.- und Post-Doc-Programmen.&lt;/p>&#xd;&#xa;&lt;ul>&#xd;&#xa;&lt;li>&lt;a title=&quot;Zur Seite&quot; href=&quot;/content/abbvie-com2/de/de/karriere/gelegenheiten/schueler-studenten/entwicklungsprogramme.html&quot;>Einstiegsprogramme für Hochschulabsolvent*innen&lt;/a>&lt;/li>&#xd;&#xa;&lt;li>&lt;a title=&quot;Zur Seite&quot; href=&quot;/content/abbvie-com2/de/de/karriere/gelegenheiten/schueler-studenten/phd-post-doc.html&quot;>Ph.D. &amp;amp; Post-Doc&lt;/a>&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;&lt;ul>&#xd;&#xa;&lt;/ul>&#xd;&#xa;"
                            textIsRich="true"/>
