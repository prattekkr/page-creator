                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    langAttribute="none"
                                    text="&lt;ul>&#xd;&#xa;&lt;li>Dauer: 4–12 Wochen&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;li>Voraussetzung: Mindestalter 18 Jahre&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;li>Nachweis: Vorlage einer Schulbescheinigung oder Immatrikulationsbescheinigung&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;li>Einsatzbereiche: Produktion, Logistik und Verwaltung (abhängig vom Bedarf und den verfügbaren Einsatzmöglichkeiten)&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;"
                                    textIsRich="true"/>
