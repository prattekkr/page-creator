                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    langAttribute="none"
                                    text="&lt;ul>&#xd;&#xa;&lt;li>Sammle wertvolle Berufserfahrung und erweitere deine persönlichen Fähigkeiten.&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;li>Lerne verschiedene Arbeitsbereiche eines internationalen Unternehmens kennen.&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;li>Knüpfe Kontakte zu Mitarbeitenden und Teams aus unterschiedlichen Fachrichtungen.&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;li>Gewinne Orientierung für deine berufliche Zukunft und mögliche Karrierewege.&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <separator_1840982084_1240306358
