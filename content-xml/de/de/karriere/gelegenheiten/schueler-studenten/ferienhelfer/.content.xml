                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="Das erwartet dich bei deinem Ferienjob"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    langAttribute="none"
                                    type="h2"
                                    variant="noh"/>
                                <text_385847365_copy__1365701980
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2024-10-23T07:27:10.441-04:00"
                                    jcr:createdBy="singarx"
                                    jcr:lastModified="{Date}2026-07-16T08:39:07.606-04:00"
                                    jcr:lastModifiedBy="LENNIAM"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    langAttribute="none"
                                    text="&lt;ul>&#xd;&#xa;&lt;li>&lt;b>Praktische Mitarbeit:&lt;/b> Du unterstützt unsere Teams bei vielfältigen Aufgaben in Produktion, Logistik oder Verwaltung und erhältst Einblicke in industrielle und organisatorische Prozesse.&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;li>&lt;b>Einblick in ein internationales Unternehmen:&lt;/b> Erlebe, wie ein globales Pharmaunternehmen arbeitet und wie verschiedene Bereiche zusammenwirken, um wichtige Lösungen für Patient*innen weltweit zu entwickeln.&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;li>&lt;b>Strukturierte Einarbeitung:&lt;/b> Wir bereiten dich auf deine Aufgaben vor und begleiten dich während deines Einsatzes, damit du dich schnell in deinem Arbeitsbereich zurechtfindest.&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;li>&lt;b>Klare Aufgaben und Verantwortung:&lt;/b> Du erhältst definierte Tätigkeiten und kannst deine Fähigkeiten in einem professionellen Arbeitsumfeld einbringen.&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;li>&lt;b>Faire Rahmenbedingungen:&lt;/b> Dich erwarten eine angemessene Vergütung sowie geregelte Arbeitszeiten für eine gute Vereinbarkeit mit deiner Ferienplanung.&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <separator_1840982084_1797044723
                                    cq:styleIds="[1662756486159]"
                                    jcr:created="{Date}2024-10-24T01:23:44.183-04:00"
                                    jcr:createdBy="singarx"
