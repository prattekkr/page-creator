                            type="h3"
                            variant="h"/>
                        <text_414741925
                            cq:styleIds="[1659545825678]"
                            jcr:created="{Date}2024-07-11T16:21:36.317-04:00"
                            jcr:createdBy="jewitca"
                            jcr:lastModified="{Date}2026-02-11T07:30:27.209-05:00"
                            jcr:lastModifiedBy="autzeax"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>Das Medical Information-Team von&amp;nbsp;AbbVie&amp;nbsp;steht dir für medizinische Anfragen zu unseren Arzneimitteln und Medizinprodukten zur Verfügung.&lt;/p>&#xa;&lt;p>Telefonisch erreichst du uns unter der Telefonnummer&amp;nbsp;0611-1720-1520.&lt;/p>&#xa;&lt;p>Gern kannst du deine Fragen auch per E-Mail an &lt;a href=&quot;mailto:medinfo.germany@abbvie.com&quot;>medinfo.germany@abbvie.com&lt;/a> senden oder über unser Medical Information-Portal unter &lt;a href=&quot;https://www.abbviemedinfo.com/&quot; target=&quot;_blank&quot; title=&quot;Zur Website medinfo&quot;>www.abbviemedinfo.com&lt;/a> an uns übermitteln. Angehörige medizinischer Fachkreise haben zudem die Möglichkeit, auf dem Portal selbst medizinische Informationen zu AbbVie-Arzneimitteln zu recherchieren.&lt;/p>&#xa;&lt;p>Nicht-Angehörige von medizinischen Fachkreisen (beispielsweise Patient*innen, deren Verwandte etc.) bitten wir um Verständnis, dass ihre Fragen ausschließlich im Rahmen des Heilmittelwerbegesetzes beantwortet werden dürfen. Bei weiterführenden Fragen müssen wir dich bitten, deine behandelnde Ärztin / deinen behandelnden Arzt zu kontaktieren.&lt;/p>&#xa;"
                            textIsRich="true"/>
                        <separator_copy
