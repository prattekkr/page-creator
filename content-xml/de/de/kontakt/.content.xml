                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>Auftragsbearbeitung:&lt;br>&#xd;&#xa;E-Mail:&amp;nbsp;&lt;a href=&quot;mailto:orders.eu@abbvie.com&quot; title=&quot;E-Mail an die Auftragsbearbeitung&quot;>orders.eu@abbvie.com&lt;/a>&lt;br>&#xd;&#xa;Fax: +49 211 975 696 06&lt;/p>&#xd;&#xa;&lt;p>Customer Service Pharma:&lt;br>&#xd;&#xa;E-Mail:&amp;nbsp;&lt;a href=&quot;mailto:kundenservice@abbvie.com&quot; title=&quot;E-Mail an den Kundenservice&quot;>kundenservice@abbvie.com&lt;/a>&lt;br>&#xd;&#xa;Tel.: +49 611 1720 1876&lt;br>&#xd;&#xa;Fax: +49 611 1720 2100&lt;/p>&#xd;&#xa;&lt;p>Customer Service Aesthetics:&lt;br>&#xd;&#xa;Tel.: +49 611 1720 2230&lt;br>&#xd;&#xa;Fax: +49 611 1720 2240,&lt;br>&#xd;&#xa;E-Mail:&amp;nbsp;&lt;a href=&quot;mailto:cs-germany@abbvie.com&quot;>cs-germany@abbvie.com&lt;/a>&lt;/p>&#xd;&#xa;&lt;p>&lt;a href=&quot;/content/dam/abbvie-com2/de/documents/retourenregelung-oeffentliche-apotheken.pdf&quot; target=&quot;_blank&quot; title=&quot;PDF Retourenregelung&quot;>Retourenregelung&lt;/a>&lt;/p>&#xd;&#xa;"
