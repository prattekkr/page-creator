                                    jcr:title="Wir bauen auf unserem langjährigen Einsatz für den Erhalt und den Schutz der Sehkraft auf"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h2"
                                    variant="h"/>
                                <text2_copy
                                    cq:styleIds="[1659545825678,1659545835858]"
