                                jcr:lastModified="{Date}2024-09-26T01:24:54.702-04:00"
                                jcr:lastModifiedBy="jewitca"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Eine chronische Infektion mit dem Hepatitis-C-Virus kann unbehandelt bleibende Leberschäden verursachen. Rund 58 Millionen Menschen weltweit haben Hepatitis C. Dank der Forschung und moderner Therapien kann die Erkrankung inzwischen bei nahezu jedem Patienten schnell und gut verträglich geheilt werden.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
