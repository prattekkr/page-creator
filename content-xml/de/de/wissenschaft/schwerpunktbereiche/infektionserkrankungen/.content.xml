                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>Infektionserkrankungen können auf vielfältige Weise übertragen werden. Auch die Patientengruppen sind oft sehr unterschiedlich. Wenn aber bestimmte Virusinfektionen frühzeitig entdeckt werden, sind sie heutzutage gut behandel- oder sogar heilbar.&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
