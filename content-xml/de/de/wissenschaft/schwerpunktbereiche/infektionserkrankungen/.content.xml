                                jcr:lastModified="{Date}2024-09-26T01:25:20.179-04:00"
                                jcr:lastModifiedBy="jewitca"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Als HIV wird die Ansteckung mit dem Humanen Immundefizienz-Virus (HIV oder HI-Virus) bezeichnet. Mit modernen Medikamenten kann eine HIV-Infektion heute gut behandelt werden. Bei frühzeitiger Diagnose und Therapie haben HIV-positive Menschen inzwischen eine vergleichbare Lebenserwartung wie die Allgemeinbevölkerung.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                        </par_12>
