                    <container_1625694995
                        cq:styleIds="[1653545825687,1653545847150,1653242825678,1653545835982]"
                        jcr:created="{Date}2024-12-13T07:25:15.727-05:00"
                        jcr:createdBy="kunkefx"
                        jcr:lastModified="{Date}2024-12-13T07:29:51.286-05:00"
                        jcr:lastModifiedBy="kunkefx"
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="abbvie-com2/components/container/v2/container">
                        <title2
                            cq:styleIds="[1659545825678,1651545824678]"
                            jcr:lastModified="{Date}2025-01-27T13:47:50.585-05:00"
                            jcr:lastModifiedBy="kunkefx"
                            jcr:primaryType="nt:unstructured"
                            jcr:title="Forschungs­schwerpunkte"
                            sling:resourceType="abbvie-com2/components/title/v2/title"
                            type="h3"
                            variant="h"/>
                        <text2
                            cq:styleIds="[1659545825678,1659545835858]"
                            jcr:lastModified="{Date}2024-12-04T05:08:52.530-05:00"
                            jcr:lastModifiedBy="WINTELX"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>Wir konzentrieren uns auf die Entwicklung zielgerichteter Medikamente. Unsere Forschungsschwerpunkte sind u. a.:&lt;/p>&#xd;&#xa;&lt;ul>&#xd;&#xa;&lt;li>Identifizierung, gezieltes Ansteuern und Hemmung von Mechanismen, die das Überleben und die Vermehrung von Tumorzellen ermöglichen.&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;&lt;ul>&#xd;&#xa;&lt;li>Verstärkter Einsatz von Antikörper-Wirkstoff-Konjugaten (antibody drug conjugates, ADCs), mit denen Wirkstoffe zielgerichtet in Krebszellen eingeschleust und hochwirksame Toxine in den Zellen freigesetzt werden.&lt;br>&#xd;&#xa;&lt;br>&#xd;&#xa;&lt;/li>&#xd;&#xa;&lt;li>Entwicklung neuer Technologien zur Verbesserung der Wirksamkeit bispezifischer Antikörper bei der Behandlung sowohl solider Tumoren als auch Blutkrebserkrankungen.&amp;nbsp;&amp;nbsp;&lt;br>&#xd;&#xa;&lt;br>&#xd;&#xa;&lt;/li>&#xd;&#xa;&lt;li>Innovationen bei der Entwicklung von proteinabbauenden Wirkstoffen, die an ein Zielprotein binden und dessen proteasomalen Abbau auslösen.&lt;br>&#xd;&#xa;&lt;br>&#xd;&#xa;&lt;/li>&#xd;&#xa;&lt;li>Entwicklung von CAR-T-Zell-Therapien, bei denen die Krebserkrankung mithilfe von gesunden Spenderimmunzellen bekämpft wird, die so verändert wurden, dass sie Tumorzellen angreifen und zerstören. Dabei sind sie resistent gegen die Abstoßung durch das menschliche Immunsystem.&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;"
                            textIsRich="true"/>
                        <separator_copy_copy
                            cq:styleIds="[1662756486159]"
                            jcr:created="{Date}2022-12-17T17:44:26.640-05:00"
                            jcr:createdBy="chiucx"
                            jcr:lastModified="{Date}2022-12-17T17:44:26.640-05:00"
                            jcr:lastModifiedBy="chiucx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                        <title2_814190477
                            cq:styleIds="[1659545825678,1651545824678]"
                            jcr:lastModified="{Date}2024-12-04T07:01:57.409-05:00"
                            jcr:lastModifiedBy="WINTELX"
                            jcr:primaryType="nt:unstructured"
                            jcr:title="Schwerpunktbereiche in der Onkologie"
                            sling:resourceType="abbvie-com2/components/title/v2/title"
                            type="h4"
                            variant="h"/>
                        <text2_1647923798
                            cq:styleIds="[1659545825678,1659545835858]"
                            jcr:lastModified="{Date}2024-12-04T07:03:06.479-05:00"
                            jcr:lastModifiedBy="WINTELX"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>Unser Ziel ist es, Lösungen zu finden, die die Behandlung von Krebserkrankungen revolutionieren und somit die Grenzen der Krebstherapie verschieben. Wir suchen nach Medikamenten, mit einer besseren und länger anhaltenden Wirksamkeit und gleichzeitig verbesserten Verträglichkeit bei Blutkrebs und soliden Tumoren. Unsere Neugier treibt uns an, hierbei neue Wege zu beschreiten.&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
                        <separator
                            cq:styleIds="[1662756486159]"
                            jcr:created="{Date}2022-12-18T09:01:55.660-05:00"
                            jcr:createdBy="chiucx"
                            jcr:lastModified="{Date}2022-12-18T09:01:55.660-05:00"
                            jcr:lastModifiedBy="chiucx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                        <title2_copy
                            cq:styleIds="[1659545825678,1651545824678]"
                            jcr:lastModified="{Date}2024-12-04T07:02:22.799-05:00"
                            jcr:lastModifiedBy="WINTELX"
                            jcr:primaryType="nt:unstructured"
                            jcr:title="Blutkrebs"
                            sling:resourceType="abbvie-com2/components/title/v2/title"
                            type="h4"
                            variant="h"/>
                        <text2_copy
                            cq:styleIds="[1659545825678,1659545835858]"
                            jcr:lastModified="{Date}2024-12-04T07:02:57.646-05:00"
                            jcr:lastModifiedBy="WINTELX"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>Blutkrebs ist eine Erkrankung, die sich auf das blutbildende Gewebe (z. B. Knochenmark) auswirkt. Leukämie, Lymphome und Myelome sind die am häufigsten beobachteten Formen von Blutkrebs.&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
                        <separator_165917366
                            cq:styleIds="[1662756423318]"
                            jcr:created="{Date}2022-12-18T09:21:43.017-05:00"
                            jcr:createdBy="chiucx"
                            jcr:lastModified="{Date}2022-12-18T09:21:43.017-05:00"
                            jcr:lastModifiedBy="chiucx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                        <accordion_copy_copy
                            cq:styleIds="[1,1653545835881]"
                            jcr:created="{Date}2022-12-17T16:25:09.442-05:00"
                            jcr:createdBy="chiucx"
                            jcr:lastModified="{Date}2024-09-26T01:08:46.943-04:00"
                            jcr:lastModifiedBy="jewitca"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/accordion/v2/accordion"
                            headingElement="h5"
                            singleExpansion="false">
                            <item_1671312472873
                                cq:panelTitle="Akute myeloische Leukämie (AML) "
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2024-12-04T07:03:52.298-05:00"
                                jcr:lastModifiedBy="WINTELX"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>AML ist eine der aggressivsten und am schwierigsten zu behandelnden Blutkrebserkrankungen, mit einer sehr niedrigen Überlebensrate und nur wenigen Behandlungsoptionen für Patient*innen, die nicht für eine intensive Chemotherapie infrage kommen.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <item_1671312475801
                                cq:panelTitle="Akute lymphatische Leukämie (ALL) "
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2024-12-04T07:04:03.553-05:00"
                                jcr:lastModifiedBy="WINTELX"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Eine ALL entsteht, wenn das Knochenmark zu viele unreife Lymphozyten – eine Art weißer Blutzellen – produziert. Es ist die häufigste Krebsart bei Kindern.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <item_1671312481387
                                cq:panelTitle="Chronische lymphatische Leukämie (CLL)"
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2024-12-04T07:04:17.216-05:00"
                                jcr:lastModifiedBy="WINTELX"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Bei CLL handelt es sich um eine langsam fortschreitende Blutkrebsart, bei der das Knochenmark zu viele Lymphozyten – eine Art weißer Blutzellen – produziert.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <item_1671372277563
                                cq:panelTitle="Diffuses großzelliges BZell-Lymphom (DLBCL) "
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2024-12-04T07:04:33.843-05:00"
                                jcr:lastModifiedBy="WINTELX"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Das DLBCL ist weltweit die häufigste Form des Non-Hodgkin-Lymphoms (NHL). Das Auftreten eines DLBCL steigt im Allgemeinen mit zunehmendem Alter; die meisten Patient*innen erhalten die Diagnose im Alter von über 60 Jahren.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <item_1671372296338
                                cq:panelTitle="Mantelzelllymphom (MCL) "
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2024-12-04T07:04:46.474-05:00"
                                jcr:lastModifiedBy="WINTELX"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Das MCL ist eine aggressive Form des NHL und geht aus Zellen hervor, die im Randbereich der Lymphknoten, der sogenannten Mantelzone, entstehen. Das Mantelzell-Lymphom ist mit ca. 1-2 Neuerkrankungen pro 100.000 Einwohner im Jahr in Deutschland relativ selten.&amp;nbsp;&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <item_1671372299968
                                cq:panelTitle="Multiples Myelom (MM) "
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2024-12-04T07:05:01.750-05:00"
                                jcr:lastModifiedBy="WINTELX"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Das MM ist eine Krebserkrankung der Plasmazellen und wird häufig anhand wiederkehrender Zyklen von Rezidiv und Remission kategorisiert. Es ist die zweithäufigste Blutkrebsart.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <item_1671372303344
                                cq:panelTitle="Myelodysplastisches Syndrome (MDS) "
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2024-12-04T07:05:16.272-05:00"
                                jcr:lastModifiedBy="WINTELX"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Beim MDS handelt es sich um eine Gruppe von Erkrankungen des Knochenmarks, die durch eine abnorme Entwicklung von Blutzellen gekennzeichnet sind.&amp;nbsp;&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <item_1671372307389
                                cq:panelTitle="Myelofibrose (MF) "
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2024-12-04T07:05:30.771-05:00"
                                jcr:lastModifiedBy="WINTELX"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>MF ist eine seltene Erkrankung, bei der sich abnormale Blutzellen und fibröses Gewebe im Knochenmark ansammeln.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                        </accordion_copy_copy>
                        <separator_165917366_
                            cq:styleIds="[1662756526578]"
                            jcr:created="{Date}2022-12-18T09:21:43.017-05:00"
                            jcr:createdBy="chiucx"
