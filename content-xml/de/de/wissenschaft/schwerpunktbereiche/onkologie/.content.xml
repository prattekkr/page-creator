                            jcr:lastModifiedBy="chiucx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                        <title2_1194237703
                            cq:styleIds="[1659545825678,1651545824678]"
                            jcr:lastModified="{Date}2024-12-04T07:05:45.524-05:00"
                            jcr:lastModifiedBy="WINTELX"
                            jcr:primaryType="nt:unstructured"
                            jcr:title="Solide Tumoren"
                            sling:resourceType="abbvie-com2/components/title/v2/title"
                            type="h4"
                            variant="h"/>
                        <text2_1534592806
                            cq:styleIds="[1659545825678,1659545835858]"
                            jcr:lastModified="{Date}2024-12-04T07:05:53.735-05:00"
                            jcr:lastModifiedBy="WINTELX"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>Zu den häufigsten soliden Tumoren zählen Karzinome. Diese können sich in fast allen Organen des Körpers entwickeln und werden häufig chirurgisch behandelt. Wir arbeiten daran, neue Behandlungsmöglichkeiten für diese Erkrankungen zu finden.&amp;nbsp;&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
                        <accordion_copy_copy_
                            cq:styleIds="[1,1653545835881]"
                            jcr:created="{Date}2022-12-17T16:25:09.442-05:00"
                            jcr:createdBy="chiucx"
                            jcr:lastModified="{Date}2024-12-04T07:06:45.960-05:00"
                            jcr:lastModifiedBy="WINTELX"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/accordion/v2/accordion"
                            headingElement="h5"
                            singleExpansion="false">
                            <item_1671312472873
                                cq:panelTitle="Ovarialkarzinom"
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2024-12-04T07:07:09.511-05:00"
                                jcr:lastModifiedBy="WINTELX"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Im Jahr 2022 gab es in Deutschland 6.709 Neuerkrankungen mit der Diagnose Ovarialkarzinom. Der Großteil der Patientinnen wird erst im fortgeschrittenen Krankheitsstadium diagnostiziert und erhält in der Regel nach Staging- und Debulking-Operation eine platinbasierte Chemotherapie, gegen die ein großer Teil im Laufe der Zeit eine Resistenz entwickelt. In der Folge ist das Karzinom schwer zu behandeln, da Mono-Chemotherapien eine verminderte Wirksamkeit und Verträglichkeit bei diesen Patientinnen zeigen.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                        </accordion_copy_copy_>
