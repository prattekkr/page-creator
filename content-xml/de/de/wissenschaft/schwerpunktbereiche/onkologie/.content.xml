                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2024-12-04T05:06:23.510-05:00"
                                jcr:lastModifiedBy="WINTELX"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/quote"
                                attributionName="Chris Tse, Ph.D."
                                attributionTitle="Executive Director, Oncology, Discovery Research"
                                quote="„Die technologischen und wissenschaftlichen Fortschritte, die in den letzten zehn Jahren erreicht wurden, ermöglichen es uns, Erkrankungen therapeutisch ganz anders zu adressieren. Es geht nicht nur darum, mit den Trends Schritt zu halten – es geht darum, mutig zu sein und Neues zu wagen, um die Wissenschaft wirklich voranzubringen.&quot;"
                                quoteType="regular"
