                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="Mit Expertise den schwerwiegendsten Krebserkrankungen die Stirn bieten"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h2"
                                    variant="h"/>
                                <text2_1220760296
                                    cq:styleIds="[1659545825678,1659545835858]"
                                    jcr:lastModified="{Date}2024-12-04T05:05:42.469-05:00"
                                    jcr:lastModifiedBy="WINTELX"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Unsere wissenschaftliche Forschung hat zu entscheidenden Fortschritten in der Behandlung von Blutkrebs geführt. Nun nutzen wir unser Wissen auch, um die Behandlung solider Tumoren zu unterstützen. Diese machen mehr als 90 % aller Krebsarten aus.&lt;br>&#xd;&#xa; &lt;br>&#xd;&#xa;Um neue Wege in der Behandlung von Krebserkrankungen gehen zu können, bauen wir auf unser tiefgreifendes Verständnis der menschlichen Biologie und modernste Forschungstechnologien.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <separator_copy
                                    cq:styleIds="[1662756486159]"
                                    jcr:created="{Date}2022-12-17T17:44:26.640-05:00"
                                    jcr:createdBy="chiucx"
