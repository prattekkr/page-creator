                            <container4_copy
                                cq:styleIds="[1653545825687,1653545847150,1653242825678,1653545835982]"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/container/v2/container">
                                <title2
                                    cq:styleIds="[1659545825678,1651545824678]"
                                    jcr:lastModified="{Date}2024-12-04T05:35:20.474-05:00"
                                    jcr:lastModifiedBy="WINTELX"
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="Forschungsschwerpunkte"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h3"
                                    variant="h"/>
                                <text2
                                    cq:styleIds="[1659545825678,1659545835858]"
                                    jcr:lastModified="{Date}2024-12-04T04:45:20.432-05:00"
                                    jcr:lastModifiedBy="WINTELX"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>&lt;b>Im Kampf gegen Erkrankungen des zentralen Nervensystems&lt;/b>&lt;/p>&#xd;&#xa;&lt;p>Wir forschen unter anderem an neuen Therapien gegen Morbus Alzheimer, Morbus Parkinson und Migräne und setzen uns für die Behandlung von Morbus Parkinson im fortgeschrittenen Stadium und Migräne in verschiedenen Ausprägungen ein.&lt;/p>&#xd;&#xa;&lt;p>Mit unserer Forschung wollen wir ein tiefergehendes Verständnis der biologischen Mechanismen erlangen, die neurodegenerativen Erkrankungen zugrunde liegen. An unseren Kompetenzzentren in den USA und in Deutschland – dem ‚Foundational Neuroscience Center‘ in Massachusetts und dem ‚Center of Excellence for Research of Central Nervous System Disorders‘ in Ludwigshafen arbeiten wir an der Entwicklung von Arzneimitteln, die nicht nur die Symptome behandeln, sondern das Fortschreiten der Erkrankung stoppen sollen.&amp;nbsp;&lt;/p>&#xd;&#xa;&lt;p>Unser Ziel ist es, neue therapeutische Ansätze zu entwickeln, die einen echten Unterschied im Leben von Patient*innen machen können. Derzeit prüfen wir eine Reihe von Wirkstoffen in frühen und späteren Phasen der klinischen Entwicklung, die bei Erkrankungen eingesetzt werden könnten, von denen Millionen Menschen weltweit betroffen sind.&amp;nbsp;&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                            </container4_copy>
                            <container4_copy_copy
                                cq:styleIds="[1653545847150,1653242825678,1653545835982,1653545825687]"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/container/v2/container">
                                <title2
                                    cq:styleIds="[1659545825678,1651545824678]"
                                    jcr:lastModified="{Date}2024-11-04T08:36:05.926-05:00"
                                    jcr:lastModifiedBy="MURRARX3"
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="Schwerpunktbereiche in der Neurologie"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h4"
                                    variant="h"/>
                                <text2
                                    cq:styleIds="[1659545825678,1659545835858]"
                                    jcr:lastModified="{Date}2024-12-04T04:45:42.689-05:00"
                                    jcr:lastModifiedBy="WINTELX"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Die Belastung durch neurologische Erkrankungen kann unüberwindbar erscheinen. Aber dieser Eindruck motiviert uns, einige der größten Herausforderungen anzugehen und mögliche Lösungen zu erarbeiten, die den Menschen als Ganzes berücksichtigen.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <separator_165917366
                                    cq:styleIds="[1662756423318]"
                                    jcr:created="{Date}2022-12-18T09:21:43.017-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2022-12-18T09:21:43.017-05:00"
                                    jcr:lastModifiedBy="chiucx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                                <accordion_copy_copy
                                    cq:styleIds="[1,1653545835881]"
                                    jcr:created="{Date}2022-12-17T16:25:09.442-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2024-12-06T07:04:36.416-05:00"
                                    jcr:lastModifiedBy="MURRARX3"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/accordion/v2/accordion"
                                    heading="Schwerpunktbereiche"
                                    headingElement="h5"
                                    singleExpansion="false">
                                    <item_1671372296338
                                        cq:panelTitle="Alzheimer"
                                        cq:styleIds="[1659545825678]"
                                        jcr:lastModified="{Date}2024-12-04T04:49:05.064-05:00"
                                        jcr:lastModifiedBy="WINTELX"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="abbvie-com2/components/text/v2/text"
                                        text="&lt;p>Schätzungen zufolge leben weltweit etwa 50 Millionen Menschen mit einer Demenz. Das schwerwiegendste Symptom ist ein massiv verschlechtertes Denk- und Erinnerungsvermögen, das nicht mit dem normalen Alterungsprozess in Zusammenhang steht. Alzheimer ist die häufigste Form einer Demenzerkrankung, mit ihr leben circa 60 bis 70 Prozent aller Betroffenen.&amp;nbsp;&amp;nbsp;&lt;/p>&#xd;&#xa;&lt;p>Auch weit über 100 Jahre nach ihrer Entdeckung gibt die neurodegenerative Erkrankung Wissenschaftlern immer noch Rätsel auf. Morbus Alzheimer kann weder verhindert noch geheilt werden. Mit den derzeit verfügbaren Therapien können Ärzte die Verschlechterung der Symptome vorübergehend verlangsamen. Dadurch kann sich die Lebensqualität der Patient*innen und der Angehörigen verbessern, die sich in der Pflege um sie kümmern.&amp;nbsp;&lt;/p>&#xd;&#xa;&lt;p>Wir arbeiten mit den weltweit führenden Alzheimer-Forscher*innen zusammen und suchen nach Möglichkeiten, die Erkrankung bereits im Frühstadium zu stoppen.&amp;nbsp;&lt;/p>&#xd;&#xa;"
                                        textIsRich="true"/>
                                    <item_1671312472873
                                        cq:panelTitle="Parkinson "
                                        cq:styleIds="[1659545825678]"
                                        jcr:lastModified="{Date}2024-12-04T04:48:23.967-05:00"
                                        jcr:lastModifiedBy="WINTELX"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="abbvie-com2/components/text/v2/text"
                                        text="&lt;p>Nach Alzheimer ist Parkinson die zweithäufigste neurodegenerative Erkrankung weltweit. Es ist eine chronische, also dauerhafte Erkrankung der Nervenzellen in dem Teil des Gehirns, der für die Kontrolle der Bewegungen zuständig ist. Typische Symptome für Parkinson sind Muskelzittern, Verlangsamung der Bewegung, Versteifung der Muskulatur und Gang- oder Gleichgewichtsstörungen. Damit hat Parkinson einen großen Einfluss auf die Lebensqualität. In Deutschland sind weit mehr als 220.000 Personen betroffen, jährlich kommen ca. 15-20.000 hinzu.&amp;nbsp;&amp;nbsp;&lt;/p>&#xd;&#xa;&lt;p>Parkinson kann nicht geheilt werden, ist jedoch gut behandelbar. Die Therapie zielt in erster Linie darauf ab, Krankheitszeichen und Begleiterscheinungen zu lindern. Im fortgeschrittenen Krankheitsstadium oder nach längerer medikamentöser Behandlung kann es sein, dass die Wirkung der bisherigen oralen Therapie nachlässt oder es zu Wirkschwankungen kommt. Wenn dies zutrifft, kann eine adäquate kontinuierliche Therapie angezeigt sein, um die Lebensqualität der Betroffenen positiv zu beeinflussen.&lt;/p>&#xd;&#xa;"
                                        textIsRich="true"/>
                                    <item_1671312475801
                                        cq:panelTitle="Migräne "
                                        cq:styleIds="[1659545825678]"
                                        jcr:lastModified="{Date}2024-12-04T04:49:39.895-05:00"
                                        jcr:lastModifiedBy="WINTELX"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="abbvie-com2/components/text/v2/text"
                                        text="&lt;p>Bei Migräne handelt es sich um eine Krankheit, die durch wiederkehrende Anfälle starker, pochender Kopfschmerzen und belastenden Begleitsymptomen (z.&amp;nbsp;B. Übelkeit, Erbrechen, extreme Licht- und Geräuschempfindlichkeit) gekennzeichnet ist.&amp;nbsp;&lt;/p>&#xd;&#xa;&lt;p>Diese gut voneinander abgrenzbaren Kopfschmerzattacken werden auch Episoden genannt. Wird die Migräne immer häufiger und geht eine Migräneattacke nahezu ohne Pause in die nächste über, kann aus der episodischen Migräne eine chronische Migräne werden.&amp;nbsp;Patient*innen mit chronischer Migräne leiden an 15 oder mehr Tagen pro Monat an Kopfschmerzen, davon an 8 Tagen an den typischen Begleitsymptomen einer Migräne.&lt;/p>&#xd;&#xa;&lt;p>Migräne liegt weltweit auf Platz&amp;nbsp;6 der am stärksten beeinträchtigenden Erkrankungen und betrifft über eine Milliarde Menschen auf der ganzen Welt. Die Erkrankung kann einen negativen Einfluss auf alle Aspekte des Lebens haben wie auf die physische (Schmerz) und mentale Gesundheit (Depressionen, Angst- und Schlafstörungen) und negativen Einfluss auf Beziehungen, Karriere und finanzielle Situation ausüben.&amp;nbsp;&lt;/p>&#xd;&#xa;"
                                        textIsRich="true"/>
                                    <item_1730731876825
                                        cq:panelTitle="Spastik nach Schlaganfall"
                                        cq:styleIds="[1659545825678]"
                                        jcr:lastModified="{Date}2024-12-04T04:49:56.329-05:00"
                                        jcr:lastModifiedBy="WINTELX"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="abbvie-com2/components/text/v2/text"
                                        text="&lt;p>Spastik ist eine Form von Bewegungsstörung. Bei manchen Patient*innen tritt nach einem Schlaganfall Spastizität in den Händen, Handgelenken, Armen oder sogar in den Beinen auf. Als Folge bleiben die Muskeln kontrahiert, was Schmerzen, Einschränkungen der Beweglichkeit und schwere Beeinträchtigungen der Fähigkeiten der Patient*innen zur unabhängigen Durchführung täglicher Aktivitäten wie dem Ankleiden und der Körperpflege zur Folge haben kann. Zu den charakteristischen Haltungen von an Spastik leidenden Patient*innen zählen das Zusammenballen einer Faust, das Abknicken eines Handgelenks, das Anwinkeln eines Ellbogens oder das Pressen eines Arms gegen die Brust. Pro Jahr erleiden weltweit etwa 12,2 Millionen Menschen einen Schlaganfall. Etwa 3,66 Millionen davon tragen permanente Behinderungen davon.&lt;/p>&#xd;&#xa;"
                                        textIsRich="true"/>
                                    <item_1671312481387
                                        cq:panelTitle="Blepharospasmus"
                                        cq:styleIds="[1659545825678]"
                                        jcr:lastModified="{Date}2024-12-04T04:50:52.198-05:00"
                                        jcr:lastModifiedBy="WINTELX"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="abbvie-com2/components/text/v2/text"
                                        text="&lt;p>Der Blepharospasmus ist eine lokale Bewegungsstörung, bei der die Muskeln zur Kontrolle der Lidbewegung betroffen sind. Diese Krankheit ist durch verstärktes Blinzeln gekennzeichnet, das durch unwillkürliche Spasmen der für den Lidschluss verantwortlichen Muskeln verursacht wird.&amp;nbsp;&amp;nbsp;&lt;/p>&#xd;&#xa;"
                                        textIsRich="true"/>
                                    <item_1671372277563
                                        cq:panelTitle="Hemifazialer Spasmus "
                                        cq:styleIds="[1659545825678]"
                                        jcr:lastModified="{Date}2024-12-04T04:51:27.306-05:00"
                                        jcr:lastModifiedBy="WINTELX"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="abbvie-com2/components/text/v2/text"
                                        text="&lt;p>Als hemifazialer Spasmus wird eine neuromuskuläre Erkrankung bezeichnet, die durch unvorhersehbare und unwillkürliche Zuckungen von Gesichtsmuskeln einer Gesichtshälfte gekennzeichnet ist.&lt;/p>&#xd;&#xa;"
                                        textIsRich="true"/>
                                    <item_1733305904675
                                        cq:panelTitle="Infantile Zerebralparese "
                                        cq:styleIds="[1659545825678]"
                                        jcr:lastModified="{Date}2024-12-04T04:54:56.620-05:00"
                                        jcr:lastModifiedBy="WINTELX"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="abbvie-com2/components/text/v2/text"
                                        text="&lt;p>Als infantile Zerebralparese wird eine Gruppe von Bewegungs-, Gleichgewichts- oder Haltungsstörungen bei Kindern bezeichnet. Ausgelöst werden sie durch eine Verletzung oder Läsion/Schädigung von Gehirnbereichen, welche die Muskeln, den Gleichgewichtssinn und willkürliche Bewegungen steuern.&lt;/p>&#xd;&#xa;"
                                        textIsRich="true"/>
                                    <item_1733305914352
                                        cq:panelTitle="Zervikale Dystonie "
                                        cq:styleIds="[1659545825678]"
                                        jcr:lastModified="{Date}2024-12-04T04:55:37.763-05:00"
                                        jcr:lastModifiedBy="WINTELX"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="abbvie-com2/components/text/v2/text"
                                        text="&lt;p>Als Dystonie wird eine Gruppe von Krankheiten bezeichnet, die ein unwillkürliches Zucken, Spasmen oder Bewegungen von Muskeln einschließen. Die zervikale Dystonie betrifft den Hals, wodurch der Kopf nur noch unter Schwierigkeiten gerade hochgehalten werden kann. Die Halsmuskeln verkrampfen und bewirken ein Ziehen, Verdrehen, Rucken oder Kippen des Kopfes in Richtung der Schulter. Darüber hinaus kann die Schulter in Richtung des abgewinkelten Kopfes angehoben sein. &lt;/p>&#xd;&#xa;"
                                        textIsRich="true"/>
                                    <item_1733305921868
                                        cq:panelTitle="Überaktive Blase "
                                        cq:styleIds="[1659545825678]"
                                        jcr:lastModified="{Date}2024-12-04T04:56:09.035-05:00"
                                        jcr:lastModifiedBy="WINTELX"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="abbvie-com2/components/text/v2/text"
                                        text="&lt;p>Die als „überaktive Blase“ bezeichnete Krankheit ist bei Erwachsenen die häufigste Ursache für Harninkontinenz oder Harnverlust. Bei den weitaus meisten Patient*innen ist die zugrundeliegende Ursache für die überaktive Blase unbekannt.&lt;/p>&#xd;&#xa;"
                                        textIsRich="true"/>
                                    <item_1733305929598
                                        cq:panelTitle="Neurogene Detrusor- (Blasen-) Hyperaktivität "
                                        cq:styleIds="[1659545825678]"
                                        jcr:lastModified="{Date}2024-12-04T04:56:30.974-05:00"
                                        jcr:lastModifiedBy="WINTELX"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="abbvie-com2/components/text/v2/text"
                                        text="&lt;p>Nervenkrankheiten wie beispielsweise Multiple Sklerose (MS) oder eine Rückenmarksverletzung können Blasenfunktionsstörungen verursachen. Der Blasenmuskel (Detrusor) ist hier aufgrund einer Nervenschädigung „außer Kontrolle“ und zieht sich unwillkürlich zusammen.&amp;nbsp;&lt;/p>&#xd;&#xa;"
                                        textIsRich="true"/>
                                    <item_1733305940787
                                        cq:panelTitle="Hyperhidrose "
                                        cq:styleIds="[1659545825678]"
                                        jcr:lastModified="{Date}2024-12-04T04:56:45.609-05:00"
                                        jcr:lastModifiedBy="WINTELX"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="abbvie-com2/components/text/v2/text"
                                        text="&lt;p>Hyperhidrose ist eine Krankheit, bei der man über das normale, zur Beibehaltung einer gleichbleibenden Körpertemperatur erforderliche Maß hinaus schwitzt.&amp;nbsp;&amp;nbsp;&lt;/p>&#xd;&#xa;"
                                        textIsRich="true"/>
                                </accordion_copy_copy>
