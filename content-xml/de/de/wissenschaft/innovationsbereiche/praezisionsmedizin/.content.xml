                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2024-05-13T05:19:11.262-04:00"
                                    jcr:lastModifiedBy="NANDIVX5"
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title=" Geschickt vorgehen, um die Patient*innen schneller mit Arzneimitteln zu versorgen "
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h2"
                                    variant="h"/>
                                <text_copy_copy
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2022-12-07T14:53:09.069-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2024-05-13T05:19:37.997-04:00"
                                    jcr:lastModifiedBy="NANDIVX5"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Bei AbbVie kommt Präzisionsmedizin im gesamten Portfolio zum Einsatz, um passende Arzneimittel für die richtigen Patient*innen bereitzustellen. Hierbei nutzen wir fortschrittliche Technologien und Datenwissenschaft, um wegweisende Einblicke in den Krankheitsmechanismus und die Heterogenität von Patient*innen zu erlangen. Unsere Erkenntnisse helfen uns dabei, Arzneimittel noch gezielter zu entwickeln, Möglichkeiten für Kombinationen zu erkennen und Patient*innen und ihren Ärzt*innen sinnvolle Diagnosewerkzeuge zur Verfügung zu stellen. Unser erklärtes Ziel ist es, Erkrankungen zu verstehen und uns den zugrundeliegenden Mechanismen bei allen Patient*innen zu widmen.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <separator_copy_141616301
                                    cq:styleIds="[1662756486159]"
                                    jcr:created="{Date}2022-12-17T12:18:10.519-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2022-12-17T12:18:10.519-05:00"
                                    jcr:lastModifiedBy="chiucx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                                <title_copy
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2022-12-17T13:22:39.555-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2024-05-13T05:19:58.584-04:00"
                                    jcr:lastModifiedBy="NANDIVX5"
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="Forschungsinteressen"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h2"
                                    variant="h"/>
                                <text_copy_copy_copy
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2022-12-07T14:53:09.069-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2024-12-02T09:18:05.032-05:00"
                                    jcr:lastModifiedBy="MURRARX3"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>&amp;nbsp;&lt;/p>&#xd;&#xa;&lt;ul>&#xd;&#xa;&lt;li>Wir erweitern und nutzen unser Verständnis der Biomarker bei soliden Tumoren als Grundlage für die Entwicklung von Immuntherapien, zielgerichteten niedermolekularen Inhibitoren und Antikörper-Wirkstoff-Konjugaten (ADCs).&lt;/li>&#xd;&#xa;&lt;li>Wir machen jetzt und auch in Zukunft den Weg frei: Wir bewirken einen echten Unterschied für Patient*innen mit malignen hämatologischen Erkrankungen durch mechanistische Erkenntnisse aus der klinischen Praxis, die als Grundlage für Kombinationstherapien dienen, die Identifizierung prädiktiver Marker, um Patientensegmente zu ermitteln, die auf eine Therapie ansprechen, und die Entwicklung alternativer molekularer Endpunkte, die eine schnellere Durchführung von klinischen Prüfungen ermöglichen.&lt;/li>&#xd;&#xa;&lt;li>Dank modernster Genomik, Gen und Proteomikanalysen, die am Genomics Research Center (GRC) durchgeführt werden, sowie wegweisender Datenwissenschaft und analytik können wir auf neueste Erkenntnisse zu Krankheitsmechanismen zugreifen.&lt;/li>&#xd;&#xa;&lt;li>Entwicklung von therapiebegleitenden Diagnostika und krankheitsspezifischen Gremien, um Patient*innen und ihren Ärzt*innen zu helfen, auf Daten basierende, fundierte Behandlungsentscheidungen zu treffen&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;li>Digitale Pathologie – mehr Präzision bei geringeren Mengen an Gewebe. Fortgeschrittene Analytik ermöglicht beispiellose Einblicke in Erkrankungs und prädiktive Marker.&lt;/li>&#xd;&#xa;&lt;li>Dabei setzen wir Talente aus allen Bereichen von AbbVie ein – von Discovery über GRC bis hin zu Clinical und Medical Affairs – sowie unsere branchenführenden Datensätze aus Biobanken und unseren eigenen klinischen Prüfungsdaten zu verschiedenen Krankheitsgebieten, um die nächste Generation von Arzneimitteln zu entwickeln.&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;&lt;p>&amp;nbsp;&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                            </container_568753235_>
                            <text_copy_copy_copy
