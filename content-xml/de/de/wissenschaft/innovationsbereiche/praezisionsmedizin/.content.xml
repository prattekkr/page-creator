                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="Die richtige Medizin für die richtigen Patient*innen entwickeln "
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h2"
                                    variant="h"/>
                                <text_copy_copy
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2022-12-07T14:53:09.069-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2024-05-13T05:18:48.434-04:00"
                                    jcr:lastModifiedBy="NANDIVX5"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Präzisionsmedizin hat die Diagnose und Behandlung von Krebserkrankungen revolutioniert. Jetzt bringen wir die Prinzipien der Präzisionsmedizin noch weiter voran, um Erkrankungen in den Bereichen Immunologie, Neurologie und Augenheilkunde zu bekämpfen.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <separator
