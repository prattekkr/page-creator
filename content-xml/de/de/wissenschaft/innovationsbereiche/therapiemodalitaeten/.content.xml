                                        jcr:lastModified="{Date}2024-10-28T08:21:44.407-04:00"
                                        jcr:lastModifiedBy="MURRARX3"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="abbvie-com2/components/quote"
                                        attributionName="Jonathon Sedgwick, Ph.D. "
                                        attributionTitle=" VP und Global Head, Discovery Research, AbbVie "
                                        quote="Die Umsetzung einer Entdeckung in ein Arzneimittel ist ein langwieriger Prozess des Ausprobierens und Reflektierens, der viele Jahre in Anspruch nehmen kann. Aber die Neugier nach dem Unbekannten und der Wissensdurst begeistern uns und treiben uns an. "
