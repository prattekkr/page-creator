                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;body-unica-32-reg&quot;>Unsere Wissenschaftler*innen nutzen umfangreiche Datensätze und untersuchen mehr als eine Million Genome, um neue Wege zu entwickeln, damit wir Erkrankungen besser verstehen und behandeln können.&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
