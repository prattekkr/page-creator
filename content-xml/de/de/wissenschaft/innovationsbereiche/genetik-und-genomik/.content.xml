                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/container/v2/container">
                                <title_116699496
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2022-12-15T11:49:26.700-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2024-12-09T05:56:18.269-05:00"
                                    jcr:lastModifiedBy="WINTELX"
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="Unsere Schwerpunkte sind u. a.: "
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h2"
                                    variant="h"/>
                                <text_copy_copy
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2022-12-07T14:53:09.069-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2024-05-10T06:41:20.574-04:00"
                                    jcr:lastModifiedBy="NANDIVX5"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>&lt;ul>&#xd;&#xa;&lt;li>Verwendung innovativer Genomeditierungssysteme als Bindeglied zwischen Genomik und Biologie&lt;/li>&#xd;&#xa;&lt;li>Nutzung von Computational Biology, um die Integration von Multi-Omics-Daten, maschinelles Lernen und die Charakterisierung der Humanbiologie zu ermöglichen und so Innovation voranzutreiben&lt;/li>&#xd;&#xa;&lt;li>Erforschung seltener Erkrankungen, um neue Targets zu entdecken und/oder zu validieren, die uns letztendlich dabei helfen, individuellere Arzneimittel für Patient*innen zu entwickeln&lt;/li>&#xd;&#xa;&lt;li>Erforschung des Einsatzes vorhandener Arzneimittel für neue Indikationen auf der Grundlage genetischer Hinweise&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;li>Einbindung induzierter pluripotenter Stammzellen (iPSCs) bei der Genomeditierung und Genomik&lt;/li>&#xd;&#xa;&lt;li>Anwendung modernster Plattformen, die mit automatisiertem Wetlab und einer standardisierten Analyse-Pipeline für die Generierung von Hochdurchsatz-Multi-Omics-Daten integriert sind&lt;/li>&#xd;&#xa;&lt;li>Nutzung von u. a. künstlicher Intelligenz/maschinellem Lernen und prädiktiven Modellen für verschiedene Analysen zur Target-Priorisierung, Extraktion von Informationen aus Multi-Omics-Daten, Bildgebung&lt;/li>&#xd;&#xa;&lt;li>Nutzung genetischer Humandaten zur Beschleunigung der Forschung und Entwicklung und zur Verringerung von Fehlerraten&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                            </container_568753235_>
                            <text_copy_copy
