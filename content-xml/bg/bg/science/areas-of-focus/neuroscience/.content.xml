                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="abbvie-com2/components/container/v2/container">
                        <title
                            cq:styleIds="[1659545825678]"
                            jcr:created="{Date}2024-11-29T00:39:33.558-05:00"
                            jcr:createdBy="singarx"
                            jcr:lastModified="{Date}2024-11-29T00:40:19.351-05:00"
                            jcr:lastModifiedBy="singarx"
                            jcr:primaryType="nt:unstructured"
                            jcr:title="Целта ни е да съхраним чувството за собствена идентичност на пациентите    "
                            sling:resourceType="abbvie-com2/components/title/v2/title"
                            type="h4"
                            variant="h"/>
                        <text
                            cq:styleIds="[1659545825678]"
                            jcr:created="{Date}2024-11-29T00:40:25.909-05:00"
                            jcr:createdBy="singarx"
                            jcr:lastModified="{Date}2025-04-24T08:25:36.122-04:00"
                            jcr:lastModifiedBy="NANDIVX5"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>В областта на неврологията, където много заболявания са труднолечими и непосрещнатите нужди са големи, нашите учени са непреклонни в стремежа си да повишат стандарта на лечение. Но мозъкът е сложен орган, а за преодоляване на новите предизвикателства са нужни нови начини на мислене на всеки етап от процеса по откриване и разработване на лекарства.&lt;/p>&#xd;&#xa;&lt;p>Ето защо непрестанно изучаваме иновативни, модифициращи заболяванията, подходи за справяне с някои от най-разпространените и сериозни заболявания – от болест на Паркинсон и болест на Алцхаймер до мигрена, шизофрения и инсулт.&amp;nbsp;&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
                        <separator
                            jcr:created="{Date}2024-11-29T00:41:28.175-05:00"
                            jcr:createdBy="singarx"
                            jcr:lastModified="{Date}2024-11-29T00:41:28.175-05:00"
                            jcr:lastModifiedBy="singarx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                        <quote
                            cq:styleIds="[1000000000000]"
                            jcr:created="{Date}2024-11-29T00:41:37.198-05:00"
                            jcr:createdBy="singarx"
                            jcr:lastModified="{Date}2025-04-24T08:26:38.581-04:00"
                            jcr:lastModifiedBy="NANDIVX5"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/quote"
                            attributionName="Д-р Майкъл Голд "
                            attributionTitle="Вицепрезидент по развойна дейност в областта на неврологията"
                            bgImageModifiers="resMode=sharp2&amp;op_sharpen=1"
                            imageModifiers="resMode=sharp2&amp;op_sharpen=1"
                            quote="Нашите учени са „екипирани“ с любознателност и упоритост и са се заели да правят открития, чрез които да настъпи значима промяна за пациентите. "
                            quoteType="regular"
                            textSize="h0"/>
                        <separator_1719928139
                            jcr:created="{Date}2024-11-29T00:43:48.494-05:00"
