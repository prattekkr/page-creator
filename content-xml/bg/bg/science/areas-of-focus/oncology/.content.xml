                            jcr:createdBy="singarx"
                            jcr:lastModified="{Date}2025-06-09T09:29:59.643-04:00"
                            jcr:lastModifiedBy="singarx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>&lt;span class=&quot;body-unica-20-reg&quot;>Насочили сме усилията си в търсене на отговори, които да променят подхода към лечението на рака. Искаме да постигнем по-добри и по-дълготрайни резултати при всички видове рак на кръвта и солидни туморни образувания. Нашата култура на любознателност ни мотивира да откриваме нови решения.&lt;/span>&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
