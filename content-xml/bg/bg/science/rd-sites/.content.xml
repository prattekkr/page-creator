                            type="h4"
                            variant="h"/>
                        <text_567538806
                            cq:styleIds="[1659545825678]"
                            jcr:created="{Date}2024-12-05T02:07:24.309-05:00"
                            jcr:createdBy="singarx"
                            jcr:lastModified="{Date}2024-12-05T02:07:51.615-05:00"
                            jcr:lastModifiedBy="singarx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>Изследователският център „Кеймбридж“ на АбВи се простира на 3 995 м2 и се намира в биотехнологичния клъстер в Кеймбридж, Масачузетс. На територията на центъра учените ни са се заели да вникнат в биологичните механизми, които обуславят невродегенеративните заболявания и по-специално болестта на Алцхаймер и болестта на Паркинсон, както и имуномедиираните заболявания.&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
                        <button_1919730922
