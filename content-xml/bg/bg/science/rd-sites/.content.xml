                            sling:resourceType="abbvie-com2/components/title/v2/title"
                            type="h4"
                            variant="h"/>
                        <text_1805853993
                            cq:styleIds="[1659545825678]"
                            jcr:created="{Date}2024-12-05T02:16:19.761-05:00"
                            jcr:createdBy="singarx"
                            jcr:lastModified="{Date}2024-12-05T02:17:07.165-05:00"
                            jcr:lastModifiedBy="singarx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p> Научноизследователският център на АбВи в Токио е мястото, където се помещава целият ни капацитет при клиничното развитие. С цел да бъдат одобрени заявленията на АбВи за разрешаване на нови продукти за пациентите в Япония, провеждаме паралелни проучвания от фаза 1 до фаза 4. Тук се изпълняват стратегически функции по клинично планиране за всяка от приоритетните ни области, за да формираме стратегия по развитие специално за Япония в областите онкология, имунология, неврология, очна грижа и естетика.&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
