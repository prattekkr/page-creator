                            sling:resourceType="abbvie-com2/components/title/v2/title"
                            type="h4"
                            variant="h"/>
                        <text_309156190
                            cq:styleIds="[1659545825678]"
                            jcr:created="{Date}2024-12-05T02:09:49.735-05:00"
                            jcr:createdBy="singarx"
                            jcr:lastModified="{Date}2024-12-05T02:10:25.121-05:00"
                            jcr:lastModifiedBy="singarx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>Вече над 30 години Центърът за биологични изследвания на АбВи в Устър, Масачузетс, е лидер в бранша по отношение на откриването на лекарства, развойната дейност и изследването на биологични средства. Тази база се простира на 51 375 м2, специализирана е в разработването на биологични лекарства и изучава възможностите за иновативни решения на някои от най-сериозните предизвикателства пред медицината, включително такива в областта на имунологията и неврологията.&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
