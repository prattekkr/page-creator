                        <par_12
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="wcm/foundation/components/parsys">
                            <container4
                                cq:styleIds="[1653545847150,1653242825678,1653545825687,1653545835982]"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/container/v2/container">
                                <text2
                                    cq:styleIds="[1659545825678,1659545835858]"
                                    jcr:lastModified="{Date}2026-03-25T06:25:10.544-04:00"
                                    jcr:lastModifiedBy="singarx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    langAttribute="none"
                                    text="&lt;p>&lt;i>29 май 2023 г.&lt;br>&#xd;&#xa;&lt;br>&#xd;&#xa;&lt;br>&#xd;&#xa;Управителят на АбВи за България Павел Колев бе избран за член на Управителния съвет на Асоциацията на научноизследователските фармацевтични производители в България (ARPharM) по време на отчетно-изборно заседание на Общото събрание на Асоциацията, проведено на 18 май 2023 г.&lt;br>&#xd;&#xa;&lt;br>&#xd;&#xa;„Щастлив съм да бъда част от една толкова разпознаваема и динамична организация, каквато е ARPharM. Надявам се с моя опит и експертиза, както и с подкрепата на колегите ми от АбВи, да подпомогнем дейността на Асоциацията. &amp;nbsp;В безпрецедентното време, в което живеем, имаме нужда от сериозна трансформация, както в компаниите, които управляваме, така и в цялата организация на здравеопазването. Вярвам, че Асоциацията, с новия Управителен съвет имаме потенциала да бъдем все по-активни и все по-значим фактор в предлагането на решения на здравната система“ – каза Павел Колев по повод избирането си в Управителния съвет на ARPharM.&lt;br>&#xd;&#xa;&lt;br>&#xd;&#xa;Павел Колев е управител на АбВи България от близо година. Той се присъединява към компанията през 2012 г. като продуктов мениджър. В последствие става &amp;nbsp;мениджър на бизнес структура и е повишен през 2016 г. като търговски мениджър в регионалния екип за Източна Европа, Близкия Изток и Африка. По-малко от 3 години след това става търговски директор в същия регион. През 2020 г. Павел Колев се присъединява към глобалния маркетинг екип. На поста управител на АбВи за България идва от позицията директор на бизнес направлението „Имунология“ в Русия. Преди работата си в АбВи, той е бил на различни позиции в търговския и маркетинг отдел на АстраЗенека в България. &amp;nbsp;Павел Колев е магистър по „Фармация“ от Медицинския университет в София.&lt;/i>&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
