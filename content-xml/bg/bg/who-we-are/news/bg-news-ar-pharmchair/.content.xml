                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    langAttribute="none"
                                    text="&lt;p>&lt;i>14 май 2025 г.&lt;br>&#xd;&#xa;&lt;b>&lt;br>&#xd;&#xa;Павел Колев, управител на AбВи в България, избран за председател на Управителния съвет на ARPharM&lt;br>&#xd;&#xa;&lt;/b>&lt;br>&#xd;&#xa;На 14 май 2025 г., в рамките на редовно отчетно-изборно заседание на Общото събрание на Асоциация на научноизследователските фармацевтични производители в България (ARPharM), бе избран нов състав на Управителния съвет (УС) на сдружението. За председател на УС с двегодишен мандат е избран Павел Колев, управител на АбВи в България. Ролята на заместник-председател, по традиция на приемственост, приема Тодор Кесимов, управител на &amp;quot;Такеда България&amp;quot; и досегашен председател на асоциацията.&lt;/i>&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <grid
                                    jcr:created="{Date}2026-03-25T12:58:11.889-04:00"
                                    jcr:createdBy="singarx"
                                    jcr:lastModified="{Date}2026-03-25T12:58:32.182-04:00"
                                    jcr:lastModifiedBy="singarx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/grid/v2/grid"
                                    rowCount="1">
                                    <columns jcr:primaryType="nt:unstructured">
                                        <item0
                                            jcr:primaryType="nt:unstructured"
                                            columnWidth="4"
                                            dataPriority="1"/>
                                        <item1
                                            jcr:primaryType="nt:unstructured"
                                            columnWidth="8"
                                            dataPriority="1"/>
                                    </columns>
                                    <par_12
