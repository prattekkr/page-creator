                                jcr:lastModifiedBy="ASHIKAX"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>シニアクリニカルリサーチアソシエイト&lt;br>&#xa;2015年中途入社。臨床試験の実務責任者として活躍中。&lt;/p>&#xa;"
                                textIsRich="true"/>
                            <separator_copy_copy__28577351
