                            <text_copy
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2022-12-10T17:23:32.991-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2025-02-25T00:32:10.472-05:00"
                                jcr:lastModifiedBy="tadankx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>2017年に（当時はアラガン・ジャパン）に入社し、東京の個人クリニックやチェーンクリニックの担当を経て、2024年1月から東京のエリアおよび東北を管轄するセールスリーダーに就任したHaruhi K.に、アラガン・エステティックスでの仕事のやりがいなどをききました。&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_copy_copy
                                cq:styleIds="[1662756456518]"
                                jcr:created="{Date}2024-03-27T02:56:24.100-04:00"
                                jcr:createdBy="tadankx"
                                jcr:lastModified="{Date}2024-03-27T02:56:37.121-04:00"
                                jcr:lastModifiedBy="tadankx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <title_copy_984608474_845442994
                                cq:styleIds="[1659545825678,1651545825678,1651545825693]"
                                jcr:created="{Date}2022-11-07T18:27:00.399-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2025-02-25T00:33:50.788-05:00"
                                jcr:lastModifiedBy="tadankx"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="営業は会社の顔。会社の顔として誇りを持って営業職に携わる"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h3"
                                variant="h"/>
                            <separator_copy_copy_
                                cq:styleIds="[1662756409908]"
                                jcr:created="{Date}2024-03-27T02:56:24.100-04:00"
                                jcr:createdBy="tadankx"
                                jcr:lastModified="{Date}2024-03-27T02:56:37.121-04:00"
                                jcr:lastModifiedBy="tadankx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <text
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2024-03-19T03:30:12.570-04:00"
                                jcr:createdBy="tadankx"
                                jcr:lastModified="{Date}2025-02-25T02:20:07.289-05:00"
                                jcr:lastModifiedBy="tadankx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;b>－セールスという仕事のどこにやりがいを感じていますか。&lt;/b>&lt;/p>&#xd;&#xa;&lt;p>営業は会社の顔です。会社の顔として私は誇りを持って営業職に携わっています。&lt;br>&#xd;&#xa;正しい情報を伝えるだけでなく、クリニックの思い、医師個人の思い、患者さんの思い、それぞれ表面だけでは見えない思いも含めて、それぞれにメリットがあるようなコミュニケーションが必要です。いくらAIが発達しても気持ちを汲み取った営業はできないと思います。それがセールスの魅力でもありやりがいでもあります。&lt;/p>&#xd;&#xa;&lt;p>&lt;b>－今年の1月からセールスリーダーに就任されました。今の立場ではどうですか。&lt;/b>&lt;/p>&#xd;&#xa;&lt;p>現在はセールスリーダーという職についてチームをリードしていますが、より広い視点で業界のことや顧客のことを見られるようになりました。また、自分自身だけでなくメンバー一人一人が会社の顔として、会社全体として評価されるようリードしていきたいと思います。&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_copy_copy__1481247164
                                cq:styleIds="[1662756502570]"
                                jcr:created="{Date}2024-03-27T02:56:24.100-04:00"
                                jcr:createdBy="tadankx"
                                jcr:lastModified="{Date}2024-03-27T02:56:37.121-04:00"
                                jcr:lastModifiedBy="tadankx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <title_copy_984608474_1932039094
                                cq:styleIds="[1659545825678,1651545825678,1651545825693]"
                                jcr:created="{Date}2022-11-07T18:27:00.399-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2025-02-25T00:35:55.101-05:00"
                                jcr:lastModifiedBy="tadankx"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="トライアンドエラーを繰り返せる環境"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h3"
                                variant="h"/>
                            <separator_copy_copy__1663405447
                                cq:styleIds="[1662756409908]"
                                jcr:created="{Date}2024-03-27T02:56:24.100-04:00"
                                jcr:createdBy="tadankx"
                                jcr:lastModified="{Date}2024-03-27T02:56:37.121-04:00"
                                jcr:lastModifiedBy="tadankx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <text_copy_314336563
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2024-03-19T03:30:12.570-04:00"
                                jcr:createdBy="tadankx"
                                jcr:lastModified="{Date}2025-02-25T01:53:41.232-05:00"
                                jcr:lastModifiedBy="tadankx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;b>－アラガン・エステティックスの働く環境について教えてください。&lt;/b>&lt;/p>&#xd;&#xa;&lt;p>アラガン・エステティックスは、とてもオープンで活発な風土があると思います。業界をリードするという気持ちで皆、日々前向きに取り組んでおり、評価に関しても業績がメインにはなりますが、行動部分もしっかりと評価されます。&lt;/p>&#xd;&#xa;&lt;p>&lt;b>－皆が業界をリードするという気持ちで仕事に取り組めるのはアラガン・エステティックスならではですね。&lt;/b>&lt;/p>&#xd;&#xa;&lt;p>はい。また、さまざまな成功事例を共有する風土があり、その成功事例をもとに顧客に合わせてアレンジし、トライアンドエラーを繰り返せる環境にもあります。自由診療の領域なので、さまざまな顧客の目標、課題があり現場で学んでいくことは多いですが、それがまたおもしろい部分でもあると思います。&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <image_copy_copy
                                jcr:created="{Date}2024-03-27T02:31:59.983-04:00"
                                jcr:createdBy="tadankx"
                                jcr:lastModified="{Date}2025-02-25T01:47:55.680-05:00"
                                jcr:lastModifiedBy="tadankx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/image/v2/image"
                                alt=" "
                                altValueFromDAM="false"
                                displayPopupTitle="true"
                                dmPresetType="imagePreset"
                                fileReference="/content/dam/abbvie-com2/japan/images/join-us/voice-of-employees/14-3.jpg"
                                isDecorative="false"
                                openInNewWindow="false"
                                titleValueFromDAM="true"/>
                            <separator_copy_copy__1232324822
                                cq:styleIds="[1662756502570]"
                                jcr:created="{Date}2024-03-27T02:56:24.100-04:00"
                                jcr:createdBy="tadankx"
                                jcr:lastModified="{Date}2024-03-27T02:56:37.121-04:00"
                                jcr:lastModifiedBy="tadankx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <title_copy_984608474_1719149717
                                cq:styleIds="[1659545825678,1651545825678,1651545825693]"
                                jcr:created="{Date}2022-11-07T18:27:00.399-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2025-02-25T01:40:53.340-05:00"
                                jcr:lastModifiedBy="tadankx"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="「プラスにならない営業ならいらない」と言われた苦い経験も"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h3"
                                variant="h"/>
                            <separator_copy_copy__269217833
                                cq:styleIds="[1662756409908]"
                                jcr:created="{Date}2024-03-27T02:56:24.100-04:00"
                                jcr:createdBy="tadankx"
                                jcr:lastModified="{Date}2024-03-27T02:56:37.121-04:00"
                                jcr:lastModifiedBy="tadankx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <text_copy_461044077_
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2024-03-19T03:30:12.570-04:00"
                                jcr:createdBy="tadankx"
                                jcr:lastModified="{Date}2025-02-25T01:42:46.368-05:00"
                                jcr:lastModifiedBy="tadankx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;b>―クリニックにはそれぞれ目標、課題がある。思いを汲み取るというところはそこですね。&lt;/b>&lt;/p>&#xd;&#xa;&lt;p>はい、提案型の営業が重要です。今でこそ学びも多く面白い部分でもあると言えますが、最初はその手法に戸惑い、アポイントが取れない、うまく売上を上げられないことも多くありました。&lt;/p>&#xd;&#xa;&lt;p>&lt;b>―過去に苦い経験もあったようですね。&lt;/b>&lt;/p>&#xd;&#xa;&lt;p>顧客の目標や課題に対してうまく提案できず、「プラスにならない営業ならいらない」と言われたこともありました。最初悩んだ時期もありましたが、そこから本気でさまざまな角度から業界や顧客に対して考えるようになり、成果を出せるようになったときには、成長を感じられたことをはっきりと覚えています。&lt;/p>&#xd;&#xa;&lt;p>&lt;b>―まさしく成長を実感できたときですね。今後は何を目指して取り組んでいきたいと思っていますか。&lt;/b>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_copy_copy__932266869
                                cq:styleIds="[1662756456518]"
                                jcr:created="{Date}2024-03-27T02:56:24.100-04:00"
                                jcr:createdBy="tadankx"
                                jcr:lastModified="{Date}2024-06-04T01:09:54.364-04:00"
                                jcr:lastModifiedBy="ASHIKAX"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <title_copy_984608474_1963727186
                                cq:styleIds="[1659545825678,1651545825678,1651545825693]"
                                jcr:created="{Date}2022-11-07T18:27:00.399-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2025-02-25T01:43:37.000-05:00"
                                jcr:lastModifiedBy="tadankx"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="ゲームチェンジャーの気持ちで顧客と共に今後も業界をリードしていきたい"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h2"
                                variant="h"/>
                            <text_copy_1688563549
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2024-03-19T03:30:12.570-04:00"
                                jcr:createdBy="tadankx"
                                jcr:lastModified="{Date}2025-03-28T02:52:25.639-04:00"
                                jcr:lastModifiedBy="tadankx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>人生100年時代（生物学的には120年以上生きる能力を秘めている）と言われる中、いかに健康で若々しく前向きに人生を楽しめるかが重要だと思います。美容医療はエイジングケアに貢献できるだけでなく、美容医療を通じて老若男女問わず人生を豊かにできる医療だと考えています。この美容医療の業界の更なる発展に向けて、ゲームチェンジャーの気持ちで顧客と共に今後も業界をリードしていきたいと思います。&lt;/p>&#xd;&#xa;&lt;p>&lt;b>―顧客とともに業界をリードしていくとき、共に働く社員には何を求めますか。&lt;/b>&lt;/p>&#xd;&#xa;&lt;p>美容医療は今後もますます成長していくと思います。美容医療をもっと広めるために、身近にしていくために、患者さんに適切な美容医療が提供されるように、アラガン・エステティックスという会社の存在は欠かせません。業界をリードしていきたい、また、セールスとしてさらに成長していきたいというチャレンジ精神旺盛な方にはぴったりな会社だと思います。ぜひ我々と一緒に働きましょう！&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <image_copy_771351189_922296377
                                jcr:created="{Date}2024-03-27T02:31:59.983-04:00"
                                jcr:createdBy="tadankx"
                                jcr:lastModified="{Date}2025-02-27T01:02:54.421-05:00"
                                jcr:lastModifiedBy="tadankx"
                                jcr:primaryType="nt:unstructured"
