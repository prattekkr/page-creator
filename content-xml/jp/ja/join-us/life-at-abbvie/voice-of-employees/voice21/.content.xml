                            <title_copy_984608474_1719149717
                                cq:styleIds="[1659545825678,1651545825678,1651545825693]"
                                jcr:created="{Date}2022-11-07T18:27:00.399-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2026-02-18T01:50:37.358-05:00"
                                jcr:lastModifiedBy="tadankx"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="先生の反応が、やりがいとして返ってくる"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h3"
                                variant="h"/>
                            <separator_copy_copy__269217833
                                cq:styleIds="[1662756409908]"
                                jcr:created="{Date}2024-03-27T02:56:24.100-04:00"
                                jcr:createdBy="tadankx"
                                jcr:lastModified="{Date}2024-03-27T02:56:37.121-04:00"
                                jcr:lastModifiedBy="tadankx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <text_copy_461044077_
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2024-03-19T03:30:12.570-04:00"
                                jcr:createdBy="tadankx"
                                jcr:lastModified="{Date}2026-02-18T01:51:19.480-05:00"
                                jcr:lastModifiedBy="tadankx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;b>―仕事をしていて、特にやりがいを感じる瞬間は？&lt;/b>&lt;/p>&#xd;&#xa;&lt;p>美容医療を牽引する先生方と意見を交わし、患者さんの満足度向上につながるトレーニングプログラムの作成を一緒に進められることは、この仕事ならではの大きなやりがいだと感じています。自分の提案やサポートが先生に届き、その結果が患者さんの笑顔となって返ってくる――そんな手応えを実感できることが、この仕事を続ける上でのモチベーションになっています。&lt;/p>&#xd;&#xa;&lt;p>また、プログラムに参加した先生方が、熱心にメモを取ってくださったり、アンケートの自由記載欄に「参加してよかった」「学びが多かった」と書いてくださったりすると、自分たちの仕事がしっかり届いたと感じます。&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_copy_copy__932266869
                                cq:styleIds="[1662756456518]"
                                jcr:created="{Date}2024-03-27T02:56:24.100-04:00"
                                jcr:createdBy="tadankx"
                                jcr:lastModified="{Date}2024-06-04T01:09:54.364-04:00"
                                jcr:lastModifiedBy="ASHIKAX"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <title_copy_984608474_1963727186
                                cq:styleIds="[1659545825678,1651545825678,1651545825693]"
                                jcr:created="{Date}2022-11-07T18:27:00.399-05:00"
