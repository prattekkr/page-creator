                                jcr:primaryType="nt:unstructured"
                                jcr:title="Haruna T."
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h4"
                                variant="h"/>
                            <text_copy
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2022-12-10T17:23:32.991-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2026-02-18T00:13:28.810-05:00"
                                jcr:lastModifiedBy="tadankx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>内資系製薬会社のMR、調剤薬局での薬剤師経験を経て、2014年に入社（当時はアラガン・ジャパン）し、ブレスト・インプラント事業に携わる。育休復帰を機にフェイシャル・エステティックス営業本部へ異動。&lt;br>&#xd;&#xa; 現在は関西エリアのマネジャーとして、医師・クリニックに伴走する営業活動に取り組んでいる。&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_copy_copy
                                cq:styleIds="[1662756456518]"
                                jcr:created="{Date}2024-03-27T02:56:24.100-04:00"
                                jcr:createdBy="tadankx"
                                jcr:lastModified="{Date}2024-03-27T02:56:37.121-04:00"
                                jcr:lastModifiedBy="tadankx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <text_copy_copy
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2022-12-10T17:23:32.991-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2026-03-26T22:55:30.068-04:00"
                                jcr:lastModifiedBy="tadankx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                langAttribute="none"
                                text="&lt;p>「短期的な売り上げよりも、長期の信頼を大切にしたい」。&lt;br>&#xd;&#xa;そう語るHaruna T.は、美容医療の現場で医師やクリニックと真摯に向き合い続けてきました。MR、薬剤師という異なる立場を経験したからこそ見えてきた“本当に求められる支援”とは何か。そして、営業として、マネジャーとして、母として――。&lt;br>&#xd;&#xa;変化の多い環境のなかでも自分らしい働き方を模索し続けるHaruna T.に、仕事のやりがい、成長、そしてこれからの目標について話を聞きました。&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_copy_copy__136334080
                                cq:styleIds="[1662756456518]"
                                jcr:created="{Date}2024-03-27T02:56:24.100-04:00"
                                jcr:createdBy="tadankx"
                                jcr:lastModified="{Date}2024-03-27T02:56:37.121-04:00"
                                jcr:lastModifiedBy="tadankx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <text_1726002577
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2026-02-19T02:33:47.794-05:00"
                                jcr:createdBy="tadankx"
                                jcr:lastModified="{Date}2026-02-19T02:35:56.997-05:00"
                                jcr:lastModifiedBy="tadankx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;h3>&lt;span class=&quot;body-unica-40-reg&quot;>&lt;b>クリニックを「一緒につくりあげる」営業――&lt;br>&#xd;&#xa; 美容医療ならではのやりがい&lt;/b>&lt;/span>&lt;/h3>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_copy_copy_
                                cq:styleIds="[1662756409908]"
                                jcr:created="{Date}2024-03-27T02:56:24.100-04:00"
                                jcr:createdBy="tadankx"
                                jcr:lastModified="{Date}2024-03-27T02:56:37.121-04:00"
                                jcr:lastModifiedBy="tadankx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <text
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2024-03-19T03:30:12.570-04:00"
                                jcr:createdBy="tadankx"
                                jcr:lastModified="{Date}2026-03-26T22:58:24.618-04:00"
                                jcr:lastModifiedBy="tadankx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                langAttribute="none"
                                text="&lt;p>&lt;b>―現在のお仕事について教えてください。&lt;/b>&lt;/p>&#xd;&#xa;&lt;p>フェイシャル・エステティックス営業本部で、美容医療に携わるクリニックを担当しています。&lt;/p>&#xd;&#xa;&lt;p>自社製品の情報を提供するだけではなく、製品が適切に活用されるよう、診療現場の状況を踏まえたポイントについて、医師やクリニックと一緒に考えるのが私たちの役割です。美容医療の現場では、医師、看護師、カウンセラー、受付など多くの方が関わります。どこか一つだけを改善しても、全体が良くなるとは限りません。診療やカウンセリングの流れを俯瞰しながら、アラガン・エステティックスの製品理解などの観点で整理が必要な点を共有し、日々の診療に役立てていただけるような情報提供を心がけています。&lt;/p>&#xd;&#xa;&lt;p>提案したことが実行され、クリニックが少しずつ変わっていく様子を目の当たりにできるのは、この仕事ならではのやりがいだと思います。&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <image_copy_copy_copy
                                jcr:created="{Date}2024-03-27T02:31:59.983-04:00"
                                jcr:createdBy="tadankx"
                                jcr:lastModified="{Date}2026-02-18T00:22:58.592-05:00"
                                jcr:lastModifiedBy="tadankx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/image/v2/image"
                                alt=" "
                                altValueFromDAM="false"
                                displayPopupTitle="true"
                                dmPresetType="imagePreset"
                                fileReference="/content/dam/abbvie-com2/japan/images/join-us/voice-of-employees/19-a02.jpg"
                                isDecorative="false"
                                openInNewWindow="false"
                                titleValueFromDAM="true"/>
                            <separator_copy_copy__1481247164
                                cq:styleIds="[1662756502570]"
                                jcr:created="{Date}2024-03-27T02:56:24.100-04:00"
                                jcr:createdBy="tadankx"
                                jcr:lastModified="{Date}2024-03-27T02:56:37.121-04:00"
                                jcr:lastModifiedBy="tadankx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <title_copy_984608474_1932039094
                                cq:styleIds="[1659545825678,1651545825678,1651545825693]"
                                jcr:created="{Date}2022-11-07T18:27:00.399-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2026-02-18T00:23:49.767-05:00"
                                jcr:lastModifiedBy="tadankx"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="「聞く力」が仕事を変えた――遠回りが、いまの強みになった"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h3"
                                variant="h"/>
                            <separator_copy_copy__1663405447
                                cq:styleIds="[1662756409908]"
                                jcr:created="{Date}2024-03-27T02:56:24.100-04:00"
                                jcr:createdBy="tadankx"
                                jcr:lastModified="{Date}2024-03-27T02:56:37.121-04:00"
                                jcr:lastModifiedBy="tadankx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <text_copy_314336563
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2024-03-19T03:30:12.570-04:00"
                                jcr:createdBy="tadankx"
                                jcr:lastModified="{Date}2026-03-04T22:30:24.079-05:00"
                                jcr:lastModifiedBy="tadankx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;b>－これまでのキャリアは、今の仕事にどう生きていますか。&lt;/b>&lt;/p>&#xd;&#xa;&lt;p>MR時代は、短い面談時間の中で「いかに伝えるか」を重視していました。&lt;br>&#xd;&#xa;でも薬剤師として患者さんと向き合うようになってから、「相手が本当に困っていることは何か」を聞くことの大切さを痛感しました。患者さんは、効果やデータだけでなく、薬の大きさや服用回数といった生活に密着した部分で悩んでいることを知りました。&lt;br>&#xd;&#xa;その経験を経て、今は医師に対しても「何を求めているのか」を徹底的に聞くことを意識しています。&lt;/p>&#xd;&#xa;&lt;p>美容医療の営業でも、技術的な話だけでなく、クリニック運営や患者さん対応など、複数の要素が絡み合っています。一つに絞りすぎず、全体を見て課題を捉えるようになったことで、提案の質も大きく変わりました。&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_copy_copy__1232324822
                                cq:styleIds="[1662756502570]"
                                jcr:created="{Date}2024-03-27T02:56:24.100-04:00"
                                jcr:createdBy="tadankx"
                                jcr:lastModified="{Date}2024-03-27T02:56:37.121-04:00"
                                jcr:lastModifiedBy="tadankx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <title_copy_984608474_1719149717
                                cq:styleIds="[1659545825678,1651545825678,1651545825693]"
                                jcr:created="{Date}2022-11-07T18:27:00.399-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2026-02-18T00:25:50.567-05:00"
                                jcr:lastModifiedBy="tadankx"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="短期の売り上げより、長期の信頼を――信念が結果につながった瞬間"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h3"
                                variant="h"/>
                            <separator_copy_copy__269217833
                                cq:styleIds="[1662756409908]"
                                jcr:created="{Date}2024-03-27T02:56:24.100-04:00"
                                jcr:createdBy="tadankx"
                                jcr:lastModified="{Date}2024-03-27T02:56:37.121-04:00"
                                jcr:lastModifiedBy="tadankx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <text_copy_461044077_
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2024-03-19T03:30:12.570-04:00"
                                jcr:createdBy="tadankx"
                                jcr:lastModified="{Date}2026-02-18T00:26:33.069-05:00"
                                jcr:lastModifiedBy="tadankx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;b>―仕事をするうえで大切にしている考え方は？&lt;/b>&lt;/p>&#xd;&#xa;&lt;p>「短期の売上より、長期の信頼」です。尊敬する医師の言葉に感銘を受け、ずっと大事にしています。すぐに売上につながらない提案でも、クリニックにとって必要だと思えば、時間をかけても取り組んでいます。&lt;/p>&#xd;&#xa;&lt;p>&lt;b>&lt;/b>印象に残っているのは、長年の経験に基づいてご自身のスタイルを確立されていたベテラン医師のことです。医師との会話の中でのちょっとした一言をきっかけに、アラガン・エステティックスが提供するトレーニングプログラムを提案しました。そのトレーニングの際に治療を受けたモデル患者さんが「こんなに変わるなんて！」と施術後の変化に感激して涙を流されたんです。そのモデル患者さんの姿を見て、医師もアラガン・エステティックスの提案に信頼を寄せていただけるようになりました。その経験を通じて、医師との信頼関係が深まり、結果として大きな成果にもつながり「やってきたことは間違っていなかった」と実感できた出来事でした。&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_copy_copy__1873841120
                                cq:styleIds="[1662756502570]"
                                jcr:created="{Date}2024-03-27T02:56:24.100-04:00"
                                jcr:createdBy="tadankx"
                                jcr:lastModified="{Date}2024-03-27T02:56:37.121-04:00"
                                jcr:lastModifiedBy="tadankx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <title_copy_984608474
                                cq:styleIds="[1659545825678,1651545825678,1651545825693]"
                                jcr:created="{Date}2022-11-07T18:27:00.399-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2026-02-18T00:27:37.155-05:00"
                                jcr:lastModifiedBy="tadankx"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="マネジャーとして、母として――自分らしい働き方を次の世代へ"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h3"
