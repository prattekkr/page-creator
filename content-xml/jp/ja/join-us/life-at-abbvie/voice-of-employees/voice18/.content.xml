                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <title_copy_984608474_1719149717
                                cq:styleIds="[1659545825678,1651545825678,1651545825693]"
                                jcr:created="{Date}2022-11-07T18:27:00.399-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2026-02-17T23:54:51.621-05:00"
                                jcr:lastModifiedBy="tadankx"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="体験を通じて育まれた、美容医療への思い"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h3"
                                variant="h"/>
                            <separator_copy_copy__269217833
                                cq:styleIds="[1662756409908]"
                                jcr:created="{Date}2024-03-27T02:56:24.100-04:00"
                                jcr:createdBy="tadankx"
                                jcr:lastModified="{Date}2024-03-27T02:56:37.121-04:00"
                                jcr:lastModifiedBy="tadankx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <text_copy_461044077_
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2024-03-19T03:30:12.570-04:00"
                                jcr:createdBy="tadankx"
                                jcr:lastModified="{Date}2026-03-04T22:33:06.999-05:00"
                                jcr:lastModifiedBy="tadankx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;b>―なぜ美容医療に関心を持つようになったのでしょうか。&lt;/b>&lt;/p>&#xd;&#xa;&lt;p>学生時代、ニキビに悩んでいた時期があり、外見に対するコンプレックスを抱えていました。その経験から、見た目の悩みが人の気持ちに与える影響の大きさを実感しています。&lt;/p>&#xd;&#xa;&lt;p>また、前職で乳がん治療薬を担当していた際、治療によって命は救われたものの、手術などによる外見の変化に戸惑い、前向きになれない患者さんの存在を知りました。&lt;/p>&#xd;&#xa;&lt;p>「生きていく力」には、身体だけでなく心の状態も大きく関わっている。美容医療が、その一助になり得るのではないか。そう感じたことが、この業界に関わりたいと思ったきっかけです。美容医療を通じて、人が自分らしく前向きに生きる手助けができる。その可能性に、今も大きなやりがいを感じています。&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_copy_copy__932266869
                                cq:styleIds="[1662756456518]"
                                jcr:created="{Date}2024-03-27T02:56:24.100-04:00"
                                jcr:createdBy="tadankx"
                                jcr:lastModified="{Date}2024-06-04T01:09:54.364-04:00"
                                jcr:lastModifiedBy="ASHIKAX"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <title_copy_984608474_1963727186
                                cq:styleIds="[1659545825678,1651545825678,1651545825693]"
                                jcr:created="{Date}2022-11-07T18:27:00.399-05:00"
