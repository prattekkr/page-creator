                                text="&lt;p>&lt;b>世代を超えたキャリア形成サポート&lt;/b>&lt;/p>&#xa;"
                                textIsRich="true"/>
                            <text_copy_copy_copy__539687213
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2024-03-08T03:14:12.624-05:00"
                                jcr:createdBy="tadankx"
                                jcr:lastModified="{Date}2026-03-05T01:33:09.947-05:00"
                                jcr:lastModifiedBy="tadankx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;ul>&#xd;&#xa;&lt;li>世代間の価値観や強みを学び合うことを目的に、人生・価値観・働き方・キャリアなどをテーマにパネルディスカッションや双方向プログラム等の対話型企画を開催&lt;/li>&#xd;&#xa;&lt;li>心理的安全性の高い環境のもと、世代横断のディスカッションや交流を展開し、各世代の強みを掛け合わせる土台作りを推進&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;"
                                textIsRich="true"/>
