                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;b>世代間の価値観の違いを特定&lt;/b>&lt;/p>&#xa;"
                                textIsRich="true"/>
                            <text_copy_copy_copy
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2024-03-08T03:14:12.624-05:00"
                                jcr:createdBy="tadankx"
                                jcr:lastModified="{Date}2024-06-14T05:21:41.105-04:00"
                                jcr:lastModifiedBy="ASHIKAX"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;ul>&#xa;&lt;li>全社員を対象にアンケートを実施。世代毎の価値観の特徴（考え方・働き方・キャリア・ライフプラン）を把握し、課題やニーズに合った、イベント・企画を立案&lt;/li>&#xa;&lt;/ul>&#xa;"
                                textIsRich="true"/>
                            <separator_copy_copy_
                                cq:styleIds="[1662756456518]"
                                jcr:created="{Date}2024-03-21T02:34:30.870-04:00"
                                jcr:createdBy="tadankx"
                                jcr:lastModified="{Date}2024-06-14T05:22:48.987-04:00"
                                jcr:lastModifiedBy="ASHIKAX"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <text_copy_copy_copy_600133418
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2024-03-08T03:14:12.624-05:00"
                                jcr:createdBy="tadankx"
                                jcr:lastModified="{Date}2026-03-05T21:14:06.965-05:00"
                                jcr:lastModifiedBy="tadankx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                langAttribute="none"
                                text="&lt;p>&lt;b>ヤング世代（20代、30代）のキャリア形成サポート&lt;/b>&lt;/p>&#xd;&#xa;&lt;p>～ヤング世代のキャリア・つながり・強みをサポートし、ヤングの勢いをつけることを目指す～&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <text_copy_copy_copy_
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2024-03-08T03:14:12.624-05:00"
                                jcr:createdBy="tadankx"
                                jcr:lastModified="{Date}2026-03-05T01:30:01.149-05:00"
                                jcr:lastModifiedBy="tadankx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;ul>&#xd;&#xa;&lt;li>昨年から、「ラフなキャリア1on1面談」・「社内AIのAVA活用促進」などを実施&lt;/li>&#xd;&#xa;&lt;li>今年もヤング世代にフォーカスしてイベント•企画を立案&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_copy_copy__1851550613
                                cq:styleIds="[1662756456518]"
                                jcr:created="{Date}2024-03-21T02:34:30.870-04:00"
                                jcr:createdBy="tadankx"
                                jcr:lastModified="{Date}2024-06-14T05:22:48.987-04:00"
                                jcr:lastModifiedBy="ASHIKAX"
