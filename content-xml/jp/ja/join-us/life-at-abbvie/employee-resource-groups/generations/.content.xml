                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <text_copy_copy_copy__1914998907
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2024-03-08T03:14:12.624-05:00"
                                jcr:createdBy="tadankx"
                                jcr:lastModified="{Date}2026-03-05T01:31:04.379-05:00"
                                jcr:lastModifiedBy="tadankx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;b>ミドル世代（30代半ば〜40代後半）のライフプラン支援&lt;/b>&lt;/p>&#xd;&#xa;&lt;p>～一人で悩まない。「知る・話す・つながる」をコンセプトに、キャリアとライフの次の一歩を自信へ～&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <text_copy_copy_copy__1698763358
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2024-03-08T03:14:12.624-05:00"
                                jcr:createdBy="tadankx"
                                jcr:lastModified="{Date}2026-03-05T01:31:37.381-05:00"
                                jcr:lastModifiedBy="tadankx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;ul>&#xd;&#xa;&lt;li>キャリアはもちろん、ライフプランにも役立つ座談会・セミナーを開催&lt;/li>&#xd;&#xa;&lt;li>部門の垣根を越えたランダムランチなどによる悩みの共有とつながり拡大&lt;/li>&#xd;&#xa;&lt;li>社外講師資料を社内展開と、ミドル世代のエンゲージメントを高めるノウハウを共有&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;"
                                textIsRich="true"/>
