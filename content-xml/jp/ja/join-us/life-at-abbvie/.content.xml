                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;body-unica-32-reg&quot;>ブレークスルーを成し遂げるまでの過程を大切にしています。やり方は結果と同じくらい重要です。&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
