                            <title_1382338800
                                cq:styleIds="[1659545825678,1661545829678]"
                                jcr:created="{Date}2022-12-10T16:40:31.549-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2024-03-04T01:51:24.434-05:00"
                                jcr:lastModifiedBy="tadankx"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="インクルーシブ、コラボラティブ、イノベーティブ"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h3"
                                variant="h"/>
                            <text_1044727654_copy
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2022-12-10T16:39:49.979-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2024-03-04T01:51:41.064-05:00"
                                jcr:lastModifiedBy="tadankx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>アッヴィ誕生以来、インクルーシブな職場環境が、私たちを成功に導いてきた秘訣です。それは、私たちが行う全てのこと、また提供する全てのものに生きています。その根底にあるのは、Ways We Work。5つの柱から成り、どのように社員が、仕事をし、イノベーションを生み出し、コラボレートし、お互いに接するかが示されています。これは、個人、チーム、そして会社全体で、世界中人々の生活に真の変化をもたらすことを可能とするものです。&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                        </container3>
                        <separator
                            cq:styleIds="[1662756456518]"
                            jcr:created="{Date}2024-05-07T23:53:21.619-04:00"
