                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/accordion/v2/accordion"
                                    headingElement="h5"
                                    singleExpansion="false">
                                    <item_1670713218905
                                        cq:panelTitle="社会保険、手当"
                                        cq:styleIds="[1659545825678]"
                                        jcr:lastModified="{Date}2024-03-08T00:34:22.427-05:00"
                                        jcr:lastModifiedBy="tadankx"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="abbvie-com2/components/text/v2/text"
                                        text="&lt;ul>&#xd;&#xa;&lt;li>各種社会保険（健康保険、厚生年金、雇用保険、労災）完備&lt;br>&#xd;&#xa;&lt;/li>&#xd;&#xa;&lt;li>転勤家賃援助&lt;/li>&#xd;&#xa;&lt;li>通勤手当&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;"
                                        textIsRich="true"/>
                                    <item_1670713221584
                                        cq:panelTitle="健康関連"
                                        cq:styleIds="[1659545825678]"
                                        jcr:lastModified="{Date}2024-12-13T00:48:02.528-05:00"
                                        jcr:lastModifiedBy="tadankx"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="abbvie-com2/components/text/v2/text"
                                        text="&lt;ul>&#xd;&#xa;&lt;li>健康診断・人間ドック、各種オプション検査&lt;br>&#xd;&#xa;&lt;/li>&#xd;&#xa;&lt;li>インフルエンザ等予防接種費用補助&lt;/li>&#xd;&#xa;&lt;li>C型肝炎ウイルス（HCV）抗体検査費用補助&lt;/li>&#xd;&#xa;&lt;li>健康保険組合による独自の支援&lt;br>&#xd;&#xa;&lt;ul>&#xd;&#xa;&lt;li>付加給付&lt;/li>&#xd;&#xa;&lt;li>健康生活を支援する様々なメニュー（カフェテリアプラン）&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;&lt;/li>&#xd;&#xa;&lt;li>健康相談・カウンセリング（産業医、外部機関）&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;"
                                        textIsRich="true"/>
                                    <item_1670713228568
                                        cq:panelTitle="生活の変化に応じた支援"
                                        cq:styleIds="[1659545825678]"
                                        jcr:lastModified="{Date}2024-12-12T23:41:09.799-05:00"
                                        jcr:lastModifiedBy="tadankx"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="abbvie-com2/components/text/v2/text"
                                        text="&lt;ul>&#xd;&#xa;&lt;li>ベビーシッターチケットや育児補助券などの育児支援&lt;/li>&#xd;&#xa;&lt;li>介護サービスや用品購入に対する補助などの介護支援&lt;br>&#xd;&#xa;&lt;/li>&#xd;&#xa;&lt;li>奨学金プログラム（子女）&lt;/li>&#xd;&#xa;&lt;li>災害・経済的困難時支援プログラム&lt;/li>&#xd;&#xa;&lt;li>慶弔金・見舞金制度（結婚祝金、出産祝金、弔慰金、傷病見舞金、災害見舞金）&lt;br>&#xd;&#xa;&lt;/li>&#xd;&#xa;&lt;li>団体扱契約生命保険、団体契約損害保険&lt;br>&#xd;&#xa;&lt;/li>&#xd;&#xa;&lt;li>死亡・高度障害補償（総合福祉団体定期保険、損害保険）&lt;br>&#xd;&#xa;&lt;/li>&#xd;&#xa;&lt;li>労災上乗せ補償（法定外補償保険）&lt;/li>&#xd;&#xa;&lt;li>GLTD（Group Long Term Disability：長期休業補償）制度&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;"
                                        textIsRich="true"/>
                                    <item_1670713232031
                                        cq:panelTitle="ライフサイクルに応じた財産形成支援"
                                        cq:styleIds="[1659545825678]"
                                        jcr:lastModified="{Date}2024-03-08T02:38:52.170-05:00"
                                        jcr:lastModifiedBy="tadankx"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="abbvie-com2/components/text/v2/text"
                                        text="&lt;ul>&#xd;&#xa;&lt;li>企業年金制度&lt;br>&#xd;&#xa;&lt;/li>&#xd;&#xa;&lt;li>従業員株式購入制度&lt;br>&#xd;&#xa;&lt;/li>&#xd;&#xa;&lt;li>財形貯蓄制度&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;"
                                        textIsRich="true"/>
                                    <item_1670713236887
                                        cq:panelTitle="親睦や余暇への補助"
                                        cq:styleIds="[1659545825678]"
                                        jcr:lastModified="{Date}2024-03-08T02:39:26.702-05:00"
                                        jcr:lastModifiedBy="tadankx"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="abbvie-com2/components/text/v2/text"
                                        text="&lt;ul>&#xd;&#xa;&lt;li>旅行/パーティー補助金/クラブ活動に対する援助&lt;/li>&#xd;&#xa;&lt;li>余暇施設、宿泊施設・レジャー施設などの割引制度、保養施設利用補助&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;"
                                        textIsRich="true"/>
                                    <item_1670713240836
                                        cq:panelTitle="社員の貢献・功績を称える制度"
                                        cq:styleIds="[1659545825678]"
                                        jcr:lastModified="{Date}2024-12-12T23:44:09.220-05:00"
                                        jcr:lastModifiedBy="tadankx"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="abbvie-com2/components/text/v2/text"
                                        text="&lt;ul>&#xd;&#xa;&lt;li>永年勤続表彰、定年表彰&lt;br />&#xd;&#xa;&lt;/li>&#xd;&#xa;&lt;li>Excellence Award（社員同士が互いに表彰することが出来る制度）&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;"
                                        textIsRich="true"/>
                                    <item_1709883616167
                                        cq:panelTitle="主体的なワークライフマネジメントをサポートする制度"
                                        cq:styleIds="[1659545825678]"
                                        jcr:lastModified="{Date}2025-04-21T23:18:36.260-04:00"
                                        jcr:lastModifiedBy="tadankx"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="abbvie-com2/components/text/v2/text"
                                        text="&lt;p>アッヴィでは異なるライフステージにいる社員一人ひとりが、ベストのパフォーマンスを出せるよう、主体的なワークライフマネジメントをサポートする制度も整えています。&lt;/p>&#xd;&#xa;&lt;ul>&#xd;&#xa;&lt;li>テレワーク制度&lt;/li>&#xd;&#xa;&lt;li>フレックスタイム制度&lt;br>&#xd;&#xa;&lt;/li>&#xd;&#xa;&lt;li>産前・産後・育児・介護休業&lt;/li>&#xd;&#xa;&lt;li>短時間勤務制度&lt;/li>&#xd;&#xa;&lt;li>特別有給休暇&lt;br>&#xd;&#xa;体調がすぐれない等の事由（年5日以内）、ボランティア休暇（年2日以内）、子どもの予防注射休暇（年2日以内）等&lt;/li>&#xd;&#xa;&lt;li>グローバル共通の会社指定休日（2018年に追加。日本は6月の第3金曜日をアッヴィ・リフレッシュホリデーとして制定）&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;"
                                        textIsRich="true"/>
                                </accordion>
                            </container>
