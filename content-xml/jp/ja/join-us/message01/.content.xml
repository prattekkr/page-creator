                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>&lt;span class=&quot;body-unica-26-reg&quot;>アリス・チェンはアッヴィ・ジャパンに2025年5月に入社した医学統括本部の責任者です。医師免許を持ち、製薬業界にて豊富な経験と知識を培ってきたアリスは、そのリーダーシップで組織の成長と成功を牽引しています。&lt;/span>&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
