                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;body-unica-20-reg&quot;>アッヴィのコーポレートサイトでは、アラガン・エステティックスの社員のインタビュー動画も掲載しています。&lt;br>&#xa; こちらもぜひご覧ください。&lt;/span>&lt;/p>&#xa;&lt;p>&lt;span class=&quot;body-unica-20-reg&quot;>&lt;a href=&quot;https://abbviejp.gallery.video/detail/videos/%E3%81%99%E3%81%B9%E3%81%A6%E3%81%AE%E5%8B%95%E7%94%BB/video/6331841604112?autoStart=true&quot; target=&quot;_blank&quot;>～美容医療で日本を明るく～ わたしたちが美容医療業界を選んだ理由、そしてこれからの挑戦&lt;/a>&lt;/span>&lt;/p>&#xa;"
