                                        sling:resourceType="abbvie-com2/components/text/v2/text"
                                        text="&lt;p>&lt;span class=&quot;body-unica-26-reg&quot;>&lt;span class=&quot;body-unica-26-reg&quot;>アッヴィ合同会社の美容医療部門 アラガン・エステティックスでは、採用セミナーを開催します。&lt;br>&#xd;&#xa;&lt;span class=&quot;body-unica-26-reg&quot;>&lt;span class=&quot;body-unica-26-reg&quot;>ご興味のある方は、お気軽にご参加ください。&lt;/span>&lt;/span>&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
