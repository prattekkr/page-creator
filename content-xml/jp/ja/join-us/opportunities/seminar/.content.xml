                                langAttribute="none"
                                text="&lt;table cellpadding=&quot;10&quot; cellspacing=&quot;0&quot; border=&quot;1&quot;>&#xd;&#xa;&lt;tbody>&lt;tr>&lt;td>&lt;p style=&quot;text-align: left;&quot;>&lt;span class=&quot;body-unica-20-reg&quot;>&lt;span data-rte-class=&quot;rte-temp&quot;>日時&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;&lt;/td>&#xd;&#xa;&lt;td style=&quot;text-align: left;&quot;>&lt;p style=&quot;text-align: left;&quot;>&lt;span class=&quot;body-unica-20-reg&quot;>2026年7月7日（火）19:00-20:00&lt;/span>&lt;/p>&#xd;&#xa;&lt;/td>&#xd;&#xa;&lt;/tr>&lt;tr>&lt;td style=&quot;text-align: left;&quot;>&lt;span class=&quot;body-unica-20-reg&quot;>&lt;span data-rte-class=&quot;rte-temp&quot;>形式&lt;/span>&lt;/span>&lt;/td>&#xd;&#xa;&lt;td style=&quot;text-align: left;&quot;>&lt;span class=&quot;body-unica-20-reg&quot;>&lt;span data-rte-class=&quot;rte-temp&quot;>オンライン（Zoom）&lt;/span>&lt;/span>&lt;/td>&#xd;&#xa;&lt;/tr>&lt;tr>&lt;td style=&quot;text-align: left;&quot;>&lt;span class=&quot;body-unica-20-reg&quot;>対象者&lt;/span>&lt;/td>&#xd;&#xa;&lt;td style=&quot;text-align: left;&quot;>&lt;span class=&quot;body-unica-20-reg&quot;>&lt;span data-rte-class=&quot;rte-temp&quot;>MR認定資格を保持されている方&lt;/span>&lt;/span>&lt;/td>&#xd;&#xa;&lt;/tr>&lt;tr>&lt;td style=&quot;text-align: left;&quot;>&lt;span class=&quot;body-unica-20-reg&quot;>申し込み方法&lt;/span>&lt;/td>&#xd;&#xa;&lt;td style=&quot;text-align: left;&quot;>&lt;span class=&quot;body-unica-20-reg&quot;>&lt;a href=&quot;https://abbvie.zoom.us/webinar/register/WN_EjaLYtU1ShCTHzECzZguIA&quot; target=&quot;_blank&quot;>こちら&lt;/a>をクリックいただき、ご登録ください。&lt;/span>&lt;/td>&#xd;&#xa;&lt;/tr>&lt;/tbody>&lt;/table>&#xd;&#xa;&lt;p>&amp;nbsp;&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
