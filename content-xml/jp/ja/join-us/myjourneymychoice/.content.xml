                                            dataPriority="1"/>
                                        <item1
                                            jcr:primaryType="nt:unstructured"
                                            columnWidth="6"
                                            dataPriority="1"/>
                                    </columns>
                                    <par_11
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="wcm/foundation/components/parsys">
                                        <text_441457603_copy_
                                            cq:styleIds="[1659545825678]"
                                            jcr:created="{Date}2022-12-10T17:16:00.094-05:00"
                                            jcr:createdBy="chiucx"
                                            jcr:lastModified="{Date}2026-01-07T20:41:00.519-05:00"
                                            jcr:lastModifiedBy="tadankx"
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="abbvie-com2/components/text/v2/text"
                                            text="&lt;p>&lt;b>エリアパートナー制度&lt;/b>&lt;/p>&#xd;&#xa;&lt;ul>&#xd;&#xa;&lt;li>居住地域を選択&lt;/li>&#xd;&#xa;&lt;li>居住する地域近郊でのキャリア形成&lt;/li>&#xd;&#xa;&lt;li>異動はあるが転勤（転居）はなし&lt;/li>&#xd;&#xa;&lt;li>ライフステージに合わせて選択可能&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;"
                                            textIsRich="true"/>
                                    </par_11>
                                    <par_12
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="wcm/foundation/components/parsys">
                                        <text_441457603_copy__1633763289
                                            cq:styleIds="[1659545825678]"
                                            jcr:created="{Date}2022-12-10T17:16:00.094-05:00"
                                            jcr:createdBy="chiucx"
                                            jcr:lastModified="{Date}2026-01-07T20:41:37.395-05:00"
                                            jcr:lastModifiedBy="tadankx"
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="abbvie-com2/components/text/v2/text"
                                            text="&lt;p>&lt;b>ナショナルパートナー制度&lt;/b>&lt;/p>&#xd;&#xa;&lt;ul>&#xd;&#xa;&lt;li>多様な地域、幅広い顧客層の対応経験&lt;/li>&#xd;&#xa;&lt;li>全国で多様なキャリア形成&lt;/li>&#xd;&#xa;&lt;li>原則4年以内に転勤&lt;/li>&#xd;&#xa;&lt;li>転勤に伴う福利厚生を充実&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;"
                                            textIsRich="true"/>
                                    </par_12>
