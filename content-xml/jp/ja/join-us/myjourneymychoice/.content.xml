                                    jcr:lastModified="{Date}2026-01-07T20:37:44.469-05:00"
                                    jcr:lastModifiedBy="tadankx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>転勤のない新しい働き方「エリアパートナ制度」を営業職（MR・エリアマネジャー）に2026年1月1日から導入しました。&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <separator_copy_copy_
                                    cq:styleIds="[1662756423318]"
                                    jcr:created="{Date}2024-03-05T21:46:02.634-05:00"
