                                jcr:primaryType="nt:unstructured"
                                jcr:title="参考情報 「働きがいのある会社」認定について"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h4"
                                variant="h"/>
                            <text_336104951
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2024-04-11T23:34:59.343-04:00"
                                jcr:createdBy="tadankx"
                                jcr:lastModified="{Date}2024-05-15T00:32:58.427-04:00"
                                jcr:lastModifiedBy="ASHIKAX"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>働く人へのアンケートの結果を基に、優れた職場文化に基づいた「働きがいのある会社」であることをGreat Place to Work&lt;sup>®&lt;/sup> Institute Japanが正式に認定するものです。&lt;/p>&#xa;&lt;p>働きがい認定企業についてはこちらをご覧ください。&lt;br>&#xa;&lt;a href=&quot;https://hatarakigai.info/ranking/certified_companies/&quot; target=&quot;_blank&quot;>https://hatarakigai.info/ranking/certified_companies/&lt;/a>&lt;/p>&#xa;"
                                textIsRich="true"/>
                            <separator_copy
                                cq:styleIds="[1662756502570]"
                                jcr:created="{Date}2024-04-11T23:34:37.565-04:00"
                                jcr:createdBy="tadankx"
                                jcr:lastModified="{Date}2024-04-11T23:34:37.565-04:00"
                                jcr:lastModifiedBy="tadankx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <title_copy
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2024-04-11T23:33:46.411-04:00"
                                jcr:createdBy="tadankx"
                                jcr:lastModified="{Date}2024-05-15T00:32:26.080-04:00"
                                jcr:lastModifiedBy="ASHIKAX"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="Great Place to Work® Institute Japanについて"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h4"
                                variant="h"/>
                            <text_336104951_copy
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2024-04-11T23:34:59.343-04:00"
                                jcr:createdBy="tadankx"
                                jcr:lastModified="{Date}2024-05-15T03:04:40.125-04:00"
                                jcr:lastModifiedBy="ASHIKAX"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Great Place to Work&lt;sup>®&lt;/sup> Instituteは、世界約100カ国に展開し、「働きがいのある会社」を世界共通の基準で調査・分析、各国のHPや主要メディア等で発表しています。米国では、1998年より「FORTUNE」を通じて毎年「働きがいのある会社」ランキングを発表しており、同国ではこのランキングに名を連ねることが「一流企業の証」として認められています。日本においては、株式会社働きがいのある会社研究所がGreat Place to Work&lt;sup>®&lt;/sup> Instituteよりライセンスを受け、Great Place to Work&lt;sup>®&lt;/sup> Institute Japan（GPTWジャパン）を運営しています。&lt;/p>&#xa;&lt;p>&lt;a href=&quot;https://hatarakigai.info/&quot; target=&quot;_blank&quot;>https://hatarakigai.info/&lt;/a>&lt;/p>&#xa;"
                                textIsRich="true"/>
