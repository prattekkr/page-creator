                                langAttribute="none"
                                type="h2"
                                variant="h"/>
                            <text_copy_copy
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2022-12-21T17:40:32.258-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2026-04-08T01:44:53.546-04:00"
                                jcr:lastModifiedBy="tadankx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                langAttribute="none"
                                text="&lt;p>欧州パーキンソン病協会（EPDA)と世界保健機関（WHO）が、パーキンソン病の周知を図るために、パーキンソン病を発見したイギリスのジェームズ・パーキンソン先生の誕生日である4月11日を世界パーキンソン病デーに制定されました。&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <text_copy_copy_copy
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2022-12-21T17:40:32.258-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2026-04-08T01:45:11.023-04:00"
                                jcr:lastModifiedBy="tadankx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                langAttribute="none"
                                text="&lt;p>パーキンソン病についての情報はこちらからご覧いただけます。&lt;br>&#xd;&#xa;&lt;a href=&quot;https://parkinson-smile.net/&quot; target=&quot;_blank&quot;>パーキンソンスマイル.net&lt;/a>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
