                            text="&lt;p style=&quot;text-align: right;&quot;>&lt;span class=&quot;body-unica-18-reg&quot;>&lt;b>【慢性リンパ性白血病（CLL）】&lt;/b>&lt;/span>&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
                        <text_1279756915
                            cq:styleIds="[1659545825678]"
                            jcr:created="{Date}2025-12-18T03:01:07.063-05:00"
