                                langAttribute="none"
                                text="&lt;table cellpadding=&quot;5&quot; cellspacing=&quot;0&quot; border=&quot;0&quot; style=&quot;margin: 0;&quot;>&#xd;&#xa;&lt;tbody>&lt;tr>&lt;td>&lt;span class=&quot;body-unica-20-reg&quot;>2026年3月26日&lt;/span>&lt;/td>&#xd;&#xa;&lt;td style=&quot;text-align: left;&quot;>&amp;nbsp;&lt;/td>&#xd;&#xa;&lt;td style=&quot;text-align: left;&quot;>&lt;span class=&quot;body-unica-20-reg&quot;>Seisen International School&lt;/span>&lt;/td>&#xd;&#xa;&lt;td style=&quot;text-align: left;&quot;>&lt;span class=&quot;body-unica-20-reg&quot;>22名&lt;/span>&lt;/td>&#xd;&#xa;&lt;/tr>&lt;/tbody>&lt;/table>&#xd;&#xa;"
