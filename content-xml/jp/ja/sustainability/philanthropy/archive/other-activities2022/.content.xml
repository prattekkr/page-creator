                                alt=" "
                                altValueFromDAM="false"
                                displayPopupTitle="true"
                                dmPresetType="imagePreset"
                                fileReference="/content/dam/abbvie-com2/japan/images/sustainability/philanthropy/other-activities/other-activities2022_1.jpg"
                                isDecorative="false"
                                titleValueFromDAM="true"/>
                            <separator_copy
