                                text="&lt;table cellpadding=&quot;10&quot; cellspacing=&quot;0&quot; border=&quot;0&quot;>&#xd;&#xa;&lt;tbody>&lt;tr>&lt;td style=&quot;border-bottom: 1px solid rgb(212, 212, 212);&quot;>&lt;span class=&quot;body-unica-20-reg&quot;>11月10日&lt;/span>&lt;/td>&#xd;&#xa;&lt;td style=&quot;border-bottom: 1.0px solid rgb(212,212,212); text-align: left;&quot;>&lt;span class=&quot;body-unica-20-reg&quot;>奈良県&lt;/span>&lt;/td>&#xd;&#xa;&lt;td style=&quot;border-bottom: 1.0px solid rgb(212,212,212); text-align: left;&quot;>&lt;span class=&quot;body-unica-20-reg&quot;>西大和学園高等学校&lt;/span>&lt;/td>&#xd;&#xa;&lt;td style=&quot;border-bottom: 1.0px solid rgb(212,212,212); text-align: left;&quot;>&lt;span class=&quot;body-unica-20-reg&quot;>28名&lt;/span>&lt;/td>&#xd;&#xa;&lt;/tr>&lt;tr>&lt;td style=&quot;border-bottom: 1.0px solid rgb(212,212,212); text-align: left;&quot;>&lt;span class=&quot;body-unica-20-reg&quot;>10月6日&lt;/span>&lt;/td>&#xd;&#xa;&lt;td style=&quot;border-bottom: 1.0px solid rgb(212,212,212); text-align: left;&quot;>&lt;span class=&quot;body-unica-20-reg&quot;>新潟県&lt;/span>&lt;/td>&#xd;&#xa;&lt;td style=&quot;border-bottom: 1.0px solid rgb(212,212,212); text-align: left;&quot;>&lt;span class=&quot;body-unica-20-reg&quot;>新潟県立長岡高等学校&lt;/span>&lt;/td>&#xd;&#xa;&lt;td style=&quot;border-bottom: 1.0px solid rgb(212,212,212); text-align: left;&quot;>&lt;span class=&quot;body-unica-20-reg&quot;>6名&lt;/span>&lt;/td>&#xd;&#xa;&lt;/tr>&lt;tr>&lt;td style=&quot;border-bottom: 1.0px solid rgb(212,212,212); text-align: left;&quot;>&lt;span class=&quot;body-unica-20-reg&quot;>8月5日&lt;/span>&lt;/td>&#xd;&#xa;&lt;td style=&quot;border-bottom: 1.0px solid rgb(212,212,212); text-align: left;&quot;>&lt;span class=&quot;body-unica-20-reg&quot;>福岡県&lt;/span>&lt;/td>&#xd;&#xa;&lt;td style=&quot;border-bottom: 1.0px solid rgb(212,212,212); text-align: left;&quot;>&lt;span class=&quot;body-unica-20-reg&quot;>福岡県立東筑高等学校&lt;/span>&lt;/td>&#xd;&#xa;&lt;td sty