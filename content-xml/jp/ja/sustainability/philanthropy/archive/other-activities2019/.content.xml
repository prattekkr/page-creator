                                jcr:lastModified="{Date}2024-07-03T20:44:47.847-04:00"
                                jcr:lastModifiedBy="tadankx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>2019年8月7日、新潟県立長岡高等学校の理数科2学年キャリアデザインツアーの訪問先としてアッヴィを選んだ6名の方を田町本社オフィスに迎えて、医薬品の開発に関する講義や、薬の有効性に関するワークショップを行いました。&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <image_copy
                                jcr:created="{Date}2024-04-25T03:46:54.430-04:00"
