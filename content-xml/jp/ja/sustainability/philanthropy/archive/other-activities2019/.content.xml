                                jcr:title="小学生の科学実験教室"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h3"
                                variant="h"/>
                            <text_copy
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2022-12-21T17:40:32.258-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2024-07-03T20:45:41.125-04:00"
                                jcr:lastModifiedBy="tadankx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>2019年8月24日、田町本社オフィスで、科学教育で地域社会に貢献することを目的に、地域の小学校4・5・6年生を対象に、科学実験教室「薬のコーティングってなに？」を行いました。午前・午後合わせて、27人の小学生と18人の保護者の方が参加しました。&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <image_copy_copy
                                jcr:created="{Date}2024-04-25T03:46:54.430-04:00"
                                jcr:createdBy="tadankx"
