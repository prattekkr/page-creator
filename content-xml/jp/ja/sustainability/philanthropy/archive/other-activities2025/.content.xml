                                jcr:lastModifiedBy="tadankx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;table cellpadding=&quot;5&quot; cellspacing=&quot;0&quot; border=&quot;0&quot; style=&quot;margin: 0;&quot;>&#xd;&#xa;&lt;tbody>&lt;tr>&lt;td>&lt;span class=&quot;body-unica-20-reg&quot;>2025年6月6日&lt;/span>&lt;/td>&#xd;&#xa;&lt;td style=&quot;text-align: left;&quot;>&lt;span class=&quot;body-unica-20-reg&quot;>東京都&lt;/span>&lt;/td>&#xd;&#xa;&lt;td style=&quot;text-align: left;&quot;>&lt;span class=&quot;body-unica-20-reg&quot;>田園調布学園中等部&lt;/span>&lt;/td>&#xd;&#xa;&lt;td style=&quot;text-align: left;&quot;>&lt;span class=&quot;body-unica-20-reg&quot;>15名&lt;/span>&lt;/td>&#xd;&#xa;&lt;/tr>&lt;tr>&lt;td>&lt;span class=&quot;body-unica-20-reg&quot;>2025年8月29日&lt;/span>&lt;/td>&#xd;&#xa;&lt;td>&lt;span class=&quot;body-unica-20-reg&quot;>東京都&lt;/span>&lt;/td>&#xd;&#xa;&lt;td>&lt;span class=&quot;body-unica-20-reg&quot;>東洋高等学校&lt;/span>&lt;/td>&#xd;&#xa;&lt;td>&lt;span class=&quot;body-unica-20-reg&quot;>11名&lt;/span>&lt;/td>&#xd;&#xa;&lt;/tr>&lt;/tbody>&lt;/table>&#xd;&#xa;"
