                                jcr:created="{Date}2022-11-28T14:09:56.113-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2024-03-07T02:41:27.296-05:00"
                                jcr:lastModifiedBy="tadankx"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="閲覧いただくにあたって"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h4"
                                variant="h"/>
                            <text_copy_copy_copy
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2022-12-07T14:53:09.069-05:00"
