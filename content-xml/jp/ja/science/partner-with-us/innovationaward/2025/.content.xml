                                    jcr:lastModifiedBy="tadankx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>&lt;span class=&quot;body-unica-20-reg&quot;>主催者であるアッヴィと米BioLabs社は、アッヴィの重点疾患領域である免疫疾患、がん、精神・神経疾患、アイケア、肥満症、美容医療において革新的な治療法を生み出す可能性のある科学や技術の研究開発を行っている、バイオテクノロジー企業または学術機関を対象に募集を行い、26件の応募の中から受賞者を決定しました。&lt;/span>&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <separator_copy_copy_22760336
                                    cq:styleIds="[1662756502570]"
                                    jcr:created="{Date}2025-05-20T23:06:59.641-04:00"
