                                    sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                                <title_copy_copy_copy_849577612
                                    cq:styleIds="[1659545825678,1661545829678,1651545825694]"
                                    jcr:lastModified="{Date}2026-06-04T01:32:31.646-04:00"
                                    jcr:lastModifiedBy="tadankx"
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="受賞者発表"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    langAttribute="none"
                                    type="h3"
                                    variant="h"/>
                                <text_copy_773278508
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2025-05-20T23:04:56.576-04:00"
                                    jcr:createdBy="tadankx"
                                    jcr:lastModified="{Date}2026-06-04T01:33:17.909-04:00"
                                    jcr:lastModifiedBy="tadankx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    langAttribute="none"
                                    text="&lt;ul>&#xd;&#xa;&lt;li>&lt;span class=&quot;body-unica-20-reg&quot;>2026年10月を予定しています。&lt;/span>&lt;/li>&#xd;&#xa;&lt;li>&lt;span class=&quot;body-unica-20-reg&quot;>選考プロセスの詳細は応募者に別途連絡予定。&lt;/span>&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <separator_copy_copy_
                                    cq:styleIds="[1662756456518]"
                                    jcr:created="{Date}2025-05-20T23:06:59.641-04:00"
                                    jcr:createdBy="tadankx"
