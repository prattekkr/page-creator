                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    langAttribute="none"
                                    text="&lt;p>&lt;span class=&quot;body-unica-20-reg&quot;>本アワードのゴールデン・チケットおよびアッヴィ・スペシャル・メンタリング・プログラムの授与に関して、受賞者およびアッヴィは、法規制ならびに双方が所属する団体等により定められた規定に従うものとします。&lt;/span>&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <separator_copy_copy__470775102
                                    cq:styleIds="[1662756456518]"
                                    jcr:created="{Date}2025-05-20T23:06:59.641-04:00"
                                    jcr:createdBy="tadankx"
                                    jcr:lastModified="{Date}2025-05-20T23:07:13.108-04:00"
