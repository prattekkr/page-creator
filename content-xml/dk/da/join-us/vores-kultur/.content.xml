                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>Vi tror på, at kulturen er grundlaget for, at vi kan opnå afgørende gennembrud. Hvordan vi når dertil, er lige så afgørende som resultatet.&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
