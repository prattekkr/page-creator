                                jcr:title="Inklusion. Samarbejdende. Innovation."
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h3"
                                variant="h"/>
                            <text_1044727654_copy
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2022-12-10T16:39:49.979-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2024-09-30T06:28:34.301-04:00"
                                jcr:lastModifiedBy="karotpb"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Siden AbbVie blev grundlagt, har det været vores overbevisning, at de mennesker, der arbejder her, er virksomhedens vigtigste aktiv og største konkurrencemæssige fordel. Vores arbejdsplads er præget af engagement, åbenhed og tillid til den enkeltes evner. Vi ønsker at skabe et nysgerrigt miljø, hvor alle kan bidrage ud fra på deres egen baggrund.&lt;/p>&#xd;&#xa;&lt;p>Som medarbejder i AbbVie er du dybt involveret i at skabe løsninger, der øger menneskers livskvalitet og bidrager til et langsigtet bæredygtigt sundhedsvæsen. For at nå vores mål har vi brug for de bedste medarbejdere, og vi stræber derfor efter at være verdens bedste arbejdsplads.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
