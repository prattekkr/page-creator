                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="Aligning our work with our Principles"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h3"/>
                                <text_copy_copy_copy
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2022-11-07T18:20:48.523-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2022-12-05T15:01:17.643-05:00"
                                    jcr:lastModifiedBy="chiucx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Our principles are the beliefs that we share. They shape our identity and the actions we take each day to take care of our communities and each other.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <text
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2025-04-21T18:02:37.802-04:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2025-04-21T18:04:46.382-04:00"
                                    jcr:lastModifiedBy="chiucx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>&lt;b>Transforming lives&lt;/b> - We inspire hope and transform lives every day. We make decisions based on our deep caring and compassion for people, delivering a lasting impact to our patients, their families, our employees and the community.&lt;/p>&#xd;&#xa;&lt;p>&lt;b>Acting with integrity &lt;/b>- We strive to always do the right thing. With uncompromising integrity at the heart of everything we do, we pursue the highest standards in quality, compliance, safety and performance.&lt;/p>&#xd;&#xa;&lt;p>&lt;b>Driving innovation&lt;/b> - We innovate relentlessly in everything we do to tackle unmet needs. We invest in the discovery and development of new medicines and healthcare approaches for a healthier world.&lt;/p>&#xd;&#xa;&lt;p>&lt;b>Embracing diversity &amp;amp; inclusion&lt;/b> - We treat everyone equally, with dignity and respect. Around the world, our employees embrace diverse backgrounds and perspectives which allows us all to achieve our best.&lt;/p>&#xd;&#xa;&lt;p>&lt;b>Serving the community&lt;/b> - We are proud to serve and support the community and do our part to protect the environment. We make a remarkable impact that's felt within healthcare and beyond.&lt;br>&#xd;&#xa;&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                            </par_13>
