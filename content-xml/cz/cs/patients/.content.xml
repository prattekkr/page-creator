                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>V&amp;nbsp;AbbVie&amp;nbsp;podporujeme&amp;nbsp;nezávislé vzdělávání zkušených zdravotníků a vědců studujících současné, nové a rozvíjející se vědecké obory.&lt;/p>&#xd;&#xa;"
