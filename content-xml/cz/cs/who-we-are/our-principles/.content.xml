                                jcr:lastModifiedBy="chiucx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/container/v2/container">
                                <text
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2022-11-28T14:12:33.220-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2026-03-25T08:31:50.677-04:00"
                                    jcr:lastModifiedBy="nandivx5"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    langAttribute="none"
                                    text="&lt;p>Naši zaměstnanci po celém světě si váží rozmanitosti&amp;nbsp;původu&amp;nbsp;i&amp;nbsp;názorů&amp;nbsp;a ke všem přistupují&amp;nbsp;stejně&amp;nbsp;-&amp;nbsp;&lt;br>&#xd;&#xa;s&amp;nbsp;úctou a respektem,&amp;nbsp;což nám umožňuje dosahovat&amp;nbsp;co nejlepších výsledků.&amp;nbsp;Jsme hrdí na to, že&amp;nbsp;podporujeme&amp;nbsp;komunity&amp;nbsp;a&amp;nbsp;přispíváme&amp;nbsp;k&amp;nbsp;ochraně životního prostředí, čímž vytváříme trvalý dopad, který je&amp;nbsp;patrný&amp;nbsp;ve zdravotnictví i mimo něj.&lt;/p>&#xd;&#xa;&lt;p>To, co děláme, není snadné, ale vytrváváme, protože&amp;nbsp;naše úspěchy přinášejí&amp;nbsp;naději a mění životy&amp;nbsp;–&amp;nbsp;&lt;br>&#xd;&#xa;každý den.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                            </container>
                        </par_12>
                    </grid_copy>
                    <accordion
                        cq:styleIds="[4,8]"
                        jcr:created="{Date}2022-12-20T16:08:57.224-05:00"
