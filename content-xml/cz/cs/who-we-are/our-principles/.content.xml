                        heading=" NAŠE PRINCIPY "
                        headingElement="h5"
                        id="accordion"
                        singleExpansion="false">
                        <item_1671570554123
                            cq:panelTitle="Měníme životy"
                            cq:styleIds="[1659545825678]"
                            jcr:lastModified="{Date}2026-04-17T01:34:16.506-04:00"
                            jcr:lastModifiedBy="singarx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            langAttribute="none"
                            text="&lt;p>Každý den&amp;nbsp;přinášíme&amp;nbsp;naději a&amp;nbsp;měníme&amp;nbsp;životy.&amp;nbsp;Naše rozhodnutí&amp;nbsp;jsou založena&amp;nbsp;na hlubokém&amp;nbsp;zájmu&amp;nbsp;a soucitu s lidmi,&amp;nbsp;čímž&amp;nbsp;vytváříme&amp;nbsp;trvalý dopad na naše pacienty, jejich rodiny,&amp;nbsp;naše&amp;nbsp;zaměstnance&amp;nbsp;i komunity.&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
                        <item_1671570557396
                            cq:panelTitle="Bezúhonné jednání "
                            cq:styleIds="[1659545825678]"
                            jcr:lastModified="{Date}2026-01-30T06:34:52.155-05:00"
                            jcr:lastModifiedBy="nandivx5"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>Snažíme se vždy jednat správně.&amp;nbsp;S nekompromisní&amp;nbsp;bezúhonností&amp;nbsp;jako základem všeho, co děláme, usilujeme o nejvyšší standardy v oblasti kvality, dodržování předpisů, bezpečnosti a výkonnosti. &lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
                        <item_1671570603045
                            cq:panelTitle="Podpora inovací"
                            cq:styleIds="[1659545825678]"
                            jcr:lastModified="{Date}2026-03-25T08:27:54.376-04:00"
                            jcr:lastModifiedBy="nandivx5"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            langAttribute="none"
                            text="&lt;p>Neustále&amp;nbsp;usilujeme&amp;nbsp;o inovace ve všem, co děláme, abychom&amp;nbsp;řešili&amp;nbsp;nenaplněné&amp;nbsp;&lt;br>&#xd;&#xa;potřeby.&amp;nbsp;Investujeme&amp;nbsp;do&amp;nbsp;výzkumu&amp;nbsp;a vývoje nových léků a přístupů ke zdravotní péči pro zdravější svět.&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
                        <item_1671570607019
                            cq:panelTitle="Přijímání diverzity a inkluze "
                            cq:styleIds="[1659545825678]"
                            jcr:lastModified="{Date}2026-01-30T06:37:01.346-05:00"
                            jcr:lastModifiedBy="nandivx5"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>Ke všem přistupujeme stejně, s důstojností a respektem.&amp;nbsp;Naši zaměstnanci po celém světě&amp;nbsp;si váží rozmanitosti původu i názorů, což nám umožňuje dosahovat&amp;nbsp;co&amp;nbsp;nejlepších výsledků. &lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
                        <item_1671570609829
                            cq:panelTitle="Podpora komunit "
                            cq:styleIds="[1659545825678]"
                            jcr:lastModified="{Date}2026-01-30T06:37:19.509-05:00"
                            jcr:lastModifiedBy="nandivx5"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>Jsme hrdí na to, že podporujeme&amp;nbsp;komunity&amp;nbsp;a&amp;nbsp;přispíváme k&amp;nbsp;ochraně životního prostředí.&amp;nbsp;Vytváříme&amp;nbsp;významný&amp;nbsp;dopad, který je patrný&amp;nbsp;ve zdravotnictví i mimo něj. &lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
                    </accordion>
