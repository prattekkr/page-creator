                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;body-unica-32-reg&quot;>Přijetí&amp;nbsp;principů&amp;nbsp;spravedlnosti, rovnosti,&amp;nbsp;diverzity&amp;nbsp;a inkluze je v&amp;nbsp;AbbVie&amp;nbsp;zásadní. Jsme hrdí na to, že&amp;nbsp;vytváříme&amp;nbsp;prostředí, které našim kolegům po celém světě umožňuje dosahovat&amp;nbsp;jejich plného potenciálu.&lt;/span>&lt;/p>&#xd;&#xa;"
