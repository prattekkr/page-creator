                            <text
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2026-02-16T08:42:04.503-05:00"
                                jcr:lastModifiedBy="nandivx5"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>Náš závazek přinášet pozitivní&amp;nbsp;dopad&amp;nbsp;pro&amp;nbsp;svět je základem všeho, co děláme. Pomáháme komunitám po celém světě zasaženým přírodními katastrofami a humanitárními krizemi&amp;nbsp;darováním&amp;nbsp;&lt;br>&#xd;&#xa; nezbytných&amp;nbsp;léků&amp;nbsp;AbbVie, poskytováním&amp;nbsp;potřebných zdrojů&amp;nbsp;&lt;br>&#xd;&#xa;neziskovým partnerům a finanční podporou&amp;nbsp;zaměstnancům a jejich rodinám, kteří byli&amp;nbsp;zasaženi&amp;nbsp;katastrofami.&amp;nbsp;&lt;/span>&lt;/span>&lt;br>&#xd;&#xa;&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator
                                cq:styleIds="[1662756456518]"
                                jcr:created="{Date}2024-04-22T11:58:18.748-04:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2024-04-22T11:58:18.748-04:00"
                                jcr:lastModifiedBy="chiucx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <text2_copy
                                cq:styleIds="[1659545825678,1659545835858]"
                                jcr:lastModified="{Date}2026-02-16T08:41:29.176-05:00"
                                jcr:lastModifiedBy="nandivx5"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Nadace&amp;nbsp;AbbVie&amp;nbsp;Foundation&amp;nbsp;rovněž znásobuje finanční dary zaměstnanců&amp;nbsp;zvoleným&amp;nbsp;neziskovým&amp;nbsp;organizacím, které&amp;nbsp;poskytují&amp;nbsp;pomoc v zasažených oblastech,&amp;nbsp;a&amp;nbsp;tím&amp;nbsp;umožňuje&amp;nbsp;zaměstnancům&amp;nbsp;aktivně&amp;nbsp;přispět k&amp;nbsp;zdravějšímu&amp;nbsp;&lt;br>&#xd;&#xa;světu&amp;nbsp;v době, kdy je to nejvíce potřeba.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
