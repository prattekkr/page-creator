                        <accordion
                            cq:styleIds="[1]"
                            jcr:created="{Date}2025-08-29T05:16:00.254-04:00"
                            jcr:createdBy="singarx"
                            jcr:lastModified="{Date}2026-03-25T06:12:32.526-04:00"
                            jcr:lastModifiedBy="nandivx5"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/accordion/v2/accordion"
                            heading="OBLASTI ZÁJMU"
                            singleExpansion="false">
                            <item_1756459771735
                                cq:panelTitle="Psychiatrické poruchy"
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2026-04-14T01:41:57.719-04:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                langAttribute="none"
                                text="&lt;p>Psychiatrické&amp;nbsp;poruchy&amp;nbsp;jsou&amp;nbsp;velmi&amp;nbsp;rozšířené&amp;nbsp;–&amp;nbsp;celosvětově&amp;nbsp;postihují&amp;nbsp;přibližně&amp;nbsp;každého&amp;nbsp;osmého&amp;nbsp;člověka&amp;nbsp;a&amp;nbsp;patří&amp;nbsp;&lt;br>&#xd;&#xa;mezi&amp;nbsp;hlavní&amp;nbsp;zdravotní&amp;nbsp;problémy.&amp;nbsp;Projevují&amp;nbsp;se&amp;nbsp;širokou&amp;nbsp;škálou&amp;nbsp;příznaků,&amp;nbsp;které&amp;nbsp;mohou&amp;nbsp;ovlivnit&amp;nbsp;náladu,&amp;nbsp;myšlení,&amp;nbsp;&lt;br>&#xd;&#xa;chování&amp;nbsp;i&amp;nbsp;celkové&amp;nbsp;duševní&amp;nbsp;fungování.&amp;nbsp;V posledních 30 letech se naši vědci a kliničtí pracovníci zabývali komplexností duševních poruch, a proto dnes nabízíme portfolio léků pro léčbu deprese, úzkosti, bipolární poruchy až po schizofrenii.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <item_1756459816709
                                cq:panelTitle="Migréna"
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2026-04-14T01:40:15.804-04:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                langAttribute="none"
                                text="&lt;p>Je to víc než jen bolest hlavy. Migréna, která celosvětově postihuje až 1 miliardu lidí, je závažné neurologické onemocnění, které způsobuje bolest a má vyčerpávající příznaky.&lt;br>&#xd;&#xa;&lt;br>&#xd;&#xa;Navazujeme na naše vedoucí postavení v oblasti léčby migrény, s terapiemi navrženými tak, aby odpovídaly potřebám pacientů napříč celým spektrem onemocnění. Neúnavně usilujeme o inovativní přístupy, jež mohou změnit budoucnost léčby migrény. Patří sem hodnocení akutních i preventivních terapií zaměřených na základní mechanismy migrény a vývoj léků nové generace, které mohou pomoci pacientům nereagujícím na současné terapie a zároveň řešit i symptomy jiné než bolest hlavy.&amp;nbsp;&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <item_1756459879819
                                cq:panelTitle="Poruchy hybnosti"
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2026-02-17T04:04:10.264-05:00"
                                jcr:lastModifiedBy="nandivx5"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Od&amp;nbsp;Parkinsonovy&amp;nbsp;choroby&amp;nbsp;až&amp;nbsp;po&amp;nbsp;specifické&amp;nbsp;typy&amp;nbsp;spasticity,&amp;nbsp;esenciální&amp;nbsp;tremor a&amp;nbsp;další,&amp;nbsp;naše&amp;nbsp;odhodlání&amp;nbsp;vůči&amp;nbsp;&lt;br>&#xd;&#xa;lidem&amp;nbsp;žijícím&amp;nbsp;s&amp;nbsp;poruchami&amp;nbsp;hybnosti&amp;nbsp;je&amp;nbsp;neochvějné. Tato&amp;nbsp;chronická&amp;nbsp;a&amp;nbsp;progresivní&amp;nbsp;onemocnění&amp;nbsp;ovlivňují&amp;nbsp;&lt;br>&#xd;&#xa;schopnost&amp;nbsp;těla&amp;nbsp;kontrolovat&amp;nbsp;pohyb.&amp;nbsp;Uvědomujeme&amp;nbsp;si&amp;nbsp;hluboký&amp;nbsp;dopad,&amp;nbsp;který&amp;nbsp;tato&amp;nbsp;onemocnění&amp;nbsp;mají&amp;nbsp;na&amp;nbsp;kvalitu&amp;nbsp;&lt;br>&#xd;&#xa;života, a&amp;nbsp;naše&amp;nbsp;specializované&amp;nbsp;týmy&amp;nbsp;se&amp;nbsp;soustředí&amp;nbsp;na&amp;nbsp;porozumění&amp;nbsp;jejich&amp;nbsp;základním&amp;nbsp;příčinám, aby&amp;nbsp;mohly&amp;nbsp;vyvíjet&amp;nbsp;terapie,&amp;nbsp;které&amp;nbsp;pomáhají&amp;nbsp;zmírnit&amp;nbsp;příznaky&amp;nbsp;a&amp;nbsp;potenciálně&amp;nbsp;upravit&amp;nbsp;nebo&amp;nbsp;zpomalit&amp;nbsp;průběh&amp;nbsp;&lt;br>&#xd;&#xa;onemocnění.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <item_1771318905008
                                cq:panelTitle="Neurodegenerativní poruchy"
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2026-03-25T06:11:49.506-04:00"
                                jcr:lastModifiedBy="nandivx5"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                langAttribute="none"
                                text="&lt;p>Neurodegenerativní poruchy jsou skupinou onemocnění, při nichž postupně degeneruje struktura a funkce nervového systému. Často vedou ke zhoršení kognitivních a fyzických schopností a ovlivňují paměť, pohyb i celkovou mozkovou funkci. Postihují více než 50 milionů lidí na celém světě a jejich počet s postupujícím stárnutím populace nadále poroste. Díky našim hlubokým znalostem biologie onemocnění a využití nejmodernějších technologií posouváme výzkum kupředu, abychom vyvíjeli terapie, které zmírňují příznaky nebo zpomalují průběh onemocnění, například u Alzheimerovy choroby, amyotrofické laterální sklerózy (ALS) či nemoci mizející bílé hmoty.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                        </accordion>
