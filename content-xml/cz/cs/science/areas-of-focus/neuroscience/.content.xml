                        <text
                            cq:styleIds="[1659545825678]"
                            jcr:created="{Date}2025-08-29T05:12:08.748-04:00"
                            jcr:createdBy="singarx"
                            jcr:lastModified="{Date}2026-04-14T01:47:52.365-04:00"
                            jcr:lastModifiedBy="singarx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            langAttribute="none"
                            text="&lt;p>Naše&amp;nbsp;vývojová řada v oblasti neurověd zahrnuje inovativní experimentální léky, včetně symptomatické terapie,&amp;nbsp;přístupů modifikujících průběh onemocnění, terapeutických toxinů a dalších špičkových strategií pro léčbu poruch mozku. Na základě zkušeností z více než tří desetiletí výzkumu se zaměřujeme na čtyři klíčové oblasti.&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
                        <separator
                            jcr:created="{Date}2025-08-29T05:14:37.442-04:00"
