                                    jcr:createdBy="nandivx5"
                                    jcr:lastModified="{Date}2026-02-17T04:16:47.571-05:00"
                                    jcr:lastModifiedBy="nandivx5"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Náš tým je připraven se s vámi setkat, aby&amp;nbsp;se s vámi&amp;nbsp;podělil&amp;nbsp;o naše možnosti a prodiskutoval&amp;nbsp;vaše obchodní příležitosti. Vždy hledáme inovace a nové možnosti partnerství, které jsou v souladu s našimi oblastmi zájmu. Máme kanceláře v severní Kalifornii, Chicagu a Bostonu a na dalších místech po celém světě.&amp;nbsp;Těšíme se, že se nám ozvete.&lt;/p>&#xd;&#xa;&lt;p>&lt;a href=&quot;https://abbvie.partneringplace.com/SubmissionUI/abbvie/submission&quot; target=&quot;_blank&quot;>Kontaktujte&amp;nbsp;nás&lt;/a> se svým nápadem.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
