                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>K rozvoji a udržování našich partnerství přistupujeme velice&amp;nbsp;komplexně&amp;nbsp;–&amp;nbsp;s našimi partnery&amp;nbsp;pracujeme jako jeden propojený celek, abychom podpořili vědecký pokrok. Spolupráce má zásadní význam pro náš vlastní úspěch i pro úspěch celého odvětví.&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
