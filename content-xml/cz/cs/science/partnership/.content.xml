                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="Jak spolupracujeme"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    langAttribute="none"
                                    type="h3"
                                    variant="h"/>
                                <text_920044543
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2026-02-16T04:47:14.256-05:00"
                                    jcr:createdBy="nandivx5"
                                    jcr:lastModified="{Date}2026-03-25T03:49:59.049-04:00"
                                    jcr:lastModifiedBy="nandivx5"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    langAttribute="none"
                                    text="&lt;p>&lt;b>Vyhledávání a hodnocení (S&amp;amp;E)&lt;br>&#xd;&#xa; &lt;/b>Zaměřujeme se na vyhledávání a vyhodnocování nových příležitostí, které doplňují a posilují naše stávající interní inovační strategie.&amp;nbsp;V rámci&amp;nbsp;S&amp;amp;E úzce spolupracujeme&amp;nbsp;s našimi výzkumnými a obchodními týmy, BD&amp;amp;A a podniky, abychom&amp;nbsp;promyšleně řešili&amp;nbsp;každou příležitost.&lt;/p>&#xd;&#xa;&lt;p>&lt;b>Rozvoj obchodu a akvizice (BD&amp;amp;A)&amp;nbsp;&lt;br>&#xd;&#xa; &lt;/b>Posuzujeme různé partnerské struktury, abychom uspokojili potřeby obou stran. BD&amp;amp;A úzce spolupracuje s oddělením výzkumu a vývoje i s našimi obchodními a výzkumnými týmy při vyhodnocování nových příležitostí.&amp;nbsp;&lt;/p>&#xd;&#xa;&lt;p>&lt;b>Globální aliance&lt;br>&#xd;&#xa; &lt;/b>Vysoce úspěšná partnerství jsou výsledkem trvalého závazku realizovat společnou vizi.&amp;nbsp;V AbbVie máme specializovaný tým, který se podílí na všech aspektech partnerství od uzavření smlouvy až po komercializaci.&lt;/p>&#xd;&#xa;&lt;p>&lt;b>Partnerství AbbVie&lt;br>&#xd;&#xa; &lt;/b>Strategicky investujeme do průlomových vědeckých příležitostí, abychom rozšířili naše klíčové zájmy ve výzkumu a vývoji a získali přístup k vědeckým poznatkům nové generace a zkušeným lídrům v oboru. Naše odborné znalosti ve vývoji a komercializaci léčiv mohou být cenným zdrojem i pro společnosti v nejranější fázi vývoje.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <separator_copy
                                    cq:styleIds="[1662756486159]"
                                    jcr:created="{Date}2026-02-16T04:46:34.311-05:00"
