                                <item_1670707220579
                                    cq:panelTitle="Allergan Aesthetics"
                                    cq:styleIds="[1659545825678]"
                                    jcr:lastModified="{Date}2026-02-16T06:07:56.631-05:00"
                                    jcr:lastModifiedBy="nandivx5"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Allergan&amp;nbsp;Aesthetics, divize&amp;nbsp;AbbVie,&amp;nbsp;vyvíjí, vyrábí a prodává portfolio předních značek a produktů&amp;nbsp;estetické medicíny. Staňte se součástí týmu, který věří v sílu důvěry.&amp;nbsp;&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <item_1670707211154
                                    cq:panelTitle="Komerční tým"
                                    cq:styleIds="[1659545825678]"
                                    jcr:lastModified="{Date}2026-02-16T06:08:11.825-05:00"
                                    jcr:lastModifiedBy="nandivx5"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Připojte se k týmům prodeje, marketingu a obchodní podpory, které propojují pacienty s novými terapiemi a řešeními, jež mohou pozitivně ovlivnit jejich životy.&amp;nbsp;&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <item_1670707214308
                                    cq:panelTitle="Korporátní tým"
                                    cq:styleIds="[1659545825678]"
                                    jcr:lastModified="{Date}2026-02-16T06:08:28.129-05:00"
                                    jcr:lastModifiedBy="nandivx5"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Najděte&amp;nbsp;nové způsoby, jak zvýšit naše&amp;nbsp;konkurenční výhody, podporujte&amp;nbsp;naše&amp;nbsp;lidi&amp;nbsp;a&amp;nbsp;veďte je&amp;nbsp;čestně&amp;nbsp;ve všem, co děláme.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <item_1670707217700
                                    cq:panelTitle="Provozní tým"
                                    cq:styleIds="[1659545825678]"
                                    jcr:lastModified="{Date}2026-04-14T07:06:09.262-04:00"
                                    jcr:lastModifiedBy="singarx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    langAttribute="none"
                                    text="&lt;p>Spolupracujte s globálním&amp;nbsp;týmem&amp;nbsp;odborníků&amp;nbsp;zodpovědných za&amp;nbsp;dodávky a distribuci&amp;nbsp;všech našich produktů&amp;nbsp;a zároveň za&amp;nbsp;některé&amp;nbsp;firemní&amp;nbsp;služby, jako například&amp;nbsp;správu budov, nákupy&amp;nbsp;či bezpečnost.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <item_1670707208042
                                    cq:panelTitle="Výzkum a vývoj"
                                    cq:styleIds="[1659545825678]"
                                    jcr:lastModified="{Date}2026-02-16T06:09:01.225-05:00"
                                    jcr:lastModifiedBy="nandivx5"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Pronikněte&amp;nbsp;na novou půdu v oblasti&amp;nbsp;výzkumu&amp;nbsp;a vývoje léků a&amp;nbsp;řešení a&amp;nbsp;podílejte se na tom, aby naše produkty a postupy splňovaly nejpřísnější regulační&amp;nbsp;standardy.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
