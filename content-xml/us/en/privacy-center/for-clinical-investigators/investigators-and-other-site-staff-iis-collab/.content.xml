                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                langAttribute="none"
                                text="&lt;p>AbbVie Inc. and Allergan plc are&amp;nbsp;&lt;a>&lt;/a>&lt;a href=&quot;https://news.abbvie.com/2020-05-08-AbbVie-Completes-Transformative-Acquisition-of-Allergan&quot;>a new combined company&lt;/a>.&amp;nbsp; To review the privacy notice for the combined company if your country of residence is not included on this page, please visit our&amp;nbsp;&lt;a>&lt;/a>&lt;a href=&quot;/content/abbvie-com2/us/en/privacy-center/privacy-notice.html&quot;>Privacy page&lt;/a>. For questions or to make requests with respect to your personal data, please&amp;nbsp;&lt;a>&lt;/a>&lt;a href=&quot;https://abbviemetadata.my.site.com/AbbvieDSRM/s/?language=en_US&quot;>click here&lt;/a>.&lt;/p>&#xd;&#xa;&lt;p>This Privacy Notice describes how AbbVie Inc. and its Affiliates process personal data of investigators and site staff participating in AbbVie-supported investigator initiated studies and collaborative research.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
