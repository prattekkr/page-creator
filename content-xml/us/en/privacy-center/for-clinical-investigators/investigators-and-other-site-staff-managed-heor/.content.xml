                            text="&lt;p>&lt;span class=&quot;body-unica-26-reg&quot;>&lt;b>For residents of EU countries or the UK&lt;/b>&lt;/span>&lt;/p>&#xd;&#xa;&lt;p>&lt;b data-rte-class=&quot;rte-temp&quot;>&lt;span class=&quot;body-unica-26-reg&quot;>&lt;b> HEOR Privacy Notice&lt;/b>&lt;/span>&lt;/b>&lt;/p>&#xd;&#xa;&lt;ul>&#xd;&#xa;&lt;li>&lt;a href=&quot;/content/dam/abbvie-com2/pdfs/privacy-center/investigators-and-other-site-staff-managed-heor/eu-residents/eu-privacy-notice-heor-abbVie-investigators-site-staff-24-april-2019.pdf&quot; target=&quot;_blank&quot;>English&lt;/a>&lt;/li>&#xd;&#xa;&lt;li>&lt;a href=&quot;/content/dam/abbvie-com2/pdfs/privacy-center/investigators-and-other-site-staff-managed-heor/eu-residents/french-eu-privacy-notice-heor-investigators-site-staff.pdf&quot; target=&quot;_blank&quot;>French&lt;/a>&lt;/li>&#xd;&#xa;&lt;li>&lt;a href=&quot;/content/dam/abbvie-com2/pdfs/privacy-center/investigators-and-other-site-staff-managed-heor/eu-residents/german-eu-privacy-notice-heor-investigators-site-staff.pdf&quot; target=&quot;_blank&quot;>German&lt;/a>&lt;/li>&#xd;&#xa;&lt;li>&lt;a href=&quot;/content/dam/abbvie-com2/pdfs/privacy-center/investigators-and-other-site-staff-managed-heor/eu-residents/italian-eu-privacy-notice-heor-investigators-site-staff.pdf&quot; target=&quot;_blank&quot;>Italian&lt;/a>&lt;/li>&#xd;&#xa;&lt;li>&lt;a href=&quot;/content/dam/abbvie-com2/pdfs/privacy-center/investigators-and-other-site-staff-managed-heor/eu-residents/spanish-eu-privacy-notice-heor-investigators-site-staff.pdf&quot; target=&quot;_blank&quot;>Spanish&lt;/a>&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;&lt;p>&lt;b data-rte-class=&quot;rte-temp&quot;>&lt;b data-rte-class=&quot;rte-temp&quot;>&lt;b data-rte-class=&quot;rte-temp&quot;>&lt;b data-rte-class=&quot;rte-temp&quot;>&lt;span class=&quot;body-unica-26-reg&quot;>&lt;b>For residents of countries outside the EU&lt;br>&#xd;&#xa; HEOR Privacy Notice&lt;/b>&lt;/span>&lt;/b>&lt;/b>&lt;/b>&lt;/b>&lt;/p>&#xd;&#