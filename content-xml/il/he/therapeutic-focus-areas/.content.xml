                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    langAttribute="none"
                                    text="&lt;p style=&quot;text-align: right;&quot;>אחוזים מהחולים בפסוריאזיס עשויים לפתח במהלך חייהם גם דלקת מפרקים פסוריאטית (Psoriatic Arthritis, PsA).&lt;br />&#xd;&#xa;דלקת מפרקים פסוריאטית היא מחלה ראומטית-אוטואימונית שבה מערכת החיסון תוקפת את המפרקים ולעתים גם גידים ורצועות. הדלקת גורמת לכאבים ביום ובלילה, בעיקר באזור הגב התחתון, בכפות הרגליים ובקרסוליים. כמו כן היא גורמת לנוקשות בוקר ולחמימות ונפיחות במפרקים. המחלה מאופיינת בתקופות של התלקחויות והפוגות, כאשר הדלקת והכאבים יכולים להוביל לתשישות קיצונית שעשויה להימשך ימים ואפילו שבועות.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
