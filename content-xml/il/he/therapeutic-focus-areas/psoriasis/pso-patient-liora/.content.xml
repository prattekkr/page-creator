                            <text_398730945_copy_
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2025-11-14T23:54:51.490-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2026-08-13T07:48:06.919-04:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                langAttribute="none"
                                text="&lt;p style=&quot;text-align: center;&quot;>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-26-reg&quot;>לעיתים זה מתחיל בצורה כמעט בלתי מורגשת, נגע קטן על העור, יובש קל או גרד שנראים כמו עניין חולף. אלא שעבור אנשים החיים עם פסוריאזיס, המפגש הראשוני עם המחלה עלול להיות מטעה. רבים מהם מגלים כי עם השנים המחלה הולכת וגוברת, הופכת לנוכחת ומשפיעה על כל רגע ביום - על הבחירות, על המפגשים החברתיים, ובעיקר על איכות החיים והדימוי העצמי. בהדרגה הם מסתגלים למגבלות שהמחלה כופה עליהם: מסתירים את הנגעים, מוותרים על בילויים, עד שהתחושה ש'ככה זה' הופכת לחלק מהשגרה. &lt;/span>&lt;/span>&lt;/p>&#xa;"
                                textIsRich="true"/>
                            <separator_879022297_
                                cq:styleIds="[1662756456518]"
                                jcr:created="{Date}2025-11-17T01:09:04.441-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-12-28T04:17:52.093-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <text_copy
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2025-11-20T03:36:23.847-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2026-08-13T06:15:49.308-04:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                langAttribute="none"
                                text="&lt;p>&lt;b>האתגר היומיומי: מחלה מטרידה ולא אסתטית&lt;/b>&lt;br>&#xd;&#xa;&lt;b>ליאורה דולגין&lt;/b> מתמודדת עם פסוריאזיס מזה שנים רבות. היא מתארת מחלה שאינה רק פיזית, אלא כזו שמלווה במצוקה רגשית משמעותית ובצורך מתמיד להסתיר מהסביבה.&lt;/p>&#xd;&#xa;&lt;p>&lt;b>&amp;quot;זו לא מחלה מדבקת, זו מחלה מטרידה מאוד ולא אסתטית. פתאום שמתי לב שהראש והקרקפת מאוד מגרדת... הופיעו לי קשקשים לבנים על הבגד... בהחבא פיזרתי מיד את הקשקשים שאיש לא יבחין בזאת. זה לא היה נעים&amp;quot;&lt;/b>.&lt;/p>&#xd;&#xa;&lt;p>כמו מטופלים רבים אחרים, גם ליאורה ניסתה לאורך השנים מגוון רחב של טיפולים – החל מכדורים, משחות וסטרואידים ועד לפוטותרפיה – ללא בהצלחה מספקת. הניסיונות הללו, לצד חוסר הוודאות, עלולים להוביל לתחושת ייאוש והשלמה עם המצב, מתוך מחשבה לפיה אין פתרון אחר.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <video
                                cq:styleIds="[1]"
                                jcr:created="{Date}2025-11-20T03:35:16.993-05:00"
                                jcr:createdBy="singarx"
