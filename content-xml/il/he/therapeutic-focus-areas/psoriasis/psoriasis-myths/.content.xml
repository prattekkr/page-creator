                                text="&lt;p style=&quot;text-align: right;&quot;>שירות לציבור. מוגש על ידי חברת AbbVie.&lt;br>&#xd;&#xa;IL-SKZD-250032 DEC 2025&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
