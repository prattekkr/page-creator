                                type="h2"
                                variant="h"/>
                            <text_700721356_copy__2041821477
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2025-01-29T09:50:49.682-05:00"
                                jcr:createdBy="gabayyx"
                                jcr:lastModified="{Date}2025-02-11T06:51:50.215-05:00"
                                jcr:lastModifiedBy="gabayyx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p style=&quot;text-align: right;&quot;>פסוריאזיס היא מחלה אוטואימונית דלקתית שאינה מדבקת. היא לא זיהומית. כמו שסוכרת אינה מדבקת - כך גם פסוריאזיס. לא באוויר, לא במגע, לא דרך הרוק ולא ביחסי מין.&lt;/p>&#xa;&lt;p style=&quot;text-align: right;&quot;>בקיצור, לא נכון&lt;/p>&#xa;"
                                textIsRich="true"/>
                            <separator_879022297__24835427
                                cq:styleIds="[1662756456518]"
