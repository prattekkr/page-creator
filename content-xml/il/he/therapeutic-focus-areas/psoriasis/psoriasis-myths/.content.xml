                                jcr:title="מיתוס 8: שמן עץ התה מועיל לפסוריאזיס"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h2"
                                variant="h"/>
                            <text_700721356_copy__1591335704
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2025-01-29T09:50:49.682-05:00"
                                jcr:createdBy="gabayyx"
                                jcr:lastModified="{Date}2025-02-11T06:52:39.356-05:00"
                                jcr:lastModifiedBy="gabayyx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p style=&quot;text-align: right;&quot;>בזכות האינטרנט והרשתות החברתיות נפוצו שיטות, תכשירים ורקיחות לטיפול בפסוריאזיס, שאין להם כל ביסוס מדעי. לפני שמנסים טיפול, חשוב להתייעץ עם רופא מומחה כי במקרה הטוב לא תהיה הטבה אבל במקרה הרע עלול להיגרם נזק. עד כמה שמפתה להקשיב לשכן או לחבר בפורום, תמיד היוועצו ברופא עור. כך למשל, לא נמצאו עדויות התומכות בשימוש בשיטות הבאות לטיפול בפסוריאזיס: אמבטיות שמן זית, שמן המפ, חלב נאקות, אכילת שום, חומץ תפוחים עבור קרקפת, כורכום, קפסאיצין ושמן עץ התה.&lt;/p>&#xa;&lt;p style=&quot;text-align: right;&quot;>בקיצור, לא נכון.&lt;/p>&#xa;"
                                textIsRich="true"/>
                            <text_700721356_copy__949823216
                                cq:styleIds="[1659545825678]"
