                                jcr:title="מיתוס 5: פסוריאזיס משפיעה רק על העור"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h2"
                                variant="h"/>
                            <text_700721356_copy__592956367
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2025-01-29T09:50:49.682-05:00"
                                jcr:createdBy="gabayyx"
                                jcr:lastModified="{Date}2025-02-11T06:50:55.657-05:00"
                                jcr:lastModifiedBy="gabayyx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p style=&quot;text-align: right;&quot;>פסוריאזיס פוגעת לא רק בעור. היא עלולה לפגוע גם במפרקים, לגרום לדלקת מפרקים פסוריאטית ולהוביל לנכות. מחקרים חדשים מתייחסים למחלה כחלק מ״סינדרום מטבולי״ שכולל מצבים כמו סוכרת, שומנים בדם והשמנת יתר. פסוריאזיס היא גם מחלה אוטואימונית, שמופיעה לעתים עם מחלות אוטואימוניות כמו קרוהן, או האשימוטו. וכמובן, היא קשורה לדיכאון וסטרס. שהרי המחלה היא נטל ועלולה לגרום לקשיים בזוגיות, בחיי חברה ובעבודה. העומס שיוצרת פסוריאזיס על המטופל גדול מאוד, וזה הוכח מחקרית. גם בהשוואה לסבל שנגרם ממחלות אחרות, מכאן החשיבות של טיפול יעיל במחלה ובהשלכות שלה.&lt;/p>&#xa;&lt;p style=&quot;text-align: right;&quot;>בקיצור, לא נכון.&lt;/p>&#xa;"
                                textIsRich="true"/>
                            <separator_879022297__2107441668
                                cq:styleIds="[1662756456518]"
                                jcr:created="{Date}2025-11-17T01:09:04.441-05:00"
