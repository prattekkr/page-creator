                            <text_copy
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2022-11-16T17:01:41.718-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2025-01-30T09:30:29.509-05:00"
                                jcr:lastModifiedBy="gabayyx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p style=&quot;text-align: right;&quot;>לאלו שמתמודדים עם פסוריאזיס יש מספיק על הראש. אין סיבה שהם יתמודדו גם עם תפיסות מוטעות, מיתוסים, תרופות סבתא ואמונות לא מבוססות. כדי לשנות את המצב, פנינו לד״ר אתי שגיא, רופאת עור ומין בכירה בבית חולים מאיר בכפר סבא ומנהלת מרפאה מקצועית במחוז שרון שומרון של שירותי בריאות כללית. אז קדימה, בואו נבין ביחד מה נכון ומה סתם מיתוס של פסוריאזיס.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_879022297__1213984075
                                cq:styleIds="[1662756456518]"
                                jcr:created="{Date}2025-11-17T01:09:04.441-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-12-28T04:17:52.093-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <title_copy_copy
                                cq:styleIds="[1659545825678,1651243825678,1651545825694]"
                                jcr:created="{Date}2025-01-30T04:42:22.864-05:00"
                                jcr:createdBy="gabayyx"
                                jcr:lastModified="{Date}2026-01-04T06:58:00.800-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="מיתוס 1: אי אפשר להגיע לעור נקי"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h2"
                                variant="h"/>
                            <text_700721356
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2025-01-29T09:50:49.682-05:00"
                                jcr:createdBy="gabayyx"
                                jcr:lastModified="{Date}2025-02-11T06:46:07.867-05:00"
                                jcr:lastModifiedBy="gabayyx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p style=&quot;text-align: right;&quot;>בעוד שבעבר הטיפולים אכן היו מוגבלים ביעילות וביכולת להביא לעור נקי מתסמינים, הרי שבעשור האחרון יש לעולם הרפואה אפשרויות חדשות &amp;nbsp;שיכולות להביא ל-90-100 אחוז עור נקי. ממש חל שיפור משמעותי ביעדים הטיפוליים. אבל אפילו כיום, יש מטופלים עם פסוריאזיס בדרגת חומרה בינונית-קשה שלא מודעים לכך שאפשר לתת להם מענה משמעותי. וחבל, כל מה שצריך זה לפנות לרופא עור המטפל בפסוריאזיס ולהתייעץ.&lt;/p>&#xa;&lt;p style=&quot;text-align: right;&quot;>בקיצור, לא נכון.&lt;/p>&#xa;"
                                textIsRich="true"/>
                            <separator_879022297__1638108054
                                cq:styleIds="[1662756456518]"
                                jcr:created="{Date}2025-11-17T01:09:04.441-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-12-28T04:17:52.093-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <title_copy_copy_copy
                                cq:styleIds="[1659545825678,1651243825678,1651545825694]"
                                jcr:created="{Date}2025-01-30T04:42:22.864-05:00"
                                jcr:createdBy="gabayyx"
                                jcr:lastModified="{Date}2026-01-04T06:58:07.265-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="מיתוס 2: צריך ללמוד לחיות עם הפגיעה באיכות החיים"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h2"
                                variant="h"/>
                            <text_700721356_copy
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2025-01-29T09:50:49.682-05:00"
                                jcr:createdBy="gabayyx"
                                jcr:lastModified="{Date}2025-02-11T06:46:44.029-05:00"
                                jcr:lastModifiedBy="gabayyx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p style=&quot;text-align: right;&quot;>פסוריאזיס היא מחלה כרונית והמטופל יפגוש אותה לאורך כל חייו. אז המחלה כאן, אבל זה לא אומר שהתסמינים חייבים להישאר. וכשאין תסמינים, הנוכחות של המחלה מתבטאת בעיקר בצורך לשמור על קשר עם הרופא המטפל ולהתעדכן בטיפולים חדשים. בכל מקרה חשוב לציין כי לחולי פסוריאזיס אין הגבלות ואין סיבה לפגיעה באיכות החיים&lt;br>&#xa;-- אפשר ללכת לשחות בים, לבוא במגע, להתחתן, לקיים יחסים, להחזיק תינוקות ולקבל חיסונים.&lt;/p>&#xa;&lt;p style=&quot;text-align: right;&quot;>בקיצור, לא נכון.&lt;/p>&#xa;"
                                textIsRich="true"/>
                            <separator_879022297__1682798674
                                cq:styleIds="[1662756456518]"
                                jcr:created="{Date}2025-11-17T01:09:04.441-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-12-28T04:17:52.093-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <title_copy_copy_copy_1871073465
                                cq:styleIds="[1659545825678,1651243825678,1651545825694]"
                                jcr:created="{Date}2025-01-30T04:42:22.864-05:00"
                                jcr:createdBy="gabayyx"
                                jcr:lastModified="{Date}2026-01-04T06:58:37.510-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="מיתוס 3: אסור לעשות קעקועים עם פסוריאזיס"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h2"
                                variant="h"/>
                            <text_700721356_copy_
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2025-01-29T09:50:49.682-05:00"
                                jcr:createdBy="gabayyx"
                                jcr:lastModified="{Date}2025-02-11T06:47:49.097-05:00"
                                jcr:lastModifiedBy="gabayyx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p style=&quot;text-align: right;&quot;>סביב כל פעולה שכרוכה בפגיעה בשלימות העור יכולה להיות התפרצות של הפסוריאזיס ולכן כדאי להיות ערים לכך ולהתייעץ עם רופא עור. התפרצות פסוריאזיס במקום של טראומה בעור מכונה ״תופעת קבנר״ והיא קשורה כנראה לתהליך הדלקתי. זה עלול לקרות בצורה מקומית אם עושים קעקוע, או הסרת שיער בלייזר למשל. אבל חשוב לציין שלהרבה מטופלים זה פשוט לא יקרה, ואפילו אם כן - זה זמני ואפשר לטפל בזה.&lt;/p>&#xd;&#xa;&lt;p style=&quot;text-align: right;&quot;>בקיצור, לרוב לא נכון.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_879022297__131085951
