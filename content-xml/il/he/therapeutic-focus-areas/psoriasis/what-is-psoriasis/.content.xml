                                        sling:resourceType="abbvie-com2/components/text/v2/text"
                                        text="&lt;p style=&quot;text-align: right;&quot;>&lt;b>&lt;span class=&quot;body-unica-26-reg&quot;>בישראל חיים כרבע מיליון אנשים עם פסוריאזיס, ולא כולם מודעים לכך שהיום ניתן להגיע לעור נקי מנגעים.&lt;br />&#xd;&#xa; מה הם תסמיני המחלה, אילו גורמי סיכון קיימים ומדוע פסוריאזיס משפיעה גם על מה שקורה מתחת לעור שלנו? התשובות כאן&lt;/span>&lt;/b>&lt;/p>&#xd;&#xa;"
                                        textIsRich="true"/>
