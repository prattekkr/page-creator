                            <separator_879022297__501972685
                                cq:styleIds="[1662756456518]"
                                jcr:created="{Date}2025-11-17T01:09:04.441-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-12-28T04:17:52.093-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <text
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2025-11-14T02:25:21.187-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-11-14T02:25:34.906-05:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>בראשית שנות ה-70, קומץ חולים בפסוריאזיס נסעו לטיפולים בים המלח ופגשו שם מטופלים כמותם, מכל העולם. הם למדו אז שמדינות המוצא של המטופלים הזרים מימנו את שהייתם בים המלח, בעוד שבאותה העת - משרד הבריאות הישראלי לא השתתף במימון עבור חולי פסוריאזיס כאן בארץ.&lt;br>&#xd;&#xa;&lt;br>&#xd;&#xa;האגודה נוסדה במטרה לשנות את המצב והיעד הראשון שקבעה לעצמה היה להביא את משרד הבריאות להשתתף בעלויות הטיפולים. ״המאבק ההוא נחל הצלחה״, מספרת קציר. ״כיום, קופות החולים מממנות לחולי פסוריאזיס מחצית מעלות השהייה בים המלח״. בימינו, האגודה מארגנת טיפולים בים המלח פעמיים בשנה ופועלת מול בתי המלון באזור בכדי לשריין חדרים במחירים אטרקטיביים, לרווחת המטופלים. במקרים פרטניים, אף ניתן למטופלים סיוע מוגדל.&lt;br>&#xd;&#xa;&lt;br>&#xd;&#xa;גם היום, עדיין ישנה בורות בכל הנוגע למחלת הפסוריאזיס, וקיימות סטיגמות שגויות רבות סביבה.,קובעת יונה קציר, מנכ&amp;quot;לית אגודת הפסוריאזיס הישראלית. ״יש עדיין אנשים בציבור שחושבים שפסוריאזיס זו מחלה מדבקת, נרתעים ממנה ומתרחקים ממי שמתמודד איתה. זאת למרות פעילות הסברה בתקשורת, צעדה שנתית שמקיימת האגודה אחת לשנה וקמפיינים להעלאת מודעות כמו ׳אתה יכול לחבק - זה לא מדבק׳״.&lt;br>&#xd;&#xa;&lt;br>&#xd;&#xa;כ 2-4% מהישראלים מתמודדים עם פסוריאזיס - מחלת עור דלקתית כרונית המאופיינת בנגעים אדומים ומגרדים על פני העור. המחלה עשויה להופיע בכל גיל וכשהיא מתלקחת על העור, קשה לפספס אותה. המשמעות היא שלצד ההתמודדות עם התסמינים הפיזיים, מזומנים למטופלים גם אתגרים רגשיים וחברתיים. ״יש למשל לא מעט צעירים עם פסוריאזיס שמתמודדים עם רגשות בושה סביב מחלתם. הם מתקשים למצוא זוגיות. מטופלים מבוגרים נתקלים לפעמים בקשיים כשהם מסבירים למעסיק שהתמודדות עם פסוריאזיס מצריכה בחלק מהמקרים לצאת לטיפולים שנתיים&amp;quot;, מסבירה קציר.&lt;br>&#xd;&#xa;&lt;br>&#xd;&#xa;בעשורים האחרונים זמינים למטופלים שלל טיפולים ביולוגים שמאפשרים התמודדות טובה יותר עם המחלה, לא מעט הודות לפעילותה של אגודת הפסוריאזיס הישראלית שנלחמה על הכללתם בסל התרופות והביאה את קופות החולים להכיר בכך שמדובר במחלה כרונית. הודות לכך, נקבעה תקרת תשלום לרבעון, שחוסכת למטופלים אלפי שקלים עבור כל טיפול. בזכות הטיפולים החדשים, בעידן הנוכחי אפשר לשאוף לעור נקי מפסוריאזיס וגם לטפל בתחלואה נלווית שאופיינית למחלה, כגון דלקת מפרקים פסוריאטית או מחלת קרוהן. &amp;quot;היום אנחנו יודעים שמי שאינו מטופל, סיכוייו לחלות בעודף משקל, לחץ דם או סוכרת גבוהים, כי מדובר במחלה רב &amp;quot;מערכתית&amp;quot;, אומרת קציר.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
