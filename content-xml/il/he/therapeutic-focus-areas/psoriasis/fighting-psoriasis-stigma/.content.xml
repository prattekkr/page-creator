                                type="h2"
                                variant="h"/>
                            <text_1393301392
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2025-11-14T02:28:12.384-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2026-03-04T05:17:23.202-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>האגודה גם לוקחת חלק במחקרים, עורכת כנסים והרצאות ומעדכנת בדבר חידושים והתפתחויות במחקר. חברותה בארגון הבינלאומי של עמותות פסוריאזיס מאפשרת לה להיות תמיד עם יד על הדופק. מעבר לכך, האגודה מפעילה קבוצות תמיכה לחולים, שבהן אפשר לחלוק תובנות, לדבר על קשיים ולהתמודד ביחד עם רגשות כמו בושה או דכאון, שהם מנת חלקם של לא מעט מטופלים. כמענה לאתגרים הללו, האגודה מעניקה למטופלים מעטפת רחבה של ייעוץ ותמיכה.&lt;/p>&#xd;&#xa;&lt;p>האגודה עושה מאמץ מיוחד לסייע לילדים שמתמודדים עם פסוריאזיס, שכן מדובר באוכלוסייה רגישה במיוחד לקשיים החברתיים והנפשיים שהמחלה מביאה עמה. &amp;quot;ההתמודדות של ילדים עם המחלה הרבה יותר קשה בהשוואה להתמודדות של מבוגר״, מדגישה קציר. לא פעם, נציגי האגודה מגיעים לבית ספר בו לומד ילד המתמודד עם פסוריאזיס, במטרה לסייע לו ולשוחח עם בני כיתתו על המחלה.&amp;nbsp;&lt;/p>&#xd;&#xa;&lt;p>אבל גולת הכותרת היא ללא ספק פעילות &amp;quot;קייטנת ילדי השמש&amp;quot;. הקייטנה מתקיימת מדי קיץ בים המלח, זה למעלה משלושה עשורים. הפעילות מסובסדת על ידי העמותה והמדריכים פועלים בהתנדבות. &amp;quot;זהו פרויקט חיינו&amp;quot;, אומרת יונה בסיפוק. ״בשגרת היומיום שלהם, לילדים עם פסוריאזיס אין כמעט אפשרות לפגוש ילדים אחרים במצב דומה. למשך 18 לילות, הקייטנה מאפשרת להם את זה. יש הורים שחוששים לשלוח את הילד אל מחוץ לבית לפרק זמן ממושך כל כך, אבל הם רואים מהר מאוד שהילדים מפסיקים להתקשר אליהם ועם סיום הקייטנה כולם עומדים ומתחבקים. ילדי הקייטנה הופכים להיות המשפחה השנייה שלהם&amp;quot;, היא מסכמת. &amp;quot;כשרואים את הילד מאושר ובנסיגה של המחלה - זה שווה הכל&amp;quot;.&lt;/p>&#xd;&#xa;&lt;p>לכן מאוד חשוב לנו שכל חולי הפסוריאזיס יצטרפו ויהיו חלק מהאגודה, כדי שנוכל להמשיך לפעול למען האינטרסים של כלל החולים, ביעילות מירבית. לפרטים נוספים..צור קשר&amp;nbsp;&lt;b>6247*&lt;br>&#xd;&#xa; &lt;br>&#xd;&#xa; &lt;a href=&quot;https://www.psoriasis.org.il/&quot; target=&quot;_blank&quot;>www.psoriasis.org.il&lt;/a>&lt;/b>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
