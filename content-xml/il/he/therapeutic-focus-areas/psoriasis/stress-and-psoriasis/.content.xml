                                type="h2"
                                variant="h"/>
                            <text_700721356_copy
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2025-01-29T09:50:49.682-05:00"
                                jcr:createdBy="gabayyx"
                                jcr:lastModified="{Date}2025-02-11T06:00:58.470-05:00"
                                jcr:lastModifiedBy="gabayyx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p style=&quot;text-align: right;&quot;>בטיפול התנהגותי-קוגניטיבי נבדוק את דפוסי החשיבה וההתנהגות וננסה לזהות את אלו אשר גורמים למצוקה או לפגיעה בתפקוד. ניתן למשל לזהות עיוותי חשיבה שיכולים להלחיץ אותנו. אפשר לזהות למשל מחשבה אצל המטופל – ׳אף אחת לא תרצה להיות איתי בגלל הנגעים, החיים שלי יהיו גרועים לנצח׳. צורת חשיבה זו בוודאי יכולה לגרום למתח רב ואף להוביל להימנעות מסיטואציות חברתיות. בטיפול התנהגותי-קוגניטיבי ננסה לבחון ולשנות את הפרשנות הקיצונית והשלילית ולעודד חשיפה הדרגתית מחודשת לאותן סיטואציות שמהן המטופל נוהג להימנע.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
