                                type="h2"
                                variant="h"/>
                            <text_700721356
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2025-01-29T09:50:49.682-05:00"
                                jcr:createdBy="gabayyx"
                                jcr:lastModified="{Date}2025-02-11T06:00:07.144-05:00"
                                jcr:lastModifiedBy="gabayyx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p style=&quot;text-align: right;&quot;>מיינדפולנס (קשיבות בעברית), היא גישה שמקורה במסורת הבודהיסטית ויש לה יעילות מוכחת מול דכאון וחרדה. הגדרה נפוצה לה שהמודעות שעולה על ידי הפניית תשומת לב לא שיפוטית למה שקורה מרגע לרגע. אפשר להיות קשובים למה שקורה בפנים ולאיך שהגוף מרגיש, או לבחון אילו מחשבות עוברות, או מה אני מרגיש, או להיות קשוב לסביבה שאני נמצא בה. בהקשר של פסוריאזיס, ניתן להיעזר במיינדפולנס להתמודד עם גרד מציק, או לזהות מחשבות שליליות כמה שהן באמת - מחשבות בלבד, ולא עובדות או המציאות.&lt;/p>&#xa;&lt;p style=&quot;text-align: right;&quot;>דרך טובה להתחיל לתרגל היא על ידי התמקדות בנשימה: ניתן להקשיב לה ולהרגיש אותה בגוף, מבלי לנסות לשנות או לווסת אותה. כשהקשב ינדוד - וזה יקרה - מחזירים אותו לבטן, או לנחיריים, או לכל מקום אחר שהנשימה מורגשת בו. כדאי להתחיל עם מדריך - יש ארגונים שמלמדים, יש עמותות, סדנאות בקופות חולים, פסיכולוגים רפואיים ועוד מומחים.&lt;/p>&#xa;"
                                textIsRich="true"/>
