                            </grid_copy>
                            <separator_879022297_
                                cq:styleIds="[1662756456518]"
                                jcr:created="{Date}2025-11-17T01:09:04.441-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-12-28T04:17:52.093-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <text_copy
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2022-11-16T17:01:41.718-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2025-02-11T04:21:26.171-05:00"
                                jcr:lastModifiedBy="gabayyx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p style=&quot;text-align: right;&quot;>פסוריאזיס היא מחלת עור דלקתית וכרונית שמתאפיינת בפריחה בעלת קשקשת, שלעיתים גם מגרדת. היא יכולה להופיע על הגוף בצורות שונות, לעיתים בצורה מקומית ולעיתים כמחלה מפושטת על פני העור. מוקדים אופייניים הם מרפקים, ברכיים, גב תחתון, קרקפת, גניטליה וציפורניים, אך ניתן למצוא נגעים גם באזורים אחרים. שכיחות המחלה עומדת על 4-2 אחוזים מהאוכלוסייה, והיא עלולה להתפרץ בכל גיל, ללא הבדל בין גברים ונשים. המחלה פוגעת באיכות החיים ומשפיעה גם על מצבם הנפשי של המטופלים: בזמן פריחה על העור, רבים מתביישים לחשוף את גופם ונמנעים מאינטראקציות חברתיות ומיחסים אינטימיים.&lt;/p>&#xd;&#xa;&lt;p style=&quot;text-align: right;&quot;>אבל פסוריאזיס אינה רק מה שקורה על פני העור. בחלק מהמקרים יש לה גם תחלואה נלווית אופיינית, כגון דלקת מפרקים פסוריאטית, דיכאון וסינדרום מטבולי (השמנה, סכרת, לחץ דם).&lt;/p>&#xd;&#xa;&lt;p style=&quot;text-align: right;&quot;>בשנים האחרונות נרשמה התקדמות בטיפול שמהווה בשורה טובה לחולים. &amp;quot;כיום, אפשר להעלים את נגעי הפסוריאזיס בצורה בטוחה ונוחה, שאינה פוגעת באיכות החיים או בשגרת היום יום&amp;quot;, מצהיר ד&amp;quot;ר גיל טאובר, מומחה לרפואת עור ומין. &amp;quot;נכנסנו לעידן של טיפולים מאוד יעילים, שמאפשרים להגיע לעור נקי לאורך זמן. זאת מציאות חדשה שלא הכרנו לפני כעשור&amp;quot;.&lt;br />&#xd;&#xa;&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <text_1841366700_copy
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2025-11-17T00:55:57.185-05:00"
                                jcr:createdBy="singarx"
