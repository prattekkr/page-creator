                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                langAttribute="none"
                                text="&lt;p>&lt;a href=&quot;/content/dam/abbvie-com2/il/documents/products/how-to-prepare-for-a-meeting-with-a-dermatologist.pdf&quot; target=&quot;_blank&quot;>&lt;b>אל תתפשרו על איכות החיים, &amp;nbsp;שאלו את הדרמטולוג.ית על טיפולים מתקדמים בפסוריאזיס&lt;/b>&lt;/a>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_879022297__1733957724
                                cq:styleIds="[1662756456518]"
