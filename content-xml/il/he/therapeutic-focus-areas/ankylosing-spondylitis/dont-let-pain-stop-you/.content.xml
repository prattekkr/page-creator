                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p style=&quot;text-align: center;&quot;>&lt;span class=&quot;body-unica-26-reg&quot;>אל תתרגלו לכאב – דברו עם הראומטולוג/ית שלכם על אפשרויות הטיפול הקיימות שיכולות לעזור לכם להפטר מהכאב ולחיות חיים מלאים ללא פשרות.&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_879022297_
