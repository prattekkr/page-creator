                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p style=&quot;text-align: center;&quot;>&lt;span class=&quot;body-unica-26-reg&quot;>שלי, שרון ודניאל מספרים מה למדו על החיים לצד דלקת חוליות מקשחת (AS), ויש להם לא מעט תובנות שכדאי להכיר. אז אילו יתרונות יש לחיים עם המחלה ולמה שרון מצא את עצמו רץ בתחתונים בגואטמלה?&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_879022297_
                                cq:styleIds="[1662756456518]"
                                jcr:created="{Date}2025-11-17T01:09:04.441-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-12-28T04:17:52.093-05:00"
