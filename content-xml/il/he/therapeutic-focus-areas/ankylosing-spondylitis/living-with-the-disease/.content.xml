                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <text_copy
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2022-11-16T17:01:41.718-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2026-01-01T04:46:49.213-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p style=&quot;text-align: right;&quot;>דניאל, שרון ושלי למדו ביום בהיר אחד שהם חולים בדלקת חוליות מקשחת (AS), מחלה דלקתית שפוגעת בחוליות של עמוד השדרה. כמו לא מעט צעירים במצבם, הם נאלצו ללמוד להתמודד עם המחלה המגבילה ויש לא מעט תובנות שאספו בדרך.&lt;/p>&#xd;&#xa;&lt;p style=&quot;text-align: right;&quot;>״אמרתי לעצמי שאין מצב שבגיל 21 אני מתעורר כל לילה מכאבים, לוקח בקבוקי משחות שרירים ומורח בגב״, נזכר שרון, ושלי מוסיפה: ״לא יכולתי לפתוח את הלסת. בקושי יכולתי לאכול או לדבר. כואב לעמוד, לשבת או להתכופף למשך הרבה זמן״.&lt;/p>&#xd;&#xa;&lt;p style=&quot;text-align: right;&quot;>״הדבר הכי כואב שהמחלה לקחה לי זה הכדורגל״, נזכר דניאל. ״הייתי משחק כל שבוע, זה הדבר שאני הכי אוהב בעולם. זה התחיל לי בצבא. הלכתי להרבה בדיקות, עד שהלכתי לראומטולוג שהתחיל לשאול אותי את השאלות הנכונות. אפשר לשלוט בדבר הזה, יש פתרונות. היום בזכות זה שאני מטופל אני יכול לשחק כדורגל״.&lt;/p>&#xd;&#xa;&lt;p style=&quot;text-align: right;&quot;>אז אילו יתרונות יש לחיים עם המחלה? מה ההבדל בין ״פטור מתור״ בישראל ובאירופה? ולמה שרון מצא את עצמו רץ בתחתונים בגואטמלה?&lt;/p>&#xd;&#xa;&lt;p style=&quot;text-align: right;&quot;>&lt;b>כל התשובות בסרטון.&lt;/b>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
