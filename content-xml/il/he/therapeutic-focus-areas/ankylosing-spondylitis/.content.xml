                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p style=&quot;direction: rtl; text-align: right;&quot;>זה כאב גב רגיל, או אולי משהו אחר? דלקת חוליות מקשחת (AS) גורמת לכאבים עזים ועלולה להחמיר לאורך זמן אם לא מטפלים בה. מי בסיכון, מתי כדאי לגשת לאבחון וכיצד מטפלים במחלה? כל מה שצריך לדעת על אנקילוזינג ספונדיליטיס&lt;br>&#xd;&#xa;&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
