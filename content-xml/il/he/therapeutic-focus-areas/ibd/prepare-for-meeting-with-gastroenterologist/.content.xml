                                jcr:primaryType="nt:unstructured"
                                jcr:title="3. ערכו תיאום ציפיות"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h2"
                                variant="h"/>
                            <text_700721356_copy_
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2025-01-29T09:50:49.682-05:00"
                                jcr:createdBy="gabayyx"
                                jcr:lastModified="{Date}2026-04-09T04:41:28.163-04:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                langAttribute="none"
                                text="&lt;p>&lt;span>במפגש עם הצוות הרפואי, הגדירו יחד מטרות טיפוליות: מה חשוב בטווח הקצר (למשל שליטה בתסמינים), ומה בטווח הארוך (למשל ריפוי עמוק של דופן המעי, הפוגה לאורך זמן ואיכות חיים טובה). &amp;quot;היום מדברים על יעדים בשלבים – קודם שיפור קליני, אחר כך איזון של מדדים רפואיים ולבסוף ריפוי של רירית דופן המעי&amp;quot;, מסבירה ברקן. תרגמו את זה למשימות מעשיות – אילו בדיקות נדרשות, איך תדעו אם הטיפול מצליח ומתי לשקול שינוי טיפול.&lt;/span>&lt;/p>&#xd;&#xa;&lt;p>לצד המדדים הרפואיים, חשוב לדבר עם הצוות הרפואי גם על מדדים אישיים החשובים לכם, כמו למשל מצב הרוח, הפרעות בשינה, בתפקוד המיני וכדומה. שתפו אותם בכל מה שמציק לכם, המטרה היא לגשר בין מה שחשוב לרופאים לבין מה שחשוב לכם. בנוסף, הצוות עשוי להיעזר בשאלונים שונים להערכת מדדי איכות חיים.&lt;/p>&#xd;&#xa;&lt;p>&lt;a href=&quot;/content/dam/abbvie-com2/il/documents/ibd-patient-checklist.pdf&quot; target=&quot;_blank&quot;>צ'ק ליסט (רשימה של עצות שימושיות) הכנה למפגש עם רופא ה-IBD - להורדה&lt;/a>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_879022297__165320743
                                cq:styleIds="[1662756423318,1662756756047]"
                                jcr:created="{Date}2025-11-17T01:09:04.441-05:00"
