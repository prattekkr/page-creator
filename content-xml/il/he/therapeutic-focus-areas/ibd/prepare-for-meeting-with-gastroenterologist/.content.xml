                            <text
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2025-11-13T03:27:23.632-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2026-04-09T04:00:37.300-04:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                langAttribute="none"
                                text="&lt;p style=&quot;text-align: center;&quot;>&lt;span class=&quot;body-unica-26-reg&quot;>מתמודדים עם קרוהן או קוליטיס כיבית? כנראה שאתם פוגשים את הרופאים לא מעט. רויטל ברקן, אחות מתאמת למחלות מעי דלקתיות מסבירה מה צריך לעשות כדי להגיע מוכנים לשיחה עם הרופא.ה ולהוציא ממנה את המרב&lt;br>&#xd;&#xa;&amp;nbsp;הכנו עבורכם צ'ק ליסט מעשי (רשימה של עצות שימושיות) שיסייע לכם להתכונן לפגישה –&amp;nbsp;&lt;a href=&quot;/content/dam/abbvie-com2/il/documents/ibd-patient-checklist.pdf&quot; target=&quot;_blank&quot;>להורדה לחצו כאן&lt;/a>&lt;/span>&lt;br>&#xd;&#xa;&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_879022297_
                                cq:styleIds="[1662756456518]"
                                jcr:created="{Date}2025-11-17T01:09:04.441-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-12-28T04:17:52.093-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <text_copy_copy
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2022-11-16T17:01:41.718-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2026-04-09T04:02:03.577-04:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                langAttribute="none"
                                text="&lt;p>קרוהן וקוליטיס כיבית הן מחלות כרוניות שדורשות מעקב מתמשך ורצף טיפולי, או במילים אחרות - לא מעט שיחות עם הרופא.ה המטפל.ת. כיוון שהרופאים המומחים עמוסים לרוב והזמן איתם קצר, חשוב במיוחד להגיע מוכנים לשיחה עם הצוות הרפואי ולמצות את הזמן המשותף. &lt;/p>&#xd;&#xa;&lt;p>כדי לעשות לכם סדר ולהתכונן כראוי למפגש עם הצוות הרפואי, שוחחנו עם רויטל ברקן, אחות מתאמת למחלות מעי דלקתיות במרכז הרפואי רבין ויו&amp;quot;ר פורום אחיות IBD. אלה העצות שלה:&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_879022297__1195876893
                                cq:styleIds="[1662756456518]"
                                jcr:created="{Date}2025-11-17T01:09:04.441-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-12-28T04:17:52.093-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <title_490938169
                                cq:styleIds="[1659545825678,1651545825694]"
                                jcr:created="{Date}2025-12-01T04:17:36.671-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2026-01-19T06:21:38.777-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="1. הכינו מראש שאלות ותוצאות בדיקות"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h2"
                                variant="h"/>
                            <text_1323613636_copy
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2025-11-27T03:37:23.547-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2026-04-09T04:02:50.431-04:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                langAttribute="none"
                                text="&lt;p>בכדי לא להתבלבל או לשכוח דברים שחשוב לכם להציף בשיחה, הכינו מראש רשימת שאלות מסודרת. ברקן מדגישה שלמרות הפיתוי להתייעץ עם גוגל או עם Chat GPT לקראת המפגש, המידע שתמצאו לא יהיה בהכרח מדויק או רלוונטי למקרה שלכם, ולכן חשוב לבחון אותו ביחד עם הרופא.ה.&amp;nbsp;&lt;/p>&#xd;&#xa;&lt;p>בנוסף, הגיעו עם תוצאות בדיקות עדכניות. הרופאים יעריכו את מצב המחלה ובמקרה הצורך יפנו אתכם לבדיקות נוספות. בסיום המפגש, תקבלו מהרופא.ה או מהאחות רשימת מעקב הכוללת המלצות להמשך הטיפול. ניתן גם לבקש מהצוות את דרכי ההתקשרות עם המרפאה למקרה של התלקחות, בעיה או שאלה.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_879022297__1542361223
                                cq:styleIds="[1662756423318,1662756756047]"
                                jcr:created="{Date}2025-11-17T01:09:04.441-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2026-01-19T06:30:37.817-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <separator_879022297__179684321
                                cq:styleIds="[1662756456518]"
                                jcr:created="{Date}2025-11-17T01:09:04.441-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2026-01-19T06:30:31.328-05:00"
