                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="4. לא הבנתם? אל תתביישו לשאול"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h2"
                                variant="h"/>
                            <text_700721356_copy__28989207
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2025-01-29T09:50:49.682-05:00"
                                jcr:createdBy="gabayyx"
                                jcr:lastModified="{Date}2026-04-09T04:06:10.996-04:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                langAttribute="none"
                                text="&lt;p>ודאו שאתם מבינים את ההסברים שניתנים לכם, שאתם יודעים מתי להיבדק, איך לזהות שיפור במדדים ואם מטרות הטיפול הושגו.&lt;/p>&#xd;&#xa;&lt;p>&amp;quot;מחלה כרונית היא כמו רכבת הרים – יש עליות וירידות, ואנחנו עוברים אותן יחד&amp;quot;, אומרת ברקן. חשוב לנהל שיח פתוח עם הצוות, לשאול שאלות ולבקש הסברים ברורים. &amp;quot;צריך ללמוד שפה חדשה, אבל חשוב להתעקש להבין – זה חלק מהניהול העצמי של המחלה. אם לא הבנתם את ההסבר, בקשו הסבר נוסף בשפה פשוטה יותר&amp;quot;.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
