                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                langAttribute="none"
                                text="&lt;p>לפני התחלת טיפול חדש, שאלו את הרופא או הרופאה כיצד הוא ניתן, אילו תופעות לוואי עלולות להופיע ואילו סימנים דורשים פנייה לרופא. אם אתם מרגישים שהטיפול הנוכחי לא מתאים לכם – דברו עם הרופא.ה ובדקו אילו אפשרויות נוספות קיימות. &amp;quot;היום יש יותר טיפולים מאי פעם&amp;quot;, מזכירה ברקן, &amp;quot;כך שגם אם יש התלקחות – אפשר להגיע לרמיסיה ולאיכות חיים טובה&amp;quot;.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
