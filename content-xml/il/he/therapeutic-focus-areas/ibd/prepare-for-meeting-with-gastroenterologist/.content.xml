                            <title_copy_copy_copy_1505709994
                                cq:styleIds="[1659545825678,1651243825678,1651545825694]"
                                jcr:created="{Date}2025-01-30T04:42:22.864-05:00"
                                jcr:createdBy="gabayyx"
                                jcr:lastModified="{Date}2026-01-19T06:30:50.389-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="2. נהלו יומן מעקב"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h2"
                                variant="h"/>
                            <text_700721356_copy__820075899
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2025-01-29T09:50:49.682-05:00"
                                jcr:createdBy="gabayyx"
                                jcr:lastModified="{Date}2026-04-09T04:03:01.394-04:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                langAttribute="none"
                                text="&lt;p>לקראת הפגישה, שימו לב לתסמינים שלכם. אם חל בהם שינוי – למשל כאבים חדשים, שינוי ביציאות או עייפות יוצאת דופן – עדכנו את הצוות הרפואי. יש היום דרכים פשוטות ולא פולשניות להעריך את מצב המחלה, וחשוב לזהות סימנים מוקדמים לפני שמתרחשת החמרה. במידת הצורך, ניתן להתייעץ עם הרופא.ה על האפשרות לשנות את הטיפול.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_879022297__996738060
                                cq:styleIds="[1662756423318,1662756756047]"
                                jcr:created="{Date}2025-11-17T01:09:04.441-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2026-01-19T06:30:37.817-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <separator_879022297__700144807
