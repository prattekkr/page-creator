                                langAttribute="none"
                                text="&lt;p style=&quot;text-align: center;&quot;>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-26-reg&quot;>ביקשנו מהגסטרואנטרולוגית פרופ׳ בלה אונגר לענות על השאלות שמעסיקות את המטופלים. אז כמה מחלת הקרוהן צפויה להשפיע על חיי היום יום שלכם? כדאי להפסיק טיפול כשמרגישים טוב? והאם המעי יכול להגיע לריפוי מלא? כל התשובות בסרטון.&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_879022297_
                                cq:styleIds="[1662756456518]"
                                jcr:created="{Date}2025-11-17T01:09:04.441-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-12-28T04:17:52.093-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <text
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2025-11-09T22:54:35.121-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2026-06-25T09:18:42.054-04:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                langAttribute="none"
                                text="&lt;p>כ-70 אלף בני אדם בישראל חיים עם מחלות מעי דלקתיות כמו קרוהן או קוליטיס כיבית. הם מתמודדים עם תסמינים של כאבי בטן ושלשולים, לעיתים כאלה שלא מאפשרים להם להתרחק יותר מדי מהשירותים הקרובים. יחד עם תסמינים נוספים, מחוץ למערכת העיכול, התוצאה עלולה להיות פגיעה משמעותית באיכות החיים, כאבים וסבל. אם המחלה לא מטופלת כראוי, היא עלולה אף להחריף.&amp;nbsp; &amp;nbsp;&lt;/p>&#xd;&#xa;&lt;p>אבל יש חדשות טובות. ארגז הכלים שזמין להתמודדות עם המחלה מתרחב כל העת. ״בשנים האחרונות התפתחו אפשרויות טיפול חדשות״, מסבירה פרופ׳ בלה אונגר מהיחידה לגסטרו-אימונולוגיה במכון הגסטרו בבית החולים שיבא בתל השומר. ״אלו כוללים טיפולים תזונתיים ותרופתיים, ביניהם גם טיפולים מתקדמים וניתוחים, שמאפשרים לשחרר את המטופל מכבלי התסמינים של המחלה ואפילו לחיות באיכות חיים מלאה״.&lt;/p>&#xd;&#xa;&lt;p>כדי שיהיה לכם את כל המידע הכי עדכני על המחלה ועל דרכי ההתמודדות עמה, ביקשנו מפרופ׳ אונגר לענות על כמה שאלות שמעסיקות אתכם, המטופלים. אז כמה מחלת הקרוהן תשפיע על חיי היום יום שלכם? &amp;nbsp;האם כדאי להפסיק טיפול כשמרגישים טוב? והאם המעי יכול להגיע לריפוי מלא? כל התשובות בסרטון.&lt;/p>&#xd;&#xa;&lt;p>שירות לציבור. הסרטון הופק במסגרת חסות של AbbVie להעלאת מודעות למחלות מעי דלקתיות באתר mako.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
