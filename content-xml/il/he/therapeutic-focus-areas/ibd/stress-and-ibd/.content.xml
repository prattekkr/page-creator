                            <text
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2025-11-13T03:27:23.632-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2026-03-31T09:26:56.036-04:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                langAttribute="none"
                                text="&lt;p style=&quot;text-align: center;&quot;>&lt;span class=&quot;body-unica-26-reg&quot;>בימים שבהם המציאות הישראלית נעה בין חרדה מפני טילים, ריצה למרחב מוגן, אי-ודאות כלכלית ו&amp;quot;סיר לחץ&amp;quot; משפחתי כשהילדים בבית ללא מסגרות - הגוף שלנו מדבר. עבור מי שמתמודד עם מחלות מעי דלקתיות (IBD), קרוהן וקוליטיס כיבית, הסטרס (דחק בעברית) אינו רק תחושה רגשית; הוא גורם פיזיולוגי המשפיע ישירות על מערכת העיכול.&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_879022297_
                                cq:styleIds="[1662756456518]"
                                jcr:created="{Date}2025-11-17T01:09:04.441-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-12-28T04:17:52.093-05:00"
                                jcr:lastModifiedBy="levhx"
