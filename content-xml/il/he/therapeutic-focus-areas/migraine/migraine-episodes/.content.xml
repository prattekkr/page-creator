                                jcr:primaryType="nt:unstructured"
                                jcr:title="איך מטפלים בהתקף מיגרנה?"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h2"
                                variant="h"/>
                            <text_copy_1261287400_827428804
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2022-11-23T16:46:55.248-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2025-01-19T07:44:27.275-05:00"
                                jcr:lastModifiedBy="gabayyx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p style=&quot;text-align: right;&quot;>בחירת הטיפול בהתקף מיגרנוטי נעשית מול הרופא המטפל ותלויה בעוצמת הכאב, בסימפטומים המלווים וברקע הרפואי של המטופל. את הטיפול האקוטי בהתקף המיגרנה יש להתחיל מיד עם הופעת ההתקף, שכן טיפול מוקדם הוא יעיל יותר.&lt;/p>&#xd;&#xa;&lt;p style=&quot;text-align: right;&quot;>הטיפול בהתקף מורכב מתרופות משככות כאב המוכרות לנו מתחומים אחרים, מתרופות ייעודיות למיגרנה וממכשירים יעודים לטיפול במיגרנה.&lt;/p>&#xd;&#xa;&lt;p style=&quot;text-align: right;&quot;>בהתקפים קלים ניתן לטפל במשככי כאבים (אנלגטיקה) פשוטים או בתרופות מקבוצת ה-NSAIDS -non steroidal anti inflammatory drugs. אם ההתקף מלווה בבחילה, ניתן לרשום למטופל תרופה ייעודית לבחילות.&lt;/p>&#xd;&#xa;&lt;p style=&quot;text-align: right;&quot;>בהתקפים קשים יותר, ניתן לטפל בתרופות ייעודיות למיגרנה – הוותיקים יותר בשוק הם טריפטנים, ולאחרונה נוספו שחקנים חדשים לזירה הטיפולית: הג'פנטים, עליהם נרחיב בהמשך.&lt;/p>&#xd;&#xa;&lt;p style=&quot;text-align: right;&quot;>הטריפטנים&amp;nbsp;הם קבוצת תרופות ייעודיות למיגרנה. יעילותן טובה, אולם חלק מהחולים מפסיק טיפול בשל תופעות לוואי ויש חולים שטיפול זה אינו מתאים עבורם.&lt;/p>&#xd;&#xa;&lt;p style=&quot;text-align: right;&quot;>בחולים הסובלים מבחילות או הקאות ניתן לתת טריפטנים בתרסיס לאף או בזריקה תת-עורית. התגובה לתרופות אלו היא מאד פרטנית ולא ניתן לחזותה מראש; על כן, יש לעתים לנסות מספר תרופות עד שמגיעים לזו המניבה עבור החולה הספציפי פעילות טובה עם כמה שפחות תופעות לוואי.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_879022297__1025144028
                                cq:styleIds="[1662756456518]"
