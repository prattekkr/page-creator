                                jcr:title="מה זה טיפול אקוטי למיגרנה?"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h2"
                                variant="h"/>
                            <text_copy_copy_14035
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2022-11-16T17:01:41.718-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2026-02-04T06:27:59.656-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p style=&quot;text-align: right;&quot;>מיגרנה היא מחלה נוירולוגית כרונית המאופיינת בכאבי ראש עזים, וכן בתסמינים מכבידים כגון רגישות לאור ולרעש, בחילות והקאות. זוהי המחלה השלישית הנפוצה ביותר ברחבי העולם, שפוגעת משמעותית ביכולת לתפקד בעבודה, בחיי החברה והמשפחה, ומכך נובעת החשיבות הגבוהה בהנגשת טיפולים אקוטיים יעילים (טיפול בזמן התקף מיגרנה) לאוכלוסיה הסובלת ממנה.&lt;/p>&#xd;&#xa;&lt;p style=&quot;text-align: right;&quot;>בניגוד ל&lt;a href=&quot;/content/abbvie-com2/il/he/therapeutic-focus-areas/migraine/preventative.html&quot;>טיפולים מניעתיים למיגרנה,&lt;/a> שתפקידם להפחית את תדירות, משך ועוצמת ההתקפים, תפקיד הטיפול האקוטי הינו להקל ואף לעצור את התפתחות הכאב&amp;nbsp;&lt;u>בעת התקף מיגרנה&lt;/u>&amp;nbsp;ובכך לאפשר חזרה לשגרה במהירות המירבית.&lt;/p>&#xd;&#xa;&lt;p style=&quot;text-align: right;&quot;>חשוב לציין שניתן לשלב בין טיפולים אקוטיים לטיפולים מניעתיים, אך יש לבצע זאת אך ורק בהמלצת הרופא.ה המטפל.ת.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
