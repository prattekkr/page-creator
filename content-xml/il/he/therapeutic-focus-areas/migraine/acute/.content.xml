                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;ul>&#xd;&#xa;&lt;li>הטיפול האקוטי (בזמן התקף) במיגרנה נועד להקל על הכאב ולאפשר חזרה מהירה לשגרה.&lt;/li>&#xd;&#xa;&lt;li>ישנו מגוון טיפולים אקוטיים במיגרנה הזמינים בישראל, חלקם ותיקים וחלקים חדשים.&lt;/li>&#xd;&#xa;&lt;li>חשוב להתייעץ עם רופא.ת המשפחה או הנוירולוג.ית על מנת לקבל את הטיפול המתאים לך.&lt;br>&#xd;&#xa;&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;"
                                textIsRich="true"/>
