                                jcr:title="מהן מטרות הטיפול האקוטי במיגרנה?"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h2"
                                variant="h"/>
                            <text_copy_copy_25677_1871302875
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2022-11-16T17:01:41.718-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2026-01-05T03:34:39.270-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p style=&quot;text-align: right;&quot;>מטרות הטיפול האקוטי במיגרנה מוגדרות בנייר עמדה שפרסמה החברה האמריקאית לכאבי ראש (AHS), והן משמשות קווים מנחים לרופאים בבחירת הטיפול האקוטי המתאים:&lt;/p>&#xd;&#xa;&lt;ol>&#xd;&#xa;&lt;li style=&quot;text-align: right;&quot;>להביא להפוגה מהירה מהכאב ומהתסמינים הנלווים להתקף&lt;/li>&#xd;&#xa;&lt;li style=&quot;text-align: right;&quot;>לאפשר חזרה מהירה לתפקוד רגיל&lt;/li>&#xd;&#xa;&lt;li style=&quot;text-align: right;&quot;>לצמצם ככל האפשר נטילת מנות נוספות של התרופות/משככי הכאבים שנלקחו או נטילת תרופות נוספות לטיפול בהתקף&lt;/li>&#xd;&#xa;&lt;li style=&quot;text-align: right;&quot;>לאפשר למטופל.ת לטפל בעצמו.ה באופן מיטבי ולצמצם את הצורך בביקורי רופא וצריכת שירותי בריאות דחופים (חדר מיון)&lt;/li>&#xd;&#xa;&lt;li style=&quot;text-align: right;&quot;>להפחית או למנוע תופעות לוואי שמופיעות כתוצאה מהטיפול&lt;/li>&#xd;&#xa;&lt;/ol>&#xd;&#xa;&lt;p style=&quot;text-align: right;&quot;>המלצה חשובה נוספת של החברה האמריקאית לכאב ראש היא ליטול טיפול אקוטי מיד עם הסימן הראשון לכאב. פעולה זו מעלה את הסיכוי של החולה להעביר את הכאב ולהפחית את המוגבלויות הנגרמות כתוצאה מהתקף המיגרנה. &lt;/p>&#xd;&#xa;&lt;p style=&quot;text-align: right;&quot;>יש לציין כי במקרים מסוימים אפשר לחזות את הופעת הכאב עוד לפני הופעתו – ניתן לקרוא על כך בכתבה על &lt;a href=&quot;/content/abbvie-com2/il/he/therapeutic-focus-areas/migraine/prodrome.html&quot;>שלב הפרודרום&lt;/a> - השלב הראשון בהתקף המיגרנה&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_879022297__1972029884
