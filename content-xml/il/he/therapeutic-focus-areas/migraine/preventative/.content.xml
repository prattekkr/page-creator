                                text="&lt;p style=&quot;text-align: center;&quot;>&lt;span class=&quot;body-unica-26-reg&quot;>הטיפולים הקיימים למניעת מיגרנה&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <text_copy
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2022-11-16T17:01:41.718-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2026-02-04T06:28:38.517-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>מיגרנה היא מחלה נוירולוגית כרונית המאופיינת בכאבי ראש עזים, וכן בתסמינים מכבידים כגון רגישות לאור ולרעש, בחילות והקאות. המיגרנה מדורגת בקטגוריית הנכות הגבוהה ביותר של ארגון הבריאות העולמי, והיא נפוצה פי 3 בקרב נשים לעומת גברים.&lt;/p>&#xd;&#xa;&lt;p>ישנם מקרים בהם התקפי המיגרנה כה תכופים, ש&lt;a href=&quot;/content/abbvie-com2/il/he/therapeutic-focus-areas/migraine/acute.html&quot;>טיפולים אקוטיים&lt;/a>&amp;nbsp;(בזמן התקף) לבדם אינם מספקים וקיים צורך משמעותי בהתחלת טיפול מניעתי.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_879022297_
                                cq:styleIds="[1662756456518]"
                                jcr:created="{Date}2025-11-17T01:09:04.441-05:00"
