                                jcr:title="מה זה טיפול מניעתי למיגרנה?"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h2"
                                variant="h"/>
                            <text_copy_copy_14035
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2022-11-16T17:01:41.718-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2026-01-05T03:44:14.533-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p style=&quot;text-align: right;&quot;>&lt;span style=&quot;&quot;>בניגוד לטיפולים אקוטיים למיגרנה, שתפקידם להקל ואף לעצור את התקף המיגרנה לאחר תחילתו, &lt;a href=&quot;/content/abbvie-com2/il/he/therapeutic-focus-areas/migraine/how-do-you-treat-chronic-migraine.html&quot;>טיפול מניעתי למיגרנה&lt;/a> מתמקד בהפחתת תדירות, משך ועוצמת ההתקפים. בישראל, מומלץ לשלב טיפול מניעתי למי שסובל מלפחות 4 ימי כאב ראש בחודש, או לשקול לשלב טיפול כזה כאשר יש 2 ימי כאב ראש בחודש עם השפעה ניכרת על איכות החיים. במקרים כאלה מומלץ לפנות לרופא.ה המטפל.ת בך ולדון באפשרות להתחיל טיפול מניעתי.&lt;/span>&lt;/p>&#xd;&#xa;&lt;p style=&quot;text-align: right;&quot;>חשוב לציין שניתן לשלב בין טיפולים אקוטיים לטיפולים מניעתיים, אך יש לבצע זאת אך ורק בהמלצת הרופא.ה המטפל.ת..&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
