                                type="h2"
                                variant="h"/>
                            <text_copy_1261287400_1852897967
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2022-11-23T16:46:55.248-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2026-01-05T06:26:57.188-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p style=&quot;text-align: right;&quot;>הפרודרום מתבטא באופן שונה אצל כל אחד ואחת, ויש כאלה שלא יחוו את הפרודרום כלל. יש כאלה שיחוו תסמינים מסוימים, העשויים להיות שונים מאלה שיחוו אחרים, או שעוצמתם ותדירותם יהיו שונות. לכן, חשוב ללמוד לזהות מהם התסמינים המקדימים כדי שתדעו ששלב הפרודרום התחיל. לרוב הזיהוי נעשה באמצעות למידה וזיהוי עצמי של התסמינים, אך בהחלט מומלץ להתייעץ עם הרופא.ה המטפל.ת ולנסות לאתר יחד את התסמינים.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_879022297__616277242
                                cq:styleIds="[1662756456518]"
                                jcr:created="{Date}2025-11-17T01:09:04.441-05:00"
                                jcr:createdBy="singarx"
