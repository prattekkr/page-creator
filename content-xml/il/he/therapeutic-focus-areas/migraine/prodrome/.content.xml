                                jcr:title="מהם תסמיני הפרודרום?"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h2"
                                variant="h"/>
                            <text_copy_1261287400_1876348983
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2022-11-23T16:46:55.248-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2025-01-19T08:14:46.069-05:00"
                                jcr:lastModifiedBy="gabayyx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p style=&quot;text-align: right;&quot;>תסמיני הפרודרום מגוונים, חלקם נפוצים יותר וחלקם פחות, וכוללים בין היתר:&lt;/p>&#xd;&#xa;&lt;ul>&#xd;&#xa;&lt;li style=&quot;text-align: right;&quot;>תחושת בחילה&lt;/li>&#xd;&#xa;&lt;li style=&quot;text-align: right;&quot;>רגישות מוגברת לאור, קול ו/או ריח&lt;/li>&#xd;&#xa;&lt;li style=&quot;text-align: right;&quot;>סחרחורות&lt;/li>&#xd;&#xa;&lt;li style=&quot;text-align: right;&quot;>עייפות ובעיות שינה&lt;/li>&#xd;&#xa;&lt;li style=&quot;text-align: right;&quot;>קושי להתרכז&lt;/li>&#xd;&#xa;&lt;li style=&quot;text-align: right;&quot;>כאב, לחץ ו/או טשטוש בראייה&lt;/li>&#xd;&#xa;&lt;li style=&quot;text-align: right;&quot;>כאב ו/או נוקשות בצוואר&lt;/li>&#xd;&#xa;&lt;li style=&quot;text-align: right;&quot;>שינויים במצב הרוח, לרבות עצבנות או חרדה&lt;/li>&#xd;&#xa;&lt;li style=&quot;text-align: right;&quot;>פיהוק מוגבר&lt;/li>&#xd;&#xa;&lt;li style=&quot;text-align: right;&quot;>חשקים למאכלים ספציפיים או חוסר תיאבון&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_682497146
                                jcr:created="{Date}2025-12-08T00:46:26.660-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-12-08T00:46:26.660-05:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
