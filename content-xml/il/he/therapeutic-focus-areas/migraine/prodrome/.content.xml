                                jcr:primaryType="nt:unstructured"
                                jcr:title="מה זה פרודרום?"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h2"
                                variant="h"/>
                            <text_copy_1261287400_827428804
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2022-11-23T16:46:55.248-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2026-01-05T06:26:37.297-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p style=&quot;text-align: right;&quot;>ה&amp;quot;פרודרום&amp;quot; הוא המונח הרפואי לסימנים או תסמינים מוקדמים של מחלה או בעיה בריאותית המופיעים לפני הופעת התסמינים העיקריים. בהקשר של מחלת המיגרנה, הפרודרום הוא השלב הראשון בהתקף המיגרנה, בו מופיעים תסמינים מסויימים &lt;b>בין מספר שעות למספר ימים לפני שלבי האאורה ו/או כאב הראש&lt;/b>. למעשה, אפשר להתייחס אל פרודרום מיגרנה כאל &amp;quot;מגדלור&amp;quot; - מערכת התראה מוקדמת המודיעה לסובלים ממיגרנה על התקף מיגרנה מתקרב.&lt;/p>&#xd;&#xa;&lt;p style=&quot;text-align: right;&quot;>שלב הפרודרום עשוי גם להשפיע לרעה על היכולת לעבוד, ולנהל חיי חברה ומשפחה. חולים שהשתתפו במחקר בתחום ציינו בין היתר שהוא יכול לעורר חרדה, תסכול ולחצים נפשיים, להקשות על השינה ועוד.&lt;/p>&#xd;&#xa;&lt;p style=&quot;text-align: right;&quot;>אם תזהו בזמן את תסמיני הפרודרום, תוכלו לדעת שההתקף למעשה מתחיל ולפעול במהירות באמצעות &lt;b>נטילת&lt;/b> &lt;b>טיפול&lt;/b> &lt;b>נכון שיכול להביא להקלה בכאב הראש ואף לעצור אותו עוד לפני שיתחיל!&lt;/b>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
