                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p style=&quot;text-align: center;&quot;>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-26-reg&quot;>המדריך לסימני האזהרה המתריעים על התקף מיגרנה מתקרב.&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_879022297_
                                cq:styleIds="[1662756456518]"
                                jcr:created="{Date}2025-11-17T01:09:04.441-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-12-28T04:17:52.093-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <text_copy
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2022-11-16T17:01:41.718-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2026-01-05T06:26:26.415-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p style=&quot;text-align: right;&quot;>מיגרנה היא מחלה נוירולוגית מורכבת, שהמשמעות שלה היא הרבה מעבר ל-&amp;quot;רק כאב ראש&amp;quot;; התקף מיגרנה הוא למעשה סדרה של אירועים נוירולוגיים אשר עשויים לכלול מספר שלבים: הפרודרום (השלב המקדים), האאורה, כאב הראש והפוסטדרום (סיום ההתקף, או ה&amp;quot;האנגאובר של המיגרנה&amp;quot;).&lt;/p>&#xd;&#xa;&lt;p style=&quot;text-align: right;&quot;>הכרת השלבים חשובה ביותר ומאפשרת לנהל נכון יותר את מחלת המיגרנה, לזהות את המאפיינים והתסמינים (סימפטומים) של כל שלב ולדעת כיצד להתמודד איתם בצורה הטובה והיעילה ביותר.&lt;/p>&#xd;&#xa;&lt;p style=&quot;text-align: right;&quot;>במדריך הבא נתמקד בשלב המקדים של התקף המיגרנה: הפרודרום (Prodrome).&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_879022297__712457647
                                cq:styleIds="[1662756456518]"
                                jcr:created="{Date}2025-11-17T01:09:04.441-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-12-28T04:17:52.093-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <title_copy_433284079
                                cq:styleIds="[1659545825678,1651545825678,1651243825678,1651545825694]"
                                jcr:created="{Date}2022-11-30T02:11:17.530-05:00"
                                jcr:createdBy="kumarvx60"
                                jcr:lastModified="{Date}2026-01-05T06:26:46.733-05:00"
