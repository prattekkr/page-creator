                            <text_copy_copy
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2022-11-16T17:01:41.718-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2025-01-01T08:41:11.297-05:00"
                                jcr:lastModifiedBy="gabayyx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p style=&quot;direction: rtl; text-align: right;&quot;>״נכון לעכשיו, אין תרופה שמאפשרת החלמה מפרקינסון וגם אין טיפול שמסוגל לעכב את התקדמות המחלה״, מציין ד&amp;quot;ר סמיון קורנבלום, מהמחלקה הנוירולוגית במרכז הרפואי העמק בעפולה. ״אבל ישנם כיום טיפולים יעילים, שמאפשרים למתן את תסמיני המחלה, גם בשלבים המתקדמים שלה. אלה כוללים בין היתר טיפולים בבליעה וטיפולים מתקדמים לשלבים מאוחרים יותר של המחלה״.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_879022297__89643692
                                cq:styleIds="[1662756456518]"
                                jcr:created="{Date}2025-11-17T01:09:04.441-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-12-28T04:17:52.093-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <title_copy_144453196
                                cq:styleIds="[1659545825678,1651545825678,1651243825678,1651545825694]"
                                jcr:created="{Date}2022-11-30T02:11:17.530-05:00"
                                jcr:createdBy="kumarvx60"
                                jcr:lastModified="{Date}2026-01-06T03:56:32.745-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="טיפול תרופתי בבליעה"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h2"
                                variant="h"/>
                            <text_copy_copy_25677_1275361891
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2022-11-16T17:01:41.718-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2025-11-03T09:29:49.113-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;ul>&#xd;&#xa;&lt;li>טיפולים באל-דופה (L-DOPA). לבודופה הוא חומר המדמה דופמין והינו הטיפול התרופתי בעל ההשפעה הרבה ביותר על תסמיני מחלת פרקינסון.&lt;/li>&#xd;&#xa;&lt;li>תרופות המבוססות על אגוניסט של דופמין. תרופות אלו נקשרות ישירות לקולטן של דופמין על פני תאי העצב במוח ובכך מפעילות אותו בצורה הדומה לדופמין. תופעות לוואי אפשריות הינן בין השאר נטייה לישנוניות, צניחה בלחץ הדם ושינויים בהתנהגות, תופעות המחייבות ניטור צמוד.&lt;/li>&#xd;&#xa;&lt;li>מעכבי MAO-B. טיפולים הפועלים על אנזים שמפרק את הדופמין ובכך מסייעים להעלות את ריכוז הדופמין במוח. התרופות הללו ניתנות בשלבים ההתחלתיים של המחלה, או כתוספת לטיפול אחר.&lt;/li>&#xd;&#xa;&lt;li>זמינות גם תרופות נוספות המסייעות להקל על תסמיני המחלה המוטוריים והלא מוטוריים.&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;&lt;p>כשמחלת פרקינסון מתקדמת, מתהווה לעיתים קרובות הפרעה בספיגת טיפול בבליעה, בשל האטה בתנועתיות הקיבה, כך שהטבליות הנבלעות אינן מגיעות ליעדן - המעי הדק המקורב. בשל כך עלול החולה לחוות השפעה מופחתת של הטיפול. בשלב זה יוצעו למתמודד טיפולים מתקדמים.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
