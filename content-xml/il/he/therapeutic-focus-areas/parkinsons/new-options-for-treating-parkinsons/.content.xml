                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p style=&quot;text-align: right;&quot;>״לצד הטיפולים״, מציין ד״ר קורנבלום, ״מחקרים מראים ששמירה על פעילות גופנית קבועה עשויה לעכב את התפתחות המחלה. לכן, אחת ההמלצות הראשונות במקרה של פרקינסון היא לבצע פעילות גופנית במשך לפחות 5 שעות שבועיות במצטבר. בעיקר מועילה פעילות אירובית, כמו הליכות&amp;quot;. טיפול נכון, שמוביל למצב מנטלי ומוטורי יציב, יאפשר למטופלים לבצע פעילות גופנית בתדירות הנדרשת.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <quote
                                cq:styleIds="[1000000000000,1000000000012]"
                                jcr:created="{Date}2025-01-01T08:43:25.442-05:00"
                                jcr:createdBy="gabayyx"
                                jcr:lastModified="{Date}2025-11-03T09:31:05.391-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/quote"
                                attributionName="ד&quot;ר סמיון קורנבלום"
                                attributionTitle="מחלקה נוירולוגית במרכז הרפואי העמק בעפולה"
                                bgImageModifiers="resMode=sharp2&amp;op_sharpen=1"
                                imageModifiers="resMode=sharp2&amp;op_sharpen=1"
                                quote="יש כיום ארגז כלים מגוון עם אפשרויות טיפול פחות פולשניות, שלא היו זמינות בעבר. יש טיפולים שמאפשרים שליטה בתסמינים לאורך כל שעות היממה. רק חשוב לפנות לרופא ולהתאים את הטיפול הנכון ביחד. בימינו, ניתן לחיות טוב יותר עם המחלה"
                                quoteType="regular"
                                textSize="h0"/>
                            <text_copy_1261287400
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2022-11-23T16:46:55.248-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2025-12-07T04:20:54.670-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p style=&quot;text-align: right;&quot;>המידע במאמר אינו מהווה המלצת רופא.ה, חוות דעת מקצועית או תחליף לייעוץ רפואי.&amp;nbsp;למידע נוסף יש לפנות לרופא המטפל.&lt;/p>&#xd;&#xa;&lt;p style=&quot;text-align: right;&quot;>המרואיין לכתבה ד״ר סמיון קורנבלום עבור חברת Abbvie.&lt;/p>&#xd;&#xa;&lt;p style=&quot;text-align: right;&quot;>שירות לציבור. מוגש על ידי חברת AbbVie&lt;/p>&#xd;&#xa;&lt;p style=&quot;text-align: right;&quot;>IL-ABBV-240040 | AUG 2024&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
