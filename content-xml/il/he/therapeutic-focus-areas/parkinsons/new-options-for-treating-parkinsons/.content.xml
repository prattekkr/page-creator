                                text="&lt;p style=&quot;text-align: center;&quot;>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-26-reg&quot;>האפשרויות החדשות לטיפול בפרקינסון&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
