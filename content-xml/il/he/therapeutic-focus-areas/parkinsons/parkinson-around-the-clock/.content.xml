                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="abbvie-com2/components/text/v2/text"
                                        text="&lt;p style=&quot;text-align: right;&quot;>&lt;span class=&quot;body-unica-26-reg&quot;>התגובה לטיפול בפרקינסון נוטה להיחלש בחלוף השנים והמחלה עלולה לשבש את חיי החולים, להפריע לתפקוד ולפגוע בשינה. הנוירולוגית ד״ר מהא חוראני מסבירה שכיום, ניתן להתאים טיפול גם לחולים עם פרקינסון מתקדם ולהשיג שליטה טובה יותר בתסמינים לאורך היממה&lt;/span>&lt;/p>&#xd;&#xa;"
                                        textIsRich="true"/>
