                                jcr:primaryType="nt:unstructured"
                                jcr:title="כשהכדורים כבר לא מספיקים"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h2"
                                variant="h"/>
                            <text_1934502723_copy
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2025-11-15T01:54:07.218-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-11-15T01:56:08.613-05:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>הטיפול התרופתי המרכזי בפרקינסון הוא מתן נגזרת דופמין (L-DOPA) שהינה תרופה ההופכת במוח לדופמין. הטיפול התרופתי מסייע להפחית תסמינים שנובעים ממחסור בדופמין, אך הוא אינו מרפא את המחלה עצמה.&lt;/p>&#xd;&#xa;&lt;p>״כשהמחלה ממשיכה להתקדם ובחלוף שנים של טיפול תרופתי, התגובה לטיפול כבר לא תהיה חזקה כפי שהייתה בתחילה. זמני ההשפעה של התרופה מתקצרים ויש צורך להעלות את מינון התרופות – גם את מספר הפעמים שיש ליטול אותן במהלך היום וגם את הכמות שיש ליטול במנה בודדת״, מפרטת ד״ר חוראני. ״בנוסף, בשלב זה התגובה לתרופה יכולה להיות לפעמים בלתי צפויה - במקום שהכדור ישפיע תוך חצי שעה ויאפשר תפקוד, הוא עלול פתאום להשפיע רק בחלוף זמן רב - או בכלל לא. מנגד, הכדור עלול גם להשפיע יתר על המידה ולהוביל לתנועות בלתי רצוניות (דיסקינזיות) שפוגעות בפעילויות בסיסיות כמו אכילה ועלולות לגרום לתאונות ולנפילות. כל זה פוגע ביכולת של החולים להיות ספונטניים, משבש פעילות יומיומית, מגביל מטופלים לביתם ומעלה את תלותם במטפלים. כתוצאה, המטופל עלול לפתח תסכול, דכאון וחרדה ובהתאם גם יחסיו עם משפחתו הופכים למתוחים ומורכבים יותר״.&amp;nbsp;&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
