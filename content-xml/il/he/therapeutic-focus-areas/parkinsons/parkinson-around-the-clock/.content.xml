                            <separator_879022297__947636164
                                cq:styleIds="[1662756456518]"
                                jcr:created="{Date}2025-11-17T01:09:04.441-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-12-28T04:17:52.093-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <text
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2025-11-15T01:52:39.465-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-11-15T01:53:00.835-05:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>פרקינסון היא מחלה ניוונית פרוגרסיבית של המוח, שתסמיניה מתקדמים עם הזמן. היא מאופיינת בפגיעה בתאים מייצרי דופמין - מוליך עצבי החיוני לגוף לביצוע תנועות באופן תקין וחלק. &lt;br />&#xd;&#xa;&lt;br />&#xd;&#xa;בשל המחסור בדופמין מתפתחים מגוון תסמינים שמגבילים את התפקוד ופוגעים באיכות החיים. תסמינים מוטוריים עשויים לכלול במקרים רבים רעד וכן איטיות בתנועה ,קושי בדיבור, נוקשות שרירים, עוויתות לא רצוניות של שרירי הגפיים (דיסטוניה), קושי בביצוע תנועות עדינות כמו קושי בכתיבה ובהקלדה ובשלבים מתקדמים של המחלה - חוסר יציבות, הפרעות הליכה ונפילות. ישנם גם תסמינים שאינם קשורים לתנועה ובהם פגיעה בזיכרון ובריכוז, הפרעות במצב הרוח, הפרעות במערכת האוטונומית של הגוף שמובילות לתנודות בלחץ הדם, הפרעות במתן שתן ועצירות. החולים סובלים גם מכאבים והפרעות שינה. &lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_879022297_
                                cq:styleIds="[1662756456518]"
                                jcr:created="{Date}2025-11-17T01:09:04.441-05:00"
