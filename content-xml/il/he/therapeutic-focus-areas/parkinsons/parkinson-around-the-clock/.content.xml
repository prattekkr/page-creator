                            <title_762664557
                                cq:styleIds="[1659545825678,1651545825694]"
                                jcr:created="{Date}2025-11-15T01:53:34.332-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2026-01-06T04:06:25.463-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="מדברים ובועטים מתוך שינה "
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h2"
                                variant="h"/>
                            <text_1934502723
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2025-11-15T01:54:07.218-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-11-15T01:54:40.354-05:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>״כמה מהתסמינים שאינם מוטוריים, כגון דיכאון וחרדה, עצירות והפרעות שינה עשויים להופיע שנים לפני התסמינים המוטוריים ולפני אבחון המחלה. עבור לא מעט מטופלים הם עלולים להיות התסמינים העיקריים״, אומרת הנוירולוגית ד״ר מהא חוראני, מנהלת המרפאה להפרעות בתנועה בבית חולים כרמל.&lt;/p>&#xd;&#xa;&lt;p>הפרעות שינה יכולות להיות בין התסמינים המטרידים ביותר עבור מטופלים ובני משפחתם. ״הפרעות שינה יכולות להתחיל אפילו 20-15 שנים לפני הופעת התסמינים המוטוריים״, מסבירה ד״ר חוראני. ״המחלה משפיעה על השינה באופנים רבים: החולים מרבים להתעורר בלילה ומתקשים לשוב לישון, הם סובלים מנוקשות שרירים בלילה ומכאבים. מעבר לכך, קיימת פגיעה בשינה שהיא ייחודית למחלה – החולים בפרקינסון עלולים לאבד את השיתוק שאמור ללוות את שנת החלום וכתוצאה מכך הם יכולים לזוז, לבעוט ואפילו ליפול מהמיטה מתוך שינה״. &lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_879022297__2121755132
                                cq:styleIds="[1662756456518]"
                                jcr:created="{Date}2025-11-17T01:09:04.441-05:00"
