                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <text_1740074505
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2025-11-17T02:43:52.618-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-11-17T02:44:08.979-05:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>המידע המובא אינו מהווה המלצת רופא, חוות דעת מקצועית או תחליף למי מהם.&lt;br>&#xd;&#xa;למידע נוסף יש לפנות לרופא/ה המטפל/ת.&lt;/p>&#xd;&#xa;&lt;p>המיגע מוגש שירות לציבור מטעם חברת AbbVie.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
