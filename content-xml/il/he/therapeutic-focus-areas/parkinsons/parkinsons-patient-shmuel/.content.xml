                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p style=&quot;text-align: center;&quot;>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-26-reg&quot;>שמואל וחיה חולקים את הסיפור שלהם - מתקופה של ירידה הדרגתית ואבדן עניין בחיים, למציאות חדשה, פעילה, עצמאית, ובאיכות חיים משופרת.&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
