                            <title_155422277
                                cq:styleIds="[1659545825678,1651545825694]"
                                jcr:created="{Date}2025-11-17T00:55:22.985-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2026-01-06T04:14:12.449-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="חמש השנים הטובות והתחלת ההחמרה"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h2"
                                variant="h"/>
                            <text_1841366700
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2025-11-17T00:55:57.185-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2026-01-06T04:14:57.911-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>בתקופה הראשונה אחרי אבחון מחלת הפרקינסון, החיים היו עדיין טובים. שמואל אמנם הלך עם מקל, אבל הוא וחיה טסו לחו&amp;quot;ל, אירחו חברים לארוחות בבית והחיים המשיכו לזרום. אבל אחרי חמש השנים הראשונות, הם התחילו לראות שמתחילה החמרה.&lt;br>&#xd;&#xa;הירידה באיכות החיים הייתה הדרגתית אבל ברורה עד למצב ששמואל רוב היום כמעט ולא עשה כלום. המסלול שלו הפך להיות פשוט – &amp;quot;מהכיסא לכורסה ואז למיטה&amp;quot;. הוא הפסיק לקרוא והפסיק להתעניין בדברים.&lt;/p>&#xd;&#xa;&lt;p>&lt;b>&amp;quot;שמואל מתחיל לחזור לעצמו&amp;quot;&lt;br>&#xd;&#xa;&lt;/b>ואז הציעו להם את הטיפול המתקדם במשאבה התת-עורית ואחרי כמה ימים בלבד עם הטיפול החדש, שמואל חזר לקרוא, להתעניין ואף לצפות בתוכניות שאהב.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <video_copy
                                cq:styleIds="[1]"
                                jcr:created="{Date}2025-11-17T00:56:30.440-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2026-04-29T08:10:59.820-04:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/video/v2/video"
                                autoPlayBrightcovePlaylistvideo="false"
                                brightcoveAccount="1029485116001"
                                brightcoveAutoPlay="true"
                                brightcovePlayerId="default"
                                brightcovePlaylistAccount="2157889325001"
