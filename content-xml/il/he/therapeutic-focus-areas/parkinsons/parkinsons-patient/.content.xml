                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>לימור, בת 44, חיה חיים פעילים ומלאים. היא עבדה עם ילדים בסיכון, גידלה משפחה, ורצה קדימה. ואז, מתוך שגרת חיים עמוסה, הגיעה האבחנה שטלטלה את עולמה: פרקינסון.&lt;br />&#xd;&#xa;עם הזמן, התסמינים הלכו והחמירו – רעד בלתי נשלט, כאבים, קושי בתנועה – אבל מה שפגע בה יותר מהכול הייתה השינה, או יותר נכון, היעדרה.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_229764441
                                jcr:created="{Date}2025-11-14T23:56:04.170-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-11-14T23:56:04.170-05:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <video
                                cq:styleIds="[1,1,2]"
                                jcr:created="{Date}2025-11-14T23:56:13.232-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2026-04-29T08:10:51.562-04:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/video/v2/video"
                                autoPlayBrightcovePlaylistvideo="false"
                                brightcoveAccount="1029485116001"
                                brightcoveAutoPlay="true"
                                brightcovePlayerId="default"
                                brightcovePlaylistAccount="2157889325001"
                                brightcoveVideoId="6377034348112"
                                dmPresetType="imagePreset"
                                fileReference="/content/dam/abbvie-com2/il/images/parkinson/limor-back-to-life.png"
                                loopBrightcovePlaylistVideo="false"
                                loopVideo="false"
                                showBrightcoveControls="true"
                                showBrightcovePlaylistControls="false"
                                showPlayerControls="false"
                                textIsRich="[true,true]"
