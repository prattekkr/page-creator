                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>הסרטון הופק במסגרת חסות של אבווי להעלאת מודעות למחלת הפרקינסון באתר מאקו.&lt;br />&#xd;&#xa;מוגש כשירות לציבור בחסות חברת AbbVie.&lt;br />&#xd;&#xa;למידע נוסף יש לפנות לרופא/ה המטפל/ת.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
