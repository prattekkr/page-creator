                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    langAttribute="none"
                                    text="&lt;p>האבחנה של מחלת פרקינסון מביאה איתה לעיתים קרובות תחושה של ערפל וחוסר וודאות. &amp;nbsp;פתאום, סדר היום המוכר משתנה ועולות שאלות רבות: איך ממשיכים מכאן? אילו זכויות מגיעות לי? האם יש מישהו שבאמת מבין מה עובר עליי ועל משפחתי?&amp;nbsp;חשוב שתדעו: אתם לא צריכים לעבור את הדרך הזו לבד. עמותת פרקינסון בישראל הוקמה כדי להיות המגדלור שלכם – מקום שבו מידע, קהילה ותמיכה מקצועית נפגשים ומסייעים לשיפור איכות החיים.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
