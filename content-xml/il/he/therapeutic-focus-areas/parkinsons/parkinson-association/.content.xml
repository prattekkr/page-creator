                            <text_398730945_copy
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2025-11-14T23:54:51.490-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2026-05-13T04:43:23.212-04:00"
                                jcr:lastModifiedBy="alonhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                langAttribute="none"
                                text="&lt;p style=&quot;text-align: center;&quot;>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-26-reg&quot;>האבחנה של מחלת פרקינסון מביאה איתה לעיתים קרובות תחושה של ערפל וחוסר וודאות. &amp;nbsp;פתאום, סדר היום המוכר משתנה ועולות שאלות רבות: איך ממשיכים מכאן? אילו זכויות מגיעות לי? האם יש מישהו שבאמת מבין מה עובר עליי ועל משפחתי?&amp;nbsp;חשוב שתדעו: אתם לא צריכים לעבור את הדרך הזו לבד. עמותת פרקינסון בישראל הוקמה כדי להיות המגדלור שלכם – מקום שבו מידע, קהילה ותמיכה מקצועית נפגשים ומסייעים לשיפור איכות החיים.&lt;/span>&lt;/span>&lt;/p>&#xa;"
                                textIsRich="true"/>
                            <separator_879022297_
                                cq:styleIds="[1662756456518]"
                                jcr:created="{Date}2025-11-17T01:09:04.441-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-12-28T04:17:52.093-05:00"
