                                jcr:title="מעטפת השירותים שמעניקה העמותה"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                langAttribute="none"
                                type="h2"
                                variant="h"/>
                            <text_1423662935
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2025-11-17T01:09:49.362-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2026-05-18T04:51:28.293-04:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                langAttribute="none"
                                text="&lt;p>הצטרפות לעמותה מעניקה גישה למגוון כלים שימושיים לניהול המחלה:&lt;/p>&#xd;&#xa;&lt;ul>&#xd;&#xa;&lt;li>&lt;b>תמיכה וליווי אישי&lt;/b>: קו חם למענה אנושי ברגעי קושי, ליווי ייעודי למאובחנים חדשים, קהילת צעירים&lt;b>&amp;nbsp;&lt;/b>הנותנת מענה ייחודי למאובחנים עד גיל 55, עם דגש על אתגרי קריירה ומשפחה.&lt;/li>&#xd;&#xa;&lt;li>&lt;b>מידע והעשרה מקצועית&lt;/b>: גישה לספריית הרצאות, בלוג מומחים על חידושים בטיפולים ורשימה ארצית של מומחים ומרפאות ייעודיות.&lt;/li>&#xd;&#xa;&lt;li>&lt;b>פעילות גופנית ופנאי&lt;/b>: תוכניות &amp;quot;כיוונים&amp;quot; ו&amp;quot;פרקינט&amp;quot; הכוללות חוגים מותאמים (גם מהבית) ופרויקטים ייחודיים כמו טניס שולחן לשיפור הקואורדינציה.&lt;/li>&#xd;&#xa;&lt;li>&lt;b>מיצוי זכויות והטבות&lt;/b>: ערכת זכויות, ייעוץ משפטי מול המוסדות ומועדון ההטבות &amp;quot;Parkinson Friend's&amp;quot; &amp;nbsp;לשיפור איכות החיים.&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;"
                                textIsRich="true"/>
