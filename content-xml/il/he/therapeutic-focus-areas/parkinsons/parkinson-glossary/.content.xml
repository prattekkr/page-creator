                                jcr:title="תופעות לוואי של טיפול תרופתי"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h2"
                                variant="h"/>
                            <text
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2025-11-17T03:13:33.287-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-12-30T03:39:04.988-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;u>דיסקינזיה&lt;br />&#xd;&#xa;&lt;/u>תנועות מעוגלות 'דמויות ריקוד', לא רצוניות, בעיקר בקצות הגפיים (אך לא רק). דיסקינזיה הינה תולדה אפשרית של טיפול מתמשך בתכשירים המכילים לבודופה, נוטה להופיע בשיא השפעת התרופה. שכיחותה גבוהה יותר בקרב חולים מבוגרים יותר.&lt;/p>&#xd;&#xa;&lt;p>&lt;u>דיסטוניה&lt;br />&#xd;&#xa;&lt;/u>התכווצות לא רצונית מתמשכת של השרירים, בכללם השרירים פושטי הגפה והשרירים מקרבי הגפה. מכיוון שהשרירים מתכווצים בו זמנית, נגרמת תנוחה חריגה של הגפה או הגו, או תנועה לא רצונית שלהם.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
