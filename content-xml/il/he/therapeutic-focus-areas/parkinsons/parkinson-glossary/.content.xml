                                jcr:primaryType="nt:unstructured"
                                jcr:title="התסמינים המוטוריים (תנועתיים) העיקריים:"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h2"
                                variant="h"/>
                            <text_1841366700
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2025-11-17T00:55:57.185-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-12-30T03:37:41.730-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;u>רעד&lt;br>&#xd;&#xa; &lt;/u>תנועה לא רצונית, קצבית (ריתמית), המופיעה בעיקר בקצות הגפיים (לרוב בכפות הידיים). הרעד במחלת פרקינסון מתאפיין בכך שהוא מופיע בעיקר כשהגפה במנוחה, פוחת בעת תנועה וניכר יותר בצד אחד של הגוף. מתח ועייפות נוטים להחמיר את הרעד.&lt;/p>&#xd;&#xa;&lt;p>&lt;u>ריגידיות (נוקשות שרירים)&lt;br>&#xd;&#xa;&lt;/u>נוקשות שרירים הנובעת מהתכווצות מתמדת של השרירים וקושי בהרפייתם. מתח השרירים המוגבר מכביד על התנועה, מאט את קצבה ועלול להוות מקור לכאבים.&lt;/p>&#xd;&#xa;&lt;p>&lt;u>ברדיקינזיה (איטיות בתנועה)&lt;br>&#xd;&#xa;&lt;/u>מצב בו הנעת שרירי הגוף מתבצעת בקצב איטי מהרגיל.&lt;/p>&#xd;&#xa;&lt;p>&lt;u>הפרעה בהחזרי שיווי המשקל והיציבה&lt;br>&#xd;&#xa;&lt;/u>הפרעה ביכולת לשמר יציבות בעת שינוי במרכז הכובד של הגוף (כגון בעת התקלות באדם או בחפץ או בשינוי תנוחה חד). הפרעה זו מגבירה את הנטייה לנפילות.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_1624848767_311274059
                                cq:styleIds="[1662756456518]"
                                jcr:created="{Date}2025-11-14T23:54:40.120-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2026-01-06T04:24:23.021-05:00"
