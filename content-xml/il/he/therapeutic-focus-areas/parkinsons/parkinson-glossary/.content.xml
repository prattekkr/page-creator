                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;div>&lt;span class=&quot;body-unica-20-reg&quot;>ירידה בהנעה הפנימית לפעולה (יוזמה), הזיות ראיה ומחשבות שווא שעלולות להופיע בשלב המתקדם של המחלה.&lt;/span>&lt;/div>&#xd;&#xa;"
