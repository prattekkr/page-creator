                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p style=&quot;text-align: center;&quot;>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-26-reg&quot;>מחלת פרקינסון היא מחלה ניוונית של מערכת העצבים המתאפיינת בהפרעות תנועה ותסמינים אחרים. כדי לסייע בהבנת המושגים הקשורים למחלה, יצרנו עבורכם מילון מונחים מקיף.&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
