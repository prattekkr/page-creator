                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>נכתב ע&amp;quot;י ד&amp;quot;ר זאב ניצן, מנהל השירות להפרעות תנועה, המרכז הרפואי האוניברסיטאי ברזילי.&lt;br>&#xd;&#xa;למידע נוסף יש לפנות לרופא/ה המטפל/ת.&lt;br>&#xd;&#xa;המידע מוגש כשירות לציבור מטעם חברת AbbVie.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
