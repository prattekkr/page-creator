                                jcr:created="{Date}2025-11-17T03:27:42.150-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-11-17T03:32:40.575-05:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>הרפואה המשלימה כשמה, אוצרת בחובה היבטים טיפוליים המשלימים את המענה הטיפול של הרפואה הקונבנציונלית. טיפולי רפואה משלימה הינם בעלי השפעה מטיבה מוכחת על מצבם של חולי פרקינסון, הטיפולים הבולטים: אמניות לחימה כגון טאי צ'י, צ'י קונג, יוגה ומדיטציה (ושיטות התרגעות נוספות), ריקוד, ריפוי במוסיקה, ריפוי באמנות, אוסטאופתיה, דיקור סיני, רפלקסולוגיה, ביופידבק וכמובן פעילות גופנית סדירה כמו שחיה, רכיבה על אופניים ועוד.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_1624848767_1858421423
