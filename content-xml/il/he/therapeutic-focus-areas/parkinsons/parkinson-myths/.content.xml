                                jcr:lastModified="{Date}2025-12-30T03:51:52.813-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;b>מחלת הפרקינסון מלווה לעיתים בתפיסות ואמונות שגויות שגורמות לחרדה מיותרת ועלולות למנוע מהמטופלים לקבל את הטיפול המתאים ביותר עבורם.&lt;/b>&lt;/p>&#xd;&#xa;&lt;p>פרופ' שרון חסין, מנהלת המכון להפרעות תנועה מבית חולים שיבא תל השומר מפריכה במדויק את המיתוסים הנפוצים ביותר ומעניקה מידע עדכני וחיוני על אפשרויות הטיפול השונות.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <video
