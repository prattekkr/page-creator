                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <title_1404561168
                                cq:styleIds="[1659545825678,1651545825694]"
                                jcr:created="{Date}2025-11-17T01:09:09.692-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2026-01-06T04:08:26.176-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="טיפולים מתקדמים:"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h2"
                                variant="h"/>
                            <text_1423662935
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2025-11-17T01:09:49.362-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2026-01-19T08:25:42.003-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;ul>&#xd;&#xa;&lt;li>קוצב מוחי (DBS) -&amp;nbsp;השתלת אלקטרודות במוח וקוצב בקיר החזה (מתאים לפחות מ-10% מהחולים)&lt;/li>&#xd;&#xa;&lt;li>משאבה דרך מערכת העיכול -&amp;nbsp;מטפטפת תרופה דרך מערכת העיכול, טיפול זה מצריך הליך ניתוח גסטרוסקופי של החדרת צינורית מדופן הבטן לתוך הקיבה וצינור נוסף לתריסריון.&lt;/li>&#xd;&#xa;&lt;li>טיפול תת עורי ותיק -&amp;nbsp;של תרופה מקבוצה אחרת, אשר ניתן בהזלפה בסיוע משאבה.&lt;/li>&#xd;&#xa;&lt;li>טיפול תת-עורי רציף חדש -&amp;nbsp;כיום, עבור מטופלים עם מחלה מתקדמת קיימת אפשרות נוספת וחדשנית - טיפול בעירוי תת-עורי באמצעות משאבה שמזליפה תרופה באופן רציף לאורך כל שעות היממה.&amp;nbsp; הטיפול לא מצריך הליך פולשני, מה שמאפשר טיפול מיטבי עם פחות סיכונים ונוחות מרבית למטופל.&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_879022297__279766434
                                cq:styleIds="[1662756456518]"
                                jcr:created="{Date}2025-11-17T01:09:04.441-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-12-28T04:17:52.093-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <text_1900808612_copy
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2025-11-17T00:56:55.506-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-12-30T03:54:20.394-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;b>מיתוס: התסמינים של מחלת הפרקינסון הם תנועתיים בלבד&lt;br>&#xd;&#xa;&lt;/b>למחלת הפרקינסון יש בדרך כלל גם ביטויים שאינם תנועתיים, למשל האטה בתפקוד מערכת העיכול, הפרעות במערכות השתן והמין. המתמודדים עם פרקינסון יכולים לסבול גם מהפרעות שינה, קשיים בוויסות חום, ויסות לחץ דם ודופק, ועלולים לפתח דכאון וחרדה. במחלה מתקדמת יכולה להופיע גם ירידה קוגניטיבית.&lt;/p>&#xd;&#xa;&lt;p>&lt;b>מיתוס: אין דרך להאט את התקדמות המחלה&lt;br>&#xd;&#xa;&lt;/b>מחקרים הראו שפעילות גופנית מעכבת את הופעת המחלה, מאטה את התקדמותה, ומשפרת את תסמיני המחלה ואת איכות החיים. ההמלצה היא לקיים פעילות אירובית בעצימות גבוהה, כמו ריצה, שחייה, הליכה מהירה או חדר כושר, למשך כשעה ביום, 5 פעמים בשבוע. גם פעילויות ספורטיביות ותנועתיות אחרות מועילות למטופלים.&lt;/p>&#xd;&#xa;&lt;p>&lt;b>היום, עם הטיפול המתאים ושמירה על אורח חיים נכון, אפשר לחיות חיים מלאי משמעות לצד מחלת הפרקינסון.&lt;/b>&lt;br>&#xd;&#xa;&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <text_1107226190
                                jcr:created="{Date}2025-11-17T01:14:45.707-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-11-17T01:14:57.286-05:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>המידע מוגש כשירות לציבור מטעם חברת AbbVie.&lt;br>&#xd;&#xa;למידע נוסף יש לפנות לרופא/ה המטפל/ת.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
