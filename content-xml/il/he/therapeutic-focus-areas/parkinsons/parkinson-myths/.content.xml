                                jcr:title="מה באמת צריך לדעת על מחלת הפרקינסון?"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h2"
                                variant="h"/>
                            <text_1900808612
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2025-11-17T00:56:55.506-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-12-30T03:52:41.916-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;b>מיתוס: התסמין המרכזי של פרקינסון הוא רעד&lt;br>&#xd;&#xa; &lt;/b>בניגוד לאמונה הרווחת&lt;b>,&amp;nbsp;רעד אינו התסמין המרכזי של פרקינסון.&amp;nbsp;&amp;nbsp;&lt;/b>למעשה, רק 3 מתוך&lt;b> &lt;/b>4&lt;b> &lt;/b>חולים חווים רעד כתסמין ראשון, ויש מטופלים שלא חווים רעד כלל.&amp;nbsp;התסמין המגדיר והעיקרי &lt;b>הוא &amp;quot;בראדיקינזיה&amp;quot;&lt;/b>&amp;nbsp;- איטיות תנועתית והקטנת תנועות, שמהווה את הקריטריון המוטורי המרכזי לאבחון &lt;b>המחלה.&lt;br>&#xd;&#xa; &lt;br>&#xd;&#xa; מיתוס: פרקינסון היא מחלה של הגיל השלישי&lt;br>&#xd;&#xa; פרקינסון יכול להופיע גם בגילאים צעירים יותר.&amp;nbsp;&lt;/b>למרות שהגיל הממוצע להופעת&lt;b> &lt;/b>המחלה הוא כ-60, אחוז משמעותי של חולים מפתחים את המחלה לפני גיל 40, ובוודאי לפני גיל 50. זהו מידע חשוב שיכול לעזור באבחון מוקדם וטיפול יעיל יותר.&lt;br>&#xd;&#xa;&lt;br>&#xd;&#xa;&lt;b>מיתוס: כשהמחלה מתקדמת חייבים ניתוח&lt;br>&#xd;&#xa; &lt;/b>בשלבים הראשונים של המחלה,&amp;nbsp;רוב המטופלים מצליחים להסתדר היטב עם&amp;nbsp;טיפול תרופתי בשילוב פעילות גופנית.&amp;nbsp;עם זאת, עבור מטופלים עם מחלה מתקדמת קיימות כיום מספר אפשרויות טיפול שונות&lt;b>:&lt;/b>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_879022297__950729984
                                cq:styleIds="[1662756456518]"
                                jcr:created="{Date}2025-11-17T01:09:04.441-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-12-28T04:17:52.093-05:00"
