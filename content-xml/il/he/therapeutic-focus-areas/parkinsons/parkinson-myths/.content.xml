                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p style=&quot;text-align: center;&quot;>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-26-reg&quot;>עובדות חשובות שכל מטופל.ת ובן משפחה צריכים לדעת&lt;br />&#xd;&#xa; &lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
