                            <text
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2025-11-20T03:36:23.847-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-12-28T05:46:05.092-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;b>מה חולל את השינוי?&lt;br>&#xd;&#xa; &lt;/b>חודשים של חיפושים ובדיקות אצל רופאים הסתיימו רק כשהגיע לראומטולוג שאבחן אותו בדלקת מפרקים שגרונית – מחלה אוטואימונית כרונית, שבה מערכת החיסון תוקפת את המפרקים וגורמת לדלקת, כאבים ונפיחות, ובמקרים ללא טיפול – לנזק בלתי הפיך. &amp;quot;הרופא אמר לי: אין תרופה שמרפאת, אבל יש היום טיפולים מעולים. לכל אחד יש את מה שמתאים לו&amp;quot;, נזכר רונן.&lt;/p>&#xd;&#xa;&lt;p>ההבנה עם מה הוא מתמודד הייתה נקודת המפנה. רונן יצא למסע בין טיפולים – מטיפולים קונבנציונליים ועד מתקדמים, שכל אחד מהם פועל אחרת, ניתן בצורה שונה ומגיב בקצב שונה. &amp;quot;עברתי ארבעה טיפולים עד שמצאתי את זה שבאמת התאים לי&amp;quot;, הוא אומר.&lt;/p>&#xd;&#xa;&lt;p>&lt;b>מה המסר שלך למטופלים אחרים?&lt;br>&#xd;&#xa; &lt;/b>״אסור לאבד תקווה&amp;quot;, חייבים להמשיך לנסות. כיום הגעתי למצב שאני חי כמו אדם רגיל: הולך רגיל, עושה ספורט, כאילו כלום. אני מאוד פעיל בפייסבוק בקבוצות של RA. הרבה פעמים אני רואה חולים מיואשים ואני מסביר להם שיש פתרונות. על כל אחד משפיעה תרופה אחרת, לכן חשוב לא לוותר על שליטה במחלה ולהמשיך לנסות עד שמוצאים את הטיפול שעוזר באמת .&lt;/p>&#xd;&#xa;&lt;p>האבחון והטיפול הנכון זה כמו לידה מחדש. קשה לתאר את זה – שמחה אדירה. פתאום יש פחות כאבים. למדתי על עצמי כמה כוח יש לי להתמודד עם דברים כאלה. גיליתי עם הזמן שאני יכול להיות אופטימי. אפשר להתמודד, יש פתרונות ויש טיפולים. היום אני לא חושב על זה שאני חולה בכלל״.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <text_817842601
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2025-11-20T03:37:35.887-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-12-28T05:42:32.478-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>המידע המובא אינו מהווה המלצת רופא, חוות דעת מקצועית או תחליף למי מהם.&lt;br />&#xd;&#xa;למידע נוסף יש לפנות לרופא/ה המטפל/ת.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
