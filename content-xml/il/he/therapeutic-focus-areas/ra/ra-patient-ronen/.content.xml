                            <text_398730945_copy_
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2025-11-14T23:54:51.490-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-12-28T05:41:07.231-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p style=&quot;text-align: center;&quot;>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-26-reg&quot;>החיים שלנו מלאים בפעולות קטנות שאנו עושים מבלי לחשוב – לצחצח שיניים, לנעול נעליים, להכין קפה. אבל כשהתפרצה אצל רונן זהר דלקת מפרקים שגרונית, אפילו הפעולות הפשוטות הללו הפכו לאתגר של ממש. הוא יצא למסע ארוך שכלל פגישות עם רופאים, אינספור בדיקות ותרופות שונות – עד שמצא סוף סוף את הטיפול שמתאים לו. המסר שלו ברור: ״אסור לאבד תקווה״. צפו בסיפורו&lt;br>&#xd;&#xa; &lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_879022297_
                                cq:styleIds="[1662756456518]"
                                jcr:created="{Date}2025-11-17T01:09:04.441-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-12-28T04:17:52.093-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <text_1841366700
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2025-11-17T00:55:57.185-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-11-20T03:31:01.367-05:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>״עד לפני שש שנים חייתי חיים רגילים לחלוטין״, נזכר רונן זהר, בן 61 מראשון לציון. ״עבודה, בית,&amp;nbsp; זוגיות, שלוש בנות, נכדות, אורח חיים ספורטיבי. ואז, יום אחד – הכול נעצר. התחלתי להרגיש כאבים. התקשיתי לבצע פעולות שגרתיות, שאנחנו לא חושבים עליהן בכלל. רציתי לצחצח שיניים - לא הצלחתי להרים את היד לכיוון הפה. רציתי לנעול נעליים בבוקר – לא הצלחתי לשרוך&amp;nbsp; את השרוכים עם האצבעות. פתאום אני צריך להשקיע חמש דקות לשרוך כל נעל.&lt;/p>&#xd;&#xa;&lt;p>״הייתי שוכב כל הערב מול הטלוויזיה ולא זז; עומד במקלחת ולא מצליח להרים את היד כדי להתנגב. המשרד שלי ממוקם בקומה ראשונה וצריך לעלות אליו במדרגות. זה הפך לסיוט עבורי כל בוקר לטפס במעלה המדרגות הללו. כשהבנות הזמינו אותי לארוחה, הן היו צריכות לסחוב אותי משני הצדדים. נאלצתי אפילו לוותר על הכלב כי לא הצלחתי לצאת איתו לטיולים״&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <video
                                cq:styleIds="[1]"
                                jcr:created="{Date}2025-11-20T03:35:16.993-05:00"
                                jcr:createdBy="singarx"
