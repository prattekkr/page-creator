                                jcr:primaryType="nt:unstructured"
                                jcr:title="מגוון אפשרויות טיפול"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h2"
                                variant="h"/>
                            <text
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2025-11-17T03:13:33.287-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2026-02-17T03:46:18.365-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span>לאחר האבחון, מגיע הזמן להתאים טיפול. עם הזמן, חלה התקדמות בטיפול ב-RA וכיום ניתן לשלוט במחלה, למנוע נזקים עתידיים ולשפר את איכות החיים. הטיפול כולל תרופות ממשפחות שונות שמטרתן לרסן את הדלקת, למנוע פגיעה במפרק ולהשיג רמיסיה (הפוגה). לצד סטרואידים ומשככי כאבים, הניתנים כטיפול לטווח קצר שמיועד להקל על התסמינים, קיימים גם טיפולים מתקדמים ייעודיים ל-RA:&lt;/span>&lt;/p>&#xd;&#xa;&lt;ul>&#xd;&#xa;&lt;li>NSAIDs - תרופות נוגדות דלקת שאינן סטרואידיות.&lt;/li>&#xd;&#xa;&lt;li>DMARDs - תרופות המשנות את מהלך המחלה, שמטרתן להאט את התקדמותה ולמנוע נזק למפרקים.&lt;/li>&#xd;&#xa;&lt;li>טיפולים מתקדמים שמשפיעים על מערכת החיסון ועל התהליך הדלקתי. הם נבדלים, בין השאר, במנגנוני הפעולה, במהירות התגובה ובדרך המתן - כדורים, עירויים או זריקות.&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;&lt;p>לרוב, הטיפול המיטבי משלב תרופות עם טיפולים לא תרופתיים כמו פיזיותרפיה ועם שינויים באורח חיים כמו הפסקת עישון.&lt;/p>&#xd;&#xa;&lt;p>דלקת מפרקים שגרונית היא מחלה מורכבת אך ניתן להתמודד איתה בצורה טובה עם אבחון מוקדם וטיפול מותאם אישית. ככל שנעלה את המודעות למחלה ונדע לזהות את התסמינים, נוכל לטפל טוב יותר ולשפר את איכות החיים. כיום אין סיבה להתפשר על איכות החיים. אם טיפול מסוים לא משיג את התוצאה הרצויה או מאבד מיעילותו, כדאי לנסות טיפולים אחרים, שכן יש היום מגוון רחב מאוד של תרופות ואפשרויות טיפול. אז אל תוותרו על שליטה במחלה, שאלו את הרופא על טיפולים חדשים, נוחים, ומהירי השפעה.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
