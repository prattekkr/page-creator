                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p style=&quot;text-align: center;&quot;>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-26-reg&quot;>דלקת מפרקים שגרונית היא דלקת המפרקים השכיחה ביותר. המחלה גורמת לכאבים ולנפיחות במפרקים ונוטה להשפיע במקביל על מפרקים בשני צדי הגוף. חיוני לאבחן את המחלה בשלביה המוקדמים, כי בעזרת טיפול מתאים ומוקדם אפשר למנוע נזק בלתי הפיך למפרקים. הנה מה שאתם צריכים לדעת&lt;br />&#xd;&#xa; &lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_879022297_
                                cq:styleIds="[1662756456518]"
                                jcr:created="{Date}2025-11-17T01:09:04.441-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-12-28T04:17:52.093-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <text_1841366700
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2025-11-17T00:55:57.185-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2026-02-17T03:46:03.431-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>דלקת מפרקים שגרונית (Rheumatoid Arthritis, RA) היא מחלה אוטואימונית כרונית בה מערכת החיסון תוקפת את רקמות הגוף, בעיקר את המפרקים. כתוצאה מכך, מתעוררת דלקת שגורמת לנפיחות וכאבים במפרקים, בעיקר בידיים, ברגליים ובברכיים. אם המחלה אינה מטופלת, היא עלולה לגרום לנזק בלתי הפיך למפרקים, לפגיעה בתפקוד היומיומי ואף להוביל לנכות במקרים חמורים. מלבד המפרקים, RA יכולה להשפיע גם על מערכות נוספות בגוף ובהן הלב, הריאות והעיניים.&lt;/p>&#xd;&#xa;&lt;p>RA פוגעת בעד כאחוז מהאוכלוסייה והיא דלקת המפרקים השכיחה ביותר. דלקת מפרקים שגרונית מופיעה בדרך כלל בגילאי 35 עד 50, אך היא יכולה להופיע גם בגיל צעיר יותר ואף בגיל מבוגר. נשים מושפעות מהמחלה פי 2.5 יותר מאשר גברים. הגורמים לדלקת מפרקים שגרונית אינם ידועים במלואם, אך לפי הערכות היא נגרמת בשל שילוב של מרכיבים גנטיים, חיסוניים וסביבתיים כמו זיהומים, טראומה, עישון וגורמי לחץ.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
