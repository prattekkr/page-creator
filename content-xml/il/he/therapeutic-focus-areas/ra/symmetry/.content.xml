                                jcr:title="מכאבים ועד ירידה בתפקוד"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h2"
                                variant="h"/>
                            <text_1423662935
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2025-11-17T01:09:49.362-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-12-28T04:39:53.266-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>דלקת מפרקים שגרונית היא מחלה מתקדמת המתבטאת בהתקפים ובשינויים בחומרת הדלקת לאורך הזמן, כאשר הנזק למפרקים הולך ומצטבר. מהלך המחלה משתנה מאוד בין מטופלים שונים, אך ככלל, תסמיני RA נוטים להיות סימטריים ומופיעים לרוב בשני צדי הגוף, כך שאם יד ימין מושפעת, סביר שגם יד שמאל תושפע. התסמינים השכיחים כוללים:&lt;/p>&#xd;&#xa;&lt;ul>&#xd;&#xa;&lt;li>כאב מתמשך במפרקים, לרוב מוחמר בבוקר לאחר שנת לילה או לאחר חוסר תנועה.&lt;/li>&#xd;&#xa;&lt;li>נוקשות בוקר לאחר הקימה, שעלולה להימשך שעות.&lt;/li>&#xd;&#xa;&lt;li>נפיחות – המפרקים הופכים לנפוחים ואדומים.&lt;/li>&#xd;&#xa;&lt;li>חום, עייפות וחולשה כללית.&lt;/li>&#xd;&#xa;&lt;li>ירידה בתפקוד – ככל שהמחלה מתקדמת, חולים רבים מתקשים לבצע פעולות יומיומיות פשוטות. המטופלים מתארים קשיים בלבישת חולצה ופשיטתה ובתנועות של הכנת מזון, כמו גם קשיים בשינה, בקימה מהמיטה ובהחזקת מברשת שיניים וסירוק שיער&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;&lt;p>עם התקדמות דלקת מפרקים שגרונית, המפרקים עלולים להתעוות ולהפוך לנוקשים עד כדי שנגרם להם נזק בלתי הפיך. לכן אבחון מוקדם הוא חיוני. האבחון עצמו מתבסס על שילוב של בדיקות דם, בדיקות דימות ובחינת התסמינים. ככל שהמחלה תאובחן מוקדם יותר – ניתן יהיה להתחיל לטפל מוקדם יותר וכך לעכב את התקדמות המחלה.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <text_1841366700_copy_1243776584
