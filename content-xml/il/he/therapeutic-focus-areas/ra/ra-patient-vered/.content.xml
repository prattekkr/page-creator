                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p style=&quot;text-align: center;&quot;>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-26-reg&quot;>לפני 14 שנים, אובחנה ורד קסוטו עם דלקת מפרקים שגרונית. כשהמחלה החריפה והיא בקושי הצליחה לעמוד בכוחות עצמה, החל מסע ארוך של חיפושים אחר מענה שיתאים לה. לאחרונה, ורד החלה לקבל טיפולים מתקדמים שחוללו שינוי מהיר ומשמעותי – וכיום היא אימא במשרה מלאה לפעוט בן שנתיים&lt;br />&#xd;&#xa; &lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_879022297_
                                cq:styleIds="[1662756456518]"
                                jcr:created="{Date}2025-11-17T01:09:04.441-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-12-28T04:17:52.093-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <text_1841366700
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2025-11-17T00:55:57.185-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-11-20T04:12:04.746-05:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>״המחלה התגלתה אצלי ב-2012, חודש אחרי שחזרתי מטיול של חצי שנה באוסטרליה, ניו זילנד ותאילנד״, נזכרת ורד קסוטו, אימא לפעוט בן שנתיים מהרצליה. ״הרגליים שלי התנפחו וחודש לאחר מכן כבר לא יכולתי לעמוד מרוב כאב. בהמשך הכאב התפשט גם לידיים. זה היה תחילתו של מסע בין רופאים רבים, עם עליות ומורדות – עד שמצאתי טיפול שמתאים לי.&lt;/p>&#xd;&#xa;&lt;p>״אובחנתי עם דלקת מפרקים שגרונית, שהיא מחלת מפרקים אוטואימונית. כלומר הגוף שלי תוקף את עצמו ונוצרת דלקת שפוגעת במפרקים. עם השנים גם התפתחו אצלי עיוותים במפרקים שבכפות הידיים. ניסיתי להחזיק סכין וגיליתי לפתע שאני לא מצליחה לחתוך סלט. לא הצלחתי להדליק את התנור. הדברים שנראים לנו כל כך מובנים מאליהם – לקום בבוקר, לעמוד על הרגליים – קיבלו פתאום משמעות אחרת״.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <video
                                cq:styleIds="[1]"
                                jcr:created="{Date}2025-11-20T04:17:38.285-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2026-04-29T08:15:57.725-04:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/video/v2/video"
                                autoPlayBrightcovePlaylistvideo="false"
                                brightcoveAccount="1029485116001"
                                brightcoveAutoPlay="true"
                                brightcovePlayerId="default"
                                brightcovePlaylistAccount="2157889325001"
                                brightcoveVideoId="6377902955112"
                                dmPresetType="imagePreset"
                                fileReference="/content/dam/abbvie-com2/il/images/ra/ra-patient-vered.png"
                                loopBrightcovePlaylistVideo="false"
                                loopVideo="false"
                                showBrightcoveControls="true"
