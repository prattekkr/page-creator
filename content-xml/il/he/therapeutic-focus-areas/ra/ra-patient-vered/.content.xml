                                youtubeAutoPlay="true"/>
                            <text
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2025-11-20T04:19:27.640-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2026-01-15T08:28:49.995-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;b>איך התמודדת עם המצב החדש?&lt;br>&#xd;&#xa; &lt;/b>״בהתחלה שתיתי מרקחות מצמחים, עשיתי אמבטיות שמן לידיים, תרגלתי מדיטציות ושיניתי את התזונה שלי. התחלתי להתעניין בכוח הריפוי הטבעי של הגוף ולמדתי נטורופתיה ורפלקסולוגיה. בין הטיפולים השונים, הייתה לי תקופה של שש שנות רמיסיה, שבמהלכן עבדתי המון עם הידיים, גם בקליניקה שפתחתי וגם כמלצרית.&amp;nbsp;ואז הגיעה התלקחות רצינית. זה התחיל בכפות הידיים ועבר לכפות הרגליים. לפני החתונה לא הצלחתי לצעוד במשך חודש שלם. התחתנתי כשאני בקושי הולכת, בקושי עומדת. ראיתי איך הגוף שלי הולך וקורס לתוך עצמו, והתחושה הייתה זוועה. ואז הגיע ההיריון – ושוב הרגשתי מדהים״.&lt;/p>&#xd;&#xa;&lt;p>&lt;b>ממש רכבת הרים.&lt;br>&#xd;&#xa; &lt;/b>״כן. כל התסמינים חלפו כלא היו, חזרתי לעבוד עם הידיים וכך זה נמשך עד הלידה. זמן קצר אחרי הלידה לא הצלחתי להרים את התינוק שלי״.&lt;/p>&#xd;&#xa;&lt;p>&lt;b>מתי הגיע השינוי?&lt;br>&#xd;&#xa; &lt;/b>״החלטתי להיות אימא חזקה ובריאה עבורי ועבור התינוק שלי. אמרתי לעצמי שאני חייבת לעשות שינוי, גם אם הוא כולל טיפול שעד עכשיו נמנעתי מלקבל, בגלל האמונה שאני יכולה לרפא את עצמי. בתקופה ההיא נחשפתי לאחד מבין הטיפולים המתקדמים שקיימים בשוק, אחרי 11 שנים של עליות ומורדות עם המחלה. פתאום לא כואב לי, אני יכולה להחזיק את הילד שלי. אפשר לחיות! לחיות בלי כאבים, בלי ניוון ובלי מוגבלות. אני זוכרת שבתקופה שלא יכולתי ללכת, הכי חשוב היה לי להצליח שוב לקחת את הילד שלי ברגל לגן. היום אני עושה את זה מדי בוקר״.&lt;/p>&#xd;&#xa;&lt;p>&lt;b>מה המסר שלך למי שמתמודדים עם דלקת מפרקים שגרונית?&lt;br>&#xd;&#xa; &lt;/b>״אל תהיו קורבן של המחלה. לא צריך לסבול. לא צריך להתפשר על איכות החיים, או להיתקע על טיפול שלא עובד ולקבל את המצב כגזירת גורל. אל תוותרו. קחו שליטה על המחלה. תקשיבו לרופאים, אבל גם ללב ולאינטואיציה שלכם, ואל תחששו לשאול על טיפולים חדשים. היום אפשר לחיות טוב מאוד עם המחלה. אני שמחה שהייתי מספיק קשובה לעצמי וברגע שהטיפול לא היה יעיל – הבנתי שמשהו צריך להשתנות. מצאתי טיפול שטוב לי״.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <text_817842601_copy
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2025-11-20T03:37:35.887-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-12-28T05:49:48.211-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>המידע המובא אינו מהווה המלצת רופא, חוות דעת מקצועית או תחליף להם.&lt;br>&#xd;&#xa;למידע נוסף יש לפנות לרופא/ה המטפל/ת.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
