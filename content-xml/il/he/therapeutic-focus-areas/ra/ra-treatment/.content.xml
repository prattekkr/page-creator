                                jcr:title="מתאימים את הטיפול הנכון"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h2"
                                variant="h"/>
                            <text_copy_copy_1984417122
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2025-11-17T03:13:33.287-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-11-18T03:56:03.481-05:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>בהחלטה על התאמת הטיפול הנכון מעורבים גורמים רבים. ״אנחנו שוקלים יעילות של טיפולים ותופעות לוואי. צריך גם לקחת בחשבון מחלות רקע כגון עישון, סרטן, מחלות לב וכלי דם או הפרעות בכבד, שלא מאפשרות לתת לחולה טיפולים מסוימים״ מסביר ד״ר גיאת.&lt;/p>&#xd;&#xa;&lt;p>חשוב שהמטופל יהיה מעורב בהחלטות הקשורות לטיפול. ״כלל אצבע הוא שככל שחולה יותר מיודע באשר לאפשרויות הטיפול השונות - עולה הסבירות שהוא יתמיד בטיפול הנבחר ושהטיפול יצליח״, מוסיף ד״ר גיאת. ״לא להתבייש. לשאול את הרופא הכל. חשוב להציף בשיח על הטיפול, הרגלים והעדפות אישיות, כמו במקרה של מטופלים שקשה להם עם זריקות, או שמרבים לטוס לחו״ל ומתקשים להתנהל עם קירור התרופה. הנוחות למטופל חשובה, כי זה לא משנה כמה התרופה יעילה אם המטופל לא לוקח אותה. צריך אמון ותקשורת טובה בין המטופל והרופא, גם אחרי שמתחילים טיפול. מוטב לא לשמור דברים בבטן. אם, למשל, דילגת על טיפול בתרופה - מאוד חשוב שתגיד את זה לרופא״.&lt;/p>&#xd;&#xa;&lt;p>את הטיפול עצמו חשוב להתחיל מוקדם ככל הניתן. ״עשרות מחקרים הראו כי טיפול מוקדם מעלה את הסיכוי לתגובה לטיפול, מפחית סיכון לנזק למפרק ולתסמונות כאב ומגדיל מאוד את הסיכוי להפוגה מלאה. במאה ה-20 הגישה הייתה לדחות את הטיפול עד כמה שניתן ועקב כך רבים הגיעו לכיסא גלגלים. זה משהו שכבר כמעט לא רואים היום, בזכות מגוון אפשרויות הטיפול והטיפול המוקדם. צריך גם לזכור שזו מחלה סיסטמית - ללא טיפול, הדלקת הכרונית עלולה לגרום נזק לא רק למפרקים אלא גם למערכות אחרות כמו לב, ריאות ועיניים״.&lt;/p>&#xd;&#xa;&lt;p>התאמת הטיפול הנכון למטופל עם דלקת מפרקים שגרונית אינה החלטה חד פעמית. חשוב שכל מטופל יימצא במעקב לניטור של מדדי פעילות המחלה כדי לוודא שזהו עדיין הטיפול המתאים ביותר עבורו. ״גם אם הוא מרגיש מצוין. צריך עדין לבדוק אם יש דלקת סמויה, תופעות לוואי או צורך לבצע התאמות״, מבהיר ד״ר גיאת.&lt;/p>&#xd;&#xa;&lt;p>בימינו, ניתן לחיות היטב לצד דלקת מפרקים שגרונית, למנוע נזקים עתידיים ולמקסם את איכות החיים. סובלים מהתסמינים ומפגיעה בתפקוד? אל תוותרו על שליטה במחלה. פנו לראומטולוג ושאלו אותו על טיפולים חדשים שיכולים לעזור לכם להגיע לרמיסיה.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
