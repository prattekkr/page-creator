                            <title_79602002
                                cq:styleIds="[1659545825678,1651545825694]"
                                jcr:created="{Date}2025-11-17T03:12:53.492-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2026-01-01T04:27:51.892-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="מגוון אפשרויות"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h2"
                                variant="h"/>
                            <text
                                jcr:created="{Date}2025-11-17T03:13:33.287-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-11-18T03:51:32.587-05:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>כיום קיים מגוון גדול של טיפולים תרופתיים לדלקת מפרקים שגרונית שמטרתם להפחית את פעילות המחלה הדלקתית. ביכולתם לסייע להגיע להפוגה ובכך לא רק להפחית תסמינים ולשפר את איכות החיים, אלא גם למנוע נזקים בלתי הפיכים ומוגבלות בעתיד.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_996582572
                                jcr:created="{Date}2025-11-17T03:14:01.214-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-11-17T03:14:01.214-05:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <title_393085719
                                cq:styleIds="[1659545825678,1651545825694]"
                                jcr:created="{Date}2025-11-17T03:14:08.506-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2026-01-01T04:28:05.276-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="טיפולים סינתטיים נוגדי דלקת (Conventional synthetic DMARDs)"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h2"
                                variant="h"/>
                            <text_copy
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2025-11-17T03:13:33.287-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-11-18T03:52:23.536-05:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>הטיפול בתרופות שונות מקבוצת ה-DMARDs הוא לרוב הטיפול הראשון שניתן למאובחנים עם דלקת מפרקים שגרונית. הטיפול עשוי להינתן בתרופה אחת או בשילוב של שתיים-שלוש תרופות מהקבוצה.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_879022297__824016865
                                cq:styleIds="[1662756456518]"
                                jcr:created="{Date}2025-11-17T01:09:04.441-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-12-28T04:17:52.093-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <title_624067795
                                cq:styleIds="[1659545825678,1651545825694]"
                                jcr:created="{Date}2025-11-17T03:17:03.113-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2026-01-01T04:28:12.795-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="טיפולים ביולוגיים וטיפולים מכווני מטרה"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h2"
                                variant="h"/>
                            <text_copy_copy
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2025-11-17T03:13:33.287-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-11-18T03:53:47.220-05:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>הטיפולים המתקדמים שכוללים תרופות ביולוגיות ותרופות מכוונות מטרה כלולים כיום בסל התרופות רק לאחר ניסיון טיפולי בלפחות שלושה תכשירים מקבוצת DMARDs.&lt;/p>&#xd;&#xa;&lt;p>התרופות הביולוגיות הופיעו בסוף שנות ה-90 ויצרו מהפכה בטיפול של דלקת מפרקים שגרונית. הטיפולים הביולוגיים ניתנים בזריקות או עירויים. קבוצה מרכזית של תרופות ביולוגיות לטיפול בדלקת מפרקים שגרונית היא חוסמי TNF אלפא&lt;i>.&amp;nbsp;&lt;/i>״התרופות מהקבוצה יעילות, ותיקות, ונחשבות בטוחות למדי״, מסביר ד״ר גיאת. קבוצה נוספת של תרופות היא מעכבי אינטרלוקין 6: ״היתרון של התרופות מקבוצה זו הוא שבדרך כלל הן יעילות גם כתרופה יחידה״, מסביר ד״ר גיאת.&lt;i>&lt;/i>&lt;/p>&#xd;&#xa;&lt;p>טיפולים נוספים הם מעכבי שפעול תאי T – טיפול ביולוגי שניתן בזריקה; ונוגדן חד שבטי מקבוצת חוסמי תאי B שניתן בעירוי. ״תרופה זו יעילה ביותר לחולים עם נוגדני מחלה. החיסרון שלה הוא שמלבד תופעות לוואי, במשך חצי שנה המטופל תחת השפעת התרופה ויש מגבלות על מתן טיפול אחר״, מפרט ד״ר גיאת.&lt;/p>&#xd;&#xa;&lt;p>בשנים האחרונות נוספו גם טיפולים מכווני מטרה מקבוצת מעכבי JAK – מולקולות קטנות שנכנסות לתא ופועלות לדיכוי האנזים JAK שמעורב בתהליך הדלקתי. ״התגובה לטיפולים אלו נוטה להיות מהירה ובניגוד לתרופות ביולוגיות אחרות - הגוף לא מפתח נגדן נוגדנים ולכן הן יעילות לאורך זמן. הן גם נוחות, כי הן ניטלות בטבליות (כדורים) ולא דורשות אחסון בקירור״.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
