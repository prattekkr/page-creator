                            <text_398730945_copy_
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2025-11-14T23:54:51.490-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-12-28T05:59:54.675-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p style=&quot;text-align: center;&quot;>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-26-reg&quot;>דלקת מפרקים שגרונית עלולה לגרום לכאבים קשים, לפגיעה באיכות החיים ואף לנכות. הראומטולוג ד״ר איתן גיאת מסביר שהתאמה נכונה של הטיפול יכולה לעכב את התקדמות המחלה ואפילו להביא להפוגה של ממש: ״יש מטופלים שמרגישים מצוין כבר 15-20 שנה״&lt;br>&#xd;&#xa; &lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_879022297_
                                cq:styleIds="[1662756456518]"
                                jcr:created="{Date}2025-11-17T01:09:04.441-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-12-28T04:17:52.093-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <text_1841366700_copy
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2025-11-17T00:55:57.185-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-12-25T07:30:07.995-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>דלקת מפרקים שגרונית (Rheumatoid Arthritis ובקיצור RA) היא מחלה כרונית אוטואימונית שבמהלכה מערכת החיסון תוקפת את המפרקים ולעיתים גם איברים אחרים בגוף כמו הלב, הריאות או העיניים. המחלה גורמת לדלקת, כאב, רגישות, נוקשות, נפיחות ומגבלות תנועה קשות במפרקים, ועלולה לגרום לתסמינים נוספים שנובעים מפגיעה באיברים שונים בגוף, ואף מעלה סיכון לתמותה.&lt;/p>&#xd;&#xa;&lt;p>דלקת מפרקים שגרונית, ששכיחה בקרב כאחוז מהאוכלוסייה, עלולה לפגוע קשות באיכות החיים בשל כאבים וקושי בתפקוד היומיומי. אך כיום, בזכות מגוון של טיפולים מתקדמים - ניתן לשלוט בתסמיני המחלה, לשפר את התפקוד ולמנוע היווצרות של נזקים בלתי הפיכים למפרקים. למעשה, אין כבר שום צורך להתפשר על איכות החיים.&amp;nbsp;&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <text_1841366700_copy_317194835
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2025-11-17T00:55:57.185-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2026-02-22T04:29:13.838-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;a href=&quot;/content/dam/abbvie-com2/il/documents/products/how-to-prepare-for-a-meeting-with-a-rheumatologist.pdf&quot; target=&quot;_blank&quot;>&lt;b>סובלים מדלקת מפרקים שגרונית? כך תתכוננו לשיחה עם הראומטולוג&lt;/b>&lt;/a>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
