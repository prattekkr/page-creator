                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="המטרה: הפוגה"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h2"
                                variant="h"/>
                            <text_1423662935
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2025-11-17T01:09:49.362-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-11-18T03:49:34.379-05:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>היעד הטיפולי המרכזי כיום בדלקת מפרקים שגרונית הוא להשיג הפוגה ולשמור על דיכוי מירבי של הדלקת, או לכל הפחות להביא לפעילות מחלה נמוכה. מבלי להמעיט בחשיבות אורח חיים בריא, האמצעי החשוב ביותר להגעה להפוגה ושמירה עליה הוא טיפול תרופתי. ״היום הגישה היא ׳טיפול מכוון למטרה׳. לא מבזבזים זמן, אם תוך שלושה חודשים לא הגענו ליעד אופטימלי מבחינת רמיסיה (הפוגה) - עוברים לטיפול הבא״, אומר ד״ר איתן גיאת, ראומטולוג בכיר במרכז הרפואי שיבא בתל השומר.&lt;/p>&#xd;&#xa;&lt;p>״קיימות כמה שיטות לדרג את פעילות המחלה ולהגדיר הפוגה באמצעות מדדים שונים של חומרת המחלה. אלו כוללים את מספר המפרקים הרגישים והנפוחים, מדד CRP לדלקתיות, הערכה של הרופא והערכה של המטופל. באופן כללי, כשלמטופל יש עד מפרק אחד שמושפע והוא מרגיש סך הכל טוב - אפשר להגיד שמדובר בהפוגה״, מסביר ד״ר גיאת. לדבריו הפוגה יכולה להימשך שנים: ״יש מטופלים שמרגישים מצוין כבר 15-20 שנה״.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <text_1841366700_copy_1194142355
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2025-11-17T00:55:57.185-05:00"
                                jcr:createdBy="singarx"
