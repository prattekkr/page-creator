                            <text_398730945
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2025-11-14T23:54:51.490-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2026-01-01T04:29:15.466-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p style=&quot;text-align: center;&quot;>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-26-reg&quot;>שוחחנו עם יו״ר האיגוד הישראלי לראומטולוגיה, פרופ' מרב לידר כדי לבחון מיתוסים על דלקת מפרקים שגרונית (RA). האם זו מחלה של מבוגרים בלבד? מי שחולה צריך להפסיק להתאמן? ובאיזה אופן חום וקור משפיעים על הדלקת? עשינו סדר&lt;br />&#xd;&#xa; &lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_879022297_
                                cq:styleIds="[1662756456518]"
                                jcr:created="{Date}2025-11-17T01:09:04.441-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-12-28T04:17:52.093-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <text_1841366700
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2025-11-17T00:55:57.185-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-11-18T05:13:20.110-05:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>דלקת מפרקים שגרונית (RA) היא מחלה כרונית שמשפיעה על הגוף בדרכים מגוונות שחלקן יכולות להיות מזוהות עם מצבים רפואיים אחרים. לכן, אין זה פלא שעם השנים נקשרו בשמה מיתוסים רבים. שוחחנו עם פרופ' מרב לידר, מנהלת היחידה הראומטולוגית במרכז הרפואי שיבא בתל השומר ויו&amp;quot;ר האיגוד הישראלי לראומטולוגיה, כדי להבין אחת ולתמיד מה נכון, מה לא נכון, ואיך אפשר לחיות טוב יותר לצד המחלה.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <text_1841366700_copy
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2025-11-17T00:55:57.185-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2026-02-22T04:34:02.784-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;a href=&quot;/content/dam/abbvie-com2/il/documents/products/how-to-prepare-for-a-meeting-with-a-rheumatologist.pdf&quot; target=&quot;_blank&quot;>&lt;b>סובלים מדלקת מפרקים שגרונית? כך תתכוננו לשיחה עם הראומטולוג&lt;/b>&lt;/a>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_879022297__786109416
                                cq:styleIds="[1662756456518]"
                                jcr:created="{Date}2025-11-17T01:09:04.441-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-12-28T04:17:52.093-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <text_1900808612
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2025-11-17T00:56:55.506-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-12-28T04:55:21.095-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;b>1.&lt;/b>&amp;nbsp;&lt;b>דלקת מפרקים שגרונית היא מחלה של מבוגרים&lt;br>&#xd;&#xa; &lt;/b>לא נכון. RA יכולה להופיע בכל גיל.&lt;br>&#xd;&#xa;הגיל הממוצע בעולם להתפרצות דלקת מפרקים שגרונית הוא 44, והיא יכולה להתפרץ בכל גיל - מהילדות, דרך הבגרות הצעירה ועד לגיל העמידה. עם זאת, לדלקת מפרקים אצל אדם מבוגר יהיו בדרך כלל מאפיינים שונים בהשוואה ל-RA אצל ילדים.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_879022297__1167103156
                                cq:styleIds="[1662756456518]"
                                jcr:created="{Date}2025-11-17T01:09:04.441-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-12-28T04:17:52.093-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <text_1423662935
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2025-11-17T01:09:49.362-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-12-28T04:56:36.165-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;b>2&lt;/b>.&amp;nbsp;&lt;b>דלקת מפרקים שגרונית נגרמת בשל עומס יתר על המפרקים&lt;br>&#xd;&#xa;&lt;/b>לא נכון. RA היא מחלה אוטואימונית שאינה נגרמת משחיקה או מעומס.&lt;br>&#xd;&#xa;אין הוכחה שהתפרצות של RA קשורה לעומס יתר על המפרקים. הגורמים למחלה הם ככל הנראה רקע גנטי בשילוב טריגרים סביבתיים שמשפעלים את מערכת החיסון, כמו למשל זיהומים או חיסונים. גם עומס נפשי יכול להחמיר את המצב, אבל לרוב הוא לא יהווה גורם מרכזי להתפתחות הדלקת. גורמים ידועים נוספים שמעלים את הסיכון להתפרצות המחלה הם עישון, עודף משקל ושינויים הורמונליים.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_879022297__1179984450
                                cq:styleIds="[1662756456518]"
                                jcr:created="{Date}2025-11-17T01:09:04.441-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-12-28T04:17:52.093-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <text
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2025-11-17T03:13:33.287-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-12-28T04:56:51.489-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;b>3&lt;/b>.&amp;nbsp;&lt;b>לא ניתן לשלוט במחלה וצריך ללמוד לחיות עם התסמינים&lt;br>&#xd;&#xa;&lt;/b>לא מדויק. RA היא אמנם מחלה כרונית, אבל ניתן לנהל אותה, להגיע להטבה משמעותית ולמנוע היווצרות של נזקים בלתי הפיכים למפרקים.&lt;br>&#xd;&#xa;אף ש-RA היא מחלה כרונית, ברוב המקרים אפשר בהחלט להגיע להטבה ניכרת ולהפוגות ארוכות, תוך צמצום נזק מצטבר למפרקים. פשוט צריך למצוא את הטיפול המתאים ואחרי שמוצאים אותו – להישאר במעקב. כי גם אם מרגישים טוב, יתכנו מצבים כמו דלקת סמויה או תופעות לוואי שונות. חשוב גם לזכור שאם טיפול תרופתי מסויים לא מצליח, קיימות היום הרבה חלופות, כך שכמעט לכל מטופל ניתן להתאים טיפול שישמור על הדלקת בשליטה. דלקת פעילה שעמידה לכל הטיפולים היא דבר נדיר - אחוז האנשים שלא מגיבים לאף מנגנון תרופתי עומד על 2.7% בלבד.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_879022297__592528808
                                cq:styleIds="[1662756456518]"
                                jcr:created="{Date}2025-11-17T01:09:04.441-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-12-28T04:17:52.093-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <text_copy
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2025-11-17T03:13:33.287-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-12-28T04:57:11.672-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;b>4. לא כדאי להתחיל את הטיפול מוקדם מדי&lt;br>&#xd;&#xa;&lt;/b>ההיפך הוא הנכון. טיפול מוקדם יכול למנוע נזקים בלתי הפיכים ואפילו לעצור את התפתחות המחלה.&lt;br>&#xd;&#xa;ברגע שהאבחנה הרפואית מבוססת לא כדאי להימנע מטיפול. הצטברות הנזק למפרק מתרחשת בשנים הראשונות של המחלה ולכן טיפול מוקדם יכול למנוע נזק בלתי הפיך ופגיעה בתפקוד.&amp;nbsp;בנוסף, קל יותר להשתלט על RA כאשר היא נמצאת בראשיתה ובשלבים המוקדמים קיים סיכוי גבוה יותר להשיג תגובה טובה לטיפול.&amp;nbsp;מחלה פעילה עלולה גם לגרום לכאב, לצמצום הפעילות החברתית והמקצועית ולנזקים שהם מעבר לנזק הפיזי למפרק עצמו. בהחלט עדיף לקבל טיפול, לשים את המחלה בצד ולהמשיך בשגרת החיים.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <text_1841366700_copy_1434353173
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2025-11-17T00:55:57.185-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2026-02-22T04:34:13.852-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;a href=&quot;/content/dam/abbvie-com2/il/documents/products/how-to-prepare-for-a-meeting-with-a-rheumatologist.pdf&quot; target=&quot;_blank&quot;>&lt;b>סובלים מדלקת מפרקים שגרונית? כך תתכוננו לשיחה עם הראומטולוג&lt;/b>&lt;/a>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_879022297__706755143
                                cq:styleIds="[1662756456518]"
                                jcr:created="{Date}2025-11-17T01:09:04.441-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-12-28T04:17:52.093-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <text_copy_copy
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2025-11-17T03:13:33.287-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-12-28T04:57:32.666-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;b>5.&amp;nbsp;דלקת מפרקים שגרונית פוגעת רק במפרקים&lt;br>&#xd;&#xa;&lt;/b>לא נכון. המחלה יכולה להשפיע גם על איברים נוספים כגון עיניים, כלי דם וריאות.&lt;br>&#xd;&#xa;RA היא מחלה רב-מערכתית. אף שהמפרקים הם האיבר שנפגע בשכיחות הגבוהה ביותר, אצל כרבע מהחולים בדלקת מפרקים שגרונית יכולה להיות גם מחלה דלקתית של הריאות, אשר מוחמרת מאוד בקרב מעשנים. חולי RA נמצאים בסיכון לחלות במחלות לב וכלי דם ובעלי נטייה מוגברת להתקפי לב ולטרשת העורקים. עם זאת, כאשר המחלה מאוזנת - הסיכון פוחת. אם מתפתחת מחלה רב-מערכתית, הראומטולוג יתכלל את הטיפול בכל המערכות.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
