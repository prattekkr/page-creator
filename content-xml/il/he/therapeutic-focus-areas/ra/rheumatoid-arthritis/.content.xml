                                jcr:lastModified="{Date}2026-01-01T04:39:44.531-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p style=&quot;text-align: center;&quot;>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-26-reg&quot;>דלקת מפרקים שגרונית (Rheumatoid Arthritis, RA) היא מחלת מפרקים כרונית ואוטואימונית, שבה מערכת החיסון תוקפת את רקמות הגוף, בעיקר את המפרקים. התוצאה היא דלקת מתמשכת שגורמת לכאבים, נפיחות, נוקשות ולעיתים לנזק בלתי הפיך. עם זאת, בעזרת אבחון מוקדם וטיפול מותאם אישית, ניתן לנהל את המחלה בצורה מיטבית ולשפר את איכות החיים.&lt;br />&#xd;&#xa; &lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_879022297__1393408684
                                cq:styleIds="[1662756456518]"
                                jcr:created="{Date}2025-11-17T01:09:04.441-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-12-28T04:17:52.093-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <title_155422277
                                cq:styleIds="[1659545825678,1651545825694]"
                                jcr:created="{Date}2025-11-17T00:55:22.985-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2026-01-01T04:39:52.591-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="מהי דלקת מפרקים שגרונית?"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h2"
                                variant="h"/>
                            <text_1841366700
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2025-11-17T00:55:57.185-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-12-28T04:17:10.502-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>RA היא מחלה שמתבטאת בפגיעה סימטרית במפרקים (למשל, שתי הידיים או שתי הברכיים) ובתסמינים כמו:&lt;/p>&#xd;&#xa;&lt;ul>&#xd;&#xa;&lt;li>&lt;b>כאבים מתמשכים&lt;/b> שמחמירים בבוקר או אחרי מנוחה.&lt;/li>&#xd;&#xa;&lt;li>&lt;b>נוקשות בוקר&lt;/b> שנמשכת שעות.&lt;/li>&#xd;&#xa;&lt;li>&lt;b>נפיחות ואדמומיות &lt;/b>במפרקים.&lt;/li>&#xd;&#xa;&lt;li>&lt;b>תחושת עייפות כללית&lt;/b> וירידה בתפקוד היומיומי.&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;&lt;p>בנוסף למפרקים, RA יכולה להשפיע גם על מערכות אחרות בגוף, כמו הלב, הריאות והעיניים.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <text_1841366700_copy
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2025-11-17T00:55:57.185-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2026-02-22T04:35:09.777-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;a href=&quot;/content/dam/abbvie-com2/il/documents/products/how-to-prepare-for-a-meeting-with-a-rheumatologist.pdf&quot; target=&quot;_blank&quot;>&lt;b>סובלים מדלקת מפרקים שגרונית? כך תתכוננו לשיחה עם הראומטולוג&lt;/b>&lt;/a>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_879022297
                                cq:styleIds="[1662756456518]"
                                jcr:created="{Date}2025-11-17T01:09:04.441-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-12-28T04:17:52.093-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <title_1404561168
                                cq:styleIds="[1659545825678,1651545825694]"
                                jcr:created="{Date}2025-11-17T01:09:09.692-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2026-01-01T04:39:58.039-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="מדוע חשוב לאבחן מוקדם?"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h2"
                                variant="h"/>
                            <text_1423662935
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2025-11-17T01:09:49.362-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-12-28T04:16:27.394-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&amp;nbsp;RA יכולה להתקדם במהירות, וללא טיפול עלולה לגרום לנזק בלתי הפיך למפרקים ולפגיעה תפקודית משמעותית. אבחון מוקדם (באמצעות בדיקות דם, דימות ותשאול קליני) מאפשר להתחיל טיפול מוקדם שמטרתו:&lt;/p>&#xd;&#xa;&lt;ul>&#xd;&#xa;&lt;li>&lt;b>שליטה בדלקת&lt;/b>&lt;/li>&#xd;&#xa;&lt;li>&lt;b>מניעת נזק עתידי&lt;/b>&lt;/li>&#xd;&#xa;&lt;li>&lt;b>שיפור איכות החיים&lt;/b>&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_879022297_
                                cq:styleIds="[1662756456518]"
                                jcr:created="{Date}2025-11-17T01:09:04.441-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-12-28T04:17:52.093-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <title_79602002
                                cq:styleIds="[1659545825678,1651545825694]"
                                jcr:created="{Date}2025-11-17T03:12:53.492-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2026-01-01T04:40:05.530-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="מהן אפשרויות הטיפול המתקדמות כיום?"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h2"
                                variant="h"/>
                            <text
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2025-11-17T03:13:33.287-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-12-28T04:23:34.380-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>בשנים האחרונות חלה התקדמות משמעותית בטיפול ב-RA. הטיפולים כוללים:&lt;/p>&#xd;&#xa;&lt;ol>&#xd;&#xa;&lt;li>&lt;b>משככי כאבים וסטרואידים&amp;nbsp;&lt;/b>להקלה מיידית וקצרת טווח.&lt;/li>&#xd;&#xa;&lt;li>&lt;b>DMARDs&amp;nbsp;&lt;/b>- תרופות המאטות את התקדמות המחלה ומונעות נזק למפרקים.&lt;/li>&#xd;&#xa;&lt;li>&lt;b>טיפולים ביולוגיים וטיפולים מתקדמים&lt;/b>&amp;nbsp;- פועלים על מערכת החיסון, עם אפשרויות מתן כמו כדורים, זריקות או עירויים.&lt;/li>&#xd;&#xa;&lt;/ol>&#xd;&#xa;&lt;p>בנוסף, טיפול ב-RA כולל גם פיזיותרפיה, שינויים תזונתיים והפסקת עישון.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_879022297__2019718887
                                cq:styleIds="[1662756456518]"
                                jcr:created="{Date}2025-11-17T01:09:04.441-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-12-28T04:17:52.093-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <title_393085719
                                cq:styleIds="[1659545825678,1651545825694]"
                                jcr:created="{Date}2025-11-17T03:14:08.506-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2026-01-01T04:40:14.483-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="מה חשוב לזכור?"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h2"
                                variant="h"/>
                            <text_copy
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2025-11-17T03:13:33.287-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-12-28T04:19:53.818-05:00"
                                jcr:lastModifiedBy="levhx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>RA היא מחלה שאפשר לנהל. המפתח הוא העלאת מודעות, אבחון מוקדם ובחירת טיפול מותאם. אם הטיפול הנוכחי אינו יעיל מספיק, חשוב לשקול חלופות – כיום קיים מגוון רחב של אפשרויות.&lt;/p>&#xd;&#xa;&lt;p>אל תוותרו על איכות החיים שלכם – היו מעורבים בטיפול, שאלו את הרופא על טיפולים מתקדמים והתייעצו על דרכים לשפר את התפקוד היומיומי.&lt;br>&#xd;&#xa;&lt;/p>&#xd;&#xa;&lt;p>&lt;b>היום חולים בדלקת מפרקים יכולים לחיות באיכות חיים טובה. אז קחו שליטה לידיים שלכם, ותוכלו לשפר את חייכם!&lt;/b>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
