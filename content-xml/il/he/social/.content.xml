                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p style=&quot;text-align: right;&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>בתוקף מתאריך: 6 בנובמבר 2018&lt;br>&#xd;&#xa; עדכון אחרון: 2 בינואר 2024&lt;/span>&lt;/p>&#xd;&#xa;"
