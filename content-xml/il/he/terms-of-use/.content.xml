                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p style=&quot;text-align: right;&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>בתוקף מתאריך: 1 באפריל 2017&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <container_944523654
                                cq:styleIds="[1653545835982]"
                                jcr:created="{Date}2022-12-22T17:02:52.196-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2025-01-13T02:30:38.083-05:00"
