                                <title_copy_copy_650582681
                                    cq:styleIds="[1659545825678,1661545829678,1651243825678]"
                                    jcr:created="{Date}2022-12-22T17:03:21.680-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2024-09-24T10:34:17.487-04:00"
                                    jcr:lastModifiedBy="jewitca"
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="קניין רוחני"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h4"
                                    variant="h"/>
                                <text_171059647_copy_906208759
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2022-12-22T17:05:41.466-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2025-01-13T02:27:49.309-05:00"
                                    jcr:lastModifiedBy="gabayyx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p style=&quot;text-align: right;&quot;>המידע, התוכן והגרפיקה שנמצאים באתר (“המידע”) הינן בבעלות, או ברישיון, AbbVie. רשות להשתמש במידע ניתנת בכף לכל התנאים הבאים: (i) הכרת זכויות היוצרים שלעיל מופיעה בכל העותקים; (ii) שימוש במידע הינו למטרות שאינן מסחריות או לשימוש אישי בלבד; (iii) המידע לא שונה בכל דרך; וכן (iv) אין שימוש בגרפיקה שנלקחה מהאתר משמש בנפרד מהטקסט הנלווה. לכל השימושים האחרים של המידע או כל סימן מסחרי, שמות מסחריים וכדומה נדרש אישור מראש ובכתב של חברת AbbVie.&lt;br />&#xd;&#xa;AbbVie אינה אחראית לתוכן המסופק על ידי ספקי צד שלישי, ונאסר עליך להפיץ חומר כזה ללא רשותו של בעל זכות היוצרים.&lt;br />&#xd;&#xa;למעט כפי שהותר לעיל, אין רישיון או זכות, במפורש או במשתמע, מוענקים לכל אדם על פי כל פטנט, סימן מסחר או זכות קניינית אחרת של AbbVie.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <separator_copy_copy_1295598495
                                    cq:styleIds="[1662756456518]"
                                    jcr:created="{Date}2022-12-22T17:03:44.000-05:00"
