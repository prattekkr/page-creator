                                    type="h4"
                                    variant="h"/>
                                <text_171059647_copy
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2022-12-22T17:05:41.466-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2024-09-24T10:32:35.407-04:00"
                                    jcr:lastModifiedBy="jewitca"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p style=&quot;text-align: right;&quot;>חברת AbbVie תעשה מאמצים סבירים כדי להפוך את אתר AbbVie זמין 24 שעות ביממה, 7 ימים בשבוע. עם זאת, אנחנו לא יכולים להבטיח זאת ואין אנו אחראים לכל אובדן או נזק שייגרם כתוצאה מהפרעה לגישה לאתר.&lt;br>&#xd;&#xa;חברת AbbVie עלולה להפסיק את פעילות אתר AbbVie מסיבות תחזוקה ותשתדל לספק הודעה סבירה מראש לגבי תחזוקה מתוכננת.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <separator_copy_copy_920539570
                                    cq:styleIds="[1662756456518]"
                                    jcr:created="{Date}2022-12-22T17:03:44.000-05:00"
