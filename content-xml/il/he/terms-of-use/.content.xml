                                    type="h4"
                                    variant="h"/>
                                <text_171059647
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2022-12-22T17:05:41.466-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2024-09-24T10:31:57.777-04:00"
                                    jcr:lastModifiedBy="jewitca"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p style=&quot;text-align: right;&quot;>בשימוש באתר AbbVie, אתה מסכים לתנאים הבאים:&lt;br>&#xd;&#xa;לא לשבש, לתקן או ליירט מידע שהועלה באתר או בכל אחד מהשרתים של AbbVie;&lt;br>&#xd;&#xa;לא לנסות לעקוף כל תכנות אבטחה של אתר של AbbVie; ו-&lt;br>&#xd;&#xa;לציית לכל החוקים, הכללים והתקנות הרלוונטיים, לאומיים ובינלאומיים.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <separator_copy_copy
                                    cq:styleIds="[1662756456518]"
