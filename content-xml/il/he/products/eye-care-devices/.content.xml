                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p style=&quot;text-align: left;&quot;>&lt;span class=&quot;body-unica-18-reg&quot;>The XEN Glaucoma Gel Implant is intended to create a channel through the sclera allowing flow of aqueous humor from the anterior chamber into the subconjunctival space to reduce intraocular pressure (IOP). The XEN Gel Implant is inserted using the XEN Injector via an ab interno approach, through a small corneal incision.&lt;/span>&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
