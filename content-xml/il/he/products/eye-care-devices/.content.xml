                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;table border=&quot;1&quot; cellspacing=&quot;0&quot; cellpadding=&quot;0&quot; width=&quot;100%&quot;>&#xd;&#xa;&lt;tbody>&lt;tr>&lt;td width=&quot;312&quot; valign=&quot;top&quot;>&lt;p style=&quot;text-align: right;&quot;>&lt;b>מרכיב פעיל&lt;/b>&lt;/p>&#xd;&#xa;&lt;/td>&#xd;&#xa;&lt;td width=&quot;492&quot; valign=&quot;top&quot; style=&quot;text-align: right;&quot;>&lt;span class=&quot;body-unica-18-reg&quot;>פוליויניל אלכוהול Polyvinyl alcohol 1.4%&lt;br>&#xd;&#xa; ופובידון Povidone 0.6%&amp;nbsp;&amp;nbsp;&lt;/span>&lt;/td>&#xd;&#xa;&lt;/tr>&lt;tr>&lt;td width=&quot;312&quot; valign=&quot;top&quot;>&lt;p style=&quot;text-align: right;&quot;>&lt;b>צורת מינון&lt;/b>&lt;/p>&#xd;&#xa;&lt;/td>&#xd;&#xa;&lt;td width=&quot;492&quot; valign=&quot;top&quot;>&lt;p style=&quot;text-align: right;&quot;>&lt;span class=&quot;body-unica-18-reg&quot;>טיפות עיניים&lt;/span>&lt;/p>&#xd;&#xa;&lt;/td>&#xd;&#xa;&lt;/tr>&lt;tr>&lt;td width=&quot;312&quot; valign=&quot;top&quot;>&lt;p style=&quot;text-align: right;&quot;>&lt;b>&amp;nbsp;התוויה רפואית&lt;/b>&lt;/p>&#xd;&#xa;&lt;/td>&#xd;&#xa;&lt;td width=&quot;492&quot; valign=&quot;top&quot;>&lt;h3 style=&quot;text-align: right;&quot;>&lt;span class=&quot;body-unica-18-reg&quot;>מיועד לסכך את פני שטח העין(ים) ולהעניק להם לחות, ומיועד להקלה זמנית של יובש, גירוי, צריבה, אי נוחות ו/או כל תסמין אחר הנגרם על ידי מחלת העין היבשה או גורמים סביבתיים&lt;/span>&lt;/h3>&#xd;&#xa;&lt;/td>&#xd;&#xa;&lt;/tr>&lt;tr>&lt;td width=&quot;132&quot; valign=&quot;top&quot;>&lt;p style=&quot;text-align: right;&quot;>&lt;b>הוראות שימוש&lt;/b>&lt;/p>&#xd;&#xa;&lt;/td>&#xd;&#xa;&lt;td>&lt;p style=&quot;text-align: right;&quot;>&lt;a href=&quot;/content/dam/abbvie-com2/il/documents/products/20076263-leaflet-refresh.pdf&quot; target=&quot;_blank&quot;>&lt;span class=&quot;body-unica-18-reg&quot;>למידע נוסף- לחץ כאן&lt;/span>&lt;/a>&lt;/p>&#xd;&#xa;&lt;/td>&#xd;&#xa;&lt;/tr>&lt;/tbody>&lt;/table>&#xd;&#xa;"
