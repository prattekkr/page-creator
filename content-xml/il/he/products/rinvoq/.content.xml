                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p style=&quot;direction: rtl;&quot;>&lt;span class=&quot;body-unica-20-reg&quot;>&lt;span class=&quot;body-unica-26-reg&quot;>רינבוק הינה תרופה לטיפול בדלקת מפרקים שיגרונית (RA), דלקת מפרקים ספחתית (PsA), דלקת חוליות מקשחת (AS),&amp;nbsp;ספונדילוארתריטיס אקסיאלית ללא עדויות רדיוגרפיות (nr-axSpA),&amp;nbsp;דלקת עור אטופית (AD), קוליטיס כיבית (UC), מחלת קרוהן (CD),&amp;nbsp;דלקת מפרקים ספחתית של גיל הילדות (JPsA),&amp;nbsp;דלקת מפרקים אידיופאטית פוליארטיקולרית של גיל הילדות (pJIA),&amp;nbsp;דלקת עורקית של הרקה&amp;nbsp;(GCA).&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                        </container3>
