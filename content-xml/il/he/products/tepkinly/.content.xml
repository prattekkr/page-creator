                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;body-unica-26-reg&quot;>טפקינלי הינה תרופה נגד מחלת הסרטן המכילה את החומר הפעיל אפקוריטמאב (Epcoritamab), אשר תוכנן במיוחד כדי לסייע למערכת החיסון לתקוף תאי סרטן (לימפומה). אפקוריטמאב פועל על-ידי היצמדות לתאי מערכת החיסון ולתאי הסרטן בגופך, מקרב אותם אחד לשני, כך שמערכת החיסון יכולה להרוס את התאים הסרטניים.&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
