                            <text_copy_copy_14035
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2022-11-16T17:01:41.718-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2025-02-10T04:46:24.450-05:00"
                                jcr:lastModifiedBy="gabayyx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p style=&quot;text-align: right;&quot;>״יש הבנה כיום, שמילוי ועיצוב שפתיים הוא חלק מתפיסה הוליסטית״, אומרת ד״ר אגוזי. ״כיום פחות נשים מגיעות ומבקשות ׳לנפח׳ את השפתיים בלי פרופורציות. חשוב להבין מה הרצונות של המטופלת והאם זה עולה בקנה אחד עם הצרכים שלה כולל מבנה הפנים והשפתיים בכדי להשיג תוצאה יפה וטבעית.&lt;/p>&#xa;&lt;p style=&quot;text-align: right;&quot;>במהלך האבחון, חשוב לנו לראות את התמונה המלאה ולהחליט על מספר הטיפולים, סוג החומר המוזרק, מינון החומר המוזרק וטכניקת ההזרקה. לדוגמא האם להשתמש במחט להזרקת חומצה היאלורונית באופן נקודתי וממוקד או בקנולה, צינורית זעירה, באמצעותה ההזרקה יוצאת אחידה ללא פגיעה בכלי הדם.&amp;quot;&lt;/p>&#xa;"
                                textIsRich="true"/>
                            <title_copy_433284079_925968542
                                cq:styleIds="[1659545825678,1651545825678,1651243825678,1651545825694]"
                                jcr:created="{Date}2022-11-30T02:11:17.530-05:00"
                                jcr:createdBy="kumarvx60"
                                jcr:lastModified="{Date}2025-02-10T04:46:37.278-05:00"
                                jcr:lastModifiedBy="gabayyx"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="טיפולים מומלצים לפי מבנה השפתיים "
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h2"
                                variant="h"/>
                            <text_copy_copy_25677
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2022-11-16T17:01:41.718-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2025-02-10T04:47:30.612-05:00"
                                jcr:lastModifiedBy="gabayyx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p style=&quot;text-align: right;&quot;>&lt;span class=&quot;body-unica-26-reg&quot;>&lt;b>שפתיים דקות (THIN LIPS)- שפה עליונה ותחתונה דקות&amp;nbsp;&lt;/b>&lt;/span>&lt;/p>&#xa;&lt;p style=&quot;text-align: right;&quot;>״בדומה ליחס הזהב הבינלאומי בפנים, ישנן גם פרופורציות מקובלות בשפתיים. אסתטית, הפרופורציה המועדפת היא בערך 1 ל-1.6, ביחס בין השפתיים, שפה עליונה לעומת השפה התחתונה, שהיא העבה יותר. לאחרונה, נכנס הטרנד של יחס שווה 1:1 בין השפה העליונה והתחתונה. מה שפחות מקובל אסתטית הוא שפה עליונה עבה יותר מהתחתונה. לרוב, מי שמגיעות לעבות שפתיים הן בעיקר נשים צעירות בעלות שפתיים דקות&amp;quot;.&lt;/p>&#xa;&lt;p style=&quot;text-align: right;&quot;>״בדרך כלל, הטיפול אורך שני מפגשים בהפרש של עד חודש ביניהם, מאחר שיש צורך להשיג את הנפח המבוקש באופן הדרגתי. לא רצוי למלא בכמות גדולה של חומצה היאלורונית ולהגדיל משמעותית את נפח השפתיים במפגש אחד, כי במקרה כזה החומר עלול לנפח את העור שמעל השפה העליונה והתוצאה לא טובה. במיוחד בשפתיים דקות, מומלץ להשתמש בכמות קטנה של חומצה היאלורונית, כאשר בכל טיפול מרחיבים מעט את השפתיים, מעניקים נפח באופן הדרגתי ומתון ומקבלים תוצאה אופטימלית״.&lt;/p>&#xa;"
                                textIsRich="true"/>
