                                        jcr:lastModified="{Date}2025-02-11T05:01:52.930-05:00"
                                        jcr:lastModifiedBy="gabayyx"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="abbvie-com2/components/text/v2/text"
                                        text="&lt;p style=&quot;text-align: right;&quot;>&lt;span class=&quot;body-unica-26-reg&quot;>&lt;b>שפתיים מלאות עם קמטוטים (FULL LIPS)&lt;/b>&lt;/span>&lt;/p>&#xa;&lt;p style=&quot;text-align: right;&quot;>״ישנן נשים אשר לא מעוניינות לעבות את השפתיים, אלא ליישר קמטוטים ולגרום לשפתיים להיראות משורטטות ומוגדרות יותר. בנוסף, עם הגיל, יש צניחה של זוויות הפה, והשפתיים מקבלות מראה ׳עצוב׳. לעתים, יש אובדן של הגדרת קשת הקופידון במרכז השפתיים והדבר תורם למראה נפול״.&lt;/p>&#xa;&lt;p style=&quot;text-align: right;&quot;>&lt;b>הטיפול המומלץ: &lt;/b>במקרה של טיפול בזוויות הפה הנפולות ובקמטים ויובש בשפתיים עצמן ומעל השפתיים, מומלץ להשתמש בחומצה היאלורונית בסמיכות עדינה בשם Juvéderm® VOLBELLA , אשר נועדה להחליק קמטוטים, לשרטט את קווי המתאר (קונטור) ולשוות לשפתיים מראה צעיר, בלי שינויים משמעותיים בנפח או בעובי השפה״. מי שמעוניינת בכמות קטנה ישנה חומצה היאלורונית Juvéderm® ULTRA 2, גם היא בסמיכות עדינה ומשווקת בכמות מופחתת מהכמות במזרק רגיל.&amp;quot;&lt;/p>&#xa;"
                                        textIsRich="true"/>
                                </par_31>
                                <par_32
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="wcm/foundation/components/parsys">
