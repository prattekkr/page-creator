                                    <text_copy_1261287400
                                        cq:styleIds="[1659545825678]"
                                        jcr:created="{Date}2022-11-23T16:46:55.248-05:00"
                                        jcr:createdBy="chiucx"
                                        jcr:lastModified="{Date}2025-02-10T04:57:02.552-05:00"
                                        jcr:lastModifiedBy="gabayyx"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="abbvie-com2/components/text/v2/text"
                                        text="&lt;p style=&quot;text-align: right;&quot;>&lt;b>הטיפול המומלץ:&lt;/b> ״החומרים המתאימים למטרת עיבוי שפתיים דקות הם חומרים בסמיכות בינונית במזרקים קטנים של 0.55 מ&amp;quot;ל במקום 1 מ&amp;quot;ל כדוגמת – Juvéderm® VOLIFT RETOUCH או Juvéderm® ULTRA SMILE, חומצות היאלורוניות איכותיות.&amp;quot;&lt;/p>&#xd;&#xa;&lt;p style=&quot;text-align: right;&quot;>&lt;b>מדוע זה יתרון בשפתיים דקות?&lt;/b>&lt;/p>&#xd;&#xa;&lt;p style=&quot;text-align: right;&quot;>&amp;quot;כאשר אנחנו משתמשים במזרק קטן יותר ניתן להשתמש בכל החומר במפגש הטיפולי ואין צורך בשמירה של מזרק פתוח בקירור. כתוצאה מכך אנו שומרים על רמת היגיינה גבוהה ובנוסף עבור המטופלת קיים חיסכון כספי משמעותי.&amp;quot;&lt;/p>&#xd;&#xa;"
                                        textIsRich="true"/>
                                </par_11>
                                <par_21
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="wcm/foundation/components/parsys">
                                    <text_copy_copy_25677
                                        cq:styleIds="[1659545825678]"
                                        jcr:created="{Date}2022-11-16T17:01:41.718-05:00"
                                        jcr:createdBy="chiucx"
                                        jcr:lastModified="{Date}2025-02-11T04:57:23.554-05:00"
                                        jcr:lastModifiedBy="gabayyx"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="abbvie-com2/components/text/v2/text"
                                        text="&lt;p style=&quot;text-align: right;&quot;>&lt;span class=&quot;body-unica-26-reg&quot;>&lt;b>שפה עליונה דקה ושפה תחתונה עבה (HEAVY LOWER LIPS)&amp;nbsp;&lt;/b>&lt;/span>&lt;/p>&#xa;&lt;p style=&quot;text-align: right;&quot;>כדי להגיע לפרופורציה הנכונה, נטפל באופן הדרגתי באמצעות מזרקים קטנים (0.55 מ&amp;quot;ל) בשפה העליונה באותן שיטות בהם טיפלנו בשפתיים הדקות.&lt;/p>&#xa;"
                                        textIsRich="true"/>
                                </par_21>
