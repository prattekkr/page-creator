                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p style=&quot;text-align: center;&quot;>&lt;b>&lt;span class=&quot;body-unica-32-reg&quot;>מהי החומצה ההיאלורונית המתאימה ביותר למבנה השפתיים, לגיל ולמבנה הפנים? מהי שיטת הפפיון ובאילו מקרים עדיף להשתמש במזרק המכיל כמות קטנה יותר של חומצה היאלורונית? ד״ר אלה אגוזי, מומחית לרפואת עור, עם התשובות&lt;/span>&lt;/b>&lt;/p>&#xa;"
                                textIsRich="true"/>
