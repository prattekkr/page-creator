                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p style=&quot;text-align: center;&quot;>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-26-reg&quot;>דלקת מפרקים שגרונית (RA) היא מחלה אוטואימונית כרונית הגורמת לדלקת במפרקים, כאבים, נוקשות ופגיעה בתפקוד היומיומי. ללא טיפול מתאים, היא עלולה להוביל לנזק בלתי הפיך למפרקים ואף להשפיע על מערכות נוספות בגוף. כאן תמצאו מידע חשוב, סיפורים אישיים וכתבות שיעזרו להבין את המחלה, אפשרויות הטיפול והדרכים לשיפור איכות החיים.&lt;br>&#xd;&#xa; &lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                        </container3>
