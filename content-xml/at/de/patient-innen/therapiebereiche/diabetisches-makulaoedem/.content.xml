                            <text_116650528_copy_
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2026-08-04T04:26:36.123-04:00"
                                jcr:lastModifiedBy="klavimx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                langAttribute="none"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-26-reg&quot;>Das Diabetische Makulaödem (DMÖ) ist eine ernsthafte Folgeerkrankung von Diabetes mellitus und eine der Hauptursachen für Sehbeeinträchtigungen und Erblindung bei Diabetiker:innen.&amp;nbsp;&lt;/span>&lt;br>&#xd;&#xa; &lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <text
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2024-08-06T02:14:27.225-04:00"
                                jcr:lastModifiedBy="HERZOBW"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;i>In Österreich leben etwa 42.000 Menschen mit dem Diabetischen Makulaödem. Regelmäßige Augenuntersuchungen und eine gute Diabetes-Kontrolle sind entscheidend für die Früherkennung und Behandlung. Verschiedene Therapieoptionen stehen zur Verfügung, um die Sehstärke zu erhalten oder zu verbessern.&lt;/i>&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                        </container3>
                        <separator_copy_copy
                            cq:styleIds="[1662756423318]"
                            jcr:created="{Date}2024-06-26T10:30:16.699-04:00"
                            jcr:createdBy="singarx"
                            jcr:lastModified="{Date}2024-06-26T10:30:16.699-04:00"
                            jcr:lastModifiedBy="singarx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                        <container_1401676501
                            cq:styleIds="[1653545825686,1653242825678,1653545835879,1653545835982,1653545835858,1653545847149,1653546847152]"
                            jcr:created="{Date}2024-06-27T07:34:37.584-04:00"
                            jcr:createdBy="singarx"
