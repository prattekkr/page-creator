                                jcr:lastModifiedBy="klavimx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                langAttribute="none"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-26-reg&quot;>Häufig tritt diese Augenentzündung in Begleitung einer anderen Erkrankung auf. Unbehandelt kann die Erkrankung das Auge dauerhaft schädigen. Innovative Therapien helfen, Uveitis in den Griff zu bekommen.&amp;nbsp;&lt;/span>&lt;br>&#xd;&#xa; &lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <text_copy_copy
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2024-05-29T05:11:48.875-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2024-08-27T02:05:26.233-04:00"
                                jcr:lastModifiedBy="HERZOBW"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;i>Uveitis kann Menschen jeden Alters betreffen, am häufigsten jedoch zwischen dem 20. und dem 60. Lebensjahr. Sogar Kinder können daran erkranken, oft in Kombination mit juveniler idiopathischer Arthritis (JIA).&amp;nbsp;&lt;/i>&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                        </container3>
                        <separator_copy_copy
                            cq:styleIds="[1662756423318]"
                            jcr:created="{Date}2024-06-26T10:30:16.699-04:00"
