                                jcr:primaryType="nt:unstructured"
                                jcr:title="Behandlung "
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h2"
                                variant="h"/>
                            <text_copy_52609772
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2024-05-29T05:11:42.584-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2024-08-26T09:12:30.136-04:00"
                                jcr:lastModifiedBy="HERZOBW"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Die Behandlung von Uveitis hängt von der Ursache und Schwere der Entzündung ab. Als Behandlungsoptionen bei nicht-infektiöser Uveitis stehen entzündungshemmende Medikamente, wie z. B. Kortikosteroide oder Immunsuppressiva zur Verfügung. In manchen Fällen kann eine Laserbehandlung oder Opteration notwendig sein.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
