                            sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                        <container_1266097542
                            cq:styleIds="[1653545825686,1653545835982]"
                            jcr:created="{Date}2024-06-26T10:54:44.152-04:00"
                            jcr:createdBy="singarx"
                            jcr:lastModified="{Date}2024-06-26T11:13:54.289-04:00"
                            jcr:lastModifiedBy="singarx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/container/v2/container">
                            <title_copy
                                cq:styleIds="[1659545825678,1651545824678,1651545825678,1651545829678,1651241825678,1651545825693]"
                                jcr:created="{Date}2024-05-29T05:10:32.590-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2024-08-27T02:06:19.733-04:00"
                                jcr:lastModifiedBy="HERZOBW"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="Symptome und Ursachen"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h2"
                                variant="h"/>
                            <text_copy
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2024-05-29T05:11:48.875-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2024-08-27T02:06:11.471-04:00"
                                jcr:lastModifiedBy="HERZOBW"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Uveitis bezeichnet verschiedene Entzündungen des Auges, insbesondere der mittleren Augenhaut (Uvea). Die Entzündung kann auch die Netzhaut oder den Glaskörper beeinträchtigen. Die häufigste Form ist die vordere Uveitis, die die Regenbogenhaut oder den Strahlenkörper betrifft. Es gibt auch mittlere und hintere Uveitis sowie Panuveitis, wenn mehrere Bereiche betroffen sind.&lt;br>&#xd;&#xa;&lt;/p>&#xd;&#xa;&lt;p>Uveitis kann durch verschiedene Faktoren verursacht werden, wie Infektionen oder Verletzungen. Häufig tritt sie in Begleitung anderer chronisch-entzündlicher Erkrankungen auf.&lt;/p>&#xd;&#xa;&lt;p>Die Symptome können je nach Art und Schwere der Entzündung variieren. Einige Formen treten akut auf, während andere einen chronischen Verlauf haben. Zu den häufigsten Anzeichen zählen verschwommenes Sehen, Augenschmerzen, Rötungen und Lichtempfindlichkeit.&amp;nbsp;&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_902356165
                                cq:styleIds="[1662756423318]"
                                jcr:created="{Date}2024-06-26T02:51:38.301-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2024-06-26T02:52:00.108-04:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <title_copy_167965354
                                cq:styleIds="[1659545825678,1651545824678,1651545825678,1651545829678,1651241825678,1651545825693]"
                                jcr:created="{Date}2024-05-29T05:11:36.683-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2024-08-06T02:33:17.984-04:00"
