                                jcr:lastModifiedBy="HERZOBW"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;sup>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-26-reg&quot;>Morbus Crohn ist eine chronisch-entzündliche Darmerkrankung, die den gesamten Verdauungstrakt betreffen kann. Sie gehört zu den sogenannten chronisch-entzündlichen Darmerkrankungen (CED) und verläuft in Schüben.&amp;nbsp;&lt;/span>&lt;br>&#xd;&#xa; &lt;/span>&lt;/sup>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <text_copy_224892904
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2024-08-27T02:08:30.101-04:00"
                                jcr:lastModifiedBy="HERZOBW"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;i>In Österreich leiden rund 80.000 Menschen unter den beiden chronisch-entzündlichen Darmerkrankungen (CED) Morbus Crohn und Colitis ulcerosa. Es gibt derzeit keine Heilung. Jedoch sind die Erkrankungen gut medikamentös behandelbar.&amp;nbsp;&lt;/i>&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                        </container3>
