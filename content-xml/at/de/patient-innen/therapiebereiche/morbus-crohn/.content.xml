                                jcr:created="{Date}2024-12-09T05:42:43.831-05:00"
                                jcr:createdBy="klavimx"
                                jcr:lastModified="{Date}2024-12-09T06:21:20.650-05:00"
                                jcr:lastModifiedBy="klavimx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;body-unica-26-reg&quot;>&lt;b>Morbus Crohn: Tipps für einen #DarmimGlück&lt;/b>&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <text_349468574
                                cq:styleIds="[1659545835858]"
                                jcr:created="{Date}2024-12-09T05:42:43.831-05:00"
                                jcr:createdBy="klavimx"
                                jcr:lastModified="{Date}2024-12-09T05:42:48.058-05:00"
                                jcr:lastModifiedBy="klavimx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Claudia Fuchs ist Leiterin des CED Kompass, einer Initiative der ÖMCCV (Österreichische Morbus Crohn /Colitis ulcerosa Vereinigung). Sie selbst ist von Morbus Crohn betroffen und erzählt in diesem Video wie sie mit der Erkrankung umgeht.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <video
                                cq:styleIds="[1]"
                                jcr:created="{Date}2024-09-24T05:36:19.521-04:00"
                                jcr:createdBy="HERZOBW"
                                jcr:lastModified="{Date}2025-10-27T05:54:07.188-04:00"
                                jcr:lastModifiedBy="klavimx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/video/v2/video"
                                brightcoveAutoPlay="false"
                                brightcovePlaylistAccount="2157889325001"
                                btnText="Jetzt Video anschauen"
                                dmPresetType="imagePreset"
                                fileReference="/content/dam/abbvie-com2/at/images/video/Claudia Fuchs.jpg"
                                imageModifiers="resMode=sharp2&amp;op_sharpen=1"
                                imgAlt="Claudia Fuchs, Leiterin des CED Kompass, erklärt im Video, wie sie mit Morbus Crohn umgeht"
                                loopVideo="false"
                                showBrightcoveControls="false"
                                showPlayerControls="false"
