                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h2"
                                variant="h"/>
                            <text
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2024-08-27T02:09:08.583-04:00"
                                jcr:createdBy="HERZOBW"
                                jcr:lastModified="{Date}2024-08-27T02:09:42.741-04:00"
                                jcr:lastModifiedBy="HERZOBW"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Morbus Crohn ist eine Autoimmunerkrankung, bei der das Immunsystem fälschlicherweise den Verdauungstrakt angreift. Diese Erkrankung kann jeden Teil des Verdauungstrakts von Mund bis Anus erfassen, wobei der Dünndarm und der Dickdarm am häufigsten betroffen sind. Morbus Crohn ist durch wiederkehrende Entzündungsschübe gekennzeichnet, die zu Symptomen wie Bauchschmerzen, Durchfall, Gewichtsverlust und Erschöpfung führen können. Darüber hinaus können Begleiterscheinungen wie Entzündungen der Augen, der Haut, der Leber oder der Gelenke auftreten. Morbus Crohn tritt in den meisten Fällen zwischen dem 15. und 30. Lebensjahr auf.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_copy
                                cq:styleIds="[1662756423318]"
                                jcr:created="{Date}2024-06-27T02:54:36.692-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2024-06-27T02:54:36.692-04:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <title_copy
                                cq:styleIds="[1659545825678,1651545824678,1651545825678,1651545829678,1651241825678,1651545825693]"
                                jcr:created="{Date}2024-05-27T03:05:59.244-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2024-08-06T02:51:42.790-04:00"
                                jcr:lastModifiedBy="HERZOBW"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="Symptome  "
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h2"
                                variant="h"/>
                            <text_copy
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2024-05-27T03:08:22.962-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2024-07-18T06:12:41.940-04:00"
                                jcr:lastModifiedBy="HERZOBW"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;div>&amp;nbsp;&lt;/div>&#xd;&#xa;&lt;div>&lt;span class=&quot;body-unica-20-reg&quot;>Die Symptome von Morbus Crohn können von Person zu Person variieren, aber einige häufige Anzeichen sind:&lt;/span>&lt;/div>&#xd;&#xa;&lt;div>&amp;nbsp;&lt;/div>&#xd;&#xa;&lt;ul>&#xd;&#xa;&lt;li>Bauchschmerzen und Krämpfe: Diese können von mild bis schwer reichen und in der Regel im Unterbauch auftreten.&lt;/li>&#xd;&#xa;&lt;li>Durchfall: Wiederholter wässriger Durchfall ist ein häufiges Symptom.&lt;/li>&#xd;&#xa;&lt;li>Gewichtsverlust: Aufgrund von Nährstoffmangel und Verdauungsproblemen kann es zu ungewolltem Gewichtsverlust kommen.&lt;/li>&#xd;&#xa;&lt;li>Erschöpfung: Morbus Crohn kann zu anhaltender Müdigkeit führen.&lt;br>&#xd;&#xa;&lt;/li>&#xd;&#xa;&lt;li>Blutiger Stuhlgang: Blutungen aus dem Rektum können auftreten.&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;&lt;p>Durch frühzeitige Diagnose können Komplikationen weitgehend vermieden werden:&amp;nbsp;&amp;nbsp;&lt;a href=&quot;https://crohn-colitis-info.at/ced-check/&quot; target=&quot;_blank&quot;>Hier geht‘s zum CED-Check!&lt;/a>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator
                                cq:styleIds="[1662756423318]"
                                jcr:created="{Date}2024-06-27T02:54:36.692-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2024-06-27T02:54:36.692-04:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
