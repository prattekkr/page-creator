                                jcr:lastModifiedBy="HERZOBW"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-26-reg&quot;>Colitis ulcerosa zählt zu den häufigsten chronisch-entzündlichen Darmerkrankungen (CED). Sie ist durch eine Entzündung des Dickdarms geprägt.&amp;nbsp;&lt;/span>&lt;/span>&lt;br>&#xd;&#xa;&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <text_copy_1731865786
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2024-08-27T02:10:39.646-04:00"
                                jcr:lastModifiedBy="HERZOBW"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;i>In Österreich leiden rund 80.000 Menschen unter den beiden chronisch-entzündlichen Darmerkrankungen (CED) Morbus Crohn und Colitis ulcerosa. Es gibt derzeit keine Heilung. Jedoch sind die Erkrankungen gut medikamentös behandelbar.&lt;/i>&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                        </container3>
                        <separator_copy_copy
                            cq:styleIds="[1662756456518]"
                            jcr:created="{Date}2024-05-27T01:56:57.161-04:00"
