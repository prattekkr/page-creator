                                jcr:lastModifiedBy="klavimx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                langAttribute="none"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-26-reg&quot;>Acne inversa, auch als Hidradenitis suppurativa (HS) bezeichnet, ist eine chronisch-entzündliche, jedoch nicht ansteckende Erkrankung. Sie ist nicht heilbar, jedoch lassen sich die Symptome mit einer passenden Therapie unter Kontrolle bringen. Entscheidend ist eine frühe Diagnose.&amp;nbsp;&lt;/span>&lt;br>&#xd;&#xa; &lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <text
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2024-08-06T02:31:04.204-04:00"
                                jcr:lastModifiedBy="HERZOBW"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;i>Bei Acne inversa denken viele an herkömmliche Akne, wie sie in der Pubertät auftreten kann. Doch handelt es sich hier um eine chronisch-entzündliche Hauterkrankung, bei der es zu einer Verstopfung der Haarfollikel und einer überschießenden Reaktion des Immunsystems kommt.&lt;/i>&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                        </container3>
                        <separator
                            cq:styleIds="[1662756423318]"
                            jcr:created="{Date}2024-06-26T04:30:18.708-04:00"
