                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                langAttribute="none"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-26-reg&quot;>Ständiger Juckreiz, endloses Kratzen, schlaflose Nächte: Neurodermitis lässt Betroffene oft ratlos zurück. Als chronisch-entzündliche Hauterkrankung kann Neurodermitis körperlich und emotional sehr belasten.&amp;nbsp;&lt;/span>&lt;br>&#xd;&#xa; &lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <text
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2024-08-26T09:58:32.697-04:00"
                                jcr:lastModifiedBy="HERZOBW"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;i>Etwa 2 bis 5 % der Erwachsenen leben mit Neurodermitis, auch atopische Dermatitis oder atopisches Ekzem genannt.&lt;/i>&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                        </container3>
                        <separator_copy
                            cq:styleIds="[1662756423318]"
                            jcr:created="{Date}2024-06-26T04:30:18.708-04:00"
