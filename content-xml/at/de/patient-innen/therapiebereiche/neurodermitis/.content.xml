                        <container3_copy
                            cq:styleIds="[1653545835982,1653545835879,1653242825678,1653545847150,1653545825686]"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/container/v2/container">
                            <title_copy
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2024-05-27T02:00:44.544-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2024-07-03T10:13:53.114-04:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="Ursachen "
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h4"
                                variant="h"/>
                            <text_copy_1766516542
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2024-05-27T02:01:40.126-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2024-05-27T02:02:13.588-04:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Die Veranlagung zu Neurodermitis kann vererbt werden. Das bedeutet jedoch nicht zwangsläufig den Ausbruch der Erkrankung. Die Ursachen von Neurodermitis sind ein fehlgeleitetes Immunsystem und eine defekte Hautbarriere, die zu der Entzündung führen und den Juck-Kratz-Kreislauf entfachen.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_copy
                                cq:styleIds="[1662756409908]"
                                jcr:created="{Date}2024-06-26T11:48:44.201-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2024-06-26T11:48:44.201-04:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <title_copy_copy
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2024-05-27T02:00:44.544-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2024-08-27T02:14:14.495-04:00"
                                jcr:lastModifiedBy="HERZOBW"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="Symptome"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h4"
                                variant="h"/>
                            <text_copy_copy
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2024-05-27T02:01:40.126-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2024-08-27T02:13:53.014-04:00"
                                jcr:lastModifiedBy="HERZOBW"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Neurodermitis äußert sich vor allem durch trockene, gerötete und entzündete Hautstellen, die an Körper oder Kopfhaut auftreten können, begleitet von einem andauernden Juckreiz. Die Beschwerden treten häufig schubweise auf und können unterschiedlich stark ausgeprägt sein.&lt;/p>&#xd;&#xa;&lt;p>Der oft quälende Juckreiz kann dazu führen, dass sich Betroffene blutig kratzen und unter Schlafmangel leiden. Das führt zu verminderter Konzentrations- und Leistungsfähigkeit. Dazu schämen sich Patient:innen oftmals für ihre sichtbaren Ekzeme und meiden soziale Kontakte. Neurodermitis kann deshalb auch den Alltag der Patient:innen sehr beeinträchtigen.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_copy_copy_
                                cq:styleIds="[1662756456518]"
                                jcr:created="{Date}2024-06-26T11:48:44.201-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2024-06-26T11:48:44.201-04:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                        </container3_copy>
                        <video
                            cq:styleIds="[1]"
                            jcr:created="{Date}2024-09-24T05:44:07.368-04:00"
                            jcr:createdBy="HERZOBW"
                            jcr:lastModified="{Date}2025-10-27T05:55:45.931-04:00"
                            jcr:lastModifiedBy="klavimx"
                            jcr:primaryType="nt:unstructured"
