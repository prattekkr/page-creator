                            <text
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2024-09-17T07:15:28.664-04:00"
                                jcr:lastModifiedBy="HERZOBW"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;sup>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-26-reg&quot;>Die chronisch-lymphatische Leukämie (CLL) ist die häufigste Form von Blutkrebs in den westlichen Industrieländern und gehört zu den Non-Hodgkin-Lymphomen.&amp;nbsp;&lt;/span>&lt;/span>&lt;/sup>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <text_copy
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2024-10-03T03:34:05.638-04:00"
                                jcr:lastModifiedBy="CATEMJX"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;i>Die Patient:innen sind meist im fortgeschrittenen Alter. Männer sind häufiger betroffen. Das Ziel der Therapie ist die Remission, d.h. die Kontrolle der Erkrankung. Auch bei einem Rückfall ist CLL gut behandelbar.&lt;/i>&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                        </container3>
                        <separator_copy
                            cq:styleIds="[1662756423318]"
                            jcr:created="{Date}2024-06-27T03:48:27.868-04:00"
                            jcr:createdBy="singarx"
