                            sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                        <container_1457920257
                            cq:styleIds="[1653545825686,1653545835879,1653545835982,1653242825678,1653546847152,1653545847149]"
                            jcr:created="{Date}2024-06-27T03:46:55.600-04:00"
                            jcr:createdBy="singarx"
                            jcr:lastModified="{Date}2024-06-27T03:47:17.106-04:00"
                            jcr:lastModifiedBy="singarx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/container/v2/container">
                            <title
                                cq:styleIds="[1659545825678,1651545824678,1651545825678,1651545829678,1651241825678,1651545825693]"
                                jcr:created="{Date}2024-05-27T05:51:44.810-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2024-08-06T02:57:25.799-04:00"
                                jcr:lastModifiedBy="HERZOBW"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="Symptome "
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h2"
                                variant="h"/>
                            <text
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2024-05-27T05:52:32.024-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2024-08-26T10:05:27.683-04:00"
                                jcr:lastModifiedBy="HERZOBW"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Die genauen Ursachen von CLL sind noch nicht vollständig verstanden. Es gibt jedoch Risikofaktoren wie Alter und mögliche Exposition gegenüber schädlichen Substanzen wie Asbest oder Pestiziden. Wenn Eltern an CLL erkrankt sind, steigt das Risiko für ihre Kinder, ebenfalls an der Erkrankung zu erkranken. CLL verläuft häufig ohne erkennbare Symptome in den frühen Stadien. Im fortgeschrittenen Stadium kann es zu Müdigkeit, Fieber, Gewichtsverlust und einer erhöhten Blutungsneigung kommen. Die Vergrößerung von Leber, Milz und Lymphknoten ist ebenfalls typisch. CLL wird oft zufällig bei Routineuntersuchungen diagnostiziert. Die genaue Diagnose erfordert jedoch spezialisierte Untersuchungen.&lt;/p>&#xa;"
                                textIsRich="true"/>
                            <separator
                                cq:styleIds="[1662756423318]"
                                jcr:created="{Date}2024-06-27T03:48:27.868-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2024-06-27T03:48:44.547-04:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <title_24363099
                                cq:styleIds="[1659545825678,1651545824678,1651545825678,1651545829678,1651241825678,1651545825693]"
                                jcr:created="{Date}2024-05-27T05:54:05.234-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2024-08-06T02:58:01.748-04:00"
                                jcr:lastModifiedBy="HERZOBW"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="Diagnose "
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h2"
                                variant="h"/>
                            <text_1936581073
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2024-05-27T05:54:46.103-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2024-06-27T03:49:27.753-04:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Für einen genauen Befund werden Patient:innen zu Spezialist:innen, den Hämatolog:innen oder Onkolog:innen, überwiesen. Unter anderem wird dann die Anzahl der weißen Blutkörperchen überprüft. Liegt die Anzahl der B-Lymphozyten dabei bei mehr als 5.000 pro Mikroliter, spricht man offiziell von einer chronisch lymphatischen Leukämie.&amp;nbsp;Neben einem Differentialblutbild und einer körperlichen Untersuchung können auch laborchemische Tests und radiologische Untersuchungen dabei helfen, die Diagnose CLL abzusichern.&lt;br>&#xd;&#xa;&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_copy_copy
                                cq:styleIds="[1662756423318]"
                                jcr:created="{Date}2024-06-27T03:48:27.868-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2024-06-27T03:48:44.547-04:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <title_861941716
                                cq:styleIds="[1659545825678,1651545825678,1651545829678,1651241825678,1651545825693]"
                                jcr:created="{Date}2024-05-27T05:56:38.156-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2024-08-06T02:57:55.534-04:00"
                                jcr:lastModifiedBy="HERZOBW"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="Behandlung "
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h2"
                                variant="h"/>
                            <text_2007272794
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2024-05-27T05:57:37.119-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2024-05-27T05:58:21.409-04:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Die Behandlung von CLL hängt von Faktoren wie dem Krankheitsstadium, dem Alter und dem Gesundheitszustand der Patient:innen ab. Zu Beginn der Erkrankung ist oft noch gar keine Behandlung notwendig, sondern nur ein engmaschiges Monitoring, das sogenannte „Watch and wait“. Ist der Therapiebeginn erforderlich, stehen unterschiedliche Möglichkeiten zur Verfügung. Moderne Therapieoptionen, darunter Chemotherapie und zielgerichtete Therapien, ermöglichen es, die Erkrankung zu kontrollieren und das Fortschreiten zu verlangsamen.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_1831301950
                                cq:styleIds="[1662756423318]"
                                jcr:created="{Date}2024-06-27T03:51:26.319-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2024-06-27T03:51:26.319-04:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <title_1228845080
                                cq:styleIds="[1659545825678,1651545824678,1651545825678,1651545829678,1651241825678,1651545825693]"
                                jcr:created="{Date}2024-05-27T05:58:40.623-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2024-08-06T02:58:13.459-04:00"
                                jcr:lastModifiedBy="HERZOBW"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="Leben mit CLL"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h2"
                                variant="h"/>
                            <text_1851466010
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2024-05-27T05:59:17.198-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2024-09-17T07:13:14.231-04:00"
                                jcr:lastModifiedBy="HERZOBW"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>CLL ist oft eine langsam fortschreitende Krankheit, und viele Patient:innen führen ein weitgehend normales Leben, ohne dass eine Behandlung notwendig ist. Regelmäßige ärztliche Kontrollen und Betreuung sind jedoch unerlässlich, damit der allfällige Therapiebeginn zeitgerecht erfolgt. Darüber, wie ein gutes Leben mit CLL gelingen kann, informiert der Selpers-Kurs „Gutes Leben mit CLL“&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <button
                                cq:styleIds="[1659997740832,1659997787460]"
