                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/container/v2/container">
                            <title_copy
                                cq:styleIds="[1659545825678,1651545824678,1651545825678,1651545829678,1651241825678,1651545825693]"
                                jcr:created="{Date}2024-05-27T02:50:15.330-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2024-08-06T02:49:08.296-04:00"
                                jcr:lastModifiedBy="HERZOBW"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="Symptome und Diagnose  "
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h2"
                                variant="h"/>
                            <text_116650528
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2024-10-02T05:59:12.505-04:00"
                                jcr:lastModifiedBy="CATEMJX"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Hepatitis C ist eine Leberentzündung, die durch das Hepatitis C-Virus (HCV) verursacht wird. Die Übertragung erfolgt durch infiziertes Blut, etwa bei unsicheren Bluttransfusionen, Organtransplantationen, verunreinigten Spritzen, Nadelstichverletzungen oder von einer infizierten Mutter auf das Kind. Mythen wie die Ansteckung durch Berührung oder Alkoholkonsum sind falsch. Die Krankheit ist seit 1993 in Österreich meldepflichtig. Etwa 80 % der Betroffenen zeigen nach der Erstinfektion keine Symptome. Zu den häufigsten, sehr unspezifischen Anzeichen zählen Müdigkeit, Gelenkschmerzen, Fieber, Übelkeit und Erbrechen. Die Diagnose erfolgt durch Antikörpertests und den Nachweis des viralen Erbmaterials (HCV-RNA) im Blut. Eine genaue Untersuchung des Leberzustands ist ebenfalls wichtig. Diese erfolgt mittels Ultraschalluntersuchung.&lt;br>&#xd;&#xa;&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator
                                cq:styleIds="[1662756423318]"
                                jcr:created="{Date}2024-06-27T02:20:19.045-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2024-06-27T02:20:19.045-04:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <title_copy_837445862
                                cq:styleIds="[1659545825678,1651545824678,1651545825678,1651545829678,1651241825678,1651545825693]"
                                jcr:created="{Date}2024-05-27T02:51:39.260-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2024-08-06T02:49:44.629-04:00"
                                jcr:lastModifiedBy="HERZOBW"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="Verlauf  "
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h2"
                                variant="h"/>
                            <text_copy
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2024-05-27T02:52:21.017-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2024-05-27T02:52:54.860-04:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Die Erkrankung gliedert sich in akute und chronische Phasen und kann unbehandelt bis zur Leberzirrhose führen. Bei der akuten Hepatitis kann es innerhalb von sechs Monaten nach erstmaligem Kontakt zu einer Spontanheilung durch den eigenen Körper kommen. Passiert dies nicht, entwickelt sich die Erkrankung zu einer chronischen Hepatitis C. Die chronische Form ist sehr gut behandelbar – ja sogar heilbar.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_217474
                                cq:styleIds="[1662756423318]"
                                jcr:created="{Date}2024-06-27T02:21:01.819-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2024-06-27T02:21:01.819-04:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <title_copy_1523776561
                                cq:styleIds="[1659545825678,1651545824678,1651545825678,1651545829678,1651241825678,1651545825693]"
                                jcr:created="{Date}2024-05-27T02:53:31.086-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2024-08-06T02:50:10.287-04:00"
                                jcr:lastModifiedBy="HERZOBW"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="Behandlung "
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h2"
                                variant="h"/>
                            <text_copy_918236415
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2024-05-27T02:54:29.369-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2024-05-27T02:54:57.356-04:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Im Gegensatz zu A und B gibt es derzeit keine Impfung gegen eine Infektion mit dem Hepatitis C-Virus. Für Patient:innen mit diagnostizierter chronischer Hepatitis C stehen verschiedene Behandlungen zur Verfügung. Mit modernen, interferonfreien Medikamenten können nahezu alle HCV-infizierten Patient:innen von der Infektion geheilt werden.&amp;nbsp;&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
