                            <text_116650528_copy
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2024-08-27T02:16:56.621-04:00"
                                jcr:lastModifiedBy="HERZOBW"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-26-reg&quot;>Hepatitis C ist eine virale Infektionskrankheit, die die Leber betrifft. Sie wird durch das Hepatitis-C-Virus (HCV) verursacht und kann sowohl akut als auch chronisch verlaufen.&amp;nbsp;&lt;/span>&lt;br>&#xd;&#xa; &lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <text
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2024-08-27T02:17:07.412-04:00"
                                jcr:createdBy="HERZOBW"
                                jcr:lastModified="{Date}2024-10-02T05:58:01.295-04:00"
                                jcr:lastModifiedBy="CATEMJX"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;i>In Österreich sind rund 26.000 Menschen mit dem Hepatitis C-Virus infiziert, das zu einer Leberentzündung führt.&amp;nbsp;&lt;/i>&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                        </container3>
                        <separator_copy_copy_
                            cq:styleIds="[1662756423318]"
                            jcr:created="{Date}2024-06-26T10:30:16.699-04:00"
