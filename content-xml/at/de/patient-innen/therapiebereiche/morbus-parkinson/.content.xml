                            <title_1801673846_cop_376519582
                                cq:styleIds="[1659545825678,1651545824678,1651545825678,1651545829678,1651241825678,1651545825693]"
                                jcr:created="{Date}2024-05-27T07:14:09.146-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2024-08-06T03:05:43.076-04:00"
                                jcr:lastModifiedBy="HERZOBW"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="Leben mit Morbus Parkinson  "
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h2"
                                variant="h"/>
                            <text_1219870506_copy_266050215
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2024-05-27T07:14:36.786-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2024-09-24T05:33:36.190-04:00"
                                jcr:lastModifiedBy="HERZOBW"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Parkinson ist eine komplexe Erkrankung des Nervensystems, die eine individuelle Behandlungsstrategie erfordert. Obwohl sie nicht heilbar ist, können Betroffene durch die richtige Therapie und Unterstützung ein erfülltes Leben führen.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
