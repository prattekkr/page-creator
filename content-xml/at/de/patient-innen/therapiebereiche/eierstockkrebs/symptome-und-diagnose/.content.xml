                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-26-reg&quot;>Eierstockkrebs verursacht keine eindeutigen Frühsymptome, die auf ihn verweisen. Die ersten Symptome sind meist unspezifisch und schwer zuzuordnen. Daher wird die Erkrankung bei mehr als zwei Drittel der Patientinnen erst dann entdeckt, wenn sich die Krebszellen bereits im kleinen Becken und/oder Bauchraum ausgebreitet haben.&lt;/span>&lt;sup>&lt;span class=&quot;body-unica-18-reg&quot;>2&lt;/span>&lt;/sup>&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
