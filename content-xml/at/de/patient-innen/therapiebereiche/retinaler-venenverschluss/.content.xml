                                jcr:primaryType="nt:unstructured"
                                jcr:title="Ursachen "
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h2"
                                variant="h"/>
                            <text_copy
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2024-05-24T07:08:59.774-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2024-05-24T07:09:42.215-04:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Im Auge gibt es eine Arterie und eine Vene, die Blut hinein- bzw. hinausführen. Ein RVV entsteht, wenn die Vene blockiert ist und Blut nicht mehr abfließen kann. Dies führt zu einer Verdickung der Netzhaut. Blutgerinnsel oder veränderte Arterien können die Blockade verursachen und zu Sehstörungen, Netzhautblutungen und sogar Erblindung führen.&lt;br>&#xd;&#xa;&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_1328419277
                                cq:styleIds="[1662756423318]"
                                jcr:created="{Date}2024-06-26T02:12:48.736-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2024-06-26T02:12:48.736-04:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <title_1042530142_cop
                                cq:styleIds="[1659545825678,1651545825693,1651545824678,1651545825678,1651545829678,1651241825678]"
                                jcr:created="{Date}2024-05-24T07:10:25.347-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2024-08-06T02:32:12.170-04:00"
                                jcr:lastModifiedBy="HERZOBW"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="Symptome "
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h2"
                                variant="h"/>
                            <text_2107706253_copy
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2024-05-24T07:12:26.186-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2024-10-02T06:01:08.414-04:00"
                                jcr:lastModifiedBy="CATEMJX"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Ein retinaler Venenverschluss kann sich entweder durch plötzliches, schlechtes Sehen oder durch eine langsame Verschlechterung des Sehens bemerkbar machen. Patient:innen haben das Gefühl, als hätten sie einen Schleier vor dem Auge und glauben fälschlicherweise, es handle sich um einen grauen Star – oder sie nehmen die Sehminderung als Folge des Alterns hin.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_661668266
                                cq:styleIds="[1662756423318]"
                                jcr:created="{Date}2024-06-26T02:14:07.215-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2024-06-26T02:17:39.008-04:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <title_copy_788993601
                                cq:styleIds="[1659545825678,1651545825693,1651545824678,1651545825678,1651545829678,1651241825678]"
                                jcr:created="{Date}2024-05-24T07:13:18.527-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2024-08-06T02:32:20.320-04:00"
                                jcr:lastModifiedBy="HERZOBW"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="Behandlung "
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h2"
                                variant="h"/>
                            <text_copy_261427840
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2024-05-24T07:14:37.494-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2024-08-27T02:04:55.179-04:00"
                                jcr:lastModifiedBy="HERZOBW"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Die Behandlung des retinalen Venenverschlusses hängt von der Art und Schwere des Verschlusses ab. Eine mögliche Behandlungsoption ist die Injektion von Medikamenten in das Auge. Diese reduzieren die Schwellung und verbessern das Sehvermögen. Dazu gehören Anti-VEGF-Medikamente und Kortikosteroide. In einigen Fällen kann auch eine Laserbehandlung eingesetzt werden.&amp;nbsp;&lt;/p>&#xd;&#xa;&lt;p>Es ist wichtig, den retinalen Venenverschluss frühzeitig zu erkennen und zu behandeln, um das Risiko von Komplikationen und dauerhaften Sehstörungen zu minimieren.&amp;nbsp;&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
