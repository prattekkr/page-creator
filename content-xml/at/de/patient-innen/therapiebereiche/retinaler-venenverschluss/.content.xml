                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                langAttribute="none"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-26-reg&quot;>Der retinale Venenverschluss (RVV) wird auch „Schlaganfall im Auge“ genannt. Etwa 1,6 % der über 49-Jährigen sind davon betroffen.&amp;nbsp;&lt;/span>&lt;br>&#xd;&#xa; &lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <text
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2024-10-02T06:01:47.891-04:00"
                                jcr:lastModifiedBy="CATEMJX"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;i>Der retinale Venenverschluss (RVV) ist die zweithäufigste Netzhaut-Gefäßerkrankung. Häufig treten retinale Venenverschlüsse nachts auf. Unbehandelt kann der Venenverschluss in schweren Fällen in nur wenigen Monaten zur Erblindung führen.&lt;/i>&lt;/span>&lt;br>&#xa;&lt;/p>&#xa;"
                                textIsRich="true"/>
                        </container3>
                        <separator_copy_copy
                            cq:styleIds="[1662756423318]"
                            jcr:created="{Date}2024-06-26T10:30:16.699-04:00"
                            jcr:createdBy="singarx"
