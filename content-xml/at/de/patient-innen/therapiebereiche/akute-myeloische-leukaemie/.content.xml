                                jcr:lastModifiedBy="HERZOBW"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-26-reg&quot;>Die&amp;nbsp;akute myeloische Leukämie (AML) ist eine Form von Blutkrebs, die das Knochenmark betrifft. Da sich AML schnell entwickeln kann, ist eine frühzeitige Behandlung entscheidend.&amp;nbsp;&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <text_copy
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2024-10-03T03:32:26.654-04:00"
                                jcr:lastModifiedBy="CATEMJX"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;i>Die akute myeloische Leukämie (AML) ist die am häufigsten diagnostizierte akute Leukämie in Österreich, wobei jährlich etwa 340 Patient:innen betroffen sind. Männer erkranken etwas häufiger.&lt;/i>&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                        </container3>
                        <separator_copy
                            cq:styleIds="[1662756423318]"
                            jcr:created="{Date}2024-06-27T03:29:41.987-04:00"
