                                jcr:lastModifiedBy="HERZOBW"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="Ursachen und Risikofaktoren "
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h2"
                                variant="h"/>
                            <text
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2024-05-27T05:05:44.771-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2024-05-27T05:06:31.612-04:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Die genauen Ursachen von AML sind oft nicht bekannt, aber Risikofaktoren wie Alter, Strahlen- oder Chemikalienexposition, bestimmte Medikamente und Rauchen können das Erkrankungsrisiko erhöhen.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator
                                cq:styleIds="[1662756423318]"
                                jcr:created="{Date}2024-06-27T03:29:41.987-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2024-06-27T03:29:41.987-04:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <title_1702676960
                                cq:styleIds="[1659545825678,1651545824678,1651545825678,1651545829678,1651241825678,1651545825693]"
                                jcr:created="{Date}2024-05-27T05:07:03.058-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2024-08-06T02:55:53.899-04:00"
                                jcr:lastModifiedBy="HERZOBW"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="Symptome und Diagnose "
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h2"
                                variant="h"/>
                            <text_415719587
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2024-05-27T05:07:54.086-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2024-09-17T07:10:52.677-04:00"
                                jcr:lastModifiedBy="HERZOBW"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Akute myeloische Leukämie ist eine Störung im Blutbildungsprozess, bei der sich unreife Vorstufen der myeloischen Blutzellen – rote Blutkörperchen, Blutplättchen und einige weiße Blutkörperchen – krankhaft verändern. Diese sogenannten Blasten reifen nicht vollständig heran, vermehren sich jedoch unkontrolliert und verdrängen gesunde Zellen. Dies führt zu Störungen lebenswichtiger Blutfunktionen wie Sauerstofftransport, Blutgerinnung und Immunabwehr. Zudem breiten sich die Krebszellen über den Blutkreislauf in andere Organe aus und können Schäden verursachen.&lt;/p>&#xd;&#xa;&lt;p>Die Symptome können stark variieren und beispielsweise Müdigkeit, Fieber, erhöhte Blutungsneigung und/oder Bauchschmerzen umfassen. Eine Blutuntersuchung beim Hausarzt ist oft der erste Schritt zur Diagnose. Weiterführende Untersuchungen wie Knochenmarkspunktion und Labortests in hämatologisch-onkologischen Zentren bestimmen die AML-Art und helfen bei der Behandlungsplanung.&lt;br>&#xd;&#xa;&lt;/p>&#xd;&#xa;&lt;p>Univ.-Prof. Dr. Heinz Sill klärt in dem Online-Kurs für Patient:innen und Angehörige „AML verstehen“ auf der Gesundheitsplattform Selpers über die Krankheit auf:&amp;nbsp;&lt;br>&#xd;&#xa;&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <button
                                cq:styleIds="[1659997740832,1659997787460]"
                                jcr:created="{Date}2024-09-17T06:57:17.143-04:00"
                                jcr:createdBy="HERZOBW"
                                jcr:lastModified="{Date}2024-09-17T07:11:22.420-04:00"
                                jcr:lastModifiedBy="HERZOBW"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="Selpers Kurs: AML verstehen"
                                sling:resourceType="abbvie-com2/components/button/v2/button"
                                accessibilityLabel="Hier geht es zum Selper Kurs über AML Verständnis"
                                linkTarget="_self"
                                linkURL="https://selpers.com/blutkrebs/aml-verstehen/"/>
                            <separator_1022537067
                                cq:styleIds="[1662756423318]"
                                jcr:created="{Date}2024-06-27T03:30:48.120-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2024-06-27T03:30:48.120-04:00"
