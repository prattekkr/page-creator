                            <title_957148025
                                cq:styleIds="[1659545825678,1651545824678,1651545825678,1651545829678,1651241825678,1651545825693]"
                                jcr:created="{Date}2024-05-27T05:11:17.481-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2024-08-06T02:56:04.376-04:00"
                                jcr:lastModifiedBy="HERZOBW"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="Behandlung"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h2"
                                variant="h"/>
                            <text_1844757057
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2024-05-27T05:17:25.251-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2024-09-17T07:11:36.982-04:00"
                                jcr:lastModifiedBy="HERZOBW"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Da AML rasch voranschreitet, ist ein schneller Behandlungsbeginn entscheidend. Die Wahl der Therapie hängt von Alter, Gesundheitszustand und der Art der AML ab. Eine intensive Chemotherapie gefolgt von einer Stammzelltransplantation ist häufig notwendig, kann jedoch belastend sein. Unterschiedliche Therapien, einschließlich Kombinationstherapien mit neuen Substanzen, können bei älteren Patient:innen oder solchen mit Vorerkrankungen die Symptome lindern, die Lebensqualität steigern und die Lebenserwartung erhöhen.&lt;/p>&#xd;&#xa;&lt;p>In dem Online-Kurs für Patent:innen und Angehörige „AML behandeln“ informiert Dr. Elisabeth Koller über aktuelle Behandlungsmethoden:&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <button_copy
                                cq:styleIds="[1659997740832,1659997787460]"
                                jcr:created="{Date}2024-09-17T06:57:17.143-04:00"
                                jcr:createdBy="HERZOBW"
                                jcr:lastModified="{Date}2024-09-17T07:11:07.291-04:00"
                                jcr:lastModifiedBy="HERZOBW"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="Selpers Kurs: AML behandeln"
                                sling:resourceType="abbvie-com2/components/button/v2/button"
                                accessibilityLabel="Hier geht es zum Selper Kurs über AML Behandlung"
                                linkTarget="_self"
                                linkURL="https://selpers.com/blutkrebs/aml-behandeln/"/>
                            <separator_1071681238
                                cq:styleIds="[1662756423318]"
                                jcr:created="{Date}2024-06-27T03:31:31.179-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2024-06-27T03:31:51.797-04:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <title_382311489
                                cq:styleIds="[1659545825678,1651545824678,1651545825678,1651545829678,1651241825678,1651545825693]"
                                jcr:created="{Date}2024-05-27T05:21:01.738-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2024-08-06T02:56:17.000-04:00"
                                jcr:lastModifiedBy="HERZOBW"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="Zusätzliche Unterstützung "
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h2"
                                variant="h"/>
                            <text_1602117950
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2024-05-27T05:21:29.106-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2024-06-27T03:32:23.980-04:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Neben der AML-Behandlung können unterstützende Therapien Beschwerden und Behandlungsfolgen mindern. Dazu gehören Wachstumsfaktoren, Antibiotika, Virostatika, Pilzmittel und Bluttransfusionen.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_311115450
