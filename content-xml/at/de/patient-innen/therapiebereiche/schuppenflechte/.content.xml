                            <text_copy
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2024-07-18T06:06:53.982-04:00"
                                jcr:lastModifiedBy="HERZOBW"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;sup>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-26-reg&quot;>Plaque-Psoriasis – besser bekannt als Schuppenflechte – ist eine chronisch-entzündliche Hauterkrankung. Sie ist zwar nicht heilbar, jedoch gibt es vielfältige Möglichkeiten der Behandlung.&lt;/span>&lt;/span>&lt;/sup>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <text
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2024-09-17T06:47:20.249-04:00"
                                jcr:lastModifiedBy="HERZOBW"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;i>Rund 250.000 Österreicher:innen leben mit Psoriasis. Die Erkrankung ist körperlich und psychisch sehr belastend.&lt;/i>&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                        </container3>
                        <separator_copy_copy_
                            cq:styleIds="[1662756423318]"
                            jcr:created="{Date}2024-06-26T10:30:16.699-04:00"
