                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;body-unica-26-reg&quot;>&lt;span class=&quot;light-font&quot;>Die axiale Spondyloarthritis (ax-SpA), auch bekannt unter dem Namen Morbus Bechterew, ist eine entzündlich-rheumatische Erkrankung, die vor allem die Wirbelsäule und die Kreuzbein-Darmbein-Gelenke betrifft.&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <text
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2024-08-26T10:36:59.585-04:00"
                                jcr:createdBy="HERZOBW"
                                jcr:lastModified="{Date}2024-10-02T04:39:01.463-04:00"
                                jcr:lastModifiedBy="CATEMJX"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;b>&lt;span class=&quot;light-font&quot;>&lt;i>Etwa 75.000 Menschen in Österreich sind betroffen. Männer erkranken bis zu dreimal häufiger als Frauen. Die Erkrankung tritt zumeist zwischen dem 20. und 40. Lebensjahr auf.&lt;/i>&lt;/span>&lt;/b>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                        </container3>
                        <separator_copy_copy_
                            cq:styleIds="[1662756423318]"
                            jcr:created="{Date}2024-05-27T10:23:32.937-04:00"
