                                jcr:primaryType="nt:unstructured"
                                jcr:title="Symptome  "
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h2"
                                variant="h"/>
                            <text_1655337203
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2024-08-26T10:37:42.986-04:00"
                                jcr:createdBy="HERZOBW"
                                jcr:lastModified="{Date}2024-08-26T10:38:08.603-04:00"
                                jcr:lastModifiedBy="HERZOBW"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Chronisch-entzündliche Erkrankungen der Wirbelsäule sind Autoimmunerkrankungen, bei denen das körpereigene Abwehrsystem Knochen- und Knorpelgewebe angreift. Dies führt zu Entzündungen in der gesamten Wirbelsäule und im Kreuz-Darmbein-Gelenk. Typische Symptome sind langanhaltende Rückenschmerzen von mehr als drei Monaten Dauer und Steifigkeit im Lendenwirbelsäulenbereich. Anfangs sind die Symptome oft unspezifisch, wodourch die Diagnose oft verzögert wird.&lt;/p>&#xd;&#xa;&lt;ul>&#xd;&#xa;&lt;li>Tiefsitzender Rückenschmerz mit morgendlichem Schmerzmaximum&lt;/li>&#xd;&#xa;&lt;li>Beginn vor dem 45. Lebensjahr&lt;/li>&#xd;&#xa;&lt;li>Müdigkeit&lt;/li>&#xd;&#xa;&lt;li>Beschwerden von mehr als drei Monaten&lt;/li>&#xd;&#xa;&lt;li>Morgensteifigkeit im Rücken, die sich nach 30 bis 45 Minuten Bewegung verbessert&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;li>Mögliche Begleiterkrankungen wie Entzündungen im Auge, Schuppenflechte oder Darmentzündungen&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_copy
                                cq:styleIds="[1662756423318]"
                                jcr:created="{Date}2024-05-27T10:23:32.937-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2024-05-27T10:23:32.937-04:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <title_1987728780
                                cq:styleIds="[1659545825678,1651545824678,1651545825678,1651545829678,1651241825678,1651545825693]"
                                jcr:created="{Date}2024-05-27T10:20:59.005-04:00"
