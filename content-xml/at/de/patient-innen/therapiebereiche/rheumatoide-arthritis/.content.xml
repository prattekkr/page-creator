                            <title_copy
                                cq:styleIds="[1659545825678,1651545824678,1651545825678,1651545829678,1651241825678,1651545825693]"
                                jcr:created="{Date}2024-05-27T10:55:11.638-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2024-08-06T03:09:59.346-04:00"
                                jcr:lastModifiedBy="HERZOBW"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="Symptome  "
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h2"
                                variant="h"/>
                            <text_1471155333
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2024-05-27T10:55:24.277-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2024-05-27T11:07:18.854-04:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;div>&amp;nbsp;&lt;/div>&#xd;&#xa;&lt;div>&lt;span class=&quot;body-unica-20-reg&quot;>Typische Anzeichen für rheumatoide Arthritis sind:&amp;nbsp;&lt;/span>&lt;/div>&#xd;&#xa;&lt;div>&amp;nbsp;&lt;/div>&#xd;&#xa;&lt;ul>&#xd;&#xa;&lt;li>Symmetrische Gelenkentzündungen auf beiden Körperseiten, wie z.B. zwei geschwollene Ringfinger.&lt;/li>&#xd;&#xa;&lt;li>Die geschwollenen Finger sind schmerz- und druckempfindlich.&lt;/li>&#xd;&#xa;&lt;li>Die Gelenke sind morgens oft steif, werden aber durch Bewegung wieder beweglicher.&lt;br>&#xd;&#xa;Eine frühzeitige Diagnose und individuelle Behandlung sind entscheidend, um bleibende Schäden zu minimieren.&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_copy_copy__1019719686
