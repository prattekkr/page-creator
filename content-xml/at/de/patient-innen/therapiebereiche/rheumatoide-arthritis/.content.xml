                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Bei anhaltenden Gelenkbeschwerden über mehrere Wochen sollte ein:e Rheumatolog:in aufgesucht werden. Die Diagnose erfolgt durch körperliche Untersuchung, Anamnese, Laboruntersuchungen und Röntgenbilder.&amp;nbsp;&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_copy_copy__1728159768
