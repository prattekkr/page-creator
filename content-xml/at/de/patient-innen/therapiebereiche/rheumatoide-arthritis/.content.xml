                                jcr:primaryType="nt:unstructured"
                                jcr:title="Behandlung"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h2"
                                variant="h"/>
                            <text_copy_501713284_
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2024-05-27T10:55:24.277-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-07-31T04:52:55.619-04:00"
                                jcr:lastModifiedBy="klavimx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Die Behandlung umfasst eine individuelle Therapie mit verschiedenen Medikamenten, darunter nichtsteroidale entzündungshemmende Medikamente (NSAR), Kortison, Schmerzmittel, Basistherapeutika, Biologika (z. B. TNF-alpha oder Interleukin-Hemmer) oder kleine Moleküle (z. B. Januskinase-Hemmer).&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_copy_copy_
                                cq:styleIds="[1662756409908]"
                                jcr:created="{Date}2024-05-27T11:14:55.841-04:00"
