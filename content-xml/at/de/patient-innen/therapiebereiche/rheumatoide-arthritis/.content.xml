                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;sup>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>Rheumatoide Arthritis ist eine chronische Autoimmunerkrankung, bei der die Gelenke schmerzhaft entzündet sind&lt;/span>&lt;/span>&lt;/sup>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <text_copy
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2024-10-02T04:37:44.111-04:00"
                                jcr:lastModifiedBy="CATEMJX"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;i>In Österreich leben rund 60.000 Menschen mit rheumatoider Arthritis. Entzündliches Rheuma ist nicht heilbar, aber wirksam behandelbar.&lt;/i>&lt;/span>&lt;/p>&#xa;"
                                textIsRich="true"/>
                        </container3>
