                            <text_copy_501713284
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2024-05-27T10:55:24.277-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2024-08-27T02:18:23.811-04:00"
                                jcr:lastModifiedBy="HERZOBW"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Rheumatoide Arthritis ist eine Autoimmunerkrankung, bei der das körpereigene Immunsystem die Gelenke angreift und Entzündungen in der Gelenk-Innenhaut auslöst. Diese Entzündungen rufen Schwellungen und Schmerzen hervor und können ohne wirksame Behandlung zu Verformungen der Knochen führen.&amp;nbsp;&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_copy_copy__926402545
                                cq:styleIds="[1662756409908]"
                                jcr:created="{Date}2024-05-27T11:14:55.841-04:00"
