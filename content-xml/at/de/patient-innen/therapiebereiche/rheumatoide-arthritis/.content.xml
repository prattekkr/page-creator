                                jcr:lastModifiedBy="klavimx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Obwohl rheumatoide Arthritis nicht geheilt werden kann, bietet eine rechtzeitige und umfassende Therapie die Möglichkeit, Krankheitssymptome zu lindern und die Lebensqualität zu steigern.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
