                                jcr:primaryType="nt:unstructured"
                                jcr:title="Behandlung  "
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h2"
                                variant="h"/>
                            <text_copy_2059746069
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2024-05-24T06:24:17.166-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2024-06-26T01:59:29.732-04:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Die Behandlung des Grünen Stars zielt darauf ab, den Sehnerv zu schützen und das Sehvermögen zu erhalten. Zu Beginn werden Augentropfen eingesetzt, die den Augeninnendruck senken und den Sehnerv durchbluten und die Nervenfasern schützen.&amp;nbsp;In über 90 % der Fälle wird die Krankheit durch die Therapie mit Augentropfen stabilisiert. Weiters stehen Laserbehandlungen und operative Verfahren, wie die Implantation eines Stents, zur Verfügung.&amp;nbsp;&lt;br>&#xd;&#xa;&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
