                                jcr:title="Ursachen"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h2"
                                variant="h"/>
                            <text_copy
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2024-05-27T00:54:23.034-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-06-27T05:41:36.379-04:00"
                                jcr:lastModifiedBy="klavimx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Bei der Riesenzellarteriitis handelt es sich um eine Autoimmunerkrankung, bei der das Immunsystem die Wände der Blutgefäße angreift und entzündet. Die genaue Ursache der Erkrankung ist noch nicht vollständig geklärt, es wird jedoch eine Beteiligung genetischer und umweltbedingter Faktoren angenommen. Die Entzündung kann zu einer Verengung der Arterien führen, was die Blutversorgung der betroffenen Gewebe beeinträchtigt.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_602648805
                                cq:styleIds="[1662756423318]"
                                jcr:created="{Date}2024-06-26T04:32:34.887-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2024-06-26T04:32:34.887-04:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <title_1356593632_cop
                                cq:styleIds="[1659545825678,1651545824678,1651545825678,1651545829678,1651241825678,1651545825693]"
                                jcr:created="{Date}2024-05-27T00:57:17.739-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-06-27T05:41:48.997-04:00"
                                jcr:lastModifiedBy="klavimx"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="Symptome"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h2"
                                variant="h"/>
                            <text_2006635851_copy
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2024-05-27T00:57:24.751-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-06-27T05:42:02.258-04:00"
                                jcr:lastModifiedBy="klavimx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Typische Anzeichen für die Riesenzellarteriitis sind:&lt;/p>&#xd;&#xa;&lt;p>• Starke, neu auftretende Kopfschmerzen, oft im Schläfenbereich&lt;/p>&#xd;&#xa;&lt;p>• Empfindliche Kopfhaut&lt;/p>&#xd;&#xa;&lt;p>• Schmerzen in Oberarmen, Schulter oder Becken&lt;/p>&#xd;&#xa;&lt;p>• Verminderte Sehkraft oder vorübergehender Sehverlust&lt;/p>&#xd;&#xa;&lt;p>• Allgemeine Müdigkeit, Fieber und Gewichtsverlust&lt;/p>&#xd;&#xa;&lt;p>Eine frühzeitige Diagnose und Behandlung sind entscheidend, um schwere Komplikationen wie dauerhaften Sehverlust zu verhindern.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator
                                cq:styleIds="[1662756423318]"
                                jcr:created="{Date}2024-06-26T11:18:03.849-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2024-06-26T11:18:03.849-04:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <title_copy_953801407
                                cq:styleIds="[1659545825678,1651545824678,1651545825678,1651545829678,1651241825678,1651545825693]"
                                jcr:created="{Date}2024-05-27T01:00:08.317-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-06-27T05:42:14.291-04:00"
                                jcr:lastModifiedBy="klavimx"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="Diagnose"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h2"
                                variant="h"/>
                            <text_copy_1638387147
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2024-05-27T01:03:01.701-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-06-27T05:42:25.173-04:00"
                                jcr:lastModifiedBy="klavimx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Bei Verdacht auf Riesenzellarteriitis sollte umgehend ein:e Rheumatolog:in aufgesucht werden. Die Diagnose erfolgt durch klinische Untersuchung, Anamnese, Blutuntersuchungen (z.B. Entzündungsmarker wie CRP- oder BSG-Wert), bildgebende Verfahren (Ultraschall, MRT, PET-CT) sowie gegebenenfalls eine Biopsie der Schläfenarterie.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_1514949200
                                cq:styleIds="[1662756423318]"
                                jcr:created="{Date}2024-06-26T11:19:19.675-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2024-06-26T11:19:19.675-04:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <title_1837585256_cop
                                cq:styleIds="[1659545825678,1651545824678,1651545825678,1651545829678,1651241825678,1651545825693]"
                                jcr:created="{Date}2024-05-27T01:04:05.032-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-06-27T05:42:34.791-04:00"
                                jcr:lastModifiedBy="klavimx"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="Behandlung"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h2"
                                variant="h"/>
                            <text_971140398_copy_
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2024-05-27T01:05:15.701-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-06-27T05:42:46.816-04:00"
                                jcr:lastModifiedBy="klavimx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Die Behandlung der Riesenzellarteriitis besteht aus einer medikamentösen Therapie, um die Entzündung rasch zu kontrollieren und Komplikationen zu verhindern. Als moderne Therapieoptionen stehen Biologika oder Small Molecules zur Verfügung.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_864210246
                                cq:styleIds="[1662756423318]"
                                jcr:created="{Date}2024-06-26T11:20:28.995-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2024-06-26T11:20:28.995-04:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <title_copy_773338705
                                cq:styleIds="[1659545825678,1651545824678,1651545825678,1651545829678,1651241825678,1651545825693]"
                                jcr:created="{Date}2024-05-27T01:07:38.985-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-06-27T05:44:19.414-04:00"
                                jcr:lastModifiedBy="klavimx"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="Leben mit Riesenzellarteriitis"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h2"
                                variant="h"/>
                            <text_copy_641378898_
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2024-05-27T01:08:08.059-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2025-06-27T05:44:30.999-04:00"
                                jcr:lastModifiedBy="klavimx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Trotz der Herausforderungen, die die Krankheit mit sich bringt, können viele Betroffene durch eine frühzeitige und konsequente Therapie die Symptome erheblich lindern und die Lebensqualität aufrechterhalten. Eine regelmäßige ärztliche Überwachung ist wichtig, um die Medikation anzupassen und mögliche Nebenwirkungen zu erkennen.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_copy_copy_
