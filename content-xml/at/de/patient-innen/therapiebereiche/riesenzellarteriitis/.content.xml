                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>Riesenzellarteriitis ist eine chronische Entzündung der großen und mittelgroßen Arterien, die vor allem bei älteren Menschen, häufiger bei Frauen, auftritt.&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <text_copy
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2025-06-27T05:40:10.179-04:00"
                                jcr:lastModifiedBy="klavimx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;i>In Österreich sind ca. 1.500 bis 1.900 Menschen betroffen*.&lt;/i>&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                        </container3>
