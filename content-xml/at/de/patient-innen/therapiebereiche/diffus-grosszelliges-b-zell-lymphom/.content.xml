                            <text
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2024-07-18T06:20:33.019-04:00"
                                jcr:lastModifiedBy="HERZOBW"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;body-unica-26-reg&quot;>&lt;span class=&quot;light-font&quot;>Das diffus großzellige B-Zell-Lymphom (DLBCL) ist eine häufige Form von Non-Hodgkin-Lymphomen und gehört zur Gruppe der bösartigen Lymphdrüsenerkrankungen&lt;/span>&lt;/span>&lt;br>&#xd;&#xa;&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <text_copy
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2024-08-06T03:00:43.092-04:00"
                                jcr:lastModifiedBy="HERZOBW"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;i>DLBCL ist eine der häufigsten Formen von Lymphomen und kann Menschen jeden Alters betreffen. Diese aggressive Form von Lymphom beeinflusst das lymphatische System und kann sich in verschiedenen Körperteilen manifestieren. DLBCL kann in vielen Fällen erfolgreich behandelt werden.&lt;/i>&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                        </container3>
                        <separator_copy
                            cq:styleIds="[1662756423318]"
                            jcr:created="{Date}2024-06-27T04:14:32.546-04:00"
                            jcr:createdBy="singarx"
                            jcr:lastModified="{Date}2024-06-27T04:14:32.546-04:00"
                            jcr:lastModifiedBy="singarx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                        <container_651703203
                            cq:styleIds="[1653545835858,1653545825686,1653242825678,1653545835879,1653545835982]"
                            jcr:created="{Date}2024-06-27T04:13:10.321-04:00"
                            jcr:createdBy="singarx"
                            jcr:lastModified="{Date}2024-08-06T02:59:39.800-04:00"
