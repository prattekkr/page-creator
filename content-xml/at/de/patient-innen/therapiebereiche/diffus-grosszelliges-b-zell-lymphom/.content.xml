                            sling:resourceType="abbvie-com2/components/container/v2/container">
                            <title
                                cq:styleIds="[1659545825678,1651545824678,1651545825678,1651545829678,1651241825678,1651545825693]"
                                jcr:created="{Date}2024-05-27T06:08:19.531-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2024-08-06T02:59:57.432-04:00"
                                jcr:lastModifiedBy="HERZOBW"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="Symptome und Diagnose "
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h2"
                                variant="h"/>
                            <text
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2024-05-27T06:08:27.251-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2024-07-18T06:21:17.543-04:00"
                                jcr:lastModifiedBy="HERZOBW"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Die Symptome von DLBCL können von Patient:in zu Patient:in variieren, aber sie umfassen oft Schwellungen von Lymphknoten, Fieber, Nachtschweiß, unerklärlichen Gewichtsverlust und allgemeine Schwäche. Die Diagnose erfolgt durch eine Kombination von Bildgebung, Gewebeproben und Bluttests.&lt;/p>&#xd;&#xa;&lt;p>Die genauen Ursachen von DLBCL sind noch nicht vollständig geklärt. Es gibt jedoch einige Risikofaktoren, darunter bestimmte genetische Veränderungen und Immunschwächezustände, die das Erkrankungsrisiko erhöhen können.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator
                                cq:styleIds="[1662756423318]"
                                jcr:created="{Date}2024-06-27T04:14:32.546-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2024-06-27T04:14:32.546-04:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <title_1590822073
                                cq:styleIds="[1659545825678,1651545824678,1651545825678,1651545829678,1651241825678,1651545825693]"
                                jcr:created="{Date}2024-05-27T06:08:35.751-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2024-08-06T03:00:08.904-04:00"
                                jcr:lastModifiedBy="HERZOBW"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="Behandlung"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h2"
                                variant="h"/>
                            <text_992210295
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2024-05-27T06:10:17.859-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2024-06-27T04:16:50.877-04:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Die Behandlung von DLBCL hängt von Faktoren wie dem Stadium der Erkrankung und dem Gesundheitszustand des/der Patient:in ab. Eine Heilung ist möglich, insbesondere wenn die Erkrankung in einem frühen Stadium erkannt wird und die geeignete Therapie angewandt wird.Die Therapie kann Chemotherapie, Strahlentherapie, zielgerichtete Therapien und in einigen Fällen eine Stammzelltransplantation umfassen.&lt;br>&#xd;&#xa;&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_49193609
                                cq:styleIds="[1662756423318]"
                                jcr:created="{Date}2024-06-27T04:17:06.028-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2024-06-27T04:17:06.028-04:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <title_1368814814
                                cq:styleIds="[1659545825678,1651545824678,1651545825678,1651545829678,1651241825678,1651545825693]"
                                jcr:created="{Date}2024-05-27T06:10:05.503-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2024-08-06T03:00:22.262-04:00"
                                jcr:lastModifiedBy="HERZOBW"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="Leben mit DLBCL "
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h2"
                                variant="h"/>
                            <text_1376091095
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2024-05-27T06:10:11.545-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2024-05-27T06:13:17.126-04:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Mit der richtigen Behandlung und Betreuung können viele Menschen mit DLBCL ein normales Leben führen. Regelmäßige ärztliche Kontrollen und eine gute Selbstfürsorge sind jedoch entscheidend.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
