                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-26-reg&quot;>Die Psoriasis Arthritis ist eine chronisch-entzündliche Erkrankung, die sowohl Haut als auch Gelenke betrifft. Sie tritt häufig zusammen mit einer Psoriasis, auch Schuppenflechte genannt, auf.&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <text_copy_964102210
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2024-09-17T07:21:58.806-04:00"
                                jcr:lastModifiedBy="HERZOBW"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;i>Patient:innen mit Schuppenflechte können auch eine Psoriasis Arthritis entwickeln. Meist sind jüngere Menschen betroffen.&lt;/i>&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                        </container3>
