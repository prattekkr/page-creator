                            <text_230942827
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2022-12-10T17:10:30.657-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2024-05-16T04:43:55.600-04:00"
                                jcr:lastModifiedBy="kanchrx3"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Wir geben unseren Mitarbeiter:innen gute Rahmenbedingungen, um sich beruflich und persönlich zu entfalten. Nutze deine Chance und erfahre mehr über unsere Zusatzleistungen.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                        </container3>
