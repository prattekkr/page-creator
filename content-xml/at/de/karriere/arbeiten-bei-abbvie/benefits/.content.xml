                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/accordion/v2/accordion"
                                heading="Was wir bieten "
                                headingElement="h5"
                                singleExpansion="false">
                                <item_1670713218905
                                    cq:panelTitle="Vergütung"
                                    cq:styleIds="[1659545825678]"
                                    jcr:lastModified="{Date}2024-05-16T04:48:53.559-04:00"
                                    jcr:lastModifiedBy="kanchrx3"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;ul>&#xd;&#xa;&lt;li>Attraktives Gehalt&lt;/li>&#xd;&#xa;&lt;li>Bonusprogramme&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <item_1670713221584
                                    cq:panelTitle="Weitere Benefits  "
                                    cq:styleIds="[1659545825678]"
                                    jcr:lastModified="{Date}2024-05-16T04:52:26.993-04:00"
                                    jcr:lastModifiedBy="kanchrx3"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;ul>&#xd;&#xa;&lt;li>Firmenpension&lt;/li>&#xd;&#xa;&lt;li>Aktienkaufplan für Mitarbeiter:innen&lt;/li>&#xd;&#xa;&lt;li>Weihnachtsgeschenke für Mitarbeiter:innen und ihre Kinder&lt;/li>&#xd;&#xa;&lt;li>Firmenjubiläen ab dem 5. Jahr der Zugehörigkeit&lt;/li>&#xd;&#xa;&lt;li>Empfehlungsprämie für neue Mitarbeiter:innen&lt;/li>&#xd;&#xa;&lt;li>Klimaticket&lt;/li>&#xd;&#xa;&lt;li>Essenszuschuss&lt;/li>&#xd;&#xa;&lt;li>Golddukaten zur Hochzeit und Geburt&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <item_1670713228568
                                    cq:panelTitle="Flexibles Arbeiten und Urlaub"
                                    cq:styleIds="[1659545825678]"
                                    jcr:lastModified="{Date}2024-09-25T03:18:08.223-04:00"
                                    jcr:lastModifiedBy="HERZOBW"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;ul>&#xd;&#xa;&lt;li>Flexibilität am Arbeitsplatz je nach Funktion, z.B. Gleitzeit, Teilzeitarbeit, Jobsharing, Work@Home&lt;/li>&#xd;&#xa;&lt;li>Hybrides Arbeitsmodell für Mitarbeiter:innen mit Bürotätigkeiten, in der Regel drei Tage im Büro und zwei Tage im Work@Home&lt;/li>&#xd;&#xa;&lt;li>Zusätzliche freie Arbeitstage&lt;/li>&#xd;&#xa;&lt;li>Jede:r Mitarbeiter:in bekommt unabhängig von der &amp;quot;Week of Possibilities&amp;quot; (WOP) zwei Arbeitstage, um sich sozial zu engagieren.&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <item_1670713232031
                                    cq:panelTitle="Unterstützung für Familien"
                                    cq:styleIds="[1659545825678]"
                                    jcr:lastModified="{Date}2024-05-16T04:55:45.697-04:00"
                                    jcr:lastModifiedBy="kanchrx3"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;ul>&#xd;&#xa;&lt;li>Flexible Elternteilzeit&lt;/li>&#xd;&#xa;&lt;li>Papamonat&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <item_1670713236887
                                    cq:panelTitle="Ganzheitliches Wohlbefinden"
                                    cq:styleIds="[1659545825678]"
                                    jcr:lastModified="{Date}2024-07-31T05:41:14.031-04:00"
                                    jcr:lastModifiedBy="HERZOBW"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Wir begleiten das gesundheitliche Wohlbefinden unserer Mitarbeiter:innen und bieten kostenlose Gesundheitsuntersuchungen wie z.B. Hör- bzw. Sehtests oder gratis Impfungen und unterschiedliche Aktionswochen, um gesunde Verhaltensweisen zu fördern.&lt;/p>&#xd;&#xa;&lt;p>&lt;a href=&quot;/content/abbvie-com2/at/de/karriere/arbeiten-bei-abbvie/wohlbefinden-am-arbeitsplatz.html&quot; title=&quot;Weitere Informationen&quot;>Weitere Informationen&lt;/a>&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <item_1670713240836
                                    cq:panelTitle="Aus- und Weiterbildung"
                                    jcr:lastModified="{Date}2024-07-31T05:41:52.593-04:00"
                                    jcr:lastModifiedBy="HERZOBW"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Bestausgebildete Expert:innen sind die Basis unseres Erfolgs. Wir unterstützen Mitarbeiter:innen mit interessanten Aus- und Weiterbildungsangeboten, um sich weiter entfalten zu können.&lt;/p>&#xd;&#xa;&lt;p>&lt;a href=&quot;/content/abbvie-com2/at/de/karriere/arbeiten-bei-abbvie/weiterentwicklung.html&quot;>Weitere Informationen&lt;/a>&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                            </accordion>
