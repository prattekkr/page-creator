                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Unabhängig von den Krankheitsgebieten und Entwicklungsphasen folgen wir drei Grundsätzen, um pharmazeutische Neuerungen&amp;nbsp;voranzutreiben.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
