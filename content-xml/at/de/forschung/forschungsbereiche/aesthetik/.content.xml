                                    sling:resourceType="abbvie-com2/components/quote"
                                    attributionName="Paolo Cuccuru"
                                    attributionTitle="General Manager Allergan Aesthetics Österreich und Schweiz  "
                                    fileReference="/content/dam/abbvie-com2/at/images/join-us/employees/Paolo_Cuccuru.jpg"
                                    quote="Die Möglichkeiten, Lösungen für Kund:innen zu finden, wurden durch den Zusammenschluss von Allergan und AbbVie im Jahr 2020 nochmals erweitert. Die Kombination aus Innovation, Technologie und technischer Expertise unterstützt uns dabei, unsere Ziele zu erreichen – und das sieht man auch in unserer sich entwickelnden Pipeline.“ "
