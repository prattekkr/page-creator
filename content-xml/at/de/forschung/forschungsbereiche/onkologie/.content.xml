                                jcr:lastModifiedBy="HERZOBW"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="SCHWERPUNKTE IN DER ONKOLOGIE"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h2"
                                variant="h"/>
                            <text2
                                cq:styleIds="[1659545825678,1659545835858]"
                                jcr:lastModified="{Date}2024-05-31T12:27:14.758-04:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Unser Ziel ist es, Lösungen zu finden, die die Behandlung von Krebserkrankungen revolutionieren. Wir suchen nach besseren und länger anhaltenden Ergebnissen bei Blutkrebs und soliden Tumoren.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <title2_copy
                                cq:styleIds="[1659545825678,1651545824678,1651545825694]"
                                jcr:lastModified="{Date}2024-07-17T03:46:18.294-04:00"
                                jcr:lastModifiedBy="HERZOBW"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="Blutkrebs"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h5"
                                variant="h"/>
                            <text2_copy
                                cq:styleIds="[1659545825678,1659545835858]"
                                jcr:lastModified="{Date}2024-05-31T12:29:21.620-04:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Blutkrebs ist eine Erkrankung, die sich auf blutbildendes Gewebe (z. B. Knochenmark) auswirkt und die Fähigkeit des Körpers, Infektionen zu bekämpfen, hemmt. Leukämie, Lymphome und Myelome sind die am häufigsten beobachteten Formen von Blutkrebs.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <accordion_copy_copy
                                cq:styleIds="[1,10,1653545835881,1651545829]"
                                jcr:created="{Date}2022-12-17T16:25:09.442-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2024-08-28T07:32:32.850-04:00"
                                jcr:lastModifiedBy="HERZOBW"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/accordion/v2/accordion"
                                heading="Schwerpunktbereiche bei Blutkrebs"
                                headingElement="h5"
                                singleExpansion="false">
                                <item_1671312472873
                                    cq:panelTitle="Akute myeloische Leukämie (AML) "
                                    cq:styleIds="[1659545825678]"
                                    jcr:lastModified="{Date}2024-05-31T12:35:07.267-04:00"
                                    jcr:lastModifiedBy="singarx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>AML ist eine der aggressivsten und am schwierigsten zu behandelnden Blutkrebserkrankungen mit einer sehr niedrigen Überlebensrate und nur wenigen Behandlungsoptionen für Patient:innen, die nicht für eine intensive Chemotherapie infrage kommen.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <item_1671312475801
                                    cq:panelTitle="Akute lymphatische Leukämie (ALL) "
                                    cq:styleIds="[1659545825678]"
                                    jcr:lastModified="{Date}2024-05-31T12:35:41.127-04:00"
                                    jcr:lastModifiedBy="singarx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Eine ALL entsteht, wenn das Knochenmark zu viele unreife Lymphozyten – eine Art weißer Blutkörperchen – produziert. Es ist die häufigste Krebsart bei Kindern.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <item_1671312481387
                                    cq:panelTitle="Chronische lymphatische Leukämie (CLL)"
                                    cq:styleIds="[1659545825678]"
                                    jcr:lastModified="{Date}2024-05-31T12:36:07.437-04:00"
                                    jcr:lastModifiedBy="singarx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Bei CLL handelt es sich um eine langsam fortschreitende Blutkrebsart, bei der das Knochenmark zu viele Lymphozyten – eine Art weißer Blutkörperchen – produziert.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <item_1671372277563
                                    cq:panelTitle="Diffuses großzelliges B-Zell-Lymphom (DLBCL) "
                                    cq:styleIds="[1659545825678]"
                                    jcr:lastModified="{Date}2024-08-14T02:21:11.994-04:00"
                                    jcr:lastModifiedBy="HERZOBW"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Das DLBCL ist die häufigste Form des Non-Hodgkin-Lymphoms (NHL). Die Wahrscheinlichkeit des Auftretens eines DLBCL steigt im Allgemeinen mit zunehmendem Alter an, die meisten Patient:innen erhalten die Diagnose im Alter von über 60 Jahren.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <item_1671372296338
                                    cq:panelTitle="Mantelzelllymphom (MCL) "
                                    cq:styleIds="[1659545825678]"
                                    jcr:lastModified="{Date}2024-08-14T02:21:25.752-04:00"
                                    jcr:lastModifiedBy="HERZOBW"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Das MCL ist eine aggressive Form des Non-Hodgkin-Lymphoms (NHL) und geht aus Zellen hervor, die im Randbereich der Lymphknoten, der sogenannten Mantelzone, entstehen.&amp;nbsp;&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <item_1671372299968
                                    cq:panelTitle="Multiples Myelom (MM) "
                                    cq:styleIds="[1659545825678]"
                                    jcr:lastModified="{Date}2024-08-22T02:54:20.806-04:00"
                                    jcr:lastModifiedBy="HERZOBW"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Das MM ist eine Krebserkrankung der Plasmazellen und ist häufig durch Wiederauftreten&amp;nbsp;der Erkrankung (Rezidiv) und Krankheitsstillstand (Remission) charakterisiert. Es ist die zweithäufigste Blutkrebsart.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <item_1671372303344
                                    cq:panelTitle="Myelodysplastische Syndrome (MDS) "
                                    cq:styleIds="[1659545825678]"
                                    jcr:lastModified="{Date}2024-09-17T01:30:44.292-04:00"
                                    jcr:lastModifiedBy="HERZOBW"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Bei MDS handelt es sich um eine Gruppe von Erkrankungen des Knochenmarks, bei denen zu wenig funktionsfähige Blutzellen wie beispielsweise rote Blutkörperchen (Erythrozyten), weiße Blutkörperchen (Leukozyten) und Blutplättchen (Thrombozyten) gebildet werden. MDS gehören zu den häufigsten bösartigen Bluterkrankungen im Erwachsenenalter.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <item_1671372307389
                                    cq:panelTitle="Myelofibrose (MF) "
                                    cq:styleIds="[1659545825678]"
                                    jcr:lastModified="{Date}2024-05-31T12:38:37.944-04:00"
                                    jcr:lastModifiedBy="singarx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>MF ist eine seltene Erkrankung, bei der sich abnormale Blutzellen und fibröses Gewebe im Knochenmark ansammeln.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                            </accordion_copy_copy>
