                                jcr:lastModifiedBy="HERZOBW"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Wir sind auf einige komplexe Augenerkrankungen spezialisiert:&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <accordion
                                cq:styleIds="[1,7]"
                                jcr:created="{Date}2024-06-01T06:41:48.275-04:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2024-07-17T09:42:26.027-04:00"
                                jcr:lastModifiedBy="HERZOBW"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/accordion/v2/accordion"
                                heading="Schwerpunkte in der Augenheilkunde"
                                singleExpansion="false">
                                <item_1717238555763
                                    cq:panelTitle="Chronisches trockenes Auge "
                                    cq:styleIds="[1659545825678]"
                                    jcr:lastModified="{Date}2024-06-01T06:52:26.153-04:00"
                                    jcr:lastModifiedBy="singarx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Eine chronische Erkrankung, die durch fortgeschrittenes Alter, das Tragen von Kontaktlinsen, bestimmte Medikamente, Augenerkrankungen, andere Erkrankungen oder Umweltfaktoren verursacht werden kann.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <item_1717238562854
                                    cq:panelTitle="Glaukom "
                                    cq:styleIds="[1659545825678]"
                                    jcr:lastModified="{Date}2024-06-01T06:53:03.728-04:00"
                                    jcr:lastModifiedBy="singarx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p> Der Begriff bezeichnet eine Gruppe von Augenerkrankungen (viele verschiedene Arten), die Schädigungen des Sehnervs verursachen, in der Regel mit hohem Augeninnendruck einhergehen und zur Erblindung führen können.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <item_1717238567731
                                    cq:panelTitle=" Altersbedingte Erkrankungen der Netzhaut "
                                    cq:styleIds="[1659545825678]"
                                    jcr:lastModified="{Date}2024-06-01T06:53:51.611-04:00"
                                    jcr:lastModifiedBy="singarx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Eine Schädigung der Makula im Zentrum der Netzhaut beeinträchtigt das zentrale Sehen und die Fähigkeit, Details zu erkennen. Die altersbedingte Makuladegeneration ist die häufigste Ursache für einen erheblichen Verlust der Sehkraft bei Menschen ab 60 Jahren.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <item_1717238629878
                                    cq:panelTitle="Refraktionsfehler  "
                                    cq:styleIds="[1659545825678]"
                                    jcr:lastModified="{Date}2024-06-01T06:55:18.869-04:00"
                                    jcr:lastModifiedBy="singarx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Sehstörungen, bei denen ein klares Sehen aufgrund der Form des Auges erschwert ist, da einfallende Lichtstrahlen nicht scharf auf der Netzhaut abgebildet werden können. Einige häufige Refraktionsfehler können das Nahsehvermögen von Erwachsenen mittleren Alters und älteren Menschen beeinträchtigen.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
