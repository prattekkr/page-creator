                                jcr:primaryType="nt:unstructured"
                                jcr:title="SCHWERPUNKTE IN DER NEUROLOGIE UND BEI PSYCHISCHEN ERKRANKUNGEN"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h3"
                                variant="h"/>
                            <text2
                                cq:styleIds="[1659545825678,1659545835858]"
                                jcr:lastModified="{Date}2024-06-01T03:28:54.806-04:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Neurologische und psychische Erkrankungen können das Leben sehr belasten. Auf Basis innovativer Forschung werden deshalb Möglichkeiten untersucht, den Versorgungsstandard und die Lebensqualität zu verbessern.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <accordion_copy_copy
                                cq:styleIds="[1,1653545835881]"
                                jcr:created="{Date}2022-12-17T16:25:09.442-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2024-08-28T07:33:11.673-04:00"
                                jcr:lastModifiedBy="HERZOBW"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/accordion/v2/accordion"
                                heading="Schwerpunktbereiche in der Neurologie und bei psychischen Erkrankungen"
                                headingElement="h5"
                                singleExpansion="false">
                                <item_1671312472873
                                    cq:panelTitle="Morbus Parkinson"
                                    cq:styleIds="[1659545825678]"
                                    jcr:lastModified="{Date}2024-09-17T01:31:30.302-04:00"
                                    jcr:lastModifiedBy="HERZOBW"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Weltweit sind fast 10 Millionen Menschen von Morbus Parkinson betroffen.Die Erkrankung verursacht unter anderem Muskelsteifigkeit, Tremor und den Verlust kognitiver Funktionen bei den Betroffenen.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <item_1671312475801
                                    cq:panelTitle="Migräne"
                                    cq:styleIds="[1659545825678]"
                                    jcr:lastModified="{Date}2024-08-14T02:11:54.787-04:00"
                                    jcr:lastModifiedBy="HERZOBW"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Es ist mehr als nur ein Kopfschmerz. Migräne betrifft 1 Milliarde Menschen auf der ganzen Welt und ist eine neurologische Erkrankung, die Schmerzen verursacht und das Leben von Betroffenen stark beeinflusst.&amp;nbsp;&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <item_1671312481387
                                    cq:panelTitle="Bewegungsstörungen"
                                    cq:styleIds="[1659545825678]"
                                    jcr:lastModified="{Date}2024-06-01T03:39:21.604-04:00"
                                    jcr:lastModifiedBy="singarx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p> Bewegungsstörungen sind chronische und progressiv verlaufende neurologische Erkrankungen, die die Fähigkeit des Körpers, Bewegungen zu kontrollieren, beeinträchtigen.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <item_1671372277563
                                    cq:panelTitle=" Psychische Erkrankungen "
                                    cq:styleIds="[1659545825678]"
                                    jcr:lastModified="{Date}2024-06-01T03:39:47.922-04:00"
                                    jcr:lastModifiedBy="singarx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Weltweit sind Millionen von Menschen von psychischen Erkrankungen betroffen, deshalb erforschen wir psychische Erkrankungen wie Depressionen, Angststörungen, bipolare Störungen und Schizophrenie.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <item_1671372296338
                                    cq:panelTitle="Alzheimer"
                                    cq:styleIds="[1659545825678]"
                                    jcr:lastModified="{Date}2024-06-01T03:40:27.901-04:00"
                                    jcr:lastModifiedBy="singarx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Laut der Alzheimer’s Association wird sich die Anzahl der älteren Menschen mit Alzheimer-Demenz bis 2050 mehr als verdreifachen. Bei von Alzheimer Betroffenen verändern sich Gedächtnis, Sprache und die Fähigkeit, Tätigkeiten wie Kochen oder Autofahren auszuführen.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
