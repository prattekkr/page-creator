                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;sup>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-26-reg&quot;>Wissenschaft und Innovation sind der Motor von AbbVie.&amp;nbsp;Sie ermöglichen uns, Therapien und Lösungen zu entwickeln, die einen bedeutenden Unterschied im Leben von Patient:innen machen.&lt;/span>&lt;/span>&lt;/sup>&lt;/p>&#xd;&#xa;"
