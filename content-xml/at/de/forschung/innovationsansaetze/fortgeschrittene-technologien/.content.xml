                                    jcr:title="Wissenschaft mit Spitzentechnologie verbinden "
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h2"
                                    variant="h"/>
                                <text_copy_copy
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2022-12-07T14:53:09.069-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2024-09-17T01:38:44.405-04:00"
                                    jcr:lastModifiedBy="HERZOBW"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Unsere bahnbrechenden Technologien kommen im gesamten F&amp;amp;E-Bereich zum Einsatz, von der frühen experimentellen Arbeit über das Verständnis der Krankheitswege und die unternehmensinterne Entdeckung neuer Substanzen bis hin zur Weiterentwicklung von klinischen Programmen in der späten Entwicklungsphase.&lt;br>&#xd;&#xa;&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <separator
