                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Unsere wissenschaftlichen Teams setzen auf patientenzentrierte Ansätze, um neue Therapien für Erkrankungen zu entwickeln. Die patientenorientierte Arzneimittelentwicklung bindet die Erfahrungen, Perspektiven und Bedürfnisse von Patient:innen im Entwicklungsprozess auf unterschiedlichen Wegen mit ein.&lt;br>&#xd;&#xa;&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
