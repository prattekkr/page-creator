                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="Partnerschaften "
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h3"
                                    variant="h"/>
                                <text_copy_copy
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2022-12-07T14:53:09.069-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2024-08-22T08:49:36.172-04:00"
                                    jcr:lastModifiedBy="HERZOBW"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Individuelle Erfahrungen, Perspektiven, Bedürfnisse und Prioritäten sind ein Teil des klinischen Entwicklungsprozesses. Deshalb ist uns die Zusammenarbeit mit Patient:innen, Patientenorganisationen, Pflegekräften und Ärzt:innen sehr wichtig. Die patientenorientierte Ergebnisforschung (patient-centered outcomes research, PCOR) basiert auf Kooperationen mit wichtigen Expert:innen im Gesundheitswesen, um zielgerichtete Strategien und Lösungen zu finden.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <separator_copy_141616301
                                    cq:styleIds="[1662756486159]"
                                    jcr:created="{Date}2022-12-17T12:18:10.519-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2022-12-17T12:18:10.519-05:00"
                                    jcr:lastModifiedBy="chiucx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                                <title_copy
                                    cq:styleIds="[1659545825678,1651545825693]"
                                    jcr:created="{Date}2022-12-17T13:22:39.555-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2024-08-08T03:36:23.627-04:00"
                                    jcr:lastModifiedBy="HERZOBW"
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title=" Diversifizierung klinischer Studien  "
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h3"
                                    variant="h"/>
                                <text_copy_copy_copy
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2022-12-07T14:53:09.069-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2024-08-22T08:50:04.781-04:00"
                                    jcr:lastModifiedBy="HERZOBW"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Klinische Studien sollen die Populationen abbilden.&amp;nbsp;Wir arbeiten daran, integrative Studienprotokolle zu entwerfen, unterrepräsentierten Bevölkerungsgruppen die Möglichkeit zu geben, sich freiwillig zu melden, und evaluieren kontinuierlich unsere Zulassungskriterien für klinische Studien anhand realer Datensätze.&amp;nbsp;&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <separator_copy_2096421555
                                    cq:styleIds="[1662756486159]"
                                    jcr:created="{Date}2022-12-17T12:18:10.519-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2022-12-17T12:18:10.519-05:00"
                                    jcr:lastModifiedBy="chiucx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                                <title_copy_copy
                                    cq:styleIds="[1659545825678,1651545825693]"
                                    jcr:created="{Date}2022-12-17T13:22:39.555-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2024-08-08T03:36:31.560-04:00"
                                    jcr:lastModifiedBy="HERZOBW"
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title=" Einbinden der Patientenerfahrung  "
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h3"
                                    variant="h"/>
                                <text_copy_copy_copy_
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2022-12-07T14:53:09.069-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2024-06-03T12:00:40.223-04:00"
                                    jcr:lastModifiedBy="singarx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p> Wir berücksichtigen die Bedürfnisse und Erfahrungen von Patient:innen in unserem klinischen Entwicklungsprozess. Wir setzen uns mit der „Patient Journey“ auseinander: Wir wollen den Weg der Patient:innen – von der Diagnose bis hin zur Behandlung – besser verstehen lernen.&amp;nbsp;&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <separator_copy
                                    cq:styleIds="[1662756486159]"
                                    jcr:created="{Date}2022-12-17T12:18:10.519-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2022-12-17T12:18:10.519-05:00"
                                    jcr:lastModifiedBy="chiucx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                                <title_copy_copy_copy
                                    cq:styleIds="[1659545825678,1651545825693]"
                                    jcr:created="{Date}2022-12-17T13:22:39.555-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2024-08-08T03:36:39.324-04:00"
                                    jcr:lastModifiedBy="HERZOBW"
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="Ausbau digitaler Gesundheitstechnologien "
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h3"
                                    variant="h"/>
                                <text_copy_copy_copy__403879328
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2022-12-07T14:53:09.069-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2024-08-14T01:54:38.801-04:00"
                                    jcr:lastModifiedBy="HERZOBW"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Wir verwenden digitale Gesundheitstechnologien – von tragbaren Geräten bis hin zu Gaming-Plattformen – , mit denen Krankheitssymptome und Behandlungsergebnisse erfasst werden können. Zudem werden neue Tools zur Entwicklung objektiver und sensitiver digitaler Biomarker eingesetzt. Diese unterstützen eine schnellere Identifizierung von Patient:innen, die auf eine Behandlung ansprechen, sowie eine präzisere klinische Beurteilung. Ebenso erfassen wir auch Real-World-Ergebnisse mittels Sensorik-Messungen. So können wir beispielsweise bei rheumatischen Erkrankungen die Verbesserungen der Gelenkfunktion, der körperlichen Aktivität und des Schlafs erfassen.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <separator
                                    cq:styleIds="[1662756486159]"
                                    jcr:created="{Date}2022-12-17T12:18:10.519-05:00"
                                    jcr:createdBy="chiucx"
