                                    jcr:lastModifiedBy="chiucx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                                <title_copy_copy_copy_497179
                                    cq:styleIds="[1659545825678,1651545825693]"
                                    jcr:created="{Date}2022-12-17T13:22:39.555-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2024-08-08T03:36:47.510-04:00"
                                    jcr:lastModifiedBy="HERZOBW"
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="Beweise aus der realen Welt  (RWE)"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h3"
                                    variant="h"/>
                                <text_copy_copy_copy__1354420930
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2022-12-07T14:53:09.069-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2024-08-14T01:54:50.892-04:00"
                                    jcr:lastModifiedBy="HERZOBW"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Real World Evidence (RWE) liefert Erkenntnisse über die Wirksamkeit von Behandlungen im klinischen Versorgungsalltag und ergänzt damit die Ergebnisse randomisierter klinischer Studien. Die RWE-Daten unterstützen uns dabei, Krankheitslast, Behandlungsmuster, Patientenverhalten sowie die Behandlungsleistung besser zu verstehen.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                            </container_568753235_>
