                                    jcr:lastModifiedBy="singarx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Präzisionsmedizin hat die Diagnose und Behandlung von Krebserkrankungen revolutioniert. Wir nutzen die Prinzipien der Präzisionsmedizin zur gezielten Bekämpfung von Erkrankungen in den Bereichen Immunologie, Onkologie, Neurowissenschaften und Augenheilkunde.&lt;/p>&#xd;&#xa;"
