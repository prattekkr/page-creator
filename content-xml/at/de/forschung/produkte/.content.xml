                                        jcr:lastModifiedBy="HERZOBW"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="abbvie-com2/components/text/v2/text"
                                        text="&lt;p>DUODOPA® Gel zur intestinalen Anwendung (Levodopa/Carbidopa)&lt;/p>&#xd;&#xa;&lt;p>HUMIRA® Injektionslösung (Adalimumab)&lt;/p>&#xd;&#xa;&lt;p>KALETRA® Lösung zum Einnehmen (Lopinavir/Ritonavir)&lt;/p>&#xd;&#xa;&lt;p>KALETRA® Filmtabletten (Lopinavir/Ritonavir)&lt;/p>&#xd;&#xa;&lt;p>MAVIRET® Filmtabletten (Glecaprevir/Pibrentasvir)&lt;/p>&#xd;&#xa;&lt;p>NORVIR® Filmtabletten (Ritonavir)&lt;/p>&#xd;&#xa;&lt;p>PRODUODOPA® Infusionslösung (FOSLEVODOPA/FOSCARBIDOPA)&lt;/p>&#xd;&#xa;&lt;p>RINVOQ® Retardtabletten (Upadacitinib)&lt;/p>&#xd;&#xa;&lt;p>SEVORANE® Inhalationsnarkotikum (Sevofluran)&lt;/p>&#xd;&#xa;&lt;p>SKYRIZI® Injektionslösung (Risankizumab)&lt;/p>&#xd;&#xa;&lt;p>TEPKINLY® Injektionslösung (EPCORITAMAB)&lt;/p>&#xd;&#xa;&lt;p>VENCLYXTO® Filmtabletten (Venetoclax)&lt;/p>&#xd;&#xa;&lt;p>ZEMPLAR® Injektionslösung (Paricalcitol)&lt;/p>&#xd;&#xa;"
                                        textIsRich="true"/>
                                    <item_1717564499030
                                        cq:panelTitle="Allergan"
                                        jcr:lastModified="{Date}2024-08-02T07:19:43.213-04:00"
                                        jcr:lastModifiedBy="HERZOBW"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="abbvie-com2/components/text/v2/text"
                                        text="&lt;p>Seit Mai 2020 ist Allergan Teil von AbbVie und im Zuge der Integration kamen folgende Produkte zum Portfolio von AbbVie hinzu:&lt;br>&#xd;&#xa;&lt;br>&#xd;&#xa;&lt;/p>&#xd;&#xa;&lt;p>ACULAR® Augentropfen (Ketorolac-Trometamol)&lt;/p>&#xd;&#xa;&lt;p>ALPHAGAN® Augentropfen (Brimonidintartrat)&lt;/p>&#xd;&#xa;&lt;p>BOTOX® Injektionslösung (Clostridium botulinum Toxin Typ A)&lt;/p>&#xd;&#xa;&lt;p>CELLUFRESH® Augentropfen (Natriumcarboxymethylcellulose)&lt;/p>&#xd;&#xa;&lt;p>CELLUMED® Augentropfen (Natriumcarboxymethylcellulose)&lt;/p>&#xd;&#xa;&lt;p>COMBIGAN® Augentropfen (Brimonidintartrat/Timolol)&lt;/p>&#xd;&#xa;&lt;p>CONSTELLA® Hartkapseln (Linaclotid)&lt;/p>&#xd;&#xa;&lt;p>GANFORT® Augentropfen (Bimatoprost/Timolol)&lt;/p>&#xd;&#xa;&lt;p>LUMIGAN® Augentropfen (Bimatoprost)&lt;/p>&#xd;&#xa;&lt;p>OPTIVE® Augentropfen (Natriumcarboxymethylcellulose/Glycerol/Levocarnitin/Erythritol)&lt;/p>&#xd;&#xa;&lt;p>OPTIVE® FUSION Augentropfen (Natriumhyaluronat/Natriumcarboxymethylcellulose/Glycerol/Erythritol)&lt;/p>&#xd;&#xa;&lt;p>OPTIVE® PLUS Augentropfen (Natriumcarboxymethylcellulose/Glycerol/Rizinusöl/Polysorbat 80/Levocarnitin/Erythritol)&lt;/p>&#xd;&#xa;&lt;p>OZURDEX® intravitreales Implantat in einem Applikator (Dexamethason)&lt;/p>&#xd;&#xa;&lt;p>PYLERA® Hartkapseln (Bismutsubcitratkalium/Metronidazol/Tetracyclinhydrochlorid)&lt;/p>&#xd;&#xa;&lt;p>RELESTAT® Augentropfen (Epinastinhydrochlorid)&lt;/p>&#xd;&#xa;&lt;p>VISTAGAN® Augentropfen (Levobunololhydrochlorid)&lt;/p>&#xd;&#xa;&lt;p>XEN® Glaukom-Gelimplantat&lt;/p>&#xd;&#xa;&lt;p>Zur Produktübersicht von Allergan Aesthetics:&amp;nbsp; &lt;a href=&quot;https://www.allerganaesthetics.at/&quot;>https://www.allerganaesthetics.at/&lt;/a>&lt;/p>&#xd;&#xa;"
