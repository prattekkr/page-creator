                                type="h1"
                                variant="h"/>
                            <text_1119159122
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2024-09-09T14:30:10.584-04:00"
                                jcr:createdBy="jewitca"
                                jcr:lastModified="{Date}2024-09-09T14:30:32.720-04:00"
                                jcr:lastModifiedBy="jewitca"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>Wir sind davon überzeugt, dass der Austausch mit Expert:innen aus dem Gesundheitsbereich einen Mehrwert für die Patient:innenversorgung bringt.&amp;nbsp;&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_783068191
                                cq:styleIds="[1662756423318]"
                                jcr:created="{Date}2024-10-16T04:59:46.520-04:00"
                                jcr:createdBy="klavimx"
                                jcr:lastModified="{Date}2024-10-16T04:59:46.520-04:00"
                                jcr:lastModifiedBy="klavimx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <text_copy_copy_copy_
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2022-11-07T18:20:48.523-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2024-09-24T09:25:19.314-04:00"
                                jcr:lastModifiedBy="HERZOBW"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>AbbVie arbeitet mit Angehörigen des Gesundheitswesens, Gesundheitsorganisationen und Patientenorganisationen sowie Selbsthilfegruppen zusammen, um die Gesundheit von Menschen mit Erkrankungen weltweit zu verbessern.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <text_copy_copy_copy__1636057213
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2022-11-07T18:20:48.523-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2024-09-24T09:25:33.403-04:00"
                                jcr:lastModifiedBy="HERZOBW"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;b>Zusammenarbeit für eine bessere Versorgung&lt;/b>&lt;/p>&#xd;&#xa;&lt;p>Für die Erforschung innovativer Medikamente ist AbbVie Österreich auf das Wissen und die Erfahrung derjenigen angewiesen, die sie verschreiben: die Ärzt:innen. Durch die Zusammenarbeit mit ihnen können wir wichtige Informationen zur Anwendung von Medikamenten sammeln und innovative Arzneimittel erforschen und entwickeln. Das hilft uns, die Versorgung von Patient:innen zu verbessern. &lt;/p>&#xd;&#xa;&lt;p>Betroffene, deren Angehörige und Freunde brauchen vielfältige Unterstützung beim Umgang mit schweren und chronischen Erkrankungen. AbbVie arbeitet in Österreich und weltweit eng mit Selbsthilfegruppen und Patientenorganisationen zusammen. Damit wollen wir Menschen helfen, ihre Krankheit zu verstehen und mit ihr umzugehen.&lt;/p>&#xd;&#xa;&lt;p>&lt;b>Offenheit und Transparenz&lt;/b>&lt;br>&#xd;&#xa;&lt;/p>&#xd;&#xa;&lt;p>Unser Austausch mit Expert:innen im Gesundheitsbereich ist von Offenheit und Transparenz geprägt, um Vertrauen in der Öffentlichkeit aufzubauen und Verlässlichkeit zu beweisen. AbbVie unterstützt die Offenlegung dieser Geschäftsbeziehungen, wann immer dies möglich ist, um die Integrität unserer Zusammenarbeit zu demonstrieren.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <text
                                jcr:lastModified="{Date}2024-08-02T04:37:58.841-04:00"
                                jcr:lastModifiedBy="HERZOBW"
                                jcr:primaryType="nt:unstructured"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>Gemeinsam können wir mehr erreichen: Deshalb setzt AbbVie Österreich auf die Zusammenarbeit mit wichtigen Gesundheitsakteuren – nach klaren Regeln und transparent.&lt;/span>&lt;/span>&lt;/p>&#xa;&lt;p>&amp;nbsp;&lt;/p>&#xa;&lt;p>&amp;nbsp;&lt;/p>&#xa;"
                                textIsRich="true"/>
                            <separator
                                cq:styleIds="[1662756423318]"
                                jcr:created="{Date}2024-10-16T04:56:50.980-04:00"
                                jcr:createdBy="klavimx"
