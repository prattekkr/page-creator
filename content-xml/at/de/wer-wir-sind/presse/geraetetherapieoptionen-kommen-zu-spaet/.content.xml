                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="Gerätegestützte Therapie: Zu wenig bekannt, zu selten eingesetzt"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    langAttribute="none"
                                    type="h2"
                                    variant="h">
                                    <cq:responsive jcr:primaryType="nt:unstructured">
                                        <default
                                            jcr:primaryType="nt:unstructured"
                                            behavior="newline"/>
                                    </cq:responsive>
                                </title_copy_copy_copy>
                                <text
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2026-05-26T11:17:32.898-04:00"
                                    jcr:createdBy="singarx"
                                    jcr:lastModified="{Date}2026-07-30T10:14:20.592-04:00"
                                    jcr:lastModifiedBy="klavimx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    langAttribute="none"
                                    text="&lt;p>Während 88 Prozent der Befragten Parkinson-Medikamente in Tablettenform kennen, haben nur 38 Prozent von gerätegestützten Therapien, wie Pumpentherapien unter die Haut oder in den Dünndarm oder eine Tiefe Hirnstimulation, &amp;nbsp;gehört – und nur 20 Prozent haben mit ihrem Arzt oder ihrer Ärztin darüber gesprochen.&amp;nbsp;&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                            </container4_copy>
