                                jcr:lastModified="{Date}2026-05-26T11:15:57.319-04:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/quote"
                                attributionName="Dr.in Michaela Steffelbauer"
                                dmPresetType="imagePreset"
                                quote="Diese Diskrepanz zeigt, dass viele Patient:innen nicht die Therapie erhalten, die sie eigentlich bräuchten"
                                quoteType="regular"
                                textSize="h0"/>
                            <container4_copy
