                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-20-reg&quot;>Wien, 19.&amp;nbsp;November 2024&amp;nbsp;&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
