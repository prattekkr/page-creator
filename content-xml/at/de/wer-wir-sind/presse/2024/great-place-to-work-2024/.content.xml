                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-20-reg&quot;>Wien, 24. Mai 2024&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
