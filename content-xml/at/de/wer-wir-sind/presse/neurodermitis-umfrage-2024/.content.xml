                                jcr:title="Ergebnisse aus einer österreichweiten Neurodermitis-Umfrage: Etwa jede/r Zweite ist belastet und schlaflos"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                langAttribute="none"
