                                    jcr:lastModifiedBy="klavimx"
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="Remission bringt auch ökonomische Vorteile"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    langAttribute="none"
                                    type="h2"
                                    variant="h">
                                    <cq:responsive jcr:primaryType="nt:unstructured">
                                        <default
                                            jcr:primaryType="nt:unstructured"
                                            behavior="newline"/>
                                    </cq:responsive>
                                </title_copy_copy_copy_1475170511>
                                <text2_copy_1277187931
                                    cq:styleIds="[1659545825678,1659545835858]"
                                    jcr:lastModified="{Date}2026-07-31T04:23:12.286-04:00"
                                    jcr:lastModifiedBy="klavimx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    langAttribute="none"
                                    text="&lt;p>Corinna Elling-Audersch verweist auf internationale Studien, die zeigen: Remission steigert die Arbeitsproduktivität um bis zu 75 Prozent und senkt Gesundheitskosten um bis zu 52 Prozent (6). Frühzeitige Diagnose, standardisierte Behandlungspfade und patientenzentrierte Versorgung sind daher nicht nur medizinisch, sondern auch volkswirtschaftlich entscheidend.&lt;br>&#xd;&#xa;&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <separator_copy_copy_830515665
                                    cq:styleIds="[1662756409908]"
                                    jcr:created="{Date}2026-07-31T04:24:35.438-04:00"
                                    jcr:createdBy="klavimx"
                                    jcr:lastModified="{Date}2026-07-31T04:24:35.438-04:00"
