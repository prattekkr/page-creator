                                    jcr:title="Mit der passenden Therapie wertvolle Lebensjahre nutzen"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    langAttribute="none"
                                    type="h2"
                                    variant="h">
                                    <cq:responsive jcr:primaryType="nt:unstructured">
                                        <default
