                                    jcr:title="Therapie im fortgeschrittenen Stadium nicht ausreichend verbreitet"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    langAttribute="none"
                                    type="h2"
                                    variant="h">
                                    <cq:responsive jcr:primaryType="nt:unstructured">
