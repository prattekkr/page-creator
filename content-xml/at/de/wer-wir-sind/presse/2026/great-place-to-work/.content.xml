                                fileReference="/content/dam/abbvie-com2/at/images/who-we-are/presse/2026/_260521KatharinaSchiffl-1235.jpg"/>
                            <text_888848836_copy_
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2024-08-05T08:07:35.401-04:00"
                                jcr:createdBy="HERZOBW"
                                jcr:lastModified="{Date}2026-05-22T04:37:43.848-04:00"
                                jcr:lastModifiedBy="klavimx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                langAttribute="none"
                                text="&lt;p>&lt;span class=&quot;body-unica-14-reg&quot;>Fotorechte: ©&amp;nbsp;Katharina Schiffl&amp;nbsp;&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <text_888848836_copy
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2024-08-05T08:07:35.401-04:00"
                                jcr:createdBy="HERZOBW"
                                jcr:lastModified="{Date}2026-05-26T02:11:53.001-04:00"
                                jcr:lastModifiedBy="klavimx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                langAttribute="none"
                                text="&lt;p>&lt;i>Wenn Mitarbeitende sagen: „Hier arbeite ich wirklich gerne“, dann ist das mehr als ein gutes Gefühl. Es ist ein starkes Zeichen für gelebte Unternehmenskultur, die geprägt ist von Vertrauen in Führungskräfte, Entwicklungsmöglichkeiten, transparenter Kommunikation und guter Zusammenarbeit mit Kolleg:innen unterschiedlichster Abteilungen.&lt;/i>&lt;/p>&#xd;&#xa;&lt;p>&lt;i>Zum elften Mal in Folge wurde das BioPharma Unternehmen AbbVie als Great Place to Work® ausgezeichnet und zählt damit erneut zu den besten Arbeitgebern des Landes. Heuer erreichte das Unternehmen Platz 1.  Zudem wurde AbbVie im März 2026 zum zweiten Mal als einer der Best Workplaces for Women™ ausgezeichnet.&lt;/i>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_copy_copy__152835849
                                cq:styleIds="[1662756409908]"
                                jcr:created="{Date}2024-07-17T16:26:11.261-04:00"
                                jcr:createdBy="washidx10"
                                jcr:lastModified="{Date}2024-07-17T16:26:11.261-04:00"
                                jcr:lastModifiedBy="washidx10"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <text_2009419873_copy_118269070
                                cq:styleIds="[1659545825678,1659545835858,1659545847147]"
                                jcr:created="{Date}2024-08-06T02:03:13.475-04:00"
                                jcr:createdBy="HERZOBW"
                                jcr:lastModified="{Date}2026-05-21T03:44:04.010-04:00"
                                jcr:lastModifiedBy="klavimx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                langAttribute="none"
                                text="&lt;p>&lt;span class=&quot;body-unica-26-reg&quot;>&lt;b>Kultur ist Haltung und wesentlicher Bestandteil des Erfolgs&lt;/b>&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <text_2009419873_copy
                                cq:styleIds="[1659545825678,1659545835858,1659545847147]"
                                jcr:created="{Date}2024-08-06T02:03:13.475-04:00"
                                jcr:createdBy="HERZOBW"
                                jcr:lastModified="{Date}2026-05-21T03:44:20.628-04:00"
                                jcr:lastModifiedBy="klavimx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                langAttribute="none"
                                text="&lt;p>Die Auszeichnung ist für AbbVie nicht nur ein Ergebnis, sondern Ausdruck einer klaren Haltung: Dabei ist wichtig, dass jede:r Mitarbeitende die Unternehmensstrategie versteht und weiß, welchen Beitrag sie oder er zum Erfolg des Unternehmens leistet. Um die ambitionierten Ziele zu erreichen, braucht jede Person im AbbVie-Team unternehmerisches Denken, Exzellenz in der Teamarbeit, Feedback, um zu lernen und die Bereitschaft, sich laufend an neue Gegebenheiten anzupassen. Denn die Gesundheitsbranche ist dynamisch und darauf muss sich AbbVie auch in seinen internen Strukturen und Abläufen einstellen. Gemeinsam wachsen, voneinander lernen und einander stärken, um den Herausforderungen der Zukunft aktiv zu begegnen ist somit wichtig.&amp;nbsp;&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <text_2009419873_copy_1146097182
                                cq:styleIds="[1659545825678,1659545835858,1659545847147]"
                                jcr:created="{Date}2024-08-06T02:03:13.475-04:00"
                                jcr:createdBy="HERZOBW"
                                jcr:lastModified="{Date}2026-05-21T03:44:38.405-04:00"
                                jcr:lastModifiedBy="klavimx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                langAttribute="none"
                                text="&lt;p>Besonders deutlich wird das in den Rückmeldungen des AbbVie-Teams:&amp;nbsp;&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <text_2009419873_copy_1233607656
                                cq:styleIds="[1659545825678,1659545835858,1659545847147]"
                                jcr:created="{Date}2024-08-06T02:03:13.475-04:00"
                                jcr:createdBy="HERZOBW"
                                jcr:lastModified="{Date}2026-05-21T03:44:52.761-04:00"
                                jcr:lastModifiedBy="klavimx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                langAttribute="none"
                                text="&lt;ul>&#xd;&#xa;&lt;li>96 % sagen, dass Menschen sich im Unternehmen schnell an die Veränderungen anpassen, die für den Erfolg der Organisation notwendig sind.&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;li>99 % kommen gerne zur Arbeit – ein Wert, der deutlich über dem Benchmark von 90 % liegt.&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;li>96 % sind stolz bei AbbVie zu arbeiten und würden die Extrameile gehen, um ihre Arbeit zu erledigen.&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;li>97 % sagen, dass man auf die gute Zusammenarbeit der Kolleg:innen zählen darf.&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_copy_copy__499758888
                                cq:styleIds="[1662756409908]"
                                jcr:created="{Date}2024-07-17T16:26:11.261-04:00"
                                jcr:createdBy="washidx10"
                                jcr:lastModified="{Date}2024-07-17T16:26:11.261-04:00"
                                jcr:lastModifiedBy="washidx10"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <quote_copy
                                cq:styleIds="[1000000000033,1000000000000,1000000000033]"
                                jcr:created="{Date}2026-03-30T03:32:05.236-04:00"
                                jcr:createdBy="klavimx"
                                jcr:lastModified="{Date}2026-05-26T02:12:07.594-04:00"
                                jcr:lastModifiedBy="klavimx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/quote"
                                attributionName="Mag. Ute Van Goethem "
                                attributionTitle="Geschäftsführerin von AbbVie in Österreich"
                                dmPresetType="imagePreset"
                                quote="Wer bei AbbVie arbeitet soll nicht nur einen Job mit einer spannenden Aufgabe sondern auch Perspektive finden. Für uns ist diese Auszeichnung ein gemeinsamer Erfolg, der nur durch den exzellenten Beitrag jeder einzelnen Person und durch das beständige gemeinsame Arbeiten an unserer Unternehmenskultur möglich ist"
                                quoteType="regular"
                                textSize="h0"/>
                            <text_2009419873_copy_534139127
                                cq:styleIds="[1659545825678,1659545835858,1659545847147]"
                                jcr:created="{Date}2024-08-06T02:03:13.475-04:00"
                                jcr:createdBy="HERZOBW"
                                jcr:lastModified="{Date}2026-05-26T02:12:15.165-04:00"
                                jcr:lastModifiedBy="klavimx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                langAttribute="none"
                                text="&lt;p>„Die Einblicke aus der Mitarbeiter:innenbefragung geben uns wertvolle Informationen darüber, was bereits gut funktioniert und in welchen Bereichen wir uns noch verbessern können. Unsere ‘AbbVie Ways We Work’ sind seit Tag eins fest in der Unternehmensstrategie verankert und motivieren uns, weiterhin ein Arbeitsumfeld zu schaffen, in dem Menschen ihr volles Potenzial entfalten können“, ergänzt Ute Van Goethem.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_copy_copy__950906742
                                cq:styleIds="[1662756409908]"
                                jcr:created="{Date}2024-07-17T16:26:11.261-04:00"
