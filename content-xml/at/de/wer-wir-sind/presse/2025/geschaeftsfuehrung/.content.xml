                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <text_28549643_copy_c_1088402550
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2024-08-05T08:26:12.399-04:00"
                                jcr:createdBy="HERZOBW"
                                jcr:lastModified="{Date}2025-11-06T12:13:24.295-05:00"
                                jcr:lastModifiedBy="klavimx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;i>Mag. Ute Van Goethem wird zur Geschäftsführerin von AbbVie in Österreich ernannt. Sie folgt auf Mag. Ingo Raimon, der sich mit 31. März nach über 35 Jahren in den wohlverdienten Ruhestand verabschiedet.&lt;/i>&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <image
                                jcr:created="{Date}2025-11-06T11:49:26.661-05:00"
                                jcr:createdBy="klavimx"
                                jcr:lastModified="{Date}2025-11-06T12:15:35.665-05:00"
