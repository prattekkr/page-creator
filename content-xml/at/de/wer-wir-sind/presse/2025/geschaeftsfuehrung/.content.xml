                                fileReference="/content/dam/abbvie-com2/at/images/who-we-are/presse/2025/250117-AV-LinkedIn-Collage-Portraits-1200x625px.jpg"/>
                            <separator_copy_copy__499758888
                                cq:styleIds="[1662756409908]"
                                jcr:created="{Date}2024-07-17T16:26:11.261-04:00"
                                jcr:createdBy="washidx10"
                                jcr:lastModified="{Date}2024-07-17T16:26:11.261-04:00"
                                jcr:lastModifiedBy="washidx10"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <text_2009419873_copy_1146097182
                                cq:styleIds="[1659545825678,1659545835858,1659545847147]"
                                jcr:created="{Date}2024-08-06T02:03:13.475-04:00"
                                jcr:createdBy="HERZOBW"
                                jcr:lastModified="{Date}2025-11-06T12:14:15.764-05:00"
                                jcr:lastModifiedBy="klavimx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Mag. Ute Van Goethem stieß 2020 als Business Unit Director Hematology/Oncology zu AbbVie in Deutschland und verantwortet seit 2023 als Commercial Director Oncology den gesamten Bereich in Europa. Vor AbbVie war Mag. Ute Van Goethem Country Head bei Mundipharma Österreich.&amp;nbsp;Die erfahrene Managerin begann 2003 nach abgeschlossenem Wirtschaftsstudium in Innsbruck&amp;nbsp;ihre erfolgreiche Karriere in der Pharmabranche. Die gebürtige Oberösterreicherin freut sich, im&amp;nbsp;Rahmen ihrer Rolle als General Managerin erneut in Österreich den Pharmabereich mitgestalten&amp;nbsp;zu können.&lt;/p>&#xd;&#xa;&lt;p>„Gemeinsam mit dem erfahrenen Leadership-Team und allen Mitarbeitenden von AbbVie&amp;nbsp;Österreich setze ich mich dafür ein, die Lebensqualität von Menschen mit vor allem chronischen&amp;nbsp;Erkrankungen entscheidend zu verbessern, indem sie Zugang zu den innovativen Produkten von&amp;nbsp;AbbVie erhalten. Ich freue mich auf meine Rückkehr nach Österreich, denn ich kenne den&amp;nbsp;Gesundheitsmarkt und viele Entscheidungsträger:innen aus meiner früheren Tätigkeit. Die&amp;nbsp;Erfahrungen aus meinen internationalen Funktionen helfen mir, Entwicklungen im europäischen&amp;nbsp;Kontext zu verstehen und bestmöglich für Österreich zu gestalten“, erklärt Mag. Ute Van Goethem.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_copy_copy_
                                cq:styleIds="[1662756409908]"
                                jcr:created="{Date}2024-07-17T16:26:11.261-04:00"
                                jcr:createdBy="washidx10"
                                jcr:lastModified="{Date}2024-07-17T16:26:11.261-04:00"
                                jcr:lastModifiedBy="washidx10"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <title_312172211_copy_2021108320
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2025-11-06T10:32:05.730-05:00"
                                jcr:createdBy="klavimx"
                                jcr:lastModified="{Date}2025-11-06T12:14:28.001-05:00"
                                jcr:lastModifiedBy="klavimx"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="Ein versierter Kenner der Branche geht in den wohlverdienten Ruhestand"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h5"
                                variant="h"/>
                            <text_2009419873_copy_534227989
                                cq:styleIds="[1659545825678,1659545835858,1659545847147]"
                                jcr:created="{Date}2024-08-06T02:03:13.475-04:00"
                                jcr:createdBy="HERZOBW"
                                jcr:lastModified="{Date}2025-11-06T12:14:59.311-05:00"
                                jcr:lastModifiedBy="klavimx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Mag. Ingo Raimon, Jurist, begann seine Karriere 1989 bei Abbott und war dort über 20 Jahre in&amp;nbsp;unterschiedlichen Funktionen und Ländern tätig – davon in den letzten 12 Jahren als General&amp;nbsp;Manager in Österreich. Mit Jänner 2013 übernahm Ingo Raimon die Geschäftsführung des&amp;nbsp;biopharmazeutischen Unternehmens AbbVie, das nach der Trennung von Abbott die&amp;nbsp;forschungsbasierten pharmazeutischen Leistungen bündelt. Er setzte sich über Jahrzehnte hinweg für die Interessen der Pharmaindustrie ein und war einer der Gründer des FOPI - Forums der&amp;nbsp;forschenden pharmazeutischen Industrie in Österreich. Er wurde im Mai 2023 zum Präsidenten der PHARMIG gewählt, deren Vorstandsmitglied er bereits seit 2013 war. In der Zeit von Jänner 2013&amp;nbsp;bis Dezember 2016 und von November 2017 bis November 2020 war Ingo Raimon Präsident des&amp;nbsp;FOPI. „Die letzten 12 Jahre waren eine spannende Reise. Es ging darum, AbbVie als&amp;nbsp;Unternehmen zum Erfolg zu führen und es auf dem heimischen Markt zu etablieren. Ute Van&amp;nbsp;Goethem blickt auf langjährige Erfahrung in der Branche und verfügt über hervorragendes Wissen über das österreichische Gesundheitswesen. Ich bin überzeugt, dass das gesamte Team bei ihr in den besten Händen ist und freue mich auf meinen neuen Lebensabschnitt. Auch in diesem&amp;nbsp;Abschnitt wird das Thema Gesundheit weiterhin eine Rolle spielen, denn gerne unterstütze ich pro bono bzw. im Ehrenamt Initiativen im Gesundheitswesen für eine gute Versorgung der&amp;nbsp;Patient:innen“, sagt Ingo Raimon.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
