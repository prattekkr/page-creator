                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;ul>&#xd;&#xa;&lt;li>&lt;span class=&quot;body-unica-20-reg&quot;>&lt;b>Mag. Ute Van Goethem übernimmt die Position der Geschäftsführerin von AbbVie in Österreich&amp;nbsp;&lt;/b>&lt;/span>&lt;/li>&#xd;&#xa;&lt;li>&lt;span class=&quot;body-unica-20-reg&quot;>&lt;b>Mag. Ingo Raimon, General Manager, verabschiedet sich nach über 35 Jahren in den wohlverdienten Ruhestand&lt;/b>&lt;/span>&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_copy_copy__152835849
                                cq:styleIds="[1662756409908]"
                                jcr:created="{Date}2024-07-17T16:26:11.261-04:00"
