                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;ul>&#xd;&#xa;&lt;li>&lt;span class=&quot;body-unica-26-reg&quot;>&lt;b>Bestes Pharma-Unternehmen im gesamten Ranking&lt;/b>&lt;/span>&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;"
