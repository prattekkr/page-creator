                                jcr:title="Vortrag: „Leben mit Parkinson – Perspektiven &amp; Möglichkeiten“"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h1"
                                variant="h"/>
                            <text_28549643_copy_c
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2024-08-05T08:26:12.399-04:00"
                                jcr:createdBy="HERZOBW"
                                jcr:lastModified="{Date}2025-11-06T12:35:36.200-05:00"
                                jcr:lastModifiedBy="klavimx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;i>Die weltweit am schnellsten wachsende neurologische Erkrankung stellt Patient:innen und deren Angehörige vor große Herausforderungen: Morbus Parkinson. In Österreich sind aktuell 20.000 bis 30.000 Menschen betroffen. Vor allem zu Beginn der Erkrankung ist eine gute Symptomkontrolle mittels oraler Medikamente möglich. Da Parkinson eine fortschreitende Erkrankung ist, kann im Verlauf der Erkrankung immer wieder eine Anpassung der Therapie erforderlich werden. Zahlreiche Parkinson Patientinnen und Patienten sind jedoch nicht ausreichend über die weiteren Therapiemöglichkeiten informiert und darunter kann die Lebensqualität der Betroffenen leiden. Die Symptome entwickeln sich meist langsam und können von Person zu Person variieren.&lt;/i>&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_copy_copy__152835849
                                cq:styleIds="[1662756409908]"
                                jcr:created="{Date}2024-07-17T16:26:11.261-04:00"
                                jcr:createdBy="washidx10"
                                jcr:lastModified="{Date}2024-07-17T16:26:11.261-04:00"
                                jcr:lastModifiedBy="washidx10"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <title_312172211_copy
