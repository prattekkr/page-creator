                                jcr:primaryType="nt:unstructured"
                                jcr:title="Therapie im fortgeschrittenen Stadium nicht ausreichend verbreitet"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h5"
                                variant="h"/>
                            <text_2009419873_copy
                                cq:styleIds="[1659545825678,1659545835858,1659545847147]"
                                jcr:created="{Date}2024-08-06T02:03:13.475-04:00"
                                jcr:createdBy="HERZOBW"
                                jcr:lastModified="{Date}2025-11-06T12:40:19.700-05:00"
                                jcr:lastModifiedBy="klavimx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Laut einer Umfrage des Meinungsforschungsinstituts Integral im Jahr 2022 erhalten nur 19&amp;nbsp;Prozent der Patient:innen mit fortgeschrittenem Morbus Parkinson eine gerätegestützte&amp;nbsp;Therapie. Mangelnde Information ist eine der Hauptursachen dieser Situation.&amp;nbsp;&lt;/p>&#xd;&#xa;&lt;p>Aus diesem Grund informiert Dr. Karoline Ostertag, Oberärztin der Abteilung Neurologie,&amp;nbsp;Klinik Hietzing, am Montag, dem 28. April, ab 19 Uhr (Einlass ab 18:30 Uhr), in ihrem Vortrag &lt;b>„Leben mit Parkinson – Perspektiven und Möglichkeiten“&lt;/b> über Therapien bei der Parkinson- Krankheit.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
