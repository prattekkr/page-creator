                                    langAttribute="none"
                                    text="&lt;p>&lt;span class=&quot;body-unica-14-reg&quot;>&lt;b>Quelle:&amp;nbsp;&lt;/b>&lt;/span>&lt;/p>&#xd;&#xa;&lt;p>&lt;span class=&quot;body-unica-14-reg&quot;>Meinungsforschungsinstitut Integral, Studie 7124 – April bis August 2022, im Auftrag von Abbvie GmbH, Befragung von 230 Patient:innen und 254 Angehörigen.&lt;/span>&lt;/p>&#xd;&#xa;"
