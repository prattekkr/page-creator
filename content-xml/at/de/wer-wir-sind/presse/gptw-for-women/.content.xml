                                    jcr:title="Jahr für Jahr ein ausgezeichneter Arbeitsplatz"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    langAttribute="none"
                                    type="h2"
                                    variant="h">
                                    <cq:responsive jcr:primaryType="nt:unstructured">
                                        <default
                                            jcr:primaryType="nt:unstructured"
                                            behavior="newline"/>
                                    </cq:responsive>
                                </title_copy_copy_copy_570804211>
                                <text2_copy_924715925
                                    cq:styleIds="[1659545825678,1659545835858]"
                                    jcr:lastModified="{Date}2026-07-30T10:29:25.692-04:00"
                                    jcr:lastModifiedBy="klavimx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    langAttribute="none"
                                    text="&lt;p>Dieser Erfolg zeugt davon, dass eine moderne Arbeitshaltung, Flexibilität, Chancengleichheit,&amp;nbsp;Teamarbeit und Familienfreundlichkeit bei AbbVie stets großgeschrieben wurden und werden.&amp;nbsp;Aufgrund dieser und vieler weiterer Ansätze und Ziele, die man im letzten Jahrzehnt verfolgt und&amp;nbsp;umgesetzt hat, erhält AbbVie 2025 erstmals die Auszeichnung „Great Place to Work for Women®“,&amp;nbsp;mit der die zehn österreichischen Unternehmen mit den besten Arbeitsverhältnissen für Frauen gekürt werden.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
