                                    jcr:title="Angebote für unterschiedliche Lebens- und Karrierephasen"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    langAttribute="none"
                                    type="h2"
                                    variant="h">
                                    <cq:responsive jcr:primaryType="nt:unstructured">
