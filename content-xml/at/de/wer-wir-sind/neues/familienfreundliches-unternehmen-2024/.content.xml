                            </container_copy_copy>
                            <quote_copy_748981664
                                cq:styleIds="[1000000000000,1000000000033]"
                                jcr:created="{Date}2024-09-25T05:24:44.580-04:00"
                                jcr:createdBy="HERZOBW"
                                jcr:lastModified="{Date}2025-04-02T11:27:29.333-04:00"
                                jcr:lastModifiedBy="CATEMJX"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/quote"
                                attributionName="Mag. Ulrike Weiss"
                                attributionTitle="Human Resources Director"
                                bgImageModifiers="resMode=sharp2&amp;op_sharpen=1"
                                fileReference="/content/dam/abbvie-com2/at/our-leaders/ulrike-weiss-cropped-head.jpg"
                                imageModifiers="resMode=sharp2&amp;op_sharpen=1"
                                quote="AbbVie schafft für die Mitarbeiter:innen ein bestmögliches Arbeitsumfeld, in dem sich Beruf und Familie gut vereinbaren lässt. Wir bieten Mitarbeiter:innen die Chance, ihre Arbeit zeitlich und örtlich so flexibel wie möglich selbst zu gestalten. Dazu verfügt jeder über Laptop und Smartphone"
                                quoteType="regular"
                                textSize="h0"/>
                            <container_copy_copy_
                                cq:styleIds="[1653545825687,1653545847150,1653242825678,1653545835982]"
                                jcr:created="{Date}2024-10-22T11:23:20.760-04:00"
                                jcr:createdBy="klavimx"
                                jcr:lastModified="{Date}2024-10-22T11:51:12.658-04:00"
                                jcr:lastModifiedBy="klavimx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/container/v2/container">
                                <text2_copy_copy_1033
                                    cq:styleIds="[1659545825678,1659545835858]"
                                    jcr:lastModified="{Date}2024-09-25T04:54:58.970-04:00"
                                    jcr:lastModifiedBy="HERZOBW"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Zudem finden sich optimale Arbeitsbedingungen im Passivbürohaus von AbbVie in Wien-Liesing. Moderne Räumlichkeiten mit viel Glas und Technik sorgen für eine angenehme Arbeitsumgebung, die für die laufende Teamkoordination notwendig ist.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <separator
                                    cq:styleIds="[1662756409908]"
                                    jcr:created="{Date}2024-10-22T11:31:58.497-04:00"
                                    jcr:createdBy="klavimx"
                                    jcr:lastModified="{Date}2024-10-22T11:31:58.497-04:00"
                                    jcr:lastModifiedBy="klavimx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                                <title_copy_copy_copy
                                    cq:styleIds="[1659545825678,1651545825693]"
                                    jcr:created="{Date}2023-05-04T21:35:42.808-04:00"
                                    jcr:createdBy="SCHAFSM"
                                    jcr:lastModified="{Date}2024-10-16T08:30:50.631-04:00"
                                    jcr:lastModifiedBy="klavimx"
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="Papamonat und Väterkarenz immer beliebter"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h2"
                                    variant="noh"/>
                                <text2_copy_530881155
                                    cq:styleIds="[1659545825678,1659545835858]"
                                    jcr:lastModified="{Date}2024-09-25T04:56:01.022-04:00"
                                    jcr:lastModifiedBy="HERZOBW"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Insgesamt hat knapp die Hälfte aller Mitarbeiter:innen bei AbbVie Kinder. AbbVie bietet auch Vätern verschiedene Möglichkeiten, eine Familienauszeit zu nehmen: Der Papamonat bzw. die Väterkarenz wird bereits gerne in Anspruch genommen, um Zeit mit dem Nachwuchs verbringen zu können.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <separator_copy_24705
                                    cq:styleIds="[1662756409908]"
                                    jcr:created="{Date}2024-10-22T11:31:58.497-04:00"
                                    jcr:createdBy="klavimx"
                                    jcr:lastModified="{Date}2024-10-22T11:31:58.497-04:00"
                                    jcr:lastModifiedBy="klavimx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                                <title_copy_copy_copy_178882264
                                    cq:styleIds="[1659545825678,1651545825693]"
                                    jcr:created="{Date}2023-05-04T21:35:42.808-04:00"
                                    jcr:createdBy="SCHAFSM"
                                    jcr:lastModified="{Date}2024-10-14T09:19:33.603-04:00"
                                    jcr:lastModifiedBy="klavimx"
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="Bring your family &amp; friends day"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h2"
                                    variant="h"/>
                                <text2_copy_530881155_1292908428
                                    cq:styleIds="[1659545825678,1659545835858]"
                                    jcr:lastModified="{Date}2024-09-25T04:56:25.288-04:00"
                                    jcr:lastModifiedBy="HERZOBW"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Das BioPharma-Unternehmen mit ca . 180 Mitarbeiter*innen veranstaltet jährlich den „bring your family &amp;amp; friends day“: Familien und Freunde der Mitarbeiter:innen besuchen das Office und erfahren an vielen Stationen &amp;nbsp;Wissenswertes zu unterschiedlichen Themen wie der Forschung. Die jungen Gäste erwartet ein buntes Kinderprogramm. Zudem nahm AbbVie heuer am Töchtertag teil, bei dem jungen Mädchen ein Einblick in das Arbeitsleben ihrer Eltern und in unterschiedliche Berufsfelder bei AbbVie gewährt wird.&amp;nbsp;&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <separator_copy_24705_744209238
                                    cq:styleIds="[1662756409908]"
                                    jcr:created="{Date}2024-10-22T11:31:58.497-04:00"
                                    jcr:createdBy="klavimx"
                                    jcr:lastModified="{Date}2024-10-22T11:31:58.497-04:00"
                                    jcr:lastModifiedBy="klavimx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                                <title_copy_copy_copy_68072735
                                    cq:styleIds="[1659545825678,1651545825693]"
                                    jcr:created="{Date}2023-05-04T21:35:42.808-04:00"
                                    jcr:createdBy="SCHAFSM"
                                    jcr:lastModified="{Date}2024-10-14T09:20:04.109-04:00"
                                    jcr:lastModifiedBy="klavimx"
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="Auszeichnung als „Great Place to Work®“"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h2"
                                    variant="h"/>
                                <text2_copy_530881155_824745902
                                    cq:styleIds="[1659545825678,1659545835858]"
                                    jcr:lastModified="{Date}2024-10-16T08:31:05.762-04:00"
                                    jcr:lastModifiedBy="klavimx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Der Erfolg dieser Maßnahmen zeigt sich in der mittlerweile neunten Auszeichnung: Seit 2016 ist AbbVie durchgehend ein „Great Place to Work®“ und erklimmt im Ranking 2024 der Kategorie „Österreichs Beste Arbeitgeber Medium“ (Unternehmen bis 500 Mitarbeiter) den 2. Platz.&lt;/p>&#xd;&#xa;&lt;p>AbbVie setzt sich weitehrin das Ziel, Mitarbeiter:innen Flexibilität und Wertschätzung entgegenzubringen, ihre Lebensqualität zu verbessern und so eine gute Balance zwischen Beruf und Familie zu erhalten. Dazu wird laufend an der Unternehmenskultur gearbeitet.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                            </container_copy_copy_>
