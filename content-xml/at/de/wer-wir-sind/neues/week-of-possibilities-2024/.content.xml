                                    type="h2"
                                    variant="noh"/>
                                <text2_1321444411
                                    cq:styleIds="[1659545825678,1659545835858]"
                                    jcr:lastModified="{Date}2024-09-25T02:16:33.629-04:00"
                                    jcr:lastModifiedBy="HERZOBW"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Jahr für Jahr geben die Mitarbeiter:innen von AbbVie etwas an Gemeinschaften zurück, indem sie sich erhrenamtlich im Rahmen verschiedener Projekte einsetzen. Ende Juni war es wieder so weit: Mitarbeiter:innen von AbbVie in über 50 Ländern streiften ihre „AbbVie-Volunteer“-T-Shirts über und machten sich an die Arbeit. Ihr Einsatz war Teil der „Week of Possibilities“ – des globalen Freiwilligen-Programms von AbbVie. Die Idee dahinter: den lokalen Gemeinschaften das (zurück-) zu geben, was sie brauchen. Heuer waren 33 Kolleg:innen aus dem österreichischen Team im Einsatz. 250 Arbeitsstunden widmeten wir unterschiedlichen Projekten.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <separator
                                    cq:styleIds="[1662756409908]"
                                    jcr:created="{Date}2024-10-22T11:31:58.497-04:00"
                                    jcr:createdBy="klavimx"
                                    jcr:lastModified="{Date}2024-10-22T11:31:58.497-04:00"
                                    jcr:lastModifiedBy="klavimx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                                <title_copy_copy
                                    cq:styleIds="[1659545825678,1651545825693]"
                                    jcr:created="{Date}2023-05-04T21:35:42.808-04:00"
                                    jcr:createdBy="SCHAFSM"
                                    jcr:lastModified="{Date}2024-10-14T08:59:57.130-04:00"
                                    jcr:lastModifiedBy="klavimx"
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="Ausmalen und Gartenarbeit für Selbsthilfegruppen"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h2"
                                    variant="noh"/>
                                <text2_copy
                                    cq:styleIds="[1659545825678,1659545835858]"
                                    jcr:lastModified="{Date}2024-10-14T09:07:46.361-04:00"
                                    jcr:lastModifiedBy="klavimx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Frühmorgens im Naturbad der Patientenorganisation „PSO Austria“: Ausgerüstet mit Malerbürsten und Farbtopf verpassten Kolleg*innen den Außenmauern der Sanitäranlagen im Naturbad der PSO Austria einen neuen Anstrich. Die Holzwände des Vereinshäuschen wurden neu lasiert, sodass der Innenbereich auch im neuen Glanz erstrahlt. Vor dem Vereinshaus wurden zudem &amp;nbsp;Sträucher und Blumen gesetzt. Das Naturbad der „PSO Austria“ umfasst 2.500m&lt;sup>2&lt;/sup>&amp;nbsp;an der Unteren Alten Donau. In Ruhelage können Menschen, die an der chronisch-entzündichen Hauterkrankung Schuppenflechte erkrankt sind, entspannt und ungestört die warmen Sommertage genießen.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <image_copy
                                    cq:styleIds="[1402843082812,1402843082822,1402843082832]"
                                    jcr:created="{Date}2024-09-25T02:36:13.531-04:00"
                                    jcr:createdBy="HERZOBW"
                                    jcr:lastModified="{Date}2024-10-17T06:24:16.083-04:00"
                                    jcr:lastModifiedBy="klavimx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/image/v2/image"
                                    alt="Gruppenfoto PSO Bad"
                                    altValueFromDAM="false"
                                    displayPopupTitle="true"
                                    dmPresetType="imagePreset"
                                    fileReference="/content/dam/abbvie-com2/at/images/who-we-are/weekofpossibilities/MFZ.jpg"
                                    isDecorative="false"
                                    openInNewWindow="false"
                                    titleValueFromDAM="true"/>
                                <separator_copy
                                    cq:styleIds="[1662756409908]"
                                    jcr:created="{Date}2024-10-22T11:31:58.497-04:00"
                                    jcr:createdBy="klavimx"
                                    jcr:lastModified="{Date}2024-10-22T11:31:58.497-04:00"
                                    jcr:lastModifiedBy="klavimx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                                <text2_copy_copy
                                    cq:styleIds="[1659545825678,1659545835858]"
                                    jcr:lastModified="{Date}2024-10-14T09:07:57.027-04:00"
                                    jcr:lastModifiedBy="klavimx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Ebenso gestaltete ein Team von AbbVie mit Blumen und Sträuchern den Hofbereich des Medizinischen Selbsthilfezentrums Wien „Martha Frühwirt“ in der Oberen Augartenstraße. Derzeit finden 21 Selbsthilfegruppen in den vorhandenen Räumlichkeiten Platz. Sie sind wichtige Anlaufstelle für Menschen mit chronischen Erkrankungen.&lt;br>&#xd;&#xa;&lt;/p>&#xd;&#xa;&lt;p>Jedes Jahr organisiert die Patientenorganisation „Rheumalis“ eine Therapiewoche in Kärnten mit einem umfassenden Therapie- und Informationsangebot für Kinder und Jugendliche, die mit einer rheumatischen Erkrankung leben, sowie deren Familien. Dazu zählt eine perfekte Vorbereitung! Mitarbeiter:innen von AbbVie unterstützten deshalb bei der Beladung des LKWs mit vielen Materialien und notwendigen Therapiegegenständen.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <separator_copy_865422970
                                    cq:styleIds="[1662756409908]"
                                    jcr:created="{Date}2024-10-22T11:31:58.497-04:00"
                                    jcr:createdBy="klavimx"
                                    jcr:lastModified="{Date}2024-10-22T11:31:58.497-04:00"
                                    jcr:lastModifiedBy="klavimx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                                <title_copy_copy_copy_983419290
                                    cq:styleIds="[1659545825678,1651545825693]"
                                    jcr:created="{Date}2023-05-04T21:35:42.808-04:00"
                                    jcr:createdBy="SCHAFSM"
                                    jcr:lastModified="{Date}2024-10-14T09:01:19.664-04:00"
                                    jcr:lastModifiedBy="klavimx"
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="Leckere Rezepte für die Zweite Gruft"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h2"
                                    variant="h"/>
                                <text2_copy_copy_1174
                                    cq:styleIds="[1659545825678,1659545835858]"
                                    jcr:lastModified="{Date}2024-09-25T02:18:12.959-04:00"
                                    jcr:lastModifiedBy="HERZOBW"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Auch in der Gruft der Caritas Wien nutzten AbbVie Mitarbeiter:innen des&amp;nbsp; BioPharma-Unternehmens die Chance sich sozial zu engagieren. Bereits seit einigen Jahren&amp;nbsp;schwingen wir hier im Rahmen der „Week of Possibilities“ regelmäßig die Kochlöffel und versorgen dabei immer Personen mit einer leckeren Malzeit. In dem Tageszentrum finden Menschen in Notlagen Zuflucht, Beratung und Betreuung sowie warme Speisen.&lt;/p>&#xd;&#xa;&lt;p>Dieses Jahr stellten sich drei Teams von AbbVie Österreich der Herausforderung, sich in der Großküche zurechtzufinden. Schließlich gleicht der Stabmixer hier eher einem Presslufthammer als einem Küchenhelfer. Und gekocht wurde für rund 150 Personen. Doch mit vereinten Kräften gelang es, wunderbare Speisen wie ein italienisches Hühnerragout mit Salat zu zaubern. Sogar für einen Nachschlag war genug übrig – sehr zur Freude der Gäste.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <separator_copy_247056735
                                    cq:styleIds="[1662756409908]"
                                    jcr:created="{Date}2024-10-22T11:31:58.497-04:00"
                                    jcr:createdBy="klavimx"
                                    jcr:lastModified="{Date}2024-10-22T11:31:58.497-04:00"
                                    jcr:lastModifiedBy="klavimx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                                <title_copy_copy_copy_1829286826
                                    cq:styleIds="[1659545825678,1651545825693]"
                                    jcr:created="{Date}2023-05-04T21:35:42.808-04:00"
                                    jcr:createdBy="SCHAFSM"
                                    jcr:lastModified="{Date}2024-10-14T09:02:53.462-04:00"
                                    jcr:lastModifiedBy="klavimx"
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="Lebensmittelpakete schnüren bei Le+O"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h2"
                                    variant="h"/>
                                <text2_copy_copy_copy
                                    cq:styleIds="[1659545825678,1659545835858]"
                                    jcr:lastModified="{Date}2024-09-25T02:19:15.099-04:00"
                                    jcr:lastModifiedBy="HERZOBW"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Essen genau unter die Lupe nehmen hieß es hingegen für das AbbVie Team beim Caritas-Projekt „Le+O – Lebensmittel und Orientierung“. Das ausschließlich aus Spenden finanzierte Programm hilft seit 2009 Tausenden armutsbetroffenen Menschen. Wöchentlich werden rund 13 Tonnen gespendete Lebensmittel bei Kooperationspartnern in Wien und Niederösterreich abgeholt.&lt;/p>&#xd;&#xa;&lt;p>Bei der „Week of Possibilities“ halfen Mitarbeiterinnen von AbbVie im Le+O-Lager in Wien-Floridsdorf die Spenden zu sortieren. Frisches Obst, Brot und Mehlspeisen wurden genau analysiert, Verdorbenes weggeschmissen und noch Genießbares verpackt. Und natürlich durfte eine gehörige Portion gute Laune dabei nicht fehlen.&lt;/p>&#xd;&#xa;&lt;p>Du willst noch mehr über das soziale Engagement von AbbVie erfahren? Weitere Informationen findest du &lt;a href=&quot;/content/abbvie-com2/at/de/nachhaltigkeit/initiativen-in-oesterreich.html&quot;>hier&lt;/a>.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <separator_copy_24705
                                    cq:styleIds="[1662756409908]"
                                    jcr:created="{Date}2024-10-22T11:31:58.497-04:00"
                                    jcr:createdBy="klavimx"
                                    jcr:lastModified="{Date}2024-10-22T11:31:58.497-04:00"
                                    jcr:lastModifiedBy="klavimx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            </container_copy>
