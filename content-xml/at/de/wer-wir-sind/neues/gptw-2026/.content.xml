                            <quote
                                cq:styleIds="[1000000000033,1000000000033,1000000000000]"
                                jcr:created="{Date}2026-08-04T08:55:59.983-04:00"
                                jcr:createdBy="klavimx"
                                jcr:lastModified="{Date}2026-08-04T08:56:40.833-04:00"
                                jcr:lastModifiedBy="klavimx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/quote"
                                attributionName="Mag. Ute Van Goethem "
                                dmPresetType="imagePreset"
                                fileReference="/content/dam/abbvie-com2/at/our-leaders/Ute-Chicago-bearbeitet-Website.jpg"
                                quote="Wer bei AbbVie arbeitet, soll nicht nur einen Job mit einer spannenden Aufgabe, sondern auch echte Perspektiven finden. Für uns sind diese Auszeichnungen ein gemeinsamer Erfolg, der nur durch den exzellenten Beitrag jeder einzelnen Person und durch das kontinuierliche Arbeiten an unserer Unternehmenskultur möglich ist."
                                quoteType="regular"
                                textSize="h0"/>
                            <container_copy_copy__1567829581
                                cq:styleIds="[1653545825687,1653545847150,1653242825678,1653545835982,1653545835879]"
                                jcr:created="{Date}2024-10-22T11:23:20.760-04:00"
                                jcr:createdBy="klavimx"
                                jcr:lastModified="{Date}2024-10-22T11:25:06.864-04:00"
                                jcr:lastModifiedBy="klavimx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/container/v2/container">
                                <text2_copy_copy_8665
                                    cq:styleIds="[1659545825678,1659545835858]"
                                    jcr:lastModified="{Date}2026-08-04T08:57:17.107-04:00"
                                    jcr:lastModifiedBy="klavimx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    langAttribute="none"
                                    text="&lt;p>Gleichzeitig sind die Ergebnisse Ansporn, die Unternehmenskultur laufend weiterzuentwickeln.&lt;/p>&#xd;&#xa;&lt;p>&lt;i>„Die Einblicke aus der Mitarbeiter:innenbefragung geben uns wertvolle Informationen darüber, was bereits gut funktioniert und in welchen Bereichen wir uns noch verbessern können. Unsere ‚AbbVie Ways We Work‘ sind seit dem ersten Tag fest in der Unternehmensstrategie verankert und motivieren uns, weiterhin ein Arbeitsumfeld zu schaffen, in dem Menschen ihr volles Potenzial entfalten können.“&lt;/i>&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <separator
                                    cq:styleIds="[1662756409908]"
                                    jcr:created="{Date}2024-10-22T11:31:58.497-04:00"
                                    jcr:createdBy="klavimx"
                                    jcr:lastModified="{Date}2024-10-22T11:31:58.497-04:00"
                                    jcr:lastModifiedBy="klavimx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                                <title_copy_copy_copy
                                    cq:styleIds="[1659545825678,1651545825693]"
                                    jcr:created="{Date}2023-05-04T21:35:42.808-04:00"
                                    jcr:createdBy="SCHAFSM"
                                    jcr:lastModified="{Date}2026-08-04T08:57:37.318-04:00"
                                    jcr:lastModifiedBy="klavimx"
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="Vielfalt schafft bessere Perspektiven"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    langAttribute="none"
                                    type="h2"
                                    variant="noh"/>
                                <text2_copy_copy_8665_73505055
                                    cq:styleIds="[1659545825678,1659545835858]"
                                    jcr:lastModified="{Date}2026-08-04T08:57:45.238-04:00"
                                    jcr:lastModifiedBy="klavimx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    langAttribute="none"
                                    text="&lt;p>Ein Arbeitsplatz wird dann besonders, wenn alle Menschen die gleichen Chancen haben, ihre Stärken einzubringen.&lt;/p>&#xd;&#xa;&lt;p>Vielfalt, Chancengleichheit und inklusive Führung gehören deshalb fest zur Unternehmenskultur von AbbVie. Unterschiedliche Erfahrungen und Sichtweisen werden bewusst gefördert, weil sie Innovation ermöglichen und Teams erfolgreicher machen.&lt;/p>&#xd;&#xa;&lt;p>Die Auszeichnung als Best Workplace for Women™ unterstreicht diesen Anspruch. Sie zeigt, dass Frauen bei AbbVie ein Umfeld erleben, in dem Entwicklungsmöglichkeiten, Wertschätzung und gegenseitige Unterstützung selbstverständlich sind.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <separator_copy_24705
                                    cq:styleIds="[1662756409908]"
                                    jcr:created="{Date}2024-10-22T11:31:58.497-04:00"
                                    jcr:createdBy="klavimx"
                                    jcr:lastModified="{Date}2024-10-22T11:31:58.497-04:00"
                                    jcr:lastModifiedBy="klavimx"
