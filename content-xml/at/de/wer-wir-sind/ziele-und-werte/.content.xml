                            sling:resourceType="abbvie-com2/components/accordion/v2/accordion"
                            heading="Unsere Prinzipien"
                            headingElement="h5"
                            id="accordion"
                            singleExpansion="false">
                            <item_1671570554123
                                cq:panelTitle="Leben grundlegend verbessern"
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2024-06-17T06:07:58.147-04:00"
                                jcr:lastModifiedBy="kanchrx3"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Unsere Entscheidungen treffen wir auf Basis unserer Fürsorge und des Mitgefühls für Menschen und bewirken so eine Verbesserung im Leben von Menschen mit Erkrankungen, ihren Familien, unseren Mitarbeiter:innen und der Gesellschaft. &lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <item_1671570557396
                                cq:panelTitle="Mit Integrität handeln"
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2024-06-17T06:08:34.830-04:00"
                                jcr:lastModifiedBy="kanchrx3"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Unser Ziel ist, immer das Richtige zu tun. Mit unserer unternehmerischen Integrität, die im Zentrum unseres Handelns steht, setzen wir die höchsten Standards bei Qualität, Sicherheit und unserer Arbeitsleistung.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <item_1671570603045
                                cq:panelTitle="Innovation vorantreiben"
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2024-06-17T06:13:13.944-04:00"
                                jcr:lastModifiedBy="kanchrx3"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Wir streben unermüdlich nach medizinischen Neuerungen. Wir investieren in die Erforschung und Entwicklung neuer Arzneimittel sowie in Lösungsansätze für eine gesündere Welt. &lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <item_1671570607019
                                cq:panelTitle="Vielfalt und Inklusion leben"
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2024-08-22T03:32:53.080-04:00"
                                jcr:lastModifiedBy="HERZOBW"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Wir behandeln alle Menschen gleich - mit Würde und Respekt. Unsere Mitarbeiter:innen kommen aus verschiedenen Ländern und bringen unterschiedliche berufliche Hintergründe und Fähigkeiten mit. Diese vielfältigen Sichtweisen und Perspektiven ermöglichen es uns, das Beste zu erreichen.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <item_1671570609829
                                cq:panelTitle="Für die Gesellschaft engagieren"
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2024-06-17T06:15:29.856-04:00"
                                jcr:lastModifiedBy="kanchrx3"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Wir sind stolz darauf, Verantwortung für unsere Gesellschaft zu übernehmen und unseren Teil zum Schutz der Umwelt beizutragen. Wir machen einen echten Unterschied im Gesundheitswesen und darüber hinaus. &lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                        </accordion_copy_copy>
