                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>Wir übernehmen gesellschaftliche Verantwortung und achten auf unsere Umwelt.&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_copy_copy
                                cq:styleIds="[1662756456518]"
                                jcr:created="{Date}2022-12-05T12:22:48.644-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2022-12-05T12:22:48.644-05:00"
                                jcr:lastModifiedBy="chiucx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <text_copy
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2022-12-05T18:02:53.586-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2024-05-21T04:12:36.331-04:00"
                                jcr:lastModifiedBy="kanchrx3"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>AbbVie nimmt sich den schwersten Erkrankungen unserer Zeit an. Doch unser nachhaltiges Engagement geht weit über die Entwicklung und Bereitstellung von innovativen Arzneimitteln hinaus. Wir setzen uns für die Anliegen von Patient:innen in der Öffentlichkeit ein, übernehmen Verantwortung für unsere Mitarbeiter:innen und schützen die Umwelt.&amp;nbsp;&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <text2_copy
                                cq:styleIds="[1659545825678,1659545835858]"
                                jcr:lastModified="{Date}2026-08-14T03:05:27.490-04:00"
                                jcr:lastModifiedBy="klavimx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                langAttribute="none"
                                text="&lt;p>&lt;b>Für ein nachhaltiges Gesundheitssystem&lt;br>&#xd;&#xa; &lt;/b>Um die Weiterentwicklung des Gesundheitswesens voranzutreiben, bringt sich AbbVie Österreich aktiv in aktuelle Diskussionen ein. Zudem sind wir Mitglied bei Interessenvertretungen wie der PHARMIG (Verband der Pharmazeutischen Industrie Österreichs), der FOPI (Forum der forschenden pharmazeutischen Industrie in Österreich) oder der österreichischen Industriellenvereinigung.&lt;br>&#xd;&#xa;&lt;/p>&#xd;&#xa;&lt;p>&lt;b>Bewusstsein für Erkrankungen schaffen&lt;br>&#xd;&#xa; &lt;/b>Weitere wichtige Pfeiler unseres Engagements sind die Öffentlichkeitsarbeit und das Empowerment von Patienten:innen. Mit gezielten Informationskampagnen und Aktionen schaffen wir Bewusstsein für Gesundheitsthemen und stärken Betroffene.&amp;nbsp;&lt;/p>&#xd;&#xa;&lt;p>&lt;a title=&quot;Weitere Informationen &quot; href=&quot;/content/abbvie-com2/at/de/patient-innen/patienteninformationen.html&quot;>Weitere Informationen&amp;nbsp;&lt;/a>&lt;br>&#xd;&#xa;&lt;br>&#xd;&#xa;&lt;/p>&#xd;&#xa;&lt;p>&lt;b>Freiwilligen-Programm „Week of Possibilities“&lt;br>&#xd;&#xa; &lt;/b>Unsere Mitarbeiter:innen nehmen auch die Chance wahr, sich sozial zu engagieren. Beim globalen Freiwilligen-Programm „Week of Possibilities“ von AbbVie werden bedürftige Gesellschaftsgruppen bei ihren täglichen Herausforderungen unterstützt. Ebenso engagieren sich AbbVie-Mitarbeiter:innen freiwillig für Aktivitäten, die Patientenorganisationen zugutekommen.&amp;nbsp;Im Jahr 2026 leisteten mehr als 15.000 Mitarbeiter:innen in 53 Ländern fast 49.000 Stunden Freiwilligenarbeit.&lt;/p>&#xd;&#xa;&lt;p>&amp;nbsp;&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
