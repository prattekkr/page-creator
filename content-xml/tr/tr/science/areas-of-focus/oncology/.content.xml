                            jcr:lastModifiedBy="chiucx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                        <accordion_copy_copy
                            cq:styleIds="[1,1653545835881]"
                            jcr:created="{Date}2022-12-17T16:25:09.442-05:00"
                            jcr:createdBy="chiucx"
                            jcr:lastModified="{Date}2025-02-16T12:55:34.885-05:00"
                            jcr:lastModifiedBy="jewitca"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/accordion/v2/accordion"
                            heading="Kan Kanserleri:"
                            headingElement="h5"
                            singleExpansion="false">
                            <item_1671312472873
                                cq:panelTitle="Akut Miyeloid Lösemi (AML): "
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2025-09-08T10:22:33.516-04:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>AML, yoğun kemoterapi almaya uygun olmayan hastalar için az tedavi seçeneği ile en agresif ve tedavisi zor&amp;nbsp;lösemilerden biridir.&lt;sup>2&lt;/sup>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <item_1671312475801
                                cq:panelTitle="Kronik Lenfositik Lösemi (KLL): "
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2025-09-08T10:18:15.569-04:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>KLL, kemik iliğinin bir tür beyaz kan hücresi olan&amp;nbsp;lenfositleri çok fazla ürettiği, yavaş&amp;nbsp;ilerleyen bir lösemi türüdür.&lt;sup>3&lt;/sup>&lt;b>&lt;/b>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                        </accordion_copy_copy>
