                            jcr:lastModifiedBy="chiucx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                        <title2_copy
                            cq:styleIds="[1659545825678,1651545824678]"
                            jcr:lastModified="{Date}2025-02-16T12:53:55.982-05:00"
                            jcr:lastModifiedBy="jewitca"
                            jcr:primaryType="nt:unstructured"
                            jcr:title="Kan Kanserleri:"
                            sling:resourceType="abbvie-com2/components/title/v2/title"
                            type="h4"
                            variant="h"/>
                        <text2_copy
                            cq:styleIds="[1659545825678,1659545835858]"
                            jcr:lastModified="{Date}2025-09-08T10:21:32.294-04:00"
                            jcr:lastModifiedBy="singarx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>Hematolojik tümörler, kan ve kan yapıcı organlardan (kemik iliği, lenf sistemi, dalak vb.) köken alan kanserlerin genel adıdır. Köken aldığı yere göre lösemi, lenfoma ve miyelom en yaygın görülen hematolojik tümörlerdir.&lt;sup>1&lt;/sup>&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
                        <separator_165917366
                            cq:styleIds="[1662756423318]"
                            jcr:created="{Date}2022-12-18T09:21:43.017-05:00"
                            jcr:createdBy="chiucx"
