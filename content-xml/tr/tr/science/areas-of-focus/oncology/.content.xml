                            type="h3"
                            variant="h"/>
                        <text2
                            cq:styleIds="[1659545825678,1659545835858]"
                            jcr:lastModified="{Date}2025-08-25T10:02:02.825-04:00"
                            jcr:lastModifiedBy="singarx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>Kanser tedavisini dönüştürecek cevaplar bulmaya odaklanıyoruz. Kan kanserleri ve solid tümörler alanlarında daha iyi ve kalıcı sonuçlar bulmak için çalışıyoruz. Kültürümüzün bir parçası olan merakımız bizi yeni çözümler keşfetmeye yönlendiriyor.&amp;nbsp;&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
                        <separator
                            cq:styleIds="[1662756486159]"
                            jcr:created="{Date}2022-12-18T09:01:55.660-05:00"
                            jcr:createdBy="chiucx"
