                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Diyabetik retinopati (DR), diabetes mellitusun uzun vadeli etkileri nedeniyle ortaya çıkan bir mikrovasküler bozukluktur. Diyabetik retinopati, retinada görme yetisini tehdit eden hasara yol açabilir ve sonunda körlüğe neden olabilir. &lt;sup>4&lt;/sup>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
