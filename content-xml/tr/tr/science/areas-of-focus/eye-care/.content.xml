                                jcr:lastModified="{Date}2025-08-22T08:13:11.946-04:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Optik sinir üzerinde tahribat yaparak ilk dönemlerde hastanın çevre görmesini bozan, son dönemlerinde ise körlüğe yol açabilen genellikle göz tansiyonunun eşlik edebildiği bir görme siniri hastalığıdır (optik nöropati).&lt;sup>2,3&lt;/sup>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <item_1671312481387
