                                jcr:lastModified="{Date}2025-08-22T07:13:35.174-04:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>İlerleyen yaş, kontakt lens kullanımı, bazı ilaçların kullanımı, diğer tıbbi durumlar veya çevresel faktörler nedeniyle oluşabilen kronik bir hastalıktır.&lt;sup>1&lt;/sup>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <item_1671312475801
                                cq:panelTitle="Glokom: "
