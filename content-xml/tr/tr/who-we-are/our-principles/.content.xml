                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>İlkelerimize olan inancımızla ilerleriz. İlkelerimiz neyi savunduğumuzun göstergesidir. İlkelerimiz rehberimizdir. İlkelerimiz bizim kim olduğumuzun ve nasıl çalıştığımızın temel göstergesidir.&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
