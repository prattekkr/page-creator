                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;body-unica-20-reg&quot;>Real World Evidence (RWE) eli tosielämän tutkimusten avulla yhä useamman ihmisen on mahdollista saada tehokasta ja itselleen sopivaa hoitoa&lt;span class=&quot;body-unica-18-reg&quot;>.&lt;/span>&lt;/span>&lt;span class=&quot;body-unica-18-reg&quot;>&amp;nbsp;&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
