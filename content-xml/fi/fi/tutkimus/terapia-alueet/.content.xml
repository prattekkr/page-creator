                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>AbbViella yhdistämme asiantuntemuksemme ja potilaiden tarpeet luodessamme uusia hoitokeinoja vakaviin sairauksiin.&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <text_1935889613
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2023-09-25T12:12:05.162-04:00"
                                jcr:createdBy="jewitca"
                                jcr:lastModified="{Date}2023-10-16T16:27:43.014-04:00"
                                jcr:lastModifiedBy="jewitca"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;body-unica-20-reg&quot;>Tahdomme kehittää parhaita mahdollisia lääkkeitä parantaaksemme vakavien sairauksien kanssa elävien ihmisten elämänlaatua. Teemme yhteistyötä yliopistojen, tutkimusinstituuttien sekä muiden kumppaneiden kanssa.&lt;/span>&lt;/p>&#xd;&#xa;&lt;p>&lt;span class=&quot;body-unica-20-reg&quot;>Keskitämme työmme terapia-alueisiin, joissa olemme vahvoja ja missä meillä on jatkuvasti suurempi mahdollisuus kehittää uusia tapoja auttaa ihmisiä. Lue lisää terapia-alueistamme alta.&lt;/span>&lt;br />&#xd;&#xa;&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                        </container3>
