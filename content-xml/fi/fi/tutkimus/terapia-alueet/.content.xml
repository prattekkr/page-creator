                            singleExpansion="false">
                            <item_1697487291460
                                cq:panelTitle="IMMUNOLOGIA"
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2023-10-16T16:24:02.329-04:00"
                                jcr:lastModifiedBy="jewitca"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;body-unica-18-reg&quot;>AbbVien vankka asiantuntemus immunologiassa on tulosta pitkästä tutkimusperinnöstämme. Onnistumisemme motivoivat meitä jatkamaan uusien ratkaisujen etsimistä.&lt;/span>&lt;/p>&#xd;&#xa;&lt;p>&lt;span class=&quot;body-unica-18-reg&quot;>Erikoistumisalamme immunologiassa ovat reumatologia, dermatologia ja gastroenterologia. Työskentelemme auttaaksemme kroonisia tulehduksellisia sairauksia sairastavia ihmisiä elämään täyttä elämää ilman sairauden aiheuttamia rajoitteita.&lt;br>&#xd;&#xa;&lt;/span>&lt;/p>&#xd;&#xa;&lt;p>&lt;span class=&quot;body-unica-18-reg&quot;>Jokaisen uuden löydöksen avulla ymmärrämme paremmin potilaiden erilaisuutta ja voimme kehittää personoidumpia lähestymistapoja immunologisiin sairauksiin.&lt;/span>&lt;/p>&#xd;&#xa;&lt;p>&lt;span class=&quot;body-unica-18-reg&quot;>Lue lisää immunologiasta&amp;nbsp;&lt;a href=&quot;https://www.abbviepro.com/fi/fi/immunology.html&quot;>AbbVie Pro:ssa&lt;/a>&lt;/span>&lt;/p>&#xd;&#xa;&lt;p>&lt;span class=&quot;body-unica-18-reg&quot;>Lisätietoa atooppisesta ihottumasta löydät osoitteesta&amp;nbsp;&lt;a href=&quot;https://www.atooppinenihottuma.fi/&quot;>atooppinenihottuma.fi&lt;/a>&lt;/span>&lt;/p>&#xd;&#xa;&lt;p>&amp;nbsp;&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <item_1697487295314
                                cq:panelTitle="ONKOLOGIA JA HEMATOLOGIA"
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2023-10-16T16:24:17.453-04:00"
                                jcr:lastModifiedBy="jewitca"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;body-unica-18-reg&quot;>Uteliaisuutemme ajaa meitä eteenpäin, kun kehitämme uusia hoitokeinoja erilaisiin syöpiin. Me AbbViella haluamme saada aikaan parempia ja pidempikestoisia tuloksia syöpien hoidossa.&lt;/span>&lt;/p>&#xd;&#xa;&lt;p>&lt;span class=&quot;body-unica-18-reg&quot;>Tutkimuksemme on johtanut tärkeisiin löytöihin hematologisten syöpien hoidossa. Nyt laajennamme tutkimuksiamme myös kiinteisiin syöpäkasvaimiin, joita suurin osa ihmisten syövistä on.&lt;/span>&lt;/p>&#xd;&#xa;&lt;p>&lt;span class=&quot;body-unica-18-reg&quot;>Hematologiset syövät vaikuttavat verta muodostaviin kudoksiin, kuten luuytimeen, ja rajoittavat kehon vastustuskykyä infektioita vastaan. Yleisimpiä hematologisia syöpiä ovat leukemiat, lymfoomat ja myelooma. Tavallisimpia kasvaintyyppejä puolestaan ovat sarkooma ja karsinooma.&lt;/span>&lt;/p>&#xd;&#xa;&lt;p>&lt;span class=&quot;body-unica-18-reg&quot;>Lue lisää onkologiasta ja hematologiasta&amp;nbsp;&lt;a href=&quot;https://www.abbviepro.com/fi/fi/oncology/oncology.html&quot;>AbbVie Pro:ssa&lt;/a>.&lt;/span>&lt;/p>&#xd;&#xa;&lt;p>&amp;nbsp;&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <item_1697487297907
                                cq:panelTitle="NEUROLOGIA"
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2023-11-15T09:12:25.084-05:00"
                                jcr:lastModifiedBy="jewitca"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;body-unica-18-reg&quot;>Teemme AbbViella innovatiivista tutkimustyötä yhdiste, jotka vaikuttavat aivoissa sijaitseviin reseptoreihin. Näiden reseptorien avulla säädellään muun muassa kipua, mielialaa, muistia ja muita neurologisia toimintoja.&lt;/span>&lt;/p>&#xd;&#xa;&lt;p>&lt;span class=&quot;body-unica-18-reg&quot;>Työskentelemme lääkekehityksen kaikissa vaiheissa perustutkimuksesta lähtien löytääksemme uusia ratkaisuja haastaviin neurologisiin ja psyykkisiin sairauksiin. Tutkimiamme sairauksia ovat esimerkiksi Alzheimerin tauti, Parkinsonin tauti, MS-tauti, migreeni sekä skitsofrenia.&lt;/span>&lt;/p>&#xd;&#xa;&lt;p>&lt;span class=&quot;body-unica-18-reg&quot;>Lue lisää neurologiasta&amp;nbsp;&lt;a href=&quot;https://www.abbviepro.com/fi/fi/neurology/neurology.html&quot;>AbbVie Pro:ssa&lt;/a>.&lt;/span>&lt;/p>&#xd;&#xa;&lt;p>&lt;span class=&quot;body-unica-18-reg&quot;>Lisätietoa migreenistä löydät osoitteesta&amp;nbsp;&lt;a href=&quot;https://otamigreenivakavasti.fi/&quot;>otamigreenivakavasti.fi&lt;/a>.&lt;/span>&lt;/p>&#xd;&#xa;&lt;p>&amp;nbsp;&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <item_1697487300004
                                cq:panelTitle="SILMÄSAIRAUDET"
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2023-10-16T16:24:58.300-04:00"
                                jcr:lastModifiedBy="jewitca"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;body-unica-18-reg&quot;>Sokeus ja näön heikentyminen vaikuttavat maailmanlaajuisesti yli miljardiin ihmiseen ja joka vuosi yhä useampi saa näköään uhkaavan diagnoosin. Keskitymme kehittämään hoitomuotoja useisiin silmätauteihin, kuten glaukoomaan ja erilaisiin verkkokalvosairauksiin.&lt;/span>&lt;/p>&#xd;&#xa;&lt;p>&lt;span class=&quot;body-unica-18-reg&quot;>Vuodesta 1948 tutkijamme Allerganilla, joka on nykyisin osa AbbVieta, ovat toimineet silmäsairauksien tutkimuksen edelläkävijöinä. Tutkimme sairauksien geneettistä perustaa löytääksemme uusia innovatiivisia lääkkeitä helpottamaan potilaiden elämää.&lt;/span>&lt;/p>&#xd;&#xa;&lt;p>&amp;nbsp;&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <item_1697487302169
                                cq:panelTitle="VIROLOGIA"
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2024-08-09T04:08:42.964-04:00"
                                jcr:lastModifiedBy="COLLINX1"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;body-unica-18-reg&quot;>Viruslääketutkimuksemme keskittyy erityisesti hepatiitti C -tartunnan hoitoon soveltuvien lääkkeiden kehitystyöhön. Maailmanlaajuisesti hepatiitti C -tartunnan saaneita ihmisiä on yli 170 miljoonaa, ja vuosittain tartunnan saa noin 4 miljoonaa ihmistä.&lt;/span>&lt;/p>&#xa;&lt;p>&lt;span class=&quot;body-unica-18-reg&quot;>Hepatiitti C -tartunta voi johtaa pitkäaikaisiin komplikaatioihin. Haluamme omalta osaltamme olla edistämässä Maailman terveysjärjestö WHO:n tavoitetta eliminoida hepatiitti C maailmasta vuoteen 2030 mennessä.&lt;br>&#xa;&lt;/span>&lt;/p>&#xa;&lt;p>&lt;span class=&quot;body-unica-18-reg&quot;>C-hepatiitin lisäksi tutkimme virologian terapia-alueella esimerkiksi endokrinologisia ja ruoansulatusjärjestelmän tauteja, keuhkotauteja sekä HIV:tä. Monimuotoista tieteellisten asiantuntijoidemme joukkoa yhdistää yksi tavoite: haluamme tehdä merkittäviä uusia löytöjä, jotka vaikuttavat positiivisesti useiden ihmisten elämiin.&lt;/span>&lt;/p>&#xa;&lt;p>&lt;span class=&quot;body-unica-18-reg&quot;>Lue lisää C-hepatiitista&amp;nbsp;&lt;a href=&quot;https://www.abbviepro.com/fi/fi/virology/hcv.html&quot;>AbbVie Pro:ssa&lt;/a>.&lt;/span>&lt;/p>&#xa;&lt;p>&lt;span class=&quot;body-unica-18-reg&quot;>Lisätietoa C-hepatiitista löydät osoitteesta&amp;nbsp;&lt;a href=&quot;https://www.abbvie.fi/yhteistyoe/potilasjaerjestoeyhteistyoe/c-hepatiitti.html&quot;>c-hepatiitti.fi&lt;/a>.&lt;/span>&lt;/p>&#xa;&lt;p>&amp;nbsp;&lt;/p>&#xa;"
                                textIsRich="true"/>
                            <item_1697487357820
                                cq:panelTitle="MUUT TERAPIA-ALUEET"
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2023-10-16T16:25:27.106-04:00"
                                jcr:lastModifiedBy="jewitca"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;body-unica-18-reg&quot;>Vuonna 2020 Allergan liitettiin osaksi AbbVieta, ja siitä lähtien olemme olleet edelläkävijöitä myös esteettisen lääketieteen parissa. Tutkimme ikääntymisen merkkejä ja kehitämme portfoliotamme täydentäviä seuraavan sukupolven esteettisiä tuotteita ja ratkaisuja.&lt;/span>&lt;/p>&#xd;&#xa;&lt;p>&lt;span class=&quot;body-unica-18-reg&quot;>Esteettisen lääketieteen ja muiden suurempien erikoistumisalojemme lisäksi me AbbViella teemme tutkimusta muun muassa endokriinisten ongelmien, kuten kilpirauhasen vajaatoiminnan ja naisten vuotohäiriöiden, parissa. Meillä on myös tutkimusohjelmia, jotka keskittyvät tutkimaan ärtyvän suolen oireyhtymää, idiopaattista keuhkofibroosia ja kystistä fibroosia.&lt;/span>&lt;/p>&#xd;&#xa;&lt;p>&lt;span class=&quot;body-unica-18-reg&quot;>Lue lisää esteettisestä lääketieteestä&amp;nbsp;&lt;a href=&quot;https://nordics.allerganaesthetics.com/f&quot;>Allergan Aestheticsin sivuilta&lt;/a>.&lt;/span>&lt;/p>&#xd;&#xa;&lt;p>&amp;nbsp;&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                        </accordion>
