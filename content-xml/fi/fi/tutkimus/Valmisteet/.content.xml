                                    jcr:title="Tuotteidemme saatavuus ja valmistus"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h3"
                                    variant="h"/>
                                <text_copy
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2023-09-27T12:37:54.295-04:00"
                                    jcr:createdBy="jewitca"
                                    jcr:lastModified="{Date}2023-09-27T13:10:30.177-04:00"
                                    jcr:lastModifiedBy="jewitca"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>&lt;span class=&quot;body-unica-18-reg&quot;>Valmisteemme ovat aina paikallisten lakien ja säädösten mukaisesti hyväksyttyjä. Valmisteiden saatavuus voi vaihdella maakohtaisesti.&lt;br>&#xd;&#xa;&lt;/span>&lt;/p>&#xd;&#xa;&lt;p>&lt;span class=&quot;body-unica-18-reg&quot;>Lääkkeitämme valmistetaan useissa tehtaissa ympäri maailmaa. Euroopan tehtaamme sijaitsevat Irlannissa, Saksassa ja Italiassa. Jokaisen lääkepakkauksen pakkausselosteessa kerrotaan, missä kyseinen lääke on viranomaismääräysten mukaisesti vapautettu käyttöön Suomessa.&lt;/span>&lt;/p>&#xd;&#xa;&lt;p>&lt;span class=&quot;body-unica-18-reg&quot;>Mikäli lääkkeidemme saatavuuteen tulisi häiriöitä, ilmoitamme asiasta erikseen Fimean ohjeiden mukaisesti. Kaikki saatavuushäiriöilmoitukset kestoineen löytyvät &lt;a href=&quot;https://www.fimea.fi/laakehaut_ja_luettelot/saatavuushairio-uusi&quot; target=&quot;_blank&quot;>Fimean nettisivuilta&lt;/a>.&lt;/span>&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                            </par_13>
                        </grid_1839283064_copy>
