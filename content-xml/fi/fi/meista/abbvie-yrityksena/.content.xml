                                    jcr:created="{Date}2022-11-28T14:12:33.220-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2023-09-22T16:33:25.579-04:00"
                                    jcr:lastModifiedBy="jewitca"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>AbbVie on perustettu vuonna 2013, mutta juuremme ovat pidemmällä. Tiemme terveydenhuollon edelläkävijäksi alkoi Abbottin kautta.&amp;nbsp;&lt;/p>&#xd;&#xa;&lt;p>Chicagolainen lääkäri Wallace Abbott perusti nimeään kantavan yrityksen vuonna 1888. AbbVie erotettiin Abbottista omaksi yritykseksi vuoden 2013 alussa.&lt;br>&#xd;&#xa;&lt;/p>&#xd;&#xa;&lt;p>Yhtiömme nimi edustaa sekä historiaa että tulevaisuutta. Nimen alkuosa, Abb, tulee Abbottista ja loppuosa, Vie, puolestaan ranskan sanasta ”elämä”.&lt;br>&#xd;&#xa;&lt;/p>&#xd;&#xa;&lt;p>Tänä päivänä meillä on maailmanlaajuisesti 50 000 työntekijää työskentelemässä elämää mullistavien lääkkeiden ja hoitojen parissa. Suomessa meitä abbvielaisia on noin 100.&lt;br>&#xd;&#xa;&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
