                                    jcr:lastModified="{Date}2023-09-22T16:47:34.335-04:00"
                                    jcr:lastModifiedBy="jewitca"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Edistämme terveydenhuollon ratkaisuja, joilla on merkitystä. Teemme tämän yhteistyössä tutkijoiden, kliinisten asiantuntijoiden, päättäjien ja potilasjärjestöjen kanssa.&lt;/p>&#xd;&#xa;&lt;p>Tiedämme, että monet tärkeimmistä lääketieteen läpimurroista ovat tutkimusyhteistyön ja erilaisten kumppanuuksien ansiota. Siksi työskentelemme yhdessä sidosryhmiemme kanssa ymmärtääksemme paremmin sairastavien elämää.&lt;br />&#xd;&#xa;&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
