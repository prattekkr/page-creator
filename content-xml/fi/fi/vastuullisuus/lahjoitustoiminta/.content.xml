                        <text
                            cq:styleIds="[1659545825678]"
                            jcr:created="{Date}2023-10-05T06:10:17.590-04:00"
                            jcr:createdBy="jewitca"
                            jcr:lastModified="{Date}2023-11-15T06:57:46.531-05:00"
                            jcr:lastModifiedBy="RAITIKJ"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>&lt;span class=&quot;body-unica-18-reg&quot;>Vuonna 2022 lahjoitimme lääketieteellistä apua ja tarvikkeita Ukrainaan ja Ukrainan pakolaisille yhteensä miljoonalla dollarilla. Lisäksi tuplasimme työntekijöidemme lahjoitukset tietyille Ukrainassa ja lähialueilla toimiville katastrofiapua tarjoaville järjestöille.&lt;/span>&lt;/p>&#xa;&lt;p>&lt;span class=&quot;body-unica-18-reg&quot;>Rahallisten lahjoitusten lisäksi olemme lahjoittaneet välttämättömiä lääkkeitä Ukrainan valtiolle ja katastrofiapua tarjoaville kumppaneillemme. Olemme myös tarjonneet ylimääräistä taloudellista apua sitä tarvitseville ukrainalaisille työntekijöillemme ja heidän perheilleen.&lt;/span>&lt;/p>&#xa;&lt;p>&lt;span class=&quot;body-unica-18-reg&quot;>Olemme keskeyttäneet esteettisen lääketieteen tuotteiden toimitukset Venäjälle, mutta jatkamme välttämättömien lääkkeiden toimittamista. Lahjoitamme kaikki Venäjällä myytyjen välttämättömien lääkkeiden tuotot Ukrainan humanitaariseen apuun.&lt;/span>&lt;/p>&#xa;&lt;p>&lt;span class=&quot;body-unica-18-reg&quot;>Jatkamme yhteistyön tekemistä järjestökumppaneidemme ja työntekijöidemme kanssa auttaaksemme ukrainalaisia.&lt;br>&#xa; &lt;/span>&amp;nbsp;&lt;/p>&#xa;"
                            textIsRich="true"/>
                    </container_706354367>
