                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="Vastuullisuutemme kulmakivet"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h3"
                                    variant="h"/>
                                <text
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2023-10-05T04:48:22.807-04:00"
                                    jcr:createdBy="jewitca"
                                    jcr:lastModified="{Date}2023-11-15T06:26:04.025-05:00"
                                    jcr:lastModifiedBy="RAITIKJ"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Kehitämme ja tuotamme lääkkeitä, jotka auttavat ratkaisemaan vakavia terveysongelmia ja parantavat ihmisten elämänlaatua. Toteutamme tämän panostamalla tutkimukseen sekä varmistamalla tuotteidemme olevan tehokkaita ja saavutettavia.&lt;/p>&#xa;&lt;p>Autamme monimuotoisia tiimejämme saavuttamaan täyden potentiaalinsa auttaaksemme ihmisiä nyt ja tulevaisuudessa. Kannustamme monipuoliseen ajatteluun, teemme paljon sisäistä ja ulkoista yhteistyötä ja tahdomme työntekijöidemme olevan alansa parhaimmistoa.&lt;/p>&#xa;&lt;p>Tavoittelemme ihmisten terveyden pitkäkestoista parantamista ja liiketoiminnan kestävyyttä toimimalla avoimesti ja rehellisesti. Pidämme huolta lääkkeiden ja muiden tuotteidemme saavutettavuudesta.&lt;/p>&#xa;&lt;p>&lt;br>&#xa;Voit lukea englanninkielisen &lt;a href=&quot;https://www.abbvie.com/content/dam/abbvie-com2/pdfs/abbvie-esg-action-report.pdf&quot; target=&quot;_blank&quot;>yritysvastuuraporttimme täällä&lt;/a>&amp;nbsp;tai tutustua tarkemmin liiketoimintamme eettiseen ohjeistoon (Code of Business Conduct) &lt;a href=&quot;https://www.abbvie.com/content/dam/abbvie-com2/pdfs/cobc/codc_Finnish.pdf&quot; target=&quot;_blank&quot;>suomeksi täällä&lt;/a>.&lt;br>&#xa;&lt;br>&#xa;&lt;/p>&#xa;"
                                    textIsRich="true"/>
                            </par_13>
                        </grid_1434625928_copy>
