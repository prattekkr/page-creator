                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>Annamme työntekijöillemme mahdollisuuden tehdä hyvää. Tuemme vapaaehtoistoimintaa monilla eri tavoilla.&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <text_1561111105
                                cq:styleIds="[1659545825678]"
