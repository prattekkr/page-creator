                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>&lt;span class=&quot;body-unica-20-reg&quot;>Henkilökuntamme kova työ ja omistautuneisuus luovat AbbVien menestyksen. Työntekijät ovat tärkein voimavaramme, ja siksi heidän hyvinvointinsa asetetaan aina kaiken muun edelle.&lt;/span>&lt;/p>&#xd;&#xa;&lt;p>&lt;span class=&quot;body-unica-20-reg&quot;>Huolehdimme työntekijöidemme hyvinvoinnin lisäksi yhdenvertaisesta kohtelusta ja reiluista eduista. Tunnistamme ja palkitsemme hienoihin suorituksiin yltäneet työntekijät. Tarjoamme myös joustavuutta ja tukea muuttuvissa elämänvaiheissa.&lt;br>&#xd;&#xa;&lt;/span>&lt;/p>&#xd;&#xa;&lt;p>&lt;span class=&quot;body-unica-20-reg&quot;>Etsimme jatkuvasti joukkoomme uusia kykyjä ja kun he löytyvät, pidämme heistä hyvää huolta.&lt;/span>&lt;br>&#xd;&#xa;&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
