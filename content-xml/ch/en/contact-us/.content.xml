                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            langAttribute="none"
                            text="&lt;p>Alte Steinhauserstrasse 14&lt;br>&#xd;&#xa;CH-6330 Cham&lt;/p>&#xd;&#xa;&lt;p>Telephone: + 41 41 399 15 00&lt;br>&#xd;&#xa;Email: &lt;a href=&quot;mailto:Switzerland@abbvie.com&quot;>Switzerland@abbvie.com&lt;/a>&lt;/p>&#xd;&#xa;&lt;p>&lt;b>Medical and Scientific inquiries&lt;br>&#xd;&#xa; &lt;/b>The AbbVie Medical Information team will answer all your medical questions about our medicines. You are welcome to send your questions by email to &lt;a href=&quot;mailto:%20medinfo.ch@abbvie.com&quot;>medinfo.ch@abbvie.com&lt;/a>.&lt;/p>&#xd;&#xa;&lt;p>Medical professionals also have the option of submitting their questions to the Medical Information team at &lt;a href=&quot;https://www.abbviemedinfo.com&quot; target=&quot;_blank&quot;>www.abbviemedinfo.com&lt;/a>.&lt;/p>&#xd;&#xa;&lt;p>&lt;b>Adverse drug reaction&lt;br>&#xd;&#xa; &lt;/b>If you would like to report an adverse drug reaction to an AbbVie product, please contact our pharmacovigilance team. The pharmacovigilance department can be reached by email at &lt;a href=&quot;mailto:chpv@abbvie.com&quot;>chpv@abbvie.com&lt;/a>.&lt;/p>&#xd;&#xa;&lt;p>&lt;b>Quality Complaint&amp;nbsp;&lt;br>&#xd;&#xa; &lt;/b>If you would like to report a quality complaint for an AbbVie product, please contact our Quality Assurance team. The department can be reached by email.&lt;/p>&#xd;&#xa;&lt;p>Quality complaints for pharmaceutical products:&lt;br>&#xd;&#xa;&lt;a href=&quot;mailto:chpq@abbvie.com&quot;>chpq@abbvie.com&lt;/a>&lt;br>&#xd;&#xa;Quality complaints for aesthetic medical devices:&lt;br>&#xd;&#xa;&lt;a href=&quot;mailto:DeviceComplaintsAlpine@Abbvie.com&quot;>DeviceComplaintsAlpine@Abbvie.com&lt;/a>&lt;br>&#xd;&#xa;&amp;nbsp;&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
