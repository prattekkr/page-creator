                            <text
                                cq:styleIds="[1659545825678,1659545835858]"
                                jcr:lastModified="{Date}2025-07-29T13:49:52.504-04:00"
                                jcr:lastModifiedBy="VALENSX5"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>On Sunday, 4th May 2025, the time had come for the fourth go: A team of 47 motivated runners from AbbVie Switzerland took part in the Wings for Life World Run in Zug. The team consisted of 29 AbbVie employees, 18 family members and friends. Together, this great team ran over 630&amp;nbsp;kilometres for a good cause.&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                        </container3>
                    </container2>
                    <grid
                        cq:styleIds="[1653545835880]"
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="abbvie-com2/components/grid/v2/grid"
                        rowCount="1">
                        <columns jcr:primaryType="nt:unstructured">
                            <item0
