                                jcr:lastModifiedBy="VALENSX5"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>Under the umbrella of the Global EHS (Environment, Health and Safety) Initiative, our local EHS team partnered with the local Samaritan Association of Cham to organize first aid training sessions. All employees were invited to participate and refresh their skills to help in emergency situations.&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                        </container3>
