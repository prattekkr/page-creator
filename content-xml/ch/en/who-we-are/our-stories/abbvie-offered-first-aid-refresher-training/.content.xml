                                    jcr:lastModifiedBy="VALENSX5"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>The training was primarily hands-on, with an initial theory session. To allow close supervision by the two trainers from the Samaritan Association, the participants were divided into small groups to ensure that each exercise was closely monitored.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
