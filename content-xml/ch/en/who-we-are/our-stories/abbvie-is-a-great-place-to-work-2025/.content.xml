                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="Passion is Fuel of Innovation "
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h3"
                                    variant="h"/>
                                <text2_copy_copy
                                    cq:styleIds="[1659545825678,1659545835858]"
                                    jcr:lastModified="{Date}2025-05-13T09:44:36.997-04:00"
                                    jcr:lastModifiedBy="VALENSX5"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Passion drives us to transcend our limitations and aim for the stars, just as we do every day in our commitment to serving patients in the best possible way. &lt;/p>&#xd;&#xa;&lt;p>An example of different roles demonstrates how each of us contributes to making a difference in patients’ lives. In just 15 seconds, 12 employees demonstrated how their work is a personal contribution to our mission to leave no eligible patient behind. Visit our video gallery to &lt;a href=&quot;/content/abbvie-com2/ch/en/join-us/life-at-abbvie/meet-our-employees-in-15-seconds.html&quot;>meet our employees in 15 seconds&lt;/a>.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <separator_copy_copy
                                    cq:styleIds="[1662756456518]"
                                    jcr:created="{Date}2025-05-12T10:34:48.737-04:00"
