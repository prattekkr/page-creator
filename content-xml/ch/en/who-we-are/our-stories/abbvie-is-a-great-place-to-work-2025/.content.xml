                                    jcr:lastModified="{Date}2025-05-12T13:47:43.919-04:00"
                                    jcr:lastModifiedBy="VALENSX5"
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="What inspires us"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h4"
                                    variant="h"/>
                                <text2_copy
                                    cq:styleIds="[1659545825678,1659545835858]"
                                    jcr:lastModified="{Date}2025-05-22T09:35:50.407-04:00"
                                    jcr:lastModifiedBy="kaspatx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;ul>&#xd;&#xa;&lt;li>Innovative medicines and solutions that improve patients’ lives&lt;/li>&#xd;&#xa;&lt;li>A strong and&amp;nbsp;diverse &lt;a href=&quot;https://www.abbvie.ch/en/science/pipeline.html&quot;>pipeline&lt;/a>&lt;/li>&#xd;&#xa;&lt;li>A culture characterized by trust, teamwork and active inclusion&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;&lt;p>&lt;b>Competitive benefits and programs that support the needs of employees&lt;/b>&lt;/p>&#xd;&#xa;&lt;ul>&#xd;&#xa;&lt;li>Flexible working hours, option of home office and sabbatical&lt;br>&#xd;&#xa;(every five years)&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;li>Up to 30 days holiday, plus 6 additional days off as bridging days&lt;/li>&#xd;&#xa;&lt;li>Individual development plans, leadership &amp;amp; management programs, etc.&lt;/li>&#xd;&#xa;&lt;li>Share ownership program for employees&lt;/li>&#xd;&#xa;&lt;li>Employee assistance programs&lt;/li>&#xd;&#xa;&lt;li>And much more...&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;&lt;p>&lt;b>94% employee satisfaction rate in this year’s survey speaks for itself.&lt;/b>&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                            </container4>
                            <container
