                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>AbbVie combines the experience of over 135&amp;nbsp;years of research&amp;nbsp;&amp;amp;&amp;nbsp;development and patient care with the dynamism and spirit of a young company, which we still uphold, even after more than 12 years. AbbVie was created in 2013 as a spin-off from Abbott.&lt;/p>&#xd;&#xa;&lt;p>We offer our employees in Switzerland the framework conditions and development opportunities of a major global corporation, but in a family atmosphere, with around 280&amp;nbsp;employees in 2025.&amp;nbsp;&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <separator
                                    cq:styleIds="[1662756456518]"
                                    jcr:created="{Date}2025-05-12T10:34:48.737-04:00"
