                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Working at AbbVie is fulfilling because of the pride we share in our achievements and our impact on patients and communities. Our shared purpose and high standards drive meaningful contributions. Meet Laia and Mathias to learn what matters to them.&amp;nbsp;&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
