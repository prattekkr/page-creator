                                    jcr:lastModified="{Date}2025-06-13T15:28:41.051-04:00"
                                    jcr:lastModifiedBy="VALENSX5"
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="Happiness at Work"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h3"
                                    variant="h"/>
                                <text2_copy_copy_copy
                                    cq:styleIds="[1659545825678,1659545835858]"
                                    jcr:lastModified="{Date}2025-06-16T02:57:29.391-04:00"
                                    jcr:lastModifiedBy="kaspatx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>We have invited some of our colleagues to speak about our core values, which were highly rated in the Great Place to Work survey: caring, belonging, camaraderie. Watch the three short videos and learn what these values mean to us.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <separator_copy_copy__1118764678
