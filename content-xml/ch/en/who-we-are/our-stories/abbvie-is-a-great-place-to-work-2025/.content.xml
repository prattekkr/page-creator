                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="We are proud to belong to AbbVie"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h4"
                                    variant="h"/>
                                <text2_copy_copy_copy_103314828
