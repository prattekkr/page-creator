                                    jcr:lastModifiedBy="jewitca"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>&lt;span class=&quot;body-unica-20-reg&quot;>On 2 May 2022, the local legal entities of AbbVie (AbbVie AG) and Allergan (Allergan AG) were merged or the business transferred in Switzerland. The overview of Allergan AG's services can be accessed by clicking on this &lt;a href=&quot;https://www.abbvie.com/who-we-are/operating-with-integrity/transparency-in-payment/allergan-ous-disclosures.html&quot; target=&quot;_blank&quot;>link&lt;/a>.&lt;/span>&lt;/p>&#xd;&#xa;"
