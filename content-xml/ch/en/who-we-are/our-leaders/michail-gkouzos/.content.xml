                                jcr:lastModifiedBy="jewitca"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;body-unica-20-reg&quot;>Michail Joined AbbVie in 2020 as BTS Lead for the Greek affiliate. In 2023, he successfully completed an eight-month assignment leading the BTS functions for Greece and Switzerland. Prior to joining AbbVie, Michail worked for one of the world’s largest food retail groups as Retail, Digital and Loyalty Applications Manager. He also worked for a telecommunications company as Lead Software Engineer for three years.&lt;/span>&lt;/p>&#xd;&#xa;&lt;p>&lt;span class=&quot;body-unica-20-reg&quot;>Michail holds a bachelor’s degree in electrical and computer engineering from the National Technical University of Athens and a master’s degree in telecommunications management from UCL, London.&amp;nbsp;&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <button
                                cq:styleIds="[1659997777274]"
