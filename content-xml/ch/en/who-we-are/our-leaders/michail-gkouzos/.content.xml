                                jcr:lastModifiedBy="jewitca"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="LinkedIn Profile"
                                sling:resourceType="abbvie-com2/components/button/v2/button"
                                accessibilityLabel="LinkedIn profile"
                                linkTarget="_blank"
                                linkURL="https://www.linkedin.com/in/michail-gkouzos-89b49714/"/>
                        </par_14>
                        <text_copy
