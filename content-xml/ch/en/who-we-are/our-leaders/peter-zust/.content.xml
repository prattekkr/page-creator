                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;body-unica-20-reg&quot;>Peter joined AbbVie in 2022 from a large multi-national pharmaceutical company where he held roles with increasing responsibility in Public Affairs, Media Relations, and External Communications. Prior to joining the pharmaceutical industry, he engaged in consultancy and campaigning in the private and public sector.&lt;/span>&lt;/p>&#xd;&#xa;&lt;p>&lt;span class=&quot;body-unica-20-reg&quot;>Peter has a long track record in numerous affiliate and international roles of increasing responsibility within the areas of communication and corporate affairs. He holds an Executive MBA from the University of Zurich as well as a master’s degree in political science from the University of Bern.&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
