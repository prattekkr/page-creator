                                jcr:lastModifiedBy="jewitca"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;body-unica-20-reg&quot;>Marco joined AbbVie Portugal in 2011 as Product Manager for Gastroenterology. Since then, he has held a variety of positions in Marketing and Sales in the Portuguese affiliate, leading teams across various therapeutic areas. In 2021 he moved to a regional role as Europe Commercial Director for Rheumatology. In May 2024, he was named Customer Excellence Director for the Swiss affiliate and relocated to Switzerland. Before joining AbbVie, Marco worked as a Product Manager for several international companies in the medical field.&lt;/span>&lt;/p>&#xd;&#xa;&lt;p>&lt;span class=&quot;body-unica-20-reg&quot;>Marco holds a bachelor’s degree of Pharmacy from the University of Lisbon and a post-graduate degree in marketing and product management from the ISCTE, Instituto Universitário de Lisboa.&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <button
                                cq:styleIds="[1659997777274]"
