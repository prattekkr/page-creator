                                jcr:lastModifiedBy="jewitca"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;body-unica-20-reg&quot;>Dirk has more than 20 years of experience in HR in the pharmaceutical industry. Before joining AbbVie he held several strategic leadership positions, in Talent Acquisition, Global and Site HR Business Partnering in different cultural environments in Europe, the USA and Asia. He led cultural transformations, with a focus on building new visions and strategies for the respective affiliates, both in mature and emerging markets.&lt;/span>&lt;/p>&#xd;&#xa;&lt;p>&lt;span class=&quot;body-unica-20-reg&quot;>Dirk holds a Master’s degree in law from University of Würzburg (Germany). He is a certified Scrum Master (Inc.) and a CTI-certified coach.&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <button_copy
                                cq:styleIds="[1659997777274]"
                                jcr:created="{Date}2022-12-02T16:28:04.724-05:00"
