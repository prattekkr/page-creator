                                jcr:lastModifiedBy="jewitca"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;body-unica-20-reg&quot;>Matteo joined AbbVie Italy in 2014 as Commercial Finance Controller. In 2017 he was appointed Commercial Business Finance Manager and one year later he moved to AbbVie's Europe Headquarters as HCV Brand Finance Manager and Long-Range Plan Lead and thereafter as Neuroscience Brand Finance Manager. &lt;br>&#xd;&#xa; &lt;br>&#xd;&#xa; Prior to joining AbbVie, Matteo worked for different international pharma companies in Accounting &amp;amp; Tax Management and in a Medical Department as Junior Finance Controller. Matteo holds a Bachelor’s degree in economics from University of Rome, Italy, awarded in 2004.&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <button
                                cq:styleIds="[1659997777274]"
                                jcr:created="{Date}2022-12-02T16:28:04.724-05:00"
