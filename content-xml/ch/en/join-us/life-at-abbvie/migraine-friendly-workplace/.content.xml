                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>The Swiss Headache Society has certified us as a migraine friendly workplace. Those affected find a supportive working environment with us so that they can achieve their full potential.&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                        </container3>
                        <grid_1109957805_copy
                            cq:styleIds="[0,1653545835880]"
                            jcr:created="{Date}2022-12-07T10:56:06.407-05:00"
                            jcr:createdBy="chiucx"
                            jcr:lastModified="{Date}2025-12-16T12:00:27.312-05:00"
