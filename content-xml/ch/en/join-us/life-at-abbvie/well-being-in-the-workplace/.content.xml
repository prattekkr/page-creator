                                jcr:lastModified="{Date}2024-05-10T14:10:30.450-04:00"
                                jcr:lastModifiedBy="jewitca"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Our flexible working methods help us to work as efficiently as possible. &lt;i>Where We Work&lt;/i>, our hybrid working model for office-based employees, offers flexibility that can be planned without restricting personal collaboration. The Swiss model usually involves two to three days in the office and the rest of the days working from home. Depending on the employee's position, other options for flexibility in the workplace include part-time work, working from home, job sharing and much more.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                        </par_13>
