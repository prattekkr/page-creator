                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>Together with myAbility, we are committed to a fair and equitable society. myAbility experts with an in-depth understanding of business create professional solutions for us that have a social impact and are simultaneously economically sustainable. AbbVie Switzerland currently has several employees with disabilities.&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
