                            jcr:primaryType="nt:unstructured"
                            jcr:title="What is an inclusive corporate culture and how do you get there? "
                            sling:resourceType="abbvie-com2/components/title/v2/title"
                            type="h3"
                            variant="h"/>
                        <text
                            cq:styleIds="[1659545825678]"
                            jcr:created="{Date}2023-01-03T18:21:41.037-05:00"
                            jcr:createdBy="schafsm"
                            jcr:lastModified="{Date}2024-07-06T11:13:24.171-04:00"
                            jcr:lastModifiedBy="jewitca"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>myAbility defines an inclusive corporate culture as follows: It gives people equal opportunities to achieve their best performance, regardless of gender, origin, religion, skin colour or disability. This requires an open attitude at all levels and hierarchical levels as well as open and transparent processes when recruiting employees, a holistic diversity&amp;nbsp;&amp;amp;&amp;nbsp;inclusion strategy, accessibility in buildings and also in the IT area, the ability to flexibly adapt working conditions, proactive talent management and a constructive error culture. The aim is to create a company-wide awareness of the issues of diversity and inclusion.&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
                    </container_395792072__733116185>
