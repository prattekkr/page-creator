                            jcr:lastModifiedBy="jewitca"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;ul>&#xd;&#xa;&lt;li>Make people aware of prejudices - especially subconscious ones - and dismantle them.&lt;/li>&#xd;&#xa;&lt;li>Implement changes at a strategic level.&lt;/li>&#xd;&#xa;&lt;li>Build self-confidence and negotiation skills.&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;"
                            textIsRich="true"/>
