                            jcr:lastModified="{Date}2024-07-08T03:59:03.256-04:00"
                            jcr:lastModifiedBy="jewitca"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>(F)empower challenges the status quo and thereby promotes equal opportunities for all employees.&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
