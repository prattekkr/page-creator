                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>The (F)empower initiative was launched to make our working environment even more balanced. The focus is on the development and promotion of leadership skills as well as self-management and personal presentation.&amp;nbsp;&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                        </container3>
