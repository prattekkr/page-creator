                                    brightcoveAutoPlay="false"
                                    btnText="Watch 2:29"
                                    description="&lt;p>At AbbVie, cutting-edge technologies are helping scientists understand disease biology like never before.&lt;/p>&#xd;&#xa;"
                                    descriptiveIframeTitle="How We Innovate with Advanced Technologies"
                                    fileReference="/content/dam/abbvie-com2/images/employee/advance-tech-video-thumbnail.jpg"
