                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/grid/v2/grid"
                                rowCount="1">
                                <columns jcr:primaryType="nt:unstructured">
                                    <item0
                                        jcr:primaryType="nt:unstructured"
                                        columnWidth="11"
                                        dataPriority="1"/>
                                    <item1
                                        jcr:primaryType="nt:unstructured"
                                        columnWidth="1"
                                        dataPriority="1"/>
                                </columns>
                                <par_11
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="wcm/foundation/components/parsys">
                                    <quote
                                        cq:styleIds="[1000000000040,1000000000000]"
                                        jcr:created="{Date}2023-01-31T14:35:03.798-05:00"
                                        jcr:createdBy="mihalsk"
                                        jcr:lastModified="{Date}2024-08-01T08:57:52.154-04:00"
                                        jcr:lastModifiedBy="kaspatx"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="abbvie-com2/components/quote"
                                        attributionName="Jonathon Sedgwick, Ph.D."
                                        attributionTitle="VP and Global Head, Discovery Research, AbbVie"
                                        quote="Turning a discovery into a medicine is an arduous process of trial and error that can take many years. However, it’s the curiosity for the unknown and thirst for knowledge that excites and drives us."
                                        quoteType="regular"
                                        textSize="h0"/>
                                </par_11>
                            </grid>
