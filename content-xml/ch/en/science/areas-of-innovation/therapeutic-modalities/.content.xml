                                sling:resourceType="abbvie-com2/components/container/v2/container">
                                <title_116699496
                                    cq:styleIds="[1661545829678,1659545825678]"
                                    jcr:created="{Date}2022-12-15T11:49:26.700-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2022-12-17T16:34:17.390-05:00"
                                    jcr:lastModifiedBy="chiucx"
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="The therapeutic modalities that lead to novel medicines"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h3"/>
                                <text_copy_copy
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2022-12-07T14:53:09.069-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2022-12-17T16:34:31.940-05:00"
                                    jcr:lastModifiedBy="chiucx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Our work begins with a deep understanding of disease biology. We discover unprecedented insights about human disease through access to patient and genomic data. Once we identify the right target with a strong link to human disease, we turn to our R&amp;amp;D toolbox — a mix of traditional and cutting-edge modalities — to create the best compound for that specific target.&lt;br>&#xd;&#xa;&lt;br>&#xd;&#xa;Our arsenal of therapeutic modalities continues to grow along with advances in innovation and knowledge. We invest in breakthrough platform technologies, AI/ML applications and drug delivery advances, helping us bring better medicines to patients faster.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                            </container_568753235>
                            <grid
                                cq:styleIds="[1653545835880]"
                                jcr:created="{Date}2023-01-31T17:46:50.023-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2023-01-31T17:46:57.322-05:00"
