                            accessibilityLabel="Take a virtual tour"
                            link="https://www.youtube.com/watch?v=_OAIUwyU6mU"/>
                        <separator
                            cq:styleIds="[1662756456518]"
                            jcr:created="{Date}2022-12-18T12:05:49.452-05:00"
                            jcr:createdBy="chiucx"
