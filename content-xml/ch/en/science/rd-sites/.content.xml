                            sling:resourceType="abbvie-com2/components/title/v2/title"
                            type="h4"/>
                        <text2_copy
                            cq:styleIds="[1659545825678,1659545835858]"
                            jcr:lastModified="{Date}2022-12-18T12:09:01.191-05:00"
                            jcr:lastModifiedBy="chiucx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>Our Irvine site is home to our Center of Excellence for aesthetics, neurotoxins, neuro-psychiatry, migraine and eye care research. The 54-acre, 1,000,000-square-foot campus offers unique scientific expertise in the research and development of translational and pharmaceutical sciences to deliver patient-centric, innovative medicines.&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
                        <separator_copy
                            cq:styleIds="[1662756456518]"
                            jcr:created="{Date}2022-12-18T12:05:49.452-05:00"
                            jcr:createdBy="chiucx"
                            jcr:lastModified="{Date}2022-12-18T12:05:49.452-05:00"
                            jcr:lastModifiedBy="chiucx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                        <title2_copy_copy
                            cq:styleIds="[1651545824678,1659545825678]"
                            jcr:lastModified="{Date}2022-12-18T12:09:27.778-05:00"
                            jcr:lastModifiedBy="chiucx"
                            jcr:primaryType="nt:unstructured"
                            jcr:title="South San Francisco, CA"
                            sling:resourceType="abbvie-com2/components/title/v2/title"
                            type="h4"/>
                        <text2_copy_copy
                            cq:styleIds="[1659545825678,1659545835858]"
                            jcr:lastModified="{Date}2023-01-31T15:40:43.131-05:00"
                            jcr:lastModifiedBy="mihalsk"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>The latest addition to our R&amp;amp;D locations, our Bay Area site is the epicenter of our cutting-edge work to advance oncology research. Here, we're evaluating a range of investigational medicines as potential treatments for various types of cancer and accelerating our R&amp;amp;D pipeline in immuno-oncology, tumor targeting, tumor dependencies and precision medicine. AbbVie Bay Area is also home to other functions including data statistics and analytics, medical affairs, patient safety, quality assurance and regulatory affairs.&lt;br>&#xd;&#xa;&lt;br>&#xd;&#xa;This new 48,000-square-foot campus, located in the birthplace of biotech, opens doors to new partnerships and collaboration to advance the next breakthroughs.&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
                        <button_copy
                            cq:styleIds="[1659997777274]"
                            jcr:created="{Date}2023-01-03T12:43:23.660-05:00"
                            jcr:createdBy="chiucx"
