                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;br>&#xd;&#xa;AbbVie's publication of clinical data helps physicians, patients and healthcare providers make informed treatment decisions. Using this data, researchers can more easily build on our research and the research of others to drive scientific progress forward. The publication of the data fulfils the requirements of Articles 71-73 of the Therapeutic Products Ordinance (TPO). This applies to all products that have been authorised by Swissmedic since January 2020.&lt;br>&#xd;&#xa;&lt;br>&#xd;&#xa;&lt;b>Product list, alphabetical, sorted by active ingredient&lt;/b>&lt;/p>&#xd;&#xa;&lt;ul>&#xd;&#xa;&lt;li>&lt;a href=&quot;/content/abbvie-com2/ch/en/science/publication-of-clinical-trials/atogepant-aquipta.html&quot;>Atogepant: Aquipta&lt;/a>&lt;/li>&#xd;&#xa;&lt;li>&lt;a href=&quot;/content/abbvie-com2/ch/en/science/publication-of-clinical-trials/epcoritamab-tepkinly.html&quot;>Epcoritamab: Tepkinly&lt;/a>&lt;/li>&#xd;&#xa;&lt;li>&lt;a href=&quot;/content/abbvie-com2/ch/en/science/publication-of-clinical-trials/mirvetuximab-soravtansine-elahere.html&quot;>Mirvetuximab&lt;i>&amp;nbsp;&lt;/i>soravtansine: Elahere&lt;/a>&lt;/li>&#xd;&#xa;&lt;li>&lt;a href=&quot;/content/abbvie-com2/ch/en/science/publication-of-clinical-trials/upadacitinib-rinvoq.html&quot;>Upadacitinib: Rinvoq&lt;/a>&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;"
