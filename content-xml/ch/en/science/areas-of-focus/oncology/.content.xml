                        <title2_1194237703
                            cq:styleIds="[1659545825678,1651545824678]"
                            jcr:lastModified="{Date}2023-02-11T15:10:23.181-05:00"
                            jcr:lastModifiedBy="chiucx"
                            jcr:primaryType="nt:unstructured"
                            jcr:title="Solid tumors"
                            sling:resourceType="abbvie-com2/components/title/v2/title"
                            type="h4"
                            variant="h"/>
                        <text2_1534592806
                            cq:styleIds="[1659545825678,1659545835858]"
                            jcr:lastModified="{Date}2026-03-02T14:32:51.688-05:00"
                            jcr:lastModifiedBy="VALENSX5"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>We are advancing an innovative solid tumor portfolio that tackles some of the most difficult-to-treat cancers. Our approach is to target novel anti-cancer pathways, using different modalities such as antibody-drug conjugates (ADCs) designed to target protein biomarkers, which are over-expressed across various tumor types, to deliver potent cancer-killing agents called ‘payloads’ to those cells, and immuno-oncology (IO) approaches, that&amp;nbsp;use the body's immune system to fight cancer.&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
                        <separator_165917366__831789195
                            cq:styleIds="[1662756486159]"
                            jcr:created="{Date}2022-12-18T09:21:43.017-05:00"
