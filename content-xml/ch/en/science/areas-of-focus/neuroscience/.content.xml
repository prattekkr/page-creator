                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>We’re delivering science that takes us closer to meaningful change for people with neurological and psychiatric disorders.&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
