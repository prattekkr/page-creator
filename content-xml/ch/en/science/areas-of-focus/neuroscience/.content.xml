                            jcr:lastModified="{Date}2023-02-11T15:13:59.477-05:00"
                            jcr:lastModifiedBy="chiucx"
                            jcr:primaryType="nt:unstructured"
                            jcr:title="Neuroscience and psychiatric focus areas"
                            sling:resourceType="abbvie-com2/components/title/v2/title"
                            type="h4"
                            variant="h"/>
                        <text2
                            cq:styleIds="[1659545825678,1659545835858]"
                            jcr:lastModified="{Date}2022-12-18T09:34:24.296-05:00"
                            jcr:lastModifiedBy="chiucx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>The burden of neurological and psychiatric disorders can feel insurmountable. But that feeling drives us to take on some of the biggest challenges and unearth potential solutions that consider the whole patient.&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
                        <separator_165917366
                            cq:styleIds="[1662756423318]"
                            jcr:created="{Date}2022-12-18T09:21:43.017-05:00"
                            jcr:createdBy="chiucx"
                            jcr:lastModified="{Date}2022-12-18T09:21:43.017-05:00"
                            jcr:lastModifiedBy="chiucx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                        <accordion_copy_copy
                            cq:styleIds="[1,1653545835881]"
                            jcr:created="{Date}2022-12-17T16:25:09.442-05:00"
                            jcr:createdBy="chiucx"
                            jcr:lastModified="{Date}2024-08-02T14:00:39.978-04:00"
                            jcr:lastModifiedBy="jewitca"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/accordion/v2/accordion"
                            heading="Focus areas"
                            headingElement="h5"
                            singleExpansion="false">
                            <item_1671312472873
                                cq:panelTitle="Parkinson's disease"
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2023-01-23T17:20:59.439-05:00"
                                jcr:lastModifiedBy="chiucx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Almost 10 million people worldwide are living with Parkinson’s disease, leaving those affected with muscular rigidity, tremors and cognitive decline. Innovative research aims to investigate ways to improve the standard of care and quality of life.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <item_1671312475801
                                cq:panelTitle="Migraine"
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2022-12-18T09:35:41.375-05:00"
                                jcr:lastModifiedBy="chiucx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>It’s more than just a headache. Impacting 1 billion people around the world, migraine is a neurological disease that causes pain and debilitating symptoms. Our science is helping healthcare providers to care for people across the spectrum of migraine. Through education and partnerships with the migraine community, we strive to help patients and their families navigate barriers to care, access effective treatments and reduce the impact of migraine on their lives.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <item_1671312481387
                                cq:panelTitle="Movement Disorders"
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2022-12-18T09:35:51.629-05:00"
                                jcr:lastModifiedBy="chiucx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Movement disorders are chronic and progressive neurological conditions impacting the body’s ability to control movement. Our commitment to people living with movement disorders is unwavering, evidenced by decades of history in this area of research. Our scientists are developing treatments that mitigate symptoms, with other efforts focused on raising awareness for the importance of prompt diagnosis and management.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                        </accordion_copy_copy>
