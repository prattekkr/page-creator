                                jcr:lastModifiedBy="jewitca"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>We accompany them on their difficult journey - from diagnosis and therapy to patient support programmes. This is how we make a real difference in the lives of those affected - that is AbbVie's aspiration. Our work strengthens the health and quality of life of patients and we assume social responsibility by supporting sustainable initiatives. This brings us ever closer to our goal of a new, better world.&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
