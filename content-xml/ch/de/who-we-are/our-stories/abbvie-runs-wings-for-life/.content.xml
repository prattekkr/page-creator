                                jcr:lastModifiedBy="VALENSX5"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>Am Sonntag, 4. Mai, 2025, war es zu vierten Mal soweit: Ein Team von 47 motivierten Läuferinnen und Läufern von AbbVie Schweiz nahm am Wings for Life World Run in Zug teil. Das Team bestand aus 29 AbbVie Mitarbeitenden, 18 Familienmitgliedern sowie Freundinnen und Freunden. Gemeinsam lief dieses grossartige Team über 630 Kilometer für einen guten Zweck.&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                        </container3>
                    </container2>
                    <grid
                        cq:styleIds="[1653545835880]"
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="abbvie-com2/components/grid/v2/grid"
                        rowCount="1">
                        <columns jcr:primaryType="nt:unstructured">
                            <item0
