                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Der Kurs bestand in erster Linie aus praktischen Übungen und einer Theorieeinheit zu Beginn. Um eine enge Betreuung durch die beiden Kursleiterinnen des Chamer Samaritervereins zu ermöglichen, wurden die Teilnehmenden in kleine Gruppen aufgeteilt, damit jede Übung aufmerksam begleitet werden konnte.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <separator_1894724708
