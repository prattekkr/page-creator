                                jcr:lastModifiedBy="jewitca"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="Weitere Informationen"
                                sling:resourceType="abbvie-com2/components/button/v2/button"
                                accessibilityLabel="Weitere Informationen"
                                linkTarget="_blank"
                                linkURL="https://www.abbvie.com/who-we-are/equity-equality-inclusion-diversity/impact-through-inclusion.html"/>
                        </par_12>
