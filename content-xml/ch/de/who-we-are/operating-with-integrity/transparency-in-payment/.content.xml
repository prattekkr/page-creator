                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>Bei Kooperationen im Gesundheitswesen handeln wir stets ethisch, transparent und in Übereinstimmung mit den Schweizer Gesetzen, Vorschriften und Pflichten des Branchenverbands.&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
