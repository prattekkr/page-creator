                                jcr:title="Unser Engagement für ethischen und verantwortungsvollen Umgang mit Tieren in der Forschung"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h1"
                                variant="h"/>
                            <text
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2025-06-04T12:04:52.527-04:00"
                                jcr:lastModifiedBy="VALENSX5"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>AbbVie hat es sich zur Aufgabe gemacht, innovative Arzneimittel und Lösungen für komplexe Gesundheitsprobleme zu entwickeln und bereitzustellen, um das Leben der Menschen zu verbessern. In diesem Bestreben halten wir die höchsten Standards für den ethischen Umgang mit Tieren in der Forschung ein.&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_copy_copy_
                                cq:styleIds="[1662756456518]"
                                jcr:created="{Date}2022-12-05T12:22:48.644-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2022-12-05T12:22:48.644-05:00"
                                jcr:lastModifiedBy="chiucx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <text_copy_copy
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2022-12-05T18:02:53.586-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2025-11-04T03:43:16.514-05:00"
                                jcr:lastModifiedBy="kaspatx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Unser Engagement spiegelt sich in der Einhaltung der Vorschriften der internationalen Aufsichtsbehörden wider, etwa der Swissmedic, der US-amerikanischen Food and Drug Administration&amp;nbsp;(FDA) und der Europäischen Arzneimittel-Agentur&amp;nbsp;(EMA). Diese Behörden schreiben vor, dass neue Arzneimittel und Medizinprodukte einer Sicherheits- und Wirksamkeitsprüfung unterzogen werden, was Tierversuche erforderlich machen kann.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                        </container3>
                    </container2>
                    <grid_copy_copy_18801
                        cq:styleIds="[0]"
