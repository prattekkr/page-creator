                                    sling:resourceType="abbvie-com2/components/accordion/v2/accordion"
                                    heading="ERFAHREN SIE MEHR DARÜBER WIE WIR DAS 3R-PRINZIP VORANTREIBEN "
                                    singleExpansion="false">
                                    <item_1719341280978
