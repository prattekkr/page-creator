                                    sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                                <title_116699496_copy_2005055571
                                    cq:styleIds="[1659545825678,1661545829678,1651545825693]"
                                    jcr:created="{Date}2022-12-15T11:49:26.700-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2025-06-04T12:05:29.592-04:00"
                                    jcr:lastModifiedBy="VALENSX5"
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="Bekenntnis zum 3R-Prinzip"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h2"
                                    variant="h"/>
                                <text_copy_copy_copy_
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2022-12-07T14:53:09.069-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2025-06-04T12:05:38.146-04:00"
                                    jcr:lastModifiedBy="VALENSX5"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Im Mittelpunkt unserer wissenschaftlichen Tätigkeit stehen die international anerkannten Grundsätze des «3R-Prinzips»:&lt;/p>&#xd;&#xa;&lt;ul>&#xd;&#xa;&lt;li>&lt;b>Vermeidung&amp;nbsp;(Replacement)&lt;/b>: Ersetzen von Tierversuchen durch Methoden ohne Tiere oder mit empfindungslosen Alternativen.&lt;/li>&#xd;&#xa;&lt;li>&lt;b>Verminderung&amp;nbsp;(Reduction)&lt;/b>: Reduzieren der Anzahl der Tiere, um die Forschungsziele zu erreichen.&lt;/li>&#xd;&#xa;&lt;li>&lt;b>Verbesserung&amp;nbsp;(Refinement)&lt;/b>: Wenn Tiere eingesetzt werden müssen, ändern wir Verfahren, um das Potenzial für Schmerzen und/oder Leid zu minimieren.&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;&lt;p>Die AbbVie-Forschungsteams arbeiten kontinuierlich daran, das 3R-Prinzip innerhalb unserer Programme voranzutreiben. Dazu setzen sie Techniken wie anatomische Modelle aus dem 3D-Drucker, künstliche Gewebe, mikrophysiologische Systeme&amp;nbsp;(z.&amp;nbsp;B. «Organ-on-a-Chip»), digitale Biomarker und andere Computer-Modellierungstechniken sowie zellbasierte Assays ein.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <separator_copy_copy_1689911009
                                    cq:styleIds="[1662756423318]"
                                    jcr:created="{Date}2024-06-07T14:48:37.428-04:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2024-06-07T14:48:37.428-04:00"
                                    jcr:lastModifiedBy="chiucx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                                <accordion
                                    cq:styleIds="[1,8]"
                                    jcr:created="{Date}2024-06-07T15:02:02.081-04:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2025-06-04T12:06:09.460-04:00"
                                    jcr:lastModifiedBy="VALENSX5"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/accordion/v2/accordion"
                                    heading="BEISPIELE FÜR UNSERE WISSENSCHAFTLICHEN ANSTRENGUNGEN "
                                    singleExpansion="false">
                                    <item_1717786996968
                                        cq:panelTitle="Maschinelles Lernen und Big Data "
                                        cq:styleIds="[1659545825678]"
                                        jcr:lastModified="{Date}2025-06-04T12:06:27.301-04:00"
                                        jcr:lastModifiedBy="VALENSX5"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="abbvie-com2/components/text/v2/text"
                                        text="&lt;p>Die AbbVie-Forschungsteams setzen maschinelles Lernen und Big Data ein, um die Untersuchung der Toxizität von Arzneimitteln zu verbessern&amp;nbsp;– ein wichtiger Aspekt der Arzneimittelentwicklung. Sie setzen Methoden des maschinellen Lernens ein, um grosse Toxikologie-Datensätze zu analysieren und so die allfällige Toxizität von Arzneimitteln frühzeitig zu erkennen. Dies verkürzt die Entwicklungszeiten und verbessert die Sicherheit und Wirksamkeit von Arzneimitteln. &lt;a href=&quot;https://pubmed.ncbi.nlm.nih.gov/30040226/&quot; target=&quot;_blank&quot;>Mehr erfahren&lt;/a>&lt;/p>&#xd;&#xa;"
                                        textIsRich="true"/>
                                    <item_1717787010304
                                        cq:panelTitle="Organoide"
                                        cq:styleIds="[1659545825678]"
                                        jcr:lastModified="{Date}2025-06-04T12:06:49.381-04:00"
                                        jcr:lastModifiedBy="VALENSX5"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="abbvie-com2/components/text/v2/text"
                                        text="&lt;p>Forschende haben bei AbbVie eine Methode entwickelt, um Zellen aus dem menschlichen Dickdarm im Labor zu züchten und zu untersuchen und dabei deren Verhalten im menschlichen Körper zu modellieren. Anhand dieser «Organoid»-Kulturen können Krankheiten wie entzündliche Darmerkrankungen studiert werden. Sie können die Grundlage für die Entwicklung neuer Therapien bilden. &lt;a href=&quot;https://pubmed.ncbi.nlm.nih.gov/33643277/&quot; target=&quot;_blank&quot;>Mehr erfahren&lt;/a>&lt;/p>&#xd;&#xa;"
                                        textIsRich="true"/>
                                    <item_1717787020064
                                        cq:panelTitle="Zellbasierter Wirksamkeitstest "
                                        cq:styleIds="[1659545825678]"
                                        jcr:lastModified="{Date}2025-07-15T10:40:14.383-04:00"
                                        jcr:lastModifiedBy="VALENSX5"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="abbvie-com2/components/text/v2/text"
                                        text="&lt;p>Im Juni&amp;nbsp;2011 erteilte uns die FDA die Zulassung für einen zellbasierten In-vitro-Test ohne Tierversuche zur Prüfung der Produktfreigabe eines der Neurotoxine von AbbVie.&lt;/p>&#xd;&#xa;"
                                        textIsRich="true"/>
                                </accordion>
                                <accordion_1663597195
                                    cq:styleIds="[1]"
                                    jcr:created="{Date}2024-06-25T14:47:51.391-04:00"
                                    jcr:createdBy="chiucx"
