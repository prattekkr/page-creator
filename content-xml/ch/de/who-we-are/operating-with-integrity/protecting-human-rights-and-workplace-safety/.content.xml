                                jcr:primaryType="nt:unstructured"
                                jcr:title="Menschenrechte zu respektieren steht im Mittelpunkt unserer Integrität und unserer Geschäftstätigkeit"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h3"
                                variant="h"/>
                            <text
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2022-12-09T17:34:50.014-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2023-12-02T03:34:49.074-05:00"
                                jcr:lastModifiedBy="jewitca"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>AbbVie achtet die jedem Menschen innewohnende Würde und respektiert die individuellen Rechte gemäss der Allgemeinen Erklärung der Menschenrechte. Diese Grundsätze werden in den Grundprinzipien unseres Unternehmens und in unserer Mission widergespiegelt, grössten medizinischen Herausforderungen zu begegnen.&lt;/p>&#xd;&#xa;&lt;p>Durch unsere Policies zu Beschäftigung, Ethik und Beschaffung tragen wir zur Umsetzung der Menschenrechte bei. Unsere Verfahren und Programme sorgen nicht nur für die Einhaltung der Gesetze und Vorschriften an den Standorten, an denen wir tätig sind, sondern beziehen auch alle von Mitarbeitenden geäusserten Bedenken hinsichtlich des Arbeitsplatzes mit ein.&amp;nbsp;&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <button
                                cq:styleIds="[1659997756584]"
                                jcr:created="{Date}2022-12-09T18:43:51.023-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2024-03-02T11:06:03.130-05:00"
                                jcr:lastModifiedBy="jewitca"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="Weitere Informationen zu unserem Engagement"
                                sling:resourceType="abbvie-com2/components/button/v2/button"
                                accessibilityLabel="Lesen Sie unser Engagement"
                                linkTarget="_blank"
                                linkURL="/content/dam/abbvie-com2/pdfs/about/our-commitment-to-human-rights.pdf"/>
                        </par_13>
