                            jcr:primaryType="nt:unstructured"
                            jcr:title="Die Sicherheit unserer Mitarbeitenden am Arbeitsplatz steht für uns an erster Stelle"
                            sling:resourceType="abbvie-com2/components/title/v2/title"
                            type="h3"
                            variant="h"/>
                        <text_copy_copy_copy
                            cq:styleIds="[1659545825678]"
                            jcr:created="{Date}2022-11-07T18:20:48.523-05:00"
                            jcr:createdBy="chiucx"
                            jcr:lastModified="{Date}2023-12-02T03:36:47.653-05:00"
                            jcr:lastModifiedBy="jewitca"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>&lt;i style=&quot;font-size: 0.8125rem;&quot;>«Zero. Believe It. Achieve It.»&lt;/i> ist unsere Philosophie, an der wir uns bei der Sicherheit am Arbeitsplatz orientieren. Diese Philosophie basiert auf der Annahme, dass mit einer präventiven Denkweise jeder Umwelt‑, Gesundheits‑ und Sicherheitsvorfall vermeidbar ist.&lt;br>&#xd;&#xa;&lt;/p>&#xd;&#xa;&lt;p>Wir bieten allen Mitarbeitenden umfassende Schulungen zum Thema Sicherheit am Arbeitsplatz an&amp;nbsp;– und die Ergebnisse sprechen für sich. Seit unserer Unternehmensgründung als unabhängiges Unternehmen haben wir im &lt;a href=&quot;https://www.spglobal.com/esg/performance/indices/&quot; target=&quot;_blank&quot;>Dow Jones Sustainability Index&lt;/a> (DJSI) im Bereich Gesundheit und Sicherheit am Arbeitsplatz eine führende Position in der gesamten Biotechnologiebranche. Unsere Raten an meldepflichtigen Vorfällen und Vorfällen mit Ausfallzeiten gehören zu den niedrigsten in der Branche, gemessen anhand von Daten der Pharmaceutical Safety Group, einem Branchenkonsortium.&amp;nbsp;&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
                    </container_195460670>
