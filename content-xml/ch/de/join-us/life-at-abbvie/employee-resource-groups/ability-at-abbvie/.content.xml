                                jcr:lastModified="{Date}2024-07-26T16:29:56.965-04:00"
                                jcr:lastModifiedBy="jewitca"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Weltweit leben 15 Prozent der Bevölkerung mit einer Behinderung; allein im deutschsprachigen Raum sind das 15,6 Millionen Menschen. Die Realität ist leider noch immer so, dass Menschen mit Behinderungen und chronischen Erkrankungen weniger Chancen am Arbeitsmarkt erhalten und nicht vollen Zugang zu vielen Produkten und Services haben. Inklusion kann nur dann zum Alltag werden, wenn Unternehmen verstehen, dass sie sich wirtschaftlich lohnt.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
