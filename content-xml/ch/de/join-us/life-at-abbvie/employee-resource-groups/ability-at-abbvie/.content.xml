                            jcr:title="Wir verbinden Arbeit mit sozialer Wirkung "
                            sling:resourceType="abbvie-com2/components/title/v2/title"
                            type="h3"
                            variant="h"/>
                        <text_1267575280
                            cq:styleIds="[1659545825678]"
                            jcr:created="{Date}2023-01-03T21:35:33.225-05:00"
                            jcr:createdBy="schafsm"
                            jcr:lastModified="{Date}2024-07-26T16:27:10.856-04:00"
                            jcr:lastModifiedBy="jewitca"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>Gemeinsam mit myAbility setzen wir uns für eine chancengerechte und faire Gesellschaft ein. Die myAbility-Expertinnen und -Experten schaffen mit ausgeprägtem wirtschaftlichem Verständnis professionelle Lösungen für uns, die eine soziale Wirkung haben und gleichzeitig wirtschaftlich nachhaltig sind. Aktuell arbeiten bei AbbVie Schweiz mehrere Mitarbeitende mit Einschränkungen.&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
                        <button
                            cq:styleIds="[1659997777274]"
