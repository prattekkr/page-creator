                            jcr:primaryType="nt:unstructured"
                            jcr:title="Was ist eine inklusive Unternehmenskultur und wie kommt man da hin?  "
                            sling:resourceType="abbvie-com2/components/title/v2/title"
                            type="h3"
                            variant="h"/>
                        <text
                            cq:styleIds="[1659545825678]"
                            jcr:created="{Date}2023-01-03T18:21:41.037-05:00"
                            jcr:createdBy="schafsm"
                            jcr:lastModified="{Date}2024-07-26T16:28:58.722-04:00"
                            jcr:lastModifiedBy="jewitca"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>myAbility definiert eine inklusive Unternehmenskultur folgendermassen: Sie ermöglicht den Menschen unabhängig von Geschlecht, Herkunft, Religion, Hautfarbe oder Behinderungen Chancengerechtigkeit, um ihre beste Leistung abzurufen. Das setzt eine offene Haltung auf allen Ebenen und Hierarchiestufen voraus sowie offene und transparente Prozesse beim Recruiting von Mitarbeitenden, eine ganzheitliche Diversitäts&amp;amp;Inklusions-Strategie, Barrierefreiheit in Gebäuden sowie auch im IT-Bereich, Möglichkeit zur flexiblen Anpassung der Arbeitsbedingungen, ein proaktives Talent-Management und eine konstruktive Fehlerkultur. Das Ziel ist, ein unternehmensweites Bewusstsein für die Themen Diversität und Inklusion zu schaffen.&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
                    </container_395792072__733116185>
