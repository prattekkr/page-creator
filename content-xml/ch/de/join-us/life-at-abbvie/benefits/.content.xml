                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>Arbeiten bei AbbVie Schweiz eröffnet Ihnen alle Vorzüge eines weltweit erfolgreichen Biopharma-Unternehmens. Wir schaffen für unsere Mitarbeitenden gute Rahmenbedingungen, damit sie sich beruflich und persönlich entfalten können. Nutzen Sie Ihre Chance und lernen Sie ein besonderes Unternehmen mit einem einzigartigen Arbeitsumfeld kennen.&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
