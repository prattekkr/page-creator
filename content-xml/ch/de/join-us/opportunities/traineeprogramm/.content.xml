                            jcr:primaryType="nt:unstructured"
                            jcr:title="Erfolg bedeutet im Idealfall eine gemeinsame Zukunft"
                            sling:resourceType="abbvie-com2/components/title/v2/title"
                            type="h2"
                            variant="h"/>
                        <text_copy
                            cq:styleIds="[1659545825678]"
                            jcr:created="{Date}2024-03-11T01:12:08.599-04:00"
                            jcr:createdBy="jewitca"
                            jcr:lastModified="{Date}2024-08-23T10:42:05.022-04:00"
                            jcr:lastModifiedBy="kaspatx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>Seit dem Start des Trainee-Programms im Juni 2016 haben wir viele Erfolge verzeichnen können: Neun von zehn Trainees wurden nach dem Programmabschluss bei AbbVie fest angestellt – zum Beispiel, als Brand Manager, Medical Science Liaison, Business Finance Manager oder Market Access Manager.&lt;/p>&#xd;&#xa;&lt;p>Als junges und dynamisches Unternehmen sind wir stets auf der Suche nach motivierten Talenten, die zu unserer offenen Unternehmenskultur passen.&lt;/p>&#xd;&#xa;&lt;p>Hier findest du zwei Kurzinterviews von ehemaligen Trainees:&lt;/p>&#xd;&#xa;&lt;p>&lt;a href=&quot;https://www.abbvie.ch/content/dam/abbvie-dotcom/ch/documents/interview-romina-cabra.pdf&quot; target=&quot;_blank&quot;>Interview Romina Cabra&lt;/a>&lt;br>&#xd;&#xa;&lt;a href=&quot;https://www.abbvie.ch/content/dam/abbvie-dotcom/ch/documents/interview-joana-herter.pdf&quot; target=&quot;_blank&quot;>Interview Joana Herter&lt;/a>&lt;/p>&#xd;&#xa;&lt;p>Die Termine für das nächste Traineeprogramm werden in Kürze hier bekanntgegeben.&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
