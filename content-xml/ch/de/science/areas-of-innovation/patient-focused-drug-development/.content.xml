                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>Patientinnen und Patienten sind der Grund für unsere Leidenschaft, neue Ansätze zu entwickeln, die helfen, den Versorgungsstandard bei Erkrankungen mit hohem, ungedeckten medizinischem Bedarf voranzubringen.&amp;nbsp;&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
