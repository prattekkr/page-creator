                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="Wie wir Innovationen im Interesse der Patientinnen und Patienten in die Tat umsetzen:"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h3"
                                    variant="h"/>
                                <separator_485085862
