                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>&lt;span class=&quot;body-unica-14-reg&quot;>&lt;span class=&quot;body-unica-16-reg&quot;>Expertinnen und Experten von AbbVie erläutern, wie die Ärzteschaft, Computerwissenschaftler, Datenwissenschaftlerinnen, Technologieexperten und andere gemeinsam daran arbeiten, Informationssilos in der Gesundheitsversorgung zu beseitigen.&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;&lt;p>&lt;span class=&quot;body-unica-14-reg&quot;>Dieses Video ist nur in Englisch verfügbar.&lt;/span>&lt;/p>&#xd;&#xa;"
