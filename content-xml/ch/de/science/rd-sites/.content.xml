                        <title2_copy_copy_cop_1811634085
                            cq:styleIds="[1659545825678,1651545824678]"
                            jcr:lastModified="{Date}2024-03-03T22:17:35.462-05:00"
                            jcr:lastModifiedBy="jewitca"
                            jcr:primaryType="nt:unstructured"
                            jcr:title="Tokio, Japan"
                            sling:resourceType="abbvie-com2/components/title/v2/title"
                            type="h4"
                            variant="h"/>
                        <text2_copy_copy_copy_1838308187
                            cq:styleIds="[1659545825678,1659545835858]"
                            jcr:lastModified="{Date}2024-05-16T09:12:28.142-04:00"
                            jcr:lastModifiedBy="kaspatx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>Unser Forschung&amp;amp;Entwicklungs‑Standort in Tokio verfügt über alle Kompetenzen für die klinische Entwicklung. Um für Patientinnen und Patienten in Japan NDA‑Zulassungen für Produkte von AbbVie zu erhalten, führen wir von Phase&amp;nbsp;I bis Phase&amp;nbsp;IV Studien parallel durch. Wir führen strategische klinische Planung in jedem Schwerpunktbereich durch, um die japanspezifische Entwicklungsstrategie für Onkologie, Immunologie, Neurologie, Specialty, Augenheilkunde und ästhetische Medizin auszubauen.&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
                    </container4_copy_copy>
