                            type="h4"
                            variant="h"/>
                        <text2_copy
                            cq:styleIds="[1659545825678,1659545835858]"
                            jcr:lastModified="{Date}2024-05-16T08:46:31.655-04:00"
                            jcr:lastModifiedBy="kaspatx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>An unserem Standort in Irvine befindet sich unser Center of Excellence für ästhetische Medizin, Neurotoxine, Neuropsychiatrie, Migräne und Augenheilkunde. Die Einrichtung auf einem Gelände von knapp 22&amp;nbsp;Hektaren beherbergt einzigartige wissenschaftliche Kompetenzen in der Erforschung&amp;amp;Entwicklung translationaler und pharmazeutischer Wissenschaft, um patientenorientierte, innovative Arzneimittel bereitzustellen.&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
                        <separator_copy
                            cq:styleIds="[1662756456518]"
                            jcr:created="{Date}2022-12-18T12:05:49.452-05:00"
                            jcr:createdBy="chiucx"
                            jcr:lastModified="{Date}2022-12-18T12:05:49.452-05:00"
