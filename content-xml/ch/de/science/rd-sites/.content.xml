                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>Das Cambridge Research Center von AbbVie ist eine knapp 4‘000&amp;nbsp;Quadratmeter grosse Einrichtung im Biotech-Zentrum von Cambridge, Massachusetts. In diesem Forschungszentrum widmen sich unsere Wissenschaftlerinnen und Wissenschaftler dem Verständnis der biologischen Mechanismen, die neurodegenerativen Erkrankungen (insbesondere Alzheimer und Parkinson) sowie immunvermittelten Erkrankungen zugrunde liegen.&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
