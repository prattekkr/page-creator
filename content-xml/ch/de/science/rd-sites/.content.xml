                            jcr:title="Virtuelle Tour"
                            sling:resourceType="abbvie-com2/components/button/v2/button"
                            accessibilityLabel="Take a virtual tour"
                            linkTarget="_blank"
                            linkURL="https://www.youtube.com/watch?v=bUG4YYs3mEo&amp;list=PLsE-xBrNzbYMPlV7rx4N4fHWyS4CFxSlr&amp;index=7"/>
                        <separator_copy_copy__1295710755
                            cq:styleIds="[1662756456518]"
                            jcr:created="{Date}2022-12-18T12:05:49.452-05:00"
