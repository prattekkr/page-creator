                        <title2_copy_copy_cop_589941422
                            cq:styleIds="[1659545825678,1651545824678]"
                            jcr:lastModified="{Date}2024-03-03T22:15:30.762-05:00"
                            jcr:lastModifiedBy="jewitca"
                            jcr:primaryType="nt:unstructured"
                            jcr:title="Worcester, Massachusetts"
                            sling:resourceType="abbvie-com2/components/title/v2/title"
                            type="h4"
                            variant="h"/>
                        <text2_copy_copy_copy_1566281083
                            cq:styleIds="[1659545825678,1659545835858]"
                            jcr:lastModified="{Date}2024-03-03T22:15:51.032-05:00"
                            jcr:lastModifiedBy="jewitca"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>Seit über 30&amp;nbsp;Jahren ist das Bioresearch Center von AbbVie in Worcester, Massachusetts, branchenführend in den Bereichen Arzneimittelforschung, Development Sciences und Biologikaforschung. In dieser 51‘375&amp;nbsp;Quadratmeter grossen Einrichtung arbeiten wir in erster Linie an der Entwicklung von Biotherapeutika und der Erforschung innovativer Lösungen für einige der komplexesten Herausforderungen in der Medizin, darunter Immunologie und Neurologie.&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
                        <button_copy_13254203
                            cq:styleIds="[1659997777274]"
                            jcr:created="{Date}2023-01-03T12:43:23.660-05:00"
                            jcr:createdBy="chiucx"
                            jcr:lastModified="{Date}2024-06-10T15:11:51.418-04:00"
