                        <title2_copy_copy
                            cq:styleIds="[1659545825678,1651545824678]"
                            jcr:lastModified="{Date}2024-03-03T22:12:37.324-05:00"
                            jcr:lastModifiedBy="jewitca"
                            jcr:primaryType="nt:unstructured"
                            jcr:title="South San Francisco, Kalifornien"
                            sling:resourceType="abbvie-com2/components/title/v2/title"
                            type="h4"
                            variant="h"/>
                        <text2_copy_copy
                            cq:styleIds="[1659545825678,1659545835858]"
                            jcr:lastModified="{Date}2024-05-16T08:48:21.227-04:00"
                            jcr:lastModifiedBy="kaspatx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>Als neueste Ergänzung unserer Forschung&amp;amp;Entwicklung‑Standorte ist die Bay Area das Epizentrum unserer wegweisenden Arbeit in der Onkologieforschung. Hier beurteilen wir die Eignung verschiedener Prüfpräparate als potenzielle Behandlungsoptionen für zahlreiche Krebsarten und bauen unsere Forschung&amp;amp;Entwicklung‑Pipeline in den Bereichen Immun-Onkologie, Tumor Targeting, Abhängigkeiten von Tumoren und Präzisionsmedizin aus. Weitere Aufgaben am Standort Bay Area sind unter anderem Datenstatistik und ‑analytik, Medical Affairs, Patientensicherheit, Qualitätssicherung und Regulatory Affairs.&lt;/p>&#xd;&#xa;&lt;p>Im Geburtsort der Biotechnologie öffnet dieser auf 4‘460&amp;nbsp;Quadratmetern neu errichtete Standort Türen für neue Partnerschaften und Kooperationen, um so den Weg für weitere Erfolge zu ebnen.&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
