                            jcr:primaryType="nt:unstructured"
                            jcr:title="Ist Schuppenflechte heilbar?"
                            sling:resourceType="abbvie-com2/components/title/v2/title"
                            type="h4"
                            variant="h"/>
                        <text_copy_copy_copy__666476140
                            cq:styleIds="[1659545825678]"
                            jcr:created="{Date}2024-01-28T16:16:54.528-05:00"
                            jcr:createdBy="jewitca"
                            jcr:lastModified="{Date}2024-01-30T16:02:45.497-05:00"
                            jcr:lastModifiedBy="jewitca"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>Schuppenflechte ist bisher nicht heilbar. Mit der entsprechenden Therapie haben Betroffene oft lange Zeit kaum sichtbare Zeichen auf ihrer Haut.&lt;/p>&#xd;&#xa;&lt;p>Weitere Informationen zu Schuppenflechte gibt es auf&amp;nbsp;&lt;a href=&quot;https://www.spvg.ch/home&quot; target=&quot;_blank&quot;>https://www.spvg.ch/home&lt;/a>&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
                        <separator_copy
