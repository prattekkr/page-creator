                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>In der Schweiz leiden rund 25’000 Menschen an chronisch-entzündlichen Darmerkrankungen (CED).&amp;nbsp;Die Krankheiten sind bisher nicht heilbar, jedoch gut behandelbar.&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
