                                jcr:lastModifiedBy="jewitca"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>Häufig tritt diese Entzündung des Auges in Begleitung einer anderen Erkrankung auf. Unbehandelt kann die Erkrankung das Auge dauerhaft schädigen. Innovative Therapien helfen, Uveitis in den Griff zu bekommen&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
