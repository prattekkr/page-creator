                                jcr:lastModifiedBy="jewitca"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>Der retinale Venenverschluss wird auch «Schlaganfall im Auge» genannt. Patienten mit einem venösen Verschluss klagen über schmerzlosen, plötzlichen Sehverlust oder optische Verzerrungen. Unbehandelt kann der Venenverschluss in schweren Fällen in nur wenigen Monaten zur Erblindung führen.&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                        </container3>
                    </container2>
                    <grid_copy_copy_copy_
                        cq:styleIds="[0,1653545835880]"
