                            <text
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2024-03-10T14:15:13.027-04:00"
                                jcr:lastModifiedBy="jewitca"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>Beim Grünen Star (Glaukom) handelt es sich um eine Erkrankung des Sehnervs und der Netzhautnerven-Faserschicht. Das Glaukom ist weltweit verbreitet. Man schätzt, dass ca. 70 Millionen Menschen an einem Glaukom leiden, wovon die Hälfte sich dessen nicht bewusst ist. Man nimmt an, dass etwa 2,5% aller über 40-Jährigen in der Schweiz an einem Glaukom leiden.&amp;nbsp;Grüner Star ist weltweit und auch in der Schweiz eine der Hauptursachen für Erblindung bei Menschen über 60 Jahren.&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                        </container3>
                    </container2>
                    <grid_copy_copy_copy_
                        cq:styleIds="[0,1653545835880]"
                        jcr:created="{Date}2022-12-16T16:39:47.272-05:00"
