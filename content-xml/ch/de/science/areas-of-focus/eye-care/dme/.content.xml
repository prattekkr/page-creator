                            <text
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2024-03-10T13:57:11.397-04:00"
                                jcr:lastModifiedBy="jewitca"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>Das Diabetische Makulaödem ist eine Folgeerkrankung von Diabetes mellitus. In der Schweiz sind rund 35’000 Diabetespatienten von einem Diabetischen Makulaödem betroffen. Unbehandelt führt die Erkrankung bis zur Erblindung. Die Erkrankung ist nicht heilbar, kann aber sehr gut behandelt werden.&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                        </container3>
                    </container2>
