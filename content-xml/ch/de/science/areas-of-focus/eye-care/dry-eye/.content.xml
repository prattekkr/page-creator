                            <text
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2024-03-10T14:26:09.724-04:00"
                                jcr:lastModifiedBy="jewitca"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>Das trockene Auge ist die häufigste Erkrankung in der Augenheilkunde. Etwa ein Sechstel der Bevölkerung in Mitteleuropa und Nordamerika ist davon betroffen. Im Asiatischen Raum ist die Häufigkeit mit einem Drittel der Bevölkerung noch höher. Häufig sind Frauen und ältere Personen vom trockenen Auge betroffen. Die Erkrankung beginnt meist schleichend, weshalb nicht jedes trockene Auge gleich erkannt wird.&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                        </container3>
                    </container2>
                    <grid_copy_copy_copy_
                        cq:styleIds="[0,1653545835880]"
