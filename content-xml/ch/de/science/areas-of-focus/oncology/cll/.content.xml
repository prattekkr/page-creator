                            jcr:primaryType="nt:unstructured"
                            jcr:title="CLL in Schweiz "
                            sling:resourceType="abbvie-com2/components/title/v2/title"
                            type="h2"
                            variant="h"/>
                        <text_249790517
                            cq:styleIds="[1659545825678]"
                            jcr:created="{Date}2024-03-12T22:37:18.828-04:00"
                            jcr:createdBy="jewitca"
                            jcr:lastModified="{Date}2024-03-12T22:39:31.750-04:00"
                            jcr:lastModifiedBy="jewitca"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>In der Schweiz erkranken jedes Jahr etwa 550 Menschen an einer chronischen lymphatischen Leukämie. Männer sind häufiger betroffen als Frauen; die Betroffenen sind meist in einem fortgeschrittenen Alter zwischen 70 und 75 Jahren.&lt;/p>&#xd;&#xa;&lt;p>Die Ursachen einer CLL sind noch unklar. Neben dem Alter werden als Risikofaktoren gewisse Schadstoffe wie Asbest oder Pestizide diskutiert.&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
                        <separator
                            cq:styleIds="[1662756456518]"
                            jcr:created="{Date}2024-03-12T22:36:48.231-04:00"
                            jcr:createdBy="jewitca"
                            jcr:lastModified="{Date}2024-03-12T22:36:48.231-04:00"
