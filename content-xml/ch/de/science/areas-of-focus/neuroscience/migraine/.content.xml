                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>Laut der Weltgesundheitsorganisation gehört die Migräne zu den am stärksten einschränkenden Erkrankungen. In der Schweiz sind in etwa 1 Million Menschen von Migräne betroffen.&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
