                                jcr:lastModifiedBy="jewitca"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>Morbus Parkinson zählt zu den häufigsten Erkrankungen des Nervensystems. In der Schweiz sind schätzungsweise rund 15’000 Menschen davon betroffen. Die Krankheit beginnt meist schleichend und bleibt oft über viele Jahre unentdeckt.&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                        </container3>
                    </container2>
                    <container_344669232
                        cq:styleIds="[1653545825688]"
                        jcr:created="{Date}2024-01-28T16:16:39.965-05:00"
                        jcr:createdBy="jewitca"
