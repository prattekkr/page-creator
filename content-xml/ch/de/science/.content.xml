                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>Unsere Forschung&amp;amp;Entwicklungs‑Teams bei AbbVie haben sich sehr anspruchsvolle Ziele gesetzt: Therapien und Lösungen entwickeln, an die sich bisher niemand sonst herangewagt hat. Wir wollen die Ersten sein. Das ist das Ziel, das wir jeden Tag für unsere Patientinnen und Patienten verfolgen.&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
