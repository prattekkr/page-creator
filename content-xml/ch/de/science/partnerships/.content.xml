                        </par_11>
                        <par_13
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="wcm/foundation/components/parsys">
                            <title
                                cq:styleIds="[1659545825678,1661545829678]"
                                jcr:created="{Date}2023-01-04T12:55:15.469-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2024-06-12T04:04:20.721-04:00"
                                jcr:lastModifiedBy="kaspatx"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="Unser Ansatz: Partnerschaften aufbauen, die einen echten Unterschied machen"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h3"
                                variant="h"/>
                            <text
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2023-01-04T12:56:00.281-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2024-05-21T08:55:06.826-04:00"
                                jcr:lastModifiedBy="kaspatx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Mit unseren Partnerschaften wollen wir bei AbbVie zwei entscheidende Dinge erreichen: Innovative Arzneimittel bereitstellen und einen echten Unterschied im Leben der Menschen machen.&lt;/p>&#xd;&#xa;&lt;p>Wir verfolgen einen hoch integrierenden Ansatz bei der Entwicklung und Aufrechterhaltung unserer Partnerschaften. Wir arbeiten gemeinsam als eine Einheit und engagieren uns für die Partnerschaften über den gesamten Entwicklungsprozess hinweg, davon profitieren die Partnerinnen und Partner und dadurch treiben wir den wissenschaftlichen Fortschritt voran.&lt;/p>&#xd;&#xa;&lt;p>Unser Ziel ist es, langfristige Beziehungen aufzubauen, von denen beide Seiten profitieren. Mit einer gemeinsamen Vision als Grundlage bündeln wir unsere kollektiven Kompetenzen im Dienst einer gemeinsamen Mission: Innovative Arzneimittel zur Behandlung schwerwiegender Erkrankungen entwickeln und die medizinischen Herausforderungen von morgen angehen.&lt;/p>&#xd;&#xa;&lt;p>Von Anfang an sorgen wir dafür, dass alle&amp;nbsp;– von den Teams bis hin zur Unternehmensleitung&amp;nbsp;– die Assets kennen, die wir gemeinsam entwickeln, und sich dafür einsetzen, diese zu fördern. Wir stellen unsere Partnerschaften auf Erfolg ein&amp;nbsp;– von der frühzeitigen Erkennung und Minderung der Risiken bis zur gemeinsamen Verantwortung und Anerkennung für erfolgreiche Ergebnisse.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator
                                cq:styleIds="[1662756423318]"
                                jcr:created="{Date}2023-01-04T13:13:17.451-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2023-01-04T13:13:17.451-05:00"
                                jcr:lastModifiedBy="chiucx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <title_copy
                                cq:styleIds="[1659545825678,1661545829678]"
                                jcr:created="{Date}2023-01-04T12:55:15.469-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2024-03-10T15:17:37.727-04:00"
                                jcr:lastModifiedBy="jewitca"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="Wie sieht eine Zusammenarbeit aus? "
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h3"
                                variant="h"/>
                            <text_259153141
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2023-01-17T14:03:15.858-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2024-03-10T15:18:28.942-04:00"
                                jcr:lastModifiedBy="jewitca"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;b>Search and Evaluation (S&amp;amp;E)&lt;br>&#xd;&#xa;&lt;/b>Unsere Aktivitäten konzentrieren sich darauf, neue Möglichkeiten zu erkennen und zu beurteilen, die unsere bestehenden Innovationsstrategien ergänzen und optimieren. S&amp;amp;E arbeitet eng mit unseren Teams von R&amp;amp;D und Commercial, BD&amp;amp;A und Ventures zusammen, um jede potenzielle Zusammenarbeit sorgfältig zu prüfen.&lt;/p>&#xd;&#xa;&lt;p>&lt;b>Business Development and Acquisitions (BD&amp;amp;A)&lt;br>&#xd;&#xa;&lt;/b>Wir beurteilen eine Vielzahl von Partnerschaftsstrukturen, um die Bedürfnisse beider Seiten zu berücksichtigen. BD&amp;amp;A arbeitet eng mit S&amp;amp;E sowie unseren Commercial‑ und R&amp;amp;D‑Organisationen zusammen, um neue Möglichkeiten zu bewerten.&lt;/p>&#xd;&#xa;&lt;p>&lt;b>Global Alliances&lt;br>&#xd;&#xa;&lt;/b>Äusserst erfolgreiche Partnerschaften entstehen aus dem fortwährenden Engagement, eine gemeinsame Vision in die Tat umzusetzen. Bei AbbVie haben wir ein engagiertes Team, das in allen Aspekten der Partnerschaft von der Vertragsgestaltung bis zur Vermarktung involviert ist.&lt;/p>&#xd;&#xa;&lt;p>&lt;b>AbbVie Ventures&lt;br>&#xd;&#xa;&lt;/b>Wir investieren strategisch in wegweisende wissenschaftliche Möglichkeiten, um unsere wichtigsten R&amp;amp;D‑Bereiche auszubauen, Zugang zur Wissenschaft von morgen zu erlangen und mit anerkannten wissenschaftlichen Führungskräften in Kontakt zu treten. Unsere Expertise in der Arzneimittelentwicklung und ‑vermarktung kann auch für junge Unternehmen eine wertvolle Hilfe sein.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_copy_1916185142
                                cq:styleIds="[1662756423318]"
                                jcr:created="{Date}2023-01-04T13:13:17.451-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2023-01-04T13:13:17.451-05:00"
                                jcr:lastModifiedBy="chiucx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <title_copy_copy
                                cq:styleIds="[1659545825678,1661545829678]"
                                jcr:created="{Date}2023-01-04T12:55:15.469-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2024-03-10T15:19:18.370-04:00"
                                jcr:lastModifiedBy="jewitca"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="Unser Team für Kooperationen "
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h3"
                                variant="h"/>
                            <text_1185168660_copy
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2023-01-04T13:14:02.289-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2024-03-10T15:20:48.019-04:00"
                                jcr:lastModifiedBy="jewitca"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Unser Team ist bereit, unsere Kompetenzen in einem persönlichen Gespräch vorzustellen und Geschäftsmöglichkeiten zu erörtern. Wir suchen stets nach Innovation und neuen Partnerschaften, die zu unseren Schwerpunktgebieten passen. Unsere Büros in Nordkalifornien, Chicago und Boston sowie weitere Standorte weltweit freuen sich auf Ihre Kontaktaufnahme.&lt;/p>&#xd;&#xa;&lt;p>&lt;a href=&quot;https://abbvie.partneringplace.com/SubmissionUI/abbvie/submission&quot; target=&quot;_blank&quot;>Kontaktieren Sie uns&lt;/a>, um Ihre Ideen vorzustellen.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_copy_19161
                                cq:styleIds="[1662756423318]"
                                jcr:created="{Date}2023-01-04T13:13:17.451-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2023-01-04T13:13:17.451-05:00"
                                jcr:lastModifiedBy="chiucx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <title_copy_copy_copy
                                cq:styleIds="[1659545825678,1661545829678]"
                                jcr:created="{Date}2023-01-04T12:55:15.469-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2024-03-10T15:23:28.203-04:00"
                                jcr:lastModifiedBy="jewitca"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="Schwerpunktbereiche"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h3"
                                variant="h"/>
                            <text_1185168660_copy_2112106858
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2023-01-04T13:14:02.289-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2024-03-10T15:23:44.568-04:00"
                                jcr:lastModifiedBy="jewitca"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Zu unseren Kernbereichen in der Forschung und Entwicklung zählen Immunologie, Onkologie, Neurologie, Augenheilkunde und ästhetische Medizin sowie weitere Schwerpunktbereiche wie Virologie und zystische Fibrose. Wir entdecken und entwickeln neue Arzneimittel in Therapiegebieten, in denen wir das grösste Potenzial sehen, auf die Erkrankung und die Behandlungsmöglichkeiten Einfluss zu nehmen.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
