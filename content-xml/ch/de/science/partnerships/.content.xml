                                jcr:lastModifiedBy="jewitca"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Für weitere Informationen zur Partnerschaft mit AbbVie &lt;a href=&quot;https://www.abbvie.com/content/dam/abbvie-com2/pdfs/partnership-approach-brochure.pdf&quot; target=&quot;_blank&quot;>laden Sie unsere Broschüre herunter&lt;/a>.&lt;/p>&#xd;&#xa;"
