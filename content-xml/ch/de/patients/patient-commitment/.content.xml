                            backgroundColor="#F1F3FF">
                            <text_56501070
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2024-03-10T16:06:29.167-04:00"
                                jcr:createdBy="jewitca"
                                jcr:lastModified="{Date}2024-08-08T07:16:53.941-04:00"
                                jcr:lastModifiedBy="kaspatx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-26-reg&quot;>Wir begleiten sie auf ihren schwierigen Weg: von der Diagnose über die Therapie bis zu Patienten-Unterstützungsprogrammen. Damit machen wir einen echten Unterschied im Leben der Betroffenen – das ist der Anspruch von AbbVie. Mit unserer Arbeit stärken wir die Gesundheit und die Lebensqualität von Patientinnen und Patienten und wir übernehmen gesellschaftliche Verantwortung, indem wir nachhaltige Initiativen unterstützen. So kommen wir unserem Ziel einer neuen, besseren Welt immer näher.&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator
