                                jcr:lastModifiedBy="jewitca"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;body-unica-20-reg&quot;>Christian&amp;nbsp;kam 2014 als Governmental Affairs Manager zu AbbVie und wurde kurz darauf zum Market Access and Governmental Affairs Director befördert. Davor war er als Public Affairs Director bei der Schweizer Tochtergesellschaft eines grossen internationalen Pharmaunternehmens für Marktzugang, behördliche Angelegenheiten und Kommunikation zuständig, nachdem er zunächst beim Schweizerischen Pharmaverband Interpharma tätig gewesen war.&lt;/span>&lt;/p>&#xd;&#xa;&lt;p>&lt;span class=&quot;body-unica-20-reg&quot;>Christian hat an der Universität Basel in Molekularbiologie promoviert und verfügt über einen Master-Abschluss in Public Relations.&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <button_copy
                                cq:styleIds="[1659997777274]"
                                jcr:created="{Date}2022-12-02T16:28:04.724-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2024-03-23T17:15:14.306-04:00"
                                jcr:lastModifiedBy="jewitca"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="LinkedIn-Profil"
                                sling:resourceType="abbvie-com2/components/button/v2/button"
                                accessibilityLabel="LinkedIn-Profil"
                                linkTarget="_blank"
                                linkURL="https://www.linkedin.com/in/dr-christian-manzoni-883a6813/?originalSubdomain=ch"/>
                        </par_14>
                        <text_copy
                            cq:styleIds="[1659545825678]"
                            jcr:created="{Date}2022-11-29T15:27:16.203-05:00"
                            jcr:createdBy="chiucx"
                            jcr:lastModified="{Date}2024-03-15T14:02:54.273-04:00"
                            jcr:lastModifiedBy="jewitca"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>&lt;span class=&quot;body-unica-20-reg&quot;>Linn kam 2017 als General Manager Schweden zu AbbVie und übernahm 2019&amp;nbsp;ausserdem die Leitung der neu geschaffenen skandinavischen Tochtergesellschaft (Dänemark, Norwegen und Schweden). Zuvor war Linn vier Jahre lang als Country Managerin für ein internationales Pharmaunternehmen in Schweden tätig, nachdem sie 17&amp;nbsp;Jahre lang Berufserfahrung in verschiedenen kaufmännischen Funktionen in unterschiedlichen Therapiebereichen und mit Verantwortung für den gesamten nordischen Raum sammeln konnte.&lt;/span>&lt;/p>&#xd;&#xa;&lt;p>&lt;span class=&quot;body-unica-20-reg&quot;>Linn hat 1995 einen Master of Science in Pharmazie an der Universität Uppsala erworben.&lt;/span>&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
