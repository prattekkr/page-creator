                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;body-unica-20-reg&quot;>Michail kam 2020 als BTS Lead für die griechische Tochtergesellschaft zu AbbVie. Im Jahr 2023 absolvierte er erfolgreich einen achtmonatigen Einsatz als Leiter der BTS-Funktionen für Griechenland und die Schweiz. Davor war Michail für einen der weltweit grössten Lebensmittel-Einzelhandelskonzerne als Retail, Digital and Loyalty Applications Manager tätig. Ausserdem war er drei Jahre lang leitender Software-Ingenieur bei einem Telekommunikationsunternehmen.&lt;/span>&lt;/p>&#xd;&#xa;&lt;p>&lt;span class=&quot;body-unica-20-reg&quot;>Michail hat einen Bachelor-Abschluss in Elektrotechnik und Computertechnik von der Nationalen Technischen Universität Athen und einen Master-Abschluss in Telekommunikationsmanagement von der UCL in London.&amp;nbsp;&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <button
                                cq:styleIds="[1659997777274]"
                                jcr:created="{Date}2022-12-02T16:28:04.724-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2024-03-23T17:43:09.035-04:00"
                                jcr:lastModifiedBy="jewitca"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="LinkedIn-Profil"
                                sling:resourceType="abbvie-com2/components/button/v2/button"
                                accessibilityLabel="LinkedIn profile"
                                linkTarget="_blank"
                                linkURL="https://www.linkedin.com/in/michail-gkouzos-89b49714/"/>
                        </par_14>
                        <text_copy
