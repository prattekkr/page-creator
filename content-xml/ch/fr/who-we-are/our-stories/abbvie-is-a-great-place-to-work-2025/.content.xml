                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="La cohésion au cœur de notre succès"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h4"
                                    variant="h"/>
                                <text2_copy_copy_copy_362955268
                                    cq:styleIds="[1659545825678,1659545835858]"
                                    jcr:lastModified="{Date}2025-06-13T15:56:47.467-04:00"
                                    jcr:lastModifiedBy="VALENSX5"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Chez AbbVie, 98% de nos collaboratrices et collaborateurs se sentent à l’aise et acceptés dès leur arrivée, grâce à notre culture de la bienveillance et nos pratiques collaboratives. La cohésion est le moteur de notre travail d’équipe, de nos innovations et de la réussite de nos activités. Apprenez-en plus sur ce lien de cohésion à travers les témoignages de Julia et de Larissa.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
