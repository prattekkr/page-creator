                                    sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                                <title2_copy_copy_cop_32930493
                                    cq:styleIds="[1659545825678,1651545824678,1651545825693]"
                                    jcr:lastModified="{Date}2025-06-13T15:56:18.410-04:00"
                                    jcr:lastModifiedBy="VALENSX5"
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="Nous sommes fiers de faire partie d’AbbVie"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h4"
                                    variant="h"/>
                                <text2_copy_copy_copy_143681805
                                    cq:styleIds="[1659545825678,1659545835858]"
                                    jcr:lastModified="{Date}2025-06-13T15:56:28.121-04:00"
                                    jcr:lastModifiedBy="VALENSX5"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Travailler chez AbbVie est épanouissant en raison de la fierté que nous éprouvons à l’égard de nos réalisations et de l’impact que nous avons auprès des patientes et patients ainsi que des communautés. Notre objectif commun et nos normes exigeantes sont à la base de contributions significatives. Faites la connaissance de Laia et Mathias pour savoir ce qui est important à leurs yeux.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
