                                    jcr:lastModifiedBy="VALENSX5"
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="Ce qui nous motive"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    langAttribute="none"
                                    type="h3"
                                    variant="h"/>
                                <text2_copy_copy_copy
                                    cq:styleIds="[1659545825678,1659545835858]"
                                    jcr:lastModified="{Date}2026-05-28T14:05:02.652-04:00"
                                    jcr:lastModifiedBy="VALENSX5"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    langAttribute="none"
                                    text="&lt;p>Visit our &lt;a href=&quot;https://careers.abbvie.com/en/&quot;>career website&lt;/a> to get an overview of all open vacancies worldwide.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <text
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2026-05-28T14:12:31.730-04:00"
                                    jcr:createdBy="VALENSX5"
                                    jcr:lastModified="{Date}2026-05-28T14:13:10.890-04:00"
                                    jcr:lastModifiedBy="VALENSX5"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    langAttribute="none"
                                    text="&lt;ul>&#xd;&#xa;&lt;li>Des solutions et des médicaments innovants qui améliorent la vie des patientes et patients&lt;/li>&#xd;&#xa;&lt;li>Un &lt;a href=&quot;https://www.abbvie.com/science/pipeline.html&quot;>pipeline&lt;/a> solide et diversifié&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;li>Une culture d’entreprise fondée sur la confiance, le travail d’équipe et l’inclusion vécue&lt;/li>&#xd;&#xa;&lt;li>Des prestations et des programmes concurrentiels qui répondent aux besoins des collaboratrices et collaborateurs&lt;ul>&#xd;&#xa;&lt;li>Horaires de travail flexibles, possibilité de travailler à domicile et de prendre un congé sabbatique&lt;br>&#xd;&#xa;(tous les cinq ans)&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;li>Jusqu’à 30 jours de vacances, plus 6 jours de congés supplémentaires sous forme de ponts&lt;/li>&#xd;&#xa;&lt;li>Plans de développement individuel, programmes de leadership et de management, etc.&lt;/li>&#xd;&#xa;&lt;li>Programme d’actionnariat pour les collaboratrices et collaborateurs&lt;/li>&#xd;&#xa;&lt;li>Programmes d’aide aux collaboratrices et collaborateurs&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;&lt;/li>&#xd;&#xa;&lt;li>et bien plus encore...&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;&lt;p>Le taux de satisfaction de 87% enregistré lors de l’enquête de cette année parle de lui-même.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
