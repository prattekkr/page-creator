                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>L’occlusion veineuse rétinienne est également appelée «AVC oculaire». Les patients souffrant d’une occlusion veineuse se plaignent d’une perte de vision indolore et soudaine ou de distorsions optiques. Si elle n’est pas traitée, l’occlusion veineuse peut, dans les cas graves, entraîner la cécité en quelques mois seulement.&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                        </container3>
