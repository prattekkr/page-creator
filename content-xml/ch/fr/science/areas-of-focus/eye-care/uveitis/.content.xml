                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>L’uvéite est une inflammation oculaire qui apparaît souvent en association à une autre maladie. Non traitée, elle peut entraîner des lésions permanentes de l’œil.&amp;nbsp;Des traitements innovants aident à maîtriser l’uvéite.&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
