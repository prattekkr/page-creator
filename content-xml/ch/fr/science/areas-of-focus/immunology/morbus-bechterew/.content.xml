                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>Les spondylarthropathies axiales (SpA) font partie des maladies rhumatismales inflammatoires. Ce terme regroupe diverses maladies inflammatoires de la colonne vertébrale. La spondylarthrite ankylosante, aussi appelée maladie de Bechterew, est un représentant bien connu de ce groupe de maladies.&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                        </container3>
