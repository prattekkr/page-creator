                        <title_copy_copy_copy_1553870631
                            cq:styleIds="[1659545825678]"
                            jcr:created="{Date}2024-01-28T16:16:47.962-05:00"
                            jcr:createdBy="jewitca"
                            jcr:lastModified="{Date}2024-01-29T16:58:39.019-05:00"
                            jcr:lastModifiedBy="jewitca"
                            jcr:primaryType="nt:unstructured"
                            jcr:title="Peut-on guérir le psoriasis?"
                            sling:resourceType="abbvie-com2/components/title/v2/title"
                            type="h4"
                            variant="h"/>
                        <text_copy_copy_copy__666476140
                            cq:styleIds="[1659545825678]"
                            jcr:created="{Date}2024-01-28T16:16:54.528-05:00"
                            jcr:createdBy="jewitca"
                            jcr:lastModified="{Date}2024-01-29T16:59:02.417-05:00"
                            jcr:lastModifiedBy="jewitca"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>Le psoriasis est à ce jour incurable. Mais, grâce à un traitement approprié, les personnes concernées ont souvent une peau pratiquement sans lésions visibles pendant de longues périodes.&lt;/p>&#xd;&#xa;&lt;p>De plus amples informations sur le psoriasis sont disponibles sur&amp;nbsp;&lt;a href=&quot;https://www.spvg.ch/fr/home.html&quot; target=&quot;_blank&quot;>https://www.spvg.ch/fr/home.html&lt;/a>&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
                        <separator_copy
                            cq:styleIds="[1662756423318]"
                            jcr:created="{Date}2024-01-28T16:45:57.304-05:00"
