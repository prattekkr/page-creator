                                jcr:lastModifiedBy="jewitca"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>Le psoriasis est une maladie chronique de la peau qui affecte en Suisse environ 170&amp;nbsp;000 personnes.&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                        </container3>
                    </container2>
                    <container_344669232
                        cq:styleIds="[1653545825686]"
                        jcr:created="{Date}2024-01-28T16:16:39.965-05:00"
                        jcr:createdBy="jewitca"
