                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>Environ 25&amp;nbsp;000 personnes en Suisse sont atteintes d’une maladie inflammatoire chronique de l’intestin.&amp;nbsp;À ce jour incurables, ces maladies peuvent toutefois être relativement bien traitées.&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
