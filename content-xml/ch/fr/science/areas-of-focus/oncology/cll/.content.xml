                            jcr:primaryType="nt:unstructured"
                            jcr:title="La LLC en Suisse "
                            sling:resourceType="abbvie-com2/components/title/v2/title"
                            type="h2"
                            variant="h"/>
                        <text_249790517
                            cq:styleIds="[1659545825678]"
                            jcr:created="{Date}2024-03-12T22:37:18.828-04:00"
                            jcr:createdBy="jewitca"
                            jcr:lastModified="{Date}2024-03-24T02:09:23.385-04:00"
                            jcr:lastModifiedBy="jewitca"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>En Suisse, environ 550&amp;nbsp;personnes sont atteintes chaque année d’une leucémie lymphoïde chronique. Les hommes sont plus souvent touchés que les femmes; les personnes concernées sont généralement d’un âge avancé, entre 70 et 75&amp;nbsp;ans.&lt;/p>&#xd;&#xa;&lt;p>Les causes d’une LLC sont encore inexpliquées. Outre l’âge, certaines substances nocives comme l’amiante ou les pesticides sont évoquées comme facteurs de risque.&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
                        <separator
                            cq:styleIds="[1662756456518]"
