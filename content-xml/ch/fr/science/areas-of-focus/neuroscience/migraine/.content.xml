                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>Selon l’Organisation mondiale de la Santé, la migraine est l’une des maladies les plus invalidantes.&amp;nbsp;En Suisse, environ 1&amp;nbsp;million de personnes sont concernées.&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
