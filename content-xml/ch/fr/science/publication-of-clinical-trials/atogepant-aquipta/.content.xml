                                text="&lt;h3>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>Numéro d’autorisation 69128, date d’autorisation: 06.03.2024&lt;/span>&lt;/span>&lt;/h3>&#xd;&#xa;"
