                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>Au cours des dix&amp;nbsp;dernières années, nous avons doublé nos investissements dans la recherche. Les nouvelles technologies nous aident dans notre mission visant à élaborer des traitements et solutions d’un nouveau genre.&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
