                                        jcr:createdBy="mihalsk"
                                        jcr:lastModified="{Date}2024-02-01T15:07:17.619-05:00"
                                        jcr:lastModifiedBy="jewitca"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="abbvie-com2/components/quote"
                                        attributionName="Jonathon Sedgwick, Ph.D."
                                        attributionTitle="VP et Global Head, Discovery Research, AbbVie"
                                        quote="«La concrétisation d’une découverte en un médicament est un long processus fait d’essais et de réflexions pouvant prendre de nombreuses années. Mais la curiosité et la soif de connaissances nous enthousiasment et nous motivent.»"
                                        quoteType="regular"
