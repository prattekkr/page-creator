                            sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                        <title2_copy_copy_cop_949126406
                            cq:styleIds="[1659545825678,1651545824678]"
                            jcr:lastModified="{Date}2024-03-24T14:02:11.036-04:00"
                            jcr:lastModifiedBy="jewitca"
                            jcr:primaryType="nt:unstructured"
                            jcr:title="Ludwigshafen, Allemagne"
                            sling:resourceType="abbvie-com2/components/title/v2/title"
                            type="h4"
                            variant="h"/>
                        <text2_copy_copy_copy_434206779
                            cq:styleIds="[1659545825678,1659545835858]"
                            jcr:lastModified="{Date}2024-03-24T14:02:32.455-04:00"
                            jcr:lastModifiedBy="jewitca"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>Dans notre établissement intégré de Ludwigshafen, nous effectuons toutes les étapes de la recherche pharmaceutique, du développement et de la production de médicaments. Les scientifiques y mènent des recherches sur des traitements potentiels contre les maladies neurodégénératives telles que les maladies d’Alzheimer et de Parkinson et ont recours à de nouvelles méthodes pour la formulation de substances complexes en vue d’améliorations potentielles des médicaments.&lt;/p>&#xd;&#xa;&lt;p>Le site de Ludwigshafen contribue en outre à la numérisation de la recherche en ayant recours à l’intelligence artificielle, l’apprentissage automatique, la bio-informatique et d’autres technologies permettant de réaliser des études précliniques et cliniques dans le monde entier.&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
                        <button_copy_13254203_631155295
                            cq:styleIds="[1659997777274]"
