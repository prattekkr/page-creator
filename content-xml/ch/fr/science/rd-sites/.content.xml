                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                        <title2_copy_copy
                            cq:styleIds="[1659545825678,1651545824678]"
                            jcr:lastModified="{Date}2024-03-24T13:59:17.791-04:00"
                            jcr:lastModifiedBy="jewitca"
                            jcr:primaryType="nt:unstructured"
                            jcr:title="South San Francisco, Californie"
                            sling:resourceType="abbvie-com2/components/title/v2/title"
                            type="h4"
                            variant="h"/>
                        <text2_copy_copy
                            cq:styleIds="[1659545825678,1659545835858]"
                            jcr:lastModified="{Date}2024-03-24T13:59:36.872-04:00"
                            jcr:lastModifiedBy="jewitca"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>Dernier établissement en date venu compléter nos sites de Recherche et Développement, la Bay&amp;nbsp;Area est l’épicentre de notre travail d’avant-garde dans la recherche en oncologie. Nous y évaluons la pertinence de différents médicaments expérimentaux en tant qu’options thérapeutiques potentielles contre plusieurs types de cancer. Nous y développons également à vive allure notre pipeline de Recherche et Développement dans les domaines de l’immuno-oncologie, du ciblage des tumeurs, des dépendances tumorales et de la médecine de précision. Les autres tâches sur le site de Bay&amp;nbsp;Area sont notamment les statistiques et l’analyse des données, les affaires médicales, la sécurité des patients, l’assurance qualité et les affaires réglementaires.&lt;/p>&#xd;&#xa;&lt;p>Sur le lieu de naissance de la biotechnologie, ce nouveau site de 4460&amp;nbsp;mètres carrés est ouvert à de nouveaux partenariats et à de nouvelles collaborations qui déboucheront sur de nouveaux succès.&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
                        <button_copy
                            cq:styleIds="[1659997777274]"
