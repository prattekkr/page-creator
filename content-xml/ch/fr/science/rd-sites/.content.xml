                            type="h4"
                            variant="h"/>
                        <text2_copy
                            cq:styleIds="[1659545825678,1659545835858]"
                            jcr:lastModified="{Date}2024-03-24T13:58:28.052-04:00"
                            jcr:lastModifiedBy="jewitca"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>Notre site d’Irvine abrite notre centre d’excellence pour la médecine esthétique, les neurotoxines, la neuropsychiatrie, la migraine et l’ophtalmologie. L’établissement, qui s’étend sur un terrain de près de 22&amp;nbsp;hectares, abrite des compétences scientifiques uniques en matière de recherche et de développement de la science translationnelle et pharmaceutique en vue de fournir des médicaments innovants axés sur les patients.&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
                        <separator_copy
                            cq:styleIds="[1662756456518]"
                            jcr:created="{Date}2022-12-18T12:05:49.452-05:00"
                            jcr:createdBy="chiucx"
                            jcr:lastModified="{Date}2022-12-18T12:05:49.452-05:00"
