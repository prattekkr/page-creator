                        <title2_copy_copy_cop_589941422
                            cq:styleIds="[1659545825678,1651545824678]"
                            jcr:lastModified="{Date}2024-03-03T22:15:30.762-05:00"
                            jcr:lastModifiedBy="jewitca"
                            jcr:primaryType="nt:unstructured"
                            jcr:title="Worcester, Massachusetts"
                            sling:resourceType="abbvie-com2/components/title/v2/title"
                            type="h4"
                            variant="h"/>
                        <text2_copy_copy_copy_1566281083
                            cq:styleIds="[1659545825678,1659545835858]"
                            jcr:lastModified="{Date}2024-03-24T14:01:30.400-04:00"
                            jcr:lastModifiedBy="jewitca"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>Depuis plus de 30&amp;nbsp;ans, le &lt;i>Bioresearch&amp;nbsp;Center&lt;/i> d’AbbVie à Worcester, Massachusetts, est leader dans les domaines de la recherche pharmaceutique, des sciences du développement et de la recherche sur les produits biologiques. Dans cet établissement de 51&amp;nbsp;375&amp;nbsp;mètres carrés, nous travaillons principalement au développement de biothérapies et à la recherche de solutions innovantes pour relever certains des défis les plus complexes de la médecine, notamment en immunologie et en neurologie.&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
                        <button_copy_13254203
                            cq:styleIds="[1659997777274]"
                            jcr:created="{Date}2023-01-03T12:43:23.660-05:00"
