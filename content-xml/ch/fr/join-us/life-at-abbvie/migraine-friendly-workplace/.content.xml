                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>La Société Suisse des Céphalées nous a certifiés comme lieu de travail adapté aux personnes souffrant de migraines. Les personnes concernées trouvent chez nous un environnement de travail qui les soutient, afin qu’elles puissent donner le meilleur d’elles-mêmes.&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                        </container3>
                        <grid_1109957805_copy
                            cq:styleIds="[0,1653545835880]"
                            jcr:created="{Date}2022-12-07T10:56:06.407-05:00"
                            jcr:createdBy="chiucx"
                            jcr:lastModified="{Date}2025-12-16T12:00:27.312-05:00"
                            jcr:lastModifiedBy="VALENSX5"
