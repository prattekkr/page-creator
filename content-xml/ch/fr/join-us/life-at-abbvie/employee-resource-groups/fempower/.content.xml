                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;ul>&#xd;&#xa;&lt;li>Prendre conscience des préjugés, en particulier des préjugés inconscients, et les éliminer.&lt;/li>&#xd;&#xa;&lt;li>Mettre en œuvre les changements qui s’imposent au niveau stratégique.&lt;/li>&#xd;&#xa;&lt;li>Développer la confiance en soi ainsi que les compétences en négociation&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;"
