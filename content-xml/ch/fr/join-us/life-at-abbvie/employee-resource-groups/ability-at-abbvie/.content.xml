                            jcr:title="Nous associons travail et action sociale"
                            sling:resourceType="abbvie-com2/components/title/v2/title"
                            type="h3"
                            variant="h"/>
                        <text_1267575280
                            cq:styleIds="[1659545825678]"
                            jcr:created="{Date}2023-01-03T21:35:33.225-05:00"
                            jcr:createdBy="schafsm"
                            jcr:lastModified="{Date}2024-07-25T23:13:41.340-04:00"
                            jcr:lastModifiedBy="jewitca"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>Avec myAbility, nous nous engageons en faveur d’une société plus juste et équitable. Les expertes et experts de myAbility, qui disposent d’une compréhension approfondie du monde économique, créent pour nous des solutions professionnelles ayant un impact social tout en étant économiquement durables. Actuellement, plusieurs collaborateurs présentant des handicaps travaillent chez AbbVie Suisse.&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
                        <button
                            cq:styleIds="[1659997740832]"
