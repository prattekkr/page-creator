                            jcr:lastModified="{Date}2024-03-25T11:23:16.380-04:00"
                            jcr:lastModifiedBy="jewitca"
                            jcr:primaryType="nt:unstructured"
                            jcr:title="L’aboutissement idéal d’un stage chez AbbVie: un avenir professionnel commun"
                            sling:resourceType="abbvie-com2/components/title/v2/title"
                            type="h2"
                            variant="h"/>
                        <text_copy
                            cq:styleIds="[1659545825678]"
                            jcr:created="{Date}2024-03-11T01:12:08.599-04:00"
                            jcr:createdBy="jewitca"
                            jcr:lastModified="{Date}2024-08-23T10:44:57.994-04:00"
                            jcr:lastModifiedBy="kaspatx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>Depuis le lancement du programme en juin&amp;nbsp;2016, nous avons déjà enregistré de nombreux succès: au terme de leur programme, neuf des dix&amp;nbsp;stagiaires ont obtenu un poste fixe chez AbbVie – en qualité de Brand Manager, Medical Science Liaison, Business Finance Manager ou Market Access Manager.&lt;br>&#xd;&#xa;&lt;/p>&#xd;&#xa;&lt;p>En tant qu’entreprise jeune et dynamique, nous sommes donc constamment à la recherche de talents motivés qui correspondent à notre culture d’entreprise ouverte.&lt;/p>&#xd;&#xa;&lt;p>&lt;br>&#xd;&#xa;Voici deux courtes interviews d'anciens stagiaires:&lt;/p>&#xd;&#xa;&lt;p>&lt;a href=&quot;https://www.abbvie.ch/content/dam/abbvie-dotcom/ch/documents/interview-romina-cabra.pdf&quot; target=&quot;_blank&quot;>Interview Romina Cabra&lt;/a>&lt;br>&#xd;&#xa;&lt;a href=&quot;https://www.abbvie.ch/content/dam/abbvie-dotcom/ch/documents/interview-joana-herter.pdf&quot; target=&quot;_blank&quot;>Interview Joana Herter&lt;/a>&lt;br>&#xd;&#xa;&lt;br>&#xd;&#xa;Les dates du prochain&amp;nbsp;de notre programme de stage seront annoncées prochainement ici.&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
