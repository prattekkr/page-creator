                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>Nous sommes à la recherche des meilleurs talents! Programme de stage d’AbbVie.&amp;nbsp;Avec notre programme de stage/rotation, nous offrons aux jeunes talents l’opportunité unique de rejoindre notre entreprise.&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
