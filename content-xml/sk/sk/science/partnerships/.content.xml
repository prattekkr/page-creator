                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <title_2048351104_cop_854970822
                                cq:styleIds="[1659545825678,1661545829678,1651545825692]"
                                jcr:created="{Date}2023-01-05T10:19:52.308-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2026-02-06T06:36:29.242-05:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="Tím pre partnerstvá "
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h2"
                                variant="h"/>
                            <text_1185168660_copy_398457286
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2023-01-04T13:14:02.289-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2026-02-26T10:41:05.462-05:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Náš tím je pripravený sa s vami stretnúť, aby sa s vami podelil o naše možnosti a prediskutoval vaše obchodné príležitosti. Vždy hľadáme inovácie a nové partnerské príležitosti, ktoré sú v súlade s našimi oblasťami záujmu. Máme kancelárie v severnej Kalifornii, Chicagu a Bostone a na ďalších miestach po celom svete. Tešíme sa, že sa nám ozvete.&lt;br>&#xd;&#xa;&lt;br>&#xd;&#xa;&lt;a href=&quot;https://abbvie.partneringplace.com/SubmissionUI/abbvie/submission&quot;>Kontaktujte nás&lt;/a> so svojím nápadom.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
