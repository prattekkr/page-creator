                            <title_copy_copy
                                cq:styleIds="[1659545825678,1661545829678,1651545825692]"
                                jcr:created="{Date}2023-01-04T12:55:15.469-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2026-02-06T06:33:28.303-05:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="Ako spolupracujeme "
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h2"
                                variant="h"/>
                            <text_1185168660_copy
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2023-01-04T13:14:02.289-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2026-03-19T05:42:56.466-04:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                langAttribute="none"
                                text="&lt;p>&lt;b>Vyhľadávanie a hodnotenie&amp;nbsp;(S&amp;amp;E)&lt;/b>&lt;/p>&#xd;&#xa;&lt;p>Zameriavame sa na vyhľadávanie a vyhodnocovanie nových príležitostí, ktoré dopĺňajú a posilňujú naše existujúce interné inovačné stratégie. V rámci S&amp;amp;E úzko spolupracujeme s našimi výskumnými a obchodnými tímami, BD&amp;amp;A a tímami pre podnikateľské zámery, aby sme premyslene riešili každú príležitosť.&lt;/p>&#xd;&#xa;&lt;p>&lt;b>Rozvoj&amp;nbsp;obchodu&amp;nbsp;a akvizície&amp;nbsp;(BD&amp;amp;A)&lt;br>&#xd;&#xa;&lt;/b>Posudzujeme&amp;nbsp;rôzne partnerské štruktúry,&amp;nbsp;aby sme vyhoveli potrebám oboch strán. BD&amp;amp;A úzko spolupracuje s oddelením vedy a výskumu a tímom&amp;nbsp;S&amp;amp;E pri vyhodnocovaní nových príležitostí.&lt;/p>&#xd;&#xa;&lt;p>&lt;b>Globálne aliancie&lt;br>&#xd;&#xa;&lt;/b>Vysoko&amp;nbsp;úspešné partnerstvá sú výsledkom trvalého záväzku realizovať spoločnú víziu. V&amp;nbsp;AbbVie&amp;nbsp;máme špecializovaný tím, ktorý sa podieľa na všetkých aspektoch partnerstva od uzatvárania zmlúv až po komercializáciu.&lt;/p>&#xd;&#xa;&lt;p>&lt;b>Partnerstvá&amp;nbsp;AbbVie&lt;br>&#xd;&#xa;&lt;/b>Strategicky investujeme do transformačných vedeckých príležitostí s cieľom rozšíriť naše hlavné záujmy v oblasti výskumu a vývoja a získať prístup k vedeckým poznatkom novej generácie a osvedčeným lídrom vo vede. Naše odborné znalosti v oblasti vývoja a komercializácie liečiv môžu byť cenným zdrojom aj pre spoločnosti v najranejšej fáze vývoja.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator_2123790112
                                cq:styleIds="[1662756456518]"
                                jcr:created="{Date}2023-01-05T10:19:42.072-05:00"
                                jcr:createdBy="chiucx"
