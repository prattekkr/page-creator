                            variant="h"/>
                        <text2
                            cq:styleIds="[1659545825678,1659545835858]"
                            jcr:lastModified="{Date}2026-04-13T07:12:33.195-04:00"
                            jcr:lastModifiedBy="singarx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            langAttribute="none"
                            text="&lt;p>&lt;b> &lt;/b>Náš vývojový rad v neurológii tvoria inovatívne skúšané lieky, vrátane symptomatických liekov, chorobu modifikujúcich terapií, terapeutických toxínov a iných prelomových inovatívnych prístupov na liečbu mozgových porúch. Na základe viac ako troch desaťročí výskumu sa zameriavame na štyri kľúčové oblasti.&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
                        <separator_165917366
                            cq:styleIds="[1662756423318]"
                            jcr:created="{Date}2022-12-18T09:21:43.017-05:00"
                            jcr:createdBy="chiucx"
