                        enableLazyLoading="false">
                        <title
                            cq:styleIds="[1659545825678,1661545829678,1651545825693]"
                            jcr:created="{Date}2026-01-31T08:30:40.863-05:00"
                            jcr:createdBy="singarx"
                            jcr:lastModified="{Date}2026-04-16T01:27:19.237-04:00"
                            jcr:lastModifiedBy="singarx"
                            jcr:primaryType="nt:unstructured"
                            jcr:title="Oblasti zamerania v onkológii "
                            sling:resourceType="abbvie-com2/components/title/v2/title"
                            langAttribute="none"
                            type="h1"
                            variant="h"/>
                        <text
                            cq:styleIds="[1659545825678]"
                            jcr:created="{Date}2026-01-31T08:30:46.296-05:00"
                            jcr:createdBy="singarx"
                            jcr:lastModified="{Date}2026-03-20T05:46:38.214-04:00"
                            jcr:lastModifiedBy="singarx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            langAttribute="none"
                            text="&lt;p>Zameriavame sa na&amp;nbsp;hľadanie odpovedí, ktoré zmenia spôsob liečby&amp;nbsp;nádorov.&amp;nbsp;Chceme dosiahnuť lepšie a dlhodobejšie výsledky pri liečbe&amp;nbsp;leukémií&amp;nbsp;a solídnych nádorov.&amp;nbsp;Naša kultúra zvedavosti nás motivuje&amp;nbsp;objavovať nové riešenia.&lt;br>&#xd;&#xa;&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
                        <separator_1130398386
                            cq:styleIds="[1662756423318]"
                            jcr:created="{Date}2026-03-20T05:47:23.833-04:00"
                            jcr:createdBy="singarx"
                            jcr:lastModified="{Date}2026-03-20T05:52:53.694-04:00"
                            jcr:lastModifiedBy="singarx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                        <title_copy
                            cq:styleIds="[1659545825678,1661545829678,1651545825693]"
                            jcr:created="{Date}2026-01-31T08:30:40.863-05:00"
                            jcr:createdBy="singarx"
                            jcr:lastModified="{Date}2026-04-16T01:27:29.477-04:00"
                            jcr:lastModifiedBy="singarx"
                            jcr:primaryType="nt:unstructured"
                            jcr:title="Nádorové ochorenia krvi"
                            sling:resourceType="abbvie-com2/components/title/v2/title"
                            langAttribute="none"
                            type="h1"
                            variant="h"/>
                        <text_copy
                            cq:styleIds="[1659545825678]"
                            jcr:created="{Date}2026-01-31T08:30:46.296-05:00"
                            jcr:createdBy="singarx"
                            jcr:lastModified="{Date}2026-03-20T05:48:53.359-04:00"
                            jcr:lastModifiedBy="singarx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            langAttribute="none"
                            text="&lt;p>Nádorové ochorenia krvi sú ochorenia, ktoré postihujú krvotvorné tkanivá (napríklad kostnú dreň) a obmedzujú schopnosť organizmu bojovať proti infekcii. Najčastejšími formami sú leukémia, lymfóm a myelóm.&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
                        <separator_1952447249
                            jcr:created="{Date}2026-03-20T05:49:16.261-04:00"
                            jcr:createdBy="singarx"
                            jcr:lastModified="{Date}2026-03-20T05:49:16.261-04:00"
                            jcr:lastModifiedBy="singarx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                        <accordion_copy
                            cq:styleIds="[1]"
                            jcr:created="{Date}2026-01-31T08:32:08.169-05:00"
                            jcr:createdBy="singarx"
                            jcr:lastModified="{Date}2026-03-20T05:57:24.015-04:00"
                            jcr:lastModifiedBy="singarx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/accordion/v2/accordion"
                            heading="NAŠE OBLASTI ZAMERANIA"
                            singleExpansion="false">
                            <item_1769866457361
                                cq:panelTitle="Akútna myeloidná leukémia (AML) "
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2026-03-20T01:56:20.326-04:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                langAttribute="none"
                                text="&lt;p>AML je jedným&amp;nbsp;z najagresívnejších a najťažšie liečiteľných&amp;nbsp;krvných nádorov&amp;nbsp;s veľmi nízkou mierou&amp;nbsp;prežívania&amp;nbsp;a s&amp;nbsp;obmedzenými&amp;nbsp;možnosťami liečby pre pacientov, ktorí nemôžu&amp;nbsp;podstúpiť&amp;nbsp;intenzívnu chemoterapiu.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <item_1769866464696
                                cq:panelTitle="Chronická lymfocytová leukémia (CLL)"
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2026-01-31T08:43:06.544-05:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>CLL je pomaly rastúci typ&amp;nbsp;leukémie, pri&amp;nbsp;ktorom&amp;nbsp;kostná dreň vytvára príliš veľa lymfocytov, čo je typ bielych krviniek.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <item_1769866467728
                                cq:panelTitle="Difúzny veľkobunkový B-lymfóm (DLBCL) "
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2026-01-31T08:43:37.899-05:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>DLBCL je najčastejším typom&amp;nbsp;non-Hodgkinovho&amp;nbsp;lymfómu (NHL) v USA&amp;nbsp;i vo&amp;nbsp;svete. Výskyt DLBCL sa vo všeobecnosti zvyšuje s vekom, pričom u väčšiny pacientov sa diagnostikuje po 60. roku života.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <item_1769866473161
                                cq:panelTitle="Mnohopočetný myelóm (MM) "
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2026-01-31T08:43:58.974-05:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>MM je&amp;nbsp;nádor&amp;nbsp;plazmatických buniek, ktorý&amp;nbsp;často charakterizujú opakujúce sa cykly&amp;nbsp;relapsu a&amp;nbsp;remisie. Je to&amp;nbsp;druhý najčastejší typ krvných nádorov.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <item_1769866479373
                                cq:panelTitle="Myelodysplastický syndróm (MDS)"
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2026-01-31T08:44:20.661-05:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>MDS je skupina krvných porúch charakterizovaná&amp;nbsp;abnormálnym vývojom krvných buniek v kostnej dreni. Tieto poruchy sa považujú za&amp;nbsp;jeden z typov nádorov.&amp;nbsp;&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                        </accordion_copy>
