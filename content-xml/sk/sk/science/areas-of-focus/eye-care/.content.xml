                                jcr:lastModified="{Date}2026-03-19T09:19:23.345-04:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                langAttribute="none"
                                text="&lt;p>Chronické ochorenie, ktoré môže byť spôsobené pokročilým vekom, používaním kontaktných šošoviek, niektorými liekmi, očnými ochoreniami, inými zdravotnými stavmi alebo vplyvom prostredia.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <item_1671312475801
                                cq:panelTitle="Glaukóm "
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2026-02-11T05:59:14.729-05:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Skupina očných ochorení (mnoho rôznych typov), ktoré spôsobujú poškodenie zrakového nervu. Zvyčajne&amp;nbsp;súvisia s&amp;nbsp;vysokým&amp;nbsp;očným&amp;nbsp;tlakom&amp;nbsp;a môžu viesť&amp;nbsp;až&amp;nbsp;k slepote.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <item_1671312481387
                                cq:panelTitle="Vekom podmienené ochorenia sietnice"
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2026-02-11T05:59:44.271-05:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Poškodenie makuly v blízkosti stredu sietnice ovplyvňuje centrálne videnie a schopnosť vidieť jemné detaily.&amp;nbsp;Vekom podmienená degenerácia makuly&amp;nbsp;je najčastejšou príčinou závažnej straty zraku u ľudí&amp;nbsp;nad&amp;nbsp;60 rokov.&amp;nbsp;&lt;br>&#xd;&#xa;&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <item_1671372277563
                                cq:panelTitle="Refrakčné chyby"
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2026-02-11T06:00:08.813-05:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Problémy so zrakom, ktoré sťažujú jasné videnie&amp;nbsp;spôsobené tvarom&amp;nbsp;oka, ktorý neumožňuje zaostrenie svetla na sietnicu. Niektoré bežné refrakčné poruchy môžu dospelým v strednom a vyššom veku sťažovať videnie&amp;nbsp;do blízka.&amp;nbsp;&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                        </accordion_copy_copy>
