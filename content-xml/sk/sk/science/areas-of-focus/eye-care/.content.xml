                                    attributionName="Dr. Mike Robinson"
                                    attributionTitle=" VP, Clinical Development, Ophthalmology "
                                    dmPresetType="imagePreset"
                                    quote="Hoci neexistuje žiaden návod na to, ako sa stať priekopníkmi, musíme sa o  to neustále usilovať a  zameriavať sa na oblasti s  nenaplnenými medicínskymi potrebami."
                                    quoteType="regular"
