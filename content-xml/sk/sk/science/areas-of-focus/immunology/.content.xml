                            variant="h"/>
                        <text_1412616714
                            cq:styleIds="[1659545825678]"
                            jcr:created="{Date}2026-03-11T11:06:01.084-04:00"
                            jcr:createdBy="singarx"
                            jcr:lastModified="{Date}2026-04-16T01:20:57.996-04:00"
                            jcr:lastModifiedBy="singarx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            langAttribute="none"
                            text="&lt;p>&lt;b>&amp;nbsp;&lt;/b>V oblasti imunológie staviame na našich rozsiahlych odborných znalostiach a dlhoročných skúsenostiach, ktoré nám otvárajú priestor pre výskum nových terapeutických oblastí a riešení pre rozmanitejšie skupiny pacientov. Naše pokročilé technológie nám umožňujú poskytovať široké spektrum liekov na niektoré z najzávažnejších imunitne podmienených ochorení.&amp;nbsp;Náš výskum zahŕňa:&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/p>&#xd;&#xa;&lt;p>&lt;b>Pochopenie príčin ochorení&amp;nbsp;&lt;br>&#xd;&#xa; &lt;/b>Naše vedomosti o ochoreniach prehlbujeme molekulárnym profilovaním zo vzoriek pacientov, skúmaním predklinických stavov ochorení až po stavy po liečbe a využívaním multiomiky, strojového učenia a umelej inteligencie.&amp;nbsp;&lt;br>&#xd;&#xa;&lt;br>&#xd;&#xa;&lt;b>Vývoj liekov pre konkrétny účel&amp;nbsp;&lt;/b>&lt;br>&#xd;&#xa;Zameriavame sa na nové spôsoby vývoja liekov s využitím molekulárnych profilov, ktoré odhaľujú genotyp ochorenia, namiesto diagnóz, ktoré popisujú ochorenie.&amp;nbsp;&lt;br>&#xd;&#xa;&lt;br>&#xd;&#xa;&lt;b>Maximalizácia pravdepodobnosti úspechu pri vývoji liekov&amp;nbsp;&lt;/b>&lt;br>&#xd;&#xa;Vyvíjame humanizovanejšie predklinické modelové systémy (napr. CRISPR, iPSC, organoidy a disease-on-a-chip) a najmodernejšie imunologické, zobrazovacie a výpočtové prístupy na podporu inovácií v oblasti cielenej identifikácie, validácie, porovnávania a prioritizácie.&amp;nbsp;&lt;br>&#xd;&#xa;&lt;br>&#xd;&#xa;&lt;b>Vyvolanie imunitnej tolerancie&amp;nbsp;&lt;/b>&lt;br>&#xd;&#xa;Skúmame biologické procesy, ktoré zodpovedajú navodeniu imunitnej tolerancie, namiesto potláčania patologickej imunitnej aktivity.&lt;br>&#xd;&#xa;&lt;br>&#xd;&#xa;&lt;b>Cielené podávanie liekov&amp;nbsp;&lt;/b>&lt;br>&#xd;&#xa;Investujeme do systémov cieleného podávania liekov, ktoré sú navrhnuté tak, aby cielene dodávali účinné liečivo do správnych buniek a/alebo tkanív. Patria sem bišpecifické látky, platformy konjugátov protilátka-liečivo, prístupy založené na malých molekulách, RNA terapie a preprogramovanie buniek in situ.&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
                        <separator_1432895722
