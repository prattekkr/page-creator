                            jcr:created="{Date}2026-01-31T07:34:13.746-05:00"
                            jcr:createdBy="singarx"
                            jcr:lastModified="{Date}2026-04-16T01:16:14.671-04:00"
                            jcr:lastModifiedBy="singarx"
                            jcr:primaryType="nt:unstructured"
                            jcr:title="Oblasti zamerania v imunológii "
                            sling:resourceType="abbvie-com2/components/title/v2/title"
                            langAttribute="none"
                            type="h1"
                            variant="h"/>
                        <text_copy
                            cq:styleIds="[1659545825678]"
                            jcr:created="{Date}2026-01-31T07:34:19.558-05:00"
                            jcr:createdBy="singarx"
                            jcr:lastModified="{Date}2026-03-11T09:06:49.462-04:00"
                            jcr:lastModifiedBy="singarx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            langAttribute="none"
                            text="&lt;p>Pomáhame ľuďom s chronickými progresívnymi ochoreniami v oblasti reumatológie, dermatológie a gastroenterológie žiť plnohodnotný život bez toho, aby ich ochorenie výrazne obmedzovalo.&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
                        <separator_copy
                            jcr:created="{Date}2026-01-31T07:34:24.924-05:00"
                            jcr:createdBy="singarx"
                            jcr:lastModified="{Date}2026-01-31T07:34:24.924-05:00"
                            jcr:lastModifiedBy="singarx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                        <accordion_copy
                            cq:styleIds="[1]"
                            jcr:created="{Date}2026-01-31T07:35:54.935-05:00"
                            jcr:createdBy="singarx"
                            jcr:lastModified="{Date}2026-01-31T07:37:58.755-05:00"
                            jcr:lastModifiedBy="singarx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/accordion/v2/accordion"
                            heading="OBLASTI ZAMERANIA V IMUNOLÓGII: "
                            singleExpansion="false">
                            <item_1769863020403
                                cq:panelTitle="Reumatológia "
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2026-03-30T10:19:12.713-04:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                langAttribute="none"
                                text="&lt;p>Zaviazali sme sa meniť spôsoby liečby ochorení, ktoré postihujú kĺby, svaly a mäkké tkanivá. Vzhľadom na vysoké nenaplnené medicínske potreby v tejto oblasti sme pripravení pre pacientov urobiť maximum.&lt;br>&#xd;&#xa;&lt;br>&#xd;&#xa;&lt;b>Zameranie v&amp;nbsp;reumatológii&lt;br>&#xd;&#xa; &lt;br>&#xd;&#xa; &lt;/b>Reumatoidná&amp;nbsp;artritída (RA)&lt;/p>&#xd;&#xa;&lt;ul>&#xd;&#xa;&lt;li>RA je&amp;nbsp;chronické autoimunitné zápalové ochorenie, ktoré&amp;nbsp;môže spôsobovať bolesť, stuhnutosť, opuchy&amp;nbsp;a stratu funkcie kĺbov. RA môže spôsobiť poškodenie tkaniva&amp;nbsp;vedúce až&amp;nbsp;k chronickej bolesti,&amp;nbsp;poruchám&amp;nbsp;pohybu&amp;nbsp;a&amp;nbsp;telesným&amp;nbsp;deformáciám.&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;&lt;p>Psoriatická&amp;nbsp;artritída (PsA)&lt;/p>&#xd;&#xa;&lt;ul>&#xd;&#xa;&lt;li>PsA predstavuje chronické zápalové ochorenie pohybového aparátu, ktoré postihuje kĺby a šľachy. Postihuje približne 30 percent ľudí, ktorí majú psoriázu. Má podobné dopady na kvalitu života pacientov ako RA, avšak pacienti s PsA čakajú omnoho dlhšie na stanovenie správnej diagnózy a vhodnú liečbu. Chýba aj hlbší výskum príčin ochorenia.&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;&lt;p>Spondylartritída&amp;nbsp;(SpA)&lt;/p>&#xd;&#xa;&lt;ul>&#xd;&#xa;&lt;li>SpA predstavuje skupinu zápalových reumatických ochorení, ktoré postihujú chrbticu a periférne kĺby, vrátane ankylozujúcej spondylitídy, axiálnej a periférnej spondylartritídy, psoriatickej artritídy, reaktívnej artritídy a enteropatických artritíd.&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;&lt;p>Axiálna&amp;nbsp;spondylartritída&amp;nbsp;(axSpA)&lt;/p>&#xd;&#xa;&lt;ul>&#xd;&#xa;&lt;li>Chronické, zápalové ochorenie axSpA zahŕňa dve podskupiny, ktoré boli klinicky definované ako ankylozujúca spondylitída (AS) a axiálna spondyloartritída bez rádiografického dôkazu (nr-axSpA). AS je zápalové ochorenie, ktoré časom spôsobuje zrastanie kostí v chrbtici. Častejšie postihuje mužov ako ženy. Nr-axSpA je chronické zápalové ochorenie, ktoré spôsobuje zápal v oblasti chrbtice a vedie k opuchom, stuhnutosti a bolesti. Prejavy nr-axSpA možno len ťažko vyšetriť, čo často vedie k oneskoreniu správnej diagnózy.&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;&lt;p>Uveitída&amp;nbsp;(UV)&lt;/p>&#xd;&#xa;&lt;ul>&#xd;&#xa;&lt;li>UV predstavuje skupinu očných ochorení, ktoré sú charakterizované zápalom uvey, strednej vrstvy oka. Uveitída môže byť závažná a viesť až k trvalej strate zraku, preto sú včasná diagnóza a liečba kľúčové.&amp;nbsp;&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;&lt;p>Systémový&amp;nbsp;lupus&amp;nbsp;erythematosus&amp;nbsp;(SLE)&lt;/p>&#xd;&#xa;&lt;ul>&#xd;&#xa;&lt;li>SLE, imunitne podmienené ochorenie, je najčastejším typom lupusu postihujúcim najmä ženy. Spája sa so zápalom viacerých orgánových systémov.&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;&lt;p>Juvenilná&amp;nbsp;idiopatická&amp;nbsp;artritída (JIA)&lt;/p>&#xd;&#xa;&lt;ul>&#xd;&#xa;&lt;li>JIA je najčastejším chronickým reumatickým ochorením v detskom veku. Pre pacientov s JIA je zásadná včasná diagnóza a liečba.&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;"
                                textIsRich="true"/>
                            <item_1769863023363
                                cq:panelTitle="Dermatológia "
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2026-03-12T02:06:35.894-04:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                langAttribute="none"
                                text="&lt;p>Snažíme sa&amp;nbsp;nachádzať&amp;nbsp;nové odpovede a zlepšovať štandardy starostlivosti o ľudí, ktorí čelia imunitne podmieneným kožným ochoreniam, najmä tým, ktoré môžu byť náročné na diagnostiku a liečbu.&amp;nbsp;&lt;br>&#xd;&#xa;&lt;br>&#xd;&#xa;Zameranie v&amp;nbsp;dermatológii&lt;/p>&#xd;&#xa;&lt;p>Psoriáza (PsO)&lt;/p>&#xd;&#xa;&lt;ul>&#xd;&#xa;&lt;li>Chronické ochorenie imunitného systému vyvoláva zápal kože a spôsobuje, že&amp;nbsp;sa&amp;nbsp;kožné bunky&amp;nbsp;obnovujú&amp;nbsp;rýchlejšie ako&amp;nbsp;obvykle, čím sa vytvárajú hrubé červené svrbiace a šupinaté škvrny známe ako&amp;nbsp;plaky. Ľudia so psoriázou&amp;nbsp;často pociťujú&amp;nbsp;negatívne&amp;nbsp;dopady&amp;nbsp;ochorenia&amp;nbsp;na duševné zdravie a pohodu vrátane hanby, hnevu a obáv, ako aj ťažkosti&amp;nbsp;pri každodenných činnostiach, ktoré môžu ovplyvniť kvalitu ich života.&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;&lt;p>Atopická dermatitída (AD)&lt;/p>&#xd;&#xa;&lt;ul>&#xd;&#xa;&lt;li>AD je chronické zápalové ochorenie, ktoré sa vyznačuje intenzívnym svrbením, mokvaním a tvorbou chrást, začervenaním, eróziou kože a jej suchosťou. Okrem kože môže mať AD významný dopad na život pacientov kvôli poruchám spánku, zníženiu pracovnej produktivity a vplyvu na duševné zdravie. Pacienti tomu často čelia najmä počas vzplanutí, čo môže viesť až k vyčerpaniu a zníženej kvalite života.&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;&lt;p>Psoriatická&amp;nbsp;artritída (PsA)&lt;/p>&#xd;&#xa;&lt;ul>&#xd;&#xa;&lt;li>PsA, ktorá sa radí medzi zápalové artritídy, vyvoláva bolesť, stuhnutosť a opuchy kĺbov. Ochorenie sa prejaví približne u 30 percent ľudí trpiacich na psoriázu.&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;&lt;p>Hidradenitis&amp;nbsp;suppurativa&amp;nbsp;(HS)&lt;/p>&#xd;&#xa;&lt;ul>&#xd;&#xa;&lt;li>HS je chronické zápalové ochorenie, ktoré môže byť náročné na diagnostiku. Ide o&amp;nbsp;progresívne ochorenie, ktoré sa&amp;nbsp;môže časom&amp;nbsp;zhoršovať&amp;nbsp;a spôsobovať nezvratné poškodenie kože a neznesiteľnú bolesť.&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;"
                                textIsRich="true"/>
                            <item_1769863026357
                                cq:panelTitle="Gastroenterológia "
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2026-03-11T07:35:55.264-04:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                langAttribute="none"
                                text="&lt;p>Nepoľavujeme v neustálom skúmaní&amp;nbsp;nových možností&amp;nbsp;v oblasti zápalových ochorení čriev (IBD). Prostredníctvom inovatívneho výskumu a vývoja&amp;nbsp;chceme&amp;nbsp;vytvoriť ešte lepšiu budúcnosť pre ľudí&amp;nbsp;i s ďalšími&amp;nbsp;ochoreniami,&amp;nbsp;vrátane žalúdka a čriev.&amp;nbsp;&lt;/p>&#xd;&#xa;&lt;p>&lt;b>Zameranie v&amp;nbsp;gastroenterológii&amp;nbsp;&lt;/b>&lt;/p>&#xd;&#xa;&lt;p>Crohnova&amp;nbsp;choroba (CD)&amp;nbsp;&lt;/p>&#xd;&#xa;&lt;ul>&#xd;&#xa;&lt;li>CD je chronické zápalové črevné ochorenie, ktoré môže postihnúť akúkoľvek časť tráviaceho traktu. Príznaky sa u jednotlivých pacientov často líšia, pričom typické je striedanie období vzplanutia a remisie.&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;&lt;p>Ulcerózna kolitída (UC)&amp;nbsp;&lt;/p>&#xd;&#xa;&lt;ul>&#xd;&#xa;&lt;li>UC je chronické zápalové&amp;nbsp;črevné&amp;nbsp;ochorenie, ktoré postihuje hrubé črevo.&amp;nbsp;Príznaky&amp;nbsp;sa pohybujú od miernych až po závažné,&amp;nbsp;pričom prejavy ochorenia&amp;nbsp;môžu&amp;nbsp;pacienta negatívne ovplyvňovať v každodenných činnostiach.&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;"
                                textIsRich="true"/>
                        </accordion_copy>
