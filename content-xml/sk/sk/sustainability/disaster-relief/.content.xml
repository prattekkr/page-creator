                                jcr:lastModified="{Date}2026-03-19T03:57:35.610-04:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                langAttribute="none"
                                text="&lt;p>Nadácia AbbVie Foundation tiež znásobuje finančné dary zamestnancov pre vybrané organizácie, ktoré poskytujú pomoc v zasiahnutých oblastiach, a tým umožňuje zamestnancom aktívne prispievať k zdravšiemu svetu v čase, keď je to najviac potrebné.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
