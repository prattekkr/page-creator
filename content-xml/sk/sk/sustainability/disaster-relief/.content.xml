                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                langAttribute="none"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-26-reg&quot;>Náš záväzok prinášať pozitívny dopad na svet je základom všetkého, čo robíme. Pomáhame komunitám po celom svete zasiahnutým prírodnými katastrofami a humanitárnymi krízami darovaním nevyhnutných liekov AbbVie, poskytovaním potrebných zdrojov neziskovým partnerom a finančnou podporou zasiahnutým zamestnancom a ich rodinám.&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <separator
                                jcr:created="{Date}2026-02-03T11:44:05.919-05:00"
                                jcr:createdBy="singarx"
                                jcr:lastModified="{Date}2026-02-03T11:44:05.919-05:00"
                                jcr:lastModifiedBy="singarx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                            <text_1343294184
