                                <item_1670707220579
                                    cq:panelTitle="Allergan Aesthetics "
                                    cq:styleIds="[1659545825678]"
                                    jcr:lastModified="{Date}2026-02-03T08:20:41.610-05:00"
                                    jcr:lastModifiedBy="singarx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Allergan&amp;nbsp;Aesthetics,&amp;nbsp;divízia&amp;nbsp;AbbVie,&amp;nbsp;vyvíja, vyrába a predáva portfólio popredných značiek a produktov&amp;nbsp;estetickej medicíny. Staňte sa súčasťou tímu, ktorý verí v silu dôvery.&amp;nbsp;&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <item_1670707211154
                                    cq:panelTitle="Komerčný tím "
                                    cq:styleIds="[1659545825678]"
                                    jcr:lastModified="{Date}2026-03-31T06:18:33.132-04:00"
                                    jcr:lastModifiedBy="singarx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    langAttribute="none"
                                    text="&lt;p>Pridajte sa k tímom predaja, marketingu a obchodnej podpory, ktoré prepájajú pacientov s novými terapiami a riešeniami s cieľom pozitívne ovplyvniť ich životy.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <item_1670707214308
                                    cq:panelTitle="Korporátny tím "
                                    cq:styleIds="[1659545825678]"
                                    jcr:lastModified="{Date}2026-02-03T08:21:31.650-05:00"
                                    jcr:lastModifiedBy="singarx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Nájdite nové spôsoby, ako zvýšiť naše&amp;nbsp;konkurenčné&amp;nbsp;výhody,&amp;nbsp;podporujte našich ľudí a veďte ich čestne vo všetkom, čo robíme.&amp;nbsp;&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <item_1670707217700
                                    cq:panelTitle="Prevádzkový tím "
                                    cq:styleIds="[1659545825678]"
                                    jcr:lastModified="{Date}2026-03-05T09:55:55.014-05:00"
                                    jcr:lastModifiedBy="singarx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Spolupracujte s globálnym tímom odborníkov zodpovedných za dodávky a distribúciu všetkých našich produktov a zároveň za niektoré firemné služby, ako napríklad správu budov, nákupy či bezpečnosť.  &lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <item_1670707208042
                                    cq:panelTitle="Výskum a vývoj"
                                    cq:styleIds="[1659545825678]"
                                    jcr:lastModified="{Date}2026-02-03T08:22:39.395-05:00"
                                    jcr:lastModifiedBy="singarx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>Preniknite na novú pôdu v oblasti výskumu a vývoja liekov a riešení a podieľajte sa na tom, aby naše produkty a postupy spĺňali najprísnejšie regulačné štandardy.&amp;nbsp;&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
