                                jcr:title="Cinq méthodes mises en place par AbbVie pour accélérer l’accès aux médicaments innovants"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h1"
                                variant="h"/>
                            <text_copy
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2025-12-10T05:25:26.518-05:00"
                                jcr:lastModifiedBy="BROINYX"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Lorsqu’il s’agit d’offrir plus de temps aux patients atteints de maladies invalidantes, les objectifs d’AbbVie sont ambitieux et ils se doivent de l’être.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                        </container>
