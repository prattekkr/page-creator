                                jcr:lastModifiedBy="llobesx"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="Faire avancer les idées qui ont un potentiel curatif"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h2"
                                variant="h"/>
                            <text_copy_copy
                                cq:styleIds="[1659545825678]"
