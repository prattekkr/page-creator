                                jcr:title="Trois façons dont l'IA* révolutionne la découverte de traitements chez AbbVie"
                                sling:resourceType="abbvie-com2/components/title/v2/title"
                                type="h1"
                                variant="h"/>
                            <text
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2024-12-20T11:17:31.709-05:00"
                                jcr:createdBy="BROINYX"
                                jcr:lastModified="{Date}2025-01-26T11:19:52.535-05:00"
                                jcr:lastModifiedBy="vailllx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Découvrez comment l'intelligence artificielle peut accélérer la découverte de nouvelles cibles thérapeutiques, optimiser le développement de médicaments et aider à les mettre à la disposition des patients les plus susceptibles de répondre au traitement.&lt;br>&#xa;&lt;br>&#xa;*IA : Intelligence Artificielle&lt;/p>&#xa;"
                                textIsRich="true"/>
                        </container3_copy_910910616>
                        <container
                            cq:styleIds="[1653545825683]"
                            jcr:created="{Date}2024-12-20T11:12:21.543-05:00"
