                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>Nous développons des médicaments qui visent à faire évoluer les standards de soins&amp;nbsp; pour améliorer la prise en charge de maladies chroniques et/ou complexes.&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
