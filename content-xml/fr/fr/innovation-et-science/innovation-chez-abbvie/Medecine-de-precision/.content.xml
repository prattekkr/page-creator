                                    jcr:title="Optimiser le développement de médicaments pour les patients"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h4"
                                    variant="h"/>
                                <image
                                    jcr:created="{Date}2024-06-27T09:16:27.346-04:00"
