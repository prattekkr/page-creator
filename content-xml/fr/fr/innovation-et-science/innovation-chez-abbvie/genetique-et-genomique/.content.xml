                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>De l'exploitation d'ensembles de données massifs à l'étude de plus d'un million de génomes, nos scientifiques revisitent la façon dont nous comprenons et traitons les maladies.&amp;nbsp;&amp;nbsp;&lt;br>&#xd;&#xa;&amp;nbsp;&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
