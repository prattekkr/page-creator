                                jcr:lastModifiedBy="chiucx"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/grid/v2/grid"
                                rowCount="1">
                                <columns jcr:primaryType="nt:unstructured">
                                    <item0
                                        jcr:primaryType="nt:unstructured"
                                        columnWidth="11"
                                        dataPriority="1"/>
                                    <item1
                                        jcr:primaryType="nt:unstructured"
                                        columnWidth="1"
                                        dataPriority="1"/>
                                </columns>
                                <par_11
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="wcm/foundation/components/parsys">
                                    <quote
                                        cq:styleIds="[1000000000040,1000000000000]"
                                        jcr:created="{Date}2023-01-31T14:35:03.798-05:00"
                                        jcr:createdBy="mihalsk"
                                        jcr:lastModified="{Date}2024-06-11T23:41:39.764-04:00"
                                        jcr:lastModifiedBy="jewitca"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="abbvie-com2/components/quote"
                                        attributionName="Jonathon Sedgwick, Ph.D."
                                        attributionTitle="Vice-président et Responsable mondial Découverte scientifique AbbVie"
                                        quote="Transformer une découverte en médicament est un processus complexe d'essais et d'erreurs qui peut prendre de nombreuses années. Mais c'est la curiosité de l'inconnu et la soif de connaissances qui nous passionnent et nous poussent à agir."
                                        quoteType="regular"
                                        textSize="h0"/>
