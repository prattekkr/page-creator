                            jcr:lastModifiedBy="jewitca"
                            jcr:primaryType="nt:unstructured"
                            jcr:title="Les essais cliniques"
                            sling:resourceType="abbvie-com2/components/title/v2/title"
                            type="h3"
                            variant="h"/>
                        <text_copy_copy_copy
                            cq:styleIds="[1659545825678]"
                            jcr:created="{Date}2022-12-07T14:53:09.069-05:00"
                            jcr:createdBy="chiucx"
                            jcr:lastModified="{Date}2024-07-03T10:32:39.822-04:00"
                            jcr:lastModifiedBy="llobesx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>Les essais cliniques permettent de recueillir des données sur l'efficacité et la sécurité d’un médicament ou d’un traitement expérimental et de déterminer s'il est sûr et efficace pour une utilisation à grande échelle chez les patients atteints de la maladie cible. Ce sont &lt;b>des études dites interventionnelles&lt;/b>, qui se déroulent en 4 phases successives. Chaque phase a des objectifs et des critères spécifiques qui doivent être satisfaits avant de passer à la phase suivante.&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
                        <separator_715941364
                            cq:styleIds="[1662756486159]"
                            jcr:created="{Date}2024-06-12T18:55:53.778-04:00"
                            jcr:createdBy="jewitca"
                            jcr:lastModified="{Date}2024-06-12T18:55:53.778-04:00"
                            jcr:lastModifiedBy="jewitca"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                        <accordion
                            cq:styleIds="[1]"
                            jcr:created="{Date}2024-06-12T18:52:20.816-04:00"
                            jcr:createdBy="jewitca"
                            jcr:lastModified="{Date}2024-06-12T18:53:38.654-04:00"
                            jcr:lastModifiedBy="jewitca"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/accordion/v2/accordion"
                            expandedItems="[item_1718232762093,item_1718232772285,item_1718232788444,item_1718232797196]"
                            heading="Les 4 phases des essais cliniques"
                            singleExpansion="false">
                            <item_1718232762093
                                cq:panelTitle="Phase I"
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2024-06-12T18:54:41.895-04:00"
                                jcr:lastModifiedBy="jewitca"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>La première phase des essais cliniques implique un petit groupe de volontaires sains pour déterminer la sécurité, la tolérabilité et la pharmacocinétique (parcours dans le corps) du médicament ou du traitement expérimental.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <item_1718232772285
                                cq:panelTitle="Phase II"
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2024-06-12T18:54:58.792-04:00"
                                jcr:lastModifiedBy="jewitca"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>La phase II des essais cliniques porte sur un groupe plus important de patients atteints de la maladie cible, pour évaluer l'efficacité et la sécurité du médicament ou du traitement expérimental.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <item_1718232788444
                                cq:panelTitle="Phase III"
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2024-06-12T18:55:09.257-04:00"
                                jcr:lastModifiedBy="jewitca"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>La phase III inclut un groupe encore plus important de patients atteints de la maladie cible, pour confirmer l'efficacité et la sécurité du médicament ou du traitement expérimental, comparé à un traitement standard ou un placebo.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <item_1718232797196
                                cq:panelTitle="Phase IV"
                                cq:styleIds="[1659545825678]"
                                jcr:lastModified="{Date}2024-06-12T18:55:26.207-04:00"
                                jcr:lastModifiedBy="jewitca"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>La phase IV des essais cliniques est menée après l'approbation réglementaire du médicament ou du traitement, pour surveiller l'utilisation à long terme et identifier tout effet indésirable ou nouvel effet secondaire.&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                        </accordion>
                        <container
