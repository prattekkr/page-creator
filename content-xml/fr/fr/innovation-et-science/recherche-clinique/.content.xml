                                jcr:created="{Date}2024-06-12T18:57:05.778-04:00"
                                jcr:createdBy="jewitca"
                                jcr:lastModified="{Date}2024-07-04T04:21:49.706-04:00"
                                jcr:lastModifiedBy="BROINYX"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/quote"
                                attributionName="Margaux De Araujo"
                                attributionTitle="Attachée de recherche clinique, AbbVie France"
                                bgImageModifiers="resMode=sharp2&amp;op_sharpen=1"
                                quote="Je suis fière de travailler avec des scientifiques et des professionnels de santé pour mener à bien nos essais cliniques. Nos recherches sont une importante source d’espoir pour les patients."
