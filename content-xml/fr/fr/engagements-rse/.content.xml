                                jcr:lastModifiedBy="jewitca"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>Au travers de nos engagements RSE, nous souhaitons également avoir un impact positif et durable sur nos collaborateurs, l'environnement et la société. &lt;br>&#xd;&#xa; C'est en agissant avec intégrité et responsabilité dans chacune de nos activités et avec chacune de nos parties prenantes que nous obtiendrons cet impact concret.&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                        </container3>
