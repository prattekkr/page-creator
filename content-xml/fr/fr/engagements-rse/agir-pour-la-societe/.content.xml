                            jcr:created="{Date}2024-02-09T17:18:30.245-05:00"
                            jcr:createdBy="jewitca"
                            jcr:lastModified="{Date}2024-05-07T04:17:56.530-04:00"
                            jcr:lastModifiedBy="BROINYX"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>AbbVie est portée par la nécessité d’aider les plus fragiles et de favoriser l’insertion des personnes en difficulté sur le marché de l’emploi. Tout au long de l'année, nous organisons plusieurs actions pour engager nos collaborateurs aux côtés d'associations qui soutiennent les personnes fragiles.&lt;/p>&#xa;"
                            textIsRich="true"/>
