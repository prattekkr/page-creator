                            sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                        <title_909475745_copy_1013458608
                            cq:styleIds="[1659545825678,1661545829678,1651545825693]"
                            jcr:created="{Date}2024-03-27T17:02:16.838-04:00"
                            jcr:createdBy="jewitca"
                            jcr:lastModified="{Date}2025-07-24T10:41:34.072-04:00"
                            jcr:lastModifiedBy="BROINYX"
                            jcr:primaryType="nt:unstructured"
                            jcr:title="AbbVie en Europe "
                            sling:resourceType="abbvie-com2/components/title/v2/title"
                            type="h3"
                            variant="h"/>
                        <text_82681427
                            cq:styleIds="[1659545825678]"
                            jcr:created="{Date}2024-03-27T21:19:39.261-04:00"
                            jcr:createdBy="jewitca"
                            jcr:lastModified="{Date}2025-11-12T05:42:21.871-05:00"
                            jcr:lastModifiedBy="llobesx"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>Notre région Europe comprend &lt;b>22 filiales &lt;/b>qui réunissent&lt;b> 36 pays &lt;/b>et propose un large éventail d'opportunités professionnelles.&lt;br>&#xd;&#xa;&lt;br>&#xd;&#xa;Notre site de &lt;b>Ludwigshafen (Allemagne) &lt;/b>est notre centre de R&amp;amp;D le plus important en dehors des États-Unis. Ses équipes, composées de 1 900 collaborateurs, assurent l'ensemble du processus de création d'un médicament : recherche, développement et production de médicaments.&lt;br>&#xd;&#xa;La région Europe comporte également 6 sites de production à la pointe de l’innovation : 4 en &lt;b>Irlande&lt;/b>, 1 en &lt;b>Italie &lt;/b>et 1 en&lt;b> France, à Pringy, près d’Annecy&lt;/b>.&lt;/p>&#xd;&#xa;&lt;p>&lt;b>Quelques chiffres pour l'Europe :&lt;/b>&lt;/p>&#xd;&#xa;&lt;ul>&#xd;&#xa;&lt;li>&lt;b>14 000 collaborateurs répartis dans 33 pays&lt;/b>&lt;/li>&#xd;&#xa;&lt;li>&lt;b>11 sites de production et de logistique&lt;/b>&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;"
                            textIsRich="true"/>
                        <separator_805876452_
                            cq:styleIds="[1662756423318]"
                            jcr:created="{Date}2024-03-27T17:20:50.492-04:00"
                            jcr:createdBy="jewitca"
                            jcr:lastModified="{Date}2024-03-27T17:20:50.492-04:00"
                            jcr:lastModifiedBy="jewitca"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                        <title_909475745_copy_127830041
                            cq:styleIds="[1659545825678,1661545829678,1651545825693]"
                            jcr:created="{Date}2024-03-27T17:02:16.838-04:00"
                            jcr:createdBy="jewitca"
                            jcr:lastModified="{Date}2025-07-24T10:41:39.818-04:00"
                            jcr:lastModifiedBy="BROINYX"
                            jcr:primaryType="nt:unstructured"
                            jcr:title="AbbVie aux Etats-Unis"
                            sling:resourceType="abbvie-com2/components/title/v2/title"
                            type="h3"
                            variant="h"/>
                        <text_2105167011
                            cq:styleIds="[1659545825678]"
                            jcr:created="{Date}2024-03-27T21:22:09.732-04:00"
                            jcr:createdBy="jewitca"
                            jcr:lastModified="{Date}2024-07-17T11:11:28.828-04:00"
                            jcr:lastModifiedBy="BROINYX"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>&lt;b>Basé à Chicago (Illinois)&lt;/b>, AbbVie offre de belles opportunités de carrière aux Etats-Unis. Le siège du Groupe accueille notre centre d’excellence R&amp;amp;D, ainsi que nos pôles Opération et Activités d’exploitation. Nous y proposons une grande variété de postes allant de l’analyse à la recherche, de la stratégie au marketing.&lt;/p>&#xd;&#xa;&lt;p>AbbVie développe également un pôle Oncologie sur la côte ouest des États-Unis avec trois sites consacrés à la recherche et au développement de nouveaux traitements anticancéreux &lt;b>dans la région de la baie de San Francisco (Redwood City, South San Francisco et Sunnyvale)&lt;/b>. Plus de 1 000 scientifiques, cliniciens et développeurs de produits dotés d’un fort esprit entrepreneurial y travaillent. Ils associent leur expertise en immuno-oncologie, biologie des cellules souches et signalisation cellulaire avec leurs connaissances des anticorps bispécifiques, anticorps conjugués (ADC) et inhibiteurs covalents afin de découvrir de nouveaux traitements en oncologie.&lt;/p>&#xd;&#xa;&lt;p>AbbVie dispose également d’un centre dans le &lt;b>Massachusetts &lt;/b>qui emploie près de 900 collaborateurs. Le centre de recherche biologique d’AbbVie de &lt;b>Worcester &lt;/b>est spécialisé dans la recherche en immunologie et en molécules biologiques, ainsi que dans le développement et la fabrication de médicaments biologiques. En 2016, nous avons inauguré le Foundational Neuroscience Center (FNC), un centre d’environ 13 100 m² consacré aux neurosciences, au sein du Life Sciences Corridor de &lt;b>Cambridge (Massachusetts)&lt;/b> où nous étudions les mécanismes biologiques à l’origine des maladies neurodégénératives.&lt;/p>&#xd;&#xa;&lt;p>&lt;b>Quelques chiffres&amp;nbsp;:&lt;/b>&lt;/p>&#xd;&#xa;&lt;ul>&#xd;&#xa;&lt;li>&lt;b>+ de 12&amp;nbsp;000 collaborateurs travaillent aux États-Unis&lt;/b>&lt;/li>&#xd;&#xa;&lt;li>&lt;b>+ de 2&amp;nbsp;800 chercheurs&amp;nbsp;&lt;/b>&lt;/li>&#xd;&#xa;&lt;li>&lt;b>+ de 100&amp;nbsp;000 m² consacrés à la recherche dans l’Illinois&lt;/b>&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;"
                            textIsRich="true"/>
                    </container_424963577>
