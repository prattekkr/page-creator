                            displayPopupTitle="true"
                            dmPresetType="imagePreset"
                            fileReference="/content/dam/abbvie-com2/fr/rejoindre-abbvie/nos-opportunités/AbbVie_Boulogne.jpg"
                            isDecorative="false"
                            openInNewWindow="false"
