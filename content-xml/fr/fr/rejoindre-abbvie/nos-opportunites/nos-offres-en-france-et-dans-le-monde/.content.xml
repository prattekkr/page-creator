                            text="&lt;p>Notre entreprise est présente partout dans le monde, offrant une grande diversité de parcours et d'expériences. Notre implantation mondiale vous permettra de construire une carrière d’envergure internationale.&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
                        <separator_805876452
                            cq:styleIds="[1662756423318]"
                            jcr:created="{Date}2024-03-27T17:20:50.492-04:00"
                            jcr:createdBy="jewitca"
                            jcr:lastModified="{Date}2024-03-27T17:20:50.492-04:00"
