                                    fileReference="/content/dam/abbvie-com2/fr/rejoindre-abbvie/nos-opportunités/AbbVie_RecrutementProcess-4.jpg"
                                    isDecorative="false"
                                    titleValueFromDAM="true"/>
                            </item_1711592353094>
                        </accordion>
                    </container_1952504295>
