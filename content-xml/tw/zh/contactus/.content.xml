                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;table width=&quot;100%&quot; cellspacing=&quot;0&quot; cellpadding=&quot;4&quot; border=&quot;0&quot;>&#xd;&#xa;&lt;tbody>&lt;tr>&lt;td>&lt;span class=&quot;body-unica-18-reg&quot;>中文商品名&lt;/span>&lt;/td>&#xd;&#xa;&lt;td style=&quot;text-align: left;&quot;>&lt;span class=&quot;body-unica-18-reg&quot;>英文商品名&lt;/span>&lt;/td>&#xd;&#xa;&lt;/tr>&lt;tr>&lt;td style=&quot;text-align: left;&quot;>&lt;span class=&quot;body-unica-18-reg&quot;>復邁注射劑&lt;/span>&lt;/td>&#xd;&#xa;&lt;td style=&quot;text-align: left;&quot;>&lt;span class=&quot;body-unica-18-reg&quot;>Humira 40mg Solution for Injection&lt;/span>&lt;/td>&#xd;&#xa;&lt;/tr>&lt;tr>&lt;td style=&quot;text-align: left;&quot;>&lt;span class=&quot;body-unica-18-reg&quot;>喜開悅75 mg針筒裝注射劑&lt;/span>&lt;/td>&#xd;&#xa;&lt;td style=&quot;text-align: left;&quot;>&lt;span class=&quot;body-unica-18-reg&quot;>SKYRIZI&amp;nbsp; 75mg/ 0.83 ml Pre-filled syringe&lt;/span>&lt;/td>&#xd;&#xa;&lt;/tr>&lt;tr>&lt;td style=&quot;text-align: left;&quot;>&lt;span class=&quot;body-unica-18-reg&quot;>銳虎持續性藥效錠15毫克&lt;br>&#xd;&#xa; &lt;/span>&lt;/td>&#xd;&#xa;&lt;td style=&quot;text-align: left;&quot;>&lt;span class=&quot;body-unica-18-reg&quot;>RINVOQ Extended-Release Tablets 15 mg&lt;/span>&lt;/td>&#xd;&#xa;&lt;/tr>&lt;tr>&lt;td style=&quot;text-align: left;&quot;>&lt;span class=&quot;body-unica-18-reg&quot;>開洛凱因注射劑 5.0毫克/毫升&lt;br>&#xd;&#xa; &lt;/span>&lt;/td>&#xd;&#xa;&lt;td style=&quot;text-align: left;&quot;>&lt;span class=&quot;body-unica-18-reg&quot;>Chirocaine 5.0 mg/ml Solution for Injection&lt;/span>&lt;/td>&#xd;&#xa;&lt;/tr>&lt;tr>&lt;td style=&quot;text-align: left;&quot;>&lt;span class=&quot;body-unica-18-reg&quot;>活寧液&lt;/span>&lt;/td>&#xd;&#xa;&lt;td style=&quot;text-align: left;&quot;>&lt;span class=&quot;body-unica-18-reg&quot;>Forane (Isoflurane)&lt;/span>&lt;/td>&#xd;&#xa;&lt;/tr>&lt;tr>&lt;td style=&quot;text-align: left;&quot;>&lt;span class=&quot;body-unica-18-reg&quot;>快利佳錠劑&lt;/span>&lt;/td>&#xd;&#xa;&lt;td style=&quot;text-align: left;&quot;>&lt;span class=&quot;body-unica-18-reg&quot;>Kaletra Tablets&lt;/span>&lt;/td>&#xd;&#xa;&lt;/tr>&lt;tr>&lt;td style=&quot;text-align: left;&quot;>&lt;span class=&quot;body-unica-18-reg&quot;>艾百樂膜衣錠100毫克/40毫克&lt;/span>&lt;/td>&#xd;&#xa;&lt;td style=&quot;text-align: left;&quot;>&lt;span class=&quot;body-unica-18-reg&quot;>Maviret Film-Coated Tablets 100mg/40mg&amp;nbsp;&lt;/span>&lt;/td>&#xd;&#xa;&lt;/tr>&lt;tr>&lt;td style=&quot;text-align: left;&quot;>&lt;span class=&quot;body-unica-18-reg&quot;>守肺佳氣管吸入懸浮液&lt;/span>&lt;/td>&#xd;&#xa;&lt;td style=&quot;text-align: left;&quot;>&lt;span class=&quot;body-unica-18-reg&quot;>Survanta 200mg/8ml/vial Intratracheal Suspension&amp;nbsp;&lt;/span>&lt;/td>&#xd;&#xa;&lt;/tr>&lt;tr>&lt;td style=&quot;text-align: left;&quot;>&lt;span class=&quot;body-unica-18-reg&quot;>“英國廠” 西福銳吸入用液劑&lt;/span>&lt;/td>&#xd;&#xa;&lt;td style=&quot;text-align: left;&quot;>&lt;span class=&quot;body-unica-18-reg&quot;>Ultane&lt;/span>&lt;/td>&#xd;&#xa;&lt;/tr>&lt;tr>&lt;td style=&quot;text-align: left;&quot;>&lt;span class=&quot;body-unica-18-reg&quot;>“艾伯維” 西福銳吸入用液劑&lt;/span>&lt;/td>&#xd;&#xa;&lt;td style=&quot;text-align: left;&quot;>&lt;span class=&quot;body-unica-18-reg&quot;>Ultane Inhalation Anesthetic Liquid&lt;/span>&lt;/td>&#xd;&#xa;&lt;/tr>&lt;tr>&lt;td style=&quot;text-align: left;&quot;>&lt;span class=&quot;body-unica-18-reg&quot;>唯可來膜衣錠10毫克&lt;/span>&lt;/td>&#xd;&#xa;&lt;td style=&quot;text-align: left;&quot;>&lt;span class=&quot;body-unica-18-reg&quot;>Venclexta Film-Coated Tablets 10mg&amp;nbsp;&lt;/span>&lt;/td>&#xd;&#xa;&lt;/tr>&lt;tr>&lt;td style=&quot;text-align: left;&quot;>&lt;span class=&quot;body-unica-18-reg&quot;>唯可來膜衣錠50毫克&lt;/span>&lt;/td>&#xd;&#xa;&lt;td style=&quot;text-align: left;&quot;>&lt;span class=&quot;body-unica-18-reg&quot;>Venclexta Film-Coated Tablets 50mg&amp;nbsp;&lt;/span>&lt;/td>&#xd;&#xa;&lt;/tr>&lt;tr>&lt;td style=&quot;text-align: left;&quot;>&lt;span class=&quot;body-unica-18-reg&quot;>唯可來膜衣錠100毫克&lt;/span>&lt;/td>&#xd;&#xa;&lt;td style=&quot;text-align: left;&quot;>&lt;span class=&quot;body-unica-18-reg&quot;>Venclexta Film-Coated Tablets 100mg&lt;/span>&amp;nbsp;&lt;/td>&#xd;&#xa;&lt;/tr>&lt;/tbody>&lt;/table>&#xd;&#xa;&lt;p>&amp;nbsp;&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
