                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;table width=&quot;100%&quot; cellspacing=&quot;0&quot; cellpadding=&quot;4&quot; border=&quot;0&quot;>&#xd;&#xa;&lt;tbody>&lt;tr>&lt;td width=&quot;300&quot; style=&quot;text-align: left;&quot;>&lt;span class=&quot;body-unica-16-reg&quot;>中文商品名&lt;/span>&lt;/td>&#xd;&#xa;&lt;td style=&quot;text-align: left;&quot;>&lt;span class=&quot;body-unica-16-reg&quot;>英文商品名&lt;/span>&lt;/td>&#xd;&#xa;&lt;/tr>&lt;tr>&lt;td style=&quot;text-align: left;&quot;>&lt;span class=&quot;body-unica-16-reg&quot;>“愛力根” 保妥適乾粉注射劑&lt;/span>&lt;/td>&#xd;&#xa;&lt;td style=&quot;text-align: left;&quot;>&lt;span class=&quot;body-unica-16-reg&quot;>BOTOX (BOTULINUM TOXIN TYPE A) PURIFIED NEUROTOXIN COMPLEX &amp;quot;ALLERGAN&amp;quot;&lt;/span>&lt;/td>&#xd;&#xa;&lt;/tr>&lt;tr>&lt;td style=&quot;text-align: left;&quot;>&lt;span class=&quot;body-unica-16-reg&quot;>艾弗目P無菌眼用液劑 0.15%&lt;/span>&lt;/td>&#xd;&#xa;&lt;td style=&quot;text-align: left;&quot;>&lt;span class=&quot;body-unica-16-reg&quot;>ALPHAGAN P OPHTHALMIC SOLUTION 0.15%&lt;/span>&lt;/td>&#xd;&#xa;&lt;/tr>&lt;tr>&lt;td style=&quot;text-align: left;&quot;>&lt;span class=&quot;body-unica-16-reg&quot;>康皕庚眼用液劑&lt;/span>&lt;/td>&#xd;&#xa;&lt;td style=&quot;text-align: left;&quot;>&lt;span class=&quot;body-unica-16-reg&quot;>COMBIGAN EYE DROPS&lt;/span>&lt;/td>&#xd;&#xa;&lt;/tr>&lt;tr>&lt;td style=&quot;text-align: left;&quot;>&lt;span class=&quot;body-unica-16-reg&quot;>&amp;quot;愛力根&amp;quot;露明目點眼液劑0.01%&lt;/span>&lt;/td>&#xd;&#xa;&lt;td style=&quot;text-align: left;&quot;>&lt;span class=&quot;body-unica-16-reg&quot;>LUMIGAN OPHTHALMIC SOLUTION 0.01%&lt;/span>&lt;/td>&#xd;&#xa;&lt;/tr>&lt;tr>&lt;td valign=&quot;top&quot;>&lt;p style=&quot;text-align: left;&quot;>&lt;span class=&quot;body-unica-16-reg&quot;>&amp;quot;愛力根&amp;quot;露明目單支裝眼用液劑0.03% (愛爾蘭廠)&lt;/span>&lt;/p>&#xd;&#xa;&lt;/td>&#xd;&#xa;&lt;td style=&quot;text-align: left;&quot;>&lt;span class=&quot;body-unica-16-reg&quot;>LUMIGAN PF Eye Drops&