                                    jcr:lastModifiedBy="kanchrx3"
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="共同推動藥物開發"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h4"
                                    variant="h"/>
                                <text_copy_copy
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2022-12-07T14:53:09.069-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2024-05-02T04:23:04.062-04:00"
                                    jcr:lastModifiedBy="kanchrx3"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>我們與病人、病人組織、照護者與臨床醫師合作，確保個人經驗、觀點、需求與優先考量都納入臨床開發流程中。例如，我們以病人為中心的成果研究(PCOR)方法，是以與重要的利害關係人合作為基礎，了解病人的生活經驗，讓我們可以制定策略和解決方案來幫助病人成長。&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <separator_copy_141616301
                                    cq:styleIds="[1662756486159]"
                                    jcr:created="{Date}2022-12-17T12:18:10.519-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2022-12-17T12:18:10.519-05:00"
                                    jcr:lastModifiedBy="chiucx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                                <title_copy
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2022-12-17T13:22:39.555-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2024-05-02T04:24:43.235-04:00"
                                    jcr:lastModifiedBy="kanchrx3"
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="將我們的臨床試驗多元化"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h4"
                                    variant="h"/>
                                <text_copy_copy_copy
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2022-12-07T14:53:09.069-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2024-05-02T04:33:04.715-04:00"
                                    jcr:lastModifiedBy="kanchrx3"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>我們相信臨床試驗應該反映所服務的人群。由專業的臨床試驗多元包容團隊領導，我們致力於設計具包容性的研究方案，讓代表性不足的人口可以自願參與，並根據真實世界的資料集持續評估臨床試驗資格標準，讓所有病人的心聲都能受到重視。如欲了解詳情 , &lt;a href=&quot;https://www.abbvie.com/who-we-are/equity-equality-inclusion-diversity/commitment-to-racial-justice.html&quot;>請閱讀我們對種族平等的承諾&lt;/a>.&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <separator_copy_2096421555
                                    cq:styleIds="[1662756486159]"
                                    jcr:created="{Date}2022-12-17T12:18:10.519-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2022-12-17T12:18:10.519-05:00"
                                    jcr:lastModifiedBy="chiucx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                                <title_copy_copy
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2022-12-17T13:22:39.555-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2024-05-02T04:35:10.049-04:00"
                                    jcr:lastModifiedBy="kanchrx3"
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="嵌入病人經驗"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h4"
                                    variant="h"/>
                                <text_copy_copy_copy_
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2022-12-07T14:53:09.069-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2024-05-02T04:36:01.272-04:00"
                                    jcr:lastModifiedBy="kanchrx3"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>我們致力於更加了解病人的經驗，在整個臨床開發流程中納入他們的觀點，滿足他們特殊的健康需求。我們建立強大的罹病歷程地圖，了解他們從診斷到治療以及之後的處理與情感歷程。&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <separator_copy
                                    cq:styleIds="[1662756486159]"
                                    jcr:created="{Date}2022-12-17T12:18:10.519-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2022-12-17T12:18:10.519-05:00"
                                    jcr:lastModifiedBy="chiucx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                                <title_copy_copy_copy
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2022-12-17T13:22:39.555-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2024-05-02T04:36:44.588-04:00"
                                    jcr:lastModifiedBy="kanchrx3"
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="推進數位健康技術"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h4"
                                    variant="h"/>
                                <text_copy_copy_copy__403879328
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2022-12-07T14:53:09.069-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2024-05-02T06:18:45.792-04:00"
                                    jcr:lastModifiedBy="kanchrx3"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>從穿戴裝置到可以測量疾病症狀和治療結果的遊戲平台，我們使用數位健康技術(DHT)工具，以實現前所未有的資料收集與見解，用於藥物開發的流程。&lt;br>&#xd;&#xa;&lt;br>&#xd;&#xa;對於不易開發新療法的疾病，我們的新工具可幫助開發客觀與靈敏的數位生物標記，希望能使我們更迅速的辨識治療反應者，並讓臨床評估更精準。&lt;br>&#xd;&#xa;&lt;br>&#xd;&#xa;&lt;br>&#xd;&#xa;我們也透過連線的感應器技術加上COAs，測量真實世界狀況下的一些結果，以提供對病人經驗的全面了解。例如，我們會測量風濕病在治療後，身體活動、睡眠和關節活動範圍的改善情況。在皮膚科適應症方面，可以即時擷取圖片並評估，根據疾病活動就證據進行治療討論。&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                                <separator
                                    cq:styleIds="[1662756486159]"
                                    jcr:created="{Date}2022-12-17T12:18:10.519-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2022-12-17T12:18:10.519-05:00"
                                    jcr:lastModifiedBy="chiucx"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/separator/v2/separator"/>
                                <title_copy_copy_copy_497179
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2022-12-17T13:22:39.555-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2024-05-02T06:22:17.686-04:00"
                                    jcr:lastModifiedBy="kanchrx3"
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="開啟真實世界證據(RWE)的潛力"
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h4"
                                    variant="h"/>
                                <text_copy_copy_copy__1354420930
                                    cq:styleIds="[1659545825678]"
                                    jcr:created="{Date}2022-12-07T14:53:09.069-05:00"
                                    jcr:createdBy="chiucx"
                                    jcr:lastModified="{Date}2024-05-02T06:24:40.983-04:00"
                                    jcr:lastModifiedBy="kanchrx3"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>RWE是從病人實際生活中所取得的臨床數據，透過對傳統隨機臨床試驗結果進行補充，有可能對於新的治療選項如何作用，提供更全面的了解。&lt;br>&#xd;&#xa;&lt;br>&#xd;&#xa;RWE幫助我們了解疾病負擔、治療模式、病人行為、未滿足醫療需求、和治療效能，特別是在照護和結果存在差異的人群，這些是無法透過傳統臨床試驗進行研究。&lt;/p>&#xd;&#xa;"
                                    textIsRich="true"/>
                            </container_568753235_>
