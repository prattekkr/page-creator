                            <container4
                                cq:styleIds="[1653545825687,1653545847150,1653242825678,1653545835982,1653545835879]"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/container/v2/container">
                                <title2
                                    cq:styleIds="[1659545825678,1651545824678,1661545829678]"
                                    jcr:lastModified="{Date}2024-04-29T12:42:06.281-04:00"
                                    jcr:lastModifiedBy="kanchrx3"
                                    jcr:primaryType="nt:unstructured"
                                    jcr:title="我們為何著重人格保護 "
                                    sling:resourceType="abbvie-com2/components/title/v2/title"
                                    type="h3"
                                    variant="h"/>
                                <text2
                                    cq:styleIds="[1659545825678,1659545835858]"
                                    jcr:lastModified="{Date}2024-04-29T12:45:09.545-04:00"
                                    jcr:lastModifiedBy="kanchrx3"
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="abbvie-com2/components/text/v2/text"
                                    text="&lt;p>在神經科學領域，有許多難以治療的疾病和高度未滿足的需求，我們的科學家努力不懈地想要提升照護標準。但大腦很複雜，新的挑戰必須在研發藥品的各個階段都採取新的思維方式。&lt;br>&#xa;&lt;br>&#xa;&lt;br>&#xa;這就是為什麼我們不斷探索創新的緩解疾病方法，以解決一些最普遍和最嚴重的疾病，從帕金森氏症和阿茲海默症到偏頭痛、思覺失調症和中風。&lt;/p>&#xa;"
                                    textIsRich="true"/>
                            </container4>
                            <separator
                                cq:styleIds="[1662756486159]"
                                jcr:created="{Date}2022-12-17T17:44:26.640-05:00"
