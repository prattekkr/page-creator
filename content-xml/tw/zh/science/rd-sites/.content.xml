                            jcr:primaryType="nt:unstructured"
                            jcr:title="美國麻州伍斯特(Worcester, MA)"
                            sling:resourceType="abbvie-com2/components/title/v2/title"
                            type="h4"
                            variant="h"/>
                        <text2_copy_copy_copy_1566281083
                            cq:styleIds="[1659545825678,1659545835858]"
                            jcr:lastModified="{Date}2024-05-03T01:53:14.635-04:00"
                            jcr:lastModifiedBy="kanchrx3"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>艾伯維在麻州伍斯特的生物研究中心在藥物探索、開發科學與生物製劑研究方面為業界佼佼者，已經有超過30年經驗。這個佔地553,000平方英尺的設施，著重於開發生物療法，並針對醫學上一些最棘手的難題(包括免疫學和神經科學)，探索創新的解決方案。&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
                        <button_copy_13254203
