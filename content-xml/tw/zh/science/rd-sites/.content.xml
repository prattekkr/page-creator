                            jcr:title="日本東京(Tokyo, Japan)"
                            sling:resourceType="abbvie-com2/components/title/v2/title"
                            type="h4"
                            variant="h"/>
                        <text2_copy_copy_copy_1838308187
                            cq:styleIds="[1659545825678,1659545835858]"
                            jcr:lastModified="{Date}2024-05-03T02:01:16.528-04:00"
                            jcr:lastModifiedBy="kanchrx3"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>艾伯維在東京的研發基地是取得完整臨床開發能力的所在。為了替日本病人取得艾伯維產品的新藥申請核准，我們同時進行第1期到第4期的研究。我們針對每個重點領域進行策略臨床規劃工作，在腫瘤學、免疫學、神經科學、專科、眼科醫療和醫學美容方面，開發日本特定的發展策略。&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
                    </container4_copy_copy>
