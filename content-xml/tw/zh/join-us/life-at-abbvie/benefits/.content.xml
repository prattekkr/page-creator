                                jcr:created="{Date}2022-12-10T17:10:30.657-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2024-04-29T15:02:10.230-04:00"
                                jcr:lastModifiedBy="ABDELAX6"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>我們提供的薪酬、福利和福祉計畫支援您在職涯和人生每個階段中不同的需求。我們提供差異化且有競爭力的獎勵與福利。有些計畫因國家而異。&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                        </container3>
