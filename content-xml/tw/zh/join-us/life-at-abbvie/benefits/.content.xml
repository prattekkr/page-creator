                                    headingElement="h5"
                                    singleExpansion="false">
                                    <item_1670713218905
                                        cq:panelTitle="薪酬"
                                        cq:styleIds="[1659545825678]"
                                        jcr:lastModified="{Date}2024-04-29T16:56:17.060-04:00"
                                        jcr:lastModifiedBy="ABDELAX6"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="abbvie-com2/components/text/v2/text"
                                        text="&lt;ul>&#xd;&#xa;&lt;li>有競爭力的底薪&amp;nbsp;&lt;br>&#xd;&#xa;&lt;/li>&#xd;&#xa;&lt;li>短期和長期激勵獎金&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;li>表彰計畫&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;"
                                        textIsRich="true"/>
                                    <item_1670713221584
                                        cq:panelTitle="福利"
                                        cq:styleIds="[1659545825678]"
                                        jcr:lastModified="{Date}2024-04-29T16:57:22.434-04:00"
                                        jcr:lastModifiedBy="ABDELAX6"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="abbvie-com2/components/text/v2/text"
                                        text="&lt;ul>&#xd;&#xa;&lt;li>全面的保險(醫療、牙醫、視力、心理健康和處方藥)&amp;nbsp;&lt;br>&#xd;&#xa;&lt;/li>&#xd;&#xa;&lt;li>病假給薪與病假&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;li>人壽保險與殘障險&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;li>靈活的支出帳戶，以稅前美元支付醫療花費*&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;li>退休儲蓄計畫*&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;li>員工購股計畫，適用於美國以外大多數國家&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;li>住房與交通津貼，適用於美國以外地方&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;&lt;p>*於美國提供&lt;/p>&#xd;&#xa;"
                                        textIsRich="true"/>
                                    <item_1670713228568
                                        cq:panelTitle="彈性工作與休假"
                                        cq:styleIds="[1659545825678]"
                                        jcr:lastModified="{Date}2024-04-29T17:01:45.760-04:00"
                                        jcr:lastModifiedBy="ABDELAX6"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="abbvie-com2/components/text/v2/text"
                                        text="&lt;ul>&#xd;&#xa;&lt;li>彈性工作安排因職務而異，例如彈性工時、兼職工作、職務分擔、調班、縮短每週工時和遠距工作&amp;nbsp;&lt;br>&#xd;&#xa;&lt;/li>&#xd;&#xa;&lt;li>辦公室員工的混合工作模式，通常為3天在辦公室，2天遠距工作&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;li>分階段退休計畫*&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;li>有薪休假與公司假期&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;li>除了全公司的志工週之外，還有兩天有薪志工假&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;&lt;p>*於美國提供&lt;/p>&#xd;&#xa;"
                                        textIsRich="true"/>
                                    <item_1670713232031
                                        cq:panelTitle="對家庭的支持"
                                        cq:styleIds="[1659545825678]"
                                        jcr:lastModified="{Date}2024-04-29T17:02:34.259-04:00"
                                        jcr:lastModifiedBy="ABDELAX6"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="abbvie-com2/components/text/v2/text"
                                        text="&lt;ul>&#xd;&#xa;&lt;li>對透過生產、收養、代孕或寄養方式撫養小孩的新手父母，給予有薪休假&amp;nbsp;&lt;br>&#xd;&#xa;&lt;/li>&#xd;&#xa;&lt;li>照顧生病家人的員工給予有薪休假和支援&amp;nbsp;&lt;br>&#xd;&#xa;&lt;/li>&#xd;&#xa;&lt;li>支援計劃生育，包括收養和代孕的協助&amp;nbsp;&lt;br>&#xd;&#xa;&lt;/li>&#xd;&#xa;&lt;li>在美國育兒中心享有折扣，並可使用我們位於美國伊利諾伊州湖郡(Lake County)總部的日托中心&amp;nbsp;&lt;/li>&#xd;&#xa;&lt;/ul>&#xd;&#xa;"
                                        textIsRich="true"/>
                                    <container
                                        cq:panelTitle="全面性福祉"
                                        cq:styleIds="[1653545847150]"
                                        jcr:created="{Date}2024-04-29T17:04:56.198-04:00"
                                        jcr:createdBy="ABDELAX6"
                                        jcr:lastModified="{Date}2024-04-29T17:08:48.364-04:00"
                                        jcr:lastModifiedBy="ABDELAX6"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="abbvie-com2/components/container/v2/container">
                                        <text
                                            cq:styleIds="[1659545825678]"
                                            jcr:created="{Date}2024-04-29T17:05:03.912-04:00"
                                            jcr:createdBy="ABDELAX6"
                                            jcr:lastModified="{Date}2024-04-29T17:05:11.317-04:00"
                                            jcr:lastModifiedBy="ABDELAX6"
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="abbvie-com2/components/text/v2/text"
                                            text="&lt;p>我們與員工合作，提供他們工具與支援，幫助他們在工作和家庭都能處於最佳狀態。因為當您處於最佳狀態時，才能充分發揮。&lt;/p>&#xd;&#xa;"
                                            textIsRich="true"/>
                                        <button
                                            jcr:created="{Date}2024-04-29T17:05:15.622-04:00"
                                            jcr:createdBy="ABDELAX6"
                                            jcr:lastModified="{Date}2024-04-29T17:05:44.048-04:00"
                                            jcr:lastModifiedBy="ABDELAX6"
                                            jcr:primaryType="nt:unstructured"
                                            jcr:title="深入了解"
                                            sling:resourceType="abbvie-com2/components/button/v2/button"
                                            accessibilityLabel="深入了解"
                                            linkTarget="_self"
                                            linkURL="https://www.abbvie.com/join-us/life-at-abbvie/well-being-in-the-workplace.html"/>
                                    </container>
                                    <item_1714425005097
                                        cq:panelTitle="學習與發展"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="abbvie-com2/components/container/v2/container">
                                        <text_copy
                                            cq:styleIds="[1659545825678]"
                                            jcr:created="{Date}2024-04-29T17:05:03.912-04:00"
                                            jcr:createdBy="ABDELAX6"
                                            jcr:lastModified="{Date}2024-04-29T17:11:00.221-04:00"
                                            jcr:lastModifiedBy="ABDELAX6"
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="abbvie-com2/components/text/v2/text"
                                            text="&lt;p>當我們促使自己成長、嘗試新技能並有勇氣承擔風險時，就是處於最佳狀態。由於對學習與發展的承諾，我們會提供資源，讓員工向前邁進，並達到更高的目標。&lt;/p>&#xd;&#xa;"
                                            textIsRich="true"/>
                                        <button_copy
                                            jcr:created="{Date}2024-04-29T17:05:15.622-04:00"
                                            jcr:createdBy="ABDELAX6"
                                            jcr:lastModified="{Date}2024-04-29T17:11:14.680-04:00"
                                            jcr:lastModifiedBy="ABDELAX6"
                                            jcr:primaryType="nt:unstructured"
                                            jcr:title="深入了解"
                                            sling:resourceType="abbvie-com2/components/button/v2/button"
                                            accessibilityLabel="深入了解"
                                            linkTarget="_self"
                                            linkURL="https://www.abbvie.com/join-us/life-at-abbvie/learning-and-development.html"/>
                                    </item_1714425005097>
                                </accordion>
                            </container>
