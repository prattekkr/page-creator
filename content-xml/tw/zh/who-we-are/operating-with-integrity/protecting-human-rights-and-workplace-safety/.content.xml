                                jcr:lastModified="{Date}2024-04-26T10:43:13.702-04:00"
                                jcr:lastModifiedBy="ABDELAX6"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>艾伯維相信每個人與生俱來的尊嚴，並尊重世界人權宣言所載的個人權利。我們將這些準則反映在公司的基本理念和解決嚴重健康難題的使命中。&lt;/p>&#xd;&#xa;&lt;p>我們透過雇用、道德與採購的政策實現人權。我們的作法和計畫不但確保所有經營業務所在地都遵循法律與法規，還解決了員工提出的所有職場顧慮。&lt;/p>&#xd;&#xa;"
                                textIsRich="true"/>
                            <button
                                cq:styleIds="[1659997756584]"
                                jcr:created="{Date}2022-12-09T18:43:51.023-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2024-04-26T10:44:18.060-04:00"
                                jcr:lastModifiedBy="ABDELAX6"
                                jcr:primaryType="nt:unstructured"
                                jcr:title="閱讀我們的承諾 "
                                sling:resourceType="abbvie-com2/components/button/v2/button"
                                accessibilityLabel="閱讀我們的承諾"
                                linkTarget="_self"
                                linkURL="/content/dam/abbvie-dotcom/uploads/PDFs/our-commitment-to-human-rights.pdf"/>
                        </par_13>
