                            variant="h"/>
                        <text_copy_copy_copy
                            cq:styleIds="[1659545825678]"
                            jcr:created="{Date}2022-11-07T18:20:48.523-05:00"
                            jcr:createdBy="chiucx"
                            jcr:lastModified="{Date}2024-08-23T17:09:01.764-04:00"
                            jcr:lastModifiedBy="jewitca"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="abbvie-com2/components/text/v2/text"
                            text="&lt;p>「零容忍、信任、實現」是我們處理職場安全的指導方針。該方針反映出一個信念:如果我們採取預防性思維，所有的環境、衛生與安全事件都可以避免。&lt;/p>&#xd;&#xa;&lt;p>我們提供所有員工全面性的職場安全訓練，而且已經看到成效。自從我們成為獨立的公司以來，一直都是&lt;a href=&quot;https://www.spglobal.com/esg/performance/indices/&quot; target=&quot;_blank&quot;>道瓊永續指數&lt;/a>(DJSI)生物科技業界中職業健康與安全的佼佼者。根據藥物安全組織(Pharmaceutical Safety Group)這個產業聯盟的資料，我們的可記錄事故率與損失時間事故率為業界最低。&lt;/p>&#xd;&#xa;"
                            textIsRich="true"/>
                    </container_195460670>
