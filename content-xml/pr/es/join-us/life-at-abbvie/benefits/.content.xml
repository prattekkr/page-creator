                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>&lt;span class=&quot;light-font&quot;>&lt;span class=&quot;body-unica-32-reg&quot;>Apoyo en cada etapa de tu vida laboral y personal.&lt;/span>&lt;/span>&lt;/p>&#xd;&#xa;"
