                            <text_230942827
                                cq:styleIds="[1659545825678]"
                                jcr:created="{Date}2022-12-10T17:10:30.657-05:00"
                                jcr:createdBy="chiucx"
                                jcr:lastModified="{Date}2025-03-31T11:56:03.262-04:00"
                                jcr:lastModifiedBy="bryanjx9"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="abbvie-com2/components/text/v2/text"
                                text="&lt;p>Nuestras compensaciones, beneficios y programas de bienestar apoyan tus diversas y cambiantes necesidades en cada etapa de vida laboral y personal. Ofrecemos recompensas y beneficios diferenciados y competitivos. Algunos programas varían según el país.&lt;/p>&#xd;&#xa;"
