                            jcr:title="Notifícame"
                            sling:resourceType="abbvie-com2/components/button/v2/button"
                            accessibilityLabel="Notifícame"
                            linkTarget="_blank"
                            linkURL="https://abbvie.submittable.com/submit"/>
