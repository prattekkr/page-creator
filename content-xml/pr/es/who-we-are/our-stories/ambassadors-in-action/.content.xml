                                fileReference="/content/dam/abbvie-com2/pr/images/stories/ambassadors-in-action/the-way-we-work-pr.jpg"
                                isDecorative="false"
                                openInNewWindow="false"
                                titleValueFromDAM="true"/>
                            <separator
                                cq:styleIds="[1662756423318]"
                                jcr:created="{Date}2023-05-04T00:37:25.823-04:00"
                                jcr:createdBy="SCHAFSM"
