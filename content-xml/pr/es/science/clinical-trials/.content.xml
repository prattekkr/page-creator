                            sling:resourceType="abbvie-com2/components/button/v2/button"
                            accessibilityLabel="Conoce más de nuestro protocolo de los estudios clínicos"
                            linkTarget="_blank"
                            linkURL="https://www.abbvieclinicaltrials.com/resources/clinical-trial-protocol/"/>
